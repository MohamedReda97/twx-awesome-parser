{
  "name": "twx-parser",
  "version": "1.7.0",
  "description": "Library for parsing and querying TWX files for IBM BPM with enhanced business object support",
  "main": "app.js",
  "bin": {
    "twx-parser": "./app.js"
  },
  "scripts": {
    "start": "node app.js",
    "viewer": "node app.js --ui",
    "test": "node test-analyzer-v2.js",
    "lint": "eslint .",
    "build": "node -e \"const fs=require('fs'); try{fs.unlinkSync('dist/twx-parser.exe')}catch(e){if(e.code!=='ENOENT')throw e}; fs.rmSync('output', { recursive: true, force: true }); fs.mkdirSync('output');\" && pkg . --out-path dist --targets node18-win-x64"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tigermarques/twx-parse.git"
  },
  "keywords": [
    "IBM",
    "BPM",
    "TWX",
    "parser",
    "business-objects"
  ],
  "author": "João Marques <joao.gsilva.marques@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tigermarques/twx-parse/issues"
  },
  "homepage": "https://github.com/tigermarques/twx-parse#readme",
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-loose": "^8.5.2",
    "acorn-walk": "^8.3.5",
    "adm-zip": "^0.5.10",
    "eslint-scope": "^9.1.2",
    "fast-xml-parser": "^4.2.5",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-chai-friendly": "^1.0.0",
    "eslint-plugin-mocha": "^10.0.0",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "pkg": {
    "assets": [
      "twx-viewer-new.html",
      "twx-viewer-new.css",
      "twx-viewer-new.js"
    ]
  }
}

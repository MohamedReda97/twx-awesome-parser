            <scriptType>CSS</scriptType>
            <scriptBlock>.Text_Area.widthSet &gt; div {
    width: 100%;
}

.Text_Area textarea {
    resize: none;
    /*{#bug: BG-361 Fixed Text Area not wrapping properly in IE11}*/
    white-space: pre-wrap;
}

.Text_Area &gt; .form-group {
    text-align: left;
}

.Text_Area &gt; .form-group &gt; .input:hover &gt; .tooltip.validationError.alignRight &gt; .tooltip-arrow {
    -webkit-transform: translateX(-12px);
    -ms-transform: translateX(-12px);
    transform: translateX(-12px);
}

.Text_Area &gt; .form-group.label-left:before, .Text_Area &gt; .form-group.label-left:after {
    display: none;
}

.Text_Area &gt; .form-group.label-left {
    display: table;
    border-spacing: 0;
    width: 100%;
}

.Text_Area &gt; .form-group.label-left &gt; label {
    display: table-cell;
    padding-right: 8px;
    vertical-align: middle;
    width: 5px;
}

.Text_Area &gt; .form-group.label-left &gt; .input {
    display: table-cell;
}

.Text_Area span.form-control-feedback {
    z-index: 3;
}

.Text_Area .input &gt; .form-control {
    float: none;
    overflow: auto;
}
.print_helper{
    display:none;
}</scriptBlock>

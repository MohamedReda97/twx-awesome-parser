{
    var row = tw.local.sqlResults[0].rows[i];
    var label = row.indexedMap[tw.local.labelCol.name];
    var value = row.indexedMap[tw.local.valueCol.name];

    tw.local.dataSeries.dataPoints[i] = new tw.object.DataPoint();
    tw.local.dataSeries.dataPoints[i].label = label;
    tw.local.dataSeries.dataPoints[i].value = value;
}


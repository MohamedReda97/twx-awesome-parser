var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-style", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domStyle, domAttr, bpmext){
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			bpmext.uidesign.css.ensureGlyphsLoaded(this);

			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");
			
			this.context.coachViewData.defaultBorderRadius = "5px";
			this.context.coachViewData.defaultBorderWidth = "1px";
			this.context.coachViewData.defaultFontSize = "15px";
			
			this.context.coachViewData.signatureWrapper = domConstruct.create("div");
			domClass.add(this.context.coachViewData.signatureWrapper, "Signature");	
			
			this.context.coachViewData.canvasWrapper = domConstruct.create("div");
			domClass.add(this.context.coachViewData.canvasWrapper, "sig-holder");

			this.context.coachViewData.disablerDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.disablerDiv, "disabler hidden");
			
			this.context.coachViewData.canvasArea = domConstruct.create("canvas");
			domClass.add(this.context.coachViewData.canvasArea, "note");
			
			this.context.coachViewData.canvasWrapper.appendChild(this.context.coachViewData.disablerDiv);
			this.context.coachViewData.canvasWrapper.appendChild(this.context.coachViewData.canvasArea);
			this.context.coachViewData.signatureWrapper.appendChild(this.context.coachViewData.canvasWrapper);
			
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.signatureWrapper);
			
			domStyle.set(this.context.coachViewData.canvasArea, "border-radius", this.context.coachViewData.defaultBorderRadius);
			domStyle.set(this.context.coachViewData.canvasArea, "border-width", this.context.coachViewData.defaultBorderWidth);
			var canvasContext = this.context.coachViewData.canvasArea.getContext('2d');
			canvasContext.font = '35pt Brush Script MT';
			canvasContext.fillStyle = 'black';
			canvasContext.fillText('Signature', 50, 80);
			
			callback();
		}));
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){
			
			if(propertyName == "@label") {
				dojo.attr(this.context.coachViewData.canvasWrapper, "aria-label", propertyValue);
			} else if(propertyName ==  "@labelVisibility"){
			
			} else if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "radius"){
				if(propertyValue===null || propertyValue===undefined || propertyValue==""){
					domStyle.set(this.context.coachViewData.canvasArea, "border-radius", this.context.coachViewData.defaultBorderRadius);
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.canvasArea, "border-radius", propertyValue);
				}else{
					domStyle.set(this.context.coachViewData.canvasArea, "border-radius", propertyValue+"px");
				}
			} else if(propertyName == "width"){
				if(!!propertyValue) {
					this.context.coachViewData.canvasArea.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.canvasArea.style.width = "";
				}
			} else if(propertyName == "height"){
				if(!!propertyValue) {
					this.context.coachViewData.canvasArea.style.height = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.canvasArea.style.height = "";
				}
			} else if(propertyName == "inkColor"){
				var canvas = this.context.coachViewData.canvasArea;
				var context = canvas.getContext('2d');
				context.font = '35pt Brush Script MT';
				context.fillStyle = (propertyValue!==null && propertyValue!==undefined && propertyValue!="") ? propertyValue : 'black';
				context.fillText('Signature', 50, 80);
			} else if(propertyName == "borderWidth"){
				if(propertyValue===null || propertyValue===undefined || propertyValue==""){
					domStyle.set(this.context.coachViewData.canvasArea, "border-width", this.context.coachViewData.defaultBorderWidth);
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.canvasArea, "border-width", propertyValue);
				}else{
					domStyle.set(this.context.coachViewData.canvasArea, "border-width", propertyValue+"px");
				}
			} else if(propertyName == "shadow"){
				if(!!propertyValue && propertyValue) {
					domClass.add(this.context.coachViewData.canvasWrapper, "shadowed");
				} else {
					domClass.remove(this.context.coachViewData.canvasWrapper, "shadowed");
				}
			} else if(propertyName == "colorStyle"){
				var colorStyle;
				if(propertyValue == "P"){
					colorStyle = "note-primary";
				} else if(propertyValue == "I"){
					colorStyle = "note-info";
				} else if(propertyValue == "S"){
					colorStyle = "note-success";
				} else if(propertyValue == "W"){
					colorStyle = "note-warning";
				} else if(propertyValue == "G"){
					colorStyle = "note-danger";
				} else {
					colorStyle = "";
				}
				domClass.replace(this.context.coachViewData.canvasArea, colorStyle, "note-primary note-info note-success note-warning note-danger");
			}
		}));	
    },	
	modelChanged: function(propertyName, propertyValue) {
			
	}
};

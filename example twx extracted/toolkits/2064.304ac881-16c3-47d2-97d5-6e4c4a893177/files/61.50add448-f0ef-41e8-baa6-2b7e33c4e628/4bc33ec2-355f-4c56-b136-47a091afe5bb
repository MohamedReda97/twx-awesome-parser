 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">newValue</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">oldValue</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 
 *   <tr class=Prop>
 *     <td>On Focus:</td>
 *	   <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>

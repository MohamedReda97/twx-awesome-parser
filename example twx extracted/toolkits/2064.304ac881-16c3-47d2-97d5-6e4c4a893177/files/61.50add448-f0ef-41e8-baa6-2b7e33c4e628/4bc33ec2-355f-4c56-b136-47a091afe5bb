 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">formattedValue</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">format</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">valid</th>
 *         </tr>
 
 *         <tr style= "border: 1px solid black; border-collapse: collapse;">
 *           <td rowspan="5" style= "border: 1px solid black; border-collapse: collapse;padding: 5px;">Properties</td>

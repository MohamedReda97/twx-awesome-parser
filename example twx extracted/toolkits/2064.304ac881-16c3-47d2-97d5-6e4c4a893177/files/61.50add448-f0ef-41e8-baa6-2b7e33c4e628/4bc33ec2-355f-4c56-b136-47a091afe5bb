 *         </tr>
 
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;"></td>
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;"></td>
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;">thousandsSeparator</td>
 *         </tr>
 
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;"></td>
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;"></td>
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;">decimalSeparator</td>
 *         </tr>
 
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;"></td>
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;"></td>
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;">decimalPlaces</td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 
 * </table>
 */



/** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Published Event:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when an event is published.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${SubResult}.setText(me.getEventData())<code></pre></td>
 *         </tr>
 *         <tr class=Prop>
 *           <td><i>Note:</i></td>
 *           <td>In order to publish an event, you need to call <b>bpmext.ui.publishEvent(String EventName, String EventData) </b>.  The EventSubscription control will read the publication and you can handle the name and data accordingly through the On Published Event.<pre class="prettyprint"><code>bpmext.ui.publishEvent(${Name}.getText(), ${Data}.getText())</code></pre></td>
 *           <td><i>Javascript expression</i></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */ 
bpmext_control_InitEventSubscription = function(bpmext)
{
	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONEVENT : "eventON_EVENT",
			_setupSubscription : function(view, eventName, oldEventName)
			{
				if(oldEventName != null && oldEventName.length > 0)
				{
					bpmext.ui.removeEventSubscription(oldEventName, view);
					bpmext.log.debug("Removed event subscription: " + oldEventName, view);
				}
				
				if(eventName != null && eventName.length > 0)
				{
					bpmext.ui.addEventSubscription(eventName, function(evtName, payload){
							view.context.binding.set("value", payload);
							bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONEVENT);
						}, 
						view
					);

					bpmext.log.debug("Added event subscription: " + eventName, view);
				}			
			},
			_handleVisibility : function(view)
			{
				view.context.setDisplay(false);
				view.context.setVisibility(false);
			}
		}

		/**
		 * @instance
		 * @memberof EventSubscription
		 * @method getEventData
		 * @desc Get the event data (payload) associated with this subscription
		 * @returns {ANY}
		 */		
		this.constructor.prototype.getEventData = function()
		{
			return this.context.binding.get("value");
		}

		/**
		 * @instance
		 * @memberof EventSubscription
		 * @method getEventName
		 * @desc Get the event name associated with this subscription
		 * @returns {string}
		 */		
		this.constructor.prototype.getEventName = function()
		{
			return this.context.options.eventName.get("value");
		}

		/**
		 * @instance
		 * @memberof EventSubscription
		 * @method setEventName
		 * @param {string} eventName the event name of the control
		 * @desc Set the event name associated with this subscription
		 */		
		this.constructor.prototype.setEventName = function(eventName)
		{
			return this.context.options.eventName.set("value", eventName);
		}
		
		/**
		 * @instance
		 * @memberof EventSubscription
		 * @method getType
		 * @desc Get descriptive string representing the type of control/section
		 * @returns {string}
		 */		
		this.constructor.prototype.getType = function()
		{
			return "eventSubscription.3";
		}
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function()
		{
			try
			{
				if (!this.context.binding)
					this.context.binding = bpmext.ui.substituteObject(this);

				var opts = this.context.options;

				if (!opts.eventName)
					bpmext.ui.substituteConfigOption(this, "eventName", null);
					
				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					null,
					this.getEventData
					);	

				this.context.element.style.position = "absolute";

				bpmext.ui.loadView(this);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONEVENT);
				
				this._proto._setupSubscription(this, opts.eventName.get("value"));
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		}

		this.constructor.prototype.view = function()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}		
		};
		
		this.constructor.prototype.change = function(event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "eventName":
						{
							this._proto._setupSubscription(this, event.newVal, event.oldVal);
							break;
						}
					}
				}
				else
				{
					//Let subscribers know this control's value has changed
					if(event.newVal != event.oldVal)
						bpmext.ui.broadcastExpressionTrigger(this, bpmext.ui.PHASE_NORMAL); 
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};		
		
		this.constructor.prototype.unload = function()
		{
			var eventName = this.context.options.eventName.get("value");
			if(eventName != null)
				bpmext.ui.removeEventSubscription(eventName, this);

			bpmext.ui.unloadView(this);
		};
	}	
};


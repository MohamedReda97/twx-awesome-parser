/** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.collapsePane(me.getPaneCount() - 1)</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Pane Collapsed:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when a pane is collapsed.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${PaneStatus}.setText("Last Pane Collapsed: " + paneIndex);</code></pre></td>
 *         </tr>
 *       </table>
 *       <table style="border: 1px solid black; border-collapse: collapse; ">
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <th style="border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">paneIndex {int}</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Pane Expanded:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when a pane is expanded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${PaneStatus}.setText("Last Pane Expanded: " + paneIndex);</code></pre></td>
 *         </tr>
 *       </table>
 *       <table style="border: 1px solid black; border-collapse: collapse; ">
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <th style="border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">paneIndex {int}</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Pane Resized:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when a pane is resized.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${PaneStatus}.setText("Last Pane Resized: " + paneIndex + " with " + changedSize + "px");</code></pre></td>
 *         </tr>
 *       </table>
 *       <table style="border: 1px solid black; border-collapse: collapse; ">
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <th style="border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">paneIndex {int}</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">changedSize {decimal}</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitHorizontalSplit = function(bpmext, domClass, domConstruct, domAttr, domGeometry, utilities)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype.IS_ADDRESS_INVISIBLE = true;
		
		this.constructor.prototype._proto =
		{
			EVT_ONCOLLAPSE : "eventON_COLLAPSE",
			EVT_ONEXPAND : "eventON_EXPAND",
			EVT_ONRESIZED : "eventON_RESIZED",
			OPTS_HNDL_LOC :
			{
				"S" : "htop",
				"M": "hmiddle",
				"E" : "hbottom"
			},
			_setCfgChildParamsDefaults : function(params)
			{
				if(params == null)
					params = {};
				
				if(params.size == null || params.size == "")
					params.size = "auto";

				if(!isNaN(params.size))
					params.size = params.size + "px";
				
				if(params.collapsedSize == null || params.collapsedSize == "")
					params.collapsedSize = "0px";

				if(!isNaN(params.collapsedSize))
					params.collapsedSize = params.collapsedSize + "px";
				
				if(params.dividerWidth == null || params.dividerWidth == "")
					params.dividerWidth = "0px";
				
				if(!isNaN(params.dividerWidth))
					params.dividerWidth = params.dividerWidth + "px";
				
				if(params.handleLocation == null || params.handleLocation == "")
					params.handleLocation = "N";
				
				if(params.splitterThickness == null || params.splitterThickness == "")
					params.splitterThickness = "0px";

				if(!isNaN(params.splitterThickness))
					params.splitterThickness = params.splitterThickness + "px";
				
				return params;
			},
			_getCfgChildParams : function(view, index)
			{
				var specs = view.context.options.paneSpecs.get("value");
				var spec;
				if(specs && specs.get){
					spec = specs.get(index);
				}
				return this._setCfgChildParamsDefaults(spec);
			},
			_getCollapsedSizeInPx : function(view, index) {
				var collapsedSize = view._proto._getCfgChildParams(view, index).collapsedSize;

				if (collapsedSize.indexOf("px") !== -1)
					return parseFloat(collapsedSize.split("px")[0]);
				else if (collapsedSize.indexOf("%") !== -1)
					return window.innerWidth * collapsedSize.split("%")[0] / 100;
				else if (collapsedSize.indexOf("rem") !== -1)
					return collapsedSize.split("rem")[0] * parseFloat(getComputedStyle(document.documentElement).fontSize);
				return 0;
			},
			_setupHandleClick : function(view, handle, index)
			{
				if (view.context.options.resizablePanes.get("value")) 
				{
					handle.onmousedown = function (event) {
						event.preventDefault();
						view._proto._resizePane(view, event, index, "mousedown");
					}
					handle.onkeydown = function (event) {
						view._proto._resizePane(view, event, index, "keydown");
					}
				}
				else
				{
					handle.onclick = function() {
						view.togglePane(index);
					}
				}
			},
			_setHeight : function (view)
			{
				try
				{
					var height = view.context.options.height.get("value");
					
					if (height != null && height != "")
					{
						if (!isNaN(height))
							height += "px";

						view.context.element.style.height = height;
					}
				}
				catch (e)
				{
					bpmext.log.error("HorizontalSplit._setHeight() error: " + e);
					if(e.stack)
						bpmext.log.error("  Call stack: " + e.stack);
				}
			},
			_setResizablePanes : function (view, resizable)
			{
				var fn = resizable ? domClass.add : domClass.remove;
				fn(view._instance.splitterBody, "resizable");
			},
			_resizePane : function(view, event, index, type)
			{
				var md;
				var splitterBody = view._instance.splitterBody;

				// Avoid mouse events in iframe
				var childIframes = splitterBody.querySelectorAll("iframe");
				for (var i = 0; i < childIframes.length; i++) {
					childIframes.item(i).style.pointerEvents = "none";
				}

				var children = splitterBody.children;
				var child = children.item(index);
				var childGeom = domGeometry.position(child);
				var left = index > 0 ? domGeometry.position(children.item(index - 1)) : null;
				var right = index <= children.length - 2 ? domGeometry.position(children.item(index + 1)) : null;

				md = {
					element: event,
					childWidth: childGeom.w,
					leftWidth: left ? left.w : 0,
					rightWidth: right ? right.w : child.offsetWidth
				};

				if (type === "mousedown")
					onMouseDown();
				else if (type === "keydown")
					onKeyDown();

				function onMouseDown() {
					splitterBody.onmousemove = function onMouseMove(element) {
						updateWidth(element.clientX - md.element.clientX);
					};
					splitterBody.onmouseup = onMouseUpandLeave;
					splitterBody.onmouseleave = onMouseUpandLeave;

					function onMouseUpandLeave() {
						splitterBody.onmousemove = null;
						splitterBody.onmouseup = null;
						splitterBody.onmouseleave = null;
						var childIframes = splitterBody.querySelectorAll("iframe");
						for (var i = 0; i < childIframes.length; i++) {
							childIframes.item(i).style.pointerEvents = "auto";
						}
					};
				};

				function onKeyDown() {
					if (event.key === "ArrowLeft" || event.key === "Left")
						updateWidth(-10);
					if (event.key === "ArrowRight" || event.key === "Right")
						updateWidth(10);

					splitterBody.onkeyup = function onKeyUp() {
						splitterBody.onkeydown = null;
						splitterBody.onkeyup = null;
					};
				};

				function updateWidth(delta) {
					if (index <= children.length - 2) {
						if (delta >= 0)
							delta = Math.min(delta, md.rightWidth - view._proto._getCollapsedSizeInPx(view, index + 1));
						else
							delta = Math.max(delta, -md.childWidth + view._proto._getCollapsedSizeInPx(view, index));

						child.style.width = delta + md.childWidth + "px";
						children.item(index + 1).style.width = md.rightWidth - delta + "px";
					}
					else {
						if (delta >= 0)
							delta = Math.min(delta, md.childWidth - view._proto._getCollapsedSizeInPx(view, index));
						else
							delta = Math.max(delta, -md.leftWidth + view._proto._getCollapsedSizeInPx(view, index - 1));

						child.style.width = -delta + md.childWidth + "px";
						children.item(index - 1).style.width = md.leftWidth + delta + "px";
					}
					if (delta != 0)
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONRESIZED, index, delta);
				}
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);
				
				view.context.setDisplay(visibility != "NONE");
				view.context.setVisibility(visibility != "HIDDEN");

				/*
				if (visibility != "NONE")
				{
					if (visibility == "READONLY")
					{
						//Do nothing special for a layout control
					}
					else
					{
						//Do nothing special for a layout control
					}
				}
				*/
			}
		}

		/**
		 * @instance
		 * @memberof HorizontalSplit
		 * @method setHeight
		 * @param {string} height
		 * @desc Set height of section (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setHeight = function (height)
		{
			this.context.options.height.set("value", height);
		}

		/**
		 * @instance
		 * @memberof HorizontalSplit
		 * @method getHeight
		 * @desc Get configured height for section (including unit)
		 * @returns {string}
		 */	
		this.constructor.prototype.getHeight = function ()
		{
			return this.context.options.height.get("value");
		}		
		
		/**
		 * @instance
		 * @memberof HorizontalSplit
		 * @method isPaneCollapsed
		 * @param {integer} index Pane index to check
		 * @desc Check if pane at <code>index</code> is collapsed
		 * @returns {boolean}
		 */	
		this.constructor.prototype.isPaneCollapsed = function(index)
		{
			var child = this._instance.splitterBody.children.item(index);

			return domClass.contains(child, "collapsed");
		}

		/**
		 * @instance
		 * @memberof HorizontalSplit
		 * @method getPaneCount
		 * @desc Count the number of panes
		 * @returns {integer}
		 */	
		this.constructor.prototype.getPaneCount = function()
		{
			return this._instance.splitterBody.children.length;
		}
		
		/**
		 * @instance
		 * @memberof HorizontalSplit
		 * @method collapsePane
		 * @param {integer} index Pane index to collapse
		 * @desc Collapse pane at the specified index
		 */	
		this.constructor.prototype.collapsePane = function(index)
		{
			var view = this;
			var child = view._instance.splitterBody.children.item(index);

			child.style.width = view._proto._getCfgChildParams(view, index).collapsedSize;
			domClass.add(child, "collapsed");
			
			//Added for US-691 : TK-1684 : STARTS
			domAttr.set(child, "aria-expanded", "false");							
			//US-691 : TK-1684 : ENDS
			var tab = child.querySelector(".tab");
			if(tab)
			{
				if(domClass.contains(tab, "last"))
					domClass.replace(tab, "fa-chevron-left", "fa-chevron-right")
				else
					domClass.replace(tab, "fa-chevron-right", "fa-chevron-left")
			}

			if(this._instance.loaded)
				bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONCOLLAPSE, index);			
		}

		/**
		 * @instance
		 * @memberof HorizontalSplit
		 * @method expandPane
		 * @param {integer} index Pane index to expand
		 * @desc Expand pane at the specified index
		 */	
		this.constructor.prototype.expandPane = function(index)
		{
			var view = this;
			var child = view._instance.splitterBody.children.item(index);

			child.style.width = view._proto._getCfgChildParams(view, index).size;
			domClass.remove(child, "collapsed");
			//Added for US-691 : TK-1684 : STARTS
			domAttr.set(child, "aria-expanded", "true");							
			//US-691 : TK-1684 : ENDS
			
			var tab = child.querySelector(".tab");
			if(tab)
			{
				if(domClass.contains(tab, "last"))
					domClass.replace(tab, "fa-chevron-right", "fa-chevron-left")
				else
					domClass.replace(tab, "fa-chevron-left", "fa-chevron-right")
			}

			if(this._instance.loaded)
				bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONEXPAND, index);
		}
		
		/**
		 * @instance
		 * @memberof HorizontalSplit
		 * @method togglePane
		 * @param {integer} index Pane index to toggle
		 * @desc Toggle pane at the specified index between collapsed and expanded
		 */	
		this.constructor.prototype.togglePane = function(index)
		{
			var child = this._instance.splitterBody.children.item(index);
			var cParams = this._proto._getCfgChildParams(this, index);
			
			if(cParams.size == child.style.width)
				this.collapsePane(index);
			else
				this.expandPane(index);
		}

		/**
		 * @instance
		 * @memberof HorizontalSplit
		 * @method getType
		 * @desc Get descriptive string representing the type of control/section
		 * @returns {string}
		 */	
		this.constructor.prototype.getType = function()
		{
			return "horizontalSplit.3";
		}
		
		/*
			Coach NG Lifecycle methods *************************************************************
		 */
		
		this.constructor.prototype.load = function()
		{
			try
			{
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCOLLAPSE, "paneIndex");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONEXPAND, "paneIndex");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONRESIZED, "paneIndex", "changedSize");

				var opts = this.context.options;
				var mdt = opts._metadata;
					
				if(!opts.paneSpecs)
					bpmext.ui.substituteConfigOption(this, "paneSpecs", {"items":[]});

				if (!opts.height)
					bpmext.ui.substituteConfigOption(this, "height", "100%");

				if (!opts.resizablePanes)
					opts.resizablePanes = bpmext.ui.substituteConfigOption(this, "resizablePanes", false);

				var cbox = this.context.element.querySelector(".ContentBox");

				this._instance.splitterBody = document.createElement("div");
				domClass.add(this._instance.splitterBody, "splitter-body");
				this.context.element.appendChild(this._instance.splitterBody);

				var children = [];
				
				for(var i = 0; i < cbox.children.length; i++)
					children.push(cbox.children[i]);

				var resizablePanes = opts.resizablePanes.get("value");
				this._proto._setHeight(this);
				this._proto._setResizablePanes(this, resizablePanes);

				bpmext.ui.loadContainer(this);

				for(var i = 0; i < children.length; i++)
				{
					var cnt = document.createElement("div");
					domClass.add(cnt, "splitter-cont");

					this._instance.splitterBody.appendChild(cnt);

					var cParams = this._proto._getCfgChildParams(this, i);
					cnt.style.width = cParams.size;
					var widthAuto = cnt.style.width == "auto";

					if ((resizablePanes) || (!widthAuto && !resizablePanes))
					{
						var splitter = document.createElement("div");
						domClass.add(splitter, "splitter");

						//Added for US-691 : TK-1684 : STARTS
						domAttr.set(splitter, "role", "separator");							
						domAttr.set(splitter, "aria-orientation", "horizontal");
						domAttr.set(splitter, "tabindex", 0);
						//US-691 : TK-1684 : ENDS
						splitter.style.width = cParams.splitterThickness;
						cnt.appendChild(splitter);

						if (resizablePanes && splitter.offsetWidth !== 0)
							this._proto._setupHandleClick(this, splitter, i);

						if(cParams.handleLocation != "N")
						{
							var tab = document.createElement("i");
							var tabCls = this._proto.OPTS_HNDL_LOC[cParams.handleLocation];
							if (tabCls == null)
								tabCls = "";

							if (resizablePanes) {
								domClass.add(tab, "tab " + tabCls);
								var icon = utilities.getCarbonIcon("ci-overflow-menu-vertical");
								domConstruct.place(icon, tab);
							}
							else {
								domClass.add(tab, "tab " + tabCls + " fa " + (i == children.length - 1 ? "last" : ""));
								this._proto._setupHandleClick(this, tab, i);
							}
							splitter.appendChild(tab);

							//Added for US-691 : TK-1684 : STARTS
							var view = this;
							var index = i;
							domAttr.set(tab, "tabindex", 0);
							if (!resizablePanes) {
								tab.addEventListener('keydown', function(evt) {	
									if(evt.key === "Enter" || evt.key === " " || evt.key === "Spacebar"){
										view.togglePane(index);
									}
								});
								this.expandPane(i);
							}
							//US-691 : TK-1684 : ENDS
						}
					}

					var child = children[i];
					cnt.appendChild(child);
					
					if(domAttr.has(child, "data-viewid"))
						this.context.createView(child);
				}

				this._instance.loaded = true;
			}
			catch (e)
			{
				bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				if(e.stack)
					bpmext.log.error("  Call stack: " + e.stack);
			}
		};

		this.constructor.prototype.unload = function()
		{
			bpmext.ui.unloadContainer(this);
		};

		this.constructor.prototype.view = function()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack)
					bpmext.log.error("  Call stack: " + e.stack);
			}
		};

		this.constructor.prototype.change = function(event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
						}
						case "height":
						{
							this._proto._setHeight(this);
							break;
						}
						case "resizablePanes":
						{
							this._proto._setResizablePanes(this, event.newVal);
							break;
						}
					}
				}
			}
			catch (e)
			{
				bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack)
					bpmext.log.error("  Call stack: " + e.stack);
			}
		};
	}
};

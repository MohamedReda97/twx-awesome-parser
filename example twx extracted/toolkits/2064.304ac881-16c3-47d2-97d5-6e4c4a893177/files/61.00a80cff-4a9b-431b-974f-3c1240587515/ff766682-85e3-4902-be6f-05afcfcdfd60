                toolbar.items[5].items[0].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "INSERT_EDIT_LINK");
                toolbar.items[5].items[1].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "INSERT_EDIT_IMAGE");

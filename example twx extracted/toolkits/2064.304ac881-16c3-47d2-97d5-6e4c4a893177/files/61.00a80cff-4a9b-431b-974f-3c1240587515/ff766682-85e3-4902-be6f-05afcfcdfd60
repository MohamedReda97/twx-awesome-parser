			}
		};

		/*
		Public control methods *************************************************************
		 */

		/**
		 * @instance
		 * @memberof TextEditor
		 * @method setLabel
		 * @param {string} label Label for the text editor
		 * @desc Set label for text editor control
		 */
		this.constructor.prototype.setLabel = function (text) {
			this.context.options._metadata.label.set("value", text);
		};

		/**
		 * @instance
		 * @memberof TextEditor
		 * @method getLabel
		 * @desc Get label associated with text editor control
		 * @returns {string}
		 */
		this.constructor.prototype.getLabel = function () {
			return this.context.options._metadata.label.get("value");
		};

		/**
		 * @instance
		 * @memberof TextEditor
		 * @method isLabelVisible
		 * @desc Get label visibility for text editor control
		 * @returns {boolean}
		 */
		this.constructor.prototype.isLabelVisible = function () {
			return this.context.options._metadata.labelVisibility.get("value") == "SHOW";
		};

		/**
		 * @instance
		 * @memberof TextEditor
		 * @method setLabelVisible
		 * @param {boolean} flag Set to <code>true</code> to make the label visible.
		 * @desc Set label visibility for text editor control
		 */
		this.constructor.prototype.setLabelVisible = function (flag) {
			this.context.options._metadata.labelVisibility.set("value", flag ? "SHOW" : "HIDE");
		};

		/**
		 * @instance
		 * @memberof TextEditor
		 * @method getText
		 * @desc Get text for text editor control
		 * @returns {string}
		 */
		this.constructor.prototype.getText = function () {
			var res = this.getData();
			return res == null ? "" : res;
		};

		/**
		 * @instance
		 * @memberof TextEditor
		 * @method setText
		 * @param {string} text Text to be set in the editor
		 * @desc Set text for text editor control
		 */
		this.constructor.prototype.setText = function (text) {
			this.context.binding.set("value", text);
		};


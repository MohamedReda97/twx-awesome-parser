                toolbar.items[4].items[0].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "BULLET_LIST");
                toolbar.items[4].items[0].settings.menu[0].text = bpmext.localization.formatMsg("controlTextEditor", "DEFAULT");
                toolbar.items[4].items[0].settings.menu[1].text = bpmext.localization.formatMsg("controlTextEditor", "CIRCLE");
                toolbar.items[4].items[0].settings.menu[2].text = bpmext.localization.formatMsg("controlTextEditor", "DISC");
                toolbar.items[4].items[0].settings.menu[3].text = bpmext.localization.formatMsg("controlTextEditor", "SQUARE");
                //Numbered List
                toolbar.items[4].items[1].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "NUMBERED_LIST");
                toolbar.items[4].items[1].settings.menu[0].text = bpmext.localization.formatMsg("controlTextEditor", "DEFAULT");
                toolbar.items[4].items[1].settings.menu[1].text = bpmext.localization.formatMsg("controlTextEditor", "LOWER_ALPHA");
                toolbar.items[4].items[1].settings.menu[2].text = bpmext.localization.formatMsg("controlTextEditor", "LOWER_GREEK");
                toolbar.items[4].items[1].settings.menu[3].text = bpmext.localization.formatMsg("controlTextEditor", "LOWER_ROMAN");
                toolbar.items[4].items[1].settings.menu[4].text = bpmext.localization.formatMsg("controlTextEditor", "UPPER_ALPHA");
                toolbar.items[4].items[1].settings.menu[5].text = bpmext.localization.formatMsg("controlTextEditor", "UPPER_ROMAN");

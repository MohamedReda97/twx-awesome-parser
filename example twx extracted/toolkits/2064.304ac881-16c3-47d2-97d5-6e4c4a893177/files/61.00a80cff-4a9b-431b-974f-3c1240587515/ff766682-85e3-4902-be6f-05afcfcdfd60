	if (!this.constructor.prototype._proto) {
		this.constructor.prototype._proto = {
			EVT_ONLOAD : "eventON_LOAD",
			EVT_ONCHANGE : "eventON_CHANGE",
			EVT_ONFOCUS : "eventON_FOCUS",
			EVT_ONBLUR : "eventON_BLUR",
			_setText : function (view, text) {
				try {
					if (text == null)
						text = "";

					if (view._instance.textEditorControl) {
						view._instance.textEditorControl.setContent(text);
					}
				} catch (e) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextEditor._setText() error: " + e);
					bpmext.log.error("TextEditor._setText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_getText : function (view) {
				var toReturn;
				if (view._instance.textEditorControl) {
					toReturn = view._instance.textEditorControl.getContent();
				}
				return toReturn;
			},
			_getLabelElt : function (view) {
				if (!view._instance.label)
					this._createLabel(view);

				return view._instance.label;
			},
			_createLabel : function (view) {
				view._instance.label = document.createElement("label");
				domClass.add(view._instance.label, "control-label");
				// domConstruct.place(view._instance.label, view._instance.group, "first");
				view._instance.header.appendChild(view._instance.label);
				domAttr.set(view._instance.label, "for", view._instance.text.id);
			},
			_setLabelVisibility : function (view, flag) {
				try {
					if (!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
				} catch (e) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextEditor._setLabelVisibility() error: " + e);
					bpmext.log.error("TextEditor._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabel : function (view, label) {
				try {
					if (label) {
						if (!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label,
							view._instance.label.innerHTML,
							view._instance.baseTxtDir,
							view._instance.genPrefTextDir);
					} else {
						if (view._instance.label) {
							view._instance.group.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				} catch (e) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextEditor._setLabel() error: " + e);
					bpmext.log.error("TextEditor._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHelpText : function (view, text)
			{
				utilities.setHelpText(view, text);
			},
			_setWidth : function (view, width) {
				try {
					var container = view._instance.textEditorControl ? view._instance.textEditorControl.getContainer() : undefined;
					if (width != null && width != "") {
						if (!isNaN(width))
							width += "px";

						if (container) {
							container.style.width = width;
						}

						domClass.add(view.context.element, "widthSet");
					} else {
						if (container) {
							container.style.width = null;
						}

						domClass.remove(view.context.element, "widthSet");
					}
				} catch (e) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextEditor._setWidth() error: " + e);
					bpmext.log.error("TextEditor._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHeight : function (view, height) {
				try {
					if (height != null && height != "") {
						if (!isNaN(height))
							height += "px";

						var container = view._instance.textEditorControl ? view._instance.textEditorControl.getContentAreaContainer() : undefined;
						if (container && container.firstChild) {
							container.firstChild.style.height = height;
						}
					}
				} catch (e) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextEditor._setHeight() error: " + e);
					bpmext.log.error("TextEditor._setHeight() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setTabIndex : function (view, index) {
				if (index != null) {
					var container = view._instance.textEditorControl ? view._instance.textEditorControl.getContentAreaContainer() : undefined;
					if (container && container.firstChild) {
						domAttr.set(container.firstChild, "tabindex", index);
					}
				} else
					domAttr.remove(view._instance.text, "tabindex");
			},
			_handleVisibility : function (view) {
				var visibility = bpmext.ui.getEffectiveVisibility(view);

				if (visibility != "NONE") {
					var readonly = false;
					if (visibility == "READONLY") {
						readonly = true;
						// domClass.remove(view._instance.disabler, "hidden");
					}
					// else {
						// domClass.add(view._instance.disabler, "hidden");
					// }

					if (view._instance.textEditorControl) {
						view._instance.textEditorControl.setMode(readonly ? "readonly" : "design");
					}
				}

				//{#bug: BG-444 Improper visibility behavior}
				var vis = utilities.handleVisibility(view.context);
				if (view._instance.textEditorControl && (vis == "NONE" || vis == "HIDDEN")) {
					view._instance.textEditorControl.notificationManager.close();
				}
			},
			_updateControl : function (view) {
				if(!view._instance.infoWrapper) {
					view._instance.infoWrapper = document.createElement("span");
					domClass.add(view._instance.infoWrapper, "info-wrapper");
					view._instance.header.appendChild(view._instance.infoWrapper);
				}
					
				var errors = bpmext.ui.getViewValidationErrors(view);

				//Color style
				var colStyle = errors ? "E" : "D";

				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_COL_STL_CLZ, colStyle, view._instance.oldColStyle);
				view._instance.oldColStyle = colStyle;

				//Validation Error Icon
				if (view._instance.icon) {
					bpmext.ui.util.closeTooltip(view._instance.iconTT, view._instance.icon);
					delete view._instance.iconTT;

					view._instance.infoWrapper.removeChild(view._instance.validation);
					delete view._instance.icon;
                    delete view._instance.validation;
				}

				if (errors) {
					view._instance.validation = document.createElement("span");
					domClass.add(view._instance.validation, "validation");

					view._instance.icon = document.createElement("i");
					domAttr.set(view._instance.icon, "tabindex", 0);
					domClass.add(view._instance.icon, "fa fa-fw fa-exclamation-circle validationIcon");

					view._instance.validation.appendChild(view._instance.icon);

					view._instance.infoWrapper.appendChild(view._instance.validation);
					
					var ttOpts = {
						horizontalPos : "left",
						verticalPos : "top",
						cssClass : "validationError",
						plainText : false,
						smartPositioning: true
					};

					view._instance.iconTT = bpmext.ui.util.showTooltip(
							view._instance.icon,
							bpmext.ui.util.formatErrors(errors),
							ttOpts);
				} else {
					domClass.remove(view._instance.group, "has-feedback has-error");
				}
			},
			_setStatusBarVis : function (view, vis) {
				for (var i = 0; i < view._instance.textEditorControl.editorContainer.childNodes[0].childNodes.length; i++) {
					if (domClass.contains(view._instance.textEditorControl.editorContainer.childNodes[0].childNodes[i], "mce-statusbar"))
						domClass.toggle(view._instance.textEditorControl.editorContainer.childNodes[0].childNodes[i], "hidden", !vis);
				}
			},
			_getSelection : function (node) {
				var start = 0,
				end = 0,
				normalizedValue,
				range,
				textInputRange,
				len,
				endRange;

				if (typeof node.selectionStart == "number" && typeof node.selectionEnd == "number") {
					start = node.selectionStart;
					end = node.selectionEnd;
				} else {
					range = document.selection.createRange();

					if (range && range.parentElement() == node) {
						len = node.value.length;
						normalizedValue = node.value.replace(/\r\n/g, "\n");
						textInputRange = node.createTextRange();
						textInputRange.moveToBookmark(range.getBookmark());
						endRange = node.createTextRange();
						endRange.collapse(false);

						if (textInputRange.compareEndPoints("StartToEnd", endRange) > -1)
							start = end = len;
						else {
							start = -textInputRange.moveStart("character", -len);
							start += normalizedValue.slice(0, start).split("\n").length - 1;

							if (textInputRange.compareEndPoints("EndToEnd", endRange) > -1)
								end = len;
							else {
								end = -textInputRange.moveEnd("character", -len);
								end += normalizedValue.slice(0, end).split("\n").length - 1;
							}
						}
					}
				}

				return {
					"start" : start,
					"end" : end
				};
			},
			_normalizeColorMap : function (view, colorMap) {
				var res = [];

				var rows = view.context.options.colorRows.get("value");
				var cols = view.context.options.colorCols.get("value");
				var numColors = rows * cols - 1;

				for (var i = 0; i < numColors && i < colorMap.length; i++) {
					if (colorMap[i].value.charAt(0) === '#') {
						res.push(colorMap[i].value.substring(1));
					} else {
						res.push(colorMap[i].value);
					}
					res.push(colorMap[i].name);
				}

				return res;
			},
			
            //284612: Add NL Strings
			_addNLStrings : function(editor) {
			    //update menu items recursivley
			    var updateMenuItem = function(menu) {
			       if (!!menu.text) {
			           var title = bpmext.localization.formatMsg("controlTextEditor", menu.text.toUpperCase().replace(/ /g, "_").replace(/\//g,""));
			           if (!!title && title != "" && title.indexOf("MESSAGE[") != 0) {
			             menu.text = title;  
			           }
			           
			       }
			       var item;
		           if (!!menu.menu) {
		               if (!!menu.menu.items) {
		                   for (item=0; item < menu.menu.items.length; item++) {
                               updateMenuItem(menu.menu.items[item]);
		                   }
		               } else {
	                       for (item in menu.menu) {
	                           updateMenuItem(menu.menu[item]);
	                       }
		               }
		           }
			    };
			    
			    var item;
			    for (item in editor.menuItems) {
			        updateMenuItem(editor.menuItems[item]);
			    }
			    
			    //Buttons
			    var toolbar = editor.theme.panel.settings.items[0].items[1].items[0]; 
                //Undo-Redo
                toolbar.items[0].items[0].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "UNDO");
                toolbar.items[0].items[1].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "REDO");

                toolbar.items[1].items[0].settings.text = bpmext.localization.formatMsg("controlTextEditor", "FORMATS");
                //Bold-Italic
                toolbar.items[2].items[0].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "BOLD");
                toolbar.items[2].items[1].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "ITALIC");
                //Text Alignment
                toolbar.items[3].items[0].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "ALIGN_LEFT");
                toolbar.items[3].items[1].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "ALIGN_CENTER");
                toolbar.items[3].items[2].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "ALIGN_RIGHT");
                toolbar.items[3].items[3].settings.tooltip = bpmext.localization.formatMsg("controlTextEditor", "JUSTIFY");

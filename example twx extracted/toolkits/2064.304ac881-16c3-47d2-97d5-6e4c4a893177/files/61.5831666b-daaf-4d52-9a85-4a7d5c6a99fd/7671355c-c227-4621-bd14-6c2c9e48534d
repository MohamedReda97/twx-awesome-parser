var mixObject = {
	createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			this.context.coachViewData.containingDiv = containingDiv;
			var tempID;
			
			while(true) {
				tempID = dojox.uuid.generateRandomUuid();
				if(this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']") == null)
					break;
			}
			
			this.context.coachViewData.containingDiv.setAttribute("data-temp-id", tempID);
			this.context.coachViewData.formGroupDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.containingDiv, "Caption_Box");
			domClass.add(this.context.coachViewData.containingDiv, "SPARKCapBox");
			
			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.label = domConstruct.create("span");
			domClass.add(this.context.coachViewData.label, "control-label");
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);
						
			domConstruct.place(this.context.coachViewData.formGroupDiv, this.context.coachViewData.containingDiv);
			domClass.add(this.context.coachViewData.formGroupDiv, "form-group");
			domClass.add(this.context.coachViewData.formGroupDiv, "label-top");
			domClass.add(this.context.coachViewData.formGroupDiv, "cap-top");
			
			this.context.coachViewData.contentBoxDiv = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']  .DesignContentBox");
			
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.label);
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.contentBoxDiv);
			
			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, this.context.coachViewData.label, undefined, true, true);
			
			callback();
		}));	
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.label;
	},
	propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, configHelper){
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.context.coachViewData.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.context.coachViewData.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "labelPlacement"){ 
				var labelPlacement;
				if(propertyValue == "L"){
					labelPlacement = "label-left cap-left";
				} else if(propertyValue == "R"){
					labelPlacement = "label-right cap-right";
				} else if(propertyValue == "B"){
					labelPlacement = "label-bottom cap-bottom";
				} else if(propertyValue == "T"){
					labelPlacement = "label-top cap-top";
				} else {
					labelPlacement = "label-top cap-top";
				}
				
				if(propertyValue===null || propertyValue===undefined || propertyValue == "L" || propertyValue == "T"){
					this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.label);
					this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.contentBoxDiv);
				}else{
					this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.contentBoxDiv);
					this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.label);
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, labelPlacement, "label-left cap-left label-right cap-right label-bottom cap-bottom label-top cap-top");
			} else if(propertyName == "labelHorizAlign"){ 
				var labelHAlign;
				if(propertyValue == "L"){
					labelHAlign = "hclbl-left";
				} else if(propertyValue == "C"){
					labelHAlign = "hclbl-center";
				} else if(propertyValue == "R"){
					labelHAlign = "hclbl-right";
				} else {
					labelHAlign = "hclbl-left";
				}
				domClass.replace(this.context.coachViewData.label, labelHAlign, "hclbl-left hclbl-center hclbl-right");
			} else if(propertyName == "labelVertAlign"){ 
				var labelVAlign;
				if(propertyValue == "T"){
					labelVAlign = "vclbl-top";
				} else if(propertyValue == "M"){
					labelVAlign = "vclbl-middle";
				} else if(propertyValue == "B"){
					labelVAlign = "vclbl-bottom";
				} else {
					labelVAlign = "vclbl-top";
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, labelVAlign, "vclbl-top vclbl-middle vclbl-bottom");
			} else if(propertyName == "labelSizeStyle"){
				var labelSizeStyle;
				if(propertyValue == "R"){
					labelSizeStyle = "text-slg";
				} else if(propertyValue == "X"){
					labelSizeStyle = "text-xlg";
				} else if(propertyValue == "G"){
					labelSizeStyle = "text-lg";
				} else if(propertyValue == "L"){
					labelSizeStyle = "text-bg";
				} else if(propertyValue == "S"){
					labelSizeStyle = "text-sm";
				} else if(propertyValue == "M"){
					labelSizeStyle = "text-xs";
				} else {
					labelSizeStyle = "";
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, labelSizeStyle, "text-slg text-xlg text-lg text-bg text-sm text-xs");
			} else if(propertyName == "labelColorStyle"){
				var labelColorStyle;
				if(propertyValue == "H"){
					labelColorStyle = "";
				} else if(propertyValue == "D"){
					labelColorStyle = "text-default";
				} else if(propertyValue == "M"){
					labelColorStyle = "text-muted";
				} else if(propertyValue == "L"){
					labelColorStyle = "text-light-gray";
				} else if(propertyValue == "P"){
					labelColorStyle = "text-primary";
				} else if(propertyValue == "I"){
					labelColorStyle = "text-info";
				} else if(propertyValue == "S"){
					labelColorStyle = "text-success";
				} else if(propertyValue == "W"){
					labelColorStyle = "text-warning";
				} else if(propertyValue == "G"){
					labelColorStyle = "text-danger";
				} else {
					labelColorStyle = "";
				}
				domClass.replace(this.context.coachViewData.label, labelColorStyle, "text-default text-muted text-light-gray text-primary text-info text-success text-warning text-danger");
			} else if(propertyName == "labelWeightStyle"){
				var labelWeightStyle;
				if(propertyValue == "S"){
					labelWeightStyle = "text-slim";
				} else if(propertyValue == "N"){
					labelWeightStyle = "text-normal";
				} else if(propertyValue == "M"){
					labelWeightStyle = "text-semibold";
				} else if(propertyValue == "B"){
					labelWeightStyle = "text-bold";
				} else {
					labelWeightStyle = "";
				}
				domClass.replace(this.context.coachViewData.label, labelWeightStyle, "text-slim text-normal text-semibold text-bold");
			} else if(propertyName == "width"){
				this.context.coachViewData.width = propertyValue;
				if(!!propertyValue) {					
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
            } else if (propertyName == "labelWidth") {
                if (propertyValue) {
                    this.context.coachViewData.label.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue + "px");
                    domClass.add(this.context.coachViewData.containingDiv, "labelWidth");
                } else {
                    this.context.coachViewData.label.style.width = "";
                    domClass.remove(this.context.coachViewData.containingDiv, "labelWidth");
                }
			} else if(propertyName == "shrinkToContent"){ 
				var shrinkToContent;
				if(propertyValue){
					shrinkToContent = "shrink-to-cnt";
				} else {
					shrinkToContent = "";
				} 
				domClass.replace(this.context.coachViewData.formGroupDiv, shrinkToContent, "shrink-to-cnt");
			}
		}));
    },
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
	}
};

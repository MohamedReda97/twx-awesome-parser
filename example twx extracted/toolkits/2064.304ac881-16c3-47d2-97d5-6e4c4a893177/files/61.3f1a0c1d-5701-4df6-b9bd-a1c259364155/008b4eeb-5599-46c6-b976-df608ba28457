 /** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setValue(${Text1}.getText())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Change:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when the bound data changes.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${Text2}.setText(me.getValue())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
 bpmext_control_InitData = function(bpmext)
{
	this._instance = {};
	
	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE"
		}

		/**
		 * @instance
		 * @memberof Data
		 * @method setValue
		 * @param {*} value May be any type, depending on what the Data control is bound to, including complex types
		 * @desc Sets the value of the data control
		 */
		this.constructor.prototype.setValue = function(value)
		{
			this.context.binding.set("value", value);
		}

		/**
		 * @instance
		 * @memberof Data
		 * @method getValue
		 * @desc Get the value of the data control
		 * @returns {*}
		 */
		this.constructor.prototype.getValue = function()
		{
			return this.context.binding.get("value");
		}
		
		/**
		 * @instance
		 * @memberof Data
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string} 
		 */		
		this.constructor.prototype.getType = function()
		{
			return "data.3";
		}
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function()
		{
			try
			{
				if (!this.context.binding)
					this.context.binding = bpmext.ui.substituteObject(this, null, null, null);
				else
				{
					var val = this.context.binding.get("value");
					if(val !== null && val !== undefined && typeof val.bindAll == "function")
						this._instance.bindAllHandle = this.context.binding.get("value").bindAll(this.change, this);
				}
				
				this.context.element.style.position = "absolute";
				
				//{#bug: 418 added definition for view, as the lack was breaking formulas}
				var view = this;
				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					function (expResult)
					{
						if (expResult == undefined)
						{
							expResult = null;
						}

						view.setValue(expResult);
					},
					this.getValue
					);	

				bpmext.ui.loadView(this);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGE);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		}
		
		this.constructor.prototype.change = function(event)
		{
			try
			{
				if (event.type == "config")
				{

				}
				else
				{
					if(event.newVal != event.oldVal)
					{
						bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE, event.newVal, event.oldVal);
						
						//BG-920 added to handle unbinding from Complex type
						if (this._instance.bindAllHandle != null)
						{
						    this._instance.bindAllHandle.unbind();
						    this._instance.bindAllHandle = null;
						}
						
						//BG-920 added to handle binding to Complex type
						var val = this.context.binding.get("value");
						if(val !== null && val !== undefined && typeof val.bindAll == "function")
						    this._instance.bindAllHandle = this.context.binding.get("value").bindAll(this.change, this);
					
						//Let subscribers know this control's value has changed
						bpmext.ui.broadcastExpressionTrigger(this, bpmext.ui.PHASE_NORMAL); 
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.unload = function()
		{
			bpmext.ui.unloadView(this);
			if(this._instance.bindAllHandle)
				this._instance.bindAllHandle.unbind();
		};

		this.constructor.prototype.view = function()
		{
		
		};
	}
};

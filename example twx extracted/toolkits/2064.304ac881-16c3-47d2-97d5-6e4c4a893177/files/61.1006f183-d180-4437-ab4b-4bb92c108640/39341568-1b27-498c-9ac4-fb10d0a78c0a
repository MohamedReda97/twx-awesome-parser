var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", "dojo/dom-style", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, domStyle, bpmext){			
			bpmext.uidesign.css.ensureGlyphsLoaded(this);						
			
			this.context.coachViewData.containingDiv = containingDiv;	
			
			var tempID;
			while(true) {
				tempID = dojox.uuid.generateRandomUuid();
				if(this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']") == null)
					break;
			}
			
			this.context.coachViewData.containingDiv.setAttribute("data-temp-id", tempID);
			
			domClass.add(this.context.coachViewData.containingDiv, "Modal-Section"); 			
						
			this.context.coachViewData.modalSectionWrapper = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "'] .modal");
			domClass.add(this.context.coachViewData.modalSectionWrapper, "fade in");
			domClass.remove(this.context.coachViewData.modalSectionWrapper, "modal");
						
			this.context.coachViewData.modalDialogDiv = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "'] .modal-dialog");	
			domClass.remove(this.context.coachViewData.modalDialogDiv, "modal-dialog");
			
			this.context.coachViewData.modelContentDiv = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "'] .modal-content");						
			domStyle.set(this.context.coachViewData.modelContentDiv,{"border": "4px solid #e7e7e7","width": "100%"});
															
			this.context.coachViewData.contentBoxDiv = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']  .DesignContentBox");			
			domStyle.set(this.context.coachViewData.contentBoxDiv,{"width": "100%"});										
									
			this.context.coachViewData.modalDialogDiv.appendChild(this.context.coachViewData.modelContentDiv);																				
			this.context.coachViewData.modalSectionWrapper.appendChild(this.context.coachViewData.modalDialogDiv);						
			domStyle.set(this.context.coachViewData.modalSectionWrapper, "display", "none");
			
			this.context.coachViewData.openModalSectiontBtn = domConstruct.create("button");								
			var modalAlertPaletteImage  = this.context.getManagedAssetUrl("BPMExt-Control-ModalSection-Palette.png", this.context.assetType_WEB, "SYSBPMUI");
			domAttr.set(this.context.coachViewData.openModalSectiontBtn, "style", "width:30px;height:30px;background-image :url('"+modalAlertPaletteImage+"');background-repeat:no-repeat;");							
			
			this.context.coachViewData.buttonGroupWrap = null;
			this.context.coachViewData.primaryBtn = null;
			this.context.coachViewData.secondaryBtn = null;
			
			var _this = this;
			bpmext.uidesign.loadLocalization(this, function(){
				domAttr.set(_this.context.coachViewData.openModalSectiontBtn, "title", bpmext.localization.formatMsg("controlModalSection", "OPEN_MODAL_SECTION_TITLE"));
				
				_this.context.coachViewData.defaultPrimaryBtnText = bpmext.localization.formatMsg("controlModalSection", "PRIMARY_BTN_TEXT");
				_this.context.coachViewData.defaultSecondaryBtnText = bpmext.localization.formatMsg("controlModalSection", "SECONDARY_BTN_TEXT");
				_this.context.coachViewData.primaryBtnText = _this.context.coachViewData.defaultPrimaryBtnText;
				_this.context.coachViewData.secondaryBtnText = _this.context.coachViewData.defaultSecondaryBtnText;
			});
			
			this.context.coachViewData.closeModalSectiontBtn = domConstruct.create("button");
			domClass.add(this.context.coachViewData.closeModalSectiontBtn, "icon btn fa fa-times");				
			//domAttr.set(this.context.coachViewData.closeModalSectiontBtn, "style", "width:30px;height:30px;");
			bpmext.uidesign.loadLocalization(this, function(){
				domAttr.set(_this.context.coachViewData.closeModalSectiontBtn, "title", bpmext.localization.formatMsg("controlModalSection", "CLOSE_MODAL_SECTION_TITLE"));
			});
			domStyle.set(this.context.coachViewData.closeModalSectiontBtn,{"color": "red","cursor": "pointer"});
			
			domStyle.set(this.context.coachViewData.closeModalSectiontBtn, "display", "none");
			
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.openModalSectiontBtn);
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.closeModalSectiontBtn);
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.modalSectionWrapper);				
						
			domStyle.set(this.context.coachViewData.containingDiv,{"width": "100%","padding": "10px","position": "relative"});										
			
			this.context.coachViewData.openModalSectiontBtn.onclick = this.lang.hitch(this, function(e){
				domStyle.set(this.context.coachViewData.openModalSectiontBtn, "display", "none");
				domStyle.set(this.context.coachViewData.closeModalSectiontBtn, "display", "block");	
				domStyle.set(this.context.coachViewData.modalSectionWrapper, "display", "block");											
			});	
			
			this.context.coachViewData.closeModalSectiontBtn.onclick = this.lang.hitch(this, function(e){
				domStyle.set(this.context.coachViewData.closeModalSectiontBtn, "display", "none");
				domStyle.set(this.context.coachViewData.openModalSectiontBtn, "display", "block");	
				domStyle.set(this.context.coachViewData.modalSectionWrapper, "display", "none");							
			});
			
			callback();
		}));	
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){															
			
			if(propertyName == "@label") {							
				dojo.attr(this.context.coachViewData.modalSectionWrapper, "aria-label", propertyValue);
			} else if(propertyName ==  "@labelVisibility"){
			
			} else if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "modalWellWidth"){				
				if(!!propertyValue) {					
					this.context.coachViewData.modalDialogDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {					
					this.context.coachViewData.modalDialogDiv.style.width = "";
				}
			} else if (propertyName === "showModalButtonGroup") {
				this.context.coachViewData.showModalButtonGroup = propertyValue;
				this.refreshButtonGroup();
			} else if (propertyName === "colorStyle") {
				this.context.coachViewData.colorStyle = propertyValue;
				this.refreshColorStyle(this.context.coachViewData.primaryBtn, propertyValue);
			} else if (propertyName === "primaryBtnText") {
				this.context.coachViewData.primaryBtnText = propertyValue;
				this.updateBtnText(this.context.coachViewData.primaryBtn, propertyValue);
			} else if (propertyName === "secondaryBtnText") {
				this.context.coachViewData.secondaryBtnText = propertyValue;
				this.updateBtnText(this.context.coachViewData.secondaryBtn, propertyValue);
			}
			/*
			* Disabling as part of Defect#283852
			else if(propertyName == "closeOnClick"){					
				if(propertyValue == true){
					this.context.coachViewData.modalDialogDiv.onclick = this.lang.hitch(this, function(e){
						domStyle.set(this.context.coachViewData.closeModalSectiontBtn, "display", "none");
						domStyle.set(this.context.coachViewData.openModalSectiontBtn, "display", "block");
						domStyle.set(this.context.coachViewData.modalSectionWrapper, "display", "none");
					});
				}else{
					this.context.coachViewData.modalDialogDiv.onclick = this.lang.hitch(this, function(e){
						domStyle.set(this.context.coachViewData.openModalSectiontBtn, "display", "none");
						domStyle.set(this.context.coachViewData.closeModalSectiontBtn, "display", "block");						
						domStyle.set(this.context.coachViewData.modalSectionWrapper, "display", "block");
					});
				}
			}
			*/
		}));	
    },
	
	modelChanged: function(propertyName, propertyValue) {
				
	},
	
	refreshButtonGroup: function () {
		var show = this.context.coachViewData.showModalButtonGroup;
		
		var modelContentDiv = this.context.coachViewData.modelContentDiv;
		var buttonGroupWrap = this.context.coachViewData.buttonGroupWrap;
		
		if (!show && !!buttonGroupWrap) {
			domConstruct.destroy(this.context.coachViewData.buttonGroupWrap);
			domConstruct.destroy(this.context.coachViewData.primaryBtn);
			domConstruct.destroy(this.context.coachViewData.secondaryBtn);
			
			this.context.coachViewData.buttonGroupWrap = null;
			this.context.coachViewData.primaryBtn = null;
			this.context.coachViewData.secondaryBtn = null;
		} else if (show && !buttonGroupWrap) {
			buttonGroupWrap = domConstruct.create("div", {class: "modal_btn_group"}, modelContentDiv, "last");

			this.context.coachViewData.buttonGroupWrap = buttonGroupWrap;
			this.context.coachViewData.primaryBtn = domConstruct.create("button", null, buttonGroupWrap, "last");
			this.context.coachViewData.secondaryBtn = domConstruct.create("button", null, buttonGroupWrap, "first");
			
			this.refreshColorStyle(this.context.coachViewData.primaryBtn, this.context.coachViewData.colorStyle);
			this.updateBtnText(this.context.coachViewData.primaryBtn, this.context.coachViewData.primaryBtnText);
			
			this.refreshColorStyle(this.context.coachViewData.secondaryBtn, "B");
			this.updateBtnText(this.context.coachViewData.secondaryBtn, this.context.coachViewData.secondaryBtnText);
		}
	},
	
	refreshColorStyle: function (btn, colorStyle) {
		if (btn) {
			var btnClass = "btn modal_btn";
			
			if (colorStyle == "P") {
				btnClass += " btn-primary";
			} else if (colorStyle === "I") {
				btnClass += " btn-info";
			} else if (colorStyle === "S") {
				btnClass += " btn-success";
			} else if (colorStyle === "W") {
				btnClass += " btn-warning";
			} else if (colorStyle === "G" || colorStyle === "E") {
				btnClass += " btn-danger ";
			} else if (colorStyle === "B") {
				btnClass += " btn-dark";
			}
			
			domClass.remove(btn);
			domClass.add(btn, btnClass);
		}
	},
	
	updateBtnText: function(btn, text) {
		if (btn && btn.innerText !== text) {
			btn.innerText = text || "";
		}
	}
};

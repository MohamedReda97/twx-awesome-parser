bpmext_control_InitSpacer = function (bpmext, utilities, domClass)
{
	this._instance =
	{
	};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			_setWidth : function (view)
			{
				var size = view.context.options.width.get("value");
				
				try
				{
					if(size != null && size != "")
					{
						if (!isNaN(size))
							size += "px";

						view.context.element.style.width = size;
					}
					else 
					{
						view.context.element.style.width = null;
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Spacer._setWidth() error: " + e);
					bpmext.log.error("Spacer._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHeight : function (view)
			{
				var size = view.context.options.height.get("value");
				
				try
				{
					if(size != null && size != "")
					{
						if (!isNaN(size))
							size += "px";

						view.context.element.style.height = size;
					}
					else 
					{
						view.context.element.style.height = null;
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Spacer._setHeight() error: " + e);
					bpmext.log.error("Spacer._setHeight() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setAnimateSizeChanges : function(view)
			{
				var asc = view.context.options.animateSizeChgs.get("value");
				if(asc)
					domClass.add(view.context.element, "animSzCh");
				else
					domClass.remove(view.context.element, "animSzCh");
			},
			_handleVisibility : function (view)
			{
				var vis = utilities.handleVisibility(view.context);
			}
		};
		

		/*
		Public control methods *************************************************************
		 */
		 
		/**
		 * @instance
		 * @memberof Spacer
		 * @method setWidth
		 * @param {string} width Spacer width
		 * @desc Set width of spacer (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (size)
		{
			this.context.options.width.set("value", size);
		}

		/**
		 * @instance
		 * @memberof Spacer
		 * @method getWidth
		 * @desc Get configured width for spacer (including unit)
		 * @returns {string}
		 */	
		this.constructor.prototype.getWidth = function ()
		{
			return this.context.options.width.get("value");
		}

		/**
		 * @instance
		 * @memberof Spacer
		 * @method setHeight
		 * @param {string} height Spacer height
		 * @desc Set height of spacer (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setHeight = function (size)
		{
			this.context.options.height.set("value", size);
		}

		/**
		 * @instance
		 * @memberof Spacer
		 * @method getHeight
		 * @desc Get configured height for spacer (including unit)
		 * @returns {string}
		 */	
		this.constructor.prototype.getHeight = function ()
		{
			return this.context.options.height.get("value");
		}	
		
		/**
		 * @instance
		 * @memberof Spacer
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "spacer.3";
		}
		
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				if(!opts.animateSizeChgs)
					opts.animateSizeChgs = bpmext.ui.substituteConfigOption(this, "animateSizeChgs", false);
				
				if (!opts.width)
					opts.width = bpmext.ui.substituteConfigOption(this, "width", null);

				if (!opts.height)
					opts.height = bpmext.ui.substituteConfigOption(this, "height", null);

				this._proto._setWidth(this);
				this._proto._setHeight(this);
				this._proto._setAnimateSizeChanges(this);

				bpmext.ui.loadView(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "width":
						{
							this._proto._setWidth(this);
							break;
						}
						case "height":
						{
							this._proto._setHeight(this);
							break;
						}
						case "animateSizeChgs":
						{
							this._proto._setAnimateSizeChanges(this);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}
}

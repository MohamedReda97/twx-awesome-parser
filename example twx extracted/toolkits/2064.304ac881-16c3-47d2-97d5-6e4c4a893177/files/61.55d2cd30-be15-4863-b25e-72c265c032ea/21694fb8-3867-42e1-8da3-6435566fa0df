var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			bpmext.uidesign.css.ensureGeneralStylesLoaded(this);

			this.context.coachViewData.containingDiv = containingDiv;
			
			var tempID;
			while(true) {
				tempID = dojox.uuid.generateRandomUuid();
				if(this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']") == null)
					break;
			}
			this.context.coachViewData.dataLabel = labelText;
			this.context.coachViewData.dataShowLabel = false;
			
			this.context.coachViewData.containingDiv.setAttribute("data-temp-id", tempID);
			
			this.context.coachViewData.root = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "'] > .DesignSectionRoot");
			this.context.coachViewData.outerDiv = this.context.coachViewData.root;
			this.context.coachViewData.label = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']  .control-label");
			this.context.coachViewData.innerDiv = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "'] .inner");
			this.context.coachViewData.contentBoxDiv = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']  .DesignContentBox");

			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.containingDiv.removeAttribute("data-temp-id");
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);
			
			this.context.coachViewData.isTooltipVisible = false;
			this.context.coachViewData.updateHorizontalPosition = this.lang.hitch(this, function(value){
				var horizontalPos;
				if(this.context.coachViewData.tooltip){
					if(value == "R"){
						horizontalPos = "alignRight";
					} else if(value == "C"){
						horizontalPos = "alignCenter";
					} else {
						horizontalPos = "alignLeft";
					}
					domClass.replace(this.context.coachViewData.tooltip, horizontalPos, "alignLeft alignRight alignCenter");
				}
			});

			this.context.coachViewData.updateVerticalPosition = this.lang.hitch(this, function(value){
				var verticalPos;
				if(this.context.coachViewData.tooltip){
					if(value == "B"){
						verticalPos = "bottom";
                        this.context.coachViewData.tooltip.style.top = "";
					} else {
						verticalPos = "top";
                        this.context.coachViewData.tooltip.style.top = "0";
					}
					domClass.replace(this.context.coachViewData.tooltip, verticalPos, "top bottom");
				}
			});
			//default is hidden label
			this.context.coachViewData.label.style.display = "none";
			//let common handler do the visibility==required setting.  We handle the rest because of the strange behaviour of this control.
			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(undefined, undefined, this.context.coachViewData.containingDiv, false, false);
			callback();
		}));
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class",  "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			this.context.coachViewData.createToolTipNode = this.lang.hitch(this, function(tooltipText){
				this.context.coachViewData.tooltip = domConstruct.create("div");
				domClass.add(this.context.coachViewData.tooltip, "tooltip fade in");
				this.context.coachViewData.tooltipArrow = domConstruct.create("div");
				domClass.add(this.context.coachViewData.tooltipArrow, "tooltip-arrow");
				this.context.coachViewData.tooltipInner = domConstruct.create("div");
				this.context.coachViewData.tooltipTextNode = document.createTextNode(tooltipText);
				this.context.coachViewData.tooltipInner.appendChild(this.context.coachViewData.tooltipTextNode);
				domClass.add(this.context.coachViewData.tooltipInner, "tooltip-inner");
				
				var horizontalPositionValue = configHelper.getConfigOptionValue(this, "horizontalPos");
				this.context.coachViewData.updateHorizontalPosition(horizontalPositionValue);
				var verticalPositionValue = configHelper.getConfigOptionValue(this, "verticalPos");
				this.context.coachViewData.updateVerticalPosition(verticalPositionValue);
				
				this.context.coachViewData.tooltip.appendChild(this.context.coachViewData.tooltipArrow);
				this.context.coachViewData.tooltip.appendChild(this.context.coachViewData.tooltipInner);
				this.context.coachViewData.innerDiv.appendChild(this.context.coachViewData.tooltip);
			});
			
			this.context.coachViewData.deleteToolTipNode = this.lang.hitch(this, function(){
				if(this.context.coachViewData.tooltip){
					this.context.coachViewData.innerDiv.removeChild(this.context.coachViewData.tooltip);
					this.context.coachViewData.tooltip = undefined;
					this.context.coachViewData.tooltipTextNode = undefined;
				}
			});
			
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.context.coachViewData.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.context.coachViewData.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "labelPlacement"){
				var labelPlacement;
				if(propertyValue == "L"){
					labelPlacement = "label-left";
				} else {
					labelPlacement = "";
				}
				domClass.replace(this.context.coachViewData.outerDiv, labelPlacement, "label-left");
			} else if(propertyName ==  "@helpText"){
				var expr = configHelper.getConfigOptionValue(this, "expression");
					expr = (expr != "" && expr != undefined) ? expr.replace(/"/g,"") : "";
					
				propertyValue = (propertyValue != "" && propertyValue != undefined && expr == "") ? propertyValue : expr;
				
				if(propertyValue && this.context.coachViewData.isTooltipVisible == true){
					if(this.context.coachViewData.tooltip && this.context.coachViewData.tooltipTextNode != undefined){
						this.context.coachViewData.tooltipTextNode.nodeValue = propertyValue;
					} else {
						this.context.coachViewData.createToolTipNode(propertyValue);
					}
				} else {
					this.context.coachViewData.deleteToolTipNode();
				}
			} else if(propertyName ==  "@labelVisibility"){
				//ignore for now, because runtime doesn't make any sense.  If label visibility is set to HIDE, then the label is always shown, regardless
				//of what showLabel is set to.  Having the two options is confusing anyway, and we should probably just use showLabel.
//				if(propertyValue == "HIDE"){
//					this.context.coachViewData.label.style.display = "none";
//				} else {
//					this.context.coachViewData.label.style.display = "";
//				}
			} else if(propertyName == "showLabel"){
				this.context.coachViewData.dataShowLabel = propertyValue;
				this.updateLabel();
			} else if(propertyName == "width"){
				this.context.coachViewData.width = propertyValue;
				if(!!propertyValue) {
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
            } else if (propertyName == "labelWidth") {
                if (propertyValue) {
                    this.context.coachViewData.label.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue + "px");
                    domClass.add(this.context.coachViewData.containingDiv, "labelWidth");
                } else {
                    this.context.coachViewData.label.style.width = "";
                    domClass.remove(this.context.coachViewData.containingDiv, "labelWidth");
                }
			} else if(propertyName == "horizontalPos"){
				this.context.coachViewData.updateHorizontalPosition(propertyValue);
			} else if(propertyName == "verticalPos"){
				this.context.coachViewData.updateVerticalPosition(propertyValue);
			} else if(propertyName == "colorStyle"){
				var colorStyle;
				if(propertyValue == "P"){
					colorStyle = "tooltip-primary";
				} else if(propertyValue == "I"){
					colorStyle = "tooltip-info";
				} else if(propertyValue == "S"){
					colorStyle = "tooltip-success";
				} else if(propertyValue == "W"){
					colorStyle = "tooltip-warning";
				} else if(propertyValue == "G"){
					colorStyle = "tooltip-danger";
				} else {
					colorStyle = "";
				}
				
				if (this.context.coachViewData.tooltip) {					
					domClass.replace(this.context.coachViewData.tooltip, colorStyle, "tooltip-primary tooltip-info tooltip-success tooltip-warning tooltip-danger");	
				}
			} else if(propertyName == "showTooltip"){
				var expr = configHelper.getConfigOptionValue(this, "expression");
					expr = (expr != "" && expr != undefined) ? expr.replace(/"/g,"") : "";
				var helpTxt =  configHelper.getConfigOptionValue(this, "@helpText");
				var tooltipText = (expr != "" && expr != undefined) ? expr : helpTxt;
				if(propertyValue == true && tooltipText){
					this.context.coachViewData.isTooltipVisible = true;
					if(!this.context.coachViewData.tooltip){
						this.context.coachViewData.createToolTipNode(tooltipText);
					}
				} else {
					this.context.coachViewData.isTooltipVisible = false;
					this.context.coachViewData.deleteToolTipNode();
				}
			} else if(propertyName == "expression"){
				var helpText = configHelper.getConfigOptionValue(this, "@helpText");
					propertyValue = (propertyValue != "" && propertyValue != undefined) ? propertyValue.replace(/"/g,"") : "";
					
				propertyValue = (propertyValue != "" && propertyValue != undefined) ? propertyValue : helpText;
				
				if(propertyValue && this.context.coachViewData.isTooltipVisible == true){
					if(this.context.coachViewData.tooltip && this.context.coachViewData.tooltipTextNode != undefined){
						this.context.coachViewData.tooltipTextNode.nodeValue = propertyValue;
					} else {
						this.context.coachViewData.createToolTipNode(propertyValue);
					}
				} else {
					this.context.coachViewData.deleteToolTipNode();
				}
			} else if(propertyName == "sizeStyle"){
                var sizeStyle;
                if(propertyValue == "L"){
                    sizeStyle = "tooltip-lg";
                } else if(propertyValue == "X"){
                    sizeStyle = "tooltip-xs";
                } else {
                    sizeStyle = "";
                }
                domClass.replace(this.context.coachViewData.tooltip, sizeStyle, "tooltip-xs tooltip-lg");
            }
		}));	
	},
	updateLabel:function(){
		var isLabelShow = false;
		if( (this.context.coachViewData.dataShowLabel == "true" || this.context.coachViewData.dataShowLabel == true) && 
				this.context.coachViewData.dataLabel!==null && this.context.coachViewData.dataLabel!==undefined &&
				this.context.coachViewData.dataLabel!==""){
			isLabelShow = true;
		}
		
		if(isLabelShow){
			this.context.coachViewData.label.style.display = "";
			this.context.coachViewData.labelTextDom.data = this.context.coachViewData.dataLabel;
		} else {
			this.context.coachViewData.label.style.display = "none";
		}
	},
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
		if(propertyName == "@label") {
			this.context.coachViewData.dataLabel = propertyValue;
			this.updateLabel();
		}
	}
};

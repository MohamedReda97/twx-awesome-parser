/**
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *	   <td colspan = "2">
 *       <table>
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the badge is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setColorStyle("I")<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Click:</td>
 *	   <td colspan = "2">
 *       <table>
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the badge is clicked.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${Tooltip1}.setTooltipVisible(!${Tooltip1}.isTooltipVisible())<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitBadge = function (utilities, bpmext, domClass, domAttr, domConstruct)
{
	this._instance =
	{
	};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			//Declarations for "private" constant values & structures
			OPTS_BCOL_STLZ :
			{
				"D" : "",
				"P": "badge-primary",
				"I" : "badge-info",
				"S" : "badge-success",
				"W" : "badge-warning",
				"E" : "badge-danger",
				"G" : "badge-danger"
			},
			OPTS_LCOL_STLZ :
			{
				"D" : "",
				"P": "label-primary",
				"I" : "label-info",
				"S" : "label-success",
				"W" : "label-warning",
				"E" : "label-danger",
				"G" : "label-danger"
			},
			_normalizeShapeStyle : function(style)
			{
				if(!style)
					style = "B";

				style=style.toUpperCase();
				
				if(style.length > 1)
				{
					switch (style)
					{
						case "DEFAULT":
						case "DEF":
						case "BADGE":
							style = "B";
							break;
						case "LABEL":
							style = "L";
							break;
						case "TAG":
							style = "T";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected shape style: " + style);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "SHAPE_STYLE_WARNING",style));
					}
				}

				return style;
			},
			EVT_ONCLICK : "eventON_CLICK",
			_setStyle : function (view)
			{
				var colorStyle = view.context.options.colorStyle.get("value");
				var shapeStyle = view.context.options.shapeStyle.get("value");

				colorStyle = bpmext.ui.util.normalizeColorStyle(colorStyle);
				shapeStyle = this._normalizeShapeStyle(shapeStyle);

				switch(shapeStyle)
				{
					case "L":
					{
						var colClass = this.OPTS_LCOL_STLZ[colorStyle];
						domClass.replace(view._instance.btn, "label " + colClass);
						break;
					}
					case "T":
					{
						var colClass = this.OPTS_LCOL_STLZ[colorStyle];
						domClass.replace(view._instance.btn, "label label-tag " + colClass);
						break;
					}
					case "B":
					default:
					{
						var colClass = this.OPTS_BCOL_STLZ[colorStyle];
						domClass.replace(view._instance.btn, "badge " + colClass);
						break;
					}
				}
			},
			_setText : function(view)
			{
				var text = view.context.options._metadata.label.get("value");
				//{#bug: BG-428 Value 0 causes Badge to display "..."}
				text += ""; //Implicit strign conversion
				if(text == null || text.length == 0)
					text = "...";

				view._instance.btn.innerHTML = view.context.htmlEscape(text);
				utilities.BiDi.applyTextDir(
					view._instance.btn,
					view._instance.btn.innerHTML,
					view._instance.baseTxtDir,
					view._instance.genPrefTextDir
					);
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);

				view.context.setDisplay(visibility != "NONE");
				view.context.setVisibility(visibility != "HIDDEN");

				if (visibility == "READONLY"){
					domClass.add(view._instance.btn, "disabled");
					domAttr.set(view._instance.btn, "disabled", "");
					domAttr.set(view._instance.btn, "aria-disabled", "true");
				}
				else{
					domClass.remove(view._instance.btn, "disabled");
					domAttr.remove(view._instance.btn, "disabled", "");
					domAttr.set(view._instance.btn, "aria-disabled", "false");
				}
			}
		};


		/*
		Public control methods *************************************************************
		 */

		/**
		 * @instance
		 * @memberof Badge
		 * @method setColorStyle
		 * @param {string} style "DEFAULT"|"DEF"|"D"=Default | "PRIMARY"|"PRI"|"P"=Primary | "INFO"|INF"|"I"=Info | "SUCCESS"|"S"=Success | "WARNING"|"WARN"|"W"=Warning | "DANGER"|ERROR|ERR"|"E"=Danger
		 * @desc Sets color style of badge.  NOTE: to avoid ambiguity always set the color using "D"|"P"|"I"|"S"|"W"|"E"
		 */
		this.constructor.prototype.setColorStyle = function (style)
		{
			return this.context.options.colorStyle.set("value", style);
		}

		/**
		 * @instance
		 * @memberof Badge
		 * @method getColorStyle
		 * @desc Gets color style of badge.  NOTE: This always returns the color as set, to avoid ambiguity always set the color using "D"|"P"|"I"|"S"|"W"|"E"
		 * @returns {string} 
		 */
		this.constructor.prototype.getColorStyle = function ()
		{
			return this.context.options.colorStyle.get("value");
		
		}

		/**
		 * @instance
		 * @memberof Badge
		 * @method setShapeStyle
		 * @param {string} style "B"|"Badge"|"Def"|"Default"=badge || "T"|"Tag"=tag || "L"|"Label"=label
		 * @desc Sets shape style of badge. NOTE: to avoid ambiguity always set the shape using "B"|"T"|"L"
		 */
		this.constructor.prototype.setShapeStyle = function (style)
		{
			return this.context.options.shapeStyle.set("value", style);
		}		

		/**
		 * @instance
		 * @memberof Badge
		 * @method getShapeStyle
		 * @desc Get the shape style of the badge. NOTE: This always returns the shape as set, to avoid ambiguity always set the shape using "B"|"T"|"L"
		 * @returns {string}
		 */
		this.constructor.prototype.getShapeStyle = function ()
		{
			return this.context.options.shapeStyle.get("value");
		}
		
		/**
		 * @instance
		 * @memberof Badge
		 * @method setText
		 * @param {string} text Text to set in the badge
		 * @desc Set the text in the badge
		 */
		this.constructor.prototype.setText = function (text)
		{
			this.context.options._metadata.label.set("value", text);
		}

		/**
		 * @instance
		 * @memberof Badge
		 * @method getText
		 * @desc Get the text in the badge
		 * @returns {string}
		 */
		this.constructor.prototype.getText = function ()
		{
			return this.context.options._metadata.label.get("value");
		}

		/**
		 * @instance
		 * @memberof Badge
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "badge.3";
		}
		//{#feature: US-696 ARIA Accessibility}
		this.constructor.prototype._getTriggerElement = function () 
		{
			return this._instance.btn; //This is the element which is referred in Popup Menu for adding WAI-ARIA Accessibility Roles
		}
		//End US-696

		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;

				if (!opts.colorStyle)
					opts.colorStyle = bpmext.ui.substituteConfigOption(this, "colorStyle", "D");

				if (!opts.shapeStyle)
					opts.shapeStyle = bpmext.ui.substituteConfigOption(this, "shapeStyle", "B");

				this._instance.btn = document.createElement("button"); 				//US-1234 : Changed from a(anchor) tag to button tag
				//domAttr.set(this._instance.btn, "href", "javascript:void(0)");	//US-1234 : Commented out
                this._instance.btn.setAttribute("role", "button");
                this._instance.btn.setAttribute("id", "badge-button-"+this.context.controlidpath);

				this._proto._setStyle(this);
				this._proto._setText(this);

				this.context.element.appendChild(this._instance.btn);

				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLICK);

				var _this = this;

				this._instance.btn.onclick = function (event)
				{
					if(!domClass.contains(this, "disabled"))
					{
						bpmext.ui.executeEventHandlingFunction(_this, _this._proto.EVT_ONCLICK);
					}
					return false;
				};
				/* US-1234 : STARTS */
				domAttr.set(this._instance.btn, "tabindex", 0);
				this._instance.btn.addEventListener('keypress', function(evt) {
					if(evt.key === "Enter" || evt.key === " " || evt.key === "Spacebar"){
						if(!domClass.contains(this, "disabled"))
						{
							bpmext.ui.executeEventHandlingFunction(_this, _this._proto.EVT_ONCLICK);
						}
						return false;
					}											
				});
				var labelTxt = this.context.options._metadata.label.get("value");
				if(labelTxt != null && labelTxt != ""){
					domAttr.set(this._instance.btn, "aria-label", labelTxt);
				}
				/* US-1234 : ENDS */

				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					function (expResult)
					{
						if (expResult == undefined)
						{
							expResult = "";
						}

						_this.setText (expResult);
					},
					this.getText
				);

				bpmext.ui.loadView(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.label":
						{
							this._proto._setText(this);
							break;
						}
						case "shapeStyle":
						case "colorStyle":
						{
							this._proto._setStyle(this);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}
}

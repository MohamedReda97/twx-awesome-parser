 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>return potential.length<=10;<code></pre></td>
 *         </tr>
 *       </table>
 *       <table style="border: 1px solid black; border-collapse: collapse; ">
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <th style="border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">current {string}</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">potential {string}</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">selection {object {start, end} }</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">type {string}</th>
 *         </tr>
 *       </table>

bpmext_control_InitConfiguration = function (domClass, bpmext)
{
	this._instance = 
	{
	};

	if (!this.constructor.prototype._proto)
	{
		var Logger = (function(){
			var _oldDebug, _oldInfo, _oldWarn, _oldError, _oldLog;
			var _logDiv;
			
			Logger = function(lastEntryFirst, positionTop, logSec)
			{
				this._positionTop = positionTop;
				this._insertFirst = lastEntryFirst;
				this.logSec = logSec;

				if(!_oldDebug)
					_oldDebug = console.debug;					

				if(!_oldInfo)
					_oldInfo = console.info;					

				if(!_oldWarn)
					_oldWarn = console.warn;					

				if(!_oldError)
					_oldError = console.error;					

				if(!_oldLog)
					_oldLog = console.log;					

				var _this = this;
				
				this.start = function()
				{
					if(!_this.logSec)
					{
						if(!_logDiv)
						{
							_logDiv = document.createElement("div");
							
							if(_this._positionTop)
							{
								_logDiv.className += " posTop";
								var mainBody = document.getElementById("mainBody");
								mainBody.insertBefore(_logDiv, mainBody.childNodes[0]);
							}
							else
								document.body.appendChild(_logDiv);
						}
						
						_this.logSec = _logDiv;
					}
					else
						_this.logSec = logSec;

					domClass.add(_this.logSec, "sparklog"); //open-log
						
					_this.logSec.innerHTML = "";
					_this.logButton = document.createElement("div");
					domClass.add(_this.logButton, "log-btn");
					
					_this.logSec.appendChild(_this.logButton);
					
					_this.logMenu = document.createElement("div");
					domClass.add(_this.logMenu, "log-menu");
					_this.logSec.appendChild(_this.logMenu);
					var clearLogBtn = document.createElement("button");
					_this.logMenu.appendChild(clearLogBtn);
					//{#feature: US-1330 Added RT localization}
					//clearLogBtn.innerHTML = "Clear";
					clearLogBtn.innerHTML = bpmext.localization.formatMsg("general", "CLEAR");
					domClass.add(clearLogBtn, "btn btn-sm btn-primary");

					var debugBtn = document.createElement("button");
					_this.logMenu.appendChild(debugBtn);
					//{#feature: US-1330 Added RT localization}
					//debugBtn.innerHTML = "Turn Debug ON";
					debugBtn.innerHTML = bpmext.localization.formatMsg("controlConfiguration", "CONFIG_TURN_DEBUG") + " " + bpmext.localization.formatMsg("general", "ON");
					domClass.add(debugBtn, "btn btn-sm btn-primary");
					
					_this.logInnerSec = document.createElement("div");
					domClass.add(_this.logInnerSec, "log-content");
					_this.logSec.appendChild(_this.logInnerSec);
					
					var consoleDiv = document.createElement("div");
					_this.logSec.appendChild(consoleDiv);
					domClass.add(consoleDiv, "log-console");
					
					var consoleTxt = document.createElement("input");
					consoleDiv.appendChild(consoleTxt);
					var consoleBtn = document.createElement("button");
					//{#feature: US-1330 Added RT localization}
					//consoleBtn.innerHTML = "Exec";
					consoleBtn.innerHTML = bpmext.localization.formatMsg("general", "Exec");
					domClass.add(consoleBtn, "btn btn-sm btn-success");
					consoleDiv.appendChild(consoleBtn);
					
					_this.logButton.onclick = function()
					{
						domClass.toggle(_this.logSec, "open-log");
					}
					
					clearLogBtn.onclick = function() {
						_this.logInnerSec.innerHTML = "";
						delete _this._lastNode;
					}
					
					debugBtn.onclick = function() {
						if(bpmext.text.endsWith(this.innerHTML, "ON"))
						{
							bpmext.ui.publishEvent("CFG_DEBUG", true);
							//{#feature: US-1330 Added RT localization}
							//this.innerHTML = "Turn Debug OFF";
							this.innerHTML = bpmext.localization.formatMsg("controlConfiguration", "CONFIG_TURN_DEBUG") + " " + bpmext.localization.formatMsg("general", "OFF");
						}
						else
						{
							bpmext.ui.publishEvent("CFG_DEBUG", false);
							//{#feature: US-1330 Added RT localization}
							//this.innerHTML = "Turn Debug ON";
							this.innerHTML = bpmext.localization.formatMsg("controlConfiguration", "CONFIG_TURN_DEBUG") + " " + bpmext.localization.formatMsg("general", "ON");
						}
					}
				}
				
				this.stop = function()
				{
					if(_logDiv)
					{
						_logDiv.parentNode.removeChild(_logDiv);
						_logDiv = null;
						_this.logInnerSec = null;
						_this.logSec = null;
						_this._lastNode = null;
					}
				}
				
				this.getLogSection = function()
				{
					return this.logSec;
				}
				
				this._log = function(text, type, oldFn)
				{
					if(_this.logInnerSec)
					{
						var entry = document.createElement("div");
						entry.className = type;
						
						
						var txt = document.createTextNode(text);
						entry.appendChild(txt);

						if(_this._insertFirst)
						{
							if(!_this._lastNode)
							{
								_this._lastNode = _this.logInnerSec.appendChild(entry);
							}
							else
							{
								_this._lastNode = _this.logInnerSec.insertBefore(entry, _this._lastNode);
							}
						}
						else
						{
							_this.logInnerSec.appendChild(entry);
							entry.scrollIntoView();
						}
					}

					if(oldFn)
						oldFn.call(console, text);					
				}
				
				this.debug = function(text)
				{
					_this._log(text, "debug", _oldDebug);
				}

				this.info = function(text)
				{
					_this._log(text, "info", _oldInfo);
				}
				
				this.warn = function(text)
				{
					_this._log(text, "warn", _oldWarn);
				}

				this.error = function(text)
				{
					_this._log(text, "error", _oldError);
				}

				this.log = function(text)
				{
					_this._log(text, "log", _oldLog);
				}
				
				console.log = this.log;
				console.debug = this.debug;
				console.info = this.info;
				console.warn = this.warn;
				console.error = this.error;
			}
			
			return Logger;
		})();		
	
		this.constructor.prototype._proto = 
		{
			_setDebugging : function(view, flag)
			{
				bpmext.log.isDebugging = flag;
				
				if(bpmext.log.isDebugging)
					bpmext.log.debug("Debug logging: ON");
				else
					console.debug("Debug logging: OFF");
			},
			_showLog : function(view, flag)
			{
				if(flag)
				{
					if(!view._instance.logger)
					{
						view._instance._logArea = document.createElement("div");
						domClass.add(view._instance._logArea, "sparklog");
						
						view.context.element.appendChild(view._instance._logArea);
						
						view._instance.logger = new Logger(
							view.context.options.lastFirst.get("value"), 
							view.context.options.logPosTop.get("value"),
							view._instance._logArea
							);
					}
					
					view._instance.logger.start();
				}
				else
				{
					if(view._instance.logger)
						view._instance.logger.stop();
				}
			},
			_positionTop : function(view, flag)
			{
				var fn = flag ? domClass.add : domClass.remove;
				fn.call(domClass, view._instance.logger.getLogSection(), "posTop");
			},
			_normalizeGlobalTextDir : function(view, dir)
			{
				var res = dir;
				if(res == null)
					res = "D";
				
				res = res.toUpperCase();
				
				if(bpmext.text.startsWith(res, "RIGHT"))
					res = "R";
				else if (bpmext.text.startsWith(res, "LEFT"))
					res = "L";
				else if (res.indexOf("AUTO") != -1)
					res = "D";
				
				switch(res)
				{
					case "LTR":
						res = "L";
					case "L":
						break;
					case "RTL":
						res = "R";
					case "R":
						break;
					case "DEF":
					case "DEFAULT":
						res = "D";
					case "D":
						break;
					default:
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.warn("Unexpected text direction: " + dir + " - using DEFAULT direction", view);
						bpmext.log.warn(bpmext.localization.formatMsg("controlConfiguration", "CONFIG_TEXT_DIR_WARNING") + ": " + dir + " -" + bpmext.localization.formatMsg("controlConfiguration", "CONFIG_USING_DEFAULT_DIR"), view);
						res = "D";
				}
				
				return res;
			},
			_setGlobalTextDir : function(view)
			{
				if(!view._instance.defDir)
				{
					view._instance.defDir = domClass.contains(document.body, "CoachViewRTL") ? "R" : "L";
				}
				
				var dir = view.context.options.globalTextDir.get("value");
				
				dir = this._normalizeGlobalTextDir(view, dir);
				if(dir == "D")
					dir = view._instance.defDir;
				
				switch(dir)
				{
					case "L":
					{
						document.body.setAttribute("dir", "ltr");
						domClass.remove(document.body, "CoachViewRTL");
						break;
					}
					case "R":
					{
						if(!document.getElementById("spark-ui-rtl-css")) //Comes from BPMExt-Core.js
						{
							var link = document.createElement('link');
							
							link.type = 'text/css';
							link.rel = "stylesheet";
							link.href = com_ibm_bpm_coach.getManagedAssetUrl('BPMExt-Style.zip', com_ibm_bpm_coach.assetType_WEB, 'SYSBPMUI') + "/rtl.css";
							link.id = "spark-ui-rtl-css";
							
							document.getElementsByTagName("head")[0].appendChild(link);
						}
						
						document.body.setAttribute("dir", "rtl");
						domClass.add(document.body, "CoachViewRTL");
						break;
					}
				}
				
				bpmext.ui.publishEvent("GLOBAL_TEXT_DIRECTION", dir == "L" ? "LTR" : "RTL");
			},
			//ED: I18N
			_lookupI18NData: function(view)
			{
				//var input = {};
				var locale = view.context.options.locale ? view.context.options.locale.get("value") : null;
				var sargs = {
					params:{"locale": locale},
					load: function(data) {
						try
						{
							if(data.result != null)
								bpmext.ui.publishEvent("I18N_DATA", data.result, true);
						}
						catch (e) {
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.error("Error on I18N AJAX service invocation (1) [" + view.context.viewid + "]: " + e);
							bpmext.log.error(bpmext.localization.formatMsg("controlConfiguration", "I18N_AJAX_SERVICE_INV_ERROR") + " (1) ["+ view.context.viewid + "]: " + e);
							if(e.stack) { 
								//{#feature: US-1330 Added RT localization}
								//bpmext.log.error("  Call stack: " + e.stack);
								bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
							}
						}
					},
					error: function(error) {
						try
						{
							//TODO: Implement better error reporting with AjaxError in the AJAX service
							//Then parse AJAX "error" object here...
							//{#feature: US-1330 Added RT localization}
							//throw new Error("I18N AJAX service error");
							throw new Error(bpmext.localization.formatMsg("controlConfiguration", "I18N_AJAX_SERVICE_ERROR"));
						}
						catch (e) {
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.error("Error on I18N AJAX service invocation (2) [" + view.context.viewid + "]: " + e);
							bpmext.log.error(bpmext.localization.formatMsg("controlConfiguration", "I18N_AJAX_SERVICE_INV_ERROR") + " (2) ["+ view.context.viewid + "]: " + e);
							if(e.stack) { 
								//{#feature: US-1330 Added RT localization}
								//bpmext.log.error("  Call stack: " + e.stack);
								bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
							}
						}
					}
				};

				try
				{
					view.context.options.i18nService(sargs);
				}
				catch(e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Error on I18N AJAX service invocation (3) [" + view.context.viewid + "]: " + e);
					bpmext.log.error(bpmext.localization.formatMsg("controlConfiguration", "I18N_AJAX_SERVICE_INV_ERROR") + " (3) ["+ view.context.viewid + "]: " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			}
		};
		
		/*
		Public control methods *************************************************************
		 */

		/**
		 * @instance
		 * @memberof Configuration
		 * @method getParameter
		 * @param {string} name Name of parameter
		 * @returns {string}
		 * @desc Get the value of a configuration parameter
		 */
		this.constructor.prototype.getParameter = function(name)
		{
			var res = null;
			
			if(this.context.options.parameters)
			{
				var paramList = this.context.options.parameters.get("value");
				if(paramList && paramList.items)
				{
					for(var i = 0; i < paramList.items.length; i++)
					{
						if(paramList.items[i].name == name)
						{
							res = paramList.items[i].value;
							break;
						}
					}
				}
			}
			
			return res;
		}	

		/**
		 * @instance
		 * @memberof Configuration
		 * @method setGlobalTextDirection
		 * @param {string} direction {AUTO|LTR|RTL} Use AUTO to reset to the default page text direction set by IBM BPM
		 * @desc Force the global text direction (left-to-right or right-to-left) for the page
		 */
		this.constructor.prototype.setGlobalTextDirection = function(dir)
		{
			this.context.options.globalTextDir.set("value", dir);
		}

		/**
		 * @instance
		 * @memberof Configuration
		 * @method getGlobalTextDirection
		 * @returns {string}
		 * @desc Gets the forced global text direction for the page
		 */
		this.constructor.prototype.getGlobalTextDirection = function()
		{
			return this.context.options.globalTextDir.get("value");
		}

		/**
		 * @instance
		 * @memberof Configuration
		 * @method setDebugging
		 * @param {boolean} debugging Debug flag
		 * @desc Set debugging on/off
		 */
		this.constructor.prototype.setDebugging = function(flag)
		{
			this.context.options.debugging.set("value", flag);
		}
		//{#feature US 505 added method}
		/**
		 * @instance
		 * @memberof Configuration
		 * @method isDebugging
		 * @returns {boolean} 
		 * @desc Indicates the current state of the debugging flag
		 */
		this.constructor.prototype.isDebugging = function()
		{
			return this.context.options.debugging.get("value");
		}
		
		/**
		 * @instance
		 * @memberof Configuration
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "configuration.3";
		}
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;
				
				if(!opts.debugging)
					bpmext.ui.substituteConfigOption(this, "debugging", false);
				
				if(!opts.showLog)
					bpmext.ui.substituteConfigOption(this, "showLog", false);

				if(!opts.lastFirst)
					bpmext.ui.substituteConfigOption(this, "lastFirst", false);
					
				if(!opts.logPosTop)
					bpmext.ui.substituteConfigOption(this, "logPosTop", false);

				if(!opts.globalTextDir)
					bpmext.ui.substituteConfigOption(this, "globalTextDir", "D");
				
				//{#feature: US-329 Force text direction from configuration}
				this._proto._setGlobalTextDir(this);
				
				this._proto._setDebugging(this, opts.debugging.get("value"));
				this._proto._showLog(this, opts.showLog.get("value"));
				if(opts.showLog.get("value"))
					this._proto._positionTop(this, opts.logPosTop.get("value"));
				
				this.context.element.style.position = "absolute";

				bpmext.ui.loadView(this);
				
				var view = this;
				
				bpmext.ui.addEventSubscription(
					"CFG_DEBUG", 
					function (eventName, debug) {
						view.setDebugging(debug);
					},
					this
				);
				
				//ED: I18N
				this._proto._lookupI18NData(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
			}
		};

		this.constructor.prototype.view = function ()
		{
		    /*
			try
			{
				
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
			}
			*/
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this.view();
							break;
						}
						case "_metadata.helpText":
						{
							this._proto._setHelpText(this, event.newVal);
							break;
						}
						case "debugging":
						{
							this._proto._setDebugging(this, event.newVal);
							break;
						}
						case "showLog":
						{
							this._proto._showLog(this, event.newVal);
							break;
						}
						case "logPosTop":
						{
							this._proto._positionTop(this, event.newVal);
							break;
						}
						case "globalTextDir":
						{
							this._proto._setGlobalTextDir(this);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
			}
		};

		this.constructor.prototype.validate = function (event)
		{};

		this.constructor.prototype.collaboration = function (event)
		{};

		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}

var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", configHelperUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, configHelper){
			this.context.coachViewData.containingDiv = containingDiv;

			var tempID;
			while(true) {
				tempID = dojox.uuid.generateRandomUuid();
				if(this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']") == null)
					break;
			}
			
			this.context.coachViewData.containingDiv.setAttribute("data-temp-id", tempID);
			
			//Modified to switch between Horizontal and Vertical Layouts
			if(this.context.coachViewData.containingDiv.classList.contains("Horizontal_Layout")){
				domClass.add(this.context.coachViewData.containingDiv, "WYSIWYGHorizontal_Layout ");				
			}else{
				domClass.add(this.context.coachViewData.containingDiv, "WYSIWYGVertical_Layout ");				
			}
			
			domClass.add(this.context.coachViewData.containingDiv, "alignJustify");
			domClass.add(this.context.coachViewData.containingDiv, "noIScroll");
			this.context.coachViewData.contentBoxDiv = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']  .DesignContentBox");
			domClass.add(this.context.coachViewData.contentBoxDiv, "layoutSec");
			domClass.add(this.context.coachViewData.contentBoxDiv, "valignDefault");
						
			//Modified to switch between Horizontal and Vertical Layouts
			if(this.context.coachViewData.containingDiv.classList.contains("Horizontal_Layout")){				
				domClass.add(this.context.coachViewData.contentBoxDiv, "hChild");			
			}else{				
				domClass.add(this.context.coachViewData.contentBoxDiv, "vChild");
			}									

			this.context.coachViewData.containingDivHorizontalAlignmentClasses = "alignJustify alignLeft  alignCenter alignRight";
			this.context.coachViewData.containingDivLayoutFlowClasses = "noIScroll shrinkwrap";
			this.context.coachViewData.contentBoxDivLayoutFlowClasses = "vChild hChild hwChild";
			this.context.coachViewData.contentBoxDivVerticalAlignmentClasses = "valignDefault valignTop valignMiddle valignBottom";
			//Init the config section to hide any options that are not relevant to the current selections
			this.configurationOptionVisiblity = null;
			this.initializeConfigurationOptionVisibility(configHelper);
			
			callback();
		}));	
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class",  "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){
			
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				//Defect#301780 - Start
                // this.context.coachViewData.containingDiv.style = lang.mixin(this.context.coachViewData.containingDiv.style, propertyValue);
                var _this = this;
                var keys = Object.keys(propertyValue);
                keys.forEach(function(key) {
                    _this.context.coachViewData.containingDiv.style[key] = propertyValue[key];
                });
                //Defect#301780 - End
				if(!!width || !!minWidth || this.context.coachViewData.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.context.coachViewData.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} 	else if(propertyName == "width"){
				this.context.coachViewData.width = propertyValue;
				if(!!propertyValue) {					
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "height"){
				this.context.coachViewData.height = propertyValue;
				if(!!propertyValue) {					
					this.context.coachViewData.containingDiv.style.height = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.containingDiv.style.height = "";
				}
			} else if(propertyName == "layoutFlow"){
				if(propertyValue == "P"){
					domClass.replace(this.context.coachViewData.containingDiv, "noIScroll", this.context.coachViewData.containingDivLayoutFlowClasses);
					domClass.replace(this.context.coachViewData.contentBoxDiv, "hChild", this.context.coachViewData.contentBoxDivLayoutFlowClasses);
				} else if(propertyValue == "H"){
					domClass.replace(this.context.coachViewData.containingDiv, "", this.context.coachViewData.containingDivLayoutFlowClasses);
					domClass.replace(this.context.coachViewData.contentBoxDiv, "hChild", this.context.coachViewData.contentBoxDivLayoutFlowClasses);
				} else if(propertyValue == "I"){
					domClass.replace(this.context.coachViewData.containingDiv, "noIScroll shrinkwrap", this.context.coachViewData.containingDivLayoutFlowClasses);
					domClass.replace(this.context.coachViewData.contentBoxDiv, "hChild", this.context.coachViewData.contentBoxDivLayoutFlowClasses);
				} else if(propertyValue == "W"){
					domClass.replace(this.context.coachViewData.containingDiv, "noIScroll", this.context.coachViewData.containingDivLayoutFlowClasses);
					domClass.replace(this.context.coachViewData.contentBoxDiv, "hwChild", this.context.coachViewData.contentBoxDivLayoutFlowClasses);
				} else if(propertyValue == "V"){
					domClass.replace(this.context.coachViewData.containingDiv, "noIScroll", this.context.coachViewData.containingDivLayoutFlowClasses);
					domClass.replace(this.context.coachViewData.contentBoxDiv, "vChild", this.context.coachViewData.contentBoxDivLayoutFlowClasses);
				} else if(propertyValue == "Y"){
					domClass.replace(this.context.coachViewData.containingDiv, "noIScroll shrinkwrap", this.context.coachViewData.containingDivLayoutFlowClasses);
					domClass.replace(this.context.coachViewData.contentBoxDiv, "vChild", this.context.coachViewData.contentBoxDivLayoutFlowClasses);
				}
			} else if(propertyName == "hAlignment"){
				if(propertyValue == "J"){
					domClass.replace(this.context.coachViewData.containingDiv, "alignJustify", this.context.coachViewData.containingDivHorizontalAlignmentClasses);
				} else if(propertyValue == "L"){
					domClass.replace(this.context.coachViewData.containingDiv, "alignLeft", this.context.coachViewData.containingDivHorizontalAlignmentClasses);
				} else if(propertyValue == "C"){
					domClass.replace(this.context.coachViewData.containingDiv, "alignCenter", this.context.coachViewData.containingDivHorizontalAlignmentClasses);
				} else if(propertyValue == "R"){
					domClass.replace(this.context.coachViewData.containingDiv, "alignRight", this.context.coachViewData.containingDivHorizontalAlignmentClasses);
				}
			} else if(propertyName == "vAlignment"){
				if(propertyValue == "D"){
					domClass.replace(this.context.coachViewData.contentBoxDiv, "valignDefault", this.context.coachViewData.contentBoxDivVerticalAlignmentClasses);
				} else if(propertyValue == "T"){
					domClass.replace(this.context.coachViewData.contentBoxDiv, "valignTop", this.context.coachViewData.contentBoxDivVerticalAlignmentClasses);
				} else if(propertyValue == "M"){
					domClass.replace(this.context.coachViewData.contentBoxDiv, "valignMiddle", this.context.coachViewData.contentBoxDivVerticalAlignmentClasses);
				} else if(propertyValue == "B"){
					domClass.replace(this.context.coachViewData.contentBoxDiv, "valignBottom", this.context.coachViewData.contentBoxDivVerticalAlignmentClasses);
				}
			} else if ( (propertyName == "deferLoad") || (propertyName == "sensor")) {
				//update the config tab to hide any options that should not be shown
				this.setConfigurationOptionVisibility(this.getOptionVisibility(configHelper));
				if (this.updateConfigurationOptionVisibility) {
					this.updateConfigurationOptionVisibility()
				};
			}
		}));	
    },
	modelChanged: function(propertyName, propertyValue) {
		
	},

	//Init the config section to hide any options that are not relevant to the current selections
	initializeConfigurationOptionVisibility: function(configHelper) {
		var visibility = this.getOptionVisibility(configHelper);
		this.setConfigurationOptionVisibility(visibility);
	},
	setConfigurationOptionVisibility: function(visibility) {
		this.configurationOptionVisibility = visibility;
	},
	getConfigurationOptionVisibility: function() {
		return this.configurationOptionVisibility;
	},
	getOptionVisibility: function(configHelper) {
		var visibility = {}, deferLoad = false, sensor = "";
		var val = configHelper.getConfigOptionValue(this, "deferLoad");
		if (val != undefined) {
			deferLoad = val;
		}
		val = configHelper.getConfigOptionValue(this, "sensor");
		if (val != undefined) {
			sensor = val;
		}
		
		if (deferLoad == true || deferLoad == "true") {
			visibility["loadBatchSize"] =  {visible: true};
		} else {
			visibility["loadBatchSize"] =  {visible: false};
		}

		if (sensor != "") {
			visibility["behaviors"] =  {visible: true};
		} else {
			visibility["behaviors"] =  {visible: false};
		}

		return visibility;
	}
};

/**
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the status box is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setStatusText("Status Text is Loaded"); me.setStatusVisible(true);<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Click:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the status box is clicked.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setStatusVisible(false);<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitStatusBox = function (bpmext, utilities, domClass, domAttr, domConstruct)
{
	bpmext.ui.pushValidationContainer(this);

	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype.IS_ADDRESS_INVISIBLE = true;
		
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE",
			EVT_ONSCLICK : "eventON_SCLICK",
			_checkStatusBubble : function (view, errors)
			{
				var isStatusVisible = view.context.options.showStatus.get("value");
				var helpTextValue = view.context.options._metadata.helpText.get("value");
				var exprValue = (!!view.context.options.expression) ? view.context.options.expression.get("value") : "";
				if(
					(errors && errors.length > 0) || 
					(isStatusVisible && (helpTextValue || exprValue))
					)
				{
					if(!view._instance.status)
					{
						view._instance.status = document.createElement("p");
						domClass.add(view._instance.status, "help-block");
						
						//Added for TK-1274 : STARTS
						domAttr.set(view._instance.status, "role", "status");
						domAttr.set(view._instance.status, "aria-live", "polite");
						var sbId = bpmext.ui.makeUniqueId("sb")
						domAttr.set(view._instance.status,"id",sbId);
							
						//if(view._instance.ariaLabelTarget != null)
						//	domAttr.set(view._instance.ariaLabelTarget, "aria-owns", sbId);
						//TK-1274 : ENDS
						
						domConstruct.place(view._instance.status, view._instance.input, "last");
						
						if(view.context.options.eventON_SCLICK)
						{
							view._instance.status.onclick = function(event) {
								bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSCLICK);
							};
							
							domClass.add(view._instance.status, "clickable");
						}
					}
				}
				else
				{
					if(view._instance.status)
					{
						view._instance.input.removeChild(view._instance.status);
						delete view._instance.status;
					}					
				}
			},
			_renderStatusBoxContent : function (view, errors)
			{
				if(view._instance.status)
				{
					//{#bug: * Error formatting defect preventing errors from being displayed}
					var htmlContent = bpmext.ui.util.formatErrors(errors);

					if(htmlContent == null)
						htmlContent = "";

					if(view.context.options.showStatus.get("value"))
					{
						var status = view.context.options._metadata.helpText.get("value");
						var asHtml = view.context.options.htmlStatus.get("value");
						
						if(status != null && status.length > 0)
						{
							if(htmlContent.length != 0)
								htmlContent += "<hr>";

							htmlContent += asHtml ? status : view.context.htmlEscape(status);
						}
					}
					
					if(htmlContent.length > 0)
					{
						view._instance.status.innerHTML = htmlContent;
						utilities.BiDi.applyTextDir(
							view._instance.status, 
							view._instance.status.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);					
					}
					else
						view._instance.status.innerHTML = "";				
				}
			},
			_updateControl : function (view)
			{
				var errors = bpmext.ui.getViewValidationErrors(view);
				
				this._checkStatusBubble(view, errors);
				this._renderStatusBoxContent(view, errors);
				
				var colStyle = errors ? "E" : view.context.options.colorStyle.get("value");
				this._setColorStyle(view, colStyle);
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;
						
						domClass.add(view.context.element, "widthSet");
					}
					else
					{
						view.context.element.style.width = null;

						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("StatusBox._setWidth() error: " + e);
					bpmext.log.error("StatusBox._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_normalizeStatusStyle: function(style)
			{
				// bpmext.ui.util.OPTS_STA_STL_CLZ = {
					// "N" : "",
					// "D" : "",
					// "S" : "simple",
					// "K" : "dark"
				// };
				if(!style)
					style = "D";
				
				style = style.toUpperCase();
				if(style.length > 1)
				{
					switch (style)
					{
						case "DEFAULT":
						case "DEF":
							style = "D";
							break;
						case "NORMAL":
							style = "N";
							break;
						case "SIMPLE":
							style = "S";
							break;
						case "DARK":
							style = "K";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected status style: " + style);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "STATUS_STYLE_WARNING",style));
					}
				}

				return style;
			},
			_setStatusStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldStStyle;
				
				newVal = this._normalizeStatusStyle(newVal);
				oldVal = this._normalizeStatusStyle(oldVal);

				bpmext.ui.util.replaceCSSClass(view.context.element, bpmext.ui.util.OPTS_STA_STL_CLZ, newVal, oldVal);
				view._instance.oldStStyle = newVal;
			},
			_setColorStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldColStyle;
				
				newVal = bpmext.ui.util.normalizeColorStyle(newVal);
				oldVal = bpmext.ui.util.normalizeColorStyle(oldVal);

				bpmext.ui.util.replaceCSSClass(view.context.element, bpmext.ui.util.OPTS_COL_STL_CLZ, newVal, oldVal);
				view._instance.oldColStyle = newVal;
			},
			_setStatusText : function (view, text, html)
			{
				if(!!view._instance.status){
					if(text != null && text.length > 0)
					{
						if(!html)
							view._instance.status.innerHTML = view.context.htmlEscape(text);
						else
							view._instance.status.innerHTML = text;

						utilities.BiDi.applyTextDir(
							view._instance.status, 
							view._instance.status.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);					
					}
					else{
						view._instance.status.innerHTML = "";
					}
				}
			},
			_setStatusVisible : function (view, visible)
			{
				var errors = bpmext.ui.getViewValidationErrors(view);
				if(errors != null && errors.length > 0)
					visible = true;
			
				this._checkStatusBubble(view, errors);
				
				if(visible)
				{
					this._renderStatusBoxContent(view, errors);
					domClass.remove(view._instance.cbox, "nostatus");
				}
				else
					domClass.add(view._instance.cbox, "nostatus");
			},
			_setStatusFloat : function (view, floatSt)
			{
				if(floatSt)
					domClass.add(view.context.element, "float");
				else
					domClass.remove(view.context.element, "float");
			},
			_createLabel : function (view)
			{
				//view._instance.label = document.createElement("label");
				//Added for TK-1274 : STARTS
				view._instance.label = document.createElement("span");
				//TK-1274 : ENDS
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.group, "first");
				
				//{#feature: US-696 ARIA labeling}
				if(view._instance.ariaLabelTarget != null)
				{
					var lblId = "sbox-lbl-" + view.getUID();

					domAttr.set(view._instance.label, "id", lblId);
					domAttr.set(view._instance.ariaLabelTarget, "aria-labelledby", lblId);
					
					if(view._instance.ariaLabelTarget.nodeName == "BUTTON" || view._instance.ariaLabelTarget.nodeName == "A")
						domAttr.remove(view._instance.ariaLabelTarget, "aria-labelledby");
				}
				//End US-696
			},
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Text._setLabelVisibility() error: " + e);
					bpmext.log.error("StatusBox._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						if(view._instance.label)
						{
							view._instance.group.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Text._setLabel() error: " + e);
					bpmext.log.error("StatusBox._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal);

				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			_handleVisibility : function (view)
			{
				var visibility = utilities.handleVisibility(view.context);
			}
		};

		/*
		Public control methods *************************************************************
		 */
		 
		/**
		 * @instance
		 * @memberof StatusBox
		 * @method setLabel
		 * @param {string} label Label text
		 * @desc Set label for control
		 */
		this.constructor.prototype.setLabel = this.constructor.prototype.setText = function (text)
		{
			this.context.options._metadata.label.set("value", text);
		};

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method getLabel
		 * @desc Get label associated with control
		 * @returns {string}
		 */
		this.constructor.prototype.getLabel = this.constructor.prototype.getText = function ()
		{
			return this.context.options._metadata.label.get("value");
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method setLabelPlacement
		 * @param {string} placement "T"|"TOP"=Top | "L"|"LEFT"=Left
		 * @desc Set label placement for control.  NOTE: to avoid ambiguity always set the label placement using "T"|"L"
		 */
		this.constructor.prototype.setLabelPlacement = function (plc)
		{
			this.context.options.labelPlacement.set("value", plc);
		};

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method getLabelPlacement
		 * @desc Get label placement for control.  NOTE: This always returns the label placement as set, to avoid ambiguity always set the label placement using "T"|"L"
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelPlacement = function ()
		{
			return this.context.options.labelPlacement.get("value");
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method setStatusText
		 * @param {string} text the status text
		 * @desc Set status text for the status box control
		 */
		this.constructor.prototype.setStatusText = function (text)
		{
			this.context.options._metadata.helpText.set("value", text);
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method getStatusText
		 * @desc Get status text for the status box control
		 * @returns {string}
		 */
		this.constructor.prototype.getStatusText = function ()
		{
			return this.context.options._metadata.helpText.get("value");
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method setStatusVisible
		 * @param {boolean} visible the visibility of the control
		 * @desc Set status visibility for the status box control
		 */
		this.constructor.prototype.setStatusVisible = function (vis)
		{
			this.context.options.showStatus.set("value", vis);
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method isStatusVisible
		 * @desc Get status visibility for the status box control
		 * @returns {boolean}
		 */
		this.constructor.prototype.isStatusVisible = function ()
		{
			return this.context.options.showStatus.get("value");
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method setWidth
		 * @param {string} width the width of the control
		 * @desc Set width of the status boxcontrol (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (width)
		{
			this.context.options.width.set("value", width);
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method getWidth
		 * @desc Get configured width for the status box control (including unit)
		 * @returns {string}
		 */	
		this.constructor.prototype.getWidth = function ()
		{
			return this.context.options.width.get("value");
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method setColorStyle
		 * @param {string} style "DEFAULT"|"DEF"|"D"=Default | PRIMARY"|"P"=Primary | "INFO"|INF"|"I"=Info | "SUCCESS"|"S"=Success | "WARNING"|"WARN"|"W"=Warning | "ERROR"|"ERR"|"DANGER"|"G"=Danger 
		 * @desc Sets color style of the status box.  NOTE: to avoid ambiguity always set the color using "D"|P"|"I"|"S"|"W"|"G"	
		 */
		this.constructor.prototype.setColorStyle = function (style)
		{
			style = bpmext.ui.util.normalizeColorStyle(style);
			return this.context.options.colorStyle.set("value", style);
		}

		/**
		 * @instance
		 * @memberof StatusBox
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "statusBox.3";
		}
		
		//{#feature: US-696 ARIA labeling}
		this.constructor.prototype._getHTMLInputElement = function () 
		{
			return this._instance.ariaLabelTarget;
		}
		//End US-696
				
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;
				
				if (!opts.colorStyle)
					bpmext.ui.substituteConfigOption(this, "colorStyle", "D");

				if (!opts.statusStyle)
					bpmext.ui.substituteConfigOption(this, "statusStyle", "N");

				if (!opts.floatStatus)
					bpmext.ui.substituteConfigOption(this, "floatStatus", false);

				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if(!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");

				if (!opts.showStatus)
					bpmext.ui.substituteConfigOption(this, "showStatus", false);
					
				if (!opts.htmlStatus)
					bpmext.ui.substituteConfigOption(this, "htmlStatus", false);
				
				if(!opts.showValidationErrors)
					bpmext.ui.substituteConfigOption(this, "showValidationErrors", false);

				this._instance.input = this.context.element.querySelector(".input"); //Only used for styling - this reference is actually useless...
				var cBox = bpmext.ui.util.getContentBox(this, this._instance.input);
				if(!cBox) {
					//{#feature: US-1330 Added RT localization}
					//throw new Error("Content Box not found in StatusBox Coach View");
					throw new Error(bpmext.localization.formatMsg("controlStatusBox", "SBOX_CBOX_NOT_FOUND"));
				}

				var view = this;				

				this._instance.cbox = cBox;
				domClass.add(this._instance.cbox, "form-group");
				this._instance.group = this.context.element.querySelector(".inner");

				var childNodes = cBox.childNodes;
				var j = 0;
				
                //BG-873                
                bpmext.ui.setupFormulaTriggeredUpdates(     
                    this, 
                    function (expResult)
                    {
                        if (expResult == undefined)
                        {
                            expResult = "";
                        }

                        view.setStatusText(expResult);
                    },
                    this.getStatusText
                );
                
				//BG-974 moving loadContainer above childNode for loop to ensure getUID is bound to view
				bpmext.ui.loadContainer(this);
				
				for(var i = 0; i < childNodes.length; i++)
				{
					var childNode = childNodes[i];
					if(domAttr.has(childNode, "data-viewid"))
					{
						j++;

						if(j > 1)
						{
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("This InputGroup control should only contain one child view - it contains " + childNodes.length);
							bpmext.log.warn(bpmext.localization.formatMsg("controlStatusBox", "STATUSBOX_CONTROL") + " " + bpmext.localization.formatMsg("general", "ONE_CHILDVIEW_WARNING") + " " + childNodes.length);
							//bpmext.log.warn("  Only the first view was added");
							bpmext.log.warn(" " + bpmext.localization.formatMsg("general", "FIRSTVIEW_ADDED_WARNING"));
							
							break;
						}
						
						var subV = this.context.createView(childNode);												
						
						//{#feature: US-696 ARIA labeling}
						if(subV._getHTMLInputElement)
							this._instance.ariaLabelTarget = subV._getHTMLInputElement();
						//End US-696
						
						subV.context.options._metadata.labelVisibility.set("value", "HIDE");
						if(!this.context.options._metadata.label.get("value"))
						{
							this.context.options._metadata.label.set("value", subV.context.options._metadata.label.get("value"));
						}
					}
				}								
								
				this._proto._setStatusFloat(this, opts.floatStatus.get("value"));
				this._proto._setWidth(this, opts.width.get("value"));

				this._proto._updateControl(this);
				this._proto._setStatusVisible(this, opts.showStatus.get("value"));
				this._proto._setStatusStyle(this, opts.statusStyle.get("value"));
				
				//BG-974 moving loadContainer above childNode for loop
				//bpmext.ui.loadContainer(this);

				this._proto._setLabelVisibility(this, opts._metadata.labelVisibility.get("value"));
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSCLICK);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
			finally
			{
				bpmext.ui.popValidationContainer(this);
			}
		
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.label":
						{
							this._proto._setLabel(this, event.newVal);
							break;
						}
						case "_metadata.labelVisibility":
						{
							this._proto._setLabelVisibility(this, event.newVal);
							break;
						}
						case "labelPlacement":
						{
							this._proto._setLabelPlacement(this, event.newVal);
							break;
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.helpText":
						{
							this._proto._setStatusText(this, event.newVal, this.context.options.htmlStatus.get("value"));
							break;
						}
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "colorStyle":
						{
							this._proto._setColorStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "statusStyle":
						{
							this._proto._setStatusStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "showStatus":
						{
							this._proto._setStatusVisible(this, event.newVal);
							break;
						}
						case "htmlStatus":
						{
							this._proto._setStatusText(this, this.context.options._metadata.helpText.get("value"), event.newVal);
							break;
						}
						case "floatStatus":
						{
							this._proto._setStatusFloat(this, event.newVal);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.validate = function (event)
		{
			try
			{
				if(this.context.options.showValidationErrors.get("value"))
				{
					bpmext.ui.updateViewValidationState(this, event);

					this._proto._updateControl(this);
					this._proto._setStatusVisible(this, this.context.options.showStatus.get("value"));
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on validate event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}			
		};
		
		/*
		this.constructor.prototype.collaboration = function (event)
		{
		};
		*/
		
		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadContainer(this);
		};
	}
}

            {
                var val = !!currentVal ? currentVal : domAttr.get(view._instance.text, "data-uval");
                
                if(val != null && val != "" && isNaN(val))
                {
                	bpmext.ui.addViewValidationError(view, "numeric", bpmext.localization.formatMsg("general", "INVALID_CONTENT_FORMAT"));
                    return false;
                }
                else if ( !decimal && (view.context.bindingType() == "Integer")  && ( (val < -2147483648) || (val > 2147483647) ))
                {
                    bpmext.ui.addViewValidationError(view, "numeric", bpmext.localization.formatMsg("controlDecimal", "OUT_OF_RANGE_FOR_INT", val));
                    return false;                   
                }
                else if (decimal && (view.context.bindingType() == "Decimal") && ( (val < -90000000000000) || (val > 90000000000000) ))
                {
                    bpmext.ui.addViewValidationError(view, "numeric", bpmext.localization.formatMsg("controlDecimal", "OUT_OF_RANGE_FOR_DEC", val));
                    return false;                   
                } else

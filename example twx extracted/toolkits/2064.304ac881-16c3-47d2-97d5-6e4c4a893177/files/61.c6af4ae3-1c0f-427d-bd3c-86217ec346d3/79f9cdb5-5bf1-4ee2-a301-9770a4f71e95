            _getSelection : function(node) 
            {
                var start = 0, end = 0, normalizedValue, range, textInputRange, len, endRange;

                if(typeof node.selectionStart == "number" && typeof node.selectionEnd == "number") 
                {
                    start = node.selectionStart;
                    end = node.selectionEnd;
                }
                else 
                {
                    range = document.selection.createRange();

                    if(range && range.parentElement() == node) 
                    {
                        len = node.value.length;
                        normalizedValue = node.value.replace(/\r\n/g, "\n");
                        textInputRange = node.createTextRange();
                        textInputRange.moveToBookmark(range.getBookmark());
                        endRange = node.createTextRange();
                        endRange.collapse(false);

                        if (textInputRange.compareEndPoints("StartToEnd", endRange) > -1) 
                            start = end = len;
                        else 
                        {
                            start = -textInputRange.moveStart("character", -len);
                            start += normalizedValue.slice(0, start).split("\n").length - 1;

                            if (textInputRange.compareEndPoints("EndToEnd", endRange) > -1) 
                                end = len;
                            else 
                            {
                                end = -textInputRange.moveEnd("character", -len);
                                end += normalizedValue.slice(0, end).split("\n").length - 1;
                            }
                        }
                    }
                }

                return {"start": start, "end": end};
            },
            _getCaretPosition : function(ctrl) 
            {
                var caretPos = 0;
                //IE Support
                if (document.selection) 
                {
                    ctrl.focus ();
                    var Sel = document.selection.createRange ();

                    Sel.moveStart ('character', -ctrl.value.length);

                    caretPos = Sel.text.length;
                }
                //Rest of the world...
                else if (ctrl.selectionStart || ctrl.selectionStart == '0')
                    caretPos = ctrl.selectionStart;

                return (caretPos);
            },
            _setCaretPosition: function(ctrl, pos)
            {
                if(ctrl.setSelectionRange)
                {
                    ctrl.focus();
                    ctrl.setSelectionRange(pos,pos);
                }
                else if (ctrl.createTextRange) 
                {
                    var range = ctrl.createTextRange();
                    range.collapse(true);
                    range.moveEnd('character', pos);
                    range.moveStart('character', pos);
                    range.select();
                }
            },
            _handleInput : function (view, onInput, text, state, selection, type)
            {
                var inputOk = false;

                state.potential = text.value;

                do
                {
                    if(onInput)
                    {
                        if(/ /m.test(state.potential))
                            break;

                        var tmp = state.potential;
                        
                        if(view._instance.decSep != "." && tmp.indexOf(".") != -1)
                            break;
                        
                        tmp = tmp.replace(view._instance.decSep, ".");

                        //if(state.potential != "-" && isNaN(state.potential))
                        //if(state.potential != "-" && isNaN(tmp))
                        if(tmp != "-" && tmp != "-." && tmp != "." && isNaN(tmp))
                            break;
                    
                        if(decimal)
                        {
                            var count = 0, pos = -1;
                            
                            for(;;)
                            {
                                pos = state.potential.indexOf(view._instance.decSep, pos + 1);
                                if(pos != -1)
                                    count++;
                                else
                                    break;
                            } 
                            
                            if(count > 1)
                                break;
                        }
                        else
                        {
                            if(state.potential.indexOf(view._instance.decSep) != -1)
                                break;
                        }
                    }

                    view._instance.tmpLocVal = state.potential;
                    view._instance.tmpNumVal = Number(view._instance.tmpLocVal.replace(view._instance.decSep, "."));
                    
                    inputOk = true;
                }
                while(false);
                
                if(!inputOk)
                {
                    //save caret position
                    var pos = this._getCaretPosition(text);
                    if(pos > 0)
                        pos -= 1;
                    
                    /* {#bug: 428 Fixed control populating with 'undefined' if the first attempted character is a space} */
                    //replace bad text with valid text
                    if (view._instance.tmpLocVal) {
                        state.current = text.value = view._instance.tmpLocVal;
                    } else {
                        state.current = text.value = "";
                    }
                    
                    //restore caret position
                    this._setCaretPosition(text, pos);
                }
                else
                {
                    state.current = view._instance.tmpLocVal = text.value;
                    view._instance.tmpNumVal = Number(view._instance.tmpLocVal.replace(view._instance.decSep, "."));
                }
                
                return inputOk;
            }

                                //view._proto._handleInput(view, onInput, text1, state, sel, "redo");
                            });
                        }
                        else if(event.key === "Delete" || event.key === "Backspace") //backspace or delete, if there is a selection
                        {
                            sel = view._proto._getSelection(text1);
                            
                            if (!!sel && sel.end != sel.start) {
                                setTimeout(function(){
                                  //BG-1189 accessing state variable as member of instance
                                    view._proto._handleInput(view, onInput, text1, view._instance.state, sel, "change");
                                });
                            }
                        }
                        else if (ie && ie <=11 && event.key === "Enter" && event.target === view._instance.text) {
                            view._instance.text.onchange();
                        }
                        else
                        {
                            sel = view._proto._getSelection(text1);
                        }
                    };
                    
                    this._instance.text.oninput = function(event)
                    {
                        //console.log("oninput: " + event);
                        if(redo || undo)
                            return;

                        //BG-1189 accessing state variable as member of instance
                        view._instance.state.potential = text1.value;
                        //state.potential = text1.value;

                        //if(state.current != state.potential)
                        if(view._instance.state.current != view._instance.state.potential)
                            view._proto._handleInput(view, onInput, text1, view._instance.state, sel, "change");
                        //view._proto._handleInput(view, onInput, text1, state, sel, "change");
                        else
                            view._instance.tmpNumVal = view._instance.state.potential;
                            //view._instance.tmpNumVal = state.potential;

                        view._instance.state.potential = null;
                        //state.potential = null;
                    }

                    this._instance.text.onpaste = function(event)
                    {
                        //console.log("onpaste: " + event);

                        //BG-947 prevent paste in disabled control
                        if (!view._instance.text.disabled)
                        {
                            var data;
                            if(event.clipboardData)
                            {
                                if(event.clipboardData.types.length > 0)
                                {
                                    for(var i = 0; i < event.clipboardData.types.length; i++)
                                    {
                                        if(event.clipboardData.types[i] == view._proto.MIME_PLAIN_TEXT)
                                        {
                                            data = event.clipboardData.getData(view._proto.MIME_PLAIN_TEXT);
                                            break;
                                            //Moved to if(data)
                                        }
                                    }
                                }
                            } 
                            else if (window.clipboardData)
                            {
                                //BG-948 support for IE11 clipboard data
                                data = window.clipboardData.getData(view._proto.IE_PLAIN_TEXT);
                            }
                            
                            //BG-948 moved from for loop, support for IE11 clipboard data
                            if (data != null)
                            {
                                data = data.trim();
                                var curVal = this.value;
                                var sel = view._proto._getSelection(this);
                                
                                if(sel != null)
                                {
                                    var part1 = curVal.substring(0, sel.start);
                                    var part2 = curVal.substring(sel.end);

                                    data = part1 + data + part2;
                                }
                                
                                var res = view._proto.parseNumericVal(view, data);

                                if(!isNaN(res) && view._proto._checkContentValid(view, res))
                                {
                                    view.setValue(Number(res));
                                        
                                    var locVal = "" + res;
                                        
                                    if(view._instance.decSep != ".")
                                        locVal = locVal.replace(".", view._instance.decSep);
                                        
                                    view._instance.text.value = locVal;
                                    //BG-1189 setting current state when programmatically setting input value
                                    view._instance.state.current =  locVal;
                                    event.preventDefault();
                                }
                            }
                        }
                    }
                }
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
                if(e.stack) { 
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.view = function ()
        {
            try
            {
                this._proto._handleVisibility(this);
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if(e.stack) { 
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.change = function (event)
        {
            bpmext.log.debug("event.newVal [" + event.newVal + "] is of type " + typeof event.newVal +
                "-- event.oldVal [" +  event.oldVal + "] is of type " + typeof event.oldVal);

            try
            {
                if (event.type == "config")
                {
                    switch (event.property)
                    {
                        case "_metadata.label":
                        {
                            this._proto._setLabel(this, event.newVal);
                            this._proto._setHelpText(this, this.context.options._metadata.helpText.get("value"));
                            break;
                        }
                        case "_metadata.visibility":
                        {
                            this._proto._handleVisibility(this);
                            break;
                        }
                        case "_metadata.labelVisibility":
                        {
                            this._proto._setLabelVisibility(this, event.newVal);
                            break;
                        }
                        case "_metadata.helpText":
                        {
							this._proto._setHelpText(this, event.newVal);
                            this._proto._updateControl(this);
                            break;
                        }
                        case "width":
                        {
                            this._proto._setWidth(this, event.newVal);
                            break;
                        }
                        case "sizeStyle":
                        {
                            this._proto._setSizeStyle(this, event.newVal, event.oldVal);
                            break;
                        }
                        case "tabIndex":
                        {
                            this._proto._setTabIndex(this, event.newVal);
                            break;
                        }
                        case "placeHolder":
                        {
                            this._proto._setPlaceholder(this, event.newVal);
                            break;
                        }
                        case "labelPlacement":
                        {
                            this._proto._setLabelPlacement(this, event.newVal);
                            break;
                        }
						case "labelWidth":
						{
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}                        
                        //{bug:587 allow for config options to immediatly update the displayed value.}
                        case "decimalSep":
                        {
                            var tmpDecSep =  event.newVal != null ? event.newVal.trim() : this._proto.DEF_DECIMAL_SEP;
                            this._instance.decSep = tmpDecSep.length > 0 ? tmpDecSep : this._proto.DEF_DECIMAL_SEP;
                            this._proto._formatInput(this, this.context.binding.get("value"))
                            break;
                        }
                        case "decimalPlaces":
                        {
                            this.context.options.decimalPlaces.set("value", event.newVal != null ? event.newVal : this._proto.DEF_DECIMAL_PLACES);
                            this._proto._formatInput(this, this.context.binding.get("value"));
                            break;
                        }
                        case "thousandsSep":
                        {
                            this.context.options.thousandsSep.set("value", event.newVal != null && event.newVal.length > 0 ? event.newVal[0] : this._proto.DEF_THOUSANDS_SEP);
                            this._proto._formatInput(this, this.context.binding.get("value"));
                            break;
                        }
                        case "prefix":
                        {
                            this.context.options.prefix.set("value", event.newVal != null && event.newVal.length > 0 ? event.newVal : this._proto.DEF_PREFIX_VALUE);
                            this._proto._formatInput(this, this.context.binding.get("value"));
                            break;
                        }
                        case "postfix":
                        {
                            this.context.options.postfix.set("value", event.newVal != null && event.newVal.length > 0 ? event.newVal : this._proto.DEF_POSTFIX_VALUE);
                            this._proto._formatInput(this, this.context.binding.get("value"));
                            break;
                        }
                    }
                }
                else if(event.insertedInto == event.removedFrom)
                {
                    if (this._proto.SKIP_VALIDATION_RESET == false)
                        this.setValid(true);
                    // {#bug 465 Integer bound must be valid 32bit signed number}
                    if (    (!this._proto.SKIP_VALIDATION_RESET) && (!decimal) && ( this.context.bindingType() == "Integer" ) &&
                            ( (event.newVal < -2147483648) || (event.newVal > 2147483647) )  )
                    {
                        //{#feature: US-1330 Added RT localization}
                        //this.setValid(false,event.newVal + " out of range for type Integer");
                        this.setValid(false, bpmext.localization.formatMsg("controlDecimal", "OUT_OF_RANGE_FOR_INT", event.newVal));
                        this._proto.SKIP_VALIDATION_RESET = true;
                        this.context.binding.set("value", Number(event.oldVal));
                    }
                    // {#bug 794 Decimal bound must be in range -90000000000000 to +90000000000000}
                    else if (   (!this._proto.SKIP_VALIDATION_RESET) && (decimal) && ( this.context.bindingType() == "Decimal" ) &&
                            ( (event.newVal < -90000000000000) || (event.newVal > 90000000000000) )  )
                    {
                        //{#feature: US-1330 Added RT localization}
                        //this.setValid(false,event.newVal + " out of range for type Decimal");
                        this.setValid(false, bpmext.localization.formatMsg("controlDecimal", "OUT_OF_RANGE_FOR_DEC", event.newVal));
                        this._proto.SKIP_VALIDATION_RESET = true;
                        this.context.binding.set("value", Number(event.oldVal));
                    }                   
                    else
                    {
                        this._proto._setValue(this, event.newVal);
//                      if (this._proto.SKIP_VALIDATION_RESET == false)
//                          this.setValid(true);
                        this._proto.SKIP_VALIDATION_RESET = false;
                        if(event.newVal != event.oldVal)
                            bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE, event.newVal, event.oldVal);
                            
                        if(this.isBound())
                            this.propagateUpValueChange(event); //Update repeating parent's data if in repeating parent
                        
                        //Let subscribers know this control's value has changed
                        bpmext.ui.broadcastExpressionTrigger(this, bpmext.ui.PHASE_NORMAL); 
                    }
                }
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if(e.stack) { 
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.validate = function (event)
        {
            try
            {
                bpmext.ui.updateViewValidationState(this, event);

                this._proto._updateControl(this);
                if(this._instance.vc)
                    this._instance.vc.validate(event);
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on validate event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if(e.stack) { 
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }           
        };

        /*

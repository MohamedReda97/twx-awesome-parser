bpmext_control_InitDecimal = function (bpmext, utilities, domClass, domAttr, domConstruct, domGeometry, decimal, i18n, numberHelper, currencyHelper)
{
    this._instance = {
        //BG-1189 declaring state variable for access through instance
        state : {}
    };
    
    if (!this.constructor.prototype._proto)
    {
        //Init i18n bundle
        i18nBundle = i18n ? i18n.getLocalization("dojo.cldr", "number", i18n.normalizeLocale()) : {localeThousandsSeparator : ""};

        this.constructor.prototype._proto =
        {
            //Locale and currency formatting setup
            localeThousandsSeparator : i18nBundle.group,
            localeDecimalSeparator : i18nBundle.decimal,
            localeDecimalFormatPattern : i18nBundle.decimalFormat,
            localeCurrencyFormatPattern: i18nBundle.currencyFormat,

            MIME_PLAIN_TEXT: "text/plain",
            //BG-948 support for IE11 clipboard data
            IE_PLAIN_TEXT: "Text",
            
            SKIP_VALIDATION_RESET: false,  // bg 465
            EVT_ONCHANGE : "eventON_CHANGE",
            EVT_ONFOCUS : "eventON_FOCUS",
            EVT_ONBLUR : "eventON_BLUR",
            EVT_ONFORMAT : "eventON_FORMAT",
            
            //{#bug:876 - Setting default thousands and decimal separator to be locale default}
            
            DEF_DECIMAL_SEP : i18nBundle.decimal,
            DEF_THOUSANDS_SEP : i18nBundle.group, 
            DEF_PREFIX_VALUE : "", //TODO Use locale data for default???
            DEF_POSTFIX_VALUE : "", //TODO Use locale data for default???
            DEF_DECIMAL_PLACES : 0,
            extractNumber: function(str, signed)
            {
                var res = "";
                var signPos = -1;
                var firstNPos = -1;
                
                for(var i = 0; i < str.length; i++)
                {
                    var c = str[i].trim();
                    
                    if(c == "-" && signPos == -1)
                        signPos = i;
                    
                    if(c.length > 0 && !isNaN(c))
                    {
                        if(firstNPos == -1)
                            firstNPos = i;

                        res += c;
                    }
                }
                
                if(signed && res.length > 0 && signPos > -1 && signPos < firstNPos)
                    res = "-" + res;
                
                return res;
            },
            parseNumericVal: function(view, data)
            {
                var decimalSep = view._instance.decSep;
                var res = Number.NaN;
                var negative = false;
                
                if(data.length > 0)
                {
                    var intPart;
                    var decPart;
                    var pos1 = data.lastIndexOf(decimalSep);
                    
                    if(pos1 != -1)
                    {
                        if(pos1 <= data.length -1)
                            decPart = data.substring(pos1 + 1);
                        else
                            decPart = null;
                            
                        intPart = data.substring(0, pos1);
                    }
                    else
                    {
                        decPart = null;
                        intPart = data;
                    }
                    
                    var num = intPart != null ? this.extractNumber(intPart, true) : "0";
                    
                    if(decimal && decPart != null) //Only append decimal part for a decimal control
                    {
                        decPart = this.extractNumber(decPart, false);
                        
                        if(decPart.length > 0)
                            num += "." + decPart;
                    }
                    
                    if(num.length > 0)
                        res = Number(num);
                }

                return res;
            },          
            _formatInput : function (view, val, saveVal)
            {
                var goodInput = false;
                var prefix = view.context.options.prefix.get("value");
                var postfix = view.context.options.postfix.get("value");
                var decimalSep = view.context.options.decimalSep.get("value");
                var decimalPlaces = view.context.options.decimalPlaces.get("value");
                var hideThousandsSeparator = view.context.options.hideThousandsSeparator.get("value");
                var thousandsSep = hideThousandsSeparator ? "" : view.context.options.thousandsSep.get("value");
                
                do
                {
                    if(val == null)
                        break;

                    if(typeof val == "string")
                        val = bpmext.text.trim(val);
                    else
                        val = "" + val;
                    
                    if(val.length == 0)
                        break;
                    
                    var numVal = val.replace(view._instance.decSep, ".");
                    
                    if(isNaN(numVal))
                        break;

                    numVal = Number(numVal);

                    if(saveVal)
                    {
                        domAttr.set(view._instance.text, "data-uval", numVal); 
                        domAttr.set(view._instance.text, "data-lval", val); 
                    }
                    
                    view._instance.tmpNumVal = numVal;
                    view._instance.tmpLocVal = val;
                    
                    if(view._instance.text != document.activeElement)
                    {
                        var fVal = bpmext.number.format(
                            numVal, 
                            decimalPlaces,
                            view._instance.decSep,
                            thousandsSep
                            );

                        var ffVal = null;
                        
                        if(view._instance._onFormatFn)
                        {
                            //{#feature: * event-driven formatting of numeric value}
                            var format = {
                                prefix: prefix, 
                                postfix: postfix,
                                thousandsSeparator: thousandsSep,
                                decimalSeparator: decimalSep,
                                decimalPlaces: decimalPlaces
                            };
                            
                            ffVal = view._instance._onFormatFn.execute(
                                numVal, //value
                                fVal, //formattedValue
                                format//format
                                );                      
                        }
                        
                        //var fVal2 = ffVal == null ? (prefix + fVal + postfix) : ffVal;
                        var fVal2;
                        var currency = view.context.options.currency;
                        
                        if (currency) 
                        {
                            currency = view.context.options.currency.get("value");
                            currency = (currency !== "NONE") ? currency : "";
                        }
                        else
                        {
                            currency = "";
                        }
                        
                        // null changed to undefined jmac
//                      if (ffVal !== null) {                       
                        if((ffVal !== null) && (ffVal !== undefined))
                        {
                            fVal2 = ffVal;
                        }
                        else if(currency !== "")
                        {
                            var currencySymbol = view.context.options.currencySymbol.get("value"); 
                            var constraints = currencyHelper._mixInDefaults(dojo.mixin({currency: currency}, { exponent: false }));
                            
                            if (currencySymbol != null) 
                            {
                                constraints.symbol = currencySymbol;
                            }
                            
                            if (decimalPlaces === 0) 
                            {
                                constraints.fractional = false;
                            }
                            else
                            {
                                constraints.places = decimalPlaces;
                            }
                            
                            if (hideThousandsSeparator)
                            {
                                constraints.pattern = this.localeCurrencyFormatPattern.replace(i18nBundle.group, "");
                            }
                            
                            fVal2 = currencyHelper.format(numVal, constraints);
                        }
                        else if((view.context.options.numericFormatting === undefined) || (view.context.options.numericFormatting.get("value") === "custom"))
                        {
                            fVal2 = prefix + fVal + postfix;
                        }
                        else
                        {
                            var constraints = {exponent: false };
                            
                            if (decimalPlaces === 0)
                            {
                                constraints.fractional = false;
                            }
                            else
                            {
                                constraints.places = decimalPlaces;
                            }
                            
                            if(hideThousandsSeparator)
                            {
                                constraints.pattern = this.localeDecimalFormatPattern.replace(i18nBundle.group, "");
                            }
                                                        
                            fVal2 = prefix + numberHelper.format(numVal, constraints) + postfix;
                        }

                        if(fVal2 === "null")
                        {
                            fVal2 = "";
                        }
                        else
                        {
                            view._instance.text.value = fVal2;
                            //BG-1189 setting current state when programmatically setting input value
                            view._instance.state.current = fVal2;
                        }
                    }
                    else //If the decimal control has the focus
                    {
                        //Do no formatting
                    }
                    
                    goodInput = true;
                }
                while(false);

                if(!goodInput)
                {
                    view._instance.text.value = "";
                    //BG-1189 setting current state when programmatically setting input value
                    view._instance.state.current = "";
                    domAttr.remove(view._instance.text, "data-uval");
                    domAttr.remove(view._instance.text, "data-lval");
                    
                    delete view._instance.tmpNumVal;
                    delete view._instance.tmpLocVal;
                }
            
                return goodInput;                   
            },
            _setValue : function (view, numVal)
            {
                var locVal = numVal;
                
                if(locVal != null && view._instance.decSep != ".")
                    locVal = ("" + locVal).replace(".", view._instance.decSep);
                
                try
                {
                    if(!view._instance._noFmt)
                        this._formatInput(view, locVal, true);
                    
                    return this._checkContentValid(view);
                }
                catch (e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("Decimal._setValue() error: " + e);
                    bpmext.log.error("Decimal._setValue() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) { 
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _getLabelElt : function (view)
            {
                if(!view._instance.label)
                    this._createLabel(view);
                
                return view._instance.label;
            },
            _createLabel : function (view)
            {
                view._instance.label = document.createElement("span");
                domClass.add(view._instance.label, "control-label");
                domConstruct.place(view._instance.label, view._instance.group, "first");
                domAttr.set(view._instance.label, "for", view._instance.text.id);
                domAttr.set(view._instance.label, "id", "decimal-label-" + view.context.controlidpath);
                domAttr.set(view._instance.text, "aria-labelledby", view._instance.label.id);
            },
            _setLabelVisibility : function (view, flag)
            {
                try
                {
                    if(!view._instance.label)
                        this._createLabel(view);

                    view.context.setDisplay(flag == "SHOW", view._instance.label);
                }
                catch (e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("Decimal._setLabelVisibility() error: " + e);
                    bpmext.log.error("Decimal._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) { 
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setLabel : function (view, label)
            {
                try
                {
                    if(label)
                    {
                        if(!view._instance.label)
                            this._createLabel(view);

                        view._instance.label.innerHTML = view.context.htmlEscape(label);
                        utilities.BiDi.applyTextDir(
                            view._instance.label, 
                            view._instance.label.innerHTML, 
                            view._instance.baseTxtDir, 
                            view._instance.genPrefTextDir
                            );
                    }
                    else
                    {
                        if(view._instance.label)
                        {
                            view._instance.group.removeChild(view._instance.label);
                            delete view._instance.label;
                        }
                    }
                }
                catch (e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("Decimal._setLabel() error: " + e);
                    bpmext.log.error("Decimal._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) { 
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setHelpText : function (view, text)
			{
				utilities.setHelpText(view, text);
			},
            _setPlaceholder : function (view, text)
            {
                try
                {
                    if(text)
                        domAttr.set(view._instance.text, "placeholder", text);
                    else
                        domAttr.remove(view._instance.text, "placeholder");
                }
                catch (e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("Decimal._setPlaceholder() error: " + e);
                    bpmext.log.error("Decimal._setPlaceholder() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) { 
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setLabelPlacement : function (view, newVal, oldVal)
            {
                if(!oldVal)
                    oldVal = view._instance.oldLblPlc;
                
                newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
                oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
                
                bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
                view._instance.oldLblPlc = newVal;
            },
            _setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else {
					if (view._instance.label) {
						view._instance.label.style.width = null;
                    }
                    
					domClass.remove(view.context.element, "labelWidth");
                }
					
			},
            _setSizeStyle : function (view, newVal, oldVal)
            {
                if(!oldVal)
                    oldVal = view._instance.oldSzStyle;

                newVal = bpmext.ui.util.normalizeSizeStyle(newVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);
                oldVal = bpmext.ui.util.normalizeSizeStyle(oldVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);
                
                bpmext.ui.util.replaceCSSClass(view._instance.text, bpmext.ui.util.OPTS_SZ_STL_CLZ, newVal, oldVal);
                view._instance.oldSzStyle = newVal;
                
                bpmext.ui.util.propagateUpSizeStyle(view, newVal);
            },
            _setWidth : function (view, width)
            {
                try
                {
                    if (width != null && width != "")
                    {
                        if (!isNaN(width))
                            width += "px";

                        view.context.element.style.width = width;
                        
                        domClass.add(view.context.element, "widthSet");
                    }
                    else {
                        view.context.element.style.width = null;

                        domClass.remove(view.context.element, "widthSet");
                    }
                }
                catch (e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("Decimal._setWidth() error: " + e);
                    bpmext.log.error("Decimal._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) { 
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setTabIndex : function (view, index)
            {
                if(index != null)
                    domAttr.set(view._instance.text, "tabindex", index);
                else
                    domAttr.remove(view._instance.text, "tabindex");
            },
            _handleVisibility : function (view)
            {
                var visibility = utilities.handleVisibility(view.context);
                
                if(visibility == "REQUIRED") {
                    view._instance.text.setAttribute("aria-required", true);
                } else {
                    view._instance.text.setAttribute("aria-required", false);
                }
                
                if (visibility != "NONE") {
                    view._instance.text.disabled = (visibility === "READONLY");
                    if (!view._instance.label)
                        return;
                    if (visibility === "READONLY")
                        domClass.add(view.context.element, "disabled");
                    else
                        domClass.remove(view.context.element, "disabled");
                }

                // Updates for WAI
                if (domAttr.has(view._instance.text, "disabled")) {										
                    domAttr.set(view._instance.text, "aria-disabled", "true");
                } else {					
                    domAttr.remove(view._instance.text, "aria-disabled");
                }
            },
            _updateControl : function (view)
            {
                var errors = bpmext.ui.getViewValidationErrors(view);
                
                //Color style
                var colStyle = errors ? "E" : view.context.options.colorStyle.get("value");
                
                bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_COL_STL_CLZ, colStyle, view._instance.oldColStyle);
                view._instance.oldColStyle = colStyle;
                
                //Validation Error Icon
                if(view._instance.icon)
                {
                    bpmext.ui.util.closeTooltip(view._instance.iconTT, view._instance.icon);
                    delete view._instance.iconTT;
                    
                    view._instance.input.removeChild(view._instance.icon);
                    delete view._instance.icon;
                }
                
                if(errors)
                {
                    domClass.add(view._instance.group, "has-feedback has-error");
                    view._instance.icon = document.createElement("span");
                    view._instance.input.appendChild(view._instance.icon);
                    domClass.add(view._instance.icon, "fa form-control-feedback fa-exclamation-circle");
                    
                    var ttOpts = {
                            horizontalPos: "right", 
                            verticalPos: "top", 
                            cssClass: "validationError",
                            plainText: false,
                            smartPositioning: true
                        };
                    
                    view._instance.iconTT = bpmext.ui.util.showTooltip(
                        view._instance.input, 
                        bpmext.ui.util.formatErrors(errors), 
                        ttOpts
                        );

                    view._instance.errorMessage = document.createElement("div");
                    view._instance.errorMessage.id = view._instance.input.firstElementChild.id + "-error-msg";
                    view._instance.errorMessage.classList.add("hide");
                    view._instance.errorMessage.innerHTML = bpmext.ui.util.formatErrors(errors);
                    view._instance.input.appendChild(view._instance.errorMessage);
                    domAttr.set(view._instance.input.firstElementChild, "aria-describedby", view._instance.errorMessage.id);
                    domAttr.set(view._instance.input.firstElementChild, "aria-invalid", "true");
                }
                else
                {
                    domClass.remove(view._instance.group, "has-feedback has-error");

var mixObject = {
	createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", "dojo/dom-style", bpmextUri, configHelperUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, domStyle, bpmext, configHelper){
			bpmext.uidesign.css.ensureGlyphsLoaded(this);
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);

			this.context.coachViewData.containingDiv = containingDiv;
			this.context.coachViewData.formGroupDiv = domConstruct.create("div");
			
			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.label = domConstruct.create("span");
			domClass.add(this.context.coachViewData.label, "control-label");
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);
			
			this.context.coachViewData.inputDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.inputDiv, "input");
			domAttr.set(this.context.coachViewData.inputDiv, "id", "RBGroup_" + this.context.modelData.layoutItemIdPath);
			dojo.attr(this.context.coachViewData.inputDiv, "role", "group");
			
			domConstruct.place(this.context.coachViewData.formGroupDiv, this.context.coachViewData.containingDiv);
			domClass.add(this.context.coachViewData.formGroupDiv, "form-group");
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.label);
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.inputDiv);

			this.generateSampleData();

			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, this.context.coachViewData.label, this.context.coachViewData.containingDiv, false, false);
			//Init the config section to hide any options that are not relevant to the current selections
			this.configurationOptionVisiblity = null;
			this.initializeConfigurationOptionVisibility(configHelper);

			callback();
		}));
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.label;
	},
	generateSampleData:function(){
		require(["dojo/dom-class", "dojo/dom-attr"], this.lang.hitch(this, function(domClass, domAttr){
			//Defect#283561 - START
			//Populate with some dummy data
			for(var count=1; count <= 3; count++){
				var divElt = document.createElement("div");
				var spanElt = document.createElement("span");
				domClass.add(spanElt, "radio3");
				var input1 = document.createElement("input");
				domAttr.set(input1, {
					"type": "radio",
					"role": "radio",
					"value": "key"+count,
					"name": "rbo_" + this.context.modelData.layoutItemIdPath
				});
				
				var span1 = document.createElement("span");
				domAttr.set(span1,"id","LblSpan"+"_"+count);
				span1.innerHTML = "Radio "+count;
				spanElt.appendChild(input1);
				spanElt.appendChild(span1);
				divElt.appendChild(spanElt);
				this.context.coachViewData.inputDiv.appendChild(divElt);
			}
			//Defect#283561 - END
		}));
	},
	populateFromJSON:function(inputData){
		require(["dojo/dom-class", "dojo/dom-attr"], this.lang.hitch(this, function(domClass, domAttr){
			if(!inputData) {
				return;
			}
			var json_data = null;
			json_data = JSON.parse(inputData);
			var result = [];
			
			for(var i in json_data)	{
				result.push([json_data[i].name,json_data[i].value]);
			}
			
			for(var count=0; count < result.length; count++){
				var divElt = document.createElement("div");
				var spanElt = document.createElement("span");
				domClass.add(spanElt, "radio3");
				var input1 = document.createElement("input");
				domAttr.set(input1, "type", "radio");
				dojo.attr(input1, "role", "radio");
				domAttr.set(input1, "value", result[count][0]);
				domAttr.set(input1, "name", "rbo_" + this.context.modelData.layoutItemIdPath);
				
				var span1 = document.createElement("span");
				domAttr.set(span1,"id","LblSpan"+"_"+count);
				span1.innerHTML = result[count][1];
				spanElt.appendChild(input1);
				spanElt.appendChild(span1);
				divElt.appendChild(spanElt);
				this.context.coachViewData.inputDiv.appendChild(divElt);
			}
		}));
	},
	propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-construct", "dojo/dom-attr", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, domAttr, configHelper){
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "labelPlacement"){
				var labelPlacement;
				if(propertyValue == "L"){
					labelPlacement = "label-left";
				} else {
					labelPlacement = "";
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, labelPlacement, "label-left");
			} else if(propertyName == "width"){
				this.width = propertyValue;
				if(!!propertyValue) {
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
            } else if (propertyName == "labelWidth") {
                if (propertyValue) {
                    this.context.coachViewData.label.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue + "px");
                    domClass.add(this.context.coachViewData.containingDiv, "labelWidth");
                } else {
                    this.context.coachViewData.label.style.width = "";
                    domClass.remove(this.context.coachViewData.containingDiv, "labelWidth");
                }
			} else if(propertyName == "staticList"){
				//Empty the Select Option List
				domConstruct.empty(this.context.coachViewData.inputDiv);
				
				//Save data for use later, when switching the lookup mode
				this.context.coachViewData.staticListData = propertyValue;

				this.populateFromJSON(propertyValue);
			} else if(propertyName == "itemLookupMode"){
				//update the config tab to hide any options that should not be shown
				this.setConfigurationOptionVisibility(this.getOptionVisibility(propertyValue));
				if (this.updateConfigurationOptionVisibility) {
					this.updateConfigurationOptionVisibility()
				};
				if(propertyValue == "E"){ //Empty
					//Empty the Select Option List
					domConstruct.empty(this.context.coachViewData.inputDiv);

					this.generateSampleData();
				} else if(propertyValue == "L"){
					//Empty the Select Option List
					domConstruct.empty(this.context.coachViewData.inputDiv);

					this.populateFromJSON(this.context.coachViewData.staticListData);
				}
			}
		}));
    },
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
	},

	//Init the config section to hide any options that are not relevant to the current selections
	initializeConfigurationOptionVisibility: function(configHelper) {
		var visibility, value = "E";
		var configOptionValue = configHelper.getConfigOptionValue(this, "itemLookupMode");
		if (configOptionValue != undefined) {
			value = configOptionValue;
		}
		visibility = this.getOptionVisibility(value);
		
		this.setConfigurationOptionVisibility(visibility);
	},
	setConfigurationOptionVisibility: function(visibility) {
		this.configurationOptionVisibility = visibility;
	},
	getConfigurationOptionVisibility: function() {
		return this.configurationOptionVisibility;
	},
	getOptionVisibility: function(value) {
		var visibility;
		
		switch(value) {
			case "B": 
				visibility = {"itemService": {visible: false},
							 "inputData": {visible: false},
			 				 "disableAutoCall": {visible: false},
							 "itemList": {visible: true},
							 "staticList": {visible: false}
							};
				break;
			case "L": 
				visibility = {"itemService": {visible: false},
			 				"inputData": {visible: false},
			 				"disableAutoCall": {visible: false},
			 				"itemList": {visible: false},
			 				"staticList": {visible: true}
		  					};
				break;
			case "S": 
				visibility = {"itemService": {visible: true},
							 "inputData": {visible: true},
			 				 "disableAutoCall": {visible: true},
							 "itemList": {visible: false},
							 "staticList": {visible: false}
							};
				break;
			case "E":
		    default:
				visibility = {"itemService": {visible: false},
			 				"inputData": {visible: false},
			 				"disableAutoCall": {visible: false},
			 				"itemList": {visible: false},
			 				"staticList": {visible: false}
							};
			  break;
		}
		return visibility;
	}
};

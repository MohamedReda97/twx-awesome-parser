bpmext_control_InitGeoLocation = function(domConstruct, domClass, domStyle, lang, bpmext, utilities)
{
	this._instance = {
		_geoPollCount : 0,
		_geoWatchId : null
	};
	
	if(!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONLOCINFOREQ : "eventON_LOCINFOREQ",
			EVT_ONLOCINFO : "eventON_LOCINFO",
			EVT_ONLOCINFOERR : "eventON_LOCINFOERR",
			_onLocationInfo : function(view, location, success)
			{
				var error;
				
				if(location)
				{
					if(location.errorCode != undefined)
					{
						error = {message: location.errorMessage, code: location.errorCode};
					}
					else
					{
						//view._instance._location = location;
						view.context.binding.set("value", location);
						
						bpmext.ui.executeEventHandlingFunction(view, this.EVT_ONLOCINFO, location);	
					}
				}
				else
				{
					//{#feature: US-1330 Added RT localization}
					//error = {message: "General error", code: -1};
					error = {message: bpmext.localization.formatMsg("controlGeoLocation", "GL_GENERAL_ERROR"), code: -1};
				}
				
				if(error != null)
				{
					//TODO: Publish alert
					bpmext.ui.executeEventHandlingFunction(view, this.EVT_ONLOCINFOERR, error);
				}
			},
			_toRad : function(num)
			{
				return num * Math.PI / 180;
			}
		};
		/**
		 * @instance
		 * @memberof GeoLocation
		 * @method requestUpdate
		 * @desc Requests an update on the geo location
		 */
		this.constructor.prototype.requestUpdate = function()
		{
			if(this._instance._geoWatchId)
			{
				navigator.geolocation.clearWatch(this._instance._geoWatchId);
				this._instance._geoWatchId = null;
			}
			
			var deviceInfo = {};

			var res = null;
			
			if(navigator.geolocation && navigator.geolocation.getCurrentPosition)
			{
				var coords = {};
				var view = this;

				try
				{
					bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONLOCINFOREQ);

					var getPosition = function(position)
					{
						view._instance._geoPollCount++;
						
						coords.latitude = position.coords.latitude;
						coords.longitude = position.coords.longitude;
						coords.accuracy = position.coords.accuracy;
						coords.altitude = position.coords.altitude;
						coords.altitudeAccuracy = position.coords.altitudeAccuracy;
						coords.heading = position.coords.heading;
						coords.speed = position.coords.speed;
						coords.timestamp = position.timestamp;
						coords.time = new Date();
						
						view._proto._onLocationInfo(view, coords, true);
					};
					
					var getError = function(error)
					{
						view._instance._geoPollCount++;

						switch(error.code) 
						{
							case error.PERMISSION_DENIED:
								//{#feature: US-1330 Added RT localization}
								//coords.errorMessage = "User denied request for Geolocation";
								coords.errorMessage = bpmext.localization.formatMsg("controlGeoLocation", "GL_PERMISSION_DENIED_ERROR");
								break;
							case error.POSITION_UNAVAILABLE:
								//{#feature: US-1330 Added RT localization}
								//coords.errorMessage = "Location information unavailable";
								coords.errorMessage = bpmext.localization.formatMsg("controlGeoLocation", "GL_POSITION_UNAVAILABLE_ERROR");
								break;
							case error.TIMEOUT:
								//{#feature: US-1330 Added RT localization}
								//coords.errorMessage = "Request to get user location timed out";
								coords.errorMessage = bpmext.localization.formatMsg("controlGeoLocation", "GL_TIMEOUT_ERROR");
								break;
							case error.UNKNOWN_ERROR:
								//{#feature: US-1330 Added RT localization}
								//coords.errorMessage = "Unknown error";
								coords.errorMessage = bpmext.localization.formatMsg("controlGeoLocation", "GL_UNKNOWN_ERROR");
								break;
						}
						
						coords.time = new Date();
						coords.errorCode = error.code;
						
						view._proto._onLocationInfo(view, coords, false);
					};
					
					if(view.context.options.monitoringMode.get("value") != "C")
					{
						navigator.geolocation.getCurrentPosition(
							getPosition,
							getError,
							{
								maximumAge: view.context.options.maxAge.get("value"), 
								timeout: view.context.options.geoTimeout.get("value"), 
								enableHighAccuracy: view.context.options.highAccuracy.get("value")
							}
						);
					}
					else
					{
						view._instance._geoWatchId = navigator.geolocation.watchPosition(
							getPosition,
							getError,
							{
								maximumAge: view.context.options.maxAge.get("value"), 
								timeout: view.context.options.geoTimeout.get("value"), 
								enableHighAccuracy: view.context.options.highAccuracy.get("value")
							}
						);
					}
				}
				catch(e)
				{
					coords.errorCode = -1;
					coords.time = new Date();
					//{#feature: US-1330 Added RT localization}
					//coords.errorMessage = "Cannot retrieve location information: " + e;
					coords.errorMessage = bpmext.localization.formatMsg("controlGeoLocation", "GL_LOC_INFO_FAIL_ERROR") + ": " + e;
					view._proto._onLocationInfo(view, coords, false);
				}
			}
			else
			{
				setTimeout(function(){view._proto._onLocationInfo(view, res, true)});
			}
		}		
	}
	
	/**
	 * @instance
	 * @memberof GeoLocation
	 * @method getPollCount
	 * @desc Gets the poll count
	 * @returns {integer}
	 */
	this.constructor.prototype.getPollCount = function()
	{
		return this._instance._geoPollCount;
	}
	
	/**
	 * @instance
	 * @memberof GeoLocation
	 * @method calculateDistance
	 * @param {decimal} lat1 the first latitude 
	 * @param {decimal} lon1 the first longitude 
	 * @param {decimal} lat2 the second latitude 
	 * @param {decimal} lon2 the second longitude 
	 * @desc Calculates the difference between two sets of latitudes and longitudes
	 * @returns {decimal} The distance between points, in km
	 */
	this.constructor.prototype.calculateDistance = function(lat1, lon1, lat2, lon2)
	{
		var R = 6371; //Earth radius (km)
		var dLat = this._proto._toRad(lat2 - lat1);
		var dLon = this._proto._toRad(lon2 - lon1); 
		var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
			  Math.cos(this._proto._toRad(lat1)) * Math.cos(this._proto._toRad(lat2)) * 
			  Math.sin(dLon / 2) * Math.sin(dLon / 2); 
		var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); 
		var d = R * c;
		
		return d;
	}
	
	/**
	 * @instance
	 * @memberof GeoLocation
	 * @method getType
	 * @desc Get descriptive string representing the type of control/section
	 * @returns {string}
	 */
	this.constructor.prototype.getType = function()
	{
		return "geoLocation.3";
	}
	
	this.constructor.prototype.load = function()
	{
		try
		{
			bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONLOCINFOREQ);
			bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONLOCINFO, "location");
			bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONLOCINFOERR, "error");

			if (!this.context.binding)
				this.context.binding = bpmext.ui.substituteObject(this, null, null, null);

			var opts = this.context.options;

			if (!opts.highAccuracy)
				bpmext.ui.substituteConfigOption(this, "highAccuracy", false);
			
			if (!opts.geoTimeout)
				bpmext.ui.substituteConfigOption(this, "geoTimeout", 6000);

			if (!opts.maxAge)
				bpmext.ui.substituteConfigOption(this, "maxAge", 0);

			if (!opts.monitoringMode)
				bpmext.ui.substituteConfigOption(this, "monitoringMode", "L");

			bpmext.ui.loadView(this);

			var view = this;
			if(opts.monitoringMode.get("value") != "S")
			{
				setTimeout(function(){
					view.requestUpdate();
				});
			}
		}
		catch (e)
		{
			//{#feature: US-1330 Added RT localization}
			//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
			bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
			if(e.stack) { 
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("  Call stack: " + e.stack);
				bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
			}
		}
	};
	
	this.constructor.prototype.unload = function()
	{
		bpmext.ui.unloadView(this);
	};

	this.constructor.prototype.view = function()
	{

	};

	this.constructor.prototype.change = function(event)
	{
		
	};

	this.constructor.prototype.collaboration = function(event)
	{
		
	};
	
	this.constructor.prototype.validate = function(event)
	{
		
	};	
};

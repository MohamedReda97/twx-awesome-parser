var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", "dojo/dom-style", bpmextUri, configHelperUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, domStyle, bpmext, configHelper){
			bpmext.uidesign.css.ensureGlyphsLoaded(this);			
						
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");
			domClass.add(this.context.coachViewData.containingDiv, "Step_Chart_SDS");
									
			this.context.coachViewData.stepChartDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.stepChartDiv, "SPARKChart");			
			domStyle.set(this.context.coachViewData.stepChartDiv,{"width":"100%","height":"100%"});
			
			this.context.coachViewData.disablerDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.disablerDiv, "disabler hidden");
			
			this.context.coachViewData.labelTextDom = document.createTextNode("{{ sdsDataService.dataSeries.seriesName }}");
			this.context.coachViewData.label = domConstruct.create("div");
			domClass.add(this.context.coachViewData.label, "control-label");
			domAttr.set(this.context.coachViewData.label, "id", "StepChartSDSLabel_" + this.context.modelData.layoutItemIdPath);
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);
			domStyle.set(this.context.coachViewData.label,{"width":"100%","text-align":"center"});

			this.context.imageUrl = this.context.getManagedAssetUrl("BPMExt-Control-StepChartSDS-Preview.png", this.context.assetType_WEB, "SYSBPMUI");			
			this.context.coachViewData.imageEl = domConstruct.create("img",{src: this.context.imageUrl});
			domStyle.set(this.context.coachViewData.imageEl,{"width":"100%"});
						
			this.context.coachViewData.stepChartDiv.appendChild(this.context.coachViewData.disablerDiv);	
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.label);
			this.context.coachViewData.stepChartDiv.appendChild(this.context.coachViewData.imageEl);
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.stepChartDiv);			

			this.coachViewImpl_updateLabel = function() {
				if(this.context.coachViewData.dataMode == "S"){
					this.context.coachViewData.labelTextDom.data = "{{ sdsDataService.dataSeries.seriesName }}";
				} else {
					var singleDataSeriesPropertyValue = configHelper.getConfigOptionValue(this, "singleDataSeries");
					this.context.coachViewData.singleDataSeries = singleDataSeriesPropertyValue && JSON.parse(singleDataSeriesPropertyValue);
					this.context.coachViewData.labelTextDom.data = (this.context.coachViewData.singleDataSeries && this.context.coachViewData.singleDataSeries.seriesName) || "";
				}
			}

			callback();
		}));	
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-attr", "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domAttr, domConstruct, configHelper){
				
			if(propertyName ==  "@labelVisibility"){
				if(propertyValue == "HIDE"){
					this.context.coachViewData.label.style.display = "none";
				} else {
					this.context.coachViewData.label.style.display = "";
				}			
			} else if(propertyName == "height"){				
				if(!!propertyValue) {															
					domAttr.set(this.context.coachViewData.imageEl, "height", isNaN(propertyValue) ? propertyValue : (propertyValue+"px"));
				} else {															
					domAttr.set(this.context.coachViewData.imageEl, "height", "100%");
				}				
			} else if(propertyName == "radius"){				
				if(!!propertyValue) {																				
					this.context.coachViewData.containingDiv.style.borderRadius = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {															
					this.context.coachViewData.containingDiv.style.borderRadius = "0px";
				}				
			} else if(propertyName == "padding"){				
				if(!!propertyValue) {																				
					domStyle.set(this.context.coachViewData.stepChartDiv,"padding",isNaN(propertyValue) ? propertyValue : (propertyValue+"px"));
				} else {															
					domStyle.set(this.context.coachViewData.stepChartDiv,"padding","0px");
				}				
			} else if(propertyName == "backgroundColorStyle"){
				var colorStyle;				
				if(propertyValue == "P"){
					colorStyle = "bg-primary";					
				} else if(propertyValue == "I"){
					colorStyle = "bg-info";					
				} else if(propertyValue == "S"){
					colorStyle = "bg-success";					
				} else if(propertyValue == "W"){
					colorStyle = "bg-warning";					
				} else if(propertyValue == "G"){
					colorStyle = "bg-danger";					
				} else {
					colorStyle = "";					
				}
				domClass.replace(this.context.coachViewData.containingDiv, colorStyle, "bg-primary bg-info bg-success bg-warning bg-danger");												
			} else if(propertyName == "dataMode"){
				this.context.coachViewData.dataMode = propertyValue;
				this.coachViewImpl_updateLabel();
			} else if(propertyName == "singleDataSeries"){
				this.coachViewImpl_updateLabel();
			}		
		}));	
    },	
	modelChanged: function(propertyName, propertyValue) {
			
	}
};

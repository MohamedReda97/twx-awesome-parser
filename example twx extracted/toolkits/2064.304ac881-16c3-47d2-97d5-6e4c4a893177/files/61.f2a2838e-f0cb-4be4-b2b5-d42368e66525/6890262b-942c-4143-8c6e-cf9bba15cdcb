bpmext_control_InitDataExport = function (utilities, bpmext, domClass, domAttr, domConstruct, fastclick, XLSX, JSZip) {
    this._instance = {
        btn : null,
        txtNode : null,
        iconSpan : null,
        multiClicks : true,
        colorStyle : null,
        shapeStyle : null,
        sizeStyle : null
    };

    if (!this.constructor.prototype._proto) {
        this.constructor.prototype._proto = {
            OPTS_COL_STLZ : {
                "D" : "",
                "P" : "btn-primary",
                "I" : "btn-info",
                "S" : "btn-success",
                "W" : "btn-warning",
                "G" : "btn-danger",
                "E" : "btn-danger",
                "B" : "btn-dark"
            },
            OPTS_SHP_STLZ : {
                "D" : "",
                "R" : "btn-rounded",
                "F" : "btn-flat"
            },
            OPTS_SZ_STLZ : {
                "D" : "",
                "L" : "btn-lg",
                "S" : "btn-sm",
                "X" : "btn-xs"
            },
            EVT_ONCLICK : "eventON_CLICK",
            EVT_ONCELLEXPT : "eventON_CELLEXPT",

            // Number of milliseconds in a day, i.e. 24 * 60 * 60 * 1000
            DAY_MILLISECONDS : 86400000,
            // Number of minutes in a day, i.e. 60 * 24
            DAY_MINUTES : 1440,
            // Number of days from Microsoft Excel's epoch, i.e new Date(1899, 11, 30) and Javascript's epoch, i.e. new Date(1970, 0, 1)
            // (new Date(1970, 0, 1).getTime() - new Date(1899, 11, 30).getTime()) / (24 * 60 * 60 * 1000)
            MS_DAY_OFFSET : 25569,
            _toMSExcelDate : function(date) {
                var timezoneOffset = date.getTimezoneOffset() / this.DAY_MINUTES;
                var msExcelDate = (date.getTime() / this.DAY_MILLISECONDS) + (this.MS_DAY_OFFSET - timezoneOffset);
                if (msExcelDate < 0) {
                    var frac = msExcelDate - Math.trunc(msExcelDate);
                    if (frac !== 0) {
                        msExcelDate = Math.ceil(msExcelDate) - frac - 2;
                    }
                }
                return msExcelDate;
            },
            _setText : function (view, text) {

                try {
                    var mdt = view.context.options._metadata;
                    var baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
                    var genPrefTextDir = view.context.bpm.system.baseTextDirection;
                    var txtNode = view._instance.txtNode;

                    if (text != null && text.length != "") {
                        txtNode.textContent = text; //view.context.htmlEscape(text);
                        utilities.BiDi.applyTextDir(txtNode, txtNode.textContent, baseTxtDir, genPrefTextDir);
                    } else {
                        txtNode.textContent = "\u00a0"; //Non-breaking space to prevent button height collapse
                    }
                } catch (e) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("DataExport._setText() error: " + e);
                    bpmext.log.error("DataExport._setText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setHelpText : function (view, text) {
                try {
                    var mdt = view.context.options._metadata;
                    var btn = view._instance.btn;

                    if (text != null && text.length != "") {
                        btn.title = text;
                    } else {
                        btn.title = null;
                    }
                } catch (e) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("DataExport._setHelpText() error: " + e);
                    bpmext.log.error("DataExport._setHelpText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setWidth : function (view, width) {
                try {
                    if (width != null && width != "") {
                        if (!isNaN(width))
                            width += "px";

                        view._instance.btn.style.width = width;

                        domClass.add(view.context.element, "widthSet");
                    } else {
                        view._instance.btn.style.width = null;

                        domClass.remove(view.context.element, "widthSet");
                    }
                } catch (e) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("DataExport._setWidth() error: " + e);
                    bpmext.log.error("DataExport._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _replaceClass : function (view, valueMap, newVal, oldVal) {
                if (newVal != null)
                    newVal = newVal.toUpperCase();

                if (oldVal != null)
                    oldVal = oldVal.toUpperCase();

                var oldClass = valueMap[oldVal];
                if (oldClass == null)
                    oldClass = "";

                var newClass = valueMap[newVal];
                if (newClass == null)
                    newClass = "";

                domClass.replace(view._instance.btn, newClass, oldClass);
            },
            _setColorStyle : function (view, newVal, oldVal) {
                oldVal = bpmext.ui.util.normalizeColorStyle(oldVal, this.OPTS_COL_STLZ);
                newVal = bpmext.ui.util.normalizeColorStyle(newVal, this.OPTS_COL_STLZ);
                newVal = bpmext.ui.util.normalizeColorStyle(newVal, this.OPTS_COL_STLZ);
                this._replaceClass(view, this.OPTS_COL_STLZ, newVal, oldVal);
            },
            _normalizeShapeStyle : function (val) {
                if (!val)
                    val = "D";

                val = val.toUpperCase();
                if (val.length > 1) {
                    switch (val) {
                    case "DEFAULT":
                    case "DEF":
                    case "D":
                        val = "D";
                        break;
                    case "ROUND":
                    case "ROUNDED":
                        val = "R";
                        break;
                    case "FLAT":
                        val = "F";
                        break;
                    default:
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.warn("Unexpected shape style value: " + val);
                        bpmext.log.warn(bpmext.localization.formatMsg("controlDataExport", "DE_SHAPE_STYLE_WARNING",val));
                    }
                }

                return val;
            },
            _setShapeStyle : function (view, newVal, oldVal) {
                newVal = this._normalizeShapeStyle(newVal);
                oldVal = this._normalizeShapeStyle(oldVal);

                this._replaceClass(view, this.OPTS_SHP_STLZ, newVal, oldVal);
            },
            _setSizeStyle : function (view, newVal, oldVal) {
                newVal = bpmext.ui.util.normalizeSizeStyle(newVal, this.OPTS_SZ_STLZ);
                oldVal = bpmext.ui.util.normalizeSizeStyle(oldVal, this.OPTS_SZ_STLZ);

                this._replaceClass(view, this.OPTS_SZ_STLZ, newVal, oldVal);
            },
            _setOutline : function (view, outline) {
                var fn = outline ? domClass.add : domClass.remove;
                fn(view._instance.btn, "btn-outline");
            },
            _setIcon : function (view, icon) {
                if (view._instance.iconSpan) {
                    view._instance.btn.removeChild(view._instance.iconSpan);
                    view._instance.iconSpan = null;
                }

                if (icon != null && icon != "") {
                    var span = document.createElement("span");
                    var iconClasses = "";
                    icon = icon.trim().toLowerCase();

                    if(bpmext.text.startsWith(icon, "ci-")) {
                        var svgElement = utilities.getCarbonIcon(icon);
                        if (svgElement) {
                            span.appendChild(svgElement);
                            iconClasses = " ci ";
                        }
                    } else {
                        if (!bpmext.text.startsWith(icon, "fa-")){
                            icon = "fa-" + icon;
                        }
                        iconClasses = "fa " + icon;
                    }

                    domClass.add(span, "btn-label icon " + iconClasses);
                    domClass.add(view._instance.btn, "btn-labeled");
                    domConstruct.place(span, view._instance.btn, "first");
                    view._instance.iconSpan = span;
                } else {
                    domClass.remove(view._instance.btn, "btn-labeled");
                }
            },
            _handleVisibility : function (view) {
                var btn = view._instance.btn;
                var visibility = bpmext.ui.getEffectiveVisibility(view);

                view.context.setDisplay(visibility != "NONE");
                view.context.setVisibility(visibility != "HIDDEN");

                if (visibility != "NONE") {
                    if (visibility == "READONLY") {
                        btn.disabled = true;
                        domClass.add(btn, "disabled");
                    } else {
                        btn.disabled = false;
                        domClass.remove(btn, "disabled");
                    }
                }
            },
            _setTabIndex : function (view, index) {
                if (index != null)
                    domAttr.set(view._instance.btn, "tabindex", index);
                else
                    domAttr.remove(view._instance.btn, "tabindex");
            },
            _setFileType : function (view, type) {
                ft = type.toLowerCase();
                if (ft.charAt(0) == '.')
                    ft = ft.substring(1);

                if (ft == 'xlsx' || ft == 'csv') {
                    view._instance.fileType = ft;
                } else {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.warn("File type '" + type + "' unknown. Output will be .csv");
                    bpmext.log.warn(bpmext.localization.formatMsg("controlDataExport", "DE_FILE_TYPE") +" '" + type + "' " + bpmext.localization.formatMsg("controlDataExport", "DE_FILETYPE_WARNING"));
                }
            },
            _setFileName : function (view, name) {
                var ext = "." + view._instance.fileType;
                if (name.length >= ext.length && name.toLowerCase().substring(name.length - ext.length) === ext)
                    name = name.substring(0, name.lastIndexOf('.'));

                view._instance.fileName = name;
            },
            _setColNameFlag : function (view, flag) {
                view._instance.colNames = flag;
            },
            _setColumnSpecs : function (view, formats) {
                view._instance.cspecs = [];

                var items = formats.items;
                for (var i = 0; i < items.length; i++) {
                    view._instance.cspecs[i] = {
                        fmt : items[i].columnFormatString
                    };
                }
            },
            _setColumnHeaders : function (view, headers) {
                view._instance.cheaders = [];

                var items = headers.items;
                for (var i = 0; i < items.length; i++) {
                    view._instance.cheaders[i] = items[i];
                }
            },
            _setColumnOrder : function (view, order) {
                view._instance.cOrder = [];

                var items = order.items;
                for (var i = 0; i < items.length; i++) {
                    view._instance.cOrder[i] = items[i];
                }
            },
            _setTableRef : function (view, tableName) {
                if (bpmext.text.startsWith(tableName, "${")) {
                    tableName = tableName.substring(2, tableName.length - 1);
                }

                if (tableName) {
                    //{bug# BG-843 Data Export associated table reference doesn't always work}
                    view._instance.table = view.ui.getParent().ui.get(tableName);

                    if (view._instance.table)
                        return;
                }

                view._instance.table = null;
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.warn("Could not find " + (tableName ? tableName : "suitable table/layout to populate control"));
                bpmext.log.warn(bpmext.localization.formatMsg("controlDataExport", "DE_NOT_FIND") + " " + (tableName ? tableName : bpmext.localization.formatMsg("controlDataExport", "DE_LAYOUT_WARNING")));
            },
            _getData : function (view) {
                var res = [];

                if (view.context.binding.get("value") && view.context.binding.get("value").items) {
                    var items = view.context.binding.get("value").items;

                    if (items && items.length > 0) {
                        var keys = Object.keys(items[0]);
                        var keyNum = keys.length;
                        var length = (view._instance.cOrder.length > 0) ? view._instance.cOrder.length : keyNum;

                        for (var i = 0; i < items.length; i++) {
                            res[i] = [];
                            var j = 0;
                            var k;
                            for (k = 0; k < length; k++) {
                                var prop =  view._instance.cOrder[k] || keys[k];
                                //if (items[i].hasOwnProperty(prop) && typeof items[i][prop] !== 'function') {
                                if (items[i].hasOwnProperty(prop) && typeof items[i][prop] !== 'function' && (typeof items[i][prop] !== 'object' || items[i][prop] instanceof Date || items[i][prop] === null)){
                                    //BG-1182 allowing items with null value as null is typeof object
                                    //BG-846 Skipping over nested complex objects, except for date
                                    res[i][j] = {
                                        value : items[i][prop]
                                    };

                                    if (view._instance.cspecs && view._instance.cspecs[j])
                                        res[i][j].fmt = view._instance.cspecs[j].fmt;

                                    if (view._instance._onCellExptFn && view._instance._onCellExptFn.execute) {

                                        var cellCtx = {
                                            view : items[i][prop],
                                            table : null,
                                            value : items[i][prop],
                                            rowIndex : i,
                                            colIndex : j
                                        };

                                        var r;

                                        try {
                                            r = view._instance._onCellExptFn.execute(cellCtx);
                                        } catch (e) {
                                            //{#feature: US-1330 Added RT localization}
                                            //bpmext.log.error("Error on cell export event [" + view.ui.getAbsoluteName() + "]: " + e);
                                            bpmext.log.error(bpmext.localization.formatMsg("controlDataExport", "ERROR_ONCELLEXPORT_EVENT") +" [" + view.ui.getAbsoluteName() + "]: " + e);
                                            //bpmext.log.error("  Cell at row " + i + ", column: " + j);
                                            bpmext.log.error(" " + bpmext.localization.formatMsg("controlDataExport", "DE_CELL_AT_ERROR", i, j));

                                            if(e.stack) {
                                                //{#feature: US-1330 Added RT localization}
                                                //bpmext.log.error("  Call stack: " + e.stack);
                                                bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                                            }
                                        }

                                        if (r === null || typeof r === 'boolean' || typeof r === 'string' || typeof r === 'number') {
                                                res[i][j].value = r;
                                            } else if (typeof r === 'object' && r.format !== undefined && typeof r.format === 'string') {
                                                if (r.value !== undefined)
                                                    res[i][j].value = r.value;
                                                res[i][j].fmt = r.format;
                                            }

                                    }

                                    j++;
                                }
                            }
                        }
                    }

                    if (view._instance.colNames) {
                         var colNames = [];

                        if (view._instance.cheaders.length > 0) {
                            for (var header=0; header<view._instance.cheaders.length; header++) {
                                colNames.push({
                                    value : view._instance.cheaders[header]
                                });

                            }
                            res.unshift(colNames);
                        }
                    }
                } else if (view._instance.table) {
                    res = view._proto._getTableData(view);
                } else {
                    bpmext.log.warn(bpmext.localization.formatMsg("controlDataExport", "DE_DATASOURCE_WARNING") + " " + view.ui.getAbsoluteName());
                }

                return res;
            },
            _getTableData : function (view) {
                var res = [];

                if (view._instance.table) {
                    if (view._instance.table.getType() == "layout.3" || view._instance.table.getType() == "table.3") {
                        var children = view._instance.table.context.subview;
                        var j = 0;
                        var cspecIdx = 0;
                        var skipped = false;
                        for (var child in children) {
                            if (children.hasOwnProperty(child) && typeof children[child] !== "function") {
                                var i = 0;
                                for (var row in children[child]) {
                                    if (children[child].hasOwnProperty(row) && typeof children[child][row] !== "function") {
                                        if (!view.context.options.inclInvis.get("value") && (!children[child][row].isVisible() || (view._instance.table._instance.cspecs && view._instance.table._instance.cspecs[cspecIdx].visibility == "N"))) {
                                            skipped = true;
                                            continue;
                                        }

                                        if (!res[i])
                                            res[i] = [];

                                        res[i][j] = {
                                            value : children[child][row].getData()
                                        };

                                        if (view._instance.cspecs && view._instance.cspecs[cspecIdx])
                                            res[i][j].fmt = view._instance.cspecs[cspecIdx].fmt;

                                        if (view._instance._onCellExptFn && view._instance._onCellExptFn.execute) {

                                            var cellCtx = {
                                                view : children[child][row],
                                                table : view._instance.table,
                                                value : children[child][row].getData(),
                                                rowIndex : i,
                                                colIndex : j
                                            };

                                            var r;

                                            try {
                                                r = view._instance._onCellExptFn.execute(cellCtx);
                                            } catch (e) {
                                                //{#feature: US-1330 Added RT localization}
                                                //bpmext.log.error("Error on cell export event [" + view.ui.getAbsoluteName() + "]: " + e);
                                                bpmext.log.error(bpmext.localization.formatMsg("controlDataExport", "ERROR_ONCELLEXPORT_EVENT") +" [" + view.ui.getAbsoluteName() + "]: " + e);
                                                //bpmext.log.error("  Cell at row " + i + ", column: " + j);
                                                bpmext.log.error(" " + bpmext.localization.formatMsg("controlDataExport", "DE_CELL_AT_ERROR", i, j));

                                                if(e.stack) {
                                                    //{#feature: US-1330 Added RT localization}
                                                    //bpmext.log.error("  Call stack: " + e.stack);
                                                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                                                }
                                            }

                                            if (r === null || typeof r === 'boolean' || typeof r === 'string' || typeof r === 'number') {
                                                res[i][j].value = r;
                                            } else if (typeof r === 'object' && r.format !== undefined && typeof r.format === 'string') {
                                                if (r.value !== undefined)
                                                    res[i][j].value = r.value;
                                                res[i][j].fmt = r.format;
                                            }
                                        }

                                        i++;
                                    }
                                }
                                cspecIdx++;
                                if (!skipped)
                                    j++;

                                skipped = false;
                            }
                        }
                    }

                    if (view._instance.colNames) {
                        if (!children)
                            var children = view._instance.table.context.subview;

                        var colNames = [];

                        var j = 0;
                        for (var child in children) {
                            if (children.hasOwnProperty(child) && typeof children[child] !== "function") {
                                for (var row in children[child]) {
                                    if (children[child].hasOwnProperty(row) && typeof children[child][row] !== "function") {
                                        if (!view.context.options.inclInvis.get("value") && (!children[child][row].isVisible() || (view._instance.table._instance.cspecs && view._instance.table._instance.cspecs[j].visibility == "N")))
                                            continue;

                                        var value;
                                        if (!!view._instance.cheaders[j]) {
                                            value = view._instance.cheaders[j];
                                        } else {
                                            value = children[child][row].context.options._metadata.label.get("value");
                                        }
                                        colNames.push({
                                            value : value
                                        });

                                        break;
                                    }
                                }
                                j++;
                            }
                        }
                        res.unshift(colNames);
                    }
                } else {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.warn("Warning: no data source associated with " + view.ui.getAbsoluteName());
                    bpmext.log.warn(bpmext.localization.formatMsg("controlDataExport", "DE_DATASOURCE_WARNING") + " " + view.ui.getAbsoluteName());
                }

                return res;
            },
            _generateWorksheet : function (view) {
                var data = view._proto._getData(view);
                var ws = {};
                var range = {
                    s : {
                        c : 0,
                        r : 0
                    },
                    e : {
                        c : 0,
                        r : 0
                    }
                };

                var fmtIdx = 0;

                for (var row = 0; row < data.length; row++) {
                    for (var col = 0; col < data[row].length; col++) {
                        if (range.e.r < row)
                            range.e.r = row;
                        if (range.e.c < col)
                            range.e.c = col;

                        var cell = {
                            v : data[row][col].value
                        };
                        if (cell.v === null)
                            continue;

                        if (data[row][col].fmt) {
                            XLSX.SSF.load(data[row][col].fmt, 166 + fmtIdx);
                            cell.z = data[row][col].fmt;
                            fmtIdx++;
                        }

                        var cell_ref = XLSX.utils.encode_cell({
                                c : col,
                                r : row
                            });

                        if (typeof cell.v === 'number') {
                            cell.t = 'n';
                        } else if (typeof cell.v === 'boolean')
                            cell.t = 'b';
                        else if (cell.v instanceof Date) {
                            cell.t = 'n';

                            if (!cell.z)
                                cell.z = XLSX.SSF._table[14];

                            cell.v = view._proto._toMSExcelDate(cell.v);
                        } else {
                            cell.t = 's';
                        }
                        ws[cell_ref] = cell;
                    }
                }

                if (range.s.c < 99999999)
                    ws['!ref'] = XLSX.utils.encode_range(range);
                return ws;
            },
            _addToWorkbook : function (view, ws, newWb) {
                if (!view._instance.wb || newWb)
                    view._instance.wb = {
                        SheetNames : [],
                        Sheets : {}
                    };

                if (view.context.binding.get("value") && view.context.binding.get("value")._objectPath) {
                    var wsName = view.context.binding.get("value")._objectPath;

                    if (wsName.indexOf('.') > -1)
                        wsName = wsName.substring(wsName.indexOf('.') + 1);
                } else {
                    var wsName = view._instance.table.context.options._metadata.label.get("value");
                }

                view._instance.wb.SheetNames.push(wsName);
                view._instance.wb.Sheets[wsName] = ws;
            },
            _exportFile : function (view, ws) {
                view._proto._addToWorkbook(view, ws, true);

                var out,
                theBlob;

                if (view._instance.fileType === 'xlsx') {
                    out = XLSX.write(view._instance.wb, {
                            bookType : 'xlsx',
                            bookSST : true,
                            type : 'binary'
                        });

                    var b = new ArrayBuffer(out.length);
                    var v = new Uint8Array(b);
                    for (var i = 0; i < out.length; i++) {
                        v[i] = out.charCodeAt(i) & 0xFF;
                    }

                    theBlob = new Blob([b], {type : ""});
                } else {
                    out = XLSX.utils.sheet_to_csv(ws);
                    theBlob = new Blob([out], {type : "text/plain;charset=UTF-8"});
                }

                if ((/iPad|iPhone/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' 
                && navigator.maxTouchPoints > 1)) && !window.MSStream) {
                    //ios does not support blob saving, use alternate method - file name not accepted
                    var reader = new FileReader();
                    reader.onload = function(e) {
                           var dataUrl = reader.result;
                           var open = window.open(dataUrl);
                           if (open === null || typeof (open) === 'undefined') {
                                  var blobUrl = URL.createObjectURL(theBlob)
                                  window.location.href = blobUrl;
                           }
                           if (!!this.setState) {
                               this.setState({ disabled: false });
                           }
                    };
                    reader.readAsDataURL(theBlob);
                } else {
                    //not ios, use FileSaver
                    saveAs(theBlob, view._instance.fileName + "." + view._instance.fileType);
                }

            }
        };


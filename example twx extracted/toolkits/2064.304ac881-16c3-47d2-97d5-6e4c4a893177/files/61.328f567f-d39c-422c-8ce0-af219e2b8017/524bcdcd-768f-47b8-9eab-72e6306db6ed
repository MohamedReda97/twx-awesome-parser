/**
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is triggered when the Variant control is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.reset()<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Change:</td>
 *     <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is triggered when there is a change detected.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>console.log(me.getValue())<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitVariant = function (utilities, bpmext, domAttr, domConstruct)
{
	this._instance =
	{
		colTemplates : [],
		vbox : null,
		cv : null,
		ctlType : null,
		ctlTypeToIdx : {}
	};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE",
			gcChildViews : function (view)
			{
				try {
					var childNodes = view._instance.vbox.childNodes;

					for (var i = 0; i < childNodes.length; i++)
					{
						var childNode = childNodes[i];
						if (domAttr.has(childNode, "data-viewid"))
						{
							view.context.deleteView(childNode);
						}
					}

					view._instance.vbox.innerHTML = "";
					view._instance.cv = null;
				} catch (e) {
					bpmext.log.error("Variant.gcChildViews() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
				}
			},
			parseControlType : function (node)
			{
				try {
					var controlType = domAttr.get(node, "data-type");

					if (controlType)
					{
						controlType = controlType.substring(controlType.lastIndexOf(".") + 1);
						return controlType;
					}

					return null;
				} catch (e) {
					bpmext.log.error("Variant.parseControlType() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
				}
			},
			_getContentBox : function(view, from)
			{
				try {
					if(!view._instance.contentBox)
					{
						var children = from.children;
						for(var i = 0; i < children.length; i++)
						{
							var child = children[i];
							if(child.className && /\bContentBox\b/.test(child.className))
							{
								view._instance.contentBox = child;
								break;
							}
						}				
					}
					
					return view._instance.contentBox;
				} catch (e) {
					bpmext.log.error("Variant._getContentBox() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
				}
			},
			_handleVisibility : function (view)
			{
				try {
					utilities.handleVisibility(view.context);
				} catch (e) {
					bpmext.log.error("Variant._handleVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
				}
			},
			_showControl: function _showControl(view, idx) {
				try {
					var tNode = view._instance.colTemplates[idx];
					var newNode = tNode.cloneNode(true);
					var cv = view.context.createView(newNode, 0, view);
					
					cv.context.options._metadata.label.set("value", view.context.options._metadata.label.get("value"));
					cv.context.options._metadata.labelVisibility.set("value", view.context.options._metadata.labelVisibility.get("value"));
					cv.context.options._metadata.visibility.set("value", view.context.options._metadata.visibility.get("value"));
					cv.context.options._metadata.helpText.set("value", view.context.options._metadata.helpText.get("value"));
					
					view._instance.cv = cv;
					//this._instance.ctlType = this._proto.parseControlType(tNode);
					
					if(cv.context.binding == null)
					{
						//Might be a problem for some views since load already done based on no binding
						cv.context.binding = bpmext.ui.substituteObject(cv);
					}

					setTimeout(function(){
						var vval = view.context.binding.get("value");
						
						if(typeof vval != "undefined")
							cv.context.binding.set("value", vval);
						else
						{                    
							//BG-1076 adding defensive code for unloaded view
							if(cv.context == null)
								return;

							var cval = cv.context.binding.get("value");
							if(typeof cval != "undefined")
							{
								view.context.binding.set("value", cval);
							}
						}
					});
					
					cv.__change0 = cv.change;
					cv.change = function (event) //Spoof child change handler to notify parent
					{
						if (cv.__change0) //Check because CV may not have a change handler (though unlikely)
						{
							//debugger;
							//console.log("cv.change: " + cv.context.binding.get("value"));
							cv.__change0(event);
							
							if (event.type == "binding" || !event.type)
							{
								if(event.newVal != event.oldVal)
								{
									view.context.binding.set("value", event.newVal);
								}
							}
						}
					};			
					
					view._instance.vbox.innerHTML = "";
					view._instance.vbox.appendChild(newNode);
				} catch (e) {
					bpmext.log.error("Variant._showControl() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
				}
			}
		};

		//Public control methods
		/**
		 * @instance
		 * @memberof Variant
		 * @method showControl
		 * @param {integer} idx the index of that variant control that you want to show
		 * @desc This method allows you to programmatically set the index of the control to be used
		 * @example me.showControl(0);
		 */
		this.constructor.prototype.showControl = function (idx)
		{
			this._proto.gcChildViews(this);
			this._proto._showControl(this, idx);
		};

		/**
		 * @instance
		 * @memberof Variant
		 * @method reset
		 * @desc This method resets the variant control which causes NO control to display
		 * @example me.reset();
		 */
		this.constructor.prototype.reset = function ()
		{
			this._proto.gcChildViews(this);

			this._instance.cv = null;
			this._instance.vbox.innerHTML = "";
		};
		
		/**
		 * @instance
		 * @memberof Variant
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */		
		this.constructor.prototype.getType = function ()
		{
			return "variant.3";
		};
		
		/**
		 * @instance
		 * @memberof Variant
		 * @method getDisplayedType
		 * @desc Get descriptive string representing the type of control the variant is currently displaying or "none" if no control is currently displayed
		 * @returns {string}
		 */			
		this.constructor.prototype.getDisplayedType = function ()
		{
			return (this._instance.cv ? this._instance.cv.getType() : "none");
		};
		
		/**
		 * @instance
		 * @memberof Variant
		 * @method getValue
		 * @desc This method returns the current value that is shown by the Variant control.  It can return any primitive types or object.
		 * @return {(integer|string|boolean|decimal|object)}
		 */
		this.constructor.prototype.getValue = function()
		{
			return this.context.binding.get("value");
		};
		
		/**
		 * @instance
		 * @memberof Variant
		 * @method setValue
		 * @param {(integer|string|boolean|decimal|object)} val the value
		 * @desc This method allows to programmatically set the value for the control
		 * @example me.setValue(132);
		 */
		this.constructor.prototype.setValue = function(val)
		{
			if(this.context.binding) {
				this.context.binding.set("value", val);
			} else {
				this.setViewData(val, true);
			}
		};

		/**
		 * @instance
		 * @memberof Variant
		 * @method getCurrentChildView()
		 * @return {CoachView}
		 * @desc This method returns the reference to the Coach View currently shown by the Variant control
		 * @example me.getCurrentChildView().setValid(false, "Validation error");
		 */
		this.constructor.prototype.getCurrentChildView = function()
		{
			return this._instance.cv;
		};
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGE);
				
				var opts = this.context.options;
				var mdt = opts._metadata;

				if (!this.context.binding)
					this.context.binding = bpmext.ui.substituteObject(this, null, null, void(0));

				if (!opts.autoSelectControl)
					bpmext.ui.substituteConfigOption(this, "autoSelectControl", false);
				
				var immediateContentBox = this._proto._getContentBox(this, this.context.element);
				var childNodes = immediateContentBox.childNodes;
				var j = 0;

				for(var i = 0; i < childNodes.length; i++)
				{
					var childNode = childNodes[i];
					if(domAttr.has(childNode, "data-viewid"))
					{
						var newNode = childNode.cloneNode(true);

						this._instance.colTemplates.push(newNode);
						this._instance.ctlTypeToIdx[this._proto.parseControlType(newNode)] = j++; //{#bug: * Incorrect control index when Variant contains "accidental" DOM nodes}
					}
				}

				this.context.element.removeChild(immediateContentBox); //Done with template - no need to keep it around

				//{#bug: * Handling of unexpected recursion when contained control handles changes improperly - ED}
				this._instance._invCounter = 0;
				
				this._instance.vbox = document.createElement("div");
				this.context.element.appendChild(this._instance.vbox);

				bpmext.ui.loadView(this);

				var cIdxExp = opts.initialControlIndex ? opts.initialControlIndex.get("value") : null;
				if(cIdxExp != null)
				{
					cIdxExp = cIdxExp + "";
					if(cIdxExp.length > 0)
					{
						try
						{
							cIdxExp = bpmext.ui.substituteEventHandlerFunctionVars(cIdxExp, "view");
							bpmext.log.debug("Variant init index expression: " + cIdxExp);
							
							var fn = new Function("view", "me", "return (" + cIdxExp + ")");
							var idx = fn(this.ui.getParent(), this);
					
							if(typeof idx == "number")
								this.showControl(idx);
						}
						catch(e)
						{
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.error("Error processing expression for Variant control " + this.ui.getAbsoluteName() + ": " + e);
							bpmext.log.error(bpmext.localization.formatMsg("controlVariant", "VARIANT_EXPR_PROCESSING_ERROR") + " " + this.ui.getAbsoluteName() + ": " + e);
							//bpmext.log.error("  Expression: " + cIdxExp);
							bpmext.log.error(" " + bpmext.localization.formatMsg("general", "EXPRESSION") + ": " + cIdxExp);
						}
					}
				}
				else if(opts.autoSelectControl.get("value"))
				{
					var val = this.context.binding.get("value");
					var type = Object.prototype.toString.call(val);
					var idx;
					
					switch(type)
					{
						case "[object String]":
						{
							idx = this._instance.ctlTypeToIdx["Text"];

							//{#feature: * Added extra auto-selection flexibility with Masked Text and Type Ahead Text}
							if(typeof idx == "undefined")
								idx = this._instance.ctlTypeToIdx["Masked_Text"];

							if(typeof idx == "undefined")
								idx = this._instance.ctlTypeToIdx["Type_Ahead_Text"];
							
                            if(typeof idx == "undefined")
                                idx = this._instance.ctlTypeToIdx["Output_Text"];

                            if(typeof idx == "undefined")
                                idx = this._instance.ctlTypeToIdx["Text_Area"];

							break;
						}
						case "[object Date]":
						{
							idx = this._instance.ctlTypeToIdx["Date_Picker"] || this._instance.ctlTypeToIdx["Date_Time_Picker"];

							break;
						}
						case "[object Number]":
						{
							if(val % 1 != 0) //Decimal
								idx = this._instance.ctlTypeToIdx["Decimal"];
							else
								idx = this._instance.ctlTypeToIdx["Integer"];

							break;
						}
						case "[object Boolean]":
						{
							idx = this._instance.ctlTypeToIdx["Checkbox"];
							
							if(typeof idx == "undefined")
								idx = this._instance.ctlTypeToIdx["Switch"]; //{#feature: * Added extra auto-selection flexibility with Switch}

							break;
						}
					}

					if(typeof idx != "undefined")
						this.showControl(idx);
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if(this._instance.cv && this._instance.cv.context)
				{
					if(event.type == "config") 
					{
						switch(event.property)
						{
							case "_metadata.labelVisibility":
							{
								this._instance.cv.context.options._metadata.labelVisibility.set("value", event.newVal);
								break;
							}
							case "_metadata.visibility":
							{
								this._proto._handleVisibility(this);
								this._instance.cv.context.options._metadata.visibility.set("value", event.newVal);
								break;
							}
							case "_metadata.label":
							{
								this._instance.cv.context.options._metadata.label.set("value", event.newVal);
								break;
							}
							case "_metadata.helpText":
							{
								this._instance.cv.context.options._metadata.helpText.set("value", event.newVal);
								break;
							}
						}
					}
					else
					{
						if(event.newVal != event.oldVal)
							bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE);
						
						if(this._instance.cv.context.binding)
						{
							try
							{
								//{#bug: * Handling of unexpected recursion when contained control handles changes improperly - ED}
								if(this._instance._invCounter++ < 1)
								{
									this._instance.cv.context.binding.set("value", event.newVal);
								}
								else
								{
									//{#feature: US-1330 Added RT localization}
									//console.warn("Attempting to stop runaway change handling - check control contained in Variant for potential change-handling defect");
									console.warn(bpmext.localization.formatMsg("controlVariant", "VARIANT_CHANGE_WARNING"));
									//this._instance._invCounter = 1; //Defensive invocation counter reset
									
									//{#feature: US-1330 Added RT localization}
									//throw new Error("Recursion safety handler");
									throw new Error(bpmext.localization.formatMsg("controlVariant", "VARIANT_RECURSION_ERROR"));
								}
							}
							finally
							{
								this._instance._invCounter--;
							}
						}
					}					
				}
				
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.validate = function (event)
		{
			if(this._instance.cv && this._instance.cv.context && this._instance.cv.validate)
				this._instance.cv.validate(event);
		};

		/*
		this.constructor.prototype.collaboration = function (event)
		{};
		*/
		
		this.constructor.prototype.unload = function ()
		{
			this._proto.gcChildViews(this);
			bpmext.ui.unloadView(this);
		};		
	}
};

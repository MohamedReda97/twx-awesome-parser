			var opts = this.context.options;
			this._instance.onClear = true;
			var lookupMode = opts.itemLookupMode.get("value");			
			
			//{#bug: BG-761 changed to specify lookupMode E for second compare}
			if(lookupMode == "S" || lookupMode == "E")
			{
				this._instance.itemList = new com.ibm.bpm.coach.List([], "svc.items");
				this._proto._loadListItems(this, this._instance.itemList);
			}
			else if(lookupMode == "L" || lookupMode == "B")
			{
				for(var i = this._instance.itemList.length() - 1; i >= 0; i--)
				{
					this._instance.itemList.remove(i);
				}
				
				this._proto._loadListItems(this, this._instance.itemList, this.context.binding.get("value"));				
			}
			//{#bug: BG-761 added to indicate no selected items }
			this.context.binding.set("value", []);			
		}
		

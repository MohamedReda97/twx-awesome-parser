		 * @param {ANY} value Value of item/option in checkbox group control
		 * @param {string} text The display text to show for the item/option
		 */
		this.constructor.prototype.setItem = function(idx, val, text)
		{
			var obj = {};
			obj[this._instance._optValProp] = val;
			obj[this._instance._optDisProp] = text;
			
			//BG-732 deselect option if value is changed
			var opt = this._instance.select.getOptionAt(idx);
			if (opt && (opt.value != val))
			{
				this._proto._addRemoveSelectedItem(this, opt.value, false);	
			}
			
			this._instance.itemList.put(idx, obj);			
		}
		


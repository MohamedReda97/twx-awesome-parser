/** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>console.log(me.getItemCount())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Service Items:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when AJAX Service returns item list. Only triggers if Item lookup Mode is set to Items From Service.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>console.log("CheckboxGroup1 item service retrieved items successfully")</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Service Error:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when AJAX selection service returns an error. Will not trigger if Item Lookup Mode is not set to Items From Service.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.clearItems()</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Change:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when the bound data changes.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${CheckboxGroup2}.reloadServiceItems(me.getSelectedIndices())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitCheckboxGroup = function (bpmext, utilities, domClass, domAttr, domConstruct, dom, domGeometry, json)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		//this._instance.select.options[i].selected
		var CheckboxGroup = function (view, parentElt)
		{
			this._parent = parentElt;
			this.options = [];
			this.view = view;
		};
		
		//Just so I remember...
		CheckboxGroup.prototype.onchange = void(0);
		
		CheckboxGroup.prototype.setSelectedOption = function(val, selected)
		{
			var children = this._parent.querySelectorAll("span.checkbox3");
			for(var i = 0; i < children.length; i++)
			{
				var spanElt = children[i];
				var input = spanElt.querySelector("input");
				var value = domAttr.get(input, "value");
				
				if(value == val)
				{
					if(selected){
						//domAttr.set(input, "checked", "");
						//Added for Tk-1066
						input.checked=true;
						domAttr.set(input,"aria-checked", "true");
						//Ends
					}
					else{
						//domAttr.remove(input, "checked");
						//Added for Tk-1066
						input.checked=false;
						domAttr.set(input,"aria-checked", "false");
						//Ends
					}
					
					return i;		// BG-818 return the affected index
				}
			}
			return -1;  // BG-818 No such value
		};
		
		CheckboxGroup.prototype.setSelectedOptions = function(values)
		{
			if(values)
			{
				var map = {};
				for(var i = 0; i < values.length; i++)
				{
					if(values[i][this.view._instance._optValProp] != undefined) {
						map[values[i][this.view._instance._optValProp]] = true;
					} 
					else {
						map[values[i]] = true;
					}
				}

	            var children = this._parent.querySelectorAll("span.checkbox3");
	            for(var i = 0; i < children.length; i++)
	            {
	                var spanElt = children[i];
	                var input = spanElt.querySelector("input");
	                var value = domAttr.get(input, "value");
	                
	                if(map[value]){
	                    //domAttr.set(input, "checked", "");
	                    //Added for Tk-1066
	                    input.checked=true;
	                        domAttr.set(input,"aria-checked", "true");
	                        //Ends
	                }
	                else{
	                    //domAttr.remove(input, "checked");
	                    //Added for Tk-1066
	                        input.checked=false;
	                        domAttr.set(input,"aria-checked", "false");
	                        //Ends
	                }
	            }
			}
		}
		
		CheckboxGroup.prototype.setSelectedIndex = function(idx, selected)
		{
			var children = this._parent.querySelectorAll("span.checkbox3");
			var spanElt = children[idx];
			if(spanElt)
			{
				var input = spanElt.querySelector("input");
				if(selected){
					//domAttr.set(input, "checked", "");
					//Added for Tk-1066
						input.checked=true;
						domAttr.set(input,"aria-checked", "true");
						//Ends
				}
				else{
					 //domAttr.remove(input, "checked");
					//Added for Tk-1066
						input.checked=false;
						domAttr.set(input,"aria-checked", "false");
						//Ends
				}
			}
		};		
		//US-1340 added setTabIndex method 
		CheckboxGroup.prototype.setTabIndex = function(index)
		{
			var children = this._parent.querySelectorAll("span.checkbox3");
			
			for(var i = 0; i < children.length; i++)
			{
				var spanElt = children[i];
				var input = spanElt.querySelector("input");
				
				if(index != null)
					domAttr.set(input, "tabindex", index);
				else
					domAttr.remove(input, "tabindex");
			}
		};
		
		CheckboxGroup.prototype.getOptionsLength = function()
		{
			var children = this._parent.querySelectorAll("span.checkbox3");
			return children.length;
		};

		CheckboxGroup.prototype.removeOptionAt = function(idx)
		{
//			debugger;
			var children = this._parent.querySelectorAll("span.checkbox3");
			var spanElt = children[idx];
			if(spanElt)
			{
				//{#bug:392 removeItemAt returns TypeError.}
				var parent = spanElt.parentNode;
				parent.removeChild(spanElt);
			}
		};

		CheckboxGroup.prototype.setOptionAt = function(idx, key, value)
		{
			var children = this._parent.querySelectorAll("span.checkbox3");
			var spanElt = children[idx];
			if(spanElt)
			{
				var input = spanElt.querySelector("input");
				domAttr.set(input, "value", key);

				var span = spanElt.querySelector("span");
				span.innerHTML = this.view.context.htmlEscape(value);
				utilities.BiDi.applyTextDir(span, span.innerHTML, this.view._instance.baseTxtDir, this.view._instance.genPrefTextDir);
			}
		}
		
		CheckboxGroup.prototype.getOptionAt = function(idx)
		{
			var res;
			var children = this._parent.querySelectorAll("span.checkbox3");
			var spanElt = children[idx];
			if(spanElt)
			{
				var input = spanElt.querySelector("input");
				var span = spanElt.querySelector("span");
				res = {
					idx: idx,
					text: span.innerHTML,
					value: domAttr.get(input, "value")
				};
			}
			
			return res;
		}
		
		CheckboxGroup.prototype.getOption = function(val)
		{
			var children = this._parent.querySelectorAll("span.checkbox3");
			for(var i = 0; i < children.length; i++)
			{
				var spanElt = children[i];
				var input = spanElt.querySelector("input");
				

				var value = domAttr.get(input, "value");
				
				if(value == val)
				{
					var span = spanElt.querySelector("span");
					var opt = {
						value: value,
						text: span.innerHTML,
						idx: i
					};
					
					return opt;
				}
			}
		}
		
		CheckboxGroup.prototype.getSelectedOptions = function()
		{
			var res = {
				values: [],
				idxs: []
			};
			
			var children = this._parent.querySelectorAll("span.checkbox3");
			for(var i = 0; i < children.length; i++)
			{
				var spanElt = children[i];
				var input = spanElt.querySelector("input");
				var checked = input.checked;//domAttr.has(input, "checked");//

				if(checked)
				{
					var value = domAttr.get(input, "value");
					res.values.push(value);
					res.idxs.push(i);
				}
			}
			
			return res;
		};
		
		CheckboxGroup.prototype.setDisabled = function(flag) {
			flag = flag || false; //coerce the value of flag 
			var inputs = this._parent.querySelectorAll("span.checkbox3 > input:not([data-disabled=\"true\"])");
			for(var i = inputs.length - 1; i >= 0; i--) {
				domAttr.set(inputs[i], {"disabled": flag, "aria-disabled": flag});
			}
		};
		
		CheckboxGroup.prototype.setOptionDisabled = function(val, flag) {
			if (val) {
				flag = flag || false; //coerce the value of flag 
				var inputs = this._parent.querySelectorAll("span.checkbox3 > input[value=\"" + val + "\"]");
				for(var i = inputs.length - 1; i >= 0; i--) {
					domAttr.set(inputs[i], {"disabled": flag, "aria-disabled": flag, "data-disabled": "" + flag});// data-* must be string 
				}
			}
		};

		CheckboxGroup.prototype.clear = function()
		{
			this._parent.innerHTML = "";
		};
		
		CheckboxGroup.prototype.appendOption = function(key, value, checked)
		{
			var divElt = document.createElement("div");
			
			//TK-1066 changed from label to span
			var spanElt = document.createElement("span");
			domClass.add(spanElt, "checkbox3");
			var input = document.createElement("input");
			domAttr.set(input, "id", "checkboxgroup-item-input-" + this.view.context.controlidpath + "[" + this.view._instance.select.getOptionsLength() + "]");
			input.onfocus = function(e)
			{
				if(!!this.nextElementSibling) {
					this.nextElementSibling.classList.add("checkboxFocus");
				}
			}
			input.onblur = function(e) 
			{
				if(!!this.nextElementSibling) {
					this.nextElementSibling.classList.remove("checkboxFocus");
				}
			}
			domAttr.set(input, "type", "checkbox");
			//Added for TK-1066
			domAttr.set(input, "role", "checkbox");
			var spanID = "checkboxgroup-item-label-" + this.view.context.controlidpath + "[" + this.view._instance.select.getOptionsLength() + "]";
			domAttr.set(input,"aria-labelledby",spanID);
			//Ends
			domAttr.set(input, "value", key);
			//domClass.add(input, "px");
			//US-1340 added tab index support
			var tabIndex = this.view.context.options.tabIndex.get("value");
			if (tabIndex != null)
				domAttr.set(input, "tabindex", tabIndex);
			
			if(checked)
			{

				//domAttr.set(input, "checked", "");
				//Added for TK-1066
				input.checked=true;
				domAttr.set(input,"aria-checked", "true");
				//Ends
			}//else added for tk1066
			else
			{
				//Added for TK-1066
				input.checked=false;
				domAttr.set(input,"aria-checked", "false");
				//Ends

			}
			
			var _this = this;

			input.onclick = function(event)
			{
				var checked = input.checked;//domAttr.has(input, "checked"); //
				
				if(!checked)
				{
					//domAttr.remove(input, "checked");
					//Added for Tk-1066
					input.checked=false;
					domAttr.set(input, "aria-checked","false");
					//Ends
				}
				else
				{
					//domAttr.set(input, "checked", "");
					//Added for Tk-1066
					input.checked=true;
					domAttr.set(input,"aria-checked", "true");
					//Ends
				}

				if(_this.onclick)
					_this.onclick(event, input.checked);
			}
			
			var span = document.createElement("span");
			span.onclick = function () // BUG 814
			{
				input.click();
			}
			//domClass.add(span, "lbl");
			//Added for TK-1066
			domAttr.set(span,"id",spanID);
			//Ends
			
			if (this.view.context.options.allowHTML.get("value"))
				span.innerHTML = value;
			else{
				span.innerHTML = this.view.context.htmlEscape(value);
			}

			utilities.BiDi.applyTextDir(span, span.innerHTML, this.view._instance.baseTxtDir, this.view._instance.genPrefTextDir);

			var flag = !this.view.isEnabled();
			domAttr.set(input, {"disabled": flag, "aria-disabled": flag});

			spanElt.appendChild(input);
			spanElt.appendChild(span);
			divElt.appendChild(spanElt);
			
			this._parent.appendChild(divElt);
		};
		
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE",
			EVT_ONSVCITEMS : "eventON_SVCITEMS",
			EVT_ONSVCERROR : "eventON_SVCERROR",
			_getItemIndex : function (view, value)
			{
				var opt = view._instance.select.getOption(value);
				if(opt)
					return opt.idx;
				else
					return -1;
			},
			//{#bug: BUG-818 binding not updating ... prototype method called to add/remove selected items from those currently selected} 
			_addRemoveSelectedItem : function (view, value, bool)
			// bool operand is TRUE for an add
			// bool operand is FALSE for a remove
			{
				var idx = view._instance.select.setSelectedOption(value, bool);
				var boundData = view.context.binding.get("value");
				if ( (idx != -1) && (bool == true) )
				{  // add item
					if (boundData.items.length == 0)
						view.context.binding.set("value", [ value ]);
					else
					{
						var addValue = true;
						for (var i = 0; i < boundData.items.length; i++)
						{
							if (boundData.items[i] == value)
							{
								addValue = false;
								break;
							}					
						}
						if (addValue == true)
						{
							var newArray = boundData.items.push(value);
						}
					}		
				}
				else if ( (idx != -1) && (bool == false) )
				{
					if (boundData.items.length == 0)
						return;
					for (var i = 0; i < boundData.items.length; i++)
					{
						if (boundData.items[i] == value)
						{
							boundData.items.splice(i,1);
							break;
						}
					}
				}
			},			
			//{#feature: * Allow leniency for mapping complex-typed items list element to simple-typed bound data list}
			_mapBindingValues : function(view, values)
			{
				if(view.isBound() && view.context.bindingType)
				{
					var bType = view.context.bindingType();
					if(bType == "String[]")
					{
						if(values != null && values.length > 0)
						{
							var typeOfItems = typeof values[0];
							var values2 = [];
							
							if(typeOfItems == "object")
							{
								for(var i = 0; i < values.length; i++)
								{
									values2.push(values[i][view._instance._optValProp]);
								}
								
								values = values2;
							}
							else if(typeOfItems == "number")
							{
								for(var i = 0; i < values.length; i++)
								{
									values2.push(values[i] + "");
								}
								
								values = values2;
							}
						}
					}
				}

				return values;
			},			
			_setSelectedItems : function (view, values)
			{
				view._instance.select.setSelectedOptions((values ? values.items : []));
			},
			_rebindAllUpdates : function(view)
			{
				
			},
			_loadListItems : function(view, itemList, selectedValue, keyProp, valueProp)
			{
				if(view._instance._bindSelUpdHandle)
					view._instance._bindSelUpdHandle.unbind();

				if(view._instance._bindValueUpdHandle)
					view._instance._bindValueUpdHandle.unbind();
				
				if(keyProp == null)
					keyProp = "name";
				
				if(valueProp == null)
					valueProp = "value";
				
				view._instance._bindValueUpdHandle = itemList.bindAll(
					function(event){
						if(event.insertedInto >= 0 && event.insertedInto != event.removedFrom)
						{
							view._proto._rebindAllUpdates(view);
							
							if(event.insertedInto == view._instance.select.getOptionsLength()) //If inserted at the end
							{
								var selValue = view.context.binding.get("value");
								var selMap = {};

								if(selValue && selValue.items)
								{
								   for(var i = 0; i < selValue.items.length; i++)
								   {
										if (selValue.items[i][keyProp]) {
											selMap[selValue.items[i][keyProp]] = true;
										} else {
											selMap[selValue.items[i]] = true;
										}
								   }
								}
								
								var item = event.newVal;
								var key = item[keyProp];
								view._instance.select.appendOption(key, item[valueProp], selMap[key]);
							}
							else
							{
								//{#feature: US-1330 Added RT localization}
								//bpmext.log.error("Mid-list inserts not supported by Coach NG API yet");
								bpmext.log.error(bpmext.localization.formatMsg("general", "MID_LIST_INSERT_COACH_NG_ERROR"));
							}
						}
						else if(event.removedFrom >= 0 && event.removedFrom != event.insertedInto) //List item deletion
						{
							view._proto._rebindAllUpdates(view);
							view._instance.select.removeOptionAt(event.removedFrom);
						}
						else if(event.removedFrom >= 0 && event.removedFrom == event.insertedInto)//Just a value change...
						{
							if(event.newVal != null)
							{
								view._instance.select.setOptionAt(
									event.removedFrom, 
									event.newVal[view._instance._optValProp],
									event.newVal[view._instance._optDisProp]
									);
							}
						}							
					}, 
					view
					);

				view._instance._bindSelUpdHandle = itemList.bind(
					"listAllSelectedIndices", 
					function(event){
						var itemKeys = [];
						var idxs = event.newVal;
						
						for(var i = 0; i < idxs.length; i++)
						{
							itemKeys.push(view._instance.itemList.items[idxs[i]][keyProp]);
						}

						view._proto._setSelectedItems(view, {items: itemKeys});
					}, 
					view
					);

				view._instance.select.clear();

				var items = itemList.items;
				var map = {};
				
				if(selectedValue && selectedValue.items)
				{
					for(var i = 0; i < selectedValue.items.length; i++)
					{
						if (selectedValue.items[i][keyProp]) {
							map[selectedValue.items[i][keyProp]] = true;
						} else {
							map[selectedValue.items[i]] = true;
						}
					}
				}
				
				for(var i = 0; i < items.length; i++)
				{
					var key = items[i][keyProp];
					view._instance.select.appendOption(key, items[i][valueProp], map[key]);
				}
				//{#bug: BG-803 deal with visibilty issues}
				view._proto._handleVisibility(view);
			},	// end _loadListItems
			_updateControl : function (view)
			{
				var errors = bpmext.ui.getViewValidationErrors(view);
				
				//Color style
				var colStyle = errors ? "E" : "D";  //{#bug: BG-777 }
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_COL_STL_CLZ, colStyle, view._instance.oldColStyle);
				view._instance.oldColStyle = colStyle;
				
				//Validation Error Icon
				if(view._instance.icon)
				{
					bpmext.ui.util.closeTooltip(view._instance.iconTT, view._instance.input);
					delete view._instance.iconTT;
					
					view._instance.input.removeChild(view._instance.icon);
					delete view._instance.icon;
				}
				
				if(errors)
				{
					domClass.add(view._instance.group, "has-feedback has-error");
					view._instance.icon = document.createElement("span");
					view._instance.input.appendChild(view._instance.icon);
					
					if (view.context.options.showValidationMarker.get("value") === true) {
						domClass.add(view._instance.icon, "fa form-control-feedback fa-exclamation-circle");

						var ttOpts = {
							horizontalPos: "right", 
							verticalPos: "top", 
							cssClass: "validationError",
							plainText: false,
							smartPositioning: true
						};
					
						view._instance.iconTT = bpmext.ui.util.showTooltip(
							view._instance.input, 
							bpmext.ui.util.formatErrors(errors), 
							ttOpts
						);
					
						view._instance.errorMessage = document.createElement("div");
						view._instance.errorMessage.id = view._instance.input.firstElementChild.id + "-error-msg";
						view._instance.errorMessage.classList.add("hide");
						view._instance.errorMessage.innerHTML = bpmext.ui.util.formatErrors(errors);
						view._instance.input.appendChild(view._instance.errorMessage);
						domAttr.set(view._instance.input.firstElementChild, "aria-describedby", view._instance.errorMessage.id);
						domAttr.set(view._instance.input.firstElementChild, "aria-invalid", "true");
					}
				}
				else
				{
					domClass.remove(view._instance.group, "has-feedback has-error");
					if (view._instance.errorMessage) { view._instance.errorMessage.remove(); }
					domAttr.remove(view._instance.input.firstElementChild, "aria-describedby");
					domAttr.remove(view._instance.input.firstElementChild, "aria-invalid");				
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			_setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else {
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}
					
					domClass.remove(view.context.element, "labelWidth");
				}
					
			},			
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(view._instance.label)
						view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{

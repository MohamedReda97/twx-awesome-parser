var mixObject = {
	createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-style", "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domStyle, domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureGeneralStylesLoaded(this);
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");
			
			//this.context.coachViewData.badgeNode = domConstruct.create("a", {href: "javascript:void(0)"});
			this.context.coachViewData.badgeNode = domConstruct.create("button");
			domClass.add(this.context.coachViewData.badgeNode, "badge");
			dojo.attr(this.context.coachViewData.badgeNode, "role", "button");
			
			//override some CSS so that an empty badge still appears on the canvas
			domStyle.set(this.context.coachViewData.badgeNode, "min-height", "10px");
			domStyle.set(this.context.coachViewData.badgeNode, "min-width", "10px");
			domStyle.set(this.context.coachViewData.badgeNode, "display", "inline-block");
			domStyle.set(this.context.coachViewData.containingDiv, "background", "none");
			
			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.badgeNode.appendChild(this.context.coachViewData.labelTextDom);
			
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.badgeNode);
			
			this.context.coachViewData.labelShapeColorStyle = "";
			this.context.coachViewData.badgeShapeColorStyle = "";
			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, undefined, undefined, true, true);
			
			callback();
		}));	
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.badgeNode;
	},
	propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, configHelper){
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "colorStyle"){
				var colorStyle;
				var isLabelShapeStyle = this.context.coachViewData.shapeStyle == "T" || this.context.coachViewData.shapeStyle == "L";
				this.context.coachViewData.labelShapeColorStyle;
				this.context.coachViewData.badgeShapeColorStyle;
				if(propertyValue == "P"){
					this.context.coachViewData.labelShapeColorStyle = "label-primary";
					this.context.coachViewData.badgeShapeColorStyle = "badge-primary";
					colorStyle = isLabelShapeStyle ? "label-primary" : "badge-primary";
				} else if(propertyValue == "I"){
					this.context.coachViewData.labelShapeColorStyle = "label-info";
					this.context.coachViewData.badgeShapeColorStyle = "badge-info";
					colorStyle = isLabelShapeStyle ?  "label-info" : "badge-info";
				} else if(propertyValue == "S"){
					this.context.coachViewData.labelShapeColorStyle = "label-success";
					this.context.coachViewData.badgeShapeColorStyle = "badge-success";
					colorStyle = isLabelShapeStyle ?  "label-success" : "badge-success";
				} else if(propertyValue == "W"){
					this.context.coachViewData.labelShapeColorStyle = "label-warning";
					this.context.coachViewData.badgeShapeColorStyle = "badge-warning";
					colorStyle = isLabelShapeStyle ?  "label-warning" : "badge-warning";
				} else if(propertyValue == "E"){
					this.context.coachViewData.labelShapeColorStyle = "label-danger";
					this.context.coachViewData.badgeShapeColorStyle = "badge-danger";
					colorStyle = isLabelShapeStyle ?  "label-danger" : "badge-danger";
				} else {
					this.context.coachViewData.labelShapeColorStyle = "";
					this.context.coachViewData.badgeShapeColorStyle = "";
					colorStyle = "";
				}
				domClass.replace(this.context.coachViewData.badgeNode, colorStyle, 
					"badge-primary badge-info badge-success badge-warning badge-danger label-primary label-info label-success label-warning label-danger");	
			} else if(propertyName == "shapeStyle"){
				var shapeStyle;
				if(propertyValue == "T"){
					shapeStyle = "label label-tag " + this.context.coachViewData.labelShapeColorStyle;
				} else if(propertyValue == "L"){
					shapeStyle = "label " + this.context.coachViewData.labelShapeColorStyle;
				} else {
					shapeStyle = "badge " + this.context.coachViewData.badgeShapeColorStyle;
				}
				domClass.replace(this.context.coachViewData.badgeNode, shapeStyle, "badge label label-tag " + 
						"badge-primary badge-info badge-success badge-warning badge-danger label-primary label-info label-success label-warning label-danger");
				this.context.coachViewData.shapeStyle = propertyValue;
			}
		}));	
    },
	
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
	}
};

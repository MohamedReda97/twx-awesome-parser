var mixObject = {
	createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureGeneralStylesLoaded(this);
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			
			this.context.coachViewData.data_binding = undefined;
			this.context.coachViewData.data_expression = undefined;
			this.context.coachViewData.data_linkText = undefined;
			this.context.coachViewData.data_linkTextRaw = undefined;
			
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");
			this.context.coachViewData.formGroupDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.formGroupDiv, "form-group");

			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.label = domConstruct.create("span");
			domClass.add(this.context.coachViewData.label, "control-label");
			domAttr.set(this.context.coachViewData.label, "id", "LinkLabel_" + this.context.modelData.layoutItemIdPath);
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);

			this.context.coachViewData.inputDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.inputDiv, "input SPARKLink");
			this.context.coachViewData.inputDiv.style.width="100%";
			this.context.coachViewData.defaultWidth = "100%";

			this.context.coachViewData.output = domConstruct.create("p");
			domClass.add(this.context.coachViewData.output, "text-left");
			dojo.attr(this.context.coachViewData.output, "aria-labelledby", this.context.coachViewData.label.id);
					
			this.context.coachViewData.link = domConstruct.create("a");
			dojo.attr(this.context.coachViewData.link, "role", "link");
			dojo.attr(this.context.coachViewData.link, "id", "link-link-" + this.context.coachViewData.label.id);
			this.context.coachViewData.output.appendChild(this.context.coachViewData.link);
			this.context.coachViewData.inputDiv.appendChild(this.context.coachViewData.output);

			domConstruct.place(this.context.coachViewData.formGroupDiv, this.context.coachViewData.containingDiv);
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.label);
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.inputDiv);

			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, this.context.coachViewData.label, this.context.coachViewData.containingDiv, false, false);
			this.updateOutputArea();
			callback();
		}));	
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.label;
	},
	propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, configHelper){
			
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "labelPlacement"){
				var labelPlacement;
				if(propertyValue == "L"){
					labelPlacement = "label-left";
				} else {
					labelPlacement = "";
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, labelPlacement, "label-left");
			} else if(propertyName == "sizeStyle"){
				var sizeStyle;
				if(propertyValue == "R"){
					sizeStyle = "text-slg";
				} else if(propertyValue == "X"){
					sizeStyle = "text-xlg";
				} else if(propertyValue == "G"){
					sizeStyle = "text-lg";
				} else if(propertyValue == "L"){
					sizeStyle = "text-bg";
				} else if(propertyValue == "S"){
					sizeStyle = "text-sm";
				} else if(propertyValue == "M"){
					sizeStyle = "text-xs";
				} else {
					sizeStyle = "";
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, sizeStyle, "text-slg text-xlg text-lg text-bg text-sm text-xs");
			} else if(propertyName == "width"){
				if(propertyValue == ""){
					this.context.coachViewData.containingDiv.style.width = this.context.coachViewData.defaultWidth;
				}else{
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				}
            } else if (propertyName == "labelWidth") {
                if (propertyValue) {
                    this.context.coachViewData.label.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue + "px");
                    domClass.add(this.context.coachViewData.containingDiv, "labelWidth");
                } else {
                    this.context.coachViewData.label.style.width = "";
                    domClass.remove(this.context.coachViewData.containingDiv, "labelWidth");
                }
			} else if(propertyName == "expression"){
				this.context.coachViewData.data_expression = propertyValue;
				this.updateOutputArea();
			} else if(propertyName == "linkText"){
				this.context.coachViewData.data_linkText = propertyValue;
				this.updateOutputArea();
			} else if(propertyName == "textAlignment"){
				var textAlignment;
				if(propertyValue == "R"){
					textAlignment = "text-right";
				} else if(propertyValue == "C"){
					textAlignment = "text-center";
				} else {
					textAlignment = "text-left";
				}
				domClass.replace(this.context.coachViewData.output, textAlignment, "text-left text-center text-right");
			} else if(propertyName == "weightStyle"){
				var weightStyle;
				if(propertyValue == "S"){
					weightStyle = "text-slim";
				} else if(propertyValue == "N"){
					weightStyle = "text-normal";
				} else if(propertyValue == "M"){
					weightStyle = "text-semibold";
				} else if(propertyValue == "B"){
					weightStyle = "text-bold";
				} else {
					weightStyle = "text-left";
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, weightStyle, "text-slim text-normal text-semibold text-bold");
			} else if(propertyName == "colorStyle"){
				var colorStyle;
				if(propertyValue == "D"){
					colorStyle = "text-default";
				} else if(propertyValue == "M"){
					colorStyle = "text-muted";
				} else if(propertyValue == "L"){
					colorStyle = "text-light-gray";
				} else if(propertyValue == "P"){
					colorStyle = "text-primary";
				} else if(propertyValue == "I"){
					colorStyle = "text-info";
				} else if(propertyValue == "S"){
					colorStyle = "text-success";
				} else if(propertyValue == "W"){
					colorStyle = "text-warning";
				} else if(propertyValue == "G"){
					colorStyle = "text-danger";
				} else {
					colorStyle = "";
				}
				domClass.replace(this.context.coachViewData.output, colorStyle, "text-primary text-info text-success text-warning text-danger text-muted text-light-gray text-default");
			}
		}));	
	},
	updateOutputArea:function(){
		if(this.context.coachViewData.data_expression){
			this.context.coachViewData.link.innerHTML = this.context.coachViewData.data_expression;
		} else {
			if(this.context.coachViewData.data_linkText){
				this.context.coachViewData.link.innerHTML = this.context.coachViewData.data_linkText;
			}else if(this.context.coachViewData.data_linkTextRaw){
				this.context.coachViewData.link.innerHTML = this.context.coachViewData.data_linkTextRaw;
			}else{
				this.context.coachViewData.link.innerHTML = "Link";
			}
		} 
	},
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);

		if(propertyName == "linkText"){
			this.context.coachViewData.data_linkTextRaw = propertyValue;
			this.updateOutputArea();
		}
	}
};
bpmext_control_InitInputGroup = function (bpmext, utilities, domClass, domAttr, domConstruct, fastclick)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype.IS_ADDRESS_INVISIBLE = true;

		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE",
			EVT_ONCLICK : "eventON_CLICK",
			OPTS_COL_BG_CLZ : {
				"D" : "bg",
				"P" : "bg-primary",
				"I" : "bg-info",
				"S" : "bg-success",
				"W" : "bg-warning",
				"G" : "bg-danger",
				"E" : "bg-danger"
			},
			OPTS_COL_BTN_CLZ : {
				"D" : "btn",
				"P" : "btn-primary",
				"I" : "btn-info",
				"S" : "btn-success",
				"W" : "btn-warning",
				"G" : "btn-danger",
				"E" : "btn-danger"
			},
			OPTS_SZ_STL_CLZ: {
				"D" : "",
				"L" : "input-group-lg",
				"S" : "input-group-sm"
			},
			OPTS_BTN_LOC_CLZ: {
				"L" : "left",
				"R" : "right"
			},
			_updateControl : function (view)
			{

			},
			_createLabel : function (view)
			{
				//view._instance.label = document.createElement("label");
				//Added for TK-1269 : STARTS
				view._instance.label = document.createElement("span");
				//TK-1269 : ENDS
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.outer, "first");

				//{#feature: US-696 ARIA labeling}
				if(view._instance.ariaLabelTarget != null)
				{
					var lblId = "ig-lbl-" + view.getUID();

					domAttr.set(view._instance.label, "id", lblId);
					domAttr.set(view._instance.ariaLabelTarget, "aria-labelledby", lblId);

					if(view._instance.ariaLabelTarget.nodeName == "BUTTON" || view._instance.ariaLabelTarget.nodeName == "A")
						domAttr.remove(view._instance.ariaLabelTarget, "aria-labelledby");
				}
				//End US-696
			},
			_setButtonKind : function (view, bKind)
			{
                var classes = "btn-label icon ";
				if(bKind == "I")
					domClass.add(view._instance.button, classes);
				else
				{
                    //+remove actual icon - e.g. fa-bell
                    view._instance.button.innerHTML = "";
					domClass.remove(view._instance.button, classes + (view._instance._oldBtnInfo || ""));
				}
			},
			_setButtonInfo : function (view, buttonInfo)
			{
				switch(view.context.options.buttonKind.get("value"))
				{
					case "I":
					{
                        var iconName = buttonInfo;
                        view._instance.button.innerHTML = "";
                        if (bpmext.text.startsWith(iconName, "ci-")) {
                            view._instance.button.appendChild(utilities.getCarbonIcon(iconName));
                            // add icon class
                            iconName = "ci " + iconName;
                        } else {
                            if (!bpmext.text.startsWith(iconName, "fa-")) {
                                iconName = "fa-" + iconName;
                            }
                            // add icon class
                            iconName = "fa " + iconName;
                        }
                        if(view._instance._oldBtnInfo != null && view._instance._oldBtnInfo.length > 0)
                            domClass.replace(view._instance.button, iconName, view._instance._oldBtnInfo);
                        else
                            domClass.add(view._instance.button, iconName);
						view._instance._oldBtnInfo = iconName;
						break;
					}
					case "T":
					{
						view._instance.button.innerHTML = buttonInfo != null ? buttonInfo : "@";
						break;
					}
					case "M":
					{
						view._instance.button.innerHTML = (buttonInfo != null ? buttonInfo : "") + "<span id='inputgroup-button-icon-"+view.context.controlidpath+"' class='ig-menu-btn fa fa-caret-down'></span>";
						break;
					}
				}
			},
			_setButtonLocation : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldBtnLoc;

				newVal = bpmext.ui.util.normalizeHorizontalPos(newVal, this.OPTS_BTN_LOC_CLZ);
				oldVal = bpmext.ui.util.normalizeHorizontalPos(oldVal, this.OPTS_BTN_LOC_CLZ);

				bpmext.ui.util.replaceCSSClass(view._instance.inputGroup, this.OPTS_BTN_LOC_CLZ, newVal, oldVal);
				view._instance.oldBtnLoc = newVal;

				domConstruct.place(
					view._instance.button,
					view._instance.inputGroup,
					newVal == "L" ? "first" : "last"
				);
			},
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("InputGroup._setLabelVisibility() error: " + e);
					bpmext.log.error("InputGroup._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label,
							view._instance.label.innerHTML,
							view._instance.baseTxtDir,
							view._instance.genPrefTextDir
							);
					}
					else
					{
						if(view._instance.label)
						{
							view._instance.outer.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("InputGroup._setLabel() error: " + e);
					bpmext.log.error("InputGroup._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldLblPlc;

				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);

				bpmext.ui.util.replaceCSSClass(view._instance.outer, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			_setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";

					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else 
				{
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}

					domClass.remove(view.context.element, "labelWidth");
				}

			},
			_setHelpText : function (view, text)
			{
				utilities.setHelpText(view, text);
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;

						domClass.add(view.context.element, "widthSet");
					}
					else 
					{
						view.context.element.style.width = null;

						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("InputGroup._setWidth() error: " + e);
					bpmext.log.error("InputGroup._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_normalizeSizeStyle: function(sizeStyle)
			{
				// OPTS_SZ_STL_CLZ: {
					// "D" : "",
					// "L" : "input-group-lg",
					// "S" : "input-group-sm"
				// },
				if(!sizeStyle)
					sizeStyle = "D";

				sizeStyle = sizeStyle.toUpperCase();
				if(sizeStyle.length > 1)
				{
					switch (sizeStyle)
					{
						case "LARGE":
							sizeStyle = "L";
							break;
						case "SMALL":
							sizeStyle = "S";
							break;
						case "DEF":
						case "DEFAULT":
							sizeStyle = "D";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected size style: " + sizeStyle);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "SIZE_STYLE_WARNING",sizeStyle));
					}
				}

				return sizeStyle;
			},
			_setSizeStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldSzStyle;

				newVal = this._normalizeSizeStyle(newVal);
				oldVal = this._normalizeSizeStyle(oldVal);

				bpmext.ui.util.replaceCSSClass(view._instance.inputGroup, this.OPTS_SZ_STL_CLZ, newVal, oldVal);
				view._instance.oldSzStyle = newVal;

				bpmext.ui.util.propagateDownSizeStyle(view, newVal);
				bpmext.ui.util.propagateUpSizeStyle(view, newVal);
			},
			_normalizeColorStyle: function(style)
			{
				if(!style)
					style = "D";

				style = style.toUpperCase();
				if(style.length > 1)
				{
					switch (style)
					{
						case "DEFAULT":
						case "DEF":
							style = "D";
							break;
						case "SUCCESS":
							style = "S";
							break;
						case "INFO":
						case "INF":
							style = "I";
							break;
						case "PRIMARY":
						case "PRI":
							style = "P";
							break;
						case "WARNING":
						case "WARN":
							style = "W";
							break;
						case "ERROR":
						case "ERR":
						case "DANGER":
							style = "G";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected color style: " + style);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "COLOR_STYLE_WARNING",style));
					}
				}

				return style;
			},
			_setButtonColorStyle : function (view, newVal, oldVal)
			{
				var clsMap = view._instance.clickable ? this.OPTS_COL_BTN_CLZ : this.OPTS_COL_BG_CLZ;
				if(!oldVal)
					oldVal = view._instance.oldColStyle;

				newVal = this._normalizeColorStyle(newVal);
				oldVal = this._normalizeColorStyle(oldVal);

				if(newVal == "D")
					domClass.remove(view._instance.inputGroup, "no-border");
				else
					domClass.add(view._instance.inputGroup, "no-border");

				bpmext.ui.util.replaceCSSClass(view._instance.button, clsMap, newVal, oldVal);
				view._instance.oldColStyle = newVal;
			},
			_handleVisibility : function (view)
			{
				var visibility = utilities.handleVisibility(view.context);

				if (visibility != "NONE")
				{
					if (visibility === "READONLY")
						domClass.remove(view._instance.disabler, "hidden");
					else
						domClass.add(view._instance.disabler, "hidden");
					if (!view._instance.label)
						return;
					if (visibility === "READONLY")
						domClass.add(view.context.element, "disabled");
					else
						domClass.remove(view.context.element, "disabled");
				}
			}
		};

		/*
		Public control methods *************************************************************
		 */

		//{#feature: * Re-introduced set/getSizeStyle() methods for Input Group - ED}
		/**
		 * @instance
		 * @memberof InputGroup
		 * @method setSizeStyle
		 * @param {string} style "DEFAULT"|"DEF"|"NORMAL"|"D"=Default | "SMALL"|"S"=Small | "LARGE"|"L"=Large
		 * @desc Sets size style of control.  NOTE: to avoid ambiguity always set the size style using "D"|"S"|"L"
		 */
		this.constructor.prototype.setSizeStyle = function (style) {
			return this.context.options.sizeStyle.set("value", style);
		}

		/**
		 * @instance
		 * @memberof InputGroup
		 * @method getSizeStyle
		 * @desc Gets size style of control
		 * @return {string} {"L"=Large | "S"=Small | "D"=Default}
		 */
		this.constructor.prototype.getSizeStyle = function () {
			return this.context.options.sizeStyle.get("value");
		}


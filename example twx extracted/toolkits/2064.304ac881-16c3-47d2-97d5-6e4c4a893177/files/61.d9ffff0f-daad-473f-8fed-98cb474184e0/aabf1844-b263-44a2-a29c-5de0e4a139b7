			return this.context.options.labelPlacement.get("value");
		}

		/**
		 * @instance
		 * @memberof InputGroup
		 * @method getLabelWidth
		 * @desc Get label width of InputGroup control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelWidth = function ()
		{
			return this.context.options.labelWidth.get("value");
		};

		/**
		 * @instance
		 * @memberof InputGroup
		 * @method setLabelWidth
		 * @param {string} labelWidth Control's label width
		 * @desc Set label width of InputGroup control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setLabelWidth = function (labelWidth)
		{
			this.context.options.labelWidth.set("value", labelWidth);
		};

		/**
		 * @instance
		 * @memberof InputGroup
		 * @method setWidth
		 * @param {string} width width of the input group
		 * @desc Set width of the control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (width)

		 * @desc Sets horizontal location of button in the control.  NOTE: to avoid ambiguity always set the label placement using "L" | "R"
		 */
		this.constructor.prototype.setButtonLocation = function (loc)
		{
			this.context.options.buttonLocation.set("value", loc);
		}

		/**
		 * @instance
		 * @memberof InputGroup

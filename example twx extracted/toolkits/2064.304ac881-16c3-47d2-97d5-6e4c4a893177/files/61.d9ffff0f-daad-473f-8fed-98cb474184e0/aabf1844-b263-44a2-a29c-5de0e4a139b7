		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;

				if (!opts.statusStyle)
					bpmext.ui.substituteConfigOption(this, "statusStyle", "N");

				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if(!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");

				if(!opts.labelWidth)
					bpmext.ui.substituteConfigOption(this, "labelWidth", null);

				if (!opts.sizeStyle)
					bpmext.ui.substituteConfigOption(this, "sizeStyle", "D");

				if(!opts.buttonLocation)
					bpmext.ui.substituteConfigOption(this, "buttonLocation", "L");

				if(!opts.buttonColorStyle)
					bpmext.ui.substituteConfigOption(this, "buttonColorStyle", "D");

				if(!opts.buttonKind)
					bpmext.ui.substituteConfigOption(this, "buttonKind", "I");

				if(!opts.buttonInfo) {
                    if (this.context.options.buttonKind.get("value") === "I") {
                        bpmext.ui.substituteConfigOption(this, "buttonInfo", "fa-circle-o");
                    } else {
                        bpmext.ui.substituteConfigOption(this, "buttonInfo", "");
                    }
				}

				if(!opts.showAsButton)
					bpmext.ui.substituteConfigOption(this, "showAsButton", false);

				this._instance._isChildStyleable = true;

				this._instance.inputGroup = this.context.element.querySelector(".input-group"); //Only used for styling - this reference is actually useless...
				domClass.add(this._instance.inputGroup, "SPARKInputGroup");
				//Added for TK-1269 : STARTS
				//domAttr.set(this._instance.inputGroup, "role", "group");
				//TK-1269 : ENDS
				this._instance.disabler = bpmext.ui.util.createDisabler(this, this._instance.inputGroup);

				var cBox = bpmext.ui.util.getContentBox(this, this._instance.inputGroup);
				if(!cBox)
					throw new Error("Content Box not found in InputGroup Coach View");

				this._instance.cbox = cBox;

				bpmext.ui.loadContainer(this);
				this._instance.outer = this.context.element.querySelector(".outer");

				var childNodes = cBox.childNodes;
				var j = 0;
				var view = this;

				for(var i = 0; i < childNodes.length; i++)
				{
					var childNode = childNodes[i];
					if(domAttr.has(childNode, "data-viewid"))
					{
						j++;

						if(j > 1)
						{
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("This InputGroup control should only contain one child view - it contains " + childNodes.length);
							bpmext.log.warn(bpmext.localization.formatMsg("controlInputGroup", "INPUTGROUP_CONTROL") + " " + bpmext.localization.formatMsg("general", "ONE_CHILDVIEW_WARNING") + " " + childNodes.length);
							//bpmext.log.warn("  Only the first view was added");
							bpmext.log.warn(" " + bpmext.localization.formatMsg("general", "FIRSTVIEW_ADDED_WARNING"));

							break;
						}

						var subV = this.context.createView(childNode);

						//{#feature: US-696 ARIA labeling}
						if(subV._getHTMLInputElement)
							this._instance.ariaLabelTarget = subV._getHTMLInputElement();
						//End US-696

						subV.context.options._metadata.labelVisibility.set("value", "HIDE");
						if(!this.context.options._metadata.label.get("value"))
						{
							this.context.options._metadata.label.set("value", subV.context.options._metadata.label.get("value"));
						}
					}
				}

				this._instance.button = document.createElement("span");
				domClass.add(this._instance.button, "input-group-addon");
				domAttr.set(this._instance.button, "id", "inputgroup-button-"+this.context.controlidpath);

				if(opts[this._proto.EVT_ONCLICK])
				{
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLICK);
					
					//Added for TK-1269 : STARTS
					domAttr.set(this._instance.button, "role", "button");
					domAttr.set(this._instance.button, "tabindex", 0);
					//TK-1269 : ENDS

					domClass.add(this._instance.button, "clickable");
					this._instance.clickable = true;

					fastclick.attach(this._instance.button);

					this._instance.button.onclick = function(event) {
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONCLICK);
					};
					
					//Added for TK-1269 : STARTS
					this._instance.button.addEventListener('keypress', function(evt) {
						if(evt.key === "Enter" || evt.key === " " || evt.key === "Spacebar")
							bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONCLICK);
					});
					//TK-1269 : ENDS
				}
				else  
				{
					domAttr.set(this._instance.button, "role", "img");
				}

				this._proto._setButtonKind(this, opts.buttonKind.get("value"));
				this._proto._setButtonInfo(this, opts.buttonInfo.get("value"));
				this._proto._setButtonLocation(this, opts.buttonLocation.get("value"));
				this._proto._setButtonColorStyle(this, opts.buttonColorStyle.get("value"));
				this._proto._setLabelVisibility(this, opts._metadata.labelVisibility.get("value"));
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));

				var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}
				//Added for TK-1269 : STARTS
				//if(this._instance.label) //{#bug: 771 Input Group error if no label is specified - condition added}
				//domAttr.set(this._instance.button, "aria-labelledby", this._instance.label.id);	//Commented for BG-815 by Nividous
				//TK-1269 : ENDS
				//BG-815 : Added by Nividous :STARTS
				domAttr.set(this._instance.button, "aria-label", opts.buttonInfo.get("value"));
				//BG-815 : ENDS
				this._proto._setWidth(this, opts.width.get("value"));
				this._proto._updateControl(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.label":
						{
							this._proto._setLabel(this, event.newVal);
							this._proto._setHelpText(this, this.context.options._metadata.helpText.get("value"));
							break;
						}
						case "_metadata.labelVisibility":
						{
							this._proto._setLabelVisibility(this, event.newVal);
							break;
						}
						case "labelPlacement":
						{
							this._proto._setLabelPlacement(this, event.newVal);
							break;
						}
						case "labelWidth":
						{
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.helpText":
                        {
							this._proto._setHelpText(this, event.newVal);
                            this._proto._updateControl(this);
                            break;
                        }
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "buttonColorStyle":
						{
							this._proto._setButtonColorStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "sizeStyle":
						{
							this._proto._setSizeStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "buttonLocation":
						{
							this._proto._setButtonLocation(this, event.newVal, event.oldVal);
							break;
						}
						case "buttonKind":
						{
							this._proto._setButtonKind(this, event.newVal);
							break;
						}
						case "buttonInfo":
						{
							this._proto._setButtonInfo(this, event.newVal);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};


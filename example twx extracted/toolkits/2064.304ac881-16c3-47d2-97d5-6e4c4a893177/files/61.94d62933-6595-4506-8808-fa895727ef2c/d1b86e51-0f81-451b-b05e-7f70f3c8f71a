define({
	getConfigOptionValue: function(obj, optionName) {
		var configData = obj.context.modelData.layoutItem.configData;
		var value = undefined;
		
		if(configData){
			for(var i = 0; i < configData.length; i++) {
				var configOption = configData[i];
				if(configOption.optionName != optionName)
					continue;
				value = configOption.value;
				break;
			}
		}
		return value;
	},
	getResponsiveConfigOptionValue: function(obj, optionName) {
		var configOptionValue = this.getConfigOptionValue(obj, optionName);
		
		if(configOptionValue != undefined) {
			try {
				var configObj = dojo.fromJson(configOptionValue);
			} catch(e) {
				return null;
			}
			
			if(!!configObj && configObj.isResponsiveData == true) {
				var configValues = configObj.values;
				var deviceID = obj.context.device.deviceID;
				var values = {"LargeID":undefined, "MediumID":undefined, "SmallID":undefined};
			
				for(var j = 0; j < configValues.length; j++) {
					var configValue = configValues[j];
					
					if(configValue.deviceConfigID == "LargeID")
						values.LargeID = configValue.value;
					else if(configValue.deviceConfigID == "MediumID")
						values.MediumID = configValue.value;
					else if(configValue.deviceConfigID == "SmallID")
						values.SmallID = configValue.value;
				}
				
				// inherit medium from large
				if(values.MediumID == undefined)
					values.MediumID = values.LargeID;
					
				// inherit small from medium
				if(values.SmallID == undefined)
					values.SmallID = values.MediumID;
					
				configOptionValue = values[deviceID];
			}
		}
		
		return configOptionValue;
	},
	/**
	 * Returns true if the value is set.  Checks for a JSON responsive wrapper and ensures that at least one device value
	 * is set.  If none are set, returns false.
	 */
	isConfigSet: function(configOptionValue) {
		if(this.isResponsiveJSONString(configOptionValue)){
			try {
				var configObj = dojo.fromJson(configOptionValue);
			} catch(e) {
				return false;//shouldn't really get here unless something is wrong with data
			}
			
			if(configObj && configObj.values) {
				return configObj.values.length>0;
			}
			return false;
		}
		else if(configOptionValue!=undefined && configOptionValue!=null && configOptionValue!="") {
			//not JSON, not empty, so just set as normal data
			return true;
		}
		return false;
	},
	/**
	 * Returns true if the parameter passed in is a responsive JSON wrapper
	 */
	isResponsiveJSONString:function(configDataStr){
		if(configDataStr===null || configDataStr===undefined || typeof configDataStr!="string"){
			return false;
		}
		if(configDataStr.charAt(0)!=="{" || configDataStr.indexOf("isResponsiveData")==-1){
			//fail fast.  If the string doesn't begin with '{' or doesn't contain the field, then it's not responsive string
			return false;
		}
		//this should be faster, so try it
		if(configDataStr.indexOf("\"isResponsiveData\":true")!=-1){
			return true;
		}
		
		//this is the slowest... hopefully we don't get here often (or at all)	
		try{
			var parsed = json.parse(configDataStr);
			if(parsed && parsed.isResponsiveData){
				return true;
			}
		}
		catch(err){
			return false;
		}
		return false;
	},
});
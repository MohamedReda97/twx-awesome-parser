/** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Timeout:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when the timer times out. Will trigger multiple times if timer is set to repeatable.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${CounterDisplay}.setText(me.getTicks())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Boundary Event:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers upon reaching a Stay On Page event after a boundary event is fired through this control.  For information on the status context variable see the context.trigger() method in the Knowledge Center.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>alert("Stay on Page status '" + status + "'")<code></pre></td>
 *         </tr>
 *       </table>
 *       <table style="border: 1px solid black; border-collapse: collapse; ">
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <th style="border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">status {string}</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   </tr>
 * </table>
 */
bpmext_control_InitTimer = function(bpmext)
{
	this._instance = {
		ticks: 0,
		running: false
	};
	
	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONTIMEOUT : "eventON_TIMEOUT",
			EVT_ONBOUNDARYEVT : "eventON_BOUNDARYEVT",
			_timerFn: function(view)
			{
				var repeatable = view.context.options.repeat.get("value");
				
				if(repeatable)
				{
					view._instance.timerHandle = setTimeout(
						function(){view._proto._timerFn(view)}, 
						view.context.options.timeout.get("value")
						);
				}
				else
				{
					view._instance.timerHandle = null;
					view._instance.running = false;
				}

				view._instance.ticks++;
					
				var fireBE = bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONTIMEOUT);

				if(fireBE)
				{
					view.context.trigger(function (st)
					{
						setTimeout(function(){
							bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONBOUNDARYEVT, st.status);
						});
					}, {callBackForAll : true});	
					
					if(!repeatable)
						view.stop();
				}
			}
		}

		/**
		 * @instance
		 * @memberof Timer
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "timer.3";
		}

		/**
		 * @instance
		 * @memberof Timer
		 * @method start
		 * @desc Starts a timer
		 */	
		this.constructor.prototype.start = function()
		{
			var view = this;
			if(!this._instance.running)
			{
				this._instance.running = true;
				this._instance.timerHandle = setTimeout(function(){view._proto._timerFn(view)},view.context.options.timeout.get("value"));
			}
		}

		/**
		 * @instance
		 * @memberof Timer
		 * @method stop
		 * @desc Stops a timer
		 */	
		this.constructor.prototype.stop = function()
		{
			if(this._instance.timerHandle)
			{
				clearTimeout(this._instance.timerHandle);
				this._instance.timerHandle = null;
			}
			
			this._instance.running = false;
		}
		
		/**
		 * @instance
		 * @memberof Timer
		 * @method setTimeout
		 * @desc Sets the timeout value (milliseconds)
		 * @param {integer} timeout Milliseconds until timer ticks
		 */	
		this.constructor.prototype.setTimeout = function(timeout)
		{
			this.context.options.timeout.set("value", timeout);
		}

		/**
		 * @instance
		 * @memberof Timer
		 * @method getTimeout
		 * @desc Gets the timeout value (milliseconds)
		 * @returns {integer} timeout Milliseconds until timer ticks
		 */	
		this.constructor.prototype.getTimeout = function()
		{
			return this.context.options.timeout.get("value");
		}
		
		/**
		 * @instance
		 * @memberof Timer
		 * @method setRepeatable
		 * @desc sets the Repeatable flag
		 * @param {boolean} flag {true | false} Set to true to make the timer repeatable
		 */	
		this.constructor.prototype.setRepeatable = function(flag)
		{
			this.context.options.repeat.set("value", flag);
		}

		/**
		 * @instance
		 * @memberof Timer
		 * @method isRepeatable
		 * @desc gets the value of the Repeatable flag
		 * @returns {boolean} 
		 */	
		this.constructor.prototype.isRepeatable = function()
		{
			return this.context.options.repeat.get("value");
		}
		
		/**
		 * @instance
		 * @memberof Timer
		 * @method getTicks
		 * @desc Returns the current number of timer ticks
		 * @returns {integer} 
		 */	
		this.constructor.prototype.getTicks = function()
		{
			return this._instance.ticks;
		}

		/**
		 * @instance
		 * @memberof Timer
		 * @method resetTicks
		 * @desc Sets the current number of timer ticks to the specified value or 0 when unspecified
		 * @param {integer} [ticks=0] Number of ticks to set
		 */	
		this.constructor.prototype.resetTicks = function(ticks)
		{
			if(!ticks)
				ticks = 0;
			
			this._instance.ticks = ticks;
		}
		
		/**
		 * @instance
		 * @memberof Timer
		 * @method isRunning
		 * @desc Indicates whether or not the timer is started
		 * @returns {boolean} 
		 */		
		this.constructor.prototype.isRunning = function()
		{
			return this._instance.running;
		}
		
		/**
		 * @instance
		 * @memberof Timer
		 * @method toggle
		 * @desc Toggles the timer on or off
		 */	
		this.constructor.prototype.toggle = function()
		{
			if(!this.isRunning())
				this.start();
			else
				this.stop();
		}
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;

				if (!opts.timeout)
					bpmext.ui.substituteConfigOption(this, "timeout", 0);

				if (!opts.repeat)
					bpmext.ui.substituteConfigOption(this, "repeat", false);
				
				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					null,
					this.getTicks
					);	

				bpmext.ui.loadView(this);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONTIMEOUT);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONBOUNDARYEVT, "status");

				var initiallyStopped = this.context.options.stopped ? this.context.options.stopped.get("value") : false;
				
				var view = this;
				if(!initiallyStopped)
				{
					view.start();
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		}
		
		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "timeout":
						{
							break;
						}
						case "repeat":
						{
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};		
			
		this.constructor.prototype.unload = function()
		{
			this.stop();
			bpmext.ui.unloadView(this);
		};

		this.constructor.prototype.view = function()
		{
		};		
	}
};


                //Added for TK-1045
                domAttr.set(view._instance._pageSizer,"aria-labelledby",spanId);

                span.appendChild(view._instance._pageSizer);
                //Ends
                view._instance._pageSizer.onkeypress = function(event)
                {
                    //TK-1045 : Firefox pager tabbing issue resolved
                    //286511: allow enter key to submit
                    return (event.charCode >= 48 && event.charCode <= 57) || (event.key === "Backspace") || (event.key === "tab") || (event.key === "Enter");
                };

                view._instance._pageSizer.onchange = function(event)
                {
                    if(!isNaN(this.value))
                        view.setPageSize(Number(this.value));
                        //Added for TK-1045
                        //domAttr.set(view._instance._pageSizer,"aria-invalid","false");
                        //TK-1045 Ends
                };

                //{#bug: BG-251 Initialize page sizer to current page size, if any}
                var ps = view.context.options.pageSize.get("value");
                if(ps > 0) {
                    view._instance._pageSizer.value = ps;
                } else {
                    view.setPageSize(view._instance.defaultPageSize);
                }
                

                //BG-1222 setting top size of disabler based on heading and padding height
                view._proto._setDisablerHeight(view, view.context.options.height.get("value"));

                return view._instance._pageSizerEnv;

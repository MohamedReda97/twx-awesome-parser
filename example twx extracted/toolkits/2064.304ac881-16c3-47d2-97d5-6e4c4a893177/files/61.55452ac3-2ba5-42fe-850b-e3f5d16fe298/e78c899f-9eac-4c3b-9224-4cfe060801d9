                    bpmext.ui.substituteConfigOption(this, "showFooter", false);

                if(!opts.headerFooterStyle)
                    bpmext.ui.substituteConfigOption(this, "headerFooterStyle", "Default");

                if(!opts.showAddButton)
                    bpmext.ui.substituteConfigOption(this, "showAddButton", false);

                if(!opts.showTableStats)
                    bpmext.ui.substituteConfigOption(this, "showTableStats", false);

                if(!opts.showPager)
                    bpmext.ui.substituteConfigOption(this, "showPager", false);

                if(!opts.showDeleteButton)
                    bpmext.ui.substituteConfigOption(this, "showDeleteButton", false);

                if(!opts.showPageSizer)
                    bpmext.ui.substituteConfigOption(this, "showPageSizer", false);

                if(!opts.highlightSel)
                    bpmext.ui.substituteConfigOption(this, "highlightSel", false);

                //Defect 285186 - START
                if(!opts.allowWrap)
                    bpmext.ui.substituteConfigOption(this, "allowWrap", false);
                //Defect 285186 - END

                //Defect 293311 - START
                if(!opts.showPopups)
                    bpmext.ui.substituteConfigOption(this, "showPopups", false);
                //Defect 293311 - END

                this._instance._viewId = bpmext.ui.makeUniqueId("");
                this._instance.defaultPageSize = this._proto.DEFAULT_PAGE_SIZE;

                this._instance.envelope = document.createElement("div");
                domClass.add(this._instance.envelope, "SPARKTable");
                //Added for TK-1032 : STARTS
                domAttr.set(this._instance.envelope, "role", "grid");
                domAttr.set(this._instance.envelope, "aria-label", mdt.label.get("value"));
                //TK-1032 : ENDS
                this._instance.disabler = bpmext.ui.util.createDisabler(this, this._instance.envelope);

                this._instance.outerBody = document.createElement("div");

                this._instance.heading = document.createElement("div");
                domClass.add(this._instance.heading, "clearfix");

                this._instance.title = document.createElement("span");

                this._proto._setTitle(this);

                this._instance.heading.appendChild(this._instance.title);

                this._instance.outerBody.appendChild(this._instance.heading);

                this._instance.scrollableArea = document.createElement("div");
                this._instance.outerBody.appendChild(this._instance.scrollableArea);

                //Defect 293311 - START
                this._proto._showPopupMenus(this, opts.showPopups.get("value"));
                //Defect 293311 - END

                this._instance.table = document.createElement("table");
                domClass.add(this._instance.table, "table");

                //Added for Tk-1036 : adding uid to table.
                var tableUid="tbl_"+bpmext.ui.makeUniqueId("");
                domAttr.set(this._instance.table,"uid",tableUid);
                //TK-1036 End.

                this._proto._setHeight(this, opts.height.get("value"));
                this._proto._setWidth(this, opts.width.get("value"));

                var colgroup = document.createElement("colgroup");
                var thead = document.createElement("thead");
                var tbody = document.createElement("tbody");
                this._instance.table.appendChild(colgroup);
                this._instance.table.appendChild(thead);
                this._instance.table.appendChild(tbody);

                this._instance.envelope.appendChild(this._instance.heading);

                this._instance.envelope.appendChild(this._instance.outerBody);

                this._instance.scrollableArea.appendChild(this._instance.table);

                this._proto._setTableStyle(this, opts.tableStyle.get("value"));
                this._proto._setColorStyle(this, opts.colorStyle.get("value"));

                this.context.element.appendChild(this._instance.envelope);

                this._instance.expandableRows = opts.expandableRows.get("value");
                this._instance.selMode = opts.selectionMode.get("value");
                this._instance.allowColumnResize = opts.allowColumnResize.get("value");

                bpmext.ui.loadContainer(this);

                this._instance._onRowsLoadedFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONROWSLOADED);
                this._instance._onExpandableRowLoadFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONEXPANDABLEROWLOAD);
                this._instance._onExpandRowFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONEXPANDROW);
                this._instance._onCollapseRowFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONCOLLAPSEROW);
                this._instance._onNewCellFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONNEWCELL);
                this._instance._onRowSelFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONROWSEL);
                //BG-1190 added event for All Rows Selected
                this._instance._onAllRowsFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONALLROWS);
                this._instance._onDelRecFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONDELREC);
                this._instance._onAddRecFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONADDREC);
                this._instance._onColumnDropFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONCOLUMNDROP);
                this._instance._onColumnResizeFn = bpmext.ui.getEventHandlingFunction(this, this._proto.EVT_ONCOLUMNRESIZE);

                this._proto._loadCellTemplates(this);
                this._proto._loadColumnSpecs(this);
                this._proto._reloadHeader(this);
                this._proto._setSelectionHighlight(this);
                this._proto._refreshTitleHeader(this);

                this._instance.loadedRowCount = 0;
                this._instance.isDragnDrop = false;
                this._instance.currentHeaderIndex = -1;

                var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}

                var view = this;

                this._proto._initList(view);
                this._proto._refreshFooter(this);

                //START Data Service-backed Table logic ///////////////////////////////////////////
                if(svcDataTbl)
                {
                    //Added for TK-1040 : STARTS
                    domAttr.set(this._instance.envelope, "aria-readonly", "true");
                    //TK-1040 : ENDS
                    if(!opts.startEmpty.get("value"))
                        this._proto._updateTable(this);
                    else
                    {
                        var list = new com.ibm.bpm.coach.List([], "svc.items");
                        this.context.binding = bpmext.ui.substituteObject(this, "binding", "list", list);
                        this._instance.list = new ItemList(this, function(){
                            return view.context.binding.get("value");
                        }, svcDataTbl);
                        this._proto._rebindAllUpdates(this);            // BG 564
                    }

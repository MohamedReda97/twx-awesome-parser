bpmext_control_InitTable = function (utilities, bpmext, ItemList, domClass, domAttr, domConstruct, dateLocale, json, lang, svcDataTbl)
{
    this._instance =
    {
        uid: bpmext.ui.makeUniqueId(""),
        rowsLoadedRunning: false,
        pageIdx: 0,
        pageSize: 0,
        minSize: 1,
        maxSize: 99999,
        defaultPageSize: 10,
        _sdt: svcDataTbl === true ? true : false
    };

    if (!this.constructor.prototype._proto)
    {
        this.constructor.prototype._proto =
        {
            EVT_ONEXPANDABLEROWLOAD: "eventON_EXPANDABLEROWLOAD",
            EVT_ONEXPANDROW: "eventON_EXPANDROW",
            EVT_ONCOLLAPSEROW: "eventON_COLLAPSEROW",
            EVT_ONNEWCELL: "eventON_NEWCELL",
            EVT_ONROWSLOADED: "eventON_ROWSLOADED",
            EVT_ONDELREC: "eventON_DELREC",
            EVT_ONROWSEL: "eventON_ROWSEL",
            //BG-1190 added event for All Rows Selected
            EVT_ONALLROWS: "eventON_ALLROWS",
            EVT_ONDATALOADED: "eventON_DATALOADED",
            EVT_ONDATAERROR: "eventON_DATAERROR",
            EVT_ONADDREC: "eventON_ADDREC",
            EVT_ONSORTING: "eventON_SORTING",
            EVT_ONPAGESIZERCHANGE: "eventON_PAGESIZERCHANGE",
            EVT_ONCOLUMNDROP: "eventON_COLUMNDROP",
            EVT_ONCOLUMNRESIZE: "eventON_COLUMNRESIZE",
            IDX_DELIM: "[index].",
            COLDATFN_PFX: "__cDat",
            //{#feature: * Allow for both E and G for Danger/Error color style}
            OPTS_COL_CLZ : {
                "D" : "table-none",
                "L" : "table-light",
                "P" : "table-primary",
                "I" : "table-info",
                "S" : "table-success",
                "W" : "table-warning",
                "E" : "table-danger",
                "G" : "table-danger"
            },
            OPTS_STL_CLZ : {
                "D" : "",
                "E" : "",
                "B" : "table-bordered",
                "S" : "table-striped",
                "H" : "table-hover",
                "C" : "table-condensed"
            },
            OPTS_STL_CLZ2 : {
                "D" : "ts-default",
                "E" : "ts-elegant",
                "B" : "ts-bordered",
                "S" : "ts-striped",
                "H" : "ts-hover",
                "C" : "ts-condensed"
            },
            DEFAULT_PAGE_SIZE: 10,
            _getContentBox : function(view)
            {
                if(!view._instance.contentBox)
                {
                    var children = view.context.element.children;
                    for(var i = 0; i < children.length; i++)
                    {
                        var child = children[i];
                        if(child.className && /\bContentBox\b/.test(child.className))
                        {
                            view._instance.contentBox = child;
                            break;
                        }
                    }
                }

                return view._instance.contentBox;
            },
            _fixIconName : function(icon)
            {
                if(!!icon)
                {
                    icon = icon.toLowerCase();
                    if(!bpmext.text.startsWith(icon, "fa-") && !bpmext.text.startsWith(icon, "ci-"))
                        icon = "fa-" + icon;
                }

                return icon;
            },
            _setWidth : function (view, width)
            {
                try
                {
                    if (width != null && width != "")
                    {
                        if (!isNaN(width))
                            width += "px";

                        view.context.element.style.width = width;
                    }
                    else 
                    {
                        view.context.element.style.width = null;
                    }
                }
                catch (e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("Table._setWidth() error: " + e);
                    bpmext.log.error("Table._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);

                    if(e.stack)
                    {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _syncOnInsertion: function(view, insertedInto)
            {
                var ps = view.context.options.pageSize.get("value");
                var maxVisibleIdx = (ps * (view._instance.pageIdx + 1)) - 1;

                if(ps == 0 || insertedInto <= maxVisibleIdx)
                    view._proto._addRow(view, view._instance.list, view._instance.list.toTransformedIndex(insertedInto));
                else //{#bug: * Added formula trigger for insertion of records whose coach views aren't displayed - ED}
                    bpmext.ui.broadcastExpressionTrigger(view);

                if(ps > 0)
                    view._proto._reloadList(view);
                else
                    view._proto._refreshTableStats(view);
            },
            _onListUpdated : function(view, event)
            {
                bpmext.log.debug("onListUpdated for " + view.context.viewid );
                if (view._instance.isSimpleTypeList) {
                    if (event.insertedInto != event.removedFrom) {
                        //Work Item#302580 When bound to list of simpletype the control does not fire unload event on child CVs -  START
                        if (event.removedFrom >= 0) {
                            var ctx = view._instance.removedItemCtx;

                            if(ctx && ctx.tr)
                                this._deleteRow(view, ctx);

                            view._instance.removedItemCtx = null;
                        }
                        //Work Item#302580 When bound to list of simpletype the control does not fire unload event on child CVs -  END

                        //297019: reload list for add/deletes for lists of simple types
                        this._reloadList(view);
                    }
                } else {
                    if(event.insertedInto >= 0 && event.insertedInto != event.removedFrom)
                    {
                        if(event.insertedInto == view._instance.list.unfilteredLength() - 1) //If inserted at end
                        {
                            if(view._instance.list.trackInsertion(view, event.insertedInto))
                            {
                                var insertedInto = event.insertedInto;

                                setTimeout(function(){
                                    view._proto._syncOnInsertion(view, insertedInto);
                                });
                            }
                        }
                        else
                        {

                            //{#feature: US-1330 Added RT localization}
                            //bpmext.log.error("Mid-list inserts not supported by Coach NG API yet");
                            bpmext.log.error(bpmext.localization.formatMsg("general", "MID_LIST_INSERT_COACH_NG_ERROR"));
                        }
                    }
                    else if(event.removedFrom >= 0 && event.removedFrom != event.insertedInto)
                    {
                        var item = event.oldVal;
                        var ctx = view._instance.list.getItemContext(item);

                        if(ctx && ctx.tr)
                            this._deleteRow(view, ctx);

                        if(view._instance.list.trackDeletion(view, event.removedFrom, event.oldVal))
                            this._reloadList(view);
                        else
                        {
                            var ps = view.context.options.pageSize.get("value");

                            if(ps > 0)
                                this._reloadList(view);
                            else
                                this._refreshTableStats(view);
                        }

                        //refreshview will destroy pseudo binding thereby preventing add/delete operations
                        //we need to check if the binding is set and prevent a refresh if not
                        if(view._instance.bindingExists === true) {
                            setTimeout(function(){
                                view.context.refreshView();
                            });
                        }
                    }
                    else //Just a value change...
                    {

                    }

                }

            },
            _onSelectionUpdated : function(view, event)
            {
                bpmext.log.debug("onSelectionUpdated " + view.context.viewid );
                if(view._instance.selMode == "N")
                    return;

                view._instance.list.trackSelectionChange(event.newVal);

                if(event.property == "listAllSelectedIndices")
                {
                    var newSelIdxs = event.newVal;
                    var idxs = {};
                    var i;
                    for(i = 0; i < newSelIdxs.length; i++)
                    {
                        idxs[newSelIdxs[i]] = true;
                    }

                    //BG-1011 define len before setting chkSelector
                    var len = view._instance.list.unfilteredLength();
                    //BG-970 Moved logic above for loop
                    if(view._instance.selMode == "S" && newSelIdxs.length == 0)
                    {
                        view._instance.rbUnselector.checked = true;
                    }
                    else if(view._instance.selMode == "M")
                    {
                        view._instance.chkSelector.checked = (len !== 0) && (newSelIdxs.length == len);

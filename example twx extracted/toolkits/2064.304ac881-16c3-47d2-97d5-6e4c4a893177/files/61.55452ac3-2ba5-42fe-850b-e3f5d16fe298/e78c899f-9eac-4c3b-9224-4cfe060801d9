            _executeSortEvent: function(view, varName, sortingOrder){
                var col = varName;
                
                var asc;
                if (sortingOrder === "ascending") {
                    asc = true;
                } else if (sortingOrder === "descending") {
                    asc = false;
                } else {
                    asc = undefined;
                }

                //US 335328 Added on sorting event for custom sorting.
                var defaultSort = bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSORTING, col, sortingOrder);
                if (defaultSort==false) {
                    //If custom sort is used update the icons to reflect correct ascending or descending order.
                    view._proto._updateSort(view, col, asc);
                } else if (asc === undefined) {
                    view.clearSort();
                } else {
                    //Use default built in sorting, view.sort, to sort current binding list.
                    view.sort(col, asc, true);
                }
            },

            _deleteRows : function(view, skipRefresh)
            {
                if(view._instance.list != null) //{#bug: 916 Added null list check to prevent load-time runtime error under certain conditions}
                {
                    var len = view._instance.list.unfilteredLength();

                    for(var i = len - 1; i >= 0; i--)
                    {
                        var item = view._instance.list.getUnfiltered(i);
                        var ctx = view._instance.list.getItemContext(item);

                        if(ctx && ctx.tr != null)
                        {
                            this._deleteRow(view, ctx, skipRefresh); //Deletes the row and associated coach views if any
                        }
                    }
                }

                //Reset async loading row tracker
                view._instance.loadedRowCount = 0;

                // {#bug: BG 386 Clear method does not update stats}
                this._refreshTableStats(view); // refresh the table stats
            },
            //BG-1015 seperated deleteRows to new function, removing gc flag
            //_clear : function(view, gcITems)
            _clear : function(view)
            {

                //BG-1015 clear selection before clearing records
                view.setAllRecordsSelected(false);

                //Unbind to prevent _onListUpdated from being fired for every removed record
                if(view._instance.bindValueUpdHandle)
                    view._instance.bindValueUpdHandle.unbind();

                //Unbind to prevent _onSelectionUpdated_ from being fired for every removed record
                if(view._instance.bindSelUpdHandle)
                    view._instance.bindSelUpdHandle.unbind();

                if(view._instance.list != null) //{#bug: 916 Added null list check to prevent load-time runtime error under certain conditions}
                {
                    var len = view._instance.list.unfilteredLength();

                    for(var i = len - 1; i >= 0; i--)
                    {
                        var item = view._instance.list.getUnfiltered(i);
                        var ctx = view._instance.list.getItemContext(item);

                        if(ctx && ctx.tr != null)
                        {
                          //BG-1229 added parameter to skip refresh view
                            this._deleteRow(view, ctx, true); //Deletes the row and associated coach views if any
                        }
                        //BG-1015 seperated deleteRows to new function, removing gc flag
                        //BG-915 added garbage collection flag to prevent remove items when called from change handler
                        //if(gcITems)
                        //{
                        view._instance.list.remove(item); //Removing the item clears potential selection flag associated with the item
                        //}
                    }
                }

                //Reset async loading row tracker
                view._instance.loadedRowCount = 0;

                // {#bug: BG 386 Clear method does not update stats}
                this._refreshTableStats(view); // refresh the table stats

                //Create new backing list based on new bound list
                view._instance.list = new ItemList(view, function(){
                    //{#bug: 916 Added null view.context.binding check to prevent load-time runtime error under certain conditions}
                    if(view.context.binding == null)
                        view.context.binding = bpmext.ui.substituteObject(view, "binding", "list", new com.ibm.bpm.coach.List([], "tmp.items"));
                        return view.context.binding.get("value");
                    },
                    svcDataTbl
                );

                //  Now Rebind to listen for list element & selection updates
                this._rebindAllUpdates(view);

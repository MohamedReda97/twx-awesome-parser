                                domClass.add(column, "dropAfter");
                                view._instance.helpText.innerHTML = bpmext.localization.formatMsg("controlTable", "DROP_AFTER", column.innerText);
                            }
                        } else if (event.key === "ArrowLeft" || event.key === "Left") {
                            event.preventDefault();
                            var column = draggableHeaders[view._instance.currentHeaderIndex]
                            if (view._instance.currentHeaderIndex > 0) {
                                domClass.remove(column, "dropBefore");
                                domClass.remove(column, "dropAfter");

                                view._instance.currentHeaderIndex--;
                                var newColumn = draggableHeaders[view._instance.currentHeaderIndex]
                                domClass.add(newColumn, "dropAfter");
                                view._instance.helpText.innerHTML = bpmext.localization.formatMsg("controlTable", "DROP_AFTER", newColumn.innerText);
                            } else {
                                domClass.remove(column, "dropAfter");
                                domClass.add(column, "dropBefore");
                                view._instance.helpText.innerHTML = bpmext.localization.formatMsg("controlTable", "DROP_BEFORE", column.innerText);
                            }
                        } else if (domClass.contains(event.target.parentElement, "draggable") && event.key === "Tab") {
                            event.preventDefault();
                        } else if (event.key === "Escape" || event.key === "Esc") {
                            draggingBtns.forEach(function(element) {
                                element.tabIndex = "0";
                            });
                            domClass.remove(draggableHeaders[view._instance.currentHeaderIndex], "dropBefore");
                            domClass.remove(draggableHeaders[view._instance.currentHeaderIndex], "dropAfter");   
                            domClass.remove(view._instance.headerRow, "dragStart");
                            domClass.remove(event.target.parentElement, "draggable");
                            view._instance.isDragnDrop = false;
                            domAttr.set(event.target, "aria-pressed", "false");
                            view._instance.helpText.innerHTML = bpmext.localization.formatMsg("controlTable", "REORDER_CANCELLED");
                        }
                    }
                }

                view._instance.handleFocus = function() {
                    if (!view._instance.isDragnDrop) {
                        view._instance.helpText.innerHTML = bpmext.localization.formatMsg("controlTable", "REORDER_COLUMN_ARIA");
                    }
                }

                //Add drag event listener - Start
                view._instance.headerRow.addEventListener("dragstart", view._instance.handleEvent);
                view._instance.headerRow.addEventListener("dragover", view._instance.handleEvent);
                view._instance.headerRow.addEventListener("dragleave", view._instance.handleEvent);
                view._instance.headerRow.addEventListener("drop", view._instance.handleEvent);

                var dragBtns = view._instance.headerRow.querySelectorAll(".draggingBtn");
                dragBtns.forEach(function(btn) {
                    domAttr.set(btn, "aria-describedby", "help-text");
                    domAttr.set(btn, "aria-pressed", "false");
                    btn.addEventListener("keydown", view._instance.handleKeydown); 
                    btn.addEventListener("focus", view._instance.handleFocus);

                    btn.addEventListener("touchstart", view._instance.handleEvent);
                    btn.addEventListener("touchmove", view._instance.handleEvent);
                    btn.addEventListener("touchend", view._instance.handleEvent);
                });
                //Add drag event listener - Ends
            },
            _resizeColumn: function(view, colResizeElm, cspec) {
                //Initialize variables for new width and initial width
                var initial_x, initial_width, siblingElement, sibling_initial_width, th, col;

                colResizeElm.onmousedown = function(event) {
                    event.preventDefault();

                    th = cspec.headerTH;
                    col = cspec.colElm;
                    //store initial mouse position
                    initial_x = event.pageX;
                    //set initial width
                    initial_width = th.offsetWidth;
                    //Get sibling element
                    siblingElement = th.nextElementSibling;
                    //Get sibling element width
                    sibling_initial_width = siblingElement.offsetWidth;

                    view._instance.table.onmousemove = function(e) {
                        // calculate changed width
                        var new_width = initial_width + (e.pageX - initial_x);
                        var new_sibling_width = sibling_initial_width - (e.pageX - initial_x);
                        
                        //set new width
                        if(new_width > 50 && new_sibling_width > 50){
                            th.style.width = new_width + "px";
                            th.style.maxWidth = new_width + "px";

                            th.nextElementSibling.style.width = new_sibling_width + "px";
                            th.nextElementSibling.style.maxWidth = new_sibling_width + "px";

                            // col.style.width = new_width + "px";
                            // col.nextElementSibling.style.width = new_sibling_width + "px";
                        }
                    };
                    
                    view._instance.table.onmouseup = function() {
                        view._instance.table.onmousemove = null;
                        var cHeader = cspec.headerTH.querySelector("div");
                        cspec.width = cspec.headerTH.offsetWidth + "px";
                        //if the column header is long and can't show full, then show a tooltip
                        if(!view.context.options.allowWrap.get("value") && (cHeader.offsetWidth < cHeader.scrollWidth)) {
                        	bpmext.ui.util.showTooltip(
                        		cHeader,
                                cspec.label,
                                {horizontalPos: "LEFT", smartPositioning: true}
                            );
                        }
                        
                        var i;
                        for(i = 0; i < view._instance.cspecs.length; i++) {
                            if(cspec.columnOrder + 1 === view._instance.cspecs[i].columnOrder) {
                                view._instance.cspecs[i].width = view._instance.cspecs[i].headerTH.offsetWidth + "px";
                                break;
                            }
                        };

                        if(view._instance._onColumnResizeFn && view._instance._onColumnResizeFn.execute) {
                            var cspecs = view.getColumns();
                            view._instance._onColumnResizeFn.execute(cspecs);
                        }
                    };
                };
                

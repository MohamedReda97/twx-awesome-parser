            _updateValidation: function(view) {
                var valErrors = bpmext.ui.getViewValidationErrors(view);
                var errors = [];

                if(valErrors) {
                    valErrors.forEach(function(error) {
                        if(error.binding === "") {
                            // Handle coach validation errors
                            errors.push(error);
                        } else if(error.id === "client") {
                            // Handle .setValid validation errors
                            errors.push(error);
                        }
                    });
                }

                if (errors.length > 0) {
                    view._instance.validation = document.createElement("span");
                    domClass.add(view._instance.validation, "table-validation");

                    view._instance.validationIcon = document.createElement("i");
                    domClass.add(view._instance.validationIcon, "fa fa-exclamation-circle");

                    view._instance.validation.appendChild(view._instance.validationIcon);

                    view._instance.heading.appendChild(view._instance.validation);

                    var position = view._instance.validationIcon.getBoundingClientRect();
                    var top = position.y; //Position of element from the top
                    var distance = window.pageYOffset + top; //Distance of element from top of the page

                    var headingWidth = view._instance.heading.offsetWidth;
                    var left = position.x;
                    var percentage = (left/headingWidth) * 100;

                    var rtl = view._proto._getDirection() === "rtl";

                    var horizontalPos = (percentage > 70) ? (rtl ? "left" : "right") : (rtl ? "right" : "left");

                    var ttOpts = {
                        horizontalPos: horizontalPos,
                        verticalPos: (distance > 50) ? "top" : "bottom",
                        cssClass: "validationError",
                        plainText: false
                    };

                    view._instance.iconTT = bpmext.ui.util.showTooltip(
                        view._instance.validationIcon,
                        bpmext.ui.util.formatErrors(errors),
                        ttOpts);
                } else {
                    // There are no errors now but if errors were shown, close tooltip and remove validation marker.
                    if (view._instance.validation && view._instance.validation.parentElement) {
                        bpmext.ui.util.closeTooltip(view._instance.iconTT, view._instance.validationIcon);
                        view._instance.validation.parentElement.removeChild(view._instance.validation);
                        view._instance.validation = null;
                    }
                }

                this._refreshTitleHeader(view);
            },
            _getDirection: function() {
                var getDirection = function(element) {
                    var result = null;
                    if (element) {
                        if (window.getComputedStyle) {
                            result = window.getComputedStyle(element, null).direction;
                        } else if (element.currentStyle) {
                            result = element.currentStyle.direction;
                        }
                    }
                    return result;
                };

                var bidi = "auto";
                if (getDirection(document.body) == "rtl" && domClass.contains(document.body, "CoachViewRTL")) {
                    bidi = "rtl";
                }
                return bidi;
            },
            _setPageSize: function(view, newSize, oldSize) {
                view._instance.pageIdx = 0;

                if (!newSize) {
                    // if the new value is not valid then use the old value 
                    newSize = oldSize || view._instance.defaultPageSize || view._proto.DEFAULT_PAGE_SIZE;
                } else if (newSize < view._instance.minSize) {
                    newSize = view._instance.minSize;
                } else if (newSize > view._instance.maxSize) {
                    newSize = view._instance.maxSize;
                }
                
                if (newSize !== view.context.options.pageSize.get("value")) {
                    // put old/default value back
                    view.setPageSize(newSize);
                }
                
                if (newSize !== oldSize) {
                    if(view._instance._pageSizer) {
                        view._instance._pageSizer.value = newSize;
                    }
                    bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONPAGESIZERCHANGE, newSize, oldSize);
                }    
            },

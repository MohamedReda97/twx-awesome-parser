            _refreshPageSizer: function(view) {
                var showPageSizer = view.context.options.showPageSizer.get("value");
                var headerFooterStyle = view.context.options.headerFooterStyle.get("value");

                this._removePageSizer(view);
                if (!showPageSizer) {
                    return;
                }

                var pageSizer;
                if (headerFooterStyle === "Modern") {
                    if (!view._instance.footer) {

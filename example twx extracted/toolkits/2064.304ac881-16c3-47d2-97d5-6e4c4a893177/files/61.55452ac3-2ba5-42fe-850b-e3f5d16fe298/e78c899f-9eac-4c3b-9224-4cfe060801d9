                                // Attach Visual Translate
                                document.body.appendChild(view._instance.movingElement);
                                // Assign box new coordinates based on the touch.
                                var x = (eventLocation.pageX - (view._instance.movingElement.offsetWidth / 2)) + 'px';
                                var y = (eventLocation.pageY - (view._instance.movingElement.offsetHeight / 2)) + 'px';
                                view._instance.movingElement.style.willChange = 'transform';

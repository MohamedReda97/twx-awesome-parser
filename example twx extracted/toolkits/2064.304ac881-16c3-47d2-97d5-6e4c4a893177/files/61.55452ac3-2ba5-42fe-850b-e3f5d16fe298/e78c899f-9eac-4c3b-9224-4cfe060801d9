         * @param {integer} pageIdx (Optional) If not specified, assumes current page
         * @desc Returns the record at the index and page specified - respecting the sorting and filtering that may be active on the table.
         * @returns {Object} Or undefined if the page index and record index don't match an actual record in the table
         */
        this.constructor.prototype.getRecordOnPage = function(recIdx, pageIdx)
        {
            if(typeof pageIdx == "undefined")
                pageIdx = this.getPageIndex();

            if(pageIdx <= this.getMaxPageIndex())
            {
                var maxCount = this.getPageSize(pageIdx, true);

                if(recIdx < maxCount) //TODO: Allow overflow to next page or return undefined if outside of page?
                {
                    var offset = pageIdx * this.getPageSize();
                    var idx2 = recIdx + offset;
                    var rec = this.getRecord(idx2, true);

                    return rec;
                }
            }
        };

        /**
         * @instance
         * @memberof Table
         * @method getRecordsOnPage
         * @param {integer} pageIdx (Optional) If not specified, assumes current page
         * @desc Returns the records at page index specified - respecting the sorting and filtering that may be active on the table.
         * @returns {Object[]}
         */
        this.constructor.prototype.getRecordsOnPage = function(pageIdx)
        {
            if(typeof pageIdx == "undefined")
                pageIdx = this.getPageIndex();

            var res = [];

            if(pageIdx <= this.getMaxPageIndex())
            {
                var maxCount = this.getPageSize(pageIdx, true);
                var offset = pageIdx * this.getPageSize();

                for(var i = 0; i < maxCount; i++)
                {
                    res.push(this.getRecord(i + offset, true));
                }
            }

            return res;
        };


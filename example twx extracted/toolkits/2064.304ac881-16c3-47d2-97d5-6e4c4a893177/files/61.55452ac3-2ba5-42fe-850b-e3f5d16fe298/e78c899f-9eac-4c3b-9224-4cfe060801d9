         * @param {integer[]} columns List of columns to hide.
         * @desc Hides the specified columns. For example [1,3,4] will hide the first, third and fourth columns.
         */
        this.constructor.prototype.hideColumns = function (columns)
        {
        	var x, y, index, offset = 0;
        	if (!!columns && columns.length != undefined) {
        		this._instance.hiddenCols = columns;
        		var headerCols = this._instance.table.tHead.rows[0].children;
        		var rows = this._instance.table.tBodies[0].childNodes;
    			if (domClass.contains(headerCols[0], "SelCtl")) {
    				//first column is a selection column
    				offset = 1;
    			}

    			//first show all then hide the ones selected
    			for (y=0; y<rows.length; y++) {
    				for (x=0; x<rows[y].children.length; x++) {
        				domClass.remove(rows[y].children[x], "hide");
    				}
    			}
        		for (x=0; x<columns.length; x++) {
        			index = columns[x] - 1 + offset;
        			domClass.add(headerCols[index], "hide");
        			for (y=0; y<rows.length; y++) {
        				domClass.add(rows[y].children[index], "hide");
        			}
        		}
        		
        	}
        };
        

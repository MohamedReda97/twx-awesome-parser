            },
            _removePaginationCtl: function (view) {
                var footer = view._instance.footer;
                if (view._instance.paginationCtl) {
                    var paginationWrap = footer && footer.querySelector("div.dataTables_paginate.paging_simple_numbers");
                    !!paginationWrap && domConstruct.empty(paginationWrap);
                    delete view._instance.paginationCtl;
                }
            },
            _createPaginationCtl: function (view) {
                var footer = view._instance.footer;
                var headerFooterStyle = view.context.options.headerFooterStyle.get("value");
                var paginationWrap = footer && footer.querySelector("div.dataTables_paginate.paging_simple_numbers");

                this._removePaginationCtl(view);
                if (!paginationWrap) {
                    return;
                }

                if (headerFooterStyle === "Modern") {
                    view._instance.paginationCtl = paginationWrap;
                } else {
                    //Added for Tk-1046
                    var nav4ul=document.createElement("nav");
                    domAttr.set(nav4ul,"role","navigation");
                    paginationWrap.appendChild(nav4ul);
                    //Ends
                    view._instance.paginationCtl = document.createElement("ul");
                    domClass.add(view._instance.paginationCtl, "pagination");
                    // Changed from paginationWrap.appendChild(view._instance.paginationCtl) for Tk-1046
                    nav4ul.appendChild(view._instance.paginationCtl);
                    // Ends
                }

                return view._instance.paginationCtl;
            },
            _refreshPaginationStatus : function(view)
            {
                if (!view.context.options.showPager.get("value")) {
                    return this._removePaginationCtl(view);
                }

                if (!view._instance.paginationCtl) {
                    this._createPaginationCtl(view);
                }

                var headerFooterStyle = view.context.options.headerFooterStyle.get("value");
                if (headerFooterStyle === "Modern") {
                    return this._refreshModernPagination(view);
                }

                var ps = view.context.options.pageSize.get("value");
                !ps && view.setPageSize(view._instance.defaultPageSize);

                //BG-969 changed >= to clear when ps blank or 0
                if(ps >= 0)
                {
                    if(
                        view._instance.paginationCtl != null &&
                        view.context.options.showPager.get("value"))
                    {
                        view._instance.paginationCtl.innerHTML = "";
                        var maxButtons = 5;
                        var pageIdx = view._instance.pageIdx != null ? view._instance.pageIdx : 0;

                        if(ps > 0)
                        {
                            var lu = view._instance.paginationCtl;
                            var items = view._instance.list;
                            var length = items != null ? items.length() : 0;
                            var maxPageIdx = Math.ceil(length / ps) - 1;
                            var pageCount = maxPageIdx + 1;
                            var i;
                            
                            //{#feature: US-1330 Added RT localization}
                            this._createPaginationButton(
                                view,
                                lu,
                                bpmext.localization.formatMsg("general", "PREVIOUS"),
                                "previous" + (pageIdx == 0 ? " disabled" : ""),
                                function(){
                                    var idx = view.getPageIndex();
                                    if(idx != 0)
                                    {
                                        idx--;
                                        view.setPageIndex(idx);
                                    }
                                },
                                "previous");

                            if(pageCount <= maxButtons)
                            {
                                for(i = 1; i <= pageCount; i++)
                                {
                                    this._createPaginationButton(
                                        view,
                                        lu,
                                        i,
                                        (i-1) == pageIdx ? "active" : null,
                                        function(event) {
                                            view.setPageIndex(Number(this.innerHTML) - 1);
                                            return false;
                                        },
                                        i);
                                }
                            }
                            else
                            {
                                var rat = pageCount/maxButtons;
                                var lastIdx = 0;                              
                                for(i = 0; i < maxButtons; i++)
                                {
                                    var idx = i * rat;
                                    idx = i < (maxButtons - 1) ? Math.round(idx) : maxPageIdx;

                                    //Always highlight selected page)
                                    if(pageIdx < idx && pageIdx > lastIdx)
                                        idx = pageIdx;

                                    this._createPaginationButton(
                                        view,
                                        lu,
                                        idx + 1,
                                        idx == pageIdx ? "active" : null,
                                        function(event) {
                                            view.setPageIndex(Number(this.innerHTML) - 1);
                                            return false;
                                        },
                                        i);

                                    lastIdx = idx;
                                }
                            }

                            //{#feature: US-1330 Added RT localization}
                            this._createPaginationButton(
                                view,
                                lu,
                                bpmext.localization.formatMsg("general", "NEXT"),
                                "next" + (pageIdx < maxPageIdx ? "" : " disabled"),
                                function(){
                                    var idx = view.getPageIndex();
                                    if(idx+1 <= view.getMaxPageIndex())
                                    {
                                        idx++;
                                        view.setPageIndex(idx);
                                    }
                                },
                                "next");
                        }
                    }
                    else if (view._instance.paginationCtl != null && !view.context.options.showPager.get("value"))
                    {
                        view._instance.paginationCtl.innerHTML = "";
                    }

                    if(view._instance._pageSizer != null)
                        view._instance._pageSizer.value = ps;
                }
                else /* {#feature: 357 allow table stats to be removed} */
                {
                    if(view._instance._pageSizer != null)
                        view._instance._pageSizer.value = "";
                }
            },
            _refreshModernPagination: function(view) {
                var ps = view.context.options.pageSize.get("value");
                !ps && view.setPageSize(view._instance.defaultPageSize);
                if(ps > 0) {
                    var refresh = false;
                    var items = view._instance.list;
                    var length = items != null ? items.length() : 0;
                    var pageCount = Math.ceil(length / ps) || 1;

                    if (!!view._instance.paginationCtl && view.context.options.showPager.get("value")) {
                        var pageIdx = view._instance.pageIdx != null ? view._instance.pageIdx : 0;
                        var pageSelector = view._instance.paginationCtl.querySelector(".pageSelector");
                        var select = pageSelector && pageSelector.querySelector("select");

                        if (select) {
                            var options = select.querySelectorAll("option");
                            refresh = (options && options.length !== pageCount);
                        }
                        
                        if (!pageSelector || refresh) {
                        	domConstruct.empty(view._instance.paginationCtl);
                        	
                        	var pageNumbArr = [];
                        	for (var i=0; i<pageCount; i++) {
                        		pageNumbArr.push(i+1);
                        	}
                        	
                        	var labelTemplate = pageCount === 1 ? "PAGE_SELECT_COUNT_SINGULAR" : "PAGE_SELECT_COUNT_PLURAL";
                            pageSelector = this._createSingleSelect(
                                view, 
                                view._instance.paginationCtl, 
                                pageNumbArr, 
                                "pageSelector", 
                                bpmext.localization.formatMsg("controlTable", labelTemplate, pageCount),
                                "right", 
                                function(event) {
                                    view.setPageIndex(Number(this.value) - 1);
                                    return false;
                                }, 
                                "pageSelector"  
                            );
                            
                            this._createIconButton(
                                view, 
                                view._instance.paginationCtl, 
                                "ci-caret-left", 
                                "previous disabled", 
                                function(){
                                    var idx = view.getPageIndex();
                                    if(idx != 0)
                                    {
                                        idx--;
                                        view.setPageIndex(idx);
                                    }
                                }, 
                                "previous"
                            );

                            this._createIconButton(
                                view, 
                                view._instance.paginationCtl, 
                                "ci-caret-right", 
                                "next" + (pageCount <= 1 ? " disabled" : ""), 
                                function(){
                                    var idx = view.getPageIndex();
                                    if(idx+1 <= view.getMaxPageIndex())
                                    {
                                        idx++;
                                        view.setPageIndex(idx);
                                    }
                                },
                                "next"
                            );
                        } else {
                            var previousBtn = view._instance.paginationCtl.querySelector(".previous");
                            var nextBtn = view._instance.paginationCtl.querySelector(".next");

                            if (pageCount <= 1) {
                                domClass.add(previousBtn, "disabled");
                                domAttr.set(previousBtn, "tabindex", "-1");
                                domClass.add(nextBtn, "disabled");
                                domAttr.set(nextBtn, "tabindex", "-1");
                            } else if (pageIdx === 0) {
                                domClass.add(previousBtn, "disabled");
                                domAttr.set(previousBtn, "tabindex", "-1");
                                domClass.remove(nextBtn, "disabled");
                                domAttr.set(nextBtn, "tabindex", "0");
                            } else if (pageIdx === pageCount - 1) {
                                domClass.remove(previousBtn, "disabled");
                                domAttr.set(previousBtn, "tabindex", "0");
                                domClass.add(nextBtn, "disabled");
                                domAttr.set(nextBtn, "tabindex", "-1");
                            } else {
                                domClass.remove(previousBtn, "disabled");
                                domAttr.set(previousBtn, "tabindex", "0");
                                domClass.remove(nextBtn, "disabled");
                                domAttr.set(nextBtn, "tabindex", "0");
                            }

                            if (select) {
                                select.value = pageIdx + 1 + "";
                            }
                        }
                    } else if (view._instance.paginationCtl) {
                        domConstruct.empty(view._instance.paginationCtl);
                    }
                } else if(ps < 0 && view._instance._pageSizer != null) {
                    view._instance._pageSizer.value = "";
                }
            },
            _replaceClass : function(node, newClass, oldClass)
            {
                if(oldClass != undefined)
                {
                    if(newClass != undefined)
                        domClass.replace(node, newClass, oldClass);
                    else
                        domClass.remove(node, oldClass);
                }
                else if(newClass != undefined)
                {
                    domClass.add(node, newClass);
                }
            },
            _normalizeColorStyle: function(style)
            {
                // OPTS_COL_CLZ : {
                    // "D" : "",
                    // "L" : "table-light",
                    // "P" : "table-primary",
                    // "I" : "table-info",
                    // "S" : "table-success",
                    // "W" : "table-warning",
                    // "G" : "table-danger"
                // },
                if(!style)
                    style = "D";

                style = style.toUpperCase();

                if(style == "E")
                    style = "G";

                if(style.length > 1)
                {
                    switch (style)
                    {
                        case "DEFAULT":
                        case "DEF":
                            style = "D";
                            break;
                        case "LIGHT":
                            style = "L";
                            break;
                        case "SUCCESS":
                            style = "S";
                            break;
                        case "INFO":
                        case "INF":
                            style = "I";
                            break;
                        case "PRIMARY":
                        case "PRI":
                            style = "P";
                            break;
                        case "WARNING":
                        case "WARN":
                            style = "W";
                            break;
                        case "ERROR":
                        case "ERR":
                        case "DANGER":
                            style = "G";
                            break;
                        default:
                            //{#feature: US-1330 Added RT localization}
                            //bpmext.log.warn("Unexpected color style: " + style);
                            bpmext.log.warn(bpmext.localization.formatMsg("general", "COLOR_STYLE_WARNING", style));
                    }
                }

                return style;
            },
            _setColorStyle : function(view, newVal, oldVal)
            {
                if(!oldVal)
                    oldVal = view._instance.oldColStyle;

                newVal = this._normalizeColorStyle(newVal);
                oldVal = this._normalizeColorStyle(oldVal);

                bpmext.ui.util.replaceCSSClass(view._instance.envelope, this.OPTS_COL_CLZ, newVal, oldVal);
                view._instance.oldColStyle = newVal;
            },
            _setTableStyle : function(view, style)
            {
                var st = view.context.options.tableStyle.get("value");
                //Added for TK-1047
                domAttr.set(view._instance.heading,"role","heading");
                //TK-1047 Ends
                if(st != "D")
                {
                    domClass.add(view._instance.envelope, "panel");

                    this._replaceClass(view._instance.heading, "panel-heading", "table-header");
                    domClass.add(view._instance.outerBody, "panel-body");
                    this._replaceClass(view._instance.title, "panel-title", "table-caption");
                    domClass.remove(view._instance.table, "table-bordered");
                }
                else
                {
                    domClass.remove(view._instance.envelope, "panel");
                    this._replaceClass(view._instance.heading, "table-header", "panel-heading");
                    domClass.remove(view._instance.outerBody, "panel-body");
                    this._replaceClass(view._instance.title, "table-caption", "panel-title");
                    domClass.add(view._instance.table, "table-bordered");
                }



                if(view._instance.oldTblStyle != null)
                    domClass.remove(view._instance.table, this.OPTS_STL_CLZ[view._instance.oldTblStyle]);

                view._instance.oldTblStyle = st;
                domClass.add(view._instance.table, this.OPTS_STL_CLZ[st]);

                //Added for finer styling control for scrolling tables
                if(view._instance.oldTblStyle2 != null)
                    domClass.remove(view._instance.envelope, this.OPTS_STL_CLZ2[view._instance.oldTblStyle2]);

                view._instance.oldTblStyle2 = st;
                domClass.add(view._instance.envelope, this.OPTS_STL_CLZ2[st]);
            },
            _updateColumnHeaderWidth : function(view)
            {
                setTimeout(function(){
                	// Sometimes this will be invoked on IE11 prior to the table data being available
                	if (view._instance.table.rows.length <= 1) {
                	    return;
                	}
                    var i,
                        length = view._instance.table.rows[1].cells.length;
                        colgroup = view._instance.table.querySelector("colgroup");

                    for(i = 0; i < length; i++) {
                        var col = colgroup.children[i];
                        var cell = view._instance.table.rows[1].cells[i];
                        if(!domClass.contains(cell, "RowSel") && !domClass.contains(cell, "RowDel") && !domClass.contains(cell, "RowExp")) {
                            var cellWidth = cell.clientWidth + "px";
                            view._instance.table.rows[0].cells[i].style.width = cellWidth;
                            view._instance.table.rows[0].cells[i].style.maxWidth = cellWidth;
                            col.style.width = cellWidth;
                        }
                    }
                }, 800);
            },
            _scrollHeader : function(event)
            {
                if(event.type === "resize") {
                    this._instance.columnHeaderWidthUpdated = false;
                }

                if(!this._instance.columnHeaderWidthUpdated){
                    this._instance.columnHeaderWidthUpdated = true;

                    domAttr.set(this._instance.headerRow, "style", {
                        position: 'absolute',
                        top: 0
                    });

                    this._proto._updateColumnHeaderWidth(this);
                }
                
                var scrollLeft = this._instance.scrollableArea.scrollLeft;
                var leftOffset = parseInt(window.getComputedStyle(this._instance.outerBody).paddingLeft) || 0;
                var left = scrollLeft * -1 + leftOffset + 'px';
                domAttr.set(this._instance.headerRow, "style", {
                    left: left
                });
            },
            _setHeadersVisibility : function(view, boolList, collapseHeader) {
                try {
                    var allHidden = true;
                    var children = view._instance.headerRow.childNodes;
                    var i;
                    for (i = 0; i < boolList.length; i++) {
                        if (boolList[i] === true) {
                            Array.prototype.slice.call(children[i].children).forEach(function(element){
                                element.classList.remove("hide");
                            });
                            allHidden = false;
                        } else if(boolList[i] === false) {
                            Array.prototype.slice.call(children[i].children).forEach(function(element){
                                element.classList.add("hide");
                            });
                        }
                    }

                    var thead = view._instance.table.querySelector("thead");
                    if (allHidden && collapseHeader === true) {
                        thead.classList.add("hide");
                    } else {
                        thead.classList.remove("hide");
                    }
                } catch (e) {
                    bpmext.log.error("Table._setHeadersVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setHeight : function(view, height)
            {
                if (height != null && height != "")
                {
                    if (!isNaN(height))
                        height += "px";

                    view._instance.outerBody.style.height = height;
                    domClass.add(view._instance.outerBody, "ScrollTable");
                    domClass.add(view._instance.scrollableArea, "ScrollArea");
                    domClass.add(view._instance.heading, "ScrollHeading");
                    view._instance._scrollingTbl = true;

                    view._instance.resizeHandle = view._proto._scrollHeader.bind(view);
                    window.addEventListener("resize", view._instance.resizeHandle, false);

                    view._instance.scrollHandle = view._proto._scrollHeader.bind(view);
                    view._instance.scrollableArea.addEventListener("scroll", view._instance.scrollHandle, false);
                }
                else
                {
                    if(view._instance.headerRow) {
                        domAttr.remove(view._instance.headerRow, "style");
                        view._instance.columnHeaderWidthUpdated = false;
                    }
                    view._instance.outerBody.style.height = "";
                    domClass.remove(view._instance.outerBody, "ScrollTable");
                    domClass.remove(view._instance.scrollableArea, "ScrollArea");
                    domClass.remove(view._instance.heading, "ScrollHeading");
                    view._instance._scrollingTbl = false;

                    window.removeEventListener("resize", view._instance.resizeHandle, false);
                    view._instance.scrollableArea.removeEventListener("scroll", view._instance.scrollHandle, false);
                }
                view._proto._setDisablerHeight(view, height);
            },
            //BG-1222 setting top size of disabler heght based on heading and padding height
            _setDisablerHeight : function(view, height)
            {
                if (view._instance.disabler && view._instance.outerBody && view._instance.scrollableArea && view._instance.headerRow && view._instance.heading)
                {
                    if (height != null && height != "")
                    {
                        view._instance.disabler.style.top = view._instance.heading.clientHeight + 55 + "px";
                        view._instance.disabler.style.width = "auto";
                        view._instance.disabler.style.left = "0px";
                        view._instance.disabler.style.right = (view._instance.outerBody.clientWidth - view._instance.scrollableArea.offsetWidth)/2 + view._instance.scrollableArea.offsetWidth - view._instance.scrollableArea.clientWidth + "px";
                    }
                    else
                    {
                        view._instance.disabler.style.top = ((view._instance.outerBody.clientHeight - view._instance.scrollableArea.clientHeight)/2) + view._instance.headerRow.clientHeight + view._instance.heading.clientHeight + "px";
                        view._instance.disabler.style.width = "100%";
                        view._instance.disabler.style.right = "0px";
                    }
                }
            },
            //START Data Service-backed Table logic ///////////////////////////////////////////
            _toString : function(val)
            {
                if(typeof val != "object")
                    return val + "";
                else
                    return val;
            },
            _callDataSvc : function(view, query, onLoadFn)
            {
                if(!view.context.options.dataService){
                    //{#feature: US-1330 Added RT localization}
                    //throw new Error("Unsupported operation for a table not backed by a data service");
                    throw new Error(bpmext.localization.formatMsg("controlTable", "ERROR_TABLE_NOT_BACKEDBY_DATASVC"));
                }

                var d = {};

                d.data = (query != undefined ? this._toString(query) : null);
                if(d.data != null && typeof d.data == "object" && d.data.toJson)
                    d.data = json.parse(d.data.toJson()); //Extract only the data that matters

                var serviceArgs =
                {
                    params: json.stringify(d),
                    load: function(response)
                    {
                        var results = response.results;
                        var items;
                        if(results)
                            items = results.items;
                            //{#bug: BG-694 FIX for 0 items returned from call.}
                            if (items == null)      // BG-694  FIX for 0 items returned from call.
                                items = [];

//                      if(items !== null && items !== undefined)       BG-694 no longer necessary
//                       {                                              BG-694 no longer necessary
                            var list = new com.ibm.bpm.coach.List(items, "svc.items");
                            view.context.binding = bpmext.ui.substituteObject(view, "binding", "list", list);

                            view._instance.list = new ItemList(view, function(){
                                return view.context.binding.get("value");
                            }, svcDataTbl);
                            view._proto._rebindAllUpdates(view);    // BG 564
                            if(view._instance._sortCol != null)
                                view.sort();
                            else
                                view._proto._reloadList(view);

                            var height = view.context.options.height.get("value");
                            if (height !== null && height !== "")
                                view._proto._scrollHeader.call(view, {type:"resize"});

                            onLoadFn();
                            bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONDATALOADED);
//                      }                                           BG-694 no longer necessary
                    },
                    error: function(error)
                    {
                        try
                        {
                            //debugger;
                            onLoadFn();
                            bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONDATAERROR);
                        }
                        catch(e)
                        {
                            //{#feature: US-1330 Added RT localization}
                            //errorTxt = "Error processing data service error: " + e;
                            errorTxt = bpmext.localization.formatMsg("controlTable", "ERROR_WHEN_PROCESSING_DATASVC") + ": " + e;
                            //Display updated error here
                        }
                    }
                };

                try
                {
                    view.context.options.dataService(serviceArgs);
                }
                catch(e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("AJAX result processing error: " + e);       //BG-853
                    bpmext.log.error(bpmext.localization.formatMsg("general", "AJAX_RESULT_PROCESSING_ERROR") + ": " + e);  //BG-853
                }
            },
            _updateTable : function(view)
            {
                if(view._instance._refreshing)
                    return;

                view._instance._refreshing = true;
                view._instance.loadedRowCount = 0;

                var input = view.getQueryData();
                try
                {
                    this._callDataSvc(
                        view,
                        input,
                        function(data)
                        {
                            /*
                            if(view.context.options.showFooter.get("value"))
                            {
                                view._proto._refreshTableStats(view);
                                view._proto._refreshPaginationStatus(view);
                            }
                            */
                        }
                    );
                }
                finally
                {
                    delete view._instance._refreshing;
                }
            },
            _handleVisibility : function (view)
            {
                var visibility = utilities.handleVisibility(view.context);

                //BG-1222 handling visibility of Add Button and Select All
                if (visibility != "NONE")
                {
                    var readonly = false;
                    if (visibility == "READONLY")
                    {
                        readonly = true;
                        domClass.remove(view._instance.disabler, "hidden");
                        if(view._instance.addRecBtn != null)
                            domClass.add(view._instance.addRecBtn, "disabled");
                        if(view._instance.chkSelector != null){
                            view._instance.chkSelector.disabled = true;
                            domAttr.set(view._instance.chkSelector, "aria-disabled", "true");
                        }
                    }
                    else
                    {
                        domClass.add(view._instance.disabler, "hidden");
                        if(view._instance.addRecBtn != null)
                            domClass.remove(view._instance.addRecBtn, "disabled");
                        if(view._instance.chkSelector != null){
                            view._instance.chkSelector.disabled = false;
                            domAttr.set(view._instance.chkSelector, "aria-disabled", "false");
                        }
                    }

                    if (view._instance.selMode != "N") {
                        var selectionBoxTypeClass = view._instance.selMode === "S" ? ".radio" : ".checkbox";
                        var selector = "table[uid='" + view._instance.table.getAttribute('uid') + "'] > tbody > tr > td > " + selectionBoxTypeClass + "3 > input";
                        var selectionBoxes = view._instance.table.parentElement.querySelectorAll(selector);

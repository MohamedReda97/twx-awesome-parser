            _renderExpandableRowAsCustom : function(view, tr, td, item, rowIdx)
            {
                var rowCtx = {
                    tr: tr,
                    td : td,
                    data: item,
                    index: rowIdx
                };

                if(view._instance._onExpandableRowLoadFn && view._instance._onExpandableRowLoadFn.execute) {
                    var c;

                    try {
                        c = view._instance._onExpandableRowLoadFn.execute(rowCtx);
                    }
                    catch(e) {

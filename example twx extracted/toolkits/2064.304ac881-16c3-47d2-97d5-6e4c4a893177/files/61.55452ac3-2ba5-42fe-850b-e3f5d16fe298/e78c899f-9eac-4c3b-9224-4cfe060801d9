            _renderAsCV : function(view, child, tr, td, altIdx, rowIdx, cspec)
            {
                var c = child.cloneNode(true);
                td.appendChild(c);
                var idx = (altIdx !== null && altIdx !== undefined) ? altIdx : rowIdx;
                var v = view.context.createView(c, idx, view);
                if(!!cspec.showLabel) {
                    v.context.options._metadata.labelVisibility.set("value", "SHOW");
                } else {
                    v.context.options._metadata.labelVisibility.set("value", "HIDE");
                }

                //Save references for lookup performance
                v._rcdRef = tr.__listItem;
                td._viewRef = v;
            },
            _renderAsSeamlessCV : function(view, child, tr, td, altIdx, rowIdx, cspec)

            }
            */

            var tmp =  this._instance.cspecs;
            var cspecs = [];
            for (var i = 0; i < tmp.length; i++){
                var cspec = tmp[i];
                cspec = cspec.toJSObject ? cspec.toJSObject() : lang.clone(cspec);
                

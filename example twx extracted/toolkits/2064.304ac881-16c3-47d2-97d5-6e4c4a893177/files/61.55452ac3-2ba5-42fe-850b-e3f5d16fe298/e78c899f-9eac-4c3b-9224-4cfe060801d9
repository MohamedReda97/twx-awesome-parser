            _initList: function (view)
            {
                var val = view.context.binding ? view.context.binding.get("value") : null;

                //BG-1194 initializing new list when get value is null
                if (!svcDataTbl && val == null) {
                    if(view.context.binding) {
                        var list = new com.ibm.bpm.coach.List([], "list.items");
                        view.context.binding.set("value", list); //potential to change backing variables unintentionally.
                    }
                    else {
                        bpmext.log.warn("Detected Table without a bound variable, certain features may produce unexpected results", view);
                    }
                }

                if(val && val instanceof com.ibm.bpm.coach.List)
                {
                    // Based on Coach frameworks createListElement function in List.js and as commented in its constructor,
                    // the .te property may not exist if the data was returned from a service call
                    require(["com.ibm.bpm.coach/templateStore"], lang.hitch(this, function(templateStore) {
                        if(!val.te && val._objectPath) {
                            val.te = templateStore.getTypeByPath(val._objectPath);
                        }

                        //297019: If the list is composed of simple types, need to have special processing
                        if (val.te == "S" || val.te == "B" || val.te == "D" || val.te == "I" || val.te == "DT") {
                            //it is a simple type list
                            view._instance.isSimpleTypeList = true;

                            var simpleItems = [];
                            for (var x=0; x < val.length(); x++) {
                                simpleItems[x] = {value:val.items[x]};
                            }
                            view._instance.simpleTypeList = new com.ibm.bpm.coach.List(simpleItems, "simpleType.items");
                            view._instance.list = new ItemList(view, function(){
                                return view._instance.simpleTypeList;
                            }, !!svcDataTbl, function(){
                                return view.context.binding.get("value");
                            });
                        } else {
                            view._instance.list = new ItemList(view, function(){
                                return view.context.binding.get("value");
                            }, !!svcDataTbl);
                        }
                        this._rebindAllUpdates(view);
                        this._reloadList(view);
                    }));
                }
                else
                {
                    //Display "no data" indicator
                }

        {
            //{#feature: * getPageSize() enhancement - now supports page [index] and [actual] flag}
            //Allow omission of index
            if(typeof index == "boolean")
            {
                actual = index;
                index = void(0);
            }

            var ps = this.context.options.pageSize.get("value");
            if(ps < 1)
                ps = this._instance.list.length();

            if(index == null)

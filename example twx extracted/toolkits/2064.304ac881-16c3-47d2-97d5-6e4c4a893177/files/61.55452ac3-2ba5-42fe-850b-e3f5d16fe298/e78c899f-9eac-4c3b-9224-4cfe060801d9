            _dragnDropColumn: function(view) {
                var colgroup = view._instance.table.querySelector("colgroup");
                var isOnLeft = function isOnLeft(node) {
                    // Get the bounding rectangle of nodes
                    var rect = node.getBoundingClientRect();
                    var center = rect.left + rect.width / 2;

                    return event.clientX < center;
                };

                var dropColumn = function dropColumn(event) {
                    event.preventDefault();
                            
                    var tr = view._instance.headerRow;
                    var dropBeforeElm = tr.querySelector(".dropBefore");
                    var dropAfterElm = tr.querySelector(".dropAfter");

                    domClass.remove(tr, "dragStart");

                    var referenceNode;
                    if(dropBeforeElm) {
                        domClass.remove(dropBeforeElm, "dropBefore");
                        referenceNode = dropBeforeElm;
                    }

                    if(dropAfterElm) {
                        domClass.remove(dropAfterElm, "dropAfter");
                        referenceNode = dropAfterElm.nextSibling;
                    }

                    var dragOverElm = event.type === "touchend" ? view._instance.movingElement.querySelector("th") : event.target;

                    //Return if the element is being dropped over columns such as select, expand or delete row
                    if(dragOverElm.__bpmDragOverDisabled || !referenceNode) {
                        return;
                    }

                    var data = "";
                    var th = event.currentTarget.localName === "th" ? event.currentTarget : event.currentTarget.parentElement;
                    if (domClass.contains(th, "draggable")) {
                        data = th.id;
                    } else {
                        data = event.dataTransfer.getData("text");
                    }
                    var elmBeingDragged = tr.querySelector("[id=" + data + "]");
                    var elmBeingDraggedIdx = elmBeingDragged.cellIndex;
                    var rows = view._instance.table.rows;
                    var referenceNodeIdx = referenceNode.cellIndex;
                    var colElmBeingDragged = colgroup.children[elmBeingDraggedIdx];

                    //Return if the element is being dropped at the same location
                    if(elmBeingDragged === dragOverElm) {
                        return;
                    }

                    //Move header to new location
                    colgroup.insertBefore(colElmBeingDragged, colgroup.children[referenceNodeIdx]);
                    tr.insertBefore(elmBeingDragged, referenceNode);

                    var i;
                    for(i = 1; i < rows.length; i++) {
                        var row = rows[i];
                        if(!row.__bpmExpandableRow) {
                            var cell = row.cells[elmBeingDraggedIdx];
                            if(cell) {
                                row.insertBefore(cell, row.cells[referenceNodeIdx]);
                            }
                        }
                    }

                    setTimeout(function() {
                        //Clear cached rows
                        var i;
                        for(i = 1; i < view._instance.list.length(); i++) {
                            var listItem = view._instance.list.get(i);
                            var ctx = view._instance.list.getItemContext(listItem);

                            if(ctx.tr) {
                                ctx.tr.__bpmRefreshRow = true;
                            }
                        }

                        //Update column specs
                        var columnSpecs = view.getOption("columnSpecs");
                        var cspecs = view._instance.cspecs;
                        var cols = [];

                        cspecs.sort(function(a, b) {
                            return a.headerTH.cellIndex - b.headerTH.cellIndex;
                        });

                        for(i = 0; i < cspecs.length; i++) {
                            var cspec = cspecs[i];
                            var col = lang.clone(cspec);
                            delete col["template"];
                            delete col["headerTH"];
                            delete col["colElm"];
                            cols[col["origIndex"]] = col;
                            delete col["origIndex"];
                            
                            col["columnOrder"] = i;

                            if(columnSpecs.get(cspec.origIndex)) {
                                columnSpecs.get(cspec.origIndex).set("columnOrder", i);
                            }
                            view._instance.colToVarMap[i] = cspec.headerTH.__varName;

                            //Update resize column element to allow/disallow resize
                            if(view._instance.allowColumnResize) {
                                var colResize = cspec.headerTH.querySelector(".colResize");

                                if(i == cspecs.length - 1) {
                                    domClass.add(colResize, "hide");
                                } else {
                                    domClass.remove(colResize, "hide");
                                }
                            }
                        }

                        if(view._instance._onColumnDropFn && view._instance._onColumnDropFn.execute) {
                            view._instance._onColumnDropFn.execute(cols);
                        }
                    });
                }

                // Places the firstNode before or after the nextNode
                function placeNode (firstNode, nextNode) {
                    var draggableHeaders = Array.prototype.slice.call(view._instance.headerRow.querySelectorAll("[draggable='true']"));
                    draggableHeaders.forEach(function(header) {
                        header.classList.remove("dropBefore");
                        header.classList.remove("dropAfter");
                    })
                    if (isBefore(firstNode, nextNode)) {
                        nextNode.classList.add("dropBefore");
                        view._instance.helpText.innerHTML = bpmext.localization.formatMsg("controlTable", "DROP_BEFORE", nextNode.innerText);
                    }
                    else {
                        nextNode.classList.add("dropAfter");
                        view._instance.helpText.innerHTML = bpmext.localization.formatMsg("controlTable", "DROP_AFTER", nextNode.innerText);
                    }
                 }

                 // Tells us if the firstNode is located before or after the nextNode
                function isBefore(firstNode, nextNode) {
                    var sibling = firstNode.previousSibling;
                    while(sibling) {
                       if(sibling === nextNode) {
                          return true;
                       }
                       sibling = sibling.previousSibling;
                    }
                    return false;
                 }
                
                view._instance.handleEvent = function(event) {
                    //Drag n Drop functions - Start
                    switch(event.type){
                        case "touchstart":
                            // If there's a moving element
                            if(!view._instance.movingElement && !view._instance.placingElement && event.currentTarget.parentNode.draggable) {

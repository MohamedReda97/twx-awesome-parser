            _refreshColumnSpecs : function(view)
            {
                if(view._instance.list != null) //{#bug: 916 Added null list check to prevent load-time runtime error under certain conditions}
                {
                    var len = view._instance.list.unfilteredLength();

                    for(var i = len - 1; i >= 0; i--)
                    {
                        var item = view._instance.list.getUnfiltered(i);
                        var ctx = view._instance.list.getItemContext(item);

                        if(ctx && ctx.tr != null)
                        {
                          //BG-1229 added parameter to skip refresh view
                            this._deleteRow(view, ctx, true); //Deletes the row and associated coach views if any
                            delete ctx.tr;  //This will trigger _addRow to re-add row and views

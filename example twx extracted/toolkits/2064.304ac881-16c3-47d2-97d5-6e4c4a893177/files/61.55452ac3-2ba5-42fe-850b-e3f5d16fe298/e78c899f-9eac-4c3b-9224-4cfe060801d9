        /**
         * @instance
         * @memberof Table
         * @method setColumns
         * @desc Sets column specifications for the Service Data Table (results in complete table reset if the table had loaded records)
         * @param {object} columnSpecs The specifications for the columns
         * @example
         * var table1 = page.ui.get("Table1");
         * var columnSpecs = [
         *  {width: "20%", visibility: true, sortable: true, css: "", dataElementName: "str1", type: "Text", label: "Str1", showLabel: true, rearrangeColumn: true, columnOrder: 1, required: true},
         *  {width: "25%", visibility: true, sortable: true, css: "", dataElementName: "int1", type: "Integer", label: "Int1", showLabel: false, rearrangeColumn: false, columnOrder: 0, required: true},
         *  {width: "25%", visibility: true, sortable: true, css: "", dataElementName: "dec1", type: "Decimal", label: "Dec1", showLabel: true, rearrangeColumn: true, columnOrder: 3, options:{decimalPlaces: 2, prefix: "$", thousandSeparator: ","}},
         *  {width: "30%", visibility: true, sortable: false, css: "", dataElementName: "date1", type: "Date", label: "Date1", showLabel: true, rearrangeColumn: false, columnOrder: 2, options:{datePattern: "yyyy-MM"}},
         * ];
         *
         * table1.setColumns(columnSpecs);
         * table1.refresh();
         */
        this.constructor.prototype.setColumns = function(cspecs)
        {
        	/*
            if (!svcDataTbl)
            {
                //{#feature: US-1330 Added RT localization}
                //throw new Error("Only Service Data Table supports setColumns");
                throw new Error(bpmext.localization.formatMsg("controlTable", "TABLE_SETCOLUMNS_ERROR"));
            }
            */

            if (cspecs == null)
                return;

            var view = this;
            var i;

            // Defect#330243 - START
            if(view._instance.list != null) //{#bug: 916 Added null list check to prevent load-time runtime error under certain conditions}
            {
                var len = view._instance.list.unfilteredLength();

                for(i = len - 1; i >= 0; i--)
                {
                    var item = view._instance.list.getUnfiltered(i);
                    var ctx = view._instance.list.getItemContext(item);

                    if(ctx && ctx.tr != null)
                    {
                      //BG-1229 added parameter to skip refresh view
                        this._proto._deleteRow(view, ctx, true); //Deletes the row and associated coach views if any
                        delete ctx.tr;  //This will trigger _addRow to re-add row and views
                    }
                }
            }
            // Defect#330243 - END

            var cs = view._instance.contentBoxTemplate.children;

            for(i = cs.length - 1; i >= 0; i--)
            {
                if(domAttr.has(cs[i], "data-viewid"))
                {
                    var c = cs[i];
                    c.parentNode.removeChild(c);
                }
            }

            //{#bug: * Fix to allow proper hiding of columns (and associated headers) in setColumns()}
            var cfgCS;
            if(view.context.options.columnSpecs != null)
            {
                cfgCS = view.context.options.columnSpecs.get("value");
                while(cfgCS.remove(0));
            }
            else
            {
                cfgCS = new com.ibm.bpm.coach.List([], "columns.config");
                view.context.options.columnSpecs = bpmext.ui.substituteConfigOption(this, "columnSpecs", cfgCS);
                //view.context.options.columnSpecs.set("value", cfgCS);
            }

            if(cspecs != null && cspecs.length > 0)
            {
                view._instance.cspecs = [];
                var availableColumnIndices = [];

                for(i = 0; i < cspecs.length; i++)
                {
                    availableColumnIndices.push(i);

                    var cspec = cspecs[i];
                    cfgCS.add(cspec);

                    var vis = cspec.visibility;
                    if(vis === false)
                        cspec.visibility = "N";
                    else if(vis === true)
                        cspec.visibility = "V";

                    if(cspec.renderAs == null)
                        cspec.renderAs = "H"; //HTML

                    if(cspec.columnOrder == "")
                        cspec.columnOrder = null;

                    if(cspec.rearrangeColumn == null)
                        cspec.rearrangeColumn = false;

                    var node = document.createElement("div");
                    var viewId = view._instance._viewId + "" + i;

                    node.setAttribute("data-viewid", viewId);
                    node.setAttribute("data-type", "spark.0000." + cspec.type);
                    node.setAttribute("data-binding", "local.list[index]." + cspec.dataElementName);

                    var topts = cspec.options;
                    if(topts == null)
                        topts = {};
                    else if(typeof topts == "string")
                    {
                        var opt = topts;
                        if(opt.charAt(0) != "{")
                            opt = '{' + opt + '}';

                        try {
                            topts = json.parse(opt);
                        }
                        catch(e) {}
                    }

                    topts._metadata = {};
                    topts._metadata.label = {
                        _map: {},
                        get: function(prop) {
                            return this._map[prop];
                        },
                        set: function(prop, val) {
                            this._map[prop] = val;
                        }
                    };

                    topts._metadata.visibility = {
                        _map: {},
                        get: function(prop) {
                            return this._map[prop];
                        },
                        set: function(prop, val) {
                            this._map[prop] = val;
                        }
                    };

                    topts._metadata.label.set("value", cspec.label);
                    topts._metadata.visibility.set("value", cspec.required == true ? "REQUIRED" : "DEFAULT");

                    node._dataOptions = cspec.options = topts; //TODO Use map instead of direct attribute on node?

                    cspec.template = node;
                    cspec.origIndex = i;
                    // view._instance.contentBoxTemplate.appendChild(node);
                    view._instance.cspecs.push(cspec);
                }

                //Column order - Start
                view._instance.cspecs.forEach(function(value){
                    if(value.columnOrder == null) {
                        value.columnOrder = availableColumnIndices[0];
                    }

                    var idx = availableColumnIndices.indexOf(value.columnOrder);
                    if (idx > -1) {
                        availableColumnIndices.splice(idx, 1);
                    } else {
                        value.columnOrder = availableColumnIndices[0];
                        availableColumnIndices.splice(value.columnOrder, 1);
                    }
                });

                view._instance.cspecs.sort(function(a, b) {
                    return a.columnOrder - b.columnOrder;
                });
                //Column order - End
            }

            this._proto._reloadHeader(this);
        };

        /**

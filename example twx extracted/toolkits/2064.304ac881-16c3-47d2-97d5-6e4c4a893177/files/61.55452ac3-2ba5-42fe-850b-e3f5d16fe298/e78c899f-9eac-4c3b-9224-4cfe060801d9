            _reloadList : function(view, fromSort)
            {
                //Start BG-1079 (ED)
                //bpmext.log.debug("List reloading for " + view.context.viewid + " new length is [" + view._instance.list.length() + "]");
                bpmext.log.debug("List reloading for " + view.context.viewid + " new length is [" + (!!view._instance.list ? view._instance.list.length() : 0) + "]");
                //End BG-1079 (ED)
                var tbody = view._instance.table.tBodies[0];
                var rows = tbody.childNodes;
                for(var i = rows.length - 1; i >= 0; i--)
                {
                    tbody.removeChild(rows[i]);
                }

                //297019: Rebuild simple type list if it is not called from a sorting/filtering/paging operation
                if (view._instance.isSimpleTypeList && fromSort !== true) {
                    var simpleItems = [];
                    var binding = view.context.binding.get("value");
                    for (var x=0; x < binding.length(); x++) {
                        simpleItems[x] = {value:binding.items[x]};
                    }
                    view._instance.simpleTypeList = new com.ibm.bpm.coach.List(simpleItems, "simpleType.items");
                    view._instance.list = new ItemList(view, function(){
                        return view._instance.simpleTypeList;
                    }, svcDataTbl, function(){
                        return view.context.binding.get("value");
                    });
                }

                //Start BG-1079 (ED)
                if(!!view._instance.list)
                {
                //End BG-1079 (ED)
                    var items = view._instance.list;
                    var startIdx;
                    var pageSize = view.context.options.pageSize.get("value");
                    if(pageSize == null || pageSize == 0)
                    {
                        pageSize = items.length();
                        startIdx = 0;
                    }
                    else
                    {
                        var len = items.length();
                        var maxPageIdx;

                        if(len > 0)
                        {
                            maxPageIdx = Math.ceil(len / pageSize) - 1;
                            if(view._instance.pageIdx > maxPageIdx)
                                view._instance.pageIdx = maxPageIdx;

                            startIdx = (view._instance.pageIdx != null ? view._instance.pageIdx : 0) * pageSize;
                            if(startIdx > len - 1)
                                startIdx = Math.floor(len / pageSize) * pageSize;
                        }
                        else
                            maxPageIdx = startIdx = 0;
                    }

                    if(!view.context.options.deferLoad.get("value"))
                        this._addRowsSync(view, items, startIdx, pageSize);
                    else
                        this._addRowsAsync(view, items, startIdx, 0, pageSize);
                //Start BG-1079 (ED)
                }
                //End BG-1079 (ED

                this._refreshTableStats(view);
                this._refreshPaginationStatus(view);
                //BG-1222 setting top size of disabler based on heading and padding height
                this._setDisablerHeight(view, view.context.options.height.get("value"));
                
                if (view._instance._scrollingTbl) {
                	view._proto._updateColumnHeaderWidth(view);
                }
                
                //Process previously hidden columns
                if (!!view._instance.hiddenCols) {
                    view.hideColumns(view._instance.hiddenCols);
                }
            },
            _isValueMatch : function(view, searchExp, value, re)
            {
                if(re != null)
                    return re.test(value);
                else
                    return searchExp == value;
            },
            _loadColumnSpecs : function(view)
            {
                var cspecs = view.context.options.columnSpecs ? view.context.options.columnSpecs.get("value").toJSObject().items : null;

                view._instance.cspecs = [];
                var createDefCellRenderFn = false;
                var controlType;
                var cspec;
                var i;

                if(cspecs != null)
                {
                    for(i = 0; i < view._instance.recordSize; i++)
                    {
                        cspec = cspecs[i];
                        if(cspec == null)
                            cspec = {};

                        if(cspec.renderAs == null)
                            cspec.renderAs = "V";

                        if(cspec.visibility == null)
                            cspec.visibility = "V";

                        if(cspec.showLabel == null)
                            cspec.showLabel = false;

                        if(cspec.rearrangeColumn == null)
                            cspec.rearrangeColumn = false;

                        if(cspec.renderAs == "C" && view._instance._onNewCellFn == null)
                        {
                            //{#feature: US-1330 Added RT localization}
                            //bpmext.log.warn("Custom cell render is selected, but no cell render logic is provided", view);
                            bpmext.log.warn(bpmext.localization.formatMsg("controlTable", "NO_CELL_RENDER_LOGIC_WARNING"), view);
                            createDefCellRenderFn = true;
                        }

                        if(cspec.options != null)
                        {
                            var opt = cspec.options;
                            if (typeof opt == "string")
                            {
                                if(opt.charAt(0) != "{")
                                {
                                    opt = '{' + opt + '}';
                                }

                                try
                                {
                                    cspec.options = json.parse(opt);
                                }
                                catch(e)
                                {

                                }
                            }
                        }


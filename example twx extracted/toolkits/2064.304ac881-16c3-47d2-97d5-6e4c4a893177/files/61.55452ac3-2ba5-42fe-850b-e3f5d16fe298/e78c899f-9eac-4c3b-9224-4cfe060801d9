            _refreshTableStats : function(view)
            {
                var footer = view._instance.footer;
                if (!footer) {
                    return;
                }

                var statsDiv = footer.querySelector("div.DT-label"); 
                if(view.context.options.showTableStats.get("value") && statsDiv)
                {
                    this._removeTableStats(view);
                    view._instance.statsLabel = domConstruct.create("div", {}, statsDiv);

                    var items = view._instance.list;
                    var length = items != null ? items.length() : 0;
                    var unfilteredLength = items != null ? items.unfilteredLength() : 0;
                    var pageSize = view.context.options.pageSize.get("value");
                    var text = "";

                    if(length == 0 || pageSize == 0)
                    {
                        //{#feature: US-1330 Added RT localization}
                        text = bpmext.localization.formatMsg("controlTable", "SHOWING_ENTRIES", length);
                    }
                    else
                    {
                        var startIdx;
                        if(pageSize == null || pageSize == 0)
                        {
                            pageSize = length;
                            startIdx = 0;
                        }
                        else
                        {
                            var idx = view._instance.pageIdx != null ? view._instance.pageIdx : 0;
                            startIdx = idx * pageSize;
                            if(startIdx > length - 1)
                                startIdx = Math.floor(length / pageSize) * pageSize;
                        }

                        var endIdx = startIdx + pageSize - 1;

                        if(endIdx >= length)
                            endIdx = length - 1;

                        if(startIdx < endIdx){
                            //{#feature: US-1330 Added RT localization}
                            //text += (startIdx + 1) + " to " + (endIdx + 1);
                            text = bpmext.localization.formatMsg("controlTable", "SHOWING_RANGE_ENTRIES", (startIdx + 1), (endIdx + 1), length);
                        }else{
                            //{#feature: US-1330 Added RT localization}
                            //text += " entry " + (startIdx + 1);
                            text += " " + bpmext.localization.formatMsg("general", "ENTRY") + " " + (startIdx + 1);
                            text = bpmext.localization.formatMsg("controlTable", "SHOWING_SINGLE_ENTRY", (startIdx + 1), length);
                        }

                    }

                    if(length != unfilteredLength && unfilteredLength > 0){
                        //{#feature: US-1330 Added RT localization}
                        //text += " (filtered from " + unfilteredLength + " total entries)";
                        text += " (" + bpmext.localization.formatMsg("controlTable", "FILTERED_FROM_MSG", unfilteredLength) + ")";
                    }

                    view._instance.statsLabel.innerHTML = text;
                    //Added for TK-1046
                    if(view._instance.footer){
                    	domAttr.set(view._instance.footer,"aria-label",text);
                    }
                    //TK-1046 Ends
                } else  {
                    this._removeTableStats(view);
                }
            },

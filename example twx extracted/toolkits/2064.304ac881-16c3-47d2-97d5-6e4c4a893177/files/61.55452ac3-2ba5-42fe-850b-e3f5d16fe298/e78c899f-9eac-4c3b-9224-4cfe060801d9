                domAttr.remove(td.children[0], "data-view-managed");
                domAttr.remove(td.children[0], "data-contentboxid");

                if(views && views.length > 0) {
                    var ctx = view._instance.list.getItemContext(item);
                    ctx.expandableRowViews = views;
                }

                var rowCtx = {
                    tr: tr,
                    td: td,
                    views: views,
                    data: item,
                    index: rowIdx
                };

                if(view._instance._onExpandableRowLoadFn && view._instance._onExpandableRowLoadFn.execute) {
                    view._instance._onExpandableRowLoadFn.execute(rowCtx);

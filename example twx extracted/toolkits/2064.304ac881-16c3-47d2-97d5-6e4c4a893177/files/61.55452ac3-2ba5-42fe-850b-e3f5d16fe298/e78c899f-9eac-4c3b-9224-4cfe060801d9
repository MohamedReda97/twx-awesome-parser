            _deleteRow : function(view, ctx, skipRefresh)
            {
                var tr = ctx.tr;
                var etr = ctx.expandableTr;

                var tds = tr.childNodes;
                for(var tdIdx = 0; tdIdx < tds.length; tdIdx++)
                {
                    var td = tds[tdIdx];
                    var cs = td.childNodes;

                    for(var cIdx = 0; cIdx < cs.length; cIdx++)
                    {
                        if(domAttr.has(cs[cIdx], "data-viewid"))
                            view.context.deleteView(cs[cIdx]);
                    }
                }

                if(tr.parentNode)
                    tr.parentNode.removeChild(tr);


                //Expandable row
                if(etr) {
                	if(etr.cells[0].children[0]) {
                        view.context.deleteView(etr.cells[0].children[0]);
                    }

                    if(etr.parentNode) {
                        etr.parentNode.removeChild(etr);
                    }
                }

                //refresh the table bindings after deleting the child views
                //to avoid an infinite loop, do not do this if skipRefresh is true
                // APAR 338422 - JR61579
                //if (skipRefresh !== true) {
                //    view.context.refreshView();
                //}

                //{#bug: BG-895 Deleting rows on Table causes issues with combination of getSibling() and SUM}
                bpmext.ui.broadcastExpressionTrigger(view);
            },
            _addRow : function(view, items, recIdx)
            {
                var listItem = items.get(recIdx);
                var ctx = view._instance.list.getItemContext(listItem);
                var tbody = view._instance.table.tBodies[0];
                var tr = ctx ? ctx.tr : null;
                var etr = ctx ? ctx.expandableTr : null;
                var altIdx = ctx ? ctx.idx : null;
                var cspecs = view._instance.cspecs;

                if(!tr || tr.__bpmRefreshRow == true)
                {
                    //Add tr to table before creating views (important for certain DOM events)
                    tr = view._proto._createRow(view, listItem, recIdx);
                    tbody.appendChild(tr);

                    //Add expandable tr to table
                    if(view._instance.expandableRows) {
                        var expandableTr = view._proto._createExpandableRow(view, listItem);
                        tbody.appendChild(expandableTr);
                    }

                    //{#bug: BG-441 On Rows Loaded - "all rows loaded" flag always false}
                    view._instance.loadedRowCount++;

                    for(var cIdx = 0; cIdx < cspecs.length; cIdx++)
                    {
                        var viewTemplate = cspecs[cIdx].template;
                        if(domAttr.has(viewTemplate, "data-viewid"))
                            view._proto._addCell(view, viewTemplate, items, tr, cIdx, recIdx, altIdx);
                    }

                    if(view.context.options.showDeleteButton.get("value"))
                        this._createDeletionCell(view, listItem, tr, recIdx);

                    //{#bug: BG-895 Deleting rows on Table causes issues with combination of getSibling() and SUM}
                    bpmext.ui.broadcastExpressionTrigger(view);

                    return true;
                }
                else
                {
                    tbody.appendChild(tr);

                    if(view._instance.expandableRows && etr)
                        tbody.appendChild(etr);

                    return false;
                }
            },
            _addRowsSync : function(view, items, startIdx, count)
            {
                var tbody = view._instance.table.tBodies[0];
                var cs = view._instance.contentBoxTemplate.children;
                var maxIdx = view._instance.list.length() - 1;

                for(var recIdx = startIdx, cnt = 1; recIdx <= maxIdx && cnt <= count; recIdx++)
                {
                    this._addRow(view, items, recIdx);
                    cnt++;
                }
                view._proto._onLoadComplete(view, view._instance.loadedRowCount >= items.length());
            },
            _addRowsAsync : function(view, items, recIdx, currentCount, maxCount)
            {
                var batchSize = view.context.options.loadBatchSize.get("value");
                var maxIdx = items.length() - 1;

                for(var i = 0; recIdx <= maxIdx && i < batchSize && currentCount < maxCount; ) //i = batch size
                {
                    if(this._addRow(view, items, recIdx))
                    {
                        i++; //Only increment batch count for expensive rows (that needed to be created instead of just shown)
                    }

                    currentCount++;
                    recIdx++;
                }

                if(currentCount < maxCount && recIdx <= maxIdx)
                    setTimeout(function() {
                        view._proto._addRowsAsync(view, items, recIdx, currentCount, maxCount);
                    });
                else
                    view._proto._onLoadComplete(view, view._instance.loadedRowCount >= items.length());
            },
            _onLoadComplete : function(view, allRowsLoaded)
            {
                // {#bug: BG 493 Issue was in Portal builder having a filter called in the on Rows Loaded method, likely a problem with Table/Service Data Table too.}
                if (!view._instance.rowsLoadedRunning)
                {
                    try
                    {
                        if(view._instance._onRowsLoadedFn )
                        {
                            view._instance.rowsLoadedRunning = true;
                            view._instance._onRowsLoadedFn.execute(allRowsLoaded);
                        }
                    }
                    finally
                    {
                        view._instance.rowsLoadedRunning = false;

                        //Force DOM redraw/refresh on Safari/Mac
                        if(dojo.isSafari && view._instance.table){
                            view._instance.table.style.display = "none";
                            setTimeout(function(){
                                view._instance.table.style.display = "";
                            }, 1);
                        }
                    }
                }
            },
            _formatValue : function(view, item, value, controlType, options)
            {
                var newVal;

                //{#bug: * Options not always passed in properly}
                if(options.options)
                    options = options.options;

                switch(controlType)
                {
                    case "Checkbox":
                    case "Boolean":
                        if(options == null)
                        {
                            options = {
                                type: "check"
                            };
                        }

                        if(!options.type)
                            options.type = "check";

                        options.type = options.type.toLowerCase();

                        switch(options.type)
                        {
                            case "text":
                                if(value)
                                {
                                    newVal = options.trueValue;
                                    if(newVal === null || newVal === undefined)
                                        newVal = "Y";
                                }
                                else
                                {
                                    newVal = options.falseValue;
                                    if(newVal === null || newVal === undefined)
                                        newVal = "N";
                                }

                                break;
                            case "icon":
                                newVal = document.createElement("i");
                                var icon;

                                if(value)
                                {
                                    if(typeof options.trueValue !== "undefined")
                                    {
                                        if(options.trueValue !== "")
                                            icon = this._fixIconName(options.trueValue);
                                    }
                                    else
                                        icon = "fa-check";
                                }
                                else
                                {
                                    if(typeof options.falseValue !== "undefined")
                                    {
                                        if(options.falseValue !== "")
                                            icon = this._fixIconName(options.falseValue);
                                    }
                                    else
                                        icon = "fa-times";
                                }

                                if(icon != null) {
                                	if (icon.indexOf("ci-") == 0) {
                                    	domClass.add(newVal, "ci");
                                    	var icon = utilities.getCarbonIcon(icon);
                                    	domConstruct.place(icon, newVal);

                                	} else {
                                        domClass.add(newVal, "fa " + icon);                                	
                                	}
                                }

                                break;
                            case "check":
                            default:
                                newVal = document.createElement("i");
                                if(value)
                                    domClass.add(newVal, "fa fa-check");

                                break;
                        }

                        break;
                    case "Decimal":
                        //BG-926 returns "" instead of NaN
                        if(value == null)
                        {
                            newVal = "";
                            break;
                        }
                        if(options == null)
                        {
                            options = {
                                decimalPlaces : 2,
                                decimalSeparator : ".", //TODO - Make locale sensitive
                                thousandSeparator : "," //TODO - Make locale sensitive
                            };
                        }

                        newVal = bpmext.number.format(
                            value,
                            options.decimalPlaces,
                            options.decimalSeparator,
                            options.thousandSeparator
                            );

                        if(options.prefix != null)
                            newVal = options.prefix + newVal;

                        if(options.postfix != null)
                            newVal += options.postfix;

                        break;
                    case "Integer":
                        //BG-926 returns "" instead of NaN
                        if(value == null)
                        {
                            newVal = "";
                            break;
                        }
                        if(options == null)
                        {
                            options = {
                                thousandSeparator : "," //TODO - Make locale sensitive
                            };
                        }

                        newVal = bpmext.number.format(
                            value,
                            0,
                            null,
                            options.thousandSeparator
                            );

                        if(options.prefix != null)
                            newVal = options.prefix + newVal;

                        if(options.postfix != null)
                            newVal += options.postfix;

                        break;
                    case "Date":
                    case "Date_Picker":
                    case "Date_Time_Picker":
                        try
                        {
                            //{#bug: * Fixed cell rendering issue for date types where the date is null}
                            if(value != null)
                            {
                                if(typeof value == "string")
                                {
                                    value = utilities.stringToDate(value);
                                }

                                var dateOptions;
                                if (options.dateOptions) {
                                    dateOptions = options.dateOptions;
                                } else {
                                    var dp = options.datePattern;
                                    dateOptions = {selector: "date"};
                                    if(dp != null) {
                                        dateOptions.datePattern = dp;
                                    } else {
                                        dateOptions.fullYear = true;
                                    }
    
                                }
                                newVal = dateLocale.format(value, dateOptions);
                            }
                            else
                                newVal = "";
                        }
                        catch(e)
                        {
                            //{#feature: US-1330 Added RT localization}
                            //bpmext.log.error("Date formatting error " + e);       //BG-853
                            bpmext.log.error(bpmext.localization.formatMsg("general", "DATE_FORMAT_ERROR") + " " + e);  //BG-853
                            newVal = bpmext.text.toString(value);
                        }

                        break;
                    case "Link":
                        newVal = document.createElement("a");
                        var href = options.href;

                        if(typeof href === "undefined")
                        {
                            href = "javascript:void(0)";
                            newVal.href = href;

                            if(typeof options.onclick == "function")
                            {
                                newVal.onclick = function(evt) {
                                    options.onclick.call(view, value, {data: item});
                                };
                            }
                            else if(typeof options.onclick == "string")
                            {
                                var fn = new Function("me", "value", "row", options.onclick);
                                newVal.onclick = function(evt) {
                                    fn.call(view, value, {data: item});
                                };
                            }
                        }
                        else
                        {
                            newVal.href = href;
                        }

                        newVal.innerHTML = value;

                        break;
                    case "Text":
                    default:
                        //{#feature: * Allow specification of null value substitute through option.nullValue}
                        newVal = (value != null ? bpmext.text.toString(value) : (options.nullValue !== undefined ? options.nullValue : ""));
                }

                return newVal;
            },
            _getValue : function(varName, obj)
            {
                if(typeof obj == "object")
                {
                    var parts = varName.split(".");
                    for(var i = 0; i < parts.length; i++)
                    {
                        var varName2 = parts[i];
                        if(varName2.charAt(varName2.length - 1) == "]")
                        {
                            varName2 = varName2.substring(0, varName2.length - 2);
                        }

                        obj = obj[varName2];
                        if(obj == null)
                            break;
                    }
                }

                return obj;
            },
            _renderExpandableRowAsCV: function(view, tr, td, item, rowIdx)

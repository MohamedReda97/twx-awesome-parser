        this.constructor.prototype.view = function ()
        {
            try
            {
                this._proto._handleVisibility(this);
                this._proto._setTitle(this);
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if(e.stack) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.change = function (event)
        {
            bpmext.log.debug("change called for " + this.context.viewid + " event Type is " + event.type + " new val " + event.newVal + " Property " + event.property);
            try
            {
                if (event.type == "config")
                {
                    switch (event.property)
                    {
                        case "_metadata.label":
                        case "_metadata.labelVisibility":
                        {
                            this._proto._setTitle(this);
                            this._proto._refreshTitleHeader(this);
                            break;
                        }
                        case "_metadata.helpText":
                        {
                            this._proto._setHelpText(this, event.newVal);
                            break;
                        }
                        case "tableStyle":
                            this._proto._setTableStyle(this, event.newVal);
                            break;
                        case "_metadata.visibility":
                        {
                            this._proto._handleVisibility(this);
                            break;
                        }
                        case "colorStyle":
                        {
                            this._proto._setColorStyle(this, event.newVal);
                            break;
                        }
                        case "width":
                        {
                            this._proto._setWidth(this, event.newVal);
                            break;
                        }
                        case "height":
                        {
                            this._proto._setHeight(this, event.newVal);
                            break;
                        }
                        case "enablePaging":
                        case "pageSize":
                        {
                            this._proto._setPageSize(this, event.newVal,  event.oldVal);
                            this._proto._reloadList(this);
                            this._proto._refreshTitleHeader(this);
                            break;
                        }
                        case "selectionMode":
                        {
                            //TODO Reload table completely
                            this._instance.selMode = event.newVal;
                            this._proto._reloadHeader(this);
                            this._proto._deleteRows(this, true);
                            this._proto._initList(this);
                            break;
                        }
                        case "queryData":
                        {
                            if(!this.context.options.dataService){
                                //{#feature: US-1330 Added RT localization}
                                //throw new Error("Unsupported operation for a table not backed by a data service");
                                throw new Error(bpmext.localization.formatMsg("controlTable", "ERROR_TABLE_NOT_BACKEDBY_DATASVC"));
                            }

                            bpmext.log.debug("Query data set: " + event.newVal);    //BG-853
                            break;
                        }
                        case "highlightSel":
                        {
                            this._proto._setSelectionHighlight(this);
                            break;
                        }
                        /* {#feature: 357 enabling responsive behavior for config options} */
                        case "showFooter":
                        {
                            this._proto._refreshFooter(this);
                            break;
                        }
                        case "headerFooterStyle":
                        {
                            if (this.context.options.showDeleteButton.get("value")) {
                                this._proto._showDeleteButton(this, false);
                                this._proto._showDeleteButton(this, true);
                            }
                            this._proto._refreshTitleHeader(this);
                            this._proto._refreshAddButton(this);
                            this._proto._refreshFooter(this);
                            this._proto._reloadList(this);
                            break;
                        }   
                        case "showPager":
                        {
                            this._proto._refreshFooter(this);
                            break;
                        }
                        case "showPageSizer":
                        {
                            this._proto._refreshTitleHeader(this);
                            this._proto._refreshFooter(this);
                            break;
                        }
                        case "showTableStats":
                        {
                            this._proto._refreshFooter(this);
                            break;
                        }
                        case "showAddButton":
                        {
                            //BG-913 added case for Add button
                            this._proto._refreshFooter(this);
                            this._proto._refreshAddButton(this);
                            this._proto._refreshTitleHeader(this);
                            break;
                        }
                        case "showDeleteButton":
                        {
                            this._proto._showDeleteButton(this, event.newVal);
                            break;
                        }
                        case "columnSpecs":
                        {
                            //BG-882 added case to update changes in Columns
                            this._proto._refreshColumnSpecs(this);
                            break;
                        }
                        case "allowWrap":
                        {
                            this._proto._allowColumnHeaderWrap(this, event.newVal);
                            break;
                        }
                        case "showPopups":
                        {
                            this._proto._showPopupMenus(this, event.newVal);
                            break;
                        }
                    }
                }
                else
                {
                    /* {#bug: 571 cleaning up orphaned views on reloads} */
                    //BG-1015 added new deleteRows function to remove gc flag
                    this._proto._deleteRows(this, true);
                    //this._proto._clear(this, false); //BG-915 added gcITems flag to _clear

                    //Start BG-1079 (ED)
                    /*
                        Support changing binding from nothing to something (e.g. when a table is bound to
                        listSelected but there is originally no selection at runtime)
                    */
                    this._proto._initList(this);
                    //End BG-1079 (ED)
                }
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if(e.stack) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.validate = function(event) {
            try {
                bpmext.ui.updateViewValidationState(this, event);
                this._proto._updateValidation(this);
            } catch (e) {
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack)
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
            }
        };

        this.constructor.prototype.unload = function ()
        {
            if(this._instance.bindValueUpdHandle)
            {
                this._instance.bindValueUpdHandle.unbind();
                delete this._instance.bindValueUpdHandle;
            }

            if(this._instance.bindSelUpdHandle)
            {
                this._instance.bindSelUpdHandle.unbind();
                delete this._instance.bindSelUpdHandle;
            }

            bpmext.ui.unloadContainer(this);
        };
    }

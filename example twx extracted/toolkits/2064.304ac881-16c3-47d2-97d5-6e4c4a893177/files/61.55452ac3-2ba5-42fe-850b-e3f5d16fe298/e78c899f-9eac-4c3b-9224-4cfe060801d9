                }, selectWrapper);

                dataList.forEach(function(item, idx) {
                    var option = domConstruct.create("option", {
                        "class": "table-singleSelect-option",
                        "value": item
                    }, select);
                    option.innerText = item;
                    option.selected = (idx === 0);
                });

                select.onchange =  onChangeFn;
                
                var icon = utilities.getCarbonIcon("ci-chevron-down");
                domConstruct.place(icon, select, "after");

                var selectLabel = domConstruct.create("label", {
                    "class": "table-singleSelect-label",
                });
                selectLabel.innerText = label;
                domConstruct.place(selectLabel, selectWrapper, labelLocation === "right" ? "last" : "first");

                return selectWrapper;
            },
            _createIconButton: function(view, parent, iconName, extraClasses, onClickFn, idQualifier)
            {
                if(extraClasses == null)
                    extraClasses = "";

                var paginateButton = domConstruct.create("div", {
                    "id": "table-pagination-"+idQualifier+"-"+view.context.controlidpath,
                    "class": "paginate_button " + extraClasses,
                    "tabindex": extraClasses.indexOf("disabled") > -1 ? "-1" : "0"
                }, parent);
                paginateButton.onclick = onClickFn;
                paginateButton.onkeypress = function(event) {

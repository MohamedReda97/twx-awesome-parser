                        bpmext.log.error("  " + bpmext.localization.formatMsg("controlTable", "ERROR_AT_EXPANDABLE_ROW", rowIdx));

                        if(e.stack) {
                            bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                        }
                    }

                    if(c != null) {
                        if(typeof c == "object") {

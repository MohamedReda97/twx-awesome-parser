            _renderAsCustom: function(view, child, tr, td, items, cspec, altIdx, colIdx, rowIdx)
            {
                var item = items.get(rowIdx);
                var varName = view._instance.colToVarMap[colIdx];
                var cellCtx = {
                    //{#feature: * Added reference to table (cell.table) and td (parentNode alias -> cell.td) in cell context object for On New Cell event}
                    table: view,
                    controlType: cspec.type,
                    varName: varName,
                    value: this._getValue(varName, item),
                    colIndex: colIdx,
                    parentNode: td,
                    td : td,
                    row: {"data": items.get(rowIdx), "index": rowIdx, "setSortValue": this._setSortValue2},
                    //{#feature: * Added getFormattedValue() method to cell object to be used in On New Cell event context}
                    getFormattedValue: this._formatCellVal,
                    setSortValue: this._setSortValue1
                };

                if(view._instance._onNewCellFn && view._instance._onNewCellFn.execute)
                {
                    var c;

                    //{#feature: * Make table more resilient to programmer errors during custom cell rendering}
                    try
                    {
                        c = view._instance._onNewCellFn.execute(cellCtx);
                    }
                    catch(e)
                    {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("Error on new cell event [" + view.ui.getAbsoluteName() + "]: " + e);
                        bpmext.log.error(bpmext.localization.formatMsg("controlTable", "ERROR_ONNEWCELL_EVENT") + " [" + view.ui.getAbsoluteName() + "]: " + e);
                        //bpmext.log.error("  Cell at row " + rowIdx + ", column: " + colIdx);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("controlTable", "ERROR_AT_CELL", rowIdx, colIdx));

                        if(e.stack)
                        {
                            //{#feature: US-1330 Added RT localization}
                            //bpmext.log.error("  Call stack: " + e.stack);
                            bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                        }
                    }

                    if(c != null)
                    {
                        if(typeof c == "object")
                            td.appendChild(c);
                        else
                        {
                            var renderAs = ("" + c).toUpperCase();
                            switch(renderAs)
                            {
                                case "S": //Render as Seamless Coach View
                                    this._renderAsSeamlessCV(view, child, tr, td, altIdx, rowIdx, cspec);
                                    break;
                                case "V": //Render as Coach View
                                    this._renderAsCV(view, child, tr, td, altIdx, rowIdx, cspec);
                                    break;
                                case "H": //Render as HTML
                                    this._renderAsHTML(view, td, items, cspec, colIdx, rowIdx);
                                    break;
                                default:
                                    //{#feature: US-1330 Added RT localization}
                                    //bpmext.log.warn("Unsupported render style: " + renderAs + " - only S (seamless CV), V (regular CV), and H (html) are supported");
                                    bpmext.log.warn(bpmext.localization.formatMsg("controlTable", "UNSUPPORTED_RENDER_STYLE_WARNING", renderAs));
                            }
                        }
                    }
                }
            },
            _addCell : function(view, child, items, tr, colIdx, rowIdx, altIdx)
            {
                var tbody = view._instance.table.tBodies[0];
                var td = document.createElement("td");
                //Added for TK-1039
                var theadRowEle=view._instance.table.tHead.rows[0];
                var childTH=theadRowEle.childNodes;
                var _cellIndex=colIdx;
                if(view._instance.selMode == "M"||view._instance.selMode == "S")
                {
                    if(view._instance.expandableRows) {
                        _cellIndex=colIdx+2;
                    } else {
                        //domAttr.set(td,"headers",childTH[_cellIndex].id);
                        _cellIndex=colIdx+1;
                    }
                }

                domAttr.set(td,"headers",childTH[_cellIndex].id);
                //TK-1039 Ends

                tr.__listItem = items.get(rowIdx);
                tr.__listItemIdx = rowIdx;

                tr.appendChild(td);

                var cspec = view._instance.cspecs[colIdx];
                switch(cspec.renderAs)
                {
                    //{#feature * New capability for custom rendering to trigger built-in rendering (saves rendering work for developer) by returning "V", "S", or "H"}
                    case "S": //Render as Seamless Coach View
                        this._renderAsSeamlessCV(view, child, tr, td, altIdx, rowIdx, cspec);
                        break;
                    case "V": //Render as Coach View
                        this._renderAsCV(view, child, tr, td, altIdx, rowIdx, cspec);
                        break;
                    case "H": //Render as HTML
                        this._renderAsHTML(view, td, items, cspec, colIdx, rowIdx);
                        break;
                    case "C": //Custom cell rendering
                        this._renderAsCustom(view, child, tr, td, items, cspec, altIdx, colIdx, rowIdx);
                        break;
                }

                if(cspec.css != null)
                {
                    var pos = cspec.css.indexOf(":");
                    if(pos != -1)
                        domAttr.set(td, "style", cspec.css);
                    else
                        domClass.add(td, cspec.css);
                }

                if(!!cspec.width)
                {
                    var w = cspec.width;
                    if (!isNaN(w))
                        w += "px";
                }

                if(cspec.visibility == null)
                    cspec.visibility = "V";

                switch(cspec.visibility)
                {
                    case "V":
                        break;
                    case "R":
                        //BG-956 respond to TableColumnVisibility of "R"
                        if(td._viewRef)
                        {
                            td._viewRef.context.options._metadata.visibility.set("value","READONLY");
                        }
                        break;
                    case "N":
                    default:
                        domClass.add(td, "hide");
                }

                //TODO: Support custom cell rendering (in which case td._getData() won't always return binding value
                td.__getData = function() {
                    return (v != null ? v.context.binding.get("value") : null);
                };
            },

                                var x = (eventLocation.pageX - (view._instance.movingElement.offsetWidth / 2)) + 'px';
                                var y = (eventLocation.pageY - (view._instance.movingElement.offsetHeight / 2)) + 'px';
                                view._instance.movingElement.style.transform = "translate(" + x + ", " + y + ")";
                                // Get the element being hovered
                                var target = document.elementsFromPoint(eventLocation.clientX, eventLocation.clientY)
                                    .find(function(element) { element.getAttribute("draggable") === "true" && !element.classList.contains("clone") });
                                

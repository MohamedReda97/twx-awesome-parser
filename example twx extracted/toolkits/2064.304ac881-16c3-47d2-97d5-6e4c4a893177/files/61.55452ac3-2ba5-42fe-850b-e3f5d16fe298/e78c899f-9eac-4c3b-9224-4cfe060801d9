            _removeTableStats: function(view) {
                if (view._instance.statsLabel) {
                    domConstruct.destroy(view._instance.statsLabel);
                    delete view._instance.statsLabel;

                    if (view._instance.footer) {
                        domAttr.set(view._instance.footer,"aria-label", "");

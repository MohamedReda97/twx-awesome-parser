                if (!opts.colorStyle)
                    bpmext.ui.substituteConfigOption(this, "colorStyle", "D");

                if (!opts.width)
                    bpmext.ui.substituteConfigOption(this, "width", "");

                if (!opts.height)
                    bpmext.ui.substituteConfigOption(this, "height", "");

                if(!opts.deferLoad)
                    bpmext.ui.substituteConfigOption(this, "deferLoad", false);

                if(!opts.pageSize)
                    bpmext.ui.substituteConfigOption(this, "pageSize", 0);

                if (!opts.allowColumnResize)
                    bpmext.ui.substituteConfigOption(this, "allowColumnResize", false);

                if(!opts.loadBatchSize)
                    bpmext.ui.substituteConfigOption(this, "loadBatchSize", 1);

                //{#feature: * Removed useless/inactive search-related config options (search always available)}
                /*
                if(!opts.fullTextSearch)
                    bpmext.ui.substituteConfigOption(this, "fullTextSearch", false);

                if(!opts.enableSearch)
                    bpmext.ui.substituteConfigOption(this, "enableSearch", false);
                */


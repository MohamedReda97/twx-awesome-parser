            _createPageSizer : function(view, showAtHeader)
            {
                this._removePageSizer(view);
                
                view._instance._pageSizerEnv = document.createElement("div");
                domClass.add(view._instance._pageSizerEnv, "DT-per-page-wrapper");
                !!showAtHeader && domClass.add(view._instance._pageSizerEnv, "DT-lf-right");

                var div1 = document.createElement("div");

                domClass.add(div1, "DT-per-page");
                view._instance._pageSizerEnv.appendChild(div1);
                //Added for TK-1045. changed label to span and added id
                var span = document.createElement("span");
                var spanId=bpmext.ui.makeUniqueId("");
                domAttr.set(span,"id",spanId);

                div1.appendChild(span);

                //{#feature: US-1330 Added RT localization}
                //span.innerHTML = "Per page:";
                span.innerHTML = bpmext.localization.formatMsg("controlTable", "PER_PAGE");

                view._instance._pageSizer = document.createElement("input");
                domAttr.set(view._instance._pageSizer, "id", "table-pagesize-input-"+view.context.controlidpath);

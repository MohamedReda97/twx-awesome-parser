var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			bpmext.uidesign.css.ensureGlyphsLoaded(this);
			
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "Alerts"); 
						
			this.context.coachViewData.defaultWidth = "100%";
			var styleString = "width: " + this.context.coachViewData.defaultWidth;
			this.context.coachViewData.alertWrapper = domConstruct.create("div");
			domClass.add(this.context.coachViewData.alertWrapper, "alert-wrapper");
			this.context.coachViewData.alertDiv = domConstruct.create("div", {style: styleString, tabindex: 0});
			domClass.add(this.context.coachViewData.alertDiv, "alert");
			domClass.add(this.context.coachViewData.alertDiv, "alert-primary");//the default
			this.context.coachViewData.closeBtn = domConstruct.create("button");
			this.context.coachViewData.closeBtn.innerHTML = "×";
			domClass.add(this.context.coachViewData.closeBtn, "close");			
			this.context.coachViewData.strongTxt = domConstruct.create("strong");
			
			this.context.coachViewData.showIcon = null;
			
			var _this = this;
			bpmext.uidesign.loadLocalization(this, function(){
				_this.context.coachViewData.strongTxt.innerHTML = bpmext.localization.formatMsg("controlAlerts", "ALERT_MESSAGE");
			});
			this.context.coachViewData.spanTxt = domConstruct.create("span");
			bpmext.uidesign.loadLocalization(this, function(){
				_this.context.coachViewData.spanTxt.innerHTML = bpmext.localization.formatMsg("controlAlerts", "ALERT_DESCRIPTION");
			});
			this.context.coachViewData.alertDiv.appendChild(this.context.coachViewData.closeBtn);	
			this.context.coachViewData.alertDiv.appendChild(this.context.coachViewData.strongTxt);
			this.context.coachViewData.alertDiv.appendChild(this.context.coachViewData.spanTxt);
			this.context.coachViewData.alertWrapper.appendChild(this.context.coachViewData.alertDiv);			
			//dojo.attr(this.context.coachViewData.alertWrapper, "role", "button");
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.alertWrapper);
			
			setTimeout(function(){
				callback();
			},100);

		}));	
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){
			
			if(propertyName == "@label") {
				dojo.attr(this.context.coachViewData.alertWrapper, "aria-label", propertyValue);
			} else if(propertyName ==  "@labelVisibility"){
			
			} else if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "alertColorStyle"){
				var colorStyle;
				if(propertyValue == "P"){
					colorStyle = "alert-primary";
				} else if(propertyValue == "I"){
					colorStyle = "alert-info";
				} else if(propertyValue == "S"){
					colorStyle = "alert-success";
				} else if(propertyValue == "W"){
					colorStyle = "alert-warning";
				} else if(propertyValue == "G"){
					colorStyle = "alert-danger";
				} else {
					colorStyle = "alert-primary";
				}
				domClass.replace(this.context.coachViewData.alertDiv, colorStyle, "alert-primary alert-info alert-success alert-warning alert-danger");
				this.updateShowIcon(domClass);
			} else if(propertyName == "darkStyle"){
				if(propertyValue == true){
					domClass.add(this.context.coachViewData.alertDiv, "alert-dark");					
				} else {
					domClass.remove(this.context.coachViewData.alertDiv, "alert-dark");
				}
			} else if(propertyName == "dense"){
				if(propertyValue == true){
					domClass.add(this.context.coachViewData.containingDiv, "dense");					
				} else {
					domClass.remove(this.context.coachViewData.containingDiv, "dense");
				}
			} else if(propertyName == "animate"){
				if(propertyValue == true){
					domClass.add(this.context.coachViewData.alertWrapper, "collapse in");					
				} else {
					domClass.remove(this.context.coachViewData.alertWrapper, "collapse in");
				}
			} else if(propertyName == "showIcon") {
				this.context.coachViewData.showIcon = propertyValue;
				this.updateShowIcon(domClass);
			}
		}));	
    },	
	modelChanged: function(propertyName, propertyValue) {
				
	},
	updateShowIcon : function(domClass) {
		var alertDiv = this.context.coachViewData.alertDiv;
		if (!alertDiv) {
			return;
		}
		
		if (this.context.coachViewData.showIcon) {
			var icon_map = {
				"alert-success": "ci-checkmark-filled",
				"alert-warning": "ci-warning-filled",
				"alert-danger": "ci-error-filled"
			}
			
			var _this = this;
			var keys = Object.keys(icon_map);
			for (var i=0; i < keys.length; i++) {
				var style = keys[i];
				if (domClass.contains(alertDiv, style)) {
					// adding showIcon class
					domClass.add(alertDiv, "showIcon");
					
					// create icon wrapper only if it is not existed
					if (!_this.context.coachViewData.alertIconWrapper) {
						_this.context.coachViewData.alertIconWrapper = domConstruct.create("div");
						domClass.add(_this.context.coachViewData.alertIconWrapper, "alert-icon");
						alertDiv.appendChild(_this.context.coachViewData.alertIconWrapper);
					}
					
					// inject carbon icon only on the style changes or the first time
					if (_this.context.coachViewData.currentIconStyle !== style) {
						domConstruct.empty(_this.context.coachViewData.alertIconWrapper);
						var icon = bpmext.uidesign.svg.getCarbonIcon(icon_map[style]);
						if (icon) {
							_this.context.coachViewData.currentIconStyle = style;
							_this.context.coachViewData.alertIconWrapper.appendChild(icon);
						}
					}
					
					return;
				}
			}
		}
		
		// remove icon if it is not required
		if (domClass.contains(alertDiv, "showIcon")) {
			domClass.remove(alertDiv, "showIcon");
			if (this.context.coachViewData.alertIconWrapper) {
				domConstruct.destory(this.context.coachViewData.alertIconWrapper);
				this.context.coachViewData.alertIconWrapper = null;
			}
		}
	}
};

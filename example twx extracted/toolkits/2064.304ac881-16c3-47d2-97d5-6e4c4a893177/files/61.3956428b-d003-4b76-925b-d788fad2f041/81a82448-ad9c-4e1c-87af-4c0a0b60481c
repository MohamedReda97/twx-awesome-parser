		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;
				
				if (!this.context.binding){
					this.context.binding = bpmext.ui.substituteObject(this, null, null, undefined);
				}

				if (!opts.tabIndex)
					bpmext.ui.substituteConfigOption(this, "tabIndex", null);
					
				if (!opts.placeHolder)
					bpmext.ui.substituteConfigOption(this, "placeHolder", null);
					
				if (!opts.colorStyle)
					bpmext.ui.substituteConfigOption(this, "colorStyle", "D");

				if (!opts.sizeStyle)
					bpmext.ui.substituteConfigOption(this, "sizeStyle", "D");

				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if(!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");
				
				if(!opts.labelWidth)
					bpmext.ui.substituteConfigOption(this, "labelWidth", null);
					
				if(!opts.mask)
					bpmext.ui.substituteConfigOption(this, "mask", "");
					
				if(!opts.autoclear)
					bpmext.ui.substituteConfigOption(this, "autoclear", false);

				if(!opts.monospace)
					bpmext.ui.substituteConfigOption(this, "monospace", false);
				
				if(!opts.showOverflowTooltip)
					bpmext.ui.substituteConfigOption(this, "showOverflowTooltip", false);
				
				this._instance.group = document.createElement("div");
				domClass.add(this._instance.group, "form-group");
				this._instance.input = document.createElement("div");
				domClass.add(this._instance.input, "input");
				
				this._instance.maskedTextInputElement = document.createElement("input");
				domClass.add(this._instance.maskedTextInputElement, "form-control");
				domAttr.set(this._instance.maskedTextInputElement, "type", "text");
				domAttr.set(this._instance.maskedTextInputElement, "role", "textbox");
				domAttr.set(this._instance.maskedTextInputElement, "id", "maskedtext-input-" + this.context.controlidpath);

				this._instance.input.appendChild(this._instance.maskedTextInputElement);
				this._instance.group.appendChild(this._instance.input);
				this.context.element.appendChild(this._instance.group);

				var definitions = {};
				definitions["#"] = "[0-9]";
				definitions["a"] = "[a-z | A-Z]";
				//BG-1208 adding definition for alphanumeric characters
				definitions["*"] = "[A-Za-z0-9]";
				this._instance.textControl = new maskedtext({definitions: definitions, autoclear : opts.autoclear.get("value")}, this._instance.maskedTextInputElement);
				this._instance.textControl.mask(opts.mask.get("value"));
				
				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					null,
					this.getText
				);
				
				bpmext.ui.loadView(this);

				this._instance.vc = bpmext.ui.getNearestValidationContainer(view);
				
				this._proto._setMonospace(this);
				this._proto._setSizeStyle(this, opts.sizeStyle.get("value"));
				this._proto._setLabelVisibility(this, opts._metadata.labelVisibility.get("value"));
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));
				this._proto._setPlaceholder(this, opts.placeHolder.get("value"));
				this._proto._setWidth(this, opts.width.get("value"));
				if(this._proto._setText(this, this.context.binding.get("value")))
					this._proto._updateControl(this);
				
				var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}
				
				this._proto._setTabIndex(this, opts.tabIndex.get("value"));
				
				var view = this;				
				if(opts[this._proto.EVT_ONCHANGE])
				{
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGE, "newText", "oldText");
				}

				this._instance.maskedTextInputElement.onchange = function(event)
				{
					if(view._proto._checkContentValid(view))	
						view.context.binding.set("value", this.value);
				}
				
				if(opts[this._proto.EVT_ONFOCUS])
				{
					this._instance.maskedTextInputElement.onfocus = function(event)
					{
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONFOCUS);
					}
					
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONFOCUS);
				}
				
				if(opts[this._proto.EVT_ONBLUR])
				{
					this._instance.maskedTextInputElement.onblur = function(event)
					{
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONBLUR);
					}
					
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONBLUR);
				}
				
				if(opts[this._proto.EVT_ONINPUT])
				{
					var onInput = opts[this._proto.EVT_ONINPUT] != null;
					var text1 = this._instance.maskedTextInputElement;
					var view = this;
					var sel;
					var state = {
						current: text1.value,
						potential: void 0
						};
						
					var redo;
					var undo;					
					
					this._instance.maskedTextInputElement.onkeydown = function(event)
					{
						redo = false;
						undo = false;

						if (event.key === "z" && event.ctrlKey) //Ctrl-Z
						{
							redo = true;
							state.current = text1.value;
							sel.start = 0;
							sel.end = 0;
							setTimeout(function(){
								view._proto._handleInput(view, onInput, text1, state, sel, "undo");
							});
						}
						else if(event.key === "y" && event.ctrlKey) //Ctrl-Y
						{
							undo = true;
							state.current = text1.value;
							sel.start = 0;
							sel.end = 0;
							
							setTimeout(function(){
								view._proto._handleInput(view, onInput, text1, state, sel, "redo");
							});
						}
						else
						{
							sel = view._proto._getSelection(text1);
						}
					}
					
                    //BG-1010 added event listener for keypress to fire onselect in IE11
                    if (navigator.userAgent && navigator.userAgent.indexOf("Trident") > 0)
                    {
                        //BG-1010 added event listener for keypress to fire onselect in IE11
                        this._instance.maskedTextInputElement.addEventListener("keypress", function(event)
                        {                           
                            this.onselect.apply();
                        });
                        //BG-1096 adding keydown listener to account for backspace
                        this._instance.maskedTextInputElement.addEventListener("keydown", function(event)
                        {
                            if (event.key === "Delete" || event.key === "Backspace") //BG-1105 added delete key also
                                this.onselect.apply();
                        });
                        //BG-1033 added event listener for paste to fire onselect in IE11
                        this._instance.maskedTextInputElement.addEventListener("paste", function(event)
                        {
                            var input1 = this;
                            setTimeout(function(){input1.onselect.apply();},100);
                        });
                        //BG-1097 added event listener for cut to fire onselect in IE11
                        this._instance.maskedTextInputElement.addEventListener("cut", function(event)
                        {
                            var input1 = this;
                            setTimeout(function(){input1.onselect.apply();},100);
                        });
                    }

                    this._instance.maskedTextInputElement.onselect = function(event)
					{
						if(redo || undo)
							return;

						state.potential = text1.value;

						if(state.current != state.potential)
						{
							view._proto._handleInput(view, onInput, text1, state, sel, "change");
						}

						state.potential = null;
					}					
					
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONINPUT, "current", "potential", "selection", "type");
				}

				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSCLICK);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 

		{
			this._instance.textControl.unmask();
			if (this._instance.overFlowtextTT) {
				bpmext.ui.util.closeTooltip(this._instance.overFlowtextTT, this._instance.input);
				delete this._instance.overFlowtextTT;
			}
			bpmext.ui.unloadView(this);
		};

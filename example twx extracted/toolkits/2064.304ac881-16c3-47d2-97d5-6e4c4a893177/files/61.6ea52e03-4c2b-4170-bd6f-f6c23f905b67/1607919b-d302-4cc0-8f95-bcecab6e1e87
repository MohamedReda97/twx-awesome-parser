/**
 * @file SPARK - SingleSelect Control
 */

/** 
 * @constructor SingleSelect
 * @desc This constructor is <i>never</i> used explicitly.
 * @augments com.ibm.bpm.coach.CoachView 
 * @classdesc A SingleSelect control is used when you want a user to select only one item from a list. By default, the Single Select uses value as it's display property.<br>A SingleSelect control provides the following configuration properties in Process Designer:
 * <table class=Config>

 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setServiceInputData({"Default"})</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 
 *   <tr class=Prop>
 *     <td>On Service Items:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when AJAX Service returns item list. Only triggers if Item lookup Mode is set to Items From Service.</td>
 *         </tr>
 
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${SingleSelect2}.clearItems()</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 
 *   <tr class=Prop>
 *     <td>On Service Error:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when AJAX selection service returns an error. Will not trigger if Item Lookup Mode is not set to Items From Service.</td>
 *         </tr>
 
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.clearItems();console.log("Error in SingleSelect1")</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 
 *   <tr class=Prop>
 *     <td>On Change:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when the bound data changes.</td>
 *         </tr>
 
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${SingleSelect2}.reloadServiceItems(me.getSelectedItem())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 
 * </table>
 */
 bpmext_control_InitSingleSelect = function (bpmext, utilities, domClass, domAttr, domConstruct, domGeometry, json)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE",
			EVT_ONFOCUS : "eventON_FOCUS",
			EVT_ONBLUR : "eventON_BLUR",
			EVT_ONSVCITEMS : "eventON_SVCITEMS",
			EVT_ONSVCERROR : "eventON_SVCERROR",
			_getItemIndex : function (view, value)
			{
				// DEC2016 CHANGE to use _instance.itemList instead of _instance.select.options
				// itemList is the true list of items... select.options always contains the placeholder
				if(view._instance.itemList.items)
				{
					for(var i = 0; i < view._instance.itemList.items.length; i++)
					{

						if (value ==  view._instance.itemList.items[i][view._instance._optValProp] )
							return i;
					}
				}
				return -1;
			},
			_getItemOption : function (view, index)
			{
				if(view._instance.select.options)
					return view._instance.select.options[index];
			},
			//{#feature: * Allow leniency for mapping complex-typed items list element to simple-typed bound data}
			_mapBindingValue : function(view, value)
			{
				if(value != null)
				{
					if(view.isBound() && view.context.bindingType)  
					{
						//{#bug: * update with fixes for binding issues }
						var bType = view.context.bindingType().toUpperCase();
						if ( (bType == "STRING")  || (bType == "INTEGER") || (bType == "DECIMAL") || (bType == "BOOLEAN") || (bType == "") )		//jmacSEL
						{
							var typeOfItem;
							if (value[view._instance._optValProp] != undefined)
								typeOfItem = typeof value[view._instance._optValProp];
							else
								typeOfItem = typeof value;
							
							var value2;
							
							if(typeOfItem == "number")
							{
								if (value[view._instance._optValProp] != undefined)
								{
									value2 = value[view._instance._optValProp];
									value = value2;
								}
							}
							else // store as string
							{
								if (value[view._instance._optValProp] != undefined)
									value2 = value[view._instance._optValProp] + "";
								else
									value2 = value + "";
								value = value2;
							}
						}
					}
				}

				return value;
			},
			_setSelectedItemByIndex : function(view, idx)		//jmacSEL
			{
				if (idx != null) {
					view._instance.select.selectedIndex = idx + 1;
					domClass.remove(view._instance.select, "placeHolder");
				} else {
					//BG-1013 Index should default to placeholder
					view._instance.select.selectedIndex = 0;
					//view._instance.select.selectedIndex = -1;
					if (view._proto._hasPlaceholder(view)) {
                    domClass.add(view._instance.select, "placeHolder");
				}
				}
			},
			_setSelectedItem : function (view, value)
			{

				var hit = false;
				
				for(var i = 0; i < view._instance.select.options.length; i++)
				{
					var opt = view._instance.select.options[i];

					if(opt.value == value)
					{
						view._instance.select.selectedIndex = i;
						domClass.remove(view._instance.select, "placeHolder");
						//domAttr.set(opt, "selected", "selected");
						hit = true;
						break;
					}
					else
					{
						//domAttr.remove(opt, "selected");
					}
				}
				
				if(!hit)
				{
					//BG-1013 set index to placeholder whether blank or not
					view._instance.select.selectedIndex = 0;
					if (view._proto._hasPlaceholder(view)) {
                    domClass.add(view._instance.select, "placeHolder");
					}
					/*var ph = view.context.options.placeHolder.get("value");
					if(ph != null && ph.length > 0)
					{
						view._instance.select.selectedIndex = 0;
					}
					else
					{
						view._instance.select.selectedIndex = -1;
//						debugger;
					}*/
				}
			},
			_appendOption : function(view, key, value)
			{
				if(view.context.itemCount===null || view.context.itemCount===undefined){
					view.context.itemCount=0;
				}
				
				var opt = document.createElement("option");
				domAttr.set(opt, "id", "singleselect-option-" + view.context.controlidpath + "[" + view.context.itemCount + "]");
				view.context.itemCount++;
				domAttr.set(opt, "value", key);
				//Added for TK-1069
				domAttr.set(opt,"aria-selected","false");
				//Ends
				
				//{#feature: US-1036 Allow entries to start with spaces to facilitate options indenting}
				value = view.context.htmlEscape(value);
				
				if(value[0] === " ")
				{
					var value2 = "";
					
					for(var i = 0; i < value.length; i++)
					{
						if(value[i] == " ")
							value2 += "&#160;";
						else
							value2 += value[i];
					}
					
					value = value2;
				}
				
				opt.innerHTML = value;
				utilities.BiDi.applyTextDir(opt, opt.innerHTML, view._instance.baseTxtDir, view._instance.genPrefTextDir);
				view._instance.select.appendChild(opt);
				
				return opt;
			},
			_rebindAllUpdates : function(view)
			{
				
			},		
			_updateItemList : function(view, event, itemList) 
			{
				var selOpt;
				if(event.insertedInto >= 0 && event.insertedInto != event.removedFrom)
				{
					view._proto._rebindAllUpdates(view);

					if(event.insertedInto == view._instance.select.options.length - 1) //If inserted at the end (-1 offset to account for placeholder option)
					{
						var item = event.newVal;
						selOpt = view._proto._appendOption(view, item[view._instance._optValProp], item[view._instance._optDisProp]);
						var tstOptValue;	// NOV 2016
						if (view.context != null && view.context.binding != null) {
							if (view._instance._isSimpleBinding)
								tstOptValue = view.context.binding.get("value");
							else
								tstOptValue = view.context.binding.get("value")[view._instance._busValProp];
						}
						if (selOpt.value == tstOptValue)
							selOpt.selected = true;
					}
					else
					{
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("Mid-list inserts not supported by Coach NG API yet");
						bpmext.log.error(bpmext.localization.formatMsg("general", "MID_LIST_INSERT_COACH_NG_ERROR"));
					}
				}
				else if(event.removedFrom >= 0 && event.removedFrom != event.insertedInto) //List item deletion
				{
					view._proto._rebindAllUpdates(view);  


					//#{bug: BG-377 updated to use 0 based index}
					//var selOpt = view._instance.select.options[event.removedFrom];
					selOpt = view._instance.select.options[event.removedFrom + 1];
					
					if(selOpt != undefined)
					{
						selOpt.parentNode.removeChild(selOpt);

						if (selOpt.selected)	// Dec 2016 Deal with removing curently selected Item
						{
							selOpt.selected = false;
							view.setSelectedItem(null);
						
						}

					}
				}
				else if(event.removedFrom >= 0 && event.removedFrom == event.insertedInto)//Just a value change...
				{
					if(event.newVal != null)
					{
						selOpt = view._instance.select.options[event.removedFrom + 1];		// DEC 2016 added the +1 
						selOpt.value = event.newVal[view._instance._optValProp];
						selOpt.innerHTML = event.newVal[view._instance._optDisProp];
						utilities.BiDi.applyTextDir(selOpt, selOpt.innerHTML, view._instance.baseTxtDir, view._instance.genPrefTextDir);
					}
				}
				else if(event.removedFrom == undefined && event.removedFrom == event.insertedInto ) // whole new list
				{
					if (event.newVal != null)
					{
						view._instance.itemList = view.context.options.itemList.get("value");
						view._proto._loadListItems(view, view._instance.itemList, view.context.binding.get("value"), view._instance._optValProp, view._instance._optDisProp, view._instance._busValProp, view._instance._busDisProp );						
						//view._proto._loadListItems(view, view._instance.itemList, event.newVal);				
					}
				}	
//				if (view.getSelectedIndex() != -1) 
				if (selOpt != undefined && selOpt.selected == true)			//DEC 2016
				{
					if (view._instance._isSimpleBinding)
						view.setSelectedItem(view._instance.select.value);
					else
					{
						var tObj = {};
						tObj[view._instance._busValProp] = selOpt.value;
						tObj[view._instance._busDisProp] = selOpt.innerHTML;
						view.setSelectedItem(tObj);
					}
				}
				
			},
			_loadListItems : function(view, itemList, selectedValue, keyProp, valueProp, busKeyProp, busValueProp)
			{
				var boundToObject = (typeof selectedValue == "object" ? true : false);

				if(view._instance._bindSelUpdHandle)
					view._instance._bindSelUpdHandle.unbind();

				if(view._instance._bindValueUpdHandle)
					view._instance._bindValueUpdHandle.unbind();
				
				if(keyProp == null)
					keyProp = "name";
				
				if(valueProp == null)
					valueProp = "value";
				
				if(busKeyProp == null)
					busKeyProp = "name";
				
				if(busValueProp == null)
					busValueProp = "value";
				
				view._instance._bindValueUpdHandle = itemList.bindAll
				(
					function(event)
					{
						view._proto._updateItemList(view, event,itemList);
					}, 
					view
					);
				view._instance.select.innerHTML = "";
				
				var ph = view.context.options.placeHolder.get("value");
				if(ph == null)
					ph = "";

				var dopt = document.createElement("option");
				view._instance.placeHolderOption = dopt;
				//Added for TK-1069
				domAttr.set(dopt,"aria-selected","false");

				//Ends
				dopt.innerHTML = view.context.htmlEscape(ph);
				utilities.BiDi.applyTextDir(dopt, dopt.innerHTML, view._instance.baseTxtDir, view._instance.genPrefTextDir);
				view._instance.select.appendChild(dopt);

				var items = itemList.items;
				var itemsIsObject = (items[0] != undefined) && (typeof items[0] == "object");	// bug 860
				var viewId = view.context && view.context.viewid ? view.context.viewid : "UNKNOWN";
				bpmext.log.debug("For view [" + viewId + "]\tItem list is " 
					+ (itemsIsObject ? "object" : "scalar") + "\n\tBound variable is " 
					+ (boundToObject ? "object" : "scalar") );
				//#{bug: BG491 issue when binding to complex types setting the selected item.}
				var selectedText;
				if ( (selectedValue != undefined) && (typeof selectedValue == "object") )
				{
					selectedText = selectedValue[busValueProp];  // added Nov 2016
					selectedValue = selectedValue[busKeyProp];
				}
				else if ( (selectedValue != undefined) && (typeof selectedValue != "object") )
				{
					selectedText = undefined;
					// have to settle for the first match.  No other way around this.  Nov 2016
					for (var i = 0; i < items.length; i++)
					{
						//{#bug:860 - during Nov/Dec 2016 updates we lost the code for when the list is simple type}
						
						if (itemsIsObject)
						{	// item list is an array of complex types
							if (selectedValue == items[i][keyProp])
							{
								selectedText = items[i][valueProp];
							}
						}
						else
						{	// item list is an array of simple types
							if (selectedValue == items[i])							
							{	
								selectedText = items[i];							
							}	
						}
						
					}

				}
				//BG-1013 default selected index to 0
				view._instance.select.selectedIndex = 0;
				if (view._proto._hasPlaceholder(view)) {
                domClass.add(view._instance.select, "placeHolder");
				}
				for(var i = 0; i < items.length; i++)
				{
					var opt;
					//{#bug: * changed how lists of objects are differentiated from lists of simple types to avoid issues with objects that contain falsy values}
					if (Object.prototype.toString.call(items[i]) === "[object Object]" && Object.prototype.toString.call(items[i]) !== "[object Null]" && Object.prototype.toString.call(items[i]) !== "[object Date]") {
						// if (/*items[i][keyProp] != undefined && items[i][keyProp] != null &&*/ items[i][valueProp] != undefined && items[i][valueProp] != null)
						opt = this._appendOption(view, items[i][keyProp], items[i][valueProp]);
					} else if (Object.prototype.toString.call(items[i]) !== "[object Null]")
					// {feature: 156 allow config option to be list of simple types }
						opt = this._appendOption(view, items[i], items[i]);
				
					//if ( (selectedValue != undefined) && (opt.value == selectedValue.toString()) ) Nov 2016
					//BG-939 added unescape to prevent HTML escape on special characters
					// var displayText = opt ? bpmext.text.unescapeHTML(opt.innerHTML) : null;
					// if ( (selectedText != undefined) && (displayText == selectedText.toString()) )
					if ((itemsIsObject && (selectedValue != undefined) && (items[i][keyProp] == selectedValue.toString()))
						|| (!itemsIsObject &&  (selectedValue != undefined) && (items[i] == selectedValue.toString())))
					{
						view._instance.select.selectedIndex = i + 1;
                        domClass.remove(view._instance.select, "placeHolder");
                        domAttr.set(opt,"aria-selected","true");
					}
				}

				setTimeout(function(){
                    //BG-1076 adding defensive code for unloaded view
                    if(view.context == null || view.context.binding == null)
                        return;
                    
					//Refresh selected value because setTimeout is async
					selectedValue = view.context.binding.get("value");
					
					//{#bug: 453 Fix intermittent issue erroneously displaying a selection when the control first displays} 
					if(selectedValue == null || selectedValue === "")  // NOV 2016
						domAttr.set(dopt, "selected", "");

					domAttr.set(dopt, "disabled", "");
					domAttr.set(dopt, "style", "display:none");
					//Added for TK-1069
					domAttr.set(dopt, "aria-hidden", "true");
					//Ends
				});	

			view._instance._bindSelUpdHandle = itemList.bind(
					"listAllSelectedIndices", 
					function(event)
					{
						var idxs = event.newVal;
						if (idxs == null)
							idxs = [];
						var idx = idxs.length > 0 ? idxs[0]: null;
						view._proto._setSelectedItemByIndex(view, idx);		// jmacSEL
						//view._proto._setSelectedItem(view, itemKey);
					}, 
					view
					);
			},
			_updateControl : function (view)
			{
				var errors = bpmext.ui.getViewValidationErrors(view);
				
				//Color style
				var colStyle = errors ? "E" : view.context.options.colorStyle.get("value");
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_COL_STL_CLZ, colStyle, view._instance.oldColStyle);
				view._instance.oldColStyle = colStyle;
				
				//Validation Error Icon
				if(view._instance.icon)
				{
					bpmext.ui.util.closeTooltip(view._instance.iconTT, view._instance.input);
					delete view._instance.iconTT;
					
					view._instance.input.removeChild(view._instance.icon);
					delete view._instance.icon;
				}
				
				if(errors)
				{
					domClass.add(view._instance.group, "has-feedback has-error");
					view._instance.icon = document.createElement("span");
					view._instance.input.appendChild(view._instance.icon);
					domClass.add(view._instance.icon, "fa form-control-feedback fa-exclamation-circle");
					
					var ttOpts = {
							horizontalPos: "right", 
							verticalPos: "top",
							cssClass: "validationError",
							plainText: false,
							smartPositioning: true
						};
					
					view._instance.iconTT = bpmext.ui.util.showTooltip(
						view._instance.input, 
						bpmext.ui.util.formatErrors(errors), 
						ttOpts
						);

					view._instance.errorMessage = document.createElement("div");
					view._instance.errorMessage.id = view._instance.input.firstElementChild.id + "-error-msg";
					view._instance.errorMessage.classList.add("hide");
					view._instance.errorMessage.innerHTML = bpmext.ui.util.formatErrors(errors);
					view._instance.input.appendChild(view._instance.errorMessage);
					domAttr.set(view._instance.input.firstElementChild, "aria-describedby", view._instance.errorMessage.id);
					domAttr.set(view._instance.input.firstElementChild, "aria-invalid", "true");
				}
				else
				{
					domClass.remove(view._instance.group, "has-feedback has-error");
					if (view._instance.errorMessage) { view._instance.errorMessage.remove(); }
					domAttr.remove(view._instance.input.firstElementChild, "aria-describedby");
					domAttr.remove(view._instance.input.firstElementChild, "aria-invalid");				
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			_setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else 
				{
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}
					
					domClass.remove(view.context.element, "labelWidth");
				}
					
			},	
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(view._instance.label)
						view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("SingleSelect._setLabelVisibility() error: " + e);
					bpmext.log.error("SingleSelect._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_createLabel : function (view)
			{
				//changing label to span : TK-1069
				view._instance.label = document.createElement("span");
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.group, "first");
				//Added for Tk-1069
				//domAttr.set(view._instance.label, "for", view._instance.select.id);	
				var lblId="lbl_"+bpmext.ui.makeUniqueId("");
				domAttr.set(view._instance.label, "id", lblId);
				domAttr.set(view._instance.select, "aria-labelledby", lblId);
				//ends
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
				
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						if(view._instance.label)
						{
							view._instance.group.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("SingleSelect._setLabel() error: " + e);
					bpmext.log.error("SingleSelect._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHelpText : function (view, text)
			{
				utilities.setHelpText(view, text);
			},
			_setSizeStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldSzStyle;

				newVal = bpmext.ui.util.normalizeSizeStyle(newVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);
				oldVal = bpmext.ui.util.normalizeSizeStyle(oldVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);
				
				bpmext.ui.util.replaceCSSClass(view._instance.select, bpmext.ui.util.OPTS_SZ_STL_CLZ, newVal, oldVal);
				view._instance.oldSzStyle = newVal;
				
				bpmext.ui.util.propagateUpSizeStyle(view, newVal);
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;
						
						domClass.add(view.context.element, "widthSet");
					}
					else
					{
						view.context.element.style.width = null;

						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("SingleSelect._setWidth() error: " + e);
					bpmext.log.error("SingleSelect._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},			
			_setTabIndex : function (view, index)
			{
				if(index != null)
					domAttr.set(view._instance.select, "tabindex", index);
				else
					domAttr.remove(view._instance.select, "tabindex");
			},
			_handleVisibility : function (view)
			{
				var vis = utilities.handleVisibility(view.context);
				
				if (vis != "NONE") {
					view._instance.select.disabled = (vis === "READONLY");
					if (!view._instance.label)
						return;
					if (vis === "READONLY")
						domClass.add(view.context.element, "disabled");
					else
						domClass.remove(view.context.element, "disabled");
					
					// Updates for WAI
					if (view._instance.select.disabled) {										
						domAttr.set(view._instance.select, "aria-disabled", "true");
					} else {					
						domAttr.remove(view._instance.select, "aria-disabled");
					}
				}
			},
			_checkBindingType : function (view) 
			{
				if (!view.context.binding)
				{
					view._instance.bindingExists = false;
					view._instance._isSimpleBinding = true;				//jmacSEL
					view.context.binding = bpmext.ui.substituteObject(view, null, null, null);
				}
				else if (!view.context.binding._spliced)  // when true everything has been set.													// jmacSEL													// jmacSEL
				{
					view._instance.bindingExists = true;
					view._instance._isSimpleBinding = false;
					var boundType = view.context.bindingType().toUpperCase();
					if ( (boundType == "STRING") || (boundType == "INTEGER") || (boundType == "DECIMAL") || (boundType == "BOOLEAN") )
						view._instance._isSimpleBinding = true;
					else
					{
						var opts = view.context.options;
						if (opts.businessDataMapping)
						{
							var dm = opts.businessDataMapping.get("value");
							view._instance._busValProp = (dm.optionValueProperty ? dm.optionValueProperty : "name" );
							view._instance._busDisProp = (dm.optionDisplayProperty ? dm.optionDisplayProperty : "value");
						}
						else
						{
							view._instance._busValProp = "name";
							view._instance._busDisProp = "value";							
						}
					}
				}
			},
			_hasPlaceholder : function(view) {
			    return (!!view.context.options.placeHolder && !!view.context.options.placeHolder.get("value"));
			}
		};


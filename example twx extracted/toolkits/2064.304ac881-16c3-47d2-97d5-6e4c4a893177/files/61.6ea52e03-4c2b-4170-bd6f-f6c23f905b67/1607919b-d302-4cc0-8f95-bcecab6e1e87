		this.constructor.prototype.unload = function ()
		{
			if(this._instance._bindSelUpdHandle)
				this._instance._bindSelUpdHandle.unbind();

			if(this._instance._bindValueUpdHandle)
				this._instance._bindValueUpdHandle.unbind();
			
			bpmext.ui.unloadView(this);
		};
	}

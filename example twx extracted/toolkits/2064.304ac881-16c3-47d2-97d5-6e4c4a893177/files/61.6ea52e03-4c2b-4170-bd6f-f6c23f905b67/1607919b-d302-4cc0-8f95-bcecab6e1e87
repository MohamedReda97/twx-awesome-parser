		/**
		 * @instance
		 * @memberof SingleSelect
		 * @method reloadServiceItems
		 * @param {ANY} input Data to be passed to the AJAX Service retrieving the items for the control 
		 * @desc Reloads the AJAX selection list
		 */
		this.constructor.prototype.reloadServiceItems = function(input)
		{
			if(input === undefined)
				input = this.context.options.inputData.get("value");

			// {bug: 540 error passing in complex data }
			// Updated as per Erics Email for BUG FIX
			if ( (input != null) && (typeof input == "object") && input.toJson)
     		input = json.parse(input.toJson());


			
			input = {"data": input};
			var view = this;
			var viewId = view.context.viewid;
			
			var sargs = {
				params: input,
				load: function(data) {
					try
					{
						domClass.remove(view._instance.input, "spin");
						//"results" is the name of the ouput of the AJAX service
						if(data.results)
						{
							delete data.results["@metadata"];
							// {bug: 854 wierd javascript error when a simple type is returned as a list of 1 item and the value is "1" }
							if ( (data.results.items.length > 0) && (typeof data.results.items[0] != "object") )
							{
								var nvps = [];
								for (var i = 0; i < data.results.items.length; i++)
								{
									var obj = {};
									obj[ view._instance._optValProp] = data.results.items[i];
									obj[ view._instance._optDisProp] = data.results.items[i];
									nvps[i] = obj;

								}
								data.results.items = nvps;
							}
							if(data.results.items)
							{
								view._instance.itemList = new com.ibm.bpm.coach.List(data.results.items, "svc.items");
								//{#bug: * Fixed data mapping for AJAX services (previously data mappings weren't read correctly)}
								view._proto._loadListItems(view, view._instance.itemList, view.context.binding.get("value"), view._instance._optValProp, view._instance._optDisProp, view._instance._busValProp, view._instance._busDisProp);
								
								if(!view.context.binding.get("value") && data.results.selected && data.results.selected.length) {
									view._proto._setSelectedItemByIndex(view, data.results.selected[0]);
								}
							}
						}
						
						//console.log("Service returned: " + bpmext.text.toString(data));
						setTimeout(function(){
							bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSVCITEMS);
						});
					}
					catch (e) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("Error on AJAX item list fetching [" + view.context.viewid + "]: " + e);
						bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONAJAX_ITEMLIST_FETCH") + " [" + viewId + "]: " + e);
						if(e.stack) { 
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.error("  Call stack: " + e.stack);
							bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
						}
					}							
				},
				error: function(error) {
					try
					{
						domClass.remove(view._instance.input, "spin");
						//console.log("Service returned w/ error");
						
						//TODO Show error on control?
						setTimeout(function(){						
							bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSVCERROR);
						});
					}
					catch (e) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("Error on AJAX item list fetching [" + view.context.viewid + "]: " + e);
						bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONAJAX_ITEMLIST_FETCH") + " [" + viewId + "]: " + e);
						if(e.stack) { 
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.error("  Call stack: " + e.stack);
							bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
						}
					}
				}
			};

			domClass.add(this._instance.input, "spin");
			this.context.options.itemService(sargs);			
		};
		

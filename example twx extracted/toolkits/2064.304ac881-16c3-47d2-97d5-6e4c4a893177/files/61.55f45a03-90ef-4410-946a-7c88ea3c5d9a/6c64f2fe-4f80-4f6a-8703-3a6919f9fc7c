 bpmext_control_InitPlaces = function (utilities, bpmext, domClass, domAttr, domConstruct)
 {
	this._instance =
	{
	}; 
	
	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONPLACES : "eventON_PLACES",
			EVT_ONPLACESERR : "eventON_PLACESERR",
			_resolvePlace : function(view, latitude, longitude, search)
			{
				var url = 'https://nominatim.openstreetmap.org/search?q='+search.types+'%20'+latitude+','+longitude+'&format=json&namedetails=1&addressdetails=1&extratags=1&limit=100';
				
				// overpass API - can search by radius in meters. Less data on return.
				//var url = 'https://overpass-api.de/api/interpreter?data=[out:json];node[amenity='+search.types+'](around:'+search.radius+','+latitude+','+longitude+');out;';
				
				
				var results = [];
				
				var getDistance = function(lat1, lon1, data){
					var R = 6371000; // metres
					var lat1rad = toRad(lat1);
					var lat2rad = toRad(data.lat);
					var latdiff = toRad(data.lat-lat1);
					var londiff = toRad(data.lon-lon1);

					var a = Math.sin(latdiff/2) * Math.sin(latdiff/2) +
							Math.cos(lat1rad) * Math.cos(lat2rad) *
							Math.sin(londiff/2) * Math.sin(londiff/2);
					var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));

					var d = R * c;
					
					//return d;
					if(d < search.radius){
						var obj = {};
						var latlon = [data.lat, data.lon];
								
						obj.html_attributions = [];
						obj.address_components = [
							{
								long_name: data.address.house_number,
								short_name: data.address.house_number,
								types: ["street_number"]
							},
							{
								long_name: data.address.road,
								short_name: data.address.road,
								types: ["route"]
							},
							{
								long_name: data.address.city,
								short_name: data.address.city,
								types: ["locality"]
							},
							{
								long_name: data.address.country,
								short_name: data.address.country,
								types: ["country"]
							},
							{
								long_name: data.address.postcode,
								short_name: data.address.postcode,
								types: ["postal_code"]
							}
						];
						obj.formatted_address = [data.address.house_number, data.address.road, data.address.city, data.address.county, data.address.state, data.address.postcode, data.address.country].filter(function(val){return val;}).join(', ');
						obj.formatted_phone_number = [data.extratags.phone].filter(function(val){return val;});
						obj.geometry = {
							location: {
								lat: data.lat,
								lng: data.lon
							}
						}
						obj.icon = [data.icon].filter(function(val){return val;});
						obj.id = [data.osm_id].filter(function(val){return val;});
						// international number?
						obj.name = [data.namedetails.name].filter(function(val){return val;});
						obj.opening_hours = [data.extratags.opening_hours].filter(function(val){return val;});
						obj.type = [data.type].filter(function(val){return val;});
						
						obj.vicinity = [data.address.house_number, data.address.road, data.address.city].filter(function(val){return val;}).join(', ');
							
						obj.website = [data.extratags.website].filter(function(val){return val;});			
						
						results.push(obj);	
							
					}
				}
				
				function toRad(Value) {
					/** Converts numeric degrees to radians */
					return Value * Math.PI / 180;
				}
				var getJSON = function(url) {
					return new Promise(function(resolve, reject) {
						var xhr = new XMLHttpRequest();
						xhr.open('get', url, true);
						xhr.responseType = 'json';
						xhr.onload = function() {
							var status = xhr.status;
							if (status == 200) {
								resolve(xhr.response);
							} else {
								reject(status);
							}
						};
						xhr.send();
					});
				};
				getJSON(url).then(function(data) {
						
					for(var i = 0; i < data.length; i++){
						
						getDistance(latitude, longitude, data[i]);
					}
					view._instance.curPlaces = results;
					bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONPLACES, results);
							
				}, function(status) { //error detection....
					console.log('Something went wrong.');
					//{#feature: US-1330 Added RT localization}
					//bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONPLACESERR, {message: "No places at location", code: -2, status: status});
					bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONPLACESERR, {message: bpmext.localization.formatMsg("controlPlaces", "NO_PLACES_AT_LOCATION"), code: -2, status: status});
				});	
				
			}
		}
		/*
		Public control methods *************************************************************
		 */

		/**
		 * @instance
		 * @memberof Places
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "places.3";
		}
		
		/**
		 * @instance
		 * @memberof Places
		 * @method requestNearbySearch
		 * @desc Get the different location that was previously requested
	     * @param {decimal} latitude the latitude of the location
		 * @param {decimal} longitude the longitude of the location
		 * @param {object} search this object contains the items radius and types of businesses that you are searching for. Max radius is 15km.  For acceptable types, see <a href="http://wiki.openstreetmap.org/wiki/Nominatim/Special_Phrases/EN">Place Types</a>
		 * @example var aPlace = page.ui.get("Places1");  aPlace.requestNearbySearch(38.577523, -121.463390, {radius: 10000, types:["bank"]}, true);  //Places Types are located at: http://wiki.openstreetmap.org/wiki/Nominatim/Special_Phrases/EN
		 */
		this.constructor.prototype.requestNearbySearch = function(latitude, longitude, search)
		{
			this._proto._resolvePlace(this, latitude, longitude, search);
		}
		/**
		 * @instance
		 * @memberof Places
		 * @method getLastPlacesInfo
		 * @desc Get the different location that was previously requested.
		 * @returns {Object[]} returns a list of Objects that contains the different location that was previously requested.
		 * <table class=Config>
		 *   <tr class=Prop>
		 *     <td class=SectionName colspan=3>JSON Structure of the Object</td>
         *   </tr>
		 *   <tr>
		 * <td> 
		  { </br>
		  "geometry": {},</br>
		   &nbsp	 &nbsp	 &nbsp  "location" : {</br>
			   &nbsp	 &nbsp	 &nbsp &nbsp	 &nbsp	 &nbsp "A": -- , </br>
			   &nbsp	 &nbsp	 &nbsp &nbsp	 &nbsp	 &nbsp "F":-- </br>
		   &nbsp	 &nbsp	 &nbsp }
			 &nbsp	 &nbsp </br>},
			</br>	
			  "html_attributes": {</br>
			&nbsp	 &nbsp	 &nbsp	     "icon": --, </br>
			&nbsp	 &nbsp	 &nbsp		 "id": --, </br>
			&nbsp	 &nbsp	 &nbsp		 "name": --
			</br>		
			  }, </br>
			  "opening_hours": --,</br>
		&nbsp	 &nbsp	 &nbsp	  "place_id": --,</br>
		&nbsp	 &nbsp	 &nbsp	  "types": {} ,</br>
		&nbsp	 &nbsp	 &nbsp	  "vicinity" : --</br> 
		  }</td>
		  *</tr>
          * </table>
	    */
		this.constructor.prototype.getLastPlacesInfo = function()
		{
			return this._instance.curPlaces;
		}
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONPLACES, "places");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONPLACESERR, "error");
				bpmext.ui.loadView(this);
				
				var view = this;
				
				//view._proto._resolvePlace(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};
				this.constructor.prototype.view = function ()
		{
			
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}
 }
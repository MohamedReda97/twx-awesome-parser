/**
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setMenuVisible(true)</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Item Click:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when an item is clicked.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${Text1}.setLabelPosition(command) //sets the label position of the Text1 control to the value of command<br />//the value of command is set in the menu item command property</code></pre></td>
 *         </tr>
 *       </table>
 *       <table style="border: 1px solid black; border-collapse: collapse; ">
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <th style="border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *           <th style="border: 1px solid black; border-collapse: collapse; padding: 5px;">command {string}</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Show:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when the popup menu is shown.</td>
 *         </tr>
 *       </table>
 *       <table style="border: 1px solid black; border-collapse: collapse; ">
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <th style="border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Close:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when the popup menu is hidden.</td>
 *         </tr>
 *       </table>
 *       <table style="border: 1px solid black; border-collapse: collapse; ">
 *         <tr style="border: 1px solid black; border-collapse: collapse;">
 *           <th style="border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitPopupMenu = function (bpmext, utilities, dom, domClass, domAttr, domConstruct, domGeometry, domStyle, query, baseWindow)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype.IS_ADDRESS_INVISIBLE = true;
		
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE",
			EVT_ONICLICK : "eventON_ICLICK",
			EVT_ONSHOW : "eventON_SHOW",
			EVT_ONCLOSE : "eventON_CLOSE",
			/* {#feature: * Added color style for popup menus} */
			OPTS_COL_STLZ : {
				"D" : "",
				"P" : "bg-primary",
				"I" : "bg-info",
				"S" : "bg-success",
				"W" : "bg-warning",
				"G" : "bg-danger",
				"E" : "bg-danger"
			},
			OPTS_COL_BDG_CLZ : {
				"D" : "badge-notset",
				"P" : "badge-primary",
				"I" : "badge-info",
				"S" : "badge-success",
				"W" : "badge-warning",
				"G" : "badge-danger",
				"E" : "badge-danger"
			},
			OPTS_COL_LBL_CLZ : {
				"D" : "label-notset",
				"P" : "label-primary",
				"I" : "label-info",
				"S" : "label-success",
				"W" : "label-warning",
				"G" : "label-danger",
				"E" : "label-danger"
			},
			OPTS_VALGN_CLZ : {
				"T" : "top",
				"B" : "bottom",
				"A" : "bottom"
			},
			_replaceClass : function (view, valueMap, newVal, oldVal)
			{
				if(newVal != null)
					newVal = newVal.toUpperCase();
				
				if(oldVal != null)
					oldVal = oldVal.toUpperCase();

				var oldClass = valueMap[oldVal];
				if(oldClass == null)
					oldClass = "";

				var newClass = valueMap[newVal];
				if(newClass == null)
					newClass = "";

				domClass.replace(view._instance.wrapper, newClass, oldClass);
			},
			_setColorStyle : function (view, newVal, oldVal)
			{
				oldVal = bpmext.ui.util.normalizeColorStyle(oldVal);
				newVal = bpmext.ui.util.normalizeColorStyle(newVal);
				this._replaceClass(view, this.OPTS_COL_STLZ, newVal, oldVal);
			},
			_setDisabler : function (view, enable)
			{
				if(enable) {
					domClass.remove(view._instance.disabler, "hidden");
				} else {
					domClass.add(view._instance.disabler, "hidden");
				}
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);

				if (visibility != "NONE")
				{
					if (visibility == "READONLY")
						this._setDisabler(view, true);
					else
						this._setDisabler(view, false);
				} 
				else if (visibility === "NONE")
				{
					domClass.remove(view._instance.wrapper, "open");
				}
				
				//{#bug: * Fixed improper post-initialization visibility handling}
				utilities.handleVisibility(view.context);
			},
			_setupItemClick: function(view, anchor, command)
			{
				var eventHandler = function(evt){
					if(evt.type === "keydown" && (event.key && event.key !== "Enter")){
						return;
					}
					
					if(!view.context.options.menuSticky.get("value")){
						view.setMenuVisible(false);
						if(view._instance.ariaTriggerElementTarget) {
							view._instance.ariaTriggerElementTarget.focus();
						}
					}

                    bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONICLICK, command);

                    return false;
				};

				anchor.onclick = eventHandler;
				//Added for TK-1272 : STARTS
				anchor.onkeydown = eventHandler;
				//TK-1272 : ENDS
			},
			_setMenuVisible: function (view, vis)
			{
				this.handleEvent = function handleEvent(event) {
					this._updateAlignment(view);
				};

				if(vis)
				{
					var firstItem = view._instance.menuTbl.querySelector(".mnTextItem");
					domClass.add(view._instance.wrapper, "open");
					if (!view.context.options.customFocus.get("value")) {
						domClass.add(firstItem, "highlight");
					}
					
					this._updateAlignment(view);
					if (!view.context.options.customFocus.get("value")) {
						setTimeout(function(){
							firstItem.focus();
						});
					}

					window.addEventListener("resize", this, { passive: true });
					if (dojo.isIos || this._isIPad()) {
						document.addEventListener('touchstart', view._instance.touchHandler);
					}
						
					//{#feature: US-696 ARIA Accessibility}
					if(view._instance.ariaTriggerElementTarget != null)
						domAttr.set(view._instance.ariaTriggerElementTarget, "aria-expanded", "true");
					//End US-696
                    bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSHOW);
				}
				else {
					domClass.remove(view._instance.wrapper, "open");
					//{#feature: US-696 ARIA Accessibility}
					if(view._instance.ariaTriggerElementTarget != null)
						domAttr.set(view._instance.ariaTriggerElementTarget, "aria-expanded", "false");
					//End US-696
                    bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONCLOSE);

                    window.removeEventListener("resize", this, { passive: true });
                    if (dojo.isIos || this._isIPad()) {
						document.removeEventListener('touchstart', view._instance.touchHandler);
					}
				}
			},
			/**
			 * dojo.isIos doesn't detect iPads
			 * @return {Boolean} whether the current device is an iPad
			 */
			_isIPad : function () {
				return navigator.platform.indexOf("iPad") !== -1 || 
					(navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
			},
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("PopupMenu._setLabelVisibility() error: " + e);
					bpmext.log.error("PopupMenu._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_createLabel : function (view)
			{
				//view._instance.label = document.createElement("label");
				//Added for TK-1272 : STARTS
				view._instance.label = document.createElement("span");
				//TK-1272 : ENDS
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.outer, "first");
				
				//{#feature: US-696 ARIA labeling}
				if(view._instance.ariaLabelTarget != null)
				{
					var lblId = "pm-lbl-" + view.getUID();

					domAttr.set(view._instance.label, "id", lblId);
					domAttr.set(view._instance.ariaLabelTarget, "aria-labelledby", lblId);
					
					if(view._instance.ariaLabelTarget.nodeName == "BUTTON" || view._instance.ariaLabelTarget.nodeName == "A")
						domAttr.remove(view._instance.ariaLabelTarget, "aria-labelledby");
				}
				//End US-696								
			},
			_setLabel : function (view)
			{
				try
				{
					var label = view.context.options._metadata.label.get("value");
					
					if(label && view.context.options.showLabel.get("value"))
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						if(view._instance.label && view._instance.inner)
						{
							view._instance.inner.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("PopupMenu._setLabel() error: " + e);
					bpmext.log.error("PopupMenu._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				
				bpmext.ui.util.replaceCSSClass(view._instance.outer, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			_setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else 
				{
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}
					
					domClass.remove(view.context.element, "labelWidth");
				}
					
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;
						
						domClass.add(view.context.element, "widthSet");
					}
					else
					{
						view.context.element.style.width = null;
	
						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("PopupMenu._setWidth() error: " + e);
					bpmext.log.error("PopupMenu._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setDropShadow : function (view, flag)
			{
				if(flag)
					domClass.add(view._instance.wrapper, "menu-shadow");
				else
					domClass.remove(view._instance.wrapper, "menu-shadow");
			},
			_getDirection: function() 
			{
                var getDirection = function(element) {
                    var result = null;
                    if (element) {
                        if (window.getComputedStyle) {
                            result = window.getComputedStyle(element, null).direction;
                        } else if (element.currentStyle) {
                            result = element.currentStyle.direction;
                        }
                    }
                    return result;
                };

                var bidi = "auto";
                if (getDirection(document.body) == "rtl" && domClass.contains(document.body, "CoachViewRTL")) {
                    bidi = "rtl";
                }
                return bidi;
            },
			_updateAlignment : function (view) 
			{
				// If not clear the wrapper top & left (or x & y) positions,
				// it will affects computing position of the targetElement (defect 340619)
				// wrapper element also needed a initial place to start with (defect 331118)
				domStyle.set(view._instance.wrapper, {
					top: 0,
					left: 0
				});

                var scrollTop;
                // maybe we should use specific versions for FF and IE (e.g. 36 - this is where the bug was introduced, 
                // and 9 respectively - i am not sure how it worked before version 9) instead of using a version > 0 
                if(dojo && (dojo.isChrome > 0 || dojo.isFF > 0 || dojo.isIE > 0 || navigator.userAgent.indexOf("Trident") > 0)){
                    scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
                } else {
                    scrollTop = baseWindow.body().scrollTop || window.pageYOffset;
                }

                //Display calendar popup above the background of a modal section
                var parents = query(view._instance.cbox).parents();
                var subParents = parents.filter(function(parent) {
                    return query(parent).style("z-index")[0] !== "auto";
                });
                var zIndex = parseInt(subParents.first().style("z-index")[0]) + 1060;

                //BiDi
				var rtl = this._getDirection() === "rtl";
				
				domClass.remove(view._instance.wrapper, "rightHMnAlign");

                var targetElement;
                if(view._instance.targetElement) {
                	targetElement = domGeometry.position(view._instance.targetElement);
				} 
				// else if(view._instance.ariaTriggerElementTarget) {
                // 	targetElement = domGeometry.position(view._instance.ariaTriggerElementTarget);
				// } 
				else {
                	targetElement = domGeometry.position(view._instance.cbox);
                }
                
				//If target element is hidden, then do not show the pop-up menu
				if (targetElement.w === 0 && targetElement.h === 0) {
					view.setMenuVisible(false);
					return;
				}
				
                var wrapperPosition = domGeometry.position(view._instance.wrapper);

				//Set Horizontal alignment
				var hPosition = view._instance.oldHzAlgn,
					left;

				if (hPosition === "L") {//Left
					if (rtl) {
						left = (targetElement.x + targetElement.w) - wrapperPosition.w;
						domClass.add(view._instance.wrapper, "rightHMnAlign");
					} else {
						left = targetElement.x;
					}
				} else if (hPosition === "R") {//Right
					if (rtl) {
						left = targetElement.x;
					} else {
						left = (targetElement.x + targetElement.w) - wrapperPosition.w;
						domClass.add(view._instance.wrapper, "rightHMnAlign");
					}
				} else if (hPosition === "A") {//Auto {
					if ((targetElement.x + wrapperPosition.w) > baseWindow.body().offsetWidth) {
						domClass.add(view._instance.wrapper, "rightHMnAlign");
						left = (targetElement.x + targetElement.w) - wrapperPosition.w;
					} else {
						left = targetElement.x;
					}
				}

				//Set Vertical alignment
				var vPosition = view._instance.oldVAlgn,
					top;
				
				//Defect#283984 - START
				if(targetElement.y < wrapperPosition.h){
					vPosition = 'B';
					this._setVertAlign(view, vPosition);
				}
				//Defect#283984 - END

				if (vPosition === "T") {
					top = (targetElement.y + scrollTop - wrapperPosition.h) - 10;
				} else {
					top = (targetElement.y + scrollTop + targetElement.h);
				}

				domStyle.set(view._instance.wrapper, {
                    top: top + 'px',
                    left: left + 'px',
                    "z-index": zIndex
                });
			},
			_setHorizAlign : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldHzAlgn;
				
				newVal = bpmext.ui.util.normalizeHorizontalPos(newVal);
				oldVal = bpmext.ui.util.normalizeHorizontalPos(oldVal);
				
				view._instance.oldHzAlgn = newVal;
			},
			_setVertAlign : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldVAlgn;
				
				newVal = bpmext.ui.util.normalizeVerticalPos(newVal, this.OPTS_VALGN_CLZ);
				oldVal = bpmext.ui.util.normalizeVerticalPos(oldVal, this.OPTS_VALGN_CLZ);
				
				bpmext.ui.util.replaceCSSClass(view._instance.wrapper, this.OPTS_VALGN_CLZ, newVal, oldVal);

				view._instance.oldVAlgn = newVal;
			},
			_removeMenuItem : function (view, index)
			{
				view._instance.menuTbl.deleteRow(index);
				if(view._instance.menuTbl.rows.length === 0) {
					domClass.remove(view._instance.wrapper, "open");
				}
			},
			_removeAllMenuItems : function (view)
			{
				if(view.context.options.menuItems)
				{
					view.context.options.menuItems.set("value", []);
				}
				else {
					view._instance.menuTbl.innerHTML = "";
				}
			},
			_setMenuItem : function (view, index, mnItem)
			{
				var tr = null;
				if(index >= view._instance.menuTbl.rows.length)
				{
					tr = document.createElement("tr");
					view._instance.menuTbl.appendChild(tr);		
				}
				else
				{
					tr = view._instance.menuTbl.rows[index];
					tr.className = "";
					tr.innerHTML = "";
				}

				domAttr.set(tr, 'tabindex', 0);

				var itemText = (mnItem.itemText == null || mnItem.itemText == "")  ? mnItem.command : mnItem.itemText;
				
				switch(mnItem.itemType)
				{
					case "L":
					{
						domClass.add(tr, "mnTextItem");
						domAttr.set(tr, 'role', 'menuitem');

						var labelTD = document.createElement("td");
						domAttr.set(labelTD, "id", "popupmenu-item-"+view.context.controlidpath+"["+index+"]");
						var a = document.createElement("a");
						domAttr.set(a, "id", "popupmenu-item-link-"+view.context.controlidpath+"["+index+"]");
						
						labelTD.appendChild(a);
						domClass.add(labelTD, "mnLabel");

						a.href = "javascript:void(0)";
													
						this._setupItemClick(view, tr, mnItem.command);
						domClass.add(a, "mnItem");
						
						if(mnItem.icon)
						{
							var ic = document.createElement("i");
							domAttr.set(ic, "id", "popupmenu-item-icon-"+view.context.controlidpath+"["+index+"]");
							var icon = mnItem.icon;
							
							var fontAwesome = bpmext.text.startsWith(icon, "fa-");
							var carbonIcon = bpmext.text.startsWith(icon, "ci-");
							
							if(!fontAwesome && !carbonIcon){
								icon = "fa-" + icon;
								fontAwesome = true;
							}
							
							if(fontAwesome){
								domClass.add(ic, "dropdown-icon fa " + icon);
							}
							else if(carbonIcon){
								domClass.add(ic, "dropdown-icon ci");
								ic.appendChild(utilities.getCarbonIcon(icon));
							}
							a.appendChild(ic);
						}
						
						var txt = document.createTextNode(itemText);
						a.appendChild(txt);
						
						tr.appendChild(labelTD);

						if(mnItem.badgeShape && mnItem.badgeShape != "N")
						{
							if(!mnItem.badgeColor)
								mnItem.badgeColor = "D";

							var badgeTD = document.createElement("td");
							domAttr.set(badgeTD, "id", "popupmenu-item-badge-"+view.context.controlidpath+"["+index+"]");
							domClass.add(badgeTD, "mnBadge");
							var sp = document.createElement("span");
							domAttr.set(sp, "id", "popupmenu-item-badge-text-"+view.context.controlidpath+"["+index+"]");
							badgeTD.appendChild(sp);
							
							switch(mnItem.badgeShape)
							{
								case "R":
									domClass.add(
										sp, 
										"mnBadge badge " + this.OPTS_COL_BDG_CLZ[mnItem.badgeColor]
										);
									break;
								case "S":
									domClass.add(
										sp, 
										"mnBadge label " + this.OPTS_COL_LBL_CLZ[mnItem.badgeColor]
										);
									break;
							}
							
							if(!mnItem.badgeText)
								mnItem.badgeText = "...";
							
							sp.innerHTML = mnItem.badgeText;
							tr.appendChild(badgeTD);
						}
						else
						{
							domAttr.set(labelTD, "colspan", 2);
						}
							
						break;
					}
					case "S":
					{
						var sepTD = document.createElement("td");
						domAttr.set(sepTD, "colspan", 2);
						domClass.add(sepTD, "divider");
						var sep = document.createElement("div");
						domClass.add(sep, "divider");
						sepTD.appendChild(sep);
						tr.appendChild(sepTD);
						break;
					}
					case "H":
					{
						var headerTD = document.createElement("td");
						domAttr.set(headerTD, "colspan", 2);
						domClass.add(headerTD, "dropdown-header");
						headerTD.innerHTML = mnItem.itemText;
						tr.appendChild(headerTD);
						break;
					}
				}
				
				//view._instance.wrapper.style.display = view._instance.menuTbl.rows.length == 0 ? "none" : null;
				//04-17-2017:Zubin: Changed 'null' for IE compatibility
				if(view._instance.menuTbl.rows.length === 0) {
					domClass.remove(view._instance.wrapper, "open");
				}
			},
			_loadMenuItems : function (view, list)
			{
				view._instance.menuTbl.innerHTML = "";
				
				if(!list)
					return;

				var mnItems = list.items;

				for(var i = 0; i < mnItems.length; i++)
				{
					var mnItem = mnItems[i];
					this._setMenuItem(view, i, mnItem);
				}		
			},
			_mnItemsUpdated : function (view, event)
			{
				if(event.insertedInto >= 0)
				{
					this._setMenuItem(view, event.insertedInto, event.newVal);
				}
				else if(event.removedFrom >= 0)
				{
					this._removeMenuItem(view, event.removedFrom);
				}
			},
			_bindMenuItemsList : function (view, mnItems)
			{
				var _this = this;
				view._instance.mnItemsChangeHandle = mnItems.bindAll(
					function(event){_this._mnItemsUpdated(view, event)},
					view
					);

				return mnItems;
			},
			_setMenuFocus : function(view)
			{										
				//Added for TK-1272 : STARTS
				var keyHandler = function(evt){
					evt.stopPropagation();
					evt.preventDefault();

					var nextElmByClass = function(node, className) {
						var nd = node;
						while (nd) {
							if (nd.classList.contains(className)) {
								return nd;
							}
							nd = nd.nextSibling;
						}
						var list = view._instance.menuTbl.querySelectorAll(".mnTextItem");
						return list[0];
					};

					var prevElmByClass = function(node, className) {
						var nd = node;
						while (nd) {
							if (nd.classList.contains(className)) {
								return nd;
							}
							nd = nd.previousSibling;
						}
						var list = view._instance.menuTbl.querySelectorAll(".mnTextItem");
						return list[list.length - 1]
					};

					var highlightedElm = null;
					if(evt.key === "Escape" || evt.key === "Esc" || evt.key === "Tab" || evt.key === " " || evt.key === "Spacebar"){ //Escape or Tab or Space
						view.setMenuVisible(false);

						highlightedElm = view._instance.menuTbl.querySelector('.highlight');
						if(highlightedElm){
							highlightedElm.classList.remove('highlight');
						}

						if(view._instance.ariaTriggerElementTarget != null){
							view._instance.ariaTriggerElementTarget.focus();
						} else if(view._instance.targetElement != null){
							view._instance.targetElement.focus();
						}
					} else if (!view.context.options.customFocus.get("value")) {
						if(evt.key === "ArrowUp" || evt.key === "ArrowDown" || evt.key === "Up" || evt.key === "Down"){//UP and Down arrow
							highlightedElm = view._instance.menuTbl.querySelector('.highlight');
							var elmToHighlight = null;
							if(highlightedElm){
								elmToHighlight = (evt.key === "ArrowDown" || evt.key === "Down") ? nextElmByClass(highlightedElm.nextSibling, 'mnTextItem') : prevElmByClass(highlightedElm.previousSibling, 'mnTextItem');
								if(elmToHighlight){
									highlightedElm.classList.remove('highlight');
									elmToHighlight.classList.add('highlight');
									elmToHighlight.focus();
								}
							} else {
								var trElm = view._instance.menuTbl.querySelector('tr');
								elmToHighlight = (evt.key === "ArrowDown" || evt.key === "Down") ? nextElmByClass(trElm, 'mnTextItem') : prevElmByClass(trElm, 'mnTextItem');
								if(elmToHighlight){
									elmToHighlight.classList.add('highlight');
									elmToHighlight.focus();
								}
							}							
						}
					}
				};

				var blurHandler = function(event){
					event.stopPropagation();
					setTimeout(function(){
						if(view.context && !view.context.options.menuSticky.get("value") && !dom.isDescendant(document.activeElement, view._instance.wrapper)){
							view.setMenuVisible(false);
						}
					}, 150);
				};

				if (!view.context.options.customFocus.get("value")) {
					view._instance.wrapper.addEventListener('blur', blurHandler, true);
				}
				view._instance.wrapper.addEventListener('keydown', keyHandler, false);	
				//TK-1272 : ENDS
			},
			_setTarget : function(view, element)
			{
				view._instance.targetElement = element;
			}
		};


		 * @desc Get the index of the specified menu item or -1 if the menuItem cannot be located.
		 * @returns index
		 */
		this.constructor.prototype.getMenuItemIndex = function(input)
		{
			var retVal = -1;
			var menuItems = this.context.options.menuItems.get("value");
			if (typeof input == "string")  // use command to get index
			{
				for (var i = 0; i < menuItems.items.length; i++)
				{
					if (menuItems.items[i].command == input)
					{
						retVal = i;
						break;
					}
				}
			}	
			else if (typeof input == "object")// lookup using the menuitem.  It is assumed that the object is a menuitem
			{
				for (var i = 0; i < menuItems.items.length; i++)
				{
					if (menuItems.items[i] == input)
					{
						retVal = i;
						break;
					}
				}
			}
			else
			{	
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Invalid type specified for input, must be string or a menuItem object");
				bpmext.log.error(bpmext.localization.formatMsg("general", "INVALID_INPUT_TYPE") + ", " + bpmext.localization.formatMsg("controlPopupMenu", "PM_STR_MENUITEMOBJ_TYPE_INPUT"));
			}
			

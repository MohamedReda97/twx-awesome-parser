				// Commented by Nividous
				/* this._instance.menu.onblur = function(event) {	
						if(!opts.menuSticky.get("value"))
							view.setMenuVisible(false);
					};
				*/
				this._instance.outer = this.context.element.querySelector(".outer");				
				var childNodes = cBox.childNodes;
				var j = 0;
				//var view = this;  // Commented by Nividous
				
				for(var i = 0; i < childNodes.length; i++)
				{
					var childNode = childNodes[i];
					if(domAttr.has(childNode, "data-viewid"))
					{
						j++;

						if(j > 1)
						{
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("This Popup Menu control (" + this.context.viewid + ") should only contain one child view - it contains " + childNodes.length);
							bpmext.log.warn(bpmext.localization.formatMsg("controlPopupMenu", "POPUPMENU_CONTROL") + " (" + this.context.viewid + ") " + bpmext.localization.formatMsg("general", "ONE_CHILDVIEW_WARNING") + " " + childNodes.length);
							//bpmext.log.warn("  Only the first view was added");
							bpmext.log.warn(" " + bpmext.localization.formatMsg("general", "FIRSTVIEW_ADDED_WARNING"));
							
							break;
						}
						
						var subV = this.context.createView(childNode);
						
						//{#feature: US-696 ARIA labeling}
						if(subV._getHTMLInputElement)
							this._instance.ariaLabelTarget = subV._getHTMLInputElement();
						//End US-696
						
						//{#feature: US-696 ARIA Accessibility}
						if(subV._getTriggerElement)
							this._instance.ariaTriggerElementTarget = subV._getTriggerElement();
						//End US-696
						
						subV.context.options._metadata.labelVisibility.set("value", "HIDE");
						if(!this.context.options._metadata.label.get("value"))
						{
							this.context.options._metadata.label.set("value", subV.context.options._metadata.label.get("value"));
						}
					}
				}								
				
				//{#feature: US-696 ARIA Accessibility}
				if(this._instance.ariaTriggerElementTarget != null)
				{							
					domAttr.set(this._instance.ariaTriggerElementTarget, "aria-haspopup", "true");	
					if(!opts.menuVisible.get("value"))
							domAttr.set(this._instance.ariaTriggerElementTarget, "aria-expanded", "false");	
				}
				//End US-696
				
				this._proto._setLabelVisibility(this, opts._metadata.labelVisibility.get("value"));
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this);
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));                
				this._proto._setWidth(this, opts.width.get("value"));
				this._proto._setDropShadow(this, opts.castShadow.get("value"));
				this._proto._setHorizAlign(this, opts.horizAlign.get("value"));
				this._proto._setVertAlign(this, opts.vertAlign.get("value"));
				this._proto._setColorStyle(this, opts.colorStyle.get("value"));
				
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONICLICK, "command");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSHOW);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLOSE);

				this._instance.touchHandler = function touchHandler(event) {
					if (view._instance.wrapper && !view._instance.wrapper.contains(event.target)) {
						document.activeElement.blur();
					}
				};
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "showLabel":
						case "_metadata.label":
						{
							this._proto._setLabel(this);
							break;
						}
						case "_metadata.labelVisibility":
						{
							this._proto._setLabelVisibility(this, event.newVal);
							break;
						}
						case "labelPlacement":
						{
							this._proto._setLabelPlacement(this, event.newVal);
							break;
						}
						case "labelWidth":
						{
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "menuVisible":
						{
							this._proto._setMenuVisible(this, event.newVal);
							break;
						}
						case "menuSticky":
						{
							//Nothing to do
							break;
						}
						case "castShadow":
						{
							this._proto._setDropShadow(this, event,newVal);
							break;
						}
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "horizAlign":
						{
							this._proto._setHorizAlign(this, event.newVal);
							break;
						}
						case "vertAlign":
						{
							this._proto._setVertAlign(this, event.newVal);
							break;
						}
						case "menuItems":
						{
							this._proto._loadMenuItems(this, event.newVal);
							break;
						}
						case "colorStyle":
						{
							this._proto._setColorStyle(this, event.newVal, event.oldVal);
							break;
						}						
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};
		
		/*
		this.constructor.prototype.validate = function (event)
		{

		 * @desc Get menu item at specified index. 
		 * @returns {MenuItem} or null if not located
		 * <table class=Config>
		 *   <tr class=Prop>
		 *     <td class=SectionName colspan=3>JSON Structure of menu items</td>
         *   </tr>
		 *   <td>{<br />
		 *       &nbsp&nbsp&nbsp&nbsp command : <code>string</code><br />
		 *       &nbsp&nbsp&nbsp&nbsp itemType : "L"=Label | "S"=Seperator | "H"=Section Header<br />
		 *       &nbsp&nbsp&nbsp&nbsp icon : <code>string</code><br />
		 *       &nbsp&nbsp&nbsp&nbsp iconText : <code>string</code><br />
		 *       &nbsp&nbsp&nbsp&nbsp badgeShape : "N"=None | "S"=Square | "R"=Rounded<br />
		 *       &nbsp&nbsp&nbsp&nbsp badgeColor : "D"=Default | "P"=Primary | "I"=Info | "S"=Success | "W"=Warning | "G"=Danger<br />
		 *       &nbsp&nbsp&nbsp&nbsp badgeText : <code>string</code><br />
		 *       }</td>
         * </table>
		 */
		this.constructor.prototype.getMenuItem = function(index)
		{
			if (typeof index == "number")  // use index
			{
				if (index >= this.context.options.menuItems.get("value").items.length) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Specified index out of range");
					bpmext.log.error(bpmext.localization.formatMsg("general", "INDEX_OUT_OF_RANGE"));
				} else {
					return this.context.options.menuItems.get("value").items[index];
				}
			}
			else if (typeof index == "string")// lookup using the Command
			{
				var cmdIndex = this.getMenuItemIndex(index);
				if (cmdIndex == -1) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Specified command not found in menuitems table");
					bpmext.log.error(bpmext.localization.formatMsg("controlPopupMenu", "CMD_NOTFOUND_IN_MENUITEMS_TBL"));
				} else {
					return this.context.options.menuItems.get("value").items[cmdIndex];
				}
			}
			else {
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Invalid type specified for input, must be string or number");
				bpmext.log.error(bpmext.localization.formatMsg("general", "INVALID_INPUT_TYPE") + ", " + bpmext.localization.formatMsg("controlPopupMenu", "PM_STR_NUM_TYPE_INPUT"));

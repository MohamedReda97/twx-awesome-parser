/**
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is triggered when the Signature control is loaded on the page</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>if(!isEmpty()){me.clear();}<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Changed:</td>
 *     <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is triggered when there is a change in the Signature control.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.obfuscate();<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */

bpmext_control_InitSignature = function(utilities, bpmext, domClass, domAttr, domConstruct, signature)
{
	this._instance = {};
	
	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGED : "eventON_CHANGED",
			OPTS_COL_STLZ :
			{
				"D" : "",
				"I" : "note-info",
				"P" : "note-primary",
				"S" : "note-success",
				"W" : "note-warning",
				"G" : "note-danger"
			},
			_normalizeColorStyle: function(style)
			{
				if(!style)
					style = "D";
				
				style = style.toUpperCase();
				if(style.length > 1)
				{
					switch (style)
					{
						case "DEFAULT":
						case "DEF":
							style = "D";
							break;
						case "PRIMARY":
						case "PRI":
							style = "P";
							break;
						case "SUCCESS":
							style = "S";
							break;
						case "INFO":
						case "INF":
							style = "I";
							break;
						case "WARNING":
						case "WARN":
							style = "W";
							break;
						case "DANGER":
							style = "G";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected color style: " + style);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "COLOR_STYLE_WARNING",style));
					}
				}

				return style;
			},
			_setColorStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldColStyle;
				
				newVal = this._normalizeColorStyle(newVal);
				oldVal = this._normalizeColorStyle(oldVal);

				bpmext.ui.util.replaceCSSClass(view._instance.canvas, this.OPTS_COL_STLZ, newVal, oldVal);
				view._instance.oldColStyle = newVal;
			},			
			_resizeCanvas : function(canvas) 
			{
				var ratio =  window.devicePixelRatio || 1;
				
				canvas.width = canvas.offsetWidth * ratio;
				canvas.height = canvas.offsetHeight * ratio;
				canvas.getContext("2d").scale(ratio, ratio);
			},			
			_setWidth : function (view)
			{
				var size = view.context.options.width.get("value");
				
				try
				{
					if(size != null && size != "")
					{
						if (!isNaN(size))
							size += "px";

						//view._instance.canvasHolder.style.width = size;
						view._instance.canvas.style.width = size;
					}
					else 
					{
						view._instance.canvas.style.width = null;

					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Signature._setWidth() error: " + e);
					bpmext.log.error("Signature._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHeight : function (view)
			{
				var size = view.context.options.height.get("value");
				
				try
				{
					if(size != null && size != "")
					{
						if (!isNaN(size))
							size += "px";

						//view._instance.canvasHolder.style.height = size;
						view._instance.canvas.style.height = size;
					}
					else 
					{
						view._instance.canvas.style.height = null;
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Signature._setHeight() error: " + e);
					bpmext.log.error("Signature._setHeight() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setRadius : function (view, newVal)
			{
				if (newVal != null && newVal.length > 0)
				{
					if (!isNaN(newVal))
						newVal += "px";
				}
				else
					newVal = 0;
					
				view._instance.canvas.style.borderRadius = newVal;
			},
			_setBorderSize : function (view, newVal)
			{
				if (newVal != null && newVal.length > 0)
				{
					if (!isNaN(newVal))
						newVal += "px";
				}
				else
					newVal = 0;
					
				view._instance.canvas.style.borderWidth = newVal;
			},			
			_setShadow : function (view)
			{
				var shadow = view.context.options.shadow.get("value");
				
				if(shadow)
					domClass.add(view._instance.canvasHolder, "shadowed");
				else
					domClass.remove(view._instance.canvasHolder, "shadowed");
			},
			_updateContent : function(view)
			{
				var sig = view.context.binding.get("value");
				if(sig == null)
					sig = "";
				
				sig += "";
				
				if(sig.length > 0)
					view._instance.signaturePad.fromDataURL(sig);
				else
					this._clearCanvas(view._instance.canvas);
			},
			_resizeCanvas : function(view, canvas) 
			{
				var w = canvas.offsetWidth;
				var h = canvas.offsetHeight;
				
				if(view._instance._oldW === w && view._instance._oldH === h)
					return;
				
				view._instance._oldW = w;
				view._instance._oldH = h;

				//A - Image scaling
				//var image = new Image();
				//image.src = canvas.toDataURL("image/png");				
				
				var ctx = canvas.getContext("2d");
				var ratio =  window.devicePixelRatio || 1;
				
				//B - Image clipping
				//var img = ctx.getImageData(0, 0, w * ratio, h * ratio);
                var sig = view._instance.signaturePad.toDataURL()
				
				canvas.width = w * ratio;
				canvas.height = h * ratio;

				ctx.scale(ratio, ratio);
                
                view._instance.signaturePad.fromDataURL(sig);

				//B - Image clipping
				//ctx.putImageData(img, 0, 0);
				
				//A - Image scaling
				//ctx.drawImage(image, 0, 0, image.width, image.height, 0, 0, canvas.width, canvas.height);
				
				//{#feature: US-1330 Added RT localization}
				//console.log("Resized signature canvas");
				console.log(bpmext.localization.formatMsg("controlSignature", "SIGN_CANVAS_RESIZED"));
			},
			_sineWave : function(view, canvas, freq, ampl, offset)
			{
				var color = view.context.options.inkColor.get("value");
				
				var ctx = canvas.getContext("2d");
				var ch = canvas.offsetHeight;
				var cw = canvas.offsetWidth;

				for(var x = 0; x < cw; x++)
				{
					var y = Math.sin((x + offset) * freq * Math.PI / 180) * ampl;
					
					var w = Math.abs(Math.sin(x * Math.PI / 180)) * 5;
					//var h = Math.abs(Math.sin(x * Math.PI / 180 * 100));
					
					ctx.fillStyle = color;

					var h = Math.abs(y) / 15;
					
					y = y + ch / (ch / 75);
					ctx.fillRect(x, y, w, h);
				}
			},
			_drawCurves : function (view, count, offset, offsetInc, freq, freqInc, ampl, amplInc)
			{
				for(var i = 0; i < count; i++)
				{
					this._sineWave(view, view._instance.canvas, freq, ampl, offset);
					offset +=offsetInc;
					freq +=freqInc;
					ampl +=amplInc;
				}
			},
			_clearCanvas : function (canvas) {
				var ctx = canvas.getContext("2d");
				ctx.clearRect (0, 0, canvas.width, canvas.height);
			},
			_obfuscateSignature : function(view)
			{
				this._drawCurves(
					view, 
					5, //count
					0, //offset
					116, //offsetInc
					2, //freq
					0, //freqInc
					9, //ampl
					21 //amplInc
					);
					
				view.context.binding.set("value", view._instance.signaturePad.toDataURL());
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);

				if (visibility != "NONE")
				{
					if (visibility == "READONLY")
						domClass.remove(view._instance.disabler, "hidden");
					else
						domClass.add(view._instance.disabler, "hidden");
				}
			}
		}
		
		/**
		 * @instance
		 * @memberof Signature
		 * @method obfuscate
		 * @desc This obscures the image of the signature
		 */		
		this.constructor.prototype.obfuscate = function()
		{
			this._proto._obfuscateSignature(this, this._instance.canvas);
		}
		/**
		 * @instance
		 * @memberof Signature
		 * @method clear
		 * @desc Clears the signature in the control
		 */		
		this.constructor.prototype.clear = function()
		{
			this._instance.signaturePad.clear();
		}
		/**
		 * @instance
		 * @memberof Signature
		 * @method isEmpty
		 * @desc Returns whether the control is empty or not
		 * @returns {boolean} 
		 */		
		this.constructor.prototype.isEmpty = function()
		{
			return this._instance.signaturePad.isEmpty();
		}
		
		/**
		 * @instance
		 * @memberof Signature
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string} 
		 */		
		this.constructor.prototype.getType = function()
		{
			return "signature.3";
		}
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function()
		{
			try
			{
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGED);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGE);
				
				if (!this.context.binding)
					this.context.binding = bpmext.ui.substituteObject(this, null, null, null);

				var opts = this.context.options;
				var mdt = opts._metadata;

				if (!opts.radius)
					opts.radius = bpmext.ui.substituteConfigOption(this, "radius", "5px");

				if (!opts.width)
					opts.width = bpmext.ui.substituteConfigOption(this, "width", null);

				if (!opts.height)
					opts.height = bpmext.ui.substituteConfigOption(this, "height", null);					

				if (!opts.borderWidth)
					opts.borderWidth = bpmext.ui.substituteConfigOption(this, "borderWidth", "1px");					

				if (!opts.colorStyle)
					bpmext.ui.substituteConfigOption(this, "colorStyle", "D");

				if (!opts.inkColor)
					bpmext.ui.substituteConfigOption(this, "inkColor", "black");
					
				if (!opts.shadow)
					bpmext.ui.substituteConfigOption(this, "shadow", false);
					
				this._instance.canvasHolder = document.createElement("div");
				domClass.add(this._instance.canvasHolder, "sig-holder");
				
				this._instance.disabler = bpmext.ui.util.createDisabler(this, this._instance.canvasHolder);
				
				//Added for US-692 : TK-1691 : STARTS
				var spanEl = document.createElement("span");
				domClass.add(spanEl, "sr-only");
				var spanId="sign_"+bpmext.ui.makeUniqueId("");
				domAttr.set(spanEl,"id",spanId);
				//spanEl.innerHTML = this.context.htmlEscape(this.context.options._metadata.label.get("value"));
				//{#feature: US-1330 Added RT localization}
				//spanEl.innerHTML = "Signature";				
				spanEl.innerHTML = bpmext.localization.formatMsg("controlSignature", "SIGNATURE_CONTROL");	
				domConstruct.place(spanEl, this._instance.disabler, "after");
				//US-692 : TK-1691 : ENDS
				this._instance.canvas = document.createElement("canvas");
				domClass.add(this._instance.canvas, "note");
				//Added for US-692 : TK-1691 : STARTS
				domAttr.set(this._instance.canvas, "role", "img");
				//{#feature: US-1330 Added RT localization}
				//domAttr.set(this._instance.canvas, "alt", "Signature");		
				domAttr.set(this._instance.canvas, "alt", bpmext.localization.formatMsg("controlSignature", "SIGNATURE_CONTROL"));	
				domAttr.set(this._instance.canvas, "aria-labelledby", spanId);	
				domAttr.set(this._instance.canvas, "aria-describedby", spanId);				
				//US-692 : TK-1691 : ENDS
				
				this._instance.canvasHolder.appendChild(this._instance.canvas);
				this.context.element.appendChild(this._instance.canvasHolder);
				
				var view = this;
				
				this._instance.signaturePad = new signature(
					this._instance.canvas,
					{
						/*
						minWidth: 5,
						maxWidth: 10,
						*/
						penColor: opts.inkColor.get("value"),
						onEnd: function() {
							view.context.binding.set("value", view._instance.signaturePad.toDataURL());
						}
					}
				);

				this._proto._setWidth(this);
				this._proto._setHeight(this);
				this._proto._setRadius(this, opts.radius.get("value"));
				this._proto._setBorderSize(this, opts.borderWidth.get("value"));
				this._proto._setColorStyle(this, opts.colorStyle.get("value"));
				this._proto._setShadow(this);

				//*
				window.addEventListener("resize", function(){view._proto._resizeCanvas(view, view._instance.canvas)});
				//*/
				
				this._proto._updateContent(this);
				
				bpmext.ui.loadView(this);
				
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		}
		
		this.constructor.prototype.change = function(event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							
							//{#bug: BG-580 Signature Pad doesn't draw signature if previously hidden}
							if(this._instance.canvas.height == null || this._instance.canvas.height == "" || this._instance.canvas.height == 0)
								this._proto._resizeCanvas(this, this._instance.canvas);
							
							break;
						}
						case "colorStyle":
						{
							this._proto._setColorStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "shadow":
						{
							this._proto._setShadow(this);
							break;
						}
						case "borderWidth":
						{
							this._proto._setBorderSize(this, event.newVal);
							break;
						}
                        case "width":
                        {
                            this._proto._setWidth(this);
                            break;
                        }
                        case "height":
                        {
                            this._proto._setHeight(this);
                            break;
                        }
					}
				}
				else
				{
					if(event.newVal != event.oldVal)
					{
						this._proto._updateContent(this);
						bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGED);						
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.unload = function()
		{
			bpmext.ui.unloadView(this);
		};

		this.constructor.prototype.view = function()
		{
			try
			{
				this._proto._handleVisibility(this);
				//{#bug: 386 moved _resizeCanvas from load to view to ensure that canvas is always set to correct size}
				this._proto._resizeCanvas(this, this._instance.canvas);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};
	}
};

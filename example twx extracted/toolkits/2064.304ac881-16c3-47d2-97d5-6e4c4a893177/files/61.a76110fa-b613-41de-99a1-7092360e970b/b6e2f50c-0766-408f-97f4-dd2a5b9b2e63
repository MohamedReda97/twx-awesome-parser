var mixObject = {
	createPreview: function(containingDiv, labelText, callback) {
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		var wysiwygDatePickerUri = this.context.getManagedAssetUrl("BPMExt-Lib-DateTimePicker.zip", this.context.assetType_WEB, "SYSBPMUI", null, "lib/BPMDateTimePicker.js");
		require(["dojo/dom-construct", "dojo/dom-class", bpmextUri, wysiwygDatePickerUri], this.lang.hitch(this, function(domConstruct, domClass, bpmext, wysiwygDatePicker) {
			containingDiv.classList.remove("Date_Time_Picker");
			containingDiv.classList.add("Date_Picker");

			bpmext.uidesign.css.ensureGlyphsLoaded(this);
			bpmext.uidesign.css.ensureStyleLoaded(this, "DatePicker", ".datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-top {top:auto}");
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);

			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");

			this.context.coachViewData.wrapperDiv = domConstruct.create("div");
			domConstruct.place(this.context.coachViewData.wrapperDiv, this.context.coachViewData.containingDiv);
			domClass.add(this.context.coachViewData.wrapperDiv, "dropdown");

			this.context.coachViewData.formGroupDiv = domConstruct.create("div");

			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.label = domConstruct.create("span");
			domClass.add(this.context.coachViewData.label, "control-label");
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);

			this.context.coachViewData.textInputDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.textInputDiv, "input");

			this.context.coachViewData.textInputElement = domConstruct.create("input");
			domClass.add(this.context.coachViewData.textInputElement, "form-control");
			this.context.coachViewData.textInputDiv.appendChild(this.context.coachViewData.textInputElement);
			
			this.context.coachViewData.calendarIcon = document.createElement("span");
			this.context.coachViewData.textInputDiv.appendChild(this.context.coachViewData.calendarIcon);

			domConstruct.place(this.context.coachViewData.formGroupDiv, this.context.coachViewData.wrapperDiv);
			domClass.add(this.context.coachViewData.formGroupDiv, "form-group");
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.label);
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.textInputDiv);

			this.context.coachViewData.dpDiv = domConstruct.create("div");
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.dpDiv);

			this.context.coachViewData.disabler = domConstruct.create("div");
			domClass.add(this.context.coachViewData.disabler, "disabler hidden");
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.disabler);

			var view = this;
			bpmext.uidesign.loadLocalization(this, function() {
				view.context.coachViewData.DPControl = new wysiwygDatePicker({}, view.context.coachViewData.dpDiv);
				domClass.add(view.context.coachViewData.DPControl.picker, "datepicker-dropdown dropdown-menu datepicker-orient-left datepicker-orient-top {display:none}");
				view.context.coachViewData.DPControl.startup();

				//Disable drop down behavior
				//view.context.coachViewData.textInputElement.onfocus = function(e) {
				//	view.context.coachViewData.DPControl.picker.style.display = "inline-block";
				//};

				//view.context.coachViewData.textInputElement.onblur = function() {
				//	view.context.coachViewData.DPControl.picker.style.display = "none";
				//};

				view.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(view.context.coachViewData.labelTextDom,
						view.context.coachViewData.label,
						view.context.coachViewData.containingDiv, false, false);
				callback();
			});
		}));
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.label;
	},
	propertyChanged: function(propertyName, propertyValue) {
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js", this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper) {
			//console.log("propertyName:", propertyName, " propertyValue:", propertyValue);
			if (this.context.coachViewData.containingDiv.classList.contains("Date_Time_Picker")) {
				this.context.coachViewData.containingDiv.classList.remove("Date_Time_Picker");
			}
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			if (propertyName == "@style") {
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");

				if (!!width || !!minWidth || this.context.coachViewData.width) {
					this.context.coachViewData.containingDiv.style.width = minWidth || this.context.coachViewData.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName ==  "@visibility") {
				if(propertyValue == "READONLY") {
					domClass.remove(this.context.coachViewData.disabler, "hidden");
				} else {
					domClass.add(this.context.coachViewData.disabler, "hidden");
				}
			} else if (propertyName == "labelPlacement") {
				var labelPlacement;
				if (propertyValue == "L") {
					labelPlacement = "label-left";
				} else {
					labelPlacement = "";
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, labelPlacement, "label-left");
            } else if (propertyName == "labelWidth") {
                if (propertyValue) {
                    this.context.coachViewData.label.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue + "px");
                    domClass.add(this.context.coachViewData.containingDiv, "labelWidth");
                } else {
                    this.context.coachViewData.label.style.width = "";
                    domClass.remove(this.context.coachViewData.containingDiv, "labelWidth");
                }
			} else if (propertyName == "enableCalendarIcon") {
                if (propertyValue) {
                    domClass.add(this.context.coachViewData.textInputElement, 'has-icon');
        			domClass.add(this.context.coachViewData.calendarIcon, 'fa form-control-feedback fa-calendar has-icon');
                } else {
                    domClass.remove(this.context.coachViewData.textInputElement, 'has-icon');
        			domClass.remove(this.context.coachViewData.calendarIcon, 'fa form-control-feedback fa-calendar has-icon');
                }
			} else if (propertyName == "sizeStyle") {
				var sizeStyle;
				if (propertyValue == "L") {
					sizeStyle = "input-lg";
				} else if (propertyValue == "S") {
					sizeStyle = "input-sm";
				} else {
					sizeStyle = "";
				}
				domClass.replace(this.context.coachViewData.textInputElement, sizeStyle, "input-sm input-lg");
			} else if (propertyName == "width") {
				this.context.coachViewData.width = propertyValue;
				if (!!propertyValue) {
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue + "px");
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if (propertyName == "placeHolder") {
				this.context.coachViewData.placeHolderText = propertyValue;
				this.context.coachViewData.textInputElement.value = propertyValue;
				this.context.coachViewData.textInputElement.style.color = "#bdbdbd";
			} else if (propertyName == "colorStyle") {
				var datePickerStyle;
				if (propertyValue == "P") {
					datePickerStyle = "dp-primary";
				} else if (propertyValue == "I") {
					datePickerStyle = "dp-info";
				} else if (propertyValue == "S") {
					datePickerStyle = "dp-success";
				} else if (propertyValue == "W") {
					datePickerStyle = "dp-warning";
				} else if (propertyValue == "E") {
					datePickerStyle = "dp-danger";
				} else {
					datePickerStyle = "";
				}
				domClass.replace(this.context.coachViewData.DPControl.picker, datePickerStyle, "dp-primary dp-info dp-success dp-warning dp-danger");
			} else if (propertyName == "type") {
				if (!propertyValue || propertyValue == "TI") {
					domClass.replace(this.context.coachViewData.DPControl.picker, "datepicker-dropdown dropdown-menu datepicker-orient-left datepicker-orient-top {display:none}", "datepicker-inline");
					this.context.coachViewData.textInputDiv.style.display = "";
                } else if (propertyValue == "I") {
					domClass.replace(this.context.coachViewData.DPControl.picker, "datepicker-inline", "datepicker-dropdown dropdown-menu datepicker-orient-left datepicker-orient-top {display:none}");
					this.context.coachViewData.DPControl.picker.style.display = "";
					this.context.coachViewData.textInputDiv.style.display = "none";
				}
			} else if (propertyName == "enableTodayButton") {
				this.context.coachViewData.DPControl.todayBtn = propertyValue;
				this.context.coachViewData.DPControl.showTodayButton(propertyValue);
			} else if (propertyName == "enableClearButton") {
				this.context.coachViewData.DPControl.clearBtn = propertyValue;
				this.context.coachViewData.DPControl.showClearButton(propertyValue);
			} else if (propertyName == "showWeeks") {
				this.context.coachViewData.DPControl.showCalendarWeek(propertyValue);
			} else if (propertyName == "highlightToday") {
				this.context.coachViewData.DPControl.setTodayHighlight(propertyValue);
			} else if (propertyName == "hideHeader") {
				this.context.coachViewData.DPControl.showHeader(!propertyValue);
			} else if (propertyName == "weekStart") {
				this.context.coachViewData.DPControl.setWeekStart(parseInt(propertyValue));
			} else if (propertyName == "startView") {
				this.context.coachViewData.DPControl.setStartView(parseInt(propertyValue));
			} else if (propertyName == "minViewMode") {
				this.context.coachViewData.DPControl.setMinViewMode(parseInt(propertyValue));
			} else if (propertyName == "format") {
				this.context.coachViewData.DPControl.setFormat(propertyValue);
			} else if (propertyName == "disabledWeekDays") {
				var OPTS_WEEK_DAYS_ARRAY = [
				                            "Sunday",
				                            "Monday",
				                            "Tuesday",
				                            "Wednesday",
				                            "Thursday",
				                            "Friday",
				                            "Saturday"
				                            ];
				var toReturn = "";
				var disabledWeekDaysArray = [];
				var index;

				var inputStrAry = [];
				inputStrAry = JSON.parse(propertyValue);

				for (index in OPTS_WEEK_DAYS_ARRAY) {
					if (inputStrAry[OPTS_WEEK_DAYS_ARRAY[index]]) {
						disabledWeekDaysArray.push(index);
					}
				}
				toReturn = disabledWeekDaysArray.join();

				this.context.coachViewData.DPControl.setDaysOfWeekDisabled(toReturn);
			} else if (propertyName == "blackoutDateStart") {
				this.context.coachViewData.DPControl.setBlackoutDateStart(propertyValue);
			} else if (propertyName == "blackoutDateEnd") {
				this.context.coachViewData.DPControl.setBlackoutDateEnd(propertyValue);
			} else if (propertyName == "blackoutDates") {
				this.context.coachViewData.DPControl.setBlackoutDates(propertyValue);
			} else if (propertyName == "startDate") {
				this.context.coachViewData.DPControl.setStartDate(propertyValue);
			} else if (propertyName == "endDate") {
				this.context.coachViewData.DPControl.setEndDate(propertyValue);
			} else if (propertyName == "includeTimePicker") {
				this.context.coachViewData.DPControl.showTimePicker(propertyValue);
			} else if (propertyName == "yearSelectorStyle") {
				this.context.coachViewData.DPControl.setYearSelectorStyle(propertyValue);
			}
		}));
	},
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
	}
};
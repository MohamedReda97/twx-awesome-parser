bpmext_control_InitOutputText = function (bpmext, utilities, domClass, domAttr, domConstruct)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			OPTS_COL_STLZ :
			{
				"H" : "",
				"D" : "text-default",
				"M" : "text-muted",
				"L" : "text-light-gray",
				"P" : "text-primary",
				"I" : "text-info",
				"S" : "text-success",
				"W" : "text-warning",
				"G" : "text-danger",
				"E" : "text-danger"
			},
			OPTS_TXT_ALGN :
			{
				"D" : "",
				"L" : "text-left",
				"C" : "text-center",
				"R" : "text-right"
			},
			OPTS_TXT_WRAP :
			{
				"D" : "",
				"N" : "WordBreakNormal",
				"K" : "WordBreakKeepAll",
				"A" : "OverflowWrapAnyWhere",
				"B" : "OverflowWrapBreakWord"
			},
			OPTS_TXS_STLZ :
			{
				"D" : "",
				"R" : "text-slg",
				"X" : "text-xlg",
				"G" : "text-lg",
				"L" : "text-bg",
				"S" : "text-sm",
				"M" : "text-xs"
			},
			OPTS_TXW_STLZ :
			{
				"D" : "",
				"N" : "text-normal",
				"S" : "text-slim",
				"M" : "text-semibold",
				"B" : "text-bold"
			},
			OPTS_WP_TXT :
			{
				"FALSE" : "",
				"TRUE" : "wrap-text"				
			},
			_setText : function (view, text)
			{
				try
				{
					if(text == null)
						text = "";

                    //BG-1169 providing option to allow HTML content
                    if (view.context.options.allowHTML.get("value"))
                        view._instance.outputText.innerHTML = text;
                    else
                        view._instance.outputText.innerHTML = view.context.htmlEscape(text);
                    
                    utilities.BiDi.applyTextDir(
                    		view._instance.outputText, 
                    		view._instance.outputText.textContent, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("OutputText._setText() error: " + e);
					bpmext.log.error("OutputText._setText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_getLabelElt : function (view)
			{
				if(!view._instance.label)
					this._createLabel(view);
				
				return view._instance.label;
			},
			_createLabel : function (view)
			{
				view._instance.label = document.createElement("span");
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.group, "first");
				domAttr.set(view._instance.label, "for", view._instance.outputText.id);
				domAttr.set(view._instance.label, "id", "outputtext-label-" + view.context.controlidpath);
                domAttr.set(view._instance.outputText, "aria-labelledby", view._instance.label.id);
			},
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("OutputText._setLabelVisibility() error: " + e);
					bpmext.log.error("OutputText._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						if(view._instance.label)
						{
							domAttr.remove(view._instance.outputText, "aria-labelledby");
							view._instance.group.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("OutputText._setLabel() error: " + e);
					bpmext.log.error("OutputText._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);

				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;

				if(newVal === "L"){
					var labelWidth = view.context.options.labelWidth.get("value") || 0;
					if(!isNaN(labelWidth)){
						labelWidth += "px";
					}
					view._instance.input.style.width = "calc(100% - " + labelWidth + ")";
				} else {
					view._instance.input.style.width = "";
				}
			},
			_setLabelWidth : function (view, labelWidth)
			{
				try
				{
					if(!view._instance.label)
					{
						return;
					}

					if(labelWidth != null && labelWidth != "")
					{
						if(!isNaN(labelWidth))
							labelWidth += "px";

						view._instance.label.style.width = labelWidth;
						domClass.add(view.context.element, "labelWidth");

						var labelPlacement = view.context.options.labelPlacement.get("value");
						if(labelPlacement === "L"){
							view._instance.input.style.width = "calc(100% - " + labelWidth + ")";
						} else {
							view._instance.input.style.width = null;
						}
					}
					else {
						if (view._instance.label) {
							view._instance.label.style.width = null;
						}

						if (view._instance.input) {
							view._instance.input.style.width = null;
						}

						domClass.remove(view.context.element, "labelWidth");
					}
				}
				catch (e)
				{
					bpmext.log.error("OutputText._setLabelWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHelpText : function (view, text)
			{
				utilities.setHelpText(view, text);
			},
			_setTextAlignment : function(view, newVal, oldVal)
			{
				bpmext.ui.util.replaceCSSClass(view._instance.outputText, this.OPTS_TXT_ALGN, newVal, oldVal);
			},
			_setTextWrap : function(view, newVal, oldVal)
			{
				bpmext.ui.util.replaceCSSClass(view.context.element, this.OPTS_TXT_WRAP, newVal, oldVal);
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;
						
						domClass.add(view.context.element, "widthSet");
					}
					else
					{
						view.context.element.style.width = null;

						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("OutputText._setWidth() error: " + e);
					bpmext.log.error("OutputText._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_handleVisibility : function (view)
			{
				var vis = utilities.handleVisibility(view.context);
				
				if (vis != "NONE")
					view._instance.outputText.disabled = (vis == "READONLY");

				// Updates for WAI
                if (domAttr.has(view._instance.outputText, "disabled")) {										
                    domAttr.set(view._instance.outputText, "aria-disabled", "true");
                } else {					
                    domAttr.remove(view._instance.outputText, "aria-disabled");
				}
			},
			_normalizeSizeStyle: function(sizeStyle)
			{
				// OPTS_TXS_STLZ :
				// {
					// "D" : "",
					// "R" : "text-slg",
					// "X" : "text-xlg",
					// "G" : "text-lg",
					// "L" : "text-bg",
					// "S" : "text-sm",
					// "M" : "text-xs"
				// },
				if(!sizeStyle)
					sizeStyle = "D";
				
				sizeStyle = sizeStyle.toUpperCase();
				if(sizeStyle.length > 1)
				{
					switch (sizeStyle)
					{
						case "SUPER-LARGE":
						case "SUPER LARGE":
						case "SUPER":
							sizeStyle = "R";
							break;
						case "EXTRA-LARGE":
						case "EXTRA LARGE":
						case "EXTRA":
							sizeStyle = "X";
							break;
						case "LARGER":
							sizeStyle = "G";
							break;
						case "LARGE":
							sizeStyle = "L";
							break;
						case "SMALL":
							sizeStyle = "S";
							break;
						case "SMALLER":
							sizeStyle = "M";
							break;
						case "DEF":
						case "DEFAULT":
							sizeStyle = "D";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected size style: " + sizeStyle);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "SIZE_STYLE_WARNING", sizeStyle));
					}
				}
				
				return sizeStyle;
			},
			_normalizeColorStyle: function(style)
			{
				// OPTS_COL_STLZ :
				// {
					// "H" : "",
					// "D" : "text-default",
					// "M" : "text-muted",
					// "L" : "text-light-gray",
					// "P" : "text-primary",
					// "I" : "text-info",
					// "S" : "text-success",
					// "W" : "text-warning",
					// "G" : "text-danger"
				// },
				if(!style)
					style = "D";
				
				style = style.toUpperCase();
				if(style.length > 1)
				{
					switch (style)
					{
						case "DEFAULT":
						case "DEF":
							style = "D";
							break;
						case "MUTED":
							style = "M";
							break;
						case "LIGHT-GRAY":
						case "GRAY":
						case "LIGHTGRAY":
						case "LIGHT GRAY":
							style = "L";
							break;
						case "SUCCESS":
							style = "S";
							break;
						case "INFO":
						case "INF":
							style = "I";
							break;
						case "PRIMARY":
						case "PRI":
							style = "P";
							break;
						case "WARNING":
						case "WARN":
							style = "W";
							break;
						case "ERROR":
						case "ERR":
						case "DANGER":
							style = "G";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected color style: " + style);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "COLOR_STYLE_WARNING", style));
					}
				}

				return style;
			},
			_setColorStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldColStyle;

				newVal = this._normalizeColorStyle(newVal);
				oldVal = this._normalizeColorStyle(oldVal);
				
				bpmext.ui.util.replaceCSSClass(view._instance.outputText, this.OPTS_COL_STLZ, newVal, oldVal);
				view._instance.oldColStyle = newVal;
			},
			_setSizeStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldSzStyle;

				newVal = this._normalizeSizeStyle(newVal);
				oldVal = this._normalizeSizeStyle(oldVal);
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, this.OPTS_TXS_STLZ, newVal, oldVal);
				view._instance.oldSzStyle = newVal;
			},
			_setWeightStyle : function (view, newVal, oldVal)
			{
				bpmext.ui.util.replaceCSSClass(view._instance.group, this.OPTS_TXW_STLZ, newVal, oldVal);
			},
            _setLabelWeightNormal : function (view, newVal)
            {
                try
                {
                    if (newVal){
                        domClass.add(view.context.element, "controlLabelWeightNormal");
                    }
                    else{
                        domClass.remove(view.context.element, "controlLabelWeightNormal");
                    }
                }
                catch (e)
                {
                    bpmext.log.error("OutputText._setLabelWeightNormal() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) {
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
		};

		/*
		Public control methods *************************************************************
		 */
		 
		/**
		 * @instance
		 * @memberof OutputText
		 * @method setLabel
		 * @param {string} text Label for control
		 * @desc Set the label for the output text control
		 */
		this.constructor.prototype.setLabel = function (text)
		{
			this.context.options._metadata.label.set("value", text);
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method getLabel
		 * @desc Get the label associated with the text control
		 * @returns {string}
		 */
		this.constructor.prototype.getLabel = function ()
		{
			return this.context.options._metadata.label.get("value");
		};
		
		/**
		 * @instance
		 * @memberof OutputText
		 * @method setLabelPlacement
		 * @param {string} placement "T"|"TOP"=Top | "L"|"LEFT"=Left
		 * @desc Set the label placement for the control.  NOTE: to avoid ambiguity always set the label placement using "T"|"L"
		 */
		this.constructor.prototype.setLabelPlacement = function (plc)
		{
			this.context.options.labelPlacement.set("value", plc);
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method getLabelPlacement
		 * @desc Get the label placement for the control.  NOTE: This always returns the label placement as set, to avoid ambiguity always set the label placement using "T"|"L"
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelPlacement = function ()
		{
			return this.context.options.labelPlacement.get("value");
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method getLabelWidth
		 * @desc Get label width of OutputText control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelWidth = function ()
		{
			return this.context.options.labelWidth.get("value");
		};
		
		/**
		 * @instance
		 * @memberof OutputText
		 * @method setLabelWidth
		 * @param {string} labelWidth Control's label width
		 * @desc Set label width of OutputText control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setLabelWidth = function (labelWidth)
		{
			this.context.options.labelWidth.set("value", labelWidth);
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method isLabelVisible
		 * @desc Get the label visibility for the output text control
		 * @returns {boolean}
		 */
		this.constructor.prototype.isLabelVisible = function ()
		{
			return this.context.options._metadata.labelVisibility.get("value") == "SHOW";
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method setLabelVisible
		 * @param {boolean} flag {true | false}
		 * @desc Set the label visibility for the output text control
		 */
		this.constructor.prototype.setLabelVisible = function (flag)
		{
			this.context.options._metadata.labelVisibility.set("value", flag ? "SHOW" : "HIDE");
		};		
		
		/**
		 * @instance
		 * @memberof OutputText
		 * @method getText
		 * @desc Get the text for the output output output text control
		 * @returns {string}
		 */
		this.constructor.prototype.getText = function ()
		{
			var res = this.getData();
			return res == null ? "" : res;
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method setText
		 * @param {string} text Output text of control
		 * @desc Set the text for the output text control
		 */
		this.constructor.prototype.setText = function (text)
		{
			if(this.context.binding) {
				this.context.binding.set("value", text);
			} else {
				this.setViewData(text, true);
			}
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method setWidth
		 * @param {string} width Width of control
		 * @desc Set the width of the output text control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (width)
		{
			this.context.options.width.set("value", width);
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method getWidth
		 * @desc Get the configured width for the output text control (including unit)
		 * @returns {string}
		 */	
		this.constructor.prototype.getWidth = function ()
		{
			return this.context.options.width.get("value");
		};

		/**
		 * @instance
		 * @memberof OutputText
		 * @method setColorStyle
     	 * @param {string} style "DEFAULT"|"DEF"|"D"=Default | "MUTED"|"M"=Muted | "LIGHT_GRAY"|"GRAY"|"LIGHTGRAY"|"LIGHT GRAY"|"LIGHT"|"L"=Light | "PRIMARY"|"P"=Primary | "INFO"|INF"|"I"=Info | "SUCCESS"|"S"=Success | "WARNING"|"WARN"|"W"=Warning | "ERROR"|"ERR"|"DANGER"|"G"=Danger | "TRANSPARENT"|"T"=Transparent 
		 * @desc Sets the color style of the control.  NOTE: to avoid ambiguity always set the color using "D"|"M"|"L"|"P"|"I"|"S"|"W"|"G"|"T"			
		 
		 */
		this.constructor.prototype.setColorStyle = function (style)
		{
			this.context.options.colorStyle.set("value", style);
		};

		//{#feature: * Added getColorStyle() method}
		/**
		 * @instance
		 * @memberof OutputText
		 * @method getColorStyle
		 * @desc Gets the color style of the control.  NOTE: This always returns the color as set, to avoid ambiguity always set the color using "D"|"M"|"L"|"P"|"I"|"S"|"W"|"G"|"T"
		 * @returns {string} 
		 */
		this.constructor.prototype.getColorStyle = function ()
		{
			return this.context.options.colorStyle.get("value");
		};


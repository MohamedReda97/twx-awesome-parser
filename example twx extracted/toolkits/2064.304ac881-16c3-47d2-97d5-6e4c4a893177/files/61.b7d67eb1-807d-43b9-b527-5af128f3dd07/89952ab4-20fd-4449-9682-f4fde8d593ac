var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");				
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			
			this.context.coachViewData.containingDiv = containingDiv;								
			this.context.coachViewData.defaultBorderRadius = "15px";
			
			this.context.coachViewData.formGroupDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.formGroupDiv, "form-group SPARKVideo");
			
			this.context.coachViewData.disablerDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.disablerDiv, "disabler hidden");
			
			this.context.coachViewData.defaultWidth = "100%";
			this.context.coachViewData.defaultHeight = "300px";
			
			this.context.defaultAcronym = "SYSBPMUI";
			this.context.defaultUrlType = this.context.assetType_WEB;
			
			this.context.defaultVideoAltValue = "Default Video Text";
			this.context.isAutoPlay = false;			
			this.context.defaultVideoUrl = this.context.getManagedAssetUrl("SampleVideo_1280x720_1mb.mp4", this.context.defaultUrlType, this.context.defaultAcronym);
			
			this.context.coachViewData.playerDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.playerDiv, "input video-js vjs-default-skin vjs-big-play-centered");
			
			this.context.coachViewData.videoEl = domConstruct.create("video",{src:"#"});
			
			this.context.coachViewData.emptyDiv = domConstruct.create("div");
			
			this.context.coachViewData.posterDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.posterDiv, "vjs-poster");
			domAttr.set(this.context.coachViewData.posterDiv, "tabindex", "-1");
			
			this.context.coachViewData.playBtnDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.playBtnDiv, "vjs-big-play-button");  
			domClass.add(this.context.coachViewData.playBtnDiv, "bigPlayBtn");
			domAttr.set(this.context.coachViewData.playBtnDiv, "tabindex", "0");
			domAttr.set(this.context.coachViewData.playBtnDiv, "role", "button");
			
			domAttr.set(this.context.coachViewData.playerDiv, "width", "100%");
							
			this.context.coachViewData.playerDiv.appendChild(this.context.coachViewData.videoEl);
			this.context.coachViewData.playerDiv.appendChild(this.context.coachViewData.playBtnDiv);	
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.playerDiv);
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.emptyDiv);			
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.posterDiv);						
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.disablerDiv);			
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.formGroupDiv);
			this.context.coachViewData.formGroupDiv.style.height = this.context.coachViewData.defaultHeight;	
			this.context.coachViewData.playerDiv.style.height = this.context.coachViewData.defaultHeight;	
			this.context.coachViewData.formGroupDiv.style.width = this.context.coachViewData.defaultWidth;	
			this.context.coachViewData.playerDiv.style.width = this.context.coachViewData.defaultWidth;
			
			callback();
		}));	
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-attr", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domAttr, configHelper){
			
			if(propertyName == "@label") {
				
			} else if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.context.coachViewData.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.context.coachViewData.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName ==  "@labelVisibility"){
				
			} else if(propertyName == "radius"){				
				if(propertyValue=="" || propertyValue===null || propertyValue===undefined){
					domStyle.set(this.context.coachViewData.playerDiv, "border-radius", this.context.coachViewData.defaultBorderRadius);					
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.playerDiv, "border-radius", propertyValue);				
				}else{
					domStyle.set(this.context.coachViewData.playerDiv, "border-radius", propertyValue+"px");				
				}
			} else if(propertyName == "width"){															
				if(propertyValue=="" || propertyValue===null || propertyValue===undefined){										
					domStyle.set(this.context.coachViewData.formGroupDiv, "width", this.context.coachViewData.defaultWidth);
				}else if(isNaN(propertyValue)){						
					domStyle.set(this.context.coachViewData.formGroupDiv, "width", propertyValue);
				}else{						
					domStyle.set(this.context.coachViewData.formGroupDiv, "width", propertyValue+"px");
				}
			} else if(propertyName == "height"){	
				if(propertyValue=="" || propertyValue===null || propertyValue===undefined){
					domStyle.set(this.context.coachViewData.playerDiv, "height", this.context.coachViewData.defaultHeight);	
					domStyle.set(this.context.coachViewData.formGroupDiv, "height", this.context.coachViewData.defaultHeight);					
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.playerDiv, "height", propertyValue);	
					domStyle.set(this.context.coachViewData.formGroupDiv, "height", propertyValue);					
				}else{
					domStyle.set(this.context.coachViewData.playerDiv, "height", propertyValue+"px");	
					domStyle.set(this.context.coachViewData.formGroupDiv, "height", propertyValue+"px");
				}
			} else if(propertyName == "posterURL"){	
				if(propertyValue !="" && propertyValue !=null){
					var videoPostertUrl = this.context.getManagedAssetUrl(propertyValue, this.context.defaultUrlType, this.context.defaultAcronym);
					//domStyle.set(this.context.coachViewData.posterDiv, "background-image", videoPostertUrl);	
					domAttr.set(this.context.coachViewData.posterDiv, "style", "background-image :url('"+videoPostertUrl+"')");	
				}else{
					domAttr.remove(this.context.coachViewData.posterDiv, "style");	
				}
				/*if(propertyValue !="" && propertyValue !=null){																					
					var videoPostertUrl = this.context.getManagedAssetUrl(propertyValue, this.context.defaultUrlType, this.context.defaultAcronym);
					domAttr.set(this.context.coachViewData.playerDiv, "src", videoPostertUrl);	
					domAttr.set(this.context.coachViewData.playerDiv, "autoplay", this.context.isAutoPlay);
				}else{					
					domAttr.set(this.context.coachViewData.playerDiv, "src", "#");	
					domAttr.set(this.context.coachViewData.playerDiv, "alt", this.context.defaultVideoAltValue);	
				}*/
			} else if(propertyName == "autoPlay"){															
				if(propertyValue !="" && propertyValue !=null)	
					this.context.isAutoPlay = propertyValue;
			}
		}));	
    },
	
	modelChanged: function(propertyName, propertyValue) {
		
	}
};

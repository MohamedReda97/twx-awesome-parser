bpmext_control_InitRadioButtonGroup = function(bpmext, utilities, domClass, domAttr, domConstruct, domGeometry, dom, json) {
    this._instance = {};

    if (!this.constructor.prototype._proto) {
        //this._instance.select.options[i].selected
        var RadioButtonGroup = function(view, parentElt) {
            this._parent = parentElt;
            this.options = [];
            this.view = view;
        };

        //Just so I remember...
        RadioButtonGroup.prototype.onchange = void(0);

        RadioButtonGroup.prototype.setSelectedOption = function(value, selected) {
            var map = {};
            if (value !== null && value !== undefined) {
                if (value[this.view._instance._optValProp] != undefined) {
                    map[value[this.view._instance._optValProp]] = true;
                } else {
                    map[value] = true;
                }
            }

            var children = this._parent.querySelectorAll("span.radio3");
            for (i = 0; i < children.length; i++) {
                var input = children[i].querySelector("input");
                var val = domAttr.get(input, "value");

                if (map[val]) {
                    input.checked = selected == true;
                    //Added for TK-1072 :STARTS
                    domAttr.set(input, "aria-checked", "true");
                    //TK-1072 : ENDS
                } else {
                    input.checked = false;
                    //Added for TK-1072 :STARTS
                    domAttr.set(input, "aria-checked", "false");
                    //TK-1072 : ENDS
                }
            }
        };

        RadioButtonGroup.prototype.setSelectedIndex = function(idx, selected) {
            var children = this._parent.querySelectorAll("span.radio3");
            var labelElt = children[idx];
            if (labelElt) {
                var input = labelElt.querySelector("input");

                input.checked = selected == true;
            }
        };

        //US-1340 added setTabIndex method 
        RadioButtonGroup.prototype.setTabIndex = function(index) {
            var children = this._parent.querySelectorAll("span.radio3");

            for (var i = 0; i < children.length; i++) {
                var spanElt = children[i];
                var input = spanElt.querySelector("input");

                if (index != null)
                    domAttr.set(input, "tabindex", index);
                else
                    domAttr.remove(input, "tabindex");
            }
        };
        RadioButtonGroup.prototype.getOptionsLength = function() {
            var children = this._parent.querySelectorAll("span.radio3");
            return children.length;
        };

        RadioButtonGroup.prototype.removeOptionAt = function(idx) {
            //			debugger;
            var children = this._parent.querySelectorAll("span.radio3");
            var labelElt = children[idx];
            if (labelElt) {
                //{#bug:392 removeItemAt returns TypeError.}
                var parent = labelElt.parentNode;
                parent.removeChild(labelElt);
            }
        };

        RadioButtonGroup.prototype.setOptionAt = function(idx, key, value) {
            var children = this._parent.querySelectorAll("span.radio3");
            var labelElt = children[idx];
            if (labelElt) {
                var input = labelElt.querySelector("input");
                domAttr.set(input, "value", key);

                var span = labelElt.querySelector("span");
                span.innerHTML = this.view.context.htmlEscape(value);
                utilities.BiDi.applyTextDir(span, span.innerHTML, this.view._instance.baseTxtDir, this.view._instance.genPrefTextDir);
            }
        };

        RadioButtonGroup.prototype.getOptionAt = function(idx) {
            var res;
            var children = this._parent.querySelectorAll("span.radio3");
            var labelElt = children[idx];
            if (labelElt) {
                var input = labelElt.querySelector("input");
                var span = labelElt.querySelector("span");
                res = {
                    idx: idx,
                    text: span.innerHTML,
                    value: domAttr.get(input, "value")
                };
            }

            return res;
        };

        RadioButtonGroup.prototype.getOption = function(val) {
            var children = this._parent.querySelectorAll("span.radio3");
            for (var i = 0; i < children.length; i++) {
                var labelElt = children[i];
                var input = labelElt.querySelector("input");


                var value = domAttr.get(input, "value");

                //{#Bug:391 RadioButtonGroup .removeItem returns val is not working.  Needed to retrieve the value for val rather than name (8/13/15)}
                //var outerspan = labelElt.querySelector("span");
                //var innerText = outerspan.innerHTML;

                //BG-982 function should compare option value or key 
                if (value == val) {
                    var span = labelElt.querySelector("span");
                    var opt = {
                        value: value,
                        text: span.innerHTML,
                        idx: i
                    };

                    return opt;
                }
            }
        };

        RadioButtonGroup.prototype.getSelectedOption = function() {
            var res = null;
            var children = this._parent.querySelectorAll("span.radio3");

            for (var i = 0; i < children.length; i++) {
                var labelElt = children[i];
                var input = labelElt.querySelector("input");
                var checked = input.checked;

                if (checked) {
                    var value = domAttr.get(input, "value");
                    res = {};
                    res.value = value;
                    res.idx = i;

                    break;
                }
            }

            return res;
        };

        RadioButtonGroup.prototype.setDisabled = function(flag) {
            var children = this._parent.querySelectorAll("span.radio3");
            for (var i = 0; i < children.length; i++) {
                var labelElt = children[i];
                var input = labelElt.querySelector("input");
                if (flag)
                    domAttr.set(input, "disabled", "");
                else
                    domAttr.remove(input, "disabled");
            }
        };

        RadioButtonGroup.prototype.clear = function() {
            this._parent.innerHTML = "";
        };

        RadioButtonGroup.prototype.appendOption = function(key, value, checked) {
            if (this.view.context.itemCount === null || this.view.context.itemCount === undefined) {
                this.view.context.itemCount = 0;
            }
            var divElt = document.createElement("div");
            var labelElt = document.createElement("span");
            var input = document.createElement("input");

            domClass.add(labelElt, "radio3");
            domAttr.set(input, "type", "radio");
            domAttr.set(input, "id", "radiogroup-item-input-" + this.view.context.controlidpath + "[" + this.view.context.itemCount + "]");
            //Added for TK-1072
            domAttr.set(input, "role", "radio");
            //domAttr.set(input,"aria-label","Select Radio Button");
            var labelSpanId = "radiogroup-item-label-" + this.view.context.controlidpath + "[" + this.view.context.itemCount + "]";
            domAttr.set(input, "aria-labelledby", labelSpanId);
            //TK-1072 : ENDS			
            domAttr.set(input, "value", key);
            domAttr.set(input, "name", "rbo_" + this.view.context.controlidpath);
            //Added for TK-1072 :STARTS
            
            //TK-1072 : ENDS			

            if (!this.view.isEnabled())
                domAttr.set(input, "disabled", "");

            //US-1340 added tab index
            var tabIndex = this.view.context.options.tabIndex.get("value");
            if (tabIndex != null)
                domAttr.set(input, "tabindex", tabIndex);
            
            // defect 332589
            input.checked = checked;
            domAttr.set(input, "aria-checked", checked.toString());

            var _this = this;

            input.onclick = function(event) {
                var children = _this._parent.querySelectorAll(".radio3"); // {#Bug 822 invalid RBG causes issue, with children.}

                for (var i = 0; i < children.length; i++) {
                    var label = children[i];
                    var input2 = label.children[0];

                    input2.checked = (input == input2);
                }

                if (_this.onclick)
                    _this.onclick(event, input2.checked);
            };

            var span = document.createElement("span");

            span.onclick = function() // BUG 814
            {
                input.click();
            };

            //Added for TK-1072
            domAttr.set(span, "id", labelSpanId);

            //TK-1072 : ENDS
            span.innerHTML = this.view.context.htmlEscape(value);
            utilities.BiDi.applyTextDir(span, span.innerHTML, this.view._instance.baseTxtDir, this.view._instance.genPrefTextDir);

            //var _rdoUid=bpmext.ui.makeUniqueId("rdo");
            //domAttr.set(span,"id",_rdoUid);
            //domAttr.set(input, "aria-labelledby", _rdoUid);

            labelElt.appendChild(input);
            labelElt.appendChild(span);
            divElt.appendChild(labelElt);
            this.view.context.itemCount++;
            this._parent.appendChild(divElt);
        };

        this.constructor.prototype._proto = {
            EVT_ONCHANGE: "eventON_CHANGE",
            EVT_ONSVCITEMS: "eventON_SVCITEMS",
            EVT_ONSVCERROR: "eventON_SVCERROR",
            _getItemIndex: function(view, value) {
                var opt = view._instance.select.getOption(value);
                if (opt)
                    return opt.idx;
                else
                    return -1;
            },
            //{#feature: * Allow leniency for mapping complex-typed items list element to simple-typed bound data}
            _mapBindingValue: function(view, value) {
                if (view.isBound() && view.context.bindingType) {
                    if (value != null) {
                        if(typeof value == "object") {
                            value = value[view._instance._optValProp];
                        }

                        var bType = view.context.bindingType().toUpperCase();
                        switch(bType) {
                            case "STRING":
                                value = value.toString();
                                break;
                            case "INTEGER":
                                value = parseInt(value);
                                break;
                            case "DECIMAL":
                                value = parseFloat(value);
                                break;
                            case "BOOLEAN":
                                if(value === "true"){
                                    value = true;
                                } else if(value === "false"){
                                    value = false;
                                }
                                break;
                        }
                    }
                } else if (!view.isBound() && value !== null && (typeof value == "object")) {
                    value = value[view._instance._optValProp];
                }

                return value;
            },
            _setSelectedItem: function(view, value) {
                view._instance.select.setSelectedOption(value, true);
            },
            _rebindAllUpdates: function(view) {

            },
            _loadListItems: function(view, itemList, selectedValue, keyProp, valueProp) {
                if (view._instance._bindSelUpdHandle)
                    view._instance._bindSelUpdHandle.unbind();

                if (view._instance._bindValueUpdHandle)
                    view._instance._bindValueUpdHandle.unbind();

                if (keyProp == null)
                    keyProp = "name";

                if (valueProp == null)
                    valueProp = "value";

                view._instance._bindValueUpdHandle = itemList.bindAll(
                    function(event) {
                        if (event.insertedInto >= 0 && event.insertedInto != event.removedFrom) {
                            view._proto._rebindAllUpdates(view);

                            if (event.insertedInto == view._instance.select.getOptionsLength()) //If inserted at the end
                            {
                                var item = event.newVal;
                                var selectedValue = this.context.binding.get("value");
                                //Defect 317572 - START
                                if(typeof selectedValue == "boolean") {
                                    selectedValue = selectedValue.toString();
                                }
                                //Defect 317572 - END
                                if (item[keyProp] != undefined) {
                                    var key = item[keyProp];
                                    view._instance.select.appendOption(key, item[valueProp], selectedValue == key);
                                } else {
                                    var key = item;
                                    view._instance.select.appendOption(key, key, selectedValue == key);
                                }
                            } else {
                                //{#feature: US-1330 Added RT localization}
                                //bpmext.log.error("Mid-list inserts not supported by Coach NG API yet");
                                bpmext.log.error(bpmext.localization.formatMsg("general", "MID_LIST_INSERT_COACH_NG_ERROR"));
                            }
                        } else if (event.removedFrom >= 0 && event.removedFrom != event.insertedInto) //List item deletion
                        {
                            view._proto._rebindAllUpdates(view);
                            view._instance.select.removeOptionAt(event.removedFrom);
                        } else if (event.removedFrom >= 0 && event.removedFrom == event.insertedInto) //Just a value change...
                        {
                            if (event.newVal != null && event.newVal[view._instance._optValProp] != undefined) {
                                view._instance.select.setOptionAt(
                                    event.removedFrom,
                                    event.newVal[view._instance._optValProp],
                                    event.newVal[view._instance._optDisProp]
                                );
                            } else if (event.newVal != null) {
                                view._instance.select.setOptionAt(
                                    event.removedFrom,
                                    event.newVal,
                                    event.newVal
                                );
							}
                        }
                    },
                    view
                );

                view._instance._bindSelUpdHandle = itemList.bind(
                    "listAllSelectedIndices",
                    function(event) {
                        var itemKeys = null;
                        var idxs = event.newVal;

                        for (var i = 0; i < idxs.length; i++) {
                            if (view._instance.itemList.items[idxs[i]][keyProp] != undefined) {
                                itemKey = view._instance.itemList.items[idxs[i]][keyProp];
                            } else {
                                itemKey = view._instance.itemList.items[idxs[i]];
                            }
                        }

                        view._proto._setSelectedItem(view, itemKey);
                    },
                    view
                );

                view._instance.select.clear();

                var items = itemList.items;
                /*
                var map = {};
				
                if(selectedValue)
                {
                	for(var i = 0; i < selectedValue.items.length; i++)
                	{
                		map[selectedValue.items[i]] = true;
                	}
                }
                */
               //Defect 317572 - START
                if(typeof selectedValue == "boolean") {
                    selectedValue = selectedValue.toString();
                }
                //Defect 317572 - END
                for (var i = 0; i < items.length; i++) {
                	if (items[i][keyProp] != undefined)	{
                    	var key = items[i][keyProp];
                    	view._instance.select.appendOption(key, items[i][valueProp], selectedValue == key);
                    } else {
                    	var key = items[i];
                    	view._instance.select.appendOption(key, key, selectedValue == key);
                    }
                }
                //BG-844 added handle visibility after list items are loaded to apply parent visibility
                view._proto._handleVisibility(view);
            },
            _updateControl: function(view) {
                var errors = bpmext.ui.getViewValidationErrors(view);

                //Validation Error Icon
                if (view._instance.icon) {
                    bpmext.ui.util.closeTooltip(view._instance.iconTT, view._instance.input);
                    delete view._instance.iconTT;

                    view._instance.input.removeChild(view._instance.icon);
                    delete view._instance.icon;
                }

                if (errors) {
                    domClass.add(view._instance.group, "has-feedback has-error");
                    view._instance.icon = document.createElement("span");
                    view._instance.input.appendChild(view._instance.icon);

					if (view.context.options.showValidationMarker.get("value") === true) {
						domClass.add(view._instance.icon, "fa form-control-feedback fa-exclamation-circle");

                        var ttOpts = {
                            horizontalPos: "right",
                            verticalPos: "top",
                            cssClass: "validationError",
                            plainText: false,
                            smartPositioning: true
                        };

                        view._instance.iconTT = bpmext.ui.util.showTooltip(
                            view._instance.input,
                            bpmext.ui.util.formatErrors(errors),
                            ttOpts
                        );

                        view._instance.errorMessage = document.createElement("div");
                        view._instance.errorMessage.id = view._instance.input.firstElementChild.id + "-error-msg";
                        view._instance.errorMessage.classList.add("hide");
                        view._instance.errorMessage.innerHTML = bpmext.ui.util.formatErrors(errors);
                        view._instance.input.appendChild(view._instance.errorMessage);
                        domAttr.set(view._instance.input.firstElementChild, "aria-describedby", view._instance.errorMessage.id);
                        domAttr.set(view._instance.input.firstElementChild, "aria-invalid", "true");
                    }
                } else {
                        domClass.remove(view._instance.group, "has-feedback has-error");
                    if (view._instance.errorMessage) { view._instance.errorMessage.remove(); }
					domAttr.remove(view._instance.input.firstElementChild, "aria-describedby");
					domAttr.remove(view._instance.input.firstElementChild, "aria-invalid");
                }
            },
            _setLabelPlacement: function(view, newVal, oldVal) {
                if (!oldVal)
                    oldVal = view._instance.oldLblPlc;

                newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
                oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);

                bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
                view._instance.oldLblPlc = newVal;
            },
            _setLabelWidth: function(view, labelWidth) {
                if (labelWidth != null && labelWidth != "") {
                    if (!isNaN(labelWidth))
                        labelWidth += "px";

                    view._instance.label.style.width = labelWidth;
                    domClass.add(view.context.element, "labelWidth");
                } else {
                    if (view._instance.label) {
						view._instance.label.style.width = null;
                    }
                    
                    domClass.remove(view.context.element, "labelWidth");
                }

            },
            _setLabelVisibility: function(view, flag) {
                try {
                    if (!view._instance.label)
                        this._createLabel(view);

                    view.context.setDisplay(flag == "SHOW", view._instance.label);
                } catch (e) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("RadioButtonGroup._setLabelVisibility() error: " + e);
                    bpmext.log.error("RadioButtonGroup._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _createLabel: function(view) {
                //Added for TK-1072
                view._instance.label = document.createElement("span");
                //TK-1072 : ENDS
                domClass.add(view._instance.label, "control-label");
                domConstruct.place(view._instance.label, view._instance.group, "first");
                //Commented for TK-1072
                //domAttr.set(view._instance.label, "for", view._instance.input.id);
                //TK-1072 : ENDS

                //Added for TK-1072
                var lblId = "lbl_" + bpmext.ui.makeUniqueId("");
                domAttr.set(view._instance.label, "id", lblId);
                domAttr.set(view._instance.input, "aria-labelledby", lblId);
                //TK-1072 : ENDS
            },
            _setLabel: function(view, label) {
                try {
                    if (label) {
                        if (!view._instance.label)
                            this._createLabel(view);

                        view._instance.label.innerHTML = view.context.htmlEscape(label);
                        utilities.BiDi.applyTextDir(
                            view._instance.label,
                            view._instance.label.innerHTML,
                            view._instance.baseTxtDir,
                            view._instance.genPrefTextDir
                        );
                    } else {
                        if (view._instance.label) {
                            view._instance.group.removeChild(view._instance.label);
                            delete view._instance.label;
                        }
                    }
                } catch (e) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("RadioButtonGroup._setLabel() error: " + e);
                    bpmext.log.error("RadioButtonGroup._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setHelpText : function (view, text)
			{
				utilities.setHelpText(view, text);
			},
            /*
            _setSizeStyle : function (view, newVal, oldVal)
            {
            	if(!oldVal)
            		oldVal = view._instance.oldSzStyle;

            	bpmext.ui.util.replaceCSSClass(view._instance.select, bpmext.ui.util.OPTS_SZ_STL_CLZ, newVal, oldVal);
            	view._instance.oldSzStyle = newVal;
            	
            	bpmext.ui.util.propagateUpSizeStyle(view, newVal);
            },
            */
            _setWidth: function(view, width) {
                try {
                    if (width != null && width != "") {
                        if (!isNaN(width))
                            width += "px";

                        view.context.element.style.width = width;

                        domClass.add(view.context.element, "widthSet");
                    } else {
                        view.context.element.style.width = null;

                        domClass.remove(view.context.element, "widthSet");
                    }
                } catch (e) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("RadioButtonGroup._setWidth() error: " + e);
                    bpmext.log.error("RadioButtonGroup._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack) {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            //US-1340 added tab index support		
            _setTabIndex: function(view, index) {
                view._instance.select.setTabIndex(index);
            },
            _handleVisibility: function(view) {
                var vis = utilities.handleVisibility(view.context);

                if (vis != "NONE") {
                    view._instance.select.setDisabled(vis == "READONLY");
                    //Added for TK-1072
                    if (vis == "REQUIRED")
                        domAttr.set(view._instance.input, "aria-required", "true");
                    else
                        domAttr.set(view._instance.input, "aria-required", "false");
                    //TK-1072 : ENDS
                }
            }
        };

        /*
        Public control methods *************************************************************
         */

        /**
         * @instance
         * @memberof RadioButtonGroup
         * @method setLabel
         * @param {string} label Label for the control
         * @desc Set label for radio button group control
         */
        this.constructor.prototype.setLabel = function(text) {
            this.context.options._metadata.label.set("value", text);
        };

        /**
         * @instance
         * @memberof RadioButtonGroup
         * @method getLabel
         * @desc Get label associated with radio button group control
         * @returns {string}
         */
        this.constructor.prototype.getLabel = function() {
            return this.context.options._metadata.label.get("value");
        };

        /**
         * @instance
         * @memberof RadioButtonGroup
         * @method setLabelPlacement
         * @param {string} placement "T"|"TOP"=Top | "L"|"LEFT"=Left 

        this.constructor.prototype.change = function(event) {
            try {
                if (event.type == "config") {
                    switch (event.property) {
                        case "_metadata.label":
                            {
                                this._proto._setLabel(this, event.newVal);
                                this._proto._setHelpText(this, this.context.options._metadata.helpText.get("value"));
                                break;
                            }
                        case "_metadata.visibility":
                            {
                                this._proto._handleVisibility(this);
                                break;
                            }
                        case "_metadata.labelVisibility":
                            {
                                this._proto._setLabelVisibility(this, event.newVal);
                                break;
                            }
                        case "width":
                            {
                                this._proto._setWidth(this, event.newVal);
                                break;
                            }
                        case "labelPlacement":
                            {
                                this._proto._setLabelPlacement(this, event.newVal);
                                break;
                            }
                        case "labelWidth":
                            {
                                this._proto._setLabelWidth(this, event.newVal);
                                break;
                            }
                        case "_metadata.helpText":
	                        {
								this._proto._setHelpText(this, event.newVal);
	                            this._proto._updateControl(this);
	                            break;
	                        }
                            //US-1340 added support for tab index
                        case "tabIndex":
                            {
                                this._proto._setTabIndex(this, event.newVal);
                                break;
                            }
                        case "itemList":
                            {
                                var lookupMode = this.context.options.itemLookupMode.get("value");
                                // Only populate if lookup mode is "Items from Config Option" or "Start Empty"
                                if (lookupMode == "B" || lookupMode == "E") {
                                    this._instance.itemList = this.context.options.itemList.get("value");
                                    this._proto._loadListItems(this, this._instance.itemList, this.context.binding.get("value"), this._instance._optValProp, this._instance._optDisProp, this._instance._busValProp, this._instance._busDisProp);
                                }
                                break;
                            }
                        case "staticList":
                            {
                                this._instance.itemList = this.context.options.staticList.get("value");
                                this._proto._loadListItems(this, this._instance.itemList, this.context.binding.get("value"));
                                break;
                            }
                            case "inputData":
                            {
								if (this.context.options.disableAutoCall.get("value")) {
									// The view is configured to disable automatic calling of the service
									break;
								}
                            	if(event.newVal != event.oldVal) {
	                            	this.reloadServiceItems(event.newVal);
	                                if(this.context.binding.get("value")) {
	                                    this.context.binding.set("value", "");
	                                }
                                }
                            	break;
                            }
                    }
                } else {
                    this._proto._setSelectedItem(this, event.newVal);

                    if (event.newVal != event.oldVal)
                        bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE, this._instance.onClear);
					
					this._instance.onClear = "false";
                }
            } catch (e) {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.validate = function(event) {
            try {
                bpmext.ui.updateViewValidationState(this, event);

                this._proto._updateControl(this);

                if (this._instance.vc)
                    this._instance.vc.validate(event);
            } catch (e) {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on validate event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        /*
        this.constructor.prototype.collaboration = function (event)
        {
        };
        */

        this.constructor.prototype.unload = function() {
            if (this._instance._bindSelUpdHandle)
                this._instance._bindSelUpdHandle.unbind();

            if (this._instance._bindValueUpdHandle)
                this._instance._bindValueUpdHandle.unbind();

            bpmext.ui.unloadView(this);
        };
    }
};
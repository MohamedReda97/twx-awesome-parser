function spark_dd_prepareQuery()
{
	//Populate XML doc with drilldown stack values
	var _escapeJavascript = function(str)
	{
		str = str.replace(/\\/mg, "\\\\");
		str = str.replace(/'/mg, "\\'");
		return str;
	}

	var _getDrillDownStack = function(targetElt)
	{
	//    log.error("%%%%% In _getDrillDownStack - target elt: " + targetElt);

		//targetElt = new tw.object.XMLElement();
		var _res = new tw.object.listOf.DataDimension();
		var _tmp = targetElt;
		
		do
		{
			if(_tmp != null && _tmp.tagName == "drilldown")
			{
				var dd = new tw.object.DataDimension();
				dd.name = _tmp.getAttribute("name");
				dd.value = _tmp.getAttribute("value");
				
				_res[_res.length] = dd;
				
				//log.error("%%%%% Added: " + dd);
			}
			_tmp = _tmp.parentNode;
		}
		while(_tmp != null);

		var _res2 = new tw.object.listOf.DataDimension();
		var j = 0;
		for(var i = _res.length - 1; i >= 0 ; i--)
		{
			_res2[j] = _res[i];
			j++;
		}
		
		return _res2;
	}

	var _lookupName = function(xmlElt, ref)
	{
		var _res = null;
		
		//xmlElt = new tw.object.XMLElement();
		var _upDistArr = ref.split("../");
		var _upDist = _upDistArr.length - 1; //TODO Poor parsing!! Fix after concept further along...
		var ref = _upDistArr[_upDist];
		
		if(xmlElt.tagName != "drilldown")
			_upDist++;
		
		//log.error("UpDist: " + _upDist + " - ref: " + ref);
		
		var xmlTarget = xmlElt;
		
		for(var i = 0; i < _upDist && xmlTarget != null;)
		{
			xmlTarget = xmlTarget.parentNode;
			if(xmlTarget != null && xmlTarget.tagName == "drilldown")
			{
				i++;
			}
		}
		
		if(xmlTarget != null)
		{
			_res = xmlTarget.getAttribute("name");
		}
		
		//log.error("Looked up name " + ref + " from <" + xmlElt.tagName + " name='" + xmlElt.getAttribute("name") + "'>: " + _res);
		
		return _res;
	};

	var _lookupValue = function(xmlElt, ref)
	{
		var jsPfx = "javascript:";
		var _res = null;
		var inputRef = null;
		//xmlElt = new tw.object.XMLElement();
		
		if(ref.indexOf(jsPfx) == 0)
		{
			_res = ref.substring(jsPfx.length);
			//log.error("Evaluating JS expression: " + _res);
			_res = eval(_res);
		}
		else
		{
			var _upDistArr = ref.split("../");
			var _upDist = _upDistArr.length - 1; //TODO Poor parsing!! Fix after concept further along...
			var ref = _upDistArr[_upDist];
			
			if(xmlElt.tagName != "drilldown")
				_upDist++;
			
			//log.error("UpDist: " + _upDist + " - ref: " + ref);
			
			var xmlTarget = xmlElt;
			
			for(var i = 0; i < _upDist && xmlTarget != null;)
			{
				xmlTarget = xmlTarget.parentNode;
				if(xmlTarget != null && xmlTarget.tagName == "drilldown")
				{
					i++;
				}
			}
			
			if(xmlTarget != null)
			{
				_res = xmlTarget.getAttribute("value");
			}    
		}
		
		//log.error("Looked up value " + ref + " from <" + xmlElt.tagName + " name='" + xmlElt.getAttribute("name") + "'>: " + _res);
		
		return _res;
	};

	var _isMatch = function(xmlElt, drillDownName)
	{
		//log.error(">> _isMatch(" + xmlElt.tagName + ", " + drillDownName + ")");
		
		var _res = false;
		var _ddName = xmlElt.getAttribute("name");
		
		do
		{
			if(_ddName != drillDownName)
			{
				break;
			}
			
			var _condField = xmlElt.getAttribute("cond-field");
			if(_condField != null)
			{
				var _condOperator = xmlElt.getAttribute("cond-operator");
				var _condValue = xmlElt.getAttribute("cond-value");
				
	//            var refField = _lookupName(xmlElt, _condField);
				var refVal = _lookupValue(xmlElt, _condField);
				
				if(_condOperator == null || _condOperator == "eq")
				{
					//log.error("  condField: = " + _condField);
	//                log.error("  refField: = " + refField);
					//log.error("  condValue: = " + _condValue);
					//log.error("  refVal: = " + refVal);
					
					if(_condValue != refVal)
					{
						break;
					}
				}
			}
		
			_res = true;
		} 
		while(false);

		//log.error("<< IsMatch: Evaluated match for <" + xmlElt.tagName + " name='" + xmlElt.getAttribute("name") + "'> with drillDownName: " + drillDownName + " - res = " + _res);

		return _res;    
	};

	var _getAvailableForDrillDown = function(parentDrillDown)
	{
		var _res = new tw.object.listOf.DataDimension();
		//parentDrillDown = new tw.object.XMLElement();
		var _drillDowns = parentDrillDown.getElementByTagName("drilldown");
		var _testMap = {};
		
		for(var i = 0; i < _drillDowns.length; i++)
		{
		  var _name = _drillDowns[i].getAttribute("name");
		  if(_testMap[_name])
			  continue;
		  
		  _testMap[_name] = true;
		  
		  var dd = new tw.object.DataDimension();
		  
		  dd.name = _name;
		  dd.value = "*";
		  
		  _res[_res.length] = dd;
		}
		
		return _res;
	};
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var _drillDownStack = tw.local.drillDownStack;
	tw.local.drillDownStack = new tw.object.listOf.DataDimension();
	tw.local.dataSeries = new tw.object.DataSeries();

	var _xmlDoc = new tw.object.XMLDocument(tw.local.xml);
	var _node = _xmlDoc.getElementByTagName("drilldown-spec");
	var _target = null;

	if(_drillDownStack != null && _drillDownStack.listLength > 0) //Echoed back by Chart
	{
		for(var i = 0; i < _drillDownStack.listLength; i++)
		{
			var _ddLevel = _drillDownStack[i];
			var _dimName = _ddLevel.name;
			var _ddValue = _ddLevel.value;
			
			var dds = _node.getElementByTagName("drilldown");
			for(var j = 0; j < dds.length; j++)
			{
				var dd = dds[j];
				
				if(_isMatch(dd, _dimName))
				{
					dd.setAttribute("value", _ddValue); //Save intermediate drill down value

					var _ddName = dd.getAttribute("name");
					//log.error("DD name: " + _ddName + " --> " + _ddValue + " (level: " + i + ")");

					var dd1 = new tw.object.DataDimension();
					tw.local.drillDownStack[tw.local.drillDownStack.listLength] = dd1;
					dd1.name = _ddName;
					
					if(i == _drillDownStack.listLength - 1)
					{
						dd1.value = "*";
					}
					else
					{
						dd1.value = _ddValue;
					}
					
					_node = dd;
					_target = dd;
					break;    
				}
			}
		}
	}
	else
	{
		_target = _node.getElementByTagName("drilldown")[0];
	}

	if(_target != null)
	{
		tw.local.drillDownStack = _getDrillDownStack(_target);
		
		var _query = _target.getElementByTagName("sql-query");
		if(_query != null && _query.length > 0)
		{
			_query = _query[0];
			tw.local.queryType = "SQL";
			tw.local.dataSeries.seriesName = _query.getAttribute("description");
			tw.local.sqlParams = new tw.object.listOf.SQLParameter();
			tw.local.availableForDrillDown = _getAvailableForDrillDown(_target);

			var _sql = _query.getElementByTagName("sql")[0];
			if(_sql != null)
				_sql = _sql.getText();
				
			//log.error("  SQL: " + _sql);
			tw.local.logic = _sql;
			
			var in0 = _query.getElementByTagName("in");
			if(in0.length > 0)
			{
				in0 = in0[0];
				var _fieldElts = in0.getElementByTagName("field");
				
				for(var j = 0; j < _fieldElts.length; j++)
				{
					var _field = _fieldElts[j];
					tw.local.sqlParams[j] = new tw.object.SQLParameter();
					tw.local.sqlParams[j].mode = "IN";
					tw.local.sqlParams[j].value = _lookupValue(_field, _field.getAttribute("ref"));
					tw.local.sqlParams[j].type = _field.getAttribute("type");
				}
			}

			//log.error("SQL Params: " + tw.local.sqlParams);

			var out0 = _query.getElementByTagName("out");
			if(out0.length > 0)
			{
				out0 = out0[0];
				var labelElt = out0.getElementByTagName("label")[0];
				tw.local.labelCol = new tw.object.NameValuePair();
				tw.local.labelCol.name = labelElt.getAttribute("field");
				
				var valueElt = out0.getElementByTagName("value")[0];
				tw.local.valueCol = new tw.object.NameValuePair();
				tw.local.valueCol.name = valueElt.getAttribute("field");
			}
		}
		else
		{
			var _query = _target.getElementByTagName("js-query");
			if(_query != null && _query.length > 0)
			{
				_query = _query[0];
				tw.local.queryType = "JS";
				tw.local.dataSeries.seriesName = _query.getAttribute("description");
				tw.local.availableForDrillDown = _getAvailableForDrillDown(_target);

				var _js = _query.getElementByTagName("script")[0];
				if(_js != null)
					_js = _js.getText();

				var _jsCode = "";
				
				var in0 = _query.getElementByTagName("in");
				if(in0.length > 0)
				{
					in0 = in0[0];
					var _fieldElts = in0.getElementByTagName("field");
					
					for(var j = 0; j < _fieldElts.length; j++)
					{
						var _field = _fieldElts[j];
						_jsCode += "var " + _field.getAttribute("var") + "='" + _escapeJavascript(_lookupValue(_field, _field.getAttribute("ref"))) + "';";
					}
				}

				_jsCode += _js;
				//log.error("  Javascript: " + _jsCode);

				tw.local.logic = _jsCode;
			}    
		}
	}
}
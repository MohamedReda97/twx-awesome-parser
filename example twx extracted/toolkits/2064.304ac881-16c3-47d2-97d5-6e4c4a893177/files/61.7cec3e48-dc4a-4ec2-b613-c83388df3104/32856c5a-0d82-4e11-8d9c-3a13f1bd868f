bpmext_control_InitAlerts = function (utilities, bpmext, domClass)
{
	this._instance =
	{
	};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONALERTCLICK : "eventON_ALERTCLICK",
			EVT_ONALERTCLOSE : "eventON_ALERTCLOSE",
			EVT_ONALERTEXPIRED : "eventON_ALERTEXPIRED",
			//{#feature: * Added support for Primary color style}
			ALRT_STL_MAP : 
			{
				"P" : "alert-primary",
				"S" : "alert-success",
				"I" : "alert-info",
				"W" : "alert-warning",
				"E" : "alert-danger",
				"D" : "alert-danger"
			},
			ALRT_ICON_MAP: 
			{
				"S": "ci-checkmark-filled",
				"W": "ci-warning-filled",
				"D": "ci-error-filled",
				"E": "ci-error-filled"
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);

				view.context.setDisplay(visibility != "NONE", view.context.element);
				view.context.setVisibility(visibility != "HIDDEN", view.context.element);
			},
			_closeAlert: function(view, alertObj)
			{
				var alertDivWrapper = alertObj.element;
				
				if(!alertObj.closed)
				{
					alertObj.closed = true;
					if(view.context.options.animate.get("value"))
					{
						alertDivWrapper.style.height = alertDivWrapper.scrollHeight + "px";
						domClass.replace(alertDivWrapper, "collapsing", "collapse in");

						setTimeout(function(){
							alertDivWrapper.style.height = 0;

							setTimeout(function()
							{
								alertDivWrapper.parentNode.removeChild(alertDivWrapper);
								
							}, 350 //Length of CSS transition duration (0.35s)
							);							
						}, 50);	
					}
					else
					{
						alertDivWrapper.parentNode.removeChild(alertDivWrapper);
					}
				}
			},
			_setDense: function(view)
			{
				if(view.context.options.dense.get("value"))
					domClass.add(view.context.element, "dense");
				else
					domClass.remove(view.context.element, "dense");				
			},
			_setAlertStyle: function(view, alertObj, style)
			{
				var cls = "alert";
				if(view.context.options.darkStyle.get("value"))
					cls += " alert-dark";
				
				if(style == null)
					style = view.context.options.alertColorStyle.get("value");
				
				cls += " " + this.ALRT_STL_MAP[bpmext.ui.util.normalizeColorStyle(style)];

				var alertDiv = alertObj.element.firstChild;
				alertDiv.className = cls;
			},
			_setIcon: function(view, alertObj, style, iconSetting) {
				var showIcon = iconSetting? iconSetting.showIcon : undefined;
				var iconName = iconSetting? iconSetting.iconName : undefined;
				
				if (showIcon === false) {
					return;
				}
				
				var alertDiv = alertObj.element.firstChild;
				var getAlertIcon = function (view, style) 
				{
					if (!view._instance.iconMap) 
						view._instance.iconMap = dojo.clone(view._proto.ALRT_ICON_MAP);
					
					// Use default setting id style is not defined
					style = style || view.context.options.alertColorStyle.get("value");
				
					var colorStyle = bpmext.ui.util.normalizeColorStyle(style);
					return view._instance.iconMap[colorStyle];
				}

				if(view.context.options.showIcon.get("value") || showIcon) 
				{
					var alertIcon = iconName || getAlertIcon(view, style);
					var iconWrapper = alertDiv.querySelector("div.alert-icon");
					
					if (alertIcon && !!iconWrapper) 
					{
						var icon = utilities.getCarbonIcon(alertIcon);
						if (!!icon) {
							iconWrapper.appendChild(icon);
							alertDiv.setAttribute("class", alertDiv.getAttribute("class") + " showIcon");
						}
					}
				}
			},
			_appendAlert: function(view, title, text, style, timeout, id, data, iconSetting)
			{
				var alertDivWrapper = document.createElement("div");
				alertDivWrapper.setAttribute("role", "alert");
				domClass.add(alertDivWrapper, "alert-wrapper");
				
				var alertDiv = document.createElement("div");
				
				alertDivWrapper.appendChild(alertDiv);
				
				if(id == null)
					id = bpmext.ui.makeUniqueId("ALERT");
				
				if(timeout == null)
					timeout = view.context.options.autoFadeDelay.get("value");
				
				var button = document.createElement("button");
				
				button.setAttribute("type", "button");
				if (utilities.getActiveTheme() === '"CARBON"') {
					domClass.add(button, "ci close");
					button.appendChild(utilities.getCarbonIcon("ci-close"));
				} else {
					domClass.add(button, "fa fa-close close");
				}
				alertDiv.appendChild(button);
				button.setAttribute("aria-label", bpmext.localization.formatMsg("controlAlerts", "CLOSE"));
				
				var strong = document.createElement("strong");
				strong.innerHTML = view.context.htmlEscape(title);
				alertDiv.appendChild(strong);
				
				var span = document.createElement("span");
				span.innerHTML = view.context.htmlEscape(text);
				alertDiv.appendChild(span);
				
				var showIcon = iconSetting? iconSetting.showIcon : undefined;
				if(showIcon !== false)
				{
					if (showIcon || view.context.options.showIcon.get("value")) 
					{
						var alertIconWrapper = document.createElement("div");

						domClass.add(alertIconWrapper, "alert-icon");
						alertDiv.appendChild(alertIconWrapper);
					}
				}

				view._instance._alertsCnt.appendChild(alertDivWrapper);
				
				var alertObj = {
					title: title, 
					text: text, 
					style: style, 
					element: alertDivWrapper,
					id: id,
					data: data,
					setText: function(text)
					{
						this.text = text;

						if(!this.closed)
						{
							//var span = this.element.querySelector("span");
							span.innerHTML = view.context.htmlEscape(text);
							
							utilities.BiDi.applyTextDir(
								span, 
								span.innerHTML, 
								view._instance.baseTxtDir, 
								view._instance.genPrefTextDir
							);							
						}
					},
					setTitle: function(title)
					{
						this.title = title;

						if(!this.closed)
						{
							//var strong = this.element.querySelector("strong");
							strong.innerHTML = view.context.htmlEscape(title);
							
							utilities.BiDi.applyTextDir(
								strong, 
								strong.innerHTML, 
								view._instance.baseTxtDir, 
								view._instance.genPrefTextDir
							);							
						}
					},
					setStyle: function(style)
					{
						this.style = style;
						
						if(!this.closed)
							view._proto._setAlertStyle(view, this, style);
					},
					close: function()
					{
						view._proto._closeAlert(view, this);
						if(this.timeoutHandle != null)
						{
							clearTimeout(this.timeoutHandle);
							delete this.timeoutHandle;
						}
					}
				};
				
				view._proto._setAlertStyle(view, alertObj, style);
				view._proto._setIcon(view, alertObj, style, iconSetting);
				
				alertDivWrapper.__alertObj = alertObj;

				button.onclick = function(event) {
					var proceedWithClose = bpmext.ui.executeEventHandlingFunction(
						view, 
						view._proto.EVT_ONALERTCLOSE, 
						alertObj
						);
					
					if(proceedWithClose)
						alertObj.close();
					
					event.stopPropagation();
					return false;
				}
				
				if(view.context.options.animate.get("value"))
				{
					domClass.replace(alertDivWrapper, "collapsing", "collapse in");
					
					setTimeout(function(){
						alertDivWrapper.style.height = alertDivWrapper.scrollHeight + "px";

						setTimeout(function(){
							domClass.replace(alertDivWrapper, "collapse in", "collapsing");							
							alertDivWrapper.style.height = "auto";
						}, 350 //Length of CSS transition duration (0.35s)
						);
					}, 50);
				}
				
				if(timeout > 0)
				{
					alertObj.timeoutHandle = setTimeout(function(){
						view._proto._closeAlert(view, alertObj);
						bpmext.ui.executeEventHandlingFunction(
							view, 
							view._proto.EVT_ONALERTEXPIRED, 
							alertObj
							);
					}, timeout);
				}
				
				alertDiv.onclick = function(event) {
					bpmext.ui.executeEventHandlingFunction(
						view, 
						view._proto.EVT_ONALERTCLICK, 
						alertObj
						);
				}
				
				return alertObj;
			}
		};

		/*
		Public control methods *************************************************************
		 */

		/**
		 * @instance
		 * @memberof Alerts
		 * @method clear
		 * @desc Closes all current alerts
		 */
		this.constructor.prototype.clear = function ()
		{
			var alerts = this.context.element.querySelectorAll(".alert-wrapper");
			
			for(var i = 0; i < alerts.length; i++)
			{
				var alert = alerts[i].__alertObj;
				alert.close();
			}
		}
		
		/**
		 * @instance
		 * @memberof Alerts
		 * @method appendAlert
		 * @param {string} title Alert title
		 * @param {string} text Alert text
		 * @param {string} style "S"=Success | "I"=Info | "P"=Primary | "W"=Warning | "D"=Danger
		 * @param {integer} timeout time (in milliseconds) before alert automatically closes
		 * @param {string} id unique id for this alert
		 * @param {ANY} data any extra data to associate with this alert
		 * @param {boolean} iconSetting.showIcon config option to control showing icon, if the value is not set then use default value (carbon theme only)
		 * @param {string} iconSetting.iconName config option for setting icon for current instance of alert, if the value is not set then use default value (carbon icon only)
		 * @desc Add an alert to list of alerts
		 * @returns {string}
		 */ 
		this.constructor.prototype.appendAlert = function (title, text, style, timeout, id, data, iconSetting)
		{
			return this._proto._appendAlert(this, title, text, style, timeout, id, data, iconSetting);
		}
		
		/**
		 * @instance
		 * @memberof Alerts
		 * @method getAlert
		 * @param {string} id ID of the alert to get
		 * @desc Get specific alert by id
		 * @returns {AlertObj} returns an Alert object, which includes title, text, style, id, and data
		 */
		this.constructor.prototype.getAlert = function (id)
		{
			var alerts = this.context.element.querySelectorAll(".alert-wrapper");
			
			for(var i = 0; i < alerts.length; i++)
			{
				var alert = alerts[i].__alertObj;
				if(alert.id == id)
					return alert;
			}
		}
		 
		/**
		 * @instance
		 * @memberof Alerts
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "alerts.3";
		}

		/**
		 * @instance
		 * @memberof Alerts
		 * @method enableAlertIcon
		 * @param {boolean} show displaying icon
		 * @desc Change default showing icon value, applied for all alerts afterwards (if icon is valid)
		 */ 
		this.constructor.prototype.enableAlertIcon = function (show)
		{
			this.context.options.showIcon.set("value", !!show);
		}

		/**
		 * @instance
		 * @memberof Alerts
		 * @method setAlertIcon
		 * @param {string} style "S"=Success | "I"=Info | "P"=Primary | "W"=Warning | "D"=Danger
		 * @param {string} iconName A carbon icon name
		 * @desc Changing the default alert icon under different style, applying to all the alerts with same style afterwards
		 */ 
		this.constructor.prototype.setAlertIcon = function (style, iconName)
		{
			if (!this._instance.iconMap) 
				this._instance.iconMap = dojo.clone(this._proto.ALRT_ICON_MAP);

			this._instance.iconMap[style] = iconName;
		}

		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;

				if(!opts.alertTopics)
					opts.alertTopics = bpmext.ui.substituteConfigOption(this, "alertTopics", {items: ["GENERAL"]});

				if(!opts.autoFadeDelay)
					opts.autoFadeDelay = bpmext.ui.substituteConfigOption(this, "autoFadeDelay", null);

				if(!opts.darkStyle)
					opts.darkStyle = bpmext.ui.substituteConfigOption(this, "darkStyle", false);
				
				if(!opts.dense)
					opts.dense = bpmext.ui.substituteConfigOption(this, "dense", false);

				if(!opts.animate)
					opts.animate = bpmext.ui.substituteConfigOption(this, "animate", false);
				
				if(!opts.alertColorStyle)
					opts.alertColorStyle = bpmext.ui.substituteConfigOption(this, "alertColorStyle", "P");

				if(!opts.showIcon)
					opts.showIcon = bpmext.ui.substituteConfigOption(this, "showIcon", false);
				
				this._instance._alertsCnt = this.context.element;
				
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONALERTCLICK, "item");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONALERTEXPIRED, "item");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONALERTCLOSE, "item");

				this._proto._setDense(this);

				bpmext.ui.loadView(this);
				
				var view = this;
				var topics = opts.alertTopics.get("value");
				if(topics != null && topics.items != null && topics.items.length > 0)
				{
					//TODO use toic map to ensure no duplicates
					var topicMap = {};
					
					for(var i = 0; i < topics.items.length; i++)
					{
						var topic = topics.items[i];
						if(topic == null || topic == "" || topic == "*")
							topic = "GENERAL";
						
						if(!topicMap[topic])
						{
							bpmext.ui.addEventSubscription("ALERT*" + topic, function(eventName, payload){
								view._proto._appendAlert(view, payload.title, payload.text, payload.style, payload.timeout, payload.id, payload.data, payload.iconSetting);
			
							},view);
						
							topicMap[topic] = true;
						}
					}
				}
				else
				{
					bpmext.ui.addEventSubscription("ALERT*GENERAL", function(eventName, payload){
						view._proto._appendAlert(view, payload.title, payload.text, payload.style, payload.timeout, payload.id, payload.data, payload.iconSetting);
					},view);
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
                        case "dense":
                        {
                            this._proto._setDense(this);
                            break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}
}

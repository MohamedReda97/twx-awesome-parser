/**
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the tooltip is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setToolTipVisible(true)<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Click:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the tooltip is clicked.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setText("You clicked me!")<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitTooltip = function (bpmext, utilities, domClass, domAttr, domConstruct, domGeometry)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype.IS_ADDRESS_INVISIBLE = true;
		
		this.constructor.prototype._proto =
		{
			EVT_ONCLICK : "eventON_CLICK",
			_handleVisibility : function (view)
			{
				var visibility = utilities.handleVisibility(view.context);
				if (view._instance._anchor && view._instance._tt) {
					bpmext.ui.util.refreshTooltipPosition(view._instance._tt, view._instance._anchor);
				}
			},
			_updateControl : function(view)
			{
				if(view._instance._tt) {
					bpmext.ui.util.closeTooltip(view._instance._tt, view._instance._anchor);
					delete view._instance._tt;
				}
				
				if (!view.context.options.showTooltip.get("value") && !view.context.options.showOnHover.get("value")) {
					return;
				}

				//Defect#284159 - START
				var getVerticalPosition = function(tooltip) {
					if (!tooltip) {
						return;
					}
					var verticalPos = view.context.options.verticalPos.get("value");
					
					var position = domGeometry.position(view._instance.inner);
					var top = position.y; //Position of nested element from the top

					var tooltipPosition = domGeometry.position(view._instance._tt);
                    var tooltipHeight = tooltipPosition.h; //Tooltip height
                    
                    var tooltipDistance = window.pageYOffset + top; //Distance of tooltip from top of the page
                    
                    if (tooltipDistance < tooltipHeight) {
                        verticalPos = 'B';
                    }
					
					return verticalPos;
				};
				//Defect#284159 - END

				var delTT = true;
				do
				{	
					var text = view.context.options._metadata.helpText.get("value");
					if(!text)
						break;
					
					text = bpmext.text.trim(text);
					if(text.length == 0)
						break;

					var verticalPos = view.context.options.verticalPos.get("value");
					var ttOpts = {
							colorStyle: view.context.options.colorStyle.get("value"),
							sizeStyle: view.context.options.sizeStyle.get("value"),
							horizontalPos: view.context.options.horizontalPos.get("value"),
							verticalPos: verticalPos,
							plainText: !view.context.options.htmlText.get("value"),
							alwaysShow: view.context.options.showTooltip.get("value")
						};

					if(view.context.options[this.EVT_ONCLICK])
						ttOpts.callback = function(event){
							var visibility = bpmext.ui.getEffectiveVisibility(view);
							if (visibility != "READONLY"){
								bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONCLICK);
							}
						};

					view._instance._tt = bpmext.ui.util.showTooltip(
						view._instance._anchor,
						text,
						ttOpts
					);
						
					delTT = false;
				}
				while(false);
					
				if(delTT)
					delete view._instance._tt;
			},
			_setLabelVisibility : function (view, flag)
			{
                /* {#feature: 357 changes to enable responsiveness in showlabel. also, i think some of this logic might be flawed anyways} */
				try
				{
					if(!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
        
					if (view.context.options._metadata.labelVisibility.get("value") == "HIDE" && flag == "SHOW") {
					    bpmext.log.warn("Tooltip Show Label config option overrides Label Visibility setting", view);
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Tooltip._setLabelVisibility() error: " + e);
					bpmext.log.error("Tooltip._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_getUID : function (view)
			{
				if(view._instance._viewUid == null)
					view._instance._viewUid = bpmext.ui.makeUniqueId("TT");

				return view._instance._viewUid;
			},
			_createLabel : function (view)
			{
				//view._instance.label = document.createElement("label");
				//Added for TK-1275 : STARTS
				view._instance.label = document.createElement("span");
				//TK-1275 : ENDS
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.outer, "first");
				
				//{#feature: US-696 ARIA labeling}
				if(view._instance.ariaLabelTarget != null)
				{
					var lblId = "ttp-lbl-" + this._getUID(view);

					domAttr.set(view._instance.label, "id", lblId);
					domAttr.set(view._instance.ariaLabelTarget, "aria-labelledby", lblId);
					
					if(view._instance.ariaLabelTarget.nodeName == "BUTTON" || view._instance.ariaLabelTarget.nodeName == "A")
						domAttr.remove(view._instance.ariaLabelTarget, "aria-labelledby");
				}
				//End US-696
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
						);
					}
					else
					{
						if(view._instance.label)
						{
							view._instance.outer.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Tooltip._setLabel() error: " + e);
					bpmext.log.error("Tooltip._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				
				bpmext.ui.util.replaceCSSClass(view._instance.outer, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			_setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else 
				{
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}
					
					domClass.remove(view.context.element, "labelWidth");
				}
					
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;
						
						domClass.add(view.context.element, "widthSet");
					}
					else
					{
						view.context.element.style.width = null;

						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Tooltip._setWidth() error: " + e);
					bpmext.log.error("Tooltip._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			}			
		};

		/*
		Public control methods *************************************************************
		 */
		 
		/**
		 * @instance
		 * @memberof Tooltip
		 * @method setText
		 * @param {string} text text of the tooltip
		 * @desc Set text for the tooltip
		 */
		this.constructor.prototype.setText = function (text)
		{
			this.context.options._metadata.helpText.set("value", text);
		};

		/**
		 * @instance
		 * @memberof Tooltip
		 * @method getText
		 * @desc Get text for tooltip
		 * @returns {string}
		 */
		this.constructor.prototype.getText = function ()
		{
			return this.context.options._metadata.helpText.get("value");
		};

		/**
		 * @instance
		 * @memberof Tooltip
		 * @method setTooltipVisible
		 * @param {boolean} visible visibility of the tooltip
		 * @desc Set visibility for the tooltip control
		 */
		this.constructor.prototype.setTooltipVisible = function (vis)
		{
			this.context.options.showTooltip.set("value", vis);
		};

		/**
		 * @instance
		 * @memberof Tooltip
		 * @method isTooltipVisible
		 * @desc Get visibility for tooltip
		 * @returns {boolean}
		 */
		this.constructor.prototype.isTooltipVisible = function ()
		{
			return this.context.options.showTooltip.get("value");
		};
//{#feature: * added setLabelPlacement method}		
		/**
		 * @instance
		 * @memberof Tooltip
		 * @method setLabelPlacement
		 * @param {string} placement "T"|"TOP"=Top | "L"|"LEFT"=Left
		 * @desc Set label placement for control.  NOTE: to avoid ambiguity always set the label placement using "T"|"L"
		 */
		this.constructor.prototype.setLabelPlacement = function (plc)
		{
			this.context.options.labelPlacement.set("value", plc);
		};
//{#feature: * added getLabelPlacement method}		
		/**
		 * @instance
		 * @memberof Tooltip
		 * @method getLabelPlacementt
		 * @desc Get label placement for control.  NOTE: This always returns the label placement as set, to avoid ambiguity always set the label placement using "T"|"L"
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelPlacement = function ()
		{
			return this.context.options.labelPlacement.get("value");
		};

		/**
		 * @instance
		 * @memberof Tooltip
		 * @method getLabelWidth
		 * @desc Get label width of Tooltip control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelWidth = function ()
		{
			return this.context.options.labelWidth.get("value");
		};
		
		/**
		 * @instance
		 * @memberof Tooltip
		 * @method setLabelWidth
		 * @param {string} labelWidth Control's label width
		 * @desc Set label width of Tooltip control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setLabelWidth = function (labelWidth)
		{
			this.context.options.labelWidth.set("value", labelWidth);
		};

		/**
		 * @instance
		 * @memberof Tooltip
		 * @method setColorStyle
		 * @param {string} style "DEFAULT"|"DEF"|"D"=Default | PRIMARY"|"P"=Primary | "INFO"|INF"|"I"=Info | "SUCCESS"|"S"=Success | "WARNING"|"WARN"|"W"=Warning | "ERROR"|"ERR"|"DANGER"|"E"|"G"=Danger 
		 * @desc Sets color style of the tooltip.  NOTE: to avoid ambiguity always set the color using "D"|P"|"I"|"S"|"W"|"G"	
		 */
		this.constructor.prototype.setColorStyle = function (style)
		{
			return this.context.options.colorStyle.set("value", style);
		};

		/**
		 * @instance
		 * @memberof Tooltip
		 * @method getColorStyle
		 * @desc Gets color style of the tooltip.  NOTE: This always returns the color as set, to avoid ambiguity always set the color using "D"|"P"|"I"|"S"|"W"|"G"
		 * @returns {string} 
		 */
		this.constructor.prototype.getColorStyle = function ()
		{
			return this.context.options.colorStyle.get("value");
		};
		
		/**
		 * @instance
		 * @memberof Tooltip
		 * @method setSizeStyle
		 * @param (string) style "Default"|"DEF"|"D"=Default | "LARGE"|"L"=Large | "EXTRA-SMALL"|"X-SMALL"|"XS"=Extra-Small
		 * @desc Sets font-size style of the tooltip. NOTE: to avoid ambiguity always set the font-size using "D"|"L"|"X"
		 */
		this.constructor.prototype.setSizeStyle = function (style)
		{
			return this.context.options.sizeStyle.set("value", style);
		};
		
		/**
		 * @instance
		 * @memberof Tooltip
		 * @method getSizeStyle
		 * @desc Gets font-size style of the tooltip. NOTE: This always returns the font-size as set, to avoid ambiguity always set the color using "D"|"L"|"X"
		 * @returns (string)
		 */
		this.constructor.prototype.getSizeStyle = function ()
		{
			return this.context.options.sizeStyle.get("value");
		};
		
		/**
		 * @instance
		 * @memberof Tooltip
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "tooltip.3";
		};
		
		//{#feature: US-696 ARIA labeling}
		this.constructor.prototype._getHTMLInputElement = function () 
		{
			return this._instance.ariaLabelTarget;
		};
		//End US-696
				
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;
				
				if(!opts.showLabel)
					bpmext.ui.substituteConfigOption(this, "showLabel", false);

				if(!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");
				
				if(!opts.labelWidth)
					bpmext.ui.substituteConfigOption(this, "labelWidth", null);

				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if (!opts.colorStyle)
					bpmext.ui.substituteConfigOption(this, "colorStyle", "D");
				
				if (!opts.sizeStyle)
					bpmext.ui.substituteConfigOption(this, "sizeStyle", "D");

				if (!opts.showTooltip)
					bpmext.ui.substituteConfigOption(this, "showTooltip", false);
					
				if (!opts.htmlText)
					bpmext.ui.substituteConfigOption(this, "htmlText", false);
					
				if (!opts.horizontalPos)
					bpmext.ui.substituteConfigOption(this, "horizontalPos", "L");
				
				if (!opts.verticalPos)
					bpmext.ui.substituteConfigOption(this, "verticalPos", "T");
				
				if (!opts.showOnHover)
					bpmext.ui.substituteConfigOption(this, "showOnHover", false);

				this._instance.outer = this.context.element.querySelector(".outer");				
				this._instance.inner = this.context.element.querySelector(".inner");				
				var cBox = bpmext.ui.util.getContentBox(this, this._instance.inner);
				if(!cBox) {
					//{#feature: US-1330 Added RT localization}
					//throw new Error("Content Box not found in Tooltip Coach View");
					throw new Error(bpmext.localization.formatMsg("controlTooltip", "TOOLTIP_CBOX_NOT_FOUND"));
				}

				var view = this;
				
				bpmext.ui.setupFormulaTriggeredUpdates(
					this, 
					function (expResult)
					{
						if (expResult == undefined)
						{
							expResult = "";
						}

						view.setText(expResult);
					},
					this.getText
				);
				
				//{#bug: * Fixed non-critical issue with initialization of tooltips containing formulas}
				var childNodes = cBox.childNodes;
				var j = 0;
				
				for(var i = 0; i < childNodes.length; i++)
				{
					var childNode = childNodes[i];
					if(domAttr.has(childNode, "data-viewid"))
					{
						j++;

						if(j > 1)
						{
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("This Tooltip control (" + this.context.viewid + ") should only contain one child view - it contains " + childNodes.length);
							bpmext.log.warn(bpmext.localization.formatMsg("controlTooltip", "TOOLTIP_CONTROL") + " (" + this.context.viewid + ") " + bpmext.localization.formatMsg("general", "ONE_CHILDVIEW_WARNING") + " " + childNodes.length);
							//bpmext.log.warn("  Only the first view was added");
							bpmext.log.warn(" "+ bpmext.localization.formatMsg("general", "FIRSTVIEW_ADDED_WARNING"));
							
							break;
						}
						
						var subV = this.context.createView(childNode);
						
						//{#feature: US-696 ARIA labeling}
						if(subV._getHTMLInputElement)
							this._instance.ariaLabelTarget = subV._getHTMLInputElement();
						//End US-696
						
						//Added for US-696
						if(subV._getHTMLInputElement)
						{
							var inputElt = subV._getHTMLInputElement();
							inputElt.addEventListener("focus", function(){
								if(opts.showOnHover.get("value"))
									view.setTooltipVisible(true);
							});

							inputElt.addEventListener("blur", function(){
								if(opts.showOnHover.get("value"))
									view.setTooltipVisible(false);
							});

							this._instance._anchor = subV._getHTMLInputElement();
						} else {
							this._instance._anchor = cBox;
						}
						//End US-696 addition
						
						var type = subV.getType && subV.getType();
						if(type !== "icon.3") {
							subV.context.options._metadata.labelVisibility.set("value", "HIDE");
						}

						if(!this.context.options._metadata.label.get("value"))
						{
							this.context.options._metadata.label.set("value", subV.context.options._metadata.label.get("value"));
						}
					}
				}

				this._instance.cbox = cBox;
				bpmext.ui.loadContainer(this);


				
				this._proto._setLabelVisibility(this, opts.showLabel.get("value") ? "SHOW" : "HIDE");
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));                				
				this._proto._setWidth(this, opts.width.get("value"));
				this._proto._updateControl(this);
				
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLICK);				
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						//{#bug: BG-345 Corrected tooltip visibility control after initilization}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.label":
						{
							this._proto._setLabel(this, event.newVal);
							break;
						}
						case "labelPlacement":
						{
							this._proto._setLabelPlacement(this, event.newVal);
							break;
						}
						case "labelWidth":
						{
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "_metadata.helpText":
						case "colorStyle":
						case "horizontalPos":
						case "verticalPos":
						case "sizeStyle":
						case "showTooltip":
						case "htmlText":
						{
							this._proto._updateControl(this);
							break;
						}
                        case "showLabel":
                        {
                            this._proto._setLabelVisibility(this, event.newVal ? "SHOW" : "HIDE");
                        }
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		/*
		this.constructor.prototype.validate = function (event)
		{
		};

		this.constructor.prototype.collaboration = function (event)
		{
		};
		*/
		
		this.constructor.prototype.unload = function ()
		{
			// remove tooltip
			if(this._instance._tt && this._instance._anchor) {
				bpmext.ui.util.closeTooltip(this._instance._tt, this._instance._anchor);
			}
			
			bpmext.ui.unloadContainer(this);
		};
	}
};

		/**
		 * @instance
		 * @memberof Layout
		 * @method setSelected
		 * @param {object} obj Object to modify selection of
		 * @param {boolean} flag Set whether object is selected or not {true | false}
		 * @desc Sets whether or not an object is selected
		 */
		this.constructor.prototype.setSelected = function(obj, flag)
		{
			var val = this.context.binding ? this.context.binding.get("value") : null;

			if(obj !== null && obj !==undefined)
			{
				if(val && val instanceof com.ibm.bpm.coach.List)
				{
					var idxs = obj.constructor === Array ? this._proto._getChildViewIndices(this, obj) : this._proto._getChildViewIndices(this, [obj]);

					if(!flag)
					{
						var sidxs = val.get("listAllSelectedIndices");
						var idxMap = {};
						
						for(var i = 0; i < idxs.length; i++)
							idxMap[i] = true;
						
						idxs = [];
						
						for(var i = 0; i < sidxs.length; i++)
							if(!idxMap[sidxs[i]])
								idxs.push(sidxs[i]);
					}
				}
			}
			else if(val && val instanceof com.ibm.bpm.coach.List)
			{
				var idxs = flag ? this._proto._getAllChildViewIndices(this) : [];
			}

			if(idxs !== undefined)
				val.set("listAllSelectedIndices", idxs);
		};
		
		/**
		 * @instance
		 * @memberof Layout
		 * @method appendElement
		 * @desc Adds the specified layout element (created by createListElement) to the table
		 * @param {object} obj	The layout element to be added
		 */	
		this.constructor.prototype.appendElement = this.constructor.prototype.add = function(elt)
		{
			if(this.context.binding)
			{
				var boundList = this.context.binding.get("value");
				if(boundList instanceof com.ibm.bpm.coach.List)
				{
				    //BG-1069 adding support for appending simple types
				    if((typeof(elt) != "object") || (elt instanceof Date))
				    {
				        boundList.add(elt);
				    } else {
    					var obj = boundList.createListElement();
    					for(var key in elt)
    					{
    						obj[key] = elt[key];
    					}
    					
    					boundList.add(obj);
				    }
				}
			}			
		};
		
		/**
		 * @instance

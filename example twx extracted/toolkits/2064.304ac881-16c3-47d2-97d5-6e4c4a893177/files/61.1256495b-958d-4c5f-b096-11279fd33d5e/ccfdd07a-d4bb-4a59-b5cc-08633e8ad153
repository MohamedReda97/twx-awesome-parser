/** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td><pre class="prettyprint"><code>me.setWidth("100%");<code></pre></td>
 *     <td><i>Javascript expression</i></td>
 *   </tr>
 *	 <tr class=Prop>
 *     <td>On Responsive Update:</td>
 *     <td></td>
 *     <td><code>string</code></td>
 *   </tr>

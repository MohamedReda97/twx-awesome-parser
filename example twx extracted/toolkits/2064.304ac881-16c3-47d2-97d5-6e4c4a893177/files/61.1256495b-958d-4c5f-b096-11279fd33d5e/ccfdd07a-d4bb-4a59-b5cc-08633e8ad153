		this.constructor.prototype.load = function ()
		{
			try
			{
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONRESUPD);

				var opts = this.context.options;
				var mdt = opts._metadata;
				
				//for cleanup of non-repeating CVs
				this._instance.layoutCreatedCVs = [];
				this._instance.layoutAddedDomClasses = [];

				if(!opts.hAlignment)
					bpmext.ui.substituteConfigOption(this, "hAlignment", this._instance.hAlignment);
				else
					this._instance.hAlignment = opts.hAlignment.get("value");

				if(!opts.vAlignment)
					bpmext.ui.substituteConfigOption(this, "vAlignment", this._instance.vAlignment);
				else
					this._instance.vAlignment = opts.vAlignment.get("value");

				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", ""); //"100%"

				if (!opts.height)
					bpmext.ui.substituteConfigOption(this, "height", "");
					
				if(!opts.layoutFlow)
					bpmext.ui.substituteConfigOption(this, "layoutFlow", this._instance.defaultLayoutFlow);
				//{#bug: BG-857 Text control Validation message is clipped when Horizontal Layout set to alignment other than Justified in CSHS only}
				//else
					this._instance.layoutFlow = opts.layoutFlow.get("value");

				if(!opts.sensor)
					bpmext.ui.substituteConfigOption(this, "sensor", null);

				if(!opts.behaviors)
					bpmext.ui.substituteConfigOption(this, "behaviors", {"items":[]});

				if(!opts.deferLoad)
					bpmext.ui.substituteConfigOption(this, "deferLoad", false);

				if(!opts.loadBatchSize)
					bpmext.ui.substituteConfigOption(this, "loadBatchSize", 1);
				
				if(!opts.startEmpty)
					bpmext.ui.substituteConfigOption(this, "startEmpty", false);
				
				var val = this.context.binding ? this.context.binding.get("value") : null;
				
				if(val && val instanceof com.ibm.bpm.coach.List)
				{
					this._proto._reloadList(this, val);
				}
				else if (opts.startEmpty.get("value") != true)
				{
					var cBox = this._proto._getContentBox(this);
					var cs = cBox.children;
					
					for(var i = 0; i < cs.length; i++)
					{
						var child = cs[i];
						if(domClass.contains(child, "ContentBox"))
						{
							var cs2 = child.children;
							for(var j = 0; j < cs2.length; j++)
							{
								var child2 = cs2[j];
								if(domAttr.has(child2, "data-viewid"))
								{
									try
									{
										this._instance.layoutCreatedCVs.push(this.context.createView(child2, null, this));
									}
									catch(e)
									{
										//{#feature: US-1330 Added RT localization}
										//bpmext.log.error("Error on creating child layout view: " + domAttr.get(child2, "data-viewid") + "\n" + e);
										bpmext.log.error(bpmext.localization.formatMsg("controlLayout", "CHILD_LAYOUT_CREATION_ERROR") + ": " + domAttr.get(child2, "data-viewid") + "\n" + e);										
										if(e.stack) { 
											//{#feature: US-1330 Added RT localization}
											//bpmext.log.error("  Call stack: " + e.stack);
											bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
										}
									}
								}
							}
						}
						else if(domAttr.has(child, "data-viewid"))
						{
							try
							{
								this._instance.layoutCreatedCVs.push(this.context.createView(child, null, this));
							}
							catch(e)
							{
								//{#feature: US-1330 Added RT localization}
								//bpmext.log.error("Error on creating child layout view: " + domAttr.get(child, "data-viewid") + "\n" + e);
								bpmext.log.error(bpmext.localization.formatMsg("controlLayout", "CHILD_LAYOUT_CREATION_ERROR") + ": " + domAttr.get(child, "data-viewid") + "\n" + e);										
								if(e.stack) { 
									//{#feature: US-1330 Added RT localization}
									//bpmext.log.error("  Call stack: " + e.stack);
									bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
								}
							}
						}
						
						domClass.add(child, "layoutCell");
						this._instance.layoutAddedDomClasses.push(child);
					}
				}
				
				var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}

				var children = this.context.element.childNodes;
				for(var i = 0; i < children.length; i++)
				{
					var child = children[i];
					if(child.className && /\bContentBox\b/.test(child.className))
					{
						this._instance.contentBox = child;
						break;
					}
				}

				domClass.add(this._instance.contentBox, "layoutSec");				
				
				bpmext.ui.loadContainer(this);

				var behaviors = opts.behaviors.get("value");

				if(behaviors.items.length > 0)
				{
					this._proto._setBehaviors(this, behaviors);
				}
				else
				{
					this._proto._updContentBox(this, this._instance.hAlignment, this._instance.vAlignment, this._instance.layoutFlow);
					this._proto._setWidth(this, opts.width.get("value"));				
					this._proto._setHeight(this, opts.height.get("value"));
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};


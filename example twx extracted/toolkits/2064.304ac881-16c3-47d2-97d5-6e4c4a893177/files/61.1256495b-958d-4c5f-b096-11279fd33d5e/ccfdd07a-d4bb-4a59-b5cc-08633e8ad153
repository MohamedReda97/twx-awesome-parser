		this.constructor.prototype.removeNonRepeatingChildren = function() {
			while (this._instance.layoutAddedDomClasses.length > 0) {
				domClass.add(this._instance.layoutAddedDomClasses.pop(), "layoutCell");
			}
			while (this._instance.layoutCreatedCVs.length > 0) {
				this.context.deleteView(this._instance.layoutCreatedCVs.pop().context.element);
			}
		};

		/*
		* Hopefully a temporary function
		* This function attempts to resolve an issue when its contents are being repeated inside another repeating layout
		* Example: data-bindingrt="local.workstreamDefintion.tasks[0].runtimeAssignments.assignee[0].displayName"
		* When an item is removed from the middle of the parent list(tasks) the "data-bindingrt" attributes of the views(displayName) inside the inner repeating layout(assignee) are out of sync with the underlying list/binding
		* therefore the data is either not displayed or invalid for subsequent items
		* For example: if there are three tasks and the full path for the three items looks as follows:
		* data-bindingrt="local.workstreamDefintion.tasks[0].runtimeAssignments.assignee[0].displayName"
		* data-bindingrt="local.workstreamDefintion.tasks[1].runtimeAssignments.assignee[0].displayName"
		* data-bindingrt="local.workstreamDefintion.tasks[2].runtimeAssignments.assignee[0].displayName"
		* If we delete the middle task we are left with:
		* data-bindingrt="local.workstreamDefintion.tasks[0].runtimeAssignments.assignee[0].displayName"
		* data-bindingrt="local.workstreamDefintion.tasks[2].runtimeAssignments.assignee[0].displayName"
		* The layout control being "VIEW" managed does not have the code to update the index for the task to 1 "local.workstreamDefintion.tasks[2]"
		*/
		this.constructor.prototype.refreshLayout = function refreshLayout(refreshLayout)
		{
			this._instance.refreshLayout = refreshLayout;
		};
		
		

var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureGeneralStylesLoaded(this);
			bpmext.uidesign.css.ensureGlyphsLoaded(this);
			
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");
			
			this.context.coachViewData.defaultLabelBaseClass = "fa fa-";
			this.context.coachViewData.defaultOnLabelClass = "check";
			this.context.coachViewData.defaultOffLabelClass = "times";
			this.context.coachViewData.labelType = "T";
			this.context.coachViewData.shapeStyle = null;
			
			this.context.coachViewData.onLabelText = null;
			this.context.coachViewData.offLabelText = null;
			this.context.coachViewData.onLabelClass = this.context.coachViewData.defaultLabelBaseClass + this.context.coachViewData.defaultOnLabelClass;
			this.context.coachViewData.offLabelClass = this.context.coachViewData.defaultLabelBaseClass + this.context.coachViewData.defaultOffLabelClass;
			
			this.context.coachViewData.defaultOnLabelIcon = domConstruct.create("span");
			this.context.coachViewData.defaultOffLabelIcon = domConstruct.create("span");
			domClass.add(this.context.coachViewData.defaultOnLabelIcon, this.context.coachViewData.onLabelClass);
			domClass.add(this.context.coachViewData.defaultOffLabelIcon, this.context.coachViewData.offLabelClass);
						
			this.context.coachViewData.switchWrapper = domConstruct.create("div");
			domClass.add(this.context.coachViewData.switchWrapper, "SPARKSwitch switcher");
			
			this.context.coachViewData.input = domConstruct.create("input", {type: "checkbox"});
			
			this.context.coachViewData.switchInnerWrapper = domConstruct.create("div", {
					"className": "switcher-inner switcher-wrapper",
					"role": "switch"
			});
			
			this.context.coachViewData.switcherToggler = domConstruct.create("div");
			domClass.add(this.context.coachViewData.switcherToggler, "switcher-toggler");
			
			this.context.coachViewData.switcherLabelWrapper = domConstruct.create("div", {
				"className": "switcher-label-wrapper"
			});
			
			this.context.coachViewData.switcherStateOn = domConstruct.create("div");
			domClass.add(this.context.coachViewData.switcherStateOn, "switcher-state-on");
			
			this.context.coachViewData.switcherStateOff = domConstruct.create("div");
			domClass.add(this.context.coachViewData.switcherStateOff, "switcher-state-off");
			
			var _this = this;
			bpmext.uidesign.loadLocalization(this, function(){
				_this.context.coachViewData.defaultOnLabelText = bpmext.localization.formatMsg("controlSwitch", "ON");
				_this.context.coachViewData.defaultOffLabelText = bpmext.localization.formatMsg("controlSwitch", "OFF");
				//timing issue, only clear if there is no provided value
				if (!(!!_this.context.coachViewData.onLabelText)) {
					_this.context.coachViewData.switcherStateOn.innerHTML = _this.context.coachViewData.defaultOnLabelText;
				}
				if (!(!!_this.context.coachViewData.offLabelText)) {
					_this.context.coachViewData.switcherStateOff.innerHTML = _this.context.coachViewData.defaultOffLabelText;
				}
			});
						
			this.context.coachViewData.switcherLabelWrapper.appendChild(this.context.coachViewData.switcherStateOn);
			this.context.coachViewData.switcherLabelWrapper.appendChild(this.context.coachViewData.switcherStateOff);
			
			this.context.coachViewData.switchWrapper.appendChild(this.context.coachViewData.input);
			this.context.coachViewData.switchWrapper.appendChild(this.context.coachViewData.switchInnerWrapper);
			this.context.coachViewData.switchInnerWrapper.appendChild(this.context.coachViewData.switcherToggler);
			this.context.coachViewData.switchInnerWrapper.appendChild(this.context.coachViewData.switcherLabelWrapper);
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.switchWrapper);
			
			this.context.coachViewData.switchWrapper.onclick = dojo.hitch(this, function(){
				domClass.toggle(this.context.coachViewData.switchWrapper, "checked");
			});
			
			// The following needs to be in a timeout so the theme's font family has time to take effect otherwise getActiveTheme always returns CLASSIC
			setTimeout(this.lang.hitch(this, function(){
				try {
					domClass.add(this.context.coachViewData.switchWrapper, this.getActiveTheme().slice(1, -1));
				} catch(e) {
					console.log("Error getting active theme", e);
				}
			}), 200);

			callback();
		}));
		},
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, configHelper){
			
			if(propertyName == "@label") {
			} else if(propertyName == "labelPlacement"){
			
			} else if(propertyName ==  "@labelVisibility"){
			
			} else if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "labelType"){
				this.context.coachViewData.labelType = propertyValue;
				this.updateLabels(domClass);
			} else if(propertyName == "sizeStyle"){
				var sizeStyle;
				if(propertyValue == "L"){
					sizeStyle = "switcher-lg";
				} else if(propertyValue == "S"){
					sizeStyle = "switcher-sm";
				} else {
					sizeStyle = "";
				}
				domClass.replace(this.context.coachViewData.switchWrapper, sizeStyle, "switcher-sm switcher-lg");
			} else if(propertyName == "colorStyle"){
				var colorStyle;
				if(propertyValue == "P"){
					colorStyle = "switcher-primary";
				} else if(propertyValue == "I"){
					colorStyle = "switcher-info";
				} else if(propertyValue == "S"){
					colorStyle = "switcher-success";
				} else if(propertyValue == "W"){
					colorStyle = "switcher-warning";
				} else if(propertyValue == "G"){
					colorStyle = "switcher-danger";
				} else {
					colorStyle = "";
				}
				domClass.replace(this.context.coachViewData.switchWrapper, colorStyle, "switcher-primary switcher-info switcher-success switcher-warning switcher-danger");	
			} else if(propertyName == "shapeStyle"){
				var shapeStyle;
				if(propertyValue == "M"){
					shapeStyle = "switcher-theme-modern";
				} else if(propertyValue == "S"){
					shapeStyle = "switcher-theme-square";
				} else {
					shapeStyle = "";
				}
				domClass.replace(this.context.coachViewData.switchWrapper, shapeStyle, "switcher-theme-square switcher-theme-modern");
				this.context.coachViewData.shapeStyle = propertyValue;
				this.updateLabels(domClass);
			} else if(propertyName == "onLabel"){
				this.context.coachViewData.onLabelText = propertyValue;
				this.updateLabels(domClass);
			} else if(propertyName == "offLabel"){
				this.context.coachViewData.offLabelText = propertyValue;
				this.updateLabels(domClass);
			}
		}));
	},
	removeIconSpans:function(){
		if(this.context.coachViewData.defaultOnLabelIcon.parentNode==this.context.coachViewData.switcherStateOn){
			this.context.coachViewData.switcherStateOn.removeChild(this.context.coachViewData.defaultOnLabelIcon);
		}
		if(this.context.coachViewData.defaultOffLabelIcon.parentNode==this.context.coachViewData.switcherStateOff){
			this.context.coachViewData.switcherStateOff.removeChild(this.context.coachViewData.defaultOffLabelIcon);
		}
	},
	updateLabels:function(domClass){
		if(this.context.coachViewData.shapeStyle==="M"){
			//modern - no text, no icons allowed
			this.context.coachViewData.switcherStateOn.innerHTML = "";
			this.context.coachViewData.switcherStateOff.innerHTML = "";
			this.removeIconSpans();
		} else{
			//not modern, so set up icon or text
			if(this.context.coachViewData.labelType===null || this.context.coachViewData.labelType===undefined || this.context.coachViewData.labelType == "T"){
				//label type is text
				//ensure that icon spans aren't children
				this.removeIconSpans();
				if(this.context.coachViewData.onLabelText===null || this.context.coachViewData.onLabelText===undefined || this.context.coachViewData.onLabelText===""){
					this.context.coachViewData.switcherStateOn.innerHTML = this.context.coachViewData.defaultOnLabelText;
				}else{
					this.context.coachViewData.switcherStateOn.innerHTML = this.context.coachViewData.onLabelText;
				}
				if(this.context.coachViewData.offLabelText===null || this.context.coachViewData.offLabelText===undefined || this.context.coachViewData.offLabelText===""){
					this.context.coachViewData.switcherStateOff.innerHTML = this.context.coachViewData.defaultOffLabelText;
				}else{
					this.context.coachViewData.switcherStateOff.innerHTML = this.context.coachViewData.offLabelText;
				}
				
			} else {
				//label type is icon
				this.context.coachViewData.switcherStateOn.innerHTML = "";
				this.context.coachViewData.switcherStateOff.innerHTML = "";
				this.context.coachViewData.switcherStateOn.appendChild(this.context.coachViewData.defaultOnLabelIcon);
				this.context.coachViewData.switcherStateOff.appendChild(this.context.coachViewData.defaultOffLabelIcon);
			}
			//always set up icons, even if the DOM is detached
			if(this.context.coachViewData.onLabelText!==null && this.context.coachViewData.onLabelText!==undefined && this.context.coachViewData.onLabelText!==""){
				domClass.remove(this.context.coachViewData.defaultOnLabelIcon, this.context.coachViewData.onLabelClass);
				this.context.coachViewData.onLabelClass = this.context.coachViewData.defaultLabelBaseClass + this.context.coachViewData.onLabelText;
				domClass.add(this.context.coachViewData.defaultOnLabelIcon, this.context.coachViewData.onLabelClass);
			} else {
				domClass.remove(this.context.coachViewData.defaultOnLabelIcon, this.context.coachViewData.onLabelClass);
				this.context.coachViewData.onLabelClass = this.context.coachViewData.defaultLabelBaseClass + this.context.coachViewData.defaultOnLabelClass;
				domClass.add(this.context.coachViewData.defaultOnLabelIcon, this.context.coachViewData.onLabelClass);
			}
			if(this.context.coachViewData.offLabelText!==null && this.context.coachViewData.offLabelText!==undefined && this.context.coachViewData.offLabelText!==""){
				domClass.remove(this.context.coachViewData.defaultOffLabelIcon, this.context.coachViewData.offLabelClass);
				this.context.coachViewData.offLabelClass = this.context.coachViewData.defaultLabelBaseClass + this.context.coachViewData.offLabelText;
				domClass.add(this.context.coachViewData.defaultOffLabelIcon, this.context.coachViewData.offLabelClass);
			} else {
				domClass.remove(this.context.coachViewData.defaultOffLabelIcon, this.context.coachViewData.offLabelClass);
				this.context.coachViewData.offLabelClass = this.context.coachViewData.defaultLabelBaseClass + this.context.coachViewData.defaultOffLabelClass;
				domClass.add(this.context.coachViewData.defaultOffLabelIcon, this.context.coachViewData.offLabelClass);
			}
		}

	},
	modelChanged: function(propertyName, propertyValue) {
		
	},

	/*
	 * Could not reuse com.ibm.bpm.coach.utils/utilities getActiveTheme as it
	 * has a dependency on com.ibm.bpm.coach/dataBindingHelper which is only
	 * available at coach runtime. Also need to create div within scope of
	 * the coach layout.
	 */
	getActiveTheme : function(forceUpdate) {
		var result = null;
		require(["dojo/dom-class"], this.lang.hitch(this, function(domClass) {
			if (!forceUpdate && this.activeTheme) {
				// console.log("***** - getActiveTheme", this.activeTheme);
				result = this.activeTheme;
			} else {
				var div = document.createElement("div");
				domClass.add(div, "active_theme");
				this.context.coachViewData.containingDiv.appendChild(div);

				var themeStyle = window.getComputedStyle(div);
				var activeTheme = themeStyle.fontFamily;

				// unify output theme string
				this.activeTheme = activeTheme.indexOf("CARBON") > -1 ? '"CARBON"':'"CLASSIC"';

				div.parentNode.removeChild(div);

				// console.log("***** - getActiveTheme", this.activeTheme, "fontFamily", activeTheme);
				result = this.activeTheme;
			}
		}));
		return result;
	}
};	

var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-style", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domStyle, bpmext){
			bpmext.uidesign.css.ensureGlyphsLoaded(this);
			
			this.context.coachViewData.containingDiv = containingDiv;
			this.context.coachViewData.spacerDiv = domConstruct.create("div");
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.spacerDiv);			
			//domClass.add(this.context.coachViewData.containingDiv, "WYSIWYGSpacer_Layout ");
			domClass.add(this.context.coachViewData.spacerDiv, "Spacer ");
			domClass.add(this.context.coachViewData.spacerDiv, "layoutCell");
			
			this.context.coachViewData.defaultWidth = "";
			this.context.coachViewData.defaultHeight = "";
			this.context.coachViewData.defaultStyle = "background-color:#e9e9e9;min-width:"+this.context.coachViewData.defaultWidth+";min-height:"+this.context.coachViewData.defaultHeight;
			var spacerPaletteImage  = this.context.getManagedAssetUrl("BPMExt-Control-Spacer-Palette.png", this.context.assetType_WEB, "SYSBPMUI");
			var spacerBackgroundImgStyle = "background-image :url('"+spacerPaletteImage+"');background-repeat: no-repeat;";
			this.context.coachViewData.spacerDiv.style = this.context.coachViewData.defaultStyle;

			callback();
		}));
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){
			
			if(propertyName == "@label") {
				dojo.attr(this.context.coachViewData.spacerDiv, "aria-label", propertyValue);
			} else if(propertyName == "width"){
				if(propertyValue===null || propertyValue===undefined || propertyValue==""){
					domStyle.set(this.context.coachViewData.spacerDiv, "width", this.context.coachViewData.defaultWidth);
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.spacerDiv, "width", propertyValue);
				}else{
					domStyle.set(this.context.coachViewData.spacerDiv, "width", propertyValue+"px");
				}
			} else if(propertyName == "height"){
				if(propertyValue===null || propertyValue===undefined || propertyValue==""){
					domStyle.set(this.context.coachViewData.spacerDiv, "height", this.context.coachViewData.defaultHeight);
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.spacerDiv, "height", propertyValue);
				}else{
					domStyle.set(this.context.coachViewData.spacerDiv, "height", propertyValue+"px");
				}
			}  else if(propertyName == "animateSizeChgs"){	
				var animateSizeChgsCls;
				if(propertyValue){
					animateSizeChgsCls = "animSzCh";
				} else {
					animateSizeChgsCls = "";
				}
				domClass.replace(this.context.coachViewData.spacerDiv, animateSizeChgsCls, "animSzCh");
			}
		}));
    },
	
	modelChanged: function(propertyName, propertyValue) {
		
	}
};

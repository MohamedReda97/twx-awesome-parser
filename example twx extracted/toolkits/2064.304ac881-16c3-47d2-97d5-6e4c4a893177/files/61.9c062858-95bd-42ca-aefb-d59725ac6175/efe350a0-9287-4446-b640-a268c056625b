bpmext_control_InitVideoPlayer = function (bpmext, utilities, domClass, domAttr, domConstruct, VideoPlayer)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			OPTS_SOURCE_TYPE :
			{
				"MP4" : "video/mp4",
				"WEBM" : "video/webm",
				"FLV" : "video/flv",
				"M3U8" : "application/x-mpegURL"
			},
			EVT_ONCHANGE : "eventON_CHANGE",
			_setVideoPlayerSource : function (view, source, type)
			{
				try
				{
					var sources;
					if(!source){
						view._instance.VideoPlayerControl.dispose();
						view._instance.playerDiv = document.createElement("video");
						domClass.add(view._instance.playerDiv, "input video-js vjs-default-skin vjs-big-play-centered");
						view._instance.group.appendChild(view._instance.playerDiv);
						view._instance.videoPlayerControlOptions.sources = undefined;
						view._instance.VideoPlayerControl = new VideoPlayer(view._instance.playerDiv, view._instance.videoPlayerControlOptions);
						// view._instance.VideoPlayerControl.init(view._instance.playerDiv, view._instance.videoPlayerControlOptions);
						// view._instance.VideoPlayerControl.initChildren();
					} else {
						sources = [{src: source, type: type}];
						view._instance.VideoPlayerControl.src(sources);
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("VideoPlayer._setVideoPlayerSource() error: " + e);
					bpmext.log.error("VideoPlayer._setVideoPlayerSource() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setWidth : function (view, width)
			{
				try
				{
                    if (width != null)
					{
						view.context.element.style.width = width;
                        
                        if (isNaN(width) && width.substring(width.length - 2, width.length) === "em") {
                            width = getComputedStyle(view.context.element).width;
                        }
                        
						view._instance.VideoPlayerControl.width(width);
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("VideoPlayer._setWidth() error: " + e);
					bpmext.log.error("VideoPlayer._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHeight : function (view, height)
			{
				try
				{
					 if (height != null)
					{
						view.context.element.style.height = height;
                        
                        if (isNaN(height) && height.substring(height.length - 2, height.length) === "em") {
                            height = getComputedStyle(view.context.element).height;
                        }
                        
						view._instance.VideoPlayerControl.height(height);
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("VideoPlayer._setHeight() error: " + e);
					bpmext.log.error("VideoPlayer._setHeight() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setPosterURL : function (view, url)
			{
				try
				{
					if (url == null || url == undefined)
					{
						url = "";
					}
					view._instance.VideoPlayerControl.poster(url);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("VideoPlayer._setPosterURL() error: " + e);
					bpmext.log.error("VideoPlayer._setPosterURL() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setAutoPreload : function (view, value)
			{
				try
				{
					if (value == null || value == undefined)
					{
						value = false;
					}
					view._instance.VideoPlayerControl.preload(value == true ? "auto" : "none");
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("VideoPlayer._setAutoPreload() error: " + e);
					bpmext.log.error("VideoPlayer._setAutoPreload() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setAutoplay : function (view, value)
			{
				try
				{
					if (value == null || value == undefined)
					{
						value = "";
					}
					
					view._instance.VideoPlayerControl.autoplay(value);
					
					if(value == true){
						view._instance.VideoPlayerControl.play();
					} else {
						view._instance.VideoPlayerControl.pause();
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("VideoPlayer._setAutoplay() error: " + e);
					bpmext.log.error("VideoPlayer._setAutoplay() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);
				
				if (visibility != "NONE"){
					view._instance.group.disabled = (visibility == "READONLY");
					view._instance.required = (visibility == "REQUIRED");
					
					if (visibility == "READONLY")
						domClass.remove(view._instance.disabler, "hidden");
					else
						domClass.add(view._instance.disabler, "hidden");
				}
			}
		};

		/*
		Public control methods *************************************************************
		 */
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method getVideoPlayerSource
		 * @desc Get VideoPlayer for VideoPlayer control
		 * @returns {string}
		 */
		this.constructor.prototype.getVideoPlayerSource = function ()
		{
			var res = this.context.binding.get("value");
			return res == null ? "" : res;
		};

		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method setVideoPlayerSource
		 * @param {string} url Video source URL
		 * @desc Set VideoPlayer for VideoPlayer control
		 * @example me.setVideoPlayerSource(${VideoSource1}.getValue()); // Here, VideoSource1 would be a {@link Data} control with the video url already bound to it
		 * // The url for a locally hosted video (contained in the Process app) can be set using
		 * // tw.system.model.findManagedFileByPath(<i>&lt;File Name&gt;</i> (e.g. "VideoFile.mp4"), TWManagedFily.Types.Web).url
		 */
		this.constructor.prototype.setVideoPlayerSource = function (VideoPlayer)
		{
			this.context.binding.set("value", VideoPlayer);
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method setSourceType
		 * @param {string} type "MP4" | "WEBM" | "FLV"
		 * @desc Sets source type of VideoPlayer control.  NOTE:  No validation is done
		 */		
		this.constructor.prototype.setSourceType = function (value)
		{
			this._proto._setColorStyle(this, value);
			return this.context.options.sourceType.set("value", value);
		};

		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method getSourceType
		 * @desc Gets source type of VideoPlayer control.  NOTE: This always returns the source type as set.
		 * @returns {string}
		 */		
		this.constructor.prototype.getSourceType = function ()
		{
			return this.context.options.sourceType.get("value");
		};

		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method setWidth
		 * @param {string} width Video Player width
		 * @desc Set width of VideoPlayer control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (width)
		{
			this.context.options.width.set("value", width);
		};

		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method setHeight
		 * @param {string} height Video player height
		 * @desc Set height of VideoPlayer control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setHeight = function (height)
		{
			this.context.options.height.set("value", height);
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method getWidth
		 * @desc Get configured width for VideoPlayer control
		 * @returns {string}
		 */	
		this.constructor.prototype.getWidth = function ()
		{
			return this.context.options.width.get("value");
		}
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method getHeight
		 * @desc Get configured height for VideoPlayer control
		 * @returns {string}
		 */	
		this.constructor.prototype.getHeight = function ()
		{
			return this.context.options.height.get("value");
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method setPosterURL
		 * @param {string} url Poster image url location. Poster image will be displayed over the video while it isn't playing.
		 * @desc Set posterURL of VideoPlayer control
		 * @example me.setPosaterURL(${Poster1}.getValue()); // Here, Poster1 would be a {@link Data} control with the poster url already bound to it
		 * // The url for a locally hosted image (contained in the Process app) can be set using
		 * // tw.system.model.findManagedFileByPath(<i>&lt;File Name&gt;</i> (e.g. "Poster.png"), TWManagedFily.Types.Web).url
		 */
		this.constructor.prototype.setPosterURL = function (url)
		{
			this.context.options.posterURL.set("value", url);
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method getPosterURL
		 * @desc Get configured posterURL for VideoPlayer control
		 * @returns {string}
		 */	
		this.constructor.prototype.getPosterURL = function ()
		{
			return this.context.options.posterURL.get("value");
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method setAutoPreload
		 * @param {boolean} autoPreload set to <code>true</code> to enable automatic preloading
		 * @desc Set autoPreload of VideoPlayer control
		 */
		this.constructor.prototype.setAutoPreload = function (autoPreload)
		{
			this.context.options.autoPreload.set("value", autoPreload);
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method getAutoPreload
		 * @desc Get configured autoPreload for VideoPlayer control
		 * @returns {boolean}
		 */	
		this.constructor.prototype.getAutoPreload = function ()
		{
			return this.context.options.autoPreload.get("value");
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method setAutoplay
		 * @param {boolean} autoplay Set to <code>true</code> to enable autoplay
		 * @desc Set autoplay of VideoPlayer control
		 */
		this.constructor.prototype.setAutoplay = function (autoPlay)
		{
			this.context.options.autoPlay.set("value", autoPlay);
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method getAutoplay
		 * @desc Get configured autoplay for VideoPlayer control
		 * @returns {boolean}
		 */	
		this.constructor.prototype.getAutoplay = function ()
		{
			return this.context.options.autoPlay.get("value");
		};
		
		/**
		 * @instance
		 * @memberof VideoPlayer
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "VideoPlayer.3";
		};

		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				window.thiz = this;
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefMaskedTextDir = this.context.bpm.system.baseTextDirection;
				
				if (!this.context.binding){
					this.context.binding = bpmext.ui.substituteObject(this, null, null, undefined);
				}
					
				if (!opts.sourceType)
					bpmext.ui.substituteConfigOption(this, "sourceType", this._proto.OPTS_SOURCE_TYPE.MP4);
					
				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if (!opts.height)
					bpmext.ui.substituteConfigOption(this, "height", null);
					
				if(!opts.posterURL)
					bpmext.ui.substituteConfigOption(this, "posterURL", "");
					
				if(!opts.autoPreload)
					bpmext.ui.substituteConfigOption(this, "autoPreload", true);
					
				if (!opts.autoPlay)
					bpmext.ui.substituteConfigOption(this, "autoPlay", false);

				if (!opts.tracks)
					bpmext.ui.substituteConfigOption(this, "tracks", []);
					
				this._instance.group = document.createElement("div");
				domClass.add(this._instance.group, "form-group SPARKVideo");
				
				this._instance.disabler = bpmext.ui.util.createDisabler(this, this._instance.group);
				
				this._instance.playerDiv = document.createElement("video");
				domClass.add(this._instance.playerDiv, "input video-js vjs-default-skin vjs-big-play-centered");
				
				this._instance.group.appendChild(this._instance.playerDiv);
				this.context.element.appendChild(this._instance.group);

				var sourceType = opts.sourceType.get("value");
				var width = opts.width.get("value");
				var height = opts.height.get("value");
				var posterURL = opts.posterURL.get("value");
				var autoPreload = opts.autoPreload.get("value");
				var autoPlay = opts.autoPlay.get("value");
				var tracks = opts.tracks.get("value").items;
				
				var sources;
				var binding = this.context.binding.get("value");

				if(binding){
					if(binding.src){
						sources = [binding];
					} else {
						sources = [{ src : binding, type: sourceType}];
					}
					
					if(binding.bindAll){
						binding.bindAll(dojo.hitch(this, function(e){
						this._proto._setVideoPlayerSource(this, binding, type);
						}), binding, sourceType);
					}
				}
				
				var options = {
					sources : sources,
					controls : true,
					preload : autoPreload ? "auto" : "none",
					autoplay : autoPlay,
					poster : posterURL
				};
				
				if(width){
                    /* {#bug: BG-495 added some support for em for width and height} */
					// when there is no format provided, we don't have to pass it in the constructor
					// this is to avoid extra headaches in the future
					this.context.element.style.width = width;
                        
                    if (isNaN(width) && width.substring(width.length - 2, width.length) === "em") {
                        width = getComputedStyle(this.context.element).width;
                    }
                        
					options.width = width;
				}
				if(height){
					// when there is no format provided, we don't have to pass it in the constructor
					// this is to avoid extra headaches in the future
                    this.context.element.style.height = height;
                        
                    if (isNaN(height) && height.substring(height.length - 2, height.length) === "em") {
                        height = getComputedStyle(this.context.element).height;
                    }
                    
					options.height = height;
				}

				//Add Text Tracks
				if (tracks && tracks.length > 0) {
					var i,
						track,
						trackList = [];
					for(i=0; i<tracks.length; i++) {
						track = {};
						if (tracks[i].source_Filename) {
							track.src = com_ibm_bpm_coach.getManagedAssetUrl(tracks[i].source_Filename, com_ibm_bpm_coach.assetType_WEB);
						}
						if (tracks[i].languageCode) {
							track.srclang = tracks[i].languageCode;
						}
						if (tracks[i].label) {
							track.label = tracks[i].label;
						}
						track.kind = tracks[i].kind;
						track.default = tracks[i].defaultTrack;

						trackList.push(track);
					}
					options.tracks = trackList;
				}
				
				this._instance.videoPlayerControlOptions = options;
				
				this._instance.VideoPlayerControl = new VideoPlayer(this._instance.playerDiv, options);
				
				bpmext.ui.loadView(this);

				var view = this;				
				if(opts[this._proto.EVT_ONCHANGE])
				{
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGE, "newVideoPlayer", "oldVideoPlayer");
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "height":
						{
							this._proto._setHeight(this, event.newVal);
							break;
						}
						case "posterURL":
						{
							this._proto._setPosterURL(this, event.newVal);
							break;
						}
						case "autoPreload":
						{
							this._proto._setAutoPreload(this, event.newVal);
							break;
						}					
						case "autoPlay":
						{
							this._proto._setAutoplay(this, event.newVal);
							break;
						}
						case "sourceType":
						{
							this._proto._setVideoPlayerSource(this, this.getVideoPlayerSource(), event.newVal);
							break;
						}
					}
				}
				else if(event.insertedInto == event.removedFrom)
				{
					this._proto._setVideoPlayerSource(this, event.newVal, this.getSourceType());
					
					if(event.newVal != event.oldVal)
						bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE, event.newVal, event.oldVal);
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};


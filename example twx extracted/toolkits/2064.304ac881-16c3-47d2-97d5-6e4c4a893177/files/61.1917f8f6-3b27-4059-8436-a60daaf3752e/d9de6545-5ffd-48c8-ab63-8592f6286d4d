/**
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>if (me.isSelected()) ${Data1}.setValue(me.getSelectedValue())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Selected:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when this radio button is selected.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${Data1}.setValue(me.getSelectedValue())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitRadioButton = function (bpmext, utilities, domClass, domAttr, domConstruct)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONSELECTED : "eventON_SELECTED",
			_setSelected : function (view, val)
			{
				try
				{
					//{#feature: * Allow more type-lenient comparisons between bound value and value when selected}
					var vws = view.context.options.valueWhenSelected.get("value");
					if(val != null && typeof vws == "string")
						val = "" + val;
					
					var res = (val == vws);

					if(res){
						//domAttr.set(view._instance.input, "checked", "");
						view._instance.input.checked = true;
						//Added for TK-1068 :STARTS
						domAttr.set(view._instance.input, "aria-checked", "true");
						//Added for TK-1068 :ENDS
					}else{
						//domAttr.remove(view._instance.input, "checked");
						view._instance.input.checked = false;
						//Added for TK-1068 :STARTS
						domAttr.set(view._instance.input, "aria-checked", "false");
						//Added for TK-1068 :ENDS
					}					
					return res;
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("RadioButton._setSelected() error: " + e);
					bpmext.log.error("RadioButton._setSelected() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setUnselected : function(view)
			{
				//domAttr.remove(view._instance.input, "checked");
				view._instance.input.checked = false;
				//Added for TK-1068 :STARTS
				domAttr.set(view._instance.input, "aria-checked", "false");
				//Added for TK-1068 :ENDS
			},
			_setLabel : function (view, label)
			{
				try
				{
					var vis = bpmext.ui.getEffectiveVisibility(view);
					var labelVisibility = view.context.options._metadata.labelVisibility.get("value");
					if(labelVisibility == "SHOW" && label != null && label.length > 0)
					{
						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
						);

						//Reset the bpmRequiredMarker
						if(vis == "REQUIRED") {
							domClass.add(view.context.element, "bpmRequiredMarker");
						}
					}
					else {
						view._instance.label.innerHTML = "&nbsp";
						
						//Remove bpmRequiredMarker
						domClass.remove(view.context.element, "bpmRequiredMarker");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("RadioButton._setLabel() error: " + e);
					bpmext.log.error("RadioButton._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setTabIndex : function (view, index)
			{
				if(index != null)
					domAttr.set(view._instance.input, "tabindex", index);
				else
					domAttr.remove(view._instance.input, "tabindex");
			},
			_handleVisibility : function (view)
			{
				var vis = bpmext.ui.getEffectiveVisibility(view);

				view.context.setDisplay(vis != "NONE");
				view.context.setVisibility(vis != "HIDDEN");

				if (vis != "NONE")
					view._instance.input.disabled = (vis == "READONLY");

				//Added for TK-1068 :STARTS
				if (view._instance.input.disabled) {										
					domAttr.set(view._instance.input, "aria-disabled", "true");
				} else {					
					domAttr.remove(view._instance.input, "aria-disabled");
				}
				
				if(vis == "REQUIRED") {
					domAttr.set(view._instance.input, "aria-required", "true");
					domClass.add(view.context.element, "bpmRequiredMarker");
				} else {
					domAttr.remove(view._instance.input, "aria-required");
					domClass.remove(view.context.element, "bpmRequiredMarker");
				}
				//TK-1068 : ENDS
			},
			_updateControl : function (view)
			{
				var errors = bpmext.ui.getViewValidationErrors(view);
				
				//Color style
				var colStyle = errors ? "E" : "D";  //{#bug: BG-777 }
				
				bpmext.ui.util.replaceCSSClass(view.context.element, bpmext.ui.util.OPTS_COL_STL_CLZ, colStyle, view._instance.oldColStyle);
				view._instance.oldColStyle = colStyle;
				
				//Validation Error Icon
				if(view._instance.icon)
				{
					bpmext.ui.util.closeTooltip(view._instance.iconTT, view.context.element);
					delete view._instance.iconTT;
					
					view.context.element.removeChild(view._instance.icon);
					delete view._instance.icon;
				}
				
				if(errors)
				{
					domClass.add(view.context.element, "has-feedback has-error");
					view._instance.icon = document.createElement("span");
					view.context.element.appendChild(view._instance.icon);
					
					if (view.context.options.showValidationMarker.get("value") === true) {
						domClass.add(view._instance.icon, "fa form-control-feedback fa-exclamation-circle");
					
						var ttOpts = {
							horizontalPos: "right", 
							verticalPos: "top", 
							cssClass: "validationError",
							plainText: false,
							smartPositioning: true
						};
					
						view._instance.iconTT = bpmext.ui.util.showTooltip(
							view.context.element, 
							bpmext.ui.util.formatErrors(errors), 
							ttOpts
						);

						view._instance.errorMessage = document.createElement("div");
						view._instance.errorMessage.id = view._instance.input.id + "-error-msg";
						view._instance.errorMessage.classList.add("hide");
						view._instance.errorMessage.innerHTML = bpmext.ui.util.formatErrors(errors);
						view._instance.input.appendChild(view._instance.errorMessage);
						domAttr.set(view._instance.input, "aria-describedby", view._instance.errorMessage.id);
						domAttr.set(view._instance.input, "aria-invalid", "true");
					}
				}
				else
				{
					domClass.remove(view.context.element, "has-feedback has-error");
					if (view._instance.errorMessage) { view._instance.errorMessage.remove(); }
					domAttr.remove(view._instance.input, "aria-describedby");
					domAttr.remove(view._instance.input, "aria-invalid");					
				}
			}
		};

		/*
		Public control methods *************************************************************
		 */
		 
		/**
		 * @instance
		 * @memberof RadioButton
		 * @method setLabel
		 * @param {string} text Label for radio button
		 * @desc Set label for radio button control
		 */
		this.constructor.prototype.setLabel = function (text)
		{
			this.context.options._metadata.label.set("value", text);
		};

		/**
		 * @instance
		 * @memberof RadioButton
		 * @method getLabel
		 * @desc Get label associated with radio button control
		 * @returns {string}
		 */
		this.constructor.prototype.getLabel = function ()
		{
			return this.context.options._metadata.label.get("value");
		}
		
		/**
		 * @instance
		 * @memberof RadioButton
		 * @method isLabelVisible
		 * @desc Get label visibility for the radio button control
		 * @returns {boolean}
		 */
		this.constructor.prototype.isLabelVisible = function ()
		{
			return this.context.options._metadata.labelVisibility.get("value") == "SHOW";
		}

		/**
		 * @instance
		 * @memberof RadioButton
		 * @method setLabelVisible
		 * @param {boolean} flag true | false
		 * @desc Set label visibility for radio button control
		 */
		this.constructor.prototype.setLabelVisible = function (flag)
		{
			this.context.options._metadata.labelVisibility.set("value", flag ? "SHOW" : "HIDE");
		};
		
		/**
		 * @instance
		 * @memberof RadioButton
		 * @method isSelected
		 * @desc Get selected state for radio button control
		 * @returns {boolean}
		 */
		this.constructor.prototype.isSelected = function ()
		{
			if(this.context.binding){
				return (this.context.binding.get("value") == this.context.options.valueWhenSelected.get("value"));
			}else{
				//return domAttr.has(this._instance.input, "checked");
				return this._instance.input.checked;				
			}
		}

		/**
		 * @instance
		 * @memberof RadioButton
		 * @method setSelected
		 * @desc Set selected state for radio button control to true
		 */
		this.constructor.prototype.setSelected = function()
		{
			if(this.context.binding)
				this.context.binding.set("value", this.context.options.valueWhenSelected.get("value"));
			else
			{
				//domAttr.set(this._instance.input, "checked", "");
				this._instance.input.checked = true;
				//Added for TK-1068 :STARTS
				domAttr.set(this._instance.input, "aria-checked", "true");
				//Added for TK-1068 :ENDS
				this.ui.publishEvent("RADIO_UNSEL_" + this.context.options.groupName.get("value"), this);

				var _this = this;
				setTimeout(function(){
					bpmext.ui.executeEventHandlingFunction(_this, _this._proto.EVT_ONSELECTED);
					});				
			}
		}

		/**
		 * @instance
		 * @memberof RadioButton
		 * @method setTabIndex
		 * @param {integer} tabIndex Tab indices start at 1 and may be set sparsely
		 * @desc Sets tab index of radio button control
		 */
		this.constructor.prototype.setTabIndex = function (tabIndex)
		{
			return this.context.options.tabIndex.set("value", tabIndex);
		}

		/**
		 * @instance
		 * @memberof RadioButton
		 * @method getTabIndex
		 * @desc Get tab index for radio button control
		 * @returns {integer}
		 */
		this.constructor.prototype.getTabIndex = function ()
		{
			return domAttr.get(this._instance.input, "tabindex");
		}

		/**
		 * @instance
		 * @memberof RadioButton
		 * @method getSelectedValue
		 * @desc Get the value of the radio button control when it is selected
		 * @returns {boolean}
		 */
		this.constructor.prototype.getSelectedValue = function ()
		{
			return this.context.options.valueWhenSelected.get("value");
		}
		
		/**
		 * @instance
		 * @memberof RadioButton
		 * @method focus
		 * @desc Set focus on this control
		 */
		this.constructor.prototype.focus = function ()
		{
			this._instance.input.focus();
		}
		
		/**
		 * @instance
		 * @memberof Text
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "radioButton.3";
		}
		
		//{#feature: US-696 ARIA labeling}
		this.constructor.prototype._getHTMLInputElement = function () 
		{
			return this._instance.input;  //This is the element that will need its "aria-labelledby" attribute set
		}
		//End US-696
				
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;
				
				if (!opts.valueWhenSelected)
					bpmext.ui.substituteConfigOption(this, "valueWhenSelected", this.context.viewid);
				
				if (!opts.tabIndex)
					bpmext.ui.substituteConfigOption(this, "tabIndex", null);
					
				if (!opts.groupName)
					bpmext.ui.substituteConfigOption(this, "groupName", domAttr.get(this.context.element, "data-binding"));

				if (!opts.showValidationMarker)
					bpmext.ui.substituteConfigOption(this, "showValidationMarker", false);

				if (opts.showValidationMarker.get("value") === true) {
					domClass.add(this.context.element, "showValidation");
				}

				//domClass.add(this.context.element, "radio");
					
				this._instance.wrapper = document.createElement("span");
				domClass.add(this._instance.wrapper, "radio3");
				
				this._instance.input = document.createElement("input");
				domAttr.set(this._instance.input, "type", "radio");
				domAttr.set(this._instance.input, "id", "radio-input-" + this.context.controlidpath);
				//Added for TK-1068 :STARTS
				domAttr.set(this._instance.input, "role", "radio");
				//TK-1068 :ENDS
				domAttr.set(this._instance.input, "name", opts.groupName.get("value"));
				//domClass.add(this._instance.input, "px");
				
				var _rdoUid="radio-label-" + this.context.controlidpath;
				this._instance.label = document.createElement("span");
				domAttr.set(this._instance.label,"id",_rdoUid);
				//domClass.add(this._instance.label, "lbl");
				domAttr.set(this._instance.input, "aria-labelledby", _rdoUid);
				
				//Added for TK-1068 :STARTS
				domAttr.set(this._instance.input, "aria-checked", "false");
				//Added for TK-1068 :ENDS
				
				this._instance.wrapper.appendChild(this._instance.input);
				this._instance.wrapper.appendChild(this._instance.label);
				this.context.element.appendChild(this._instance.wrapper);
				
				//{#bug: 814, issue with IE10 compatability}
				var view = this;				// moved up 

				this._instance.label.onclick = function () 
				{  
					view._instance.input.click();
				};
				
				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					null,
					this.isSelected
					);				
				
				bpmext.ui.loadView(this);

				this._instance.vc = bpmext.ui.getNearestValidationContainer(view);
				
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setTabIndex(this, opts.tabIndex.get("value"));
				
				if(this.context.binding) {
					this._proto._setSelected(this, this.context.binding.get("value"));
					this._proto._updateControl(this);
				}
				
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSELECTED);

//				var view = this;
				if(!this.context.binding)
				{
					this.ui.addEventSubscription(
						"RADIO_UNSEL_" + opts.groupName.get("value"), 
						function(event, payload){
							if(payload != view)
								view._proto._setUnselected(view);
						}
					);
				}
				
				this._instance.input.onclick = function(event)
				{
					if(view.context.binding)
						view.context.binding.set("value", opts.valueWhenSelected.get("value"));
					else
					{
						view.setSelected();
					}
				}		
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.label":
						{
							this._proto._setLabel(this, event.newVal);
							break;
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.labelVisibility":
						{
							this._proto._setLabel(this, this.context.options._metadata.label.get("value"));
							break;
						}
						case "tabIndex":
						{
							this._proto._setTabIndex(this, event.newVal);
							break;
						}
					}
				}
				else
				{
					if(this._proto._setSelected(this, event.newVal))
					{
						var _this = this;
						setTimeout(function(){
							bpmext.ui.executeEventHandlingFunction(_this, _this._proto.EVT_ONSELECTED);
							});
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.validate = function (event)
		{
			try
			{
				bpmext.ui.updateViewValidationState(this, event);

				this._proto._updateControl(this);
				if(this._instance.vc)
					this._instance.vc.validate(event);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on validate event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}			
		};

		/*
		this.constructor.prototype.collaboration = function (event)
		{
		};
		*/
		
		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}
}

 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${Map}.setCenter(latLng.A, latLng.F)<code></pre></td>
 *         </tr>
 *       </table>
 *       <table style= "border: 1px solid black; border-collapse: collapse; ">
 *         <tr  style= "border: 1px solid black; border-collapse: collapse;">
 *           <th   style= "border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *           <th   style="border: 1px solid black; border-collapse: collapse; padding: 5px;">event (see <a href="https://developers.google.com/maps/documentation/javascript/reference">google.maps.Map class</a>)</th>
 *         </tr>
 *         <tr  style= "border: 1px solid black; border-collapse: collapse;">
 *           <td  rowspan="3" style= "border: 1px solid black; border-collapse: collapse;padding: 5px;">Properties</td>
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;">latLng {A, F}</td>
 *         </tr>
 *         <tr  style= "border: 1px solid black; border-collapse: collapse;">
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;">pa {x, y}</td>
 *         </tr>
 *         <tr  style= "border: 1px solid black; border-collapse: collapse;">
 *           <td style="color: black; font-weight: normal; border: 1px solid black; border-collapse: collapse;padding: 5px;">pixel {x, y}</td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Marker Click:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the user clicks the marker on the map.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>return confirm("The map destination is located here.")<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitGoogleMap = function (utilities, bpmext, domClass, domAttr, domConstruct, ResizeSensor)
{
	this._instance =
	{
	};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			ResizeSensor:ResizeSensor,
			EVT_ONCLICK : "eventON_CLICK",
			EVT_ONMARKERCLICK : "eventON_MARKERCLICK",
			_getScript : function (src)
			{
				document.write('<' + 'script src="' + src + '"><' + '/script>');
			},
			_setWidth : function (view)
			{
				var size = view.context.options.width.get("value");
				
				try
				{
					if(size != null && size != "")
					{
						if (!isNaN(size))
							size += "px";

						view._instance.mapDiv.style.width = size;
					}
					else 
					{
						view._instance.mapDiv.style.weight = null;
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("GoogleMap._setWidth() error: " + e);
					bpmext.log.error("GoogleMap._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHeight : function (view)
			{
				var size = view.context.options.height.get("value");
				
				try
				{
					if(size != null && size != "")
					{
						if (!isNaN(size))
							size += "px";

						view._instance.mapDiv.style.height = size;
					}
					else 
					{
						view._instance.mapDiv.style.height = null;
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("GoogleMap._setHeight() error: " + e);
					bpmext.log.error("GoogleMap._setHeight() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_replaceClass : function (view, elt, valueMap, newVal, oldVal)
			{
				if(newVal != null)
					newVal = newVal.toUpperCase();
				
				if(oldVal != null)
					oldVal = oldVal.toUpperCase();

				var oldClass = valueMap[oldVal];
				if(oldClass == null)
					oldClass = "";

				var newClass = valueMap[newVal];
				if(newClass == null)
					newClass = "";

				domClass.replace(elt, newClass, oldClass);
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);

				if (visibility != "NONE")
				{
					if (visibility == "READONLY")
						domClass.remove(view._instance.disabler, "hidden");
					else
						domClass.add(view._instance.disabler, "hidden");
				}
				var google = view._instance.google;
				
				setTimeout(function(){
					if(google && view._instance.map) 
						google.maps.event.trigger(view._instance.map, 'resize')
					});
			}
		};
		

		/*
		Public control methods *************************************************************
		 */

		/**
		 * @instance
		 * @memberof GoogleMap
		 * @method setWidth
		 * @param {string} width the width of the map
		 * @desc Set size of map (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (size)
		{
			this.context.options.width.set("value", size);
		}

		/**
		 * @instance
		 * @memberof GoogleMap
		 * @method setCenter
		 * @param {decimal} latitude the latitude
		 * @param {decimal} longitude the longitude
		 * @desc Set the center of the map
		 */
		this.constructor.prototype.setCenter = function (latitude, longitude)
		{
			this.context.options.centerLat.set("value", latitude);
			this.context.options.centerLong.set("value", longitude);
			
			var google = this._instance.google;
			
			var latLng = new google.maps.LatLng(latitude, longitude);
			this._instance.map.setCenter(latLng);
		}
		
		/**
		 * @instance
		 * @memberof GoogleMap
		 * @method redraw
		 * @desc Redraws the map
		 */
		this.constructor.prototype.redraw = function ()
		{
			if(this._instance.google && this._instance.map)
			{
				this._instance.google.maps.event.trigger(this._instance.map, 'resize');
			}
		}
	
		/**
		 * @instance
		 * @memberof GoogleMap
		 * @method click
		 * @desc Programmatically click this map
		 */
		this.constructor.prototype.click = function ()
		{
			this._instance.btn.click();
			
		}

		/**
		 * @instance
		 * @memberof GoogleMap
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "googleMap.3";
		}
		
		/**
		 * @instance
		 * @memberof GoogleMap
		 * @method addMarker
		 * @param {object} location the object that includes the latitude and longitude
		 * @param {string} title the title of the marker
		 * @param {boolean} draggable determines whether it is draggable
		 * @desc adds a marker to the map
		 * @example var latlng = new google.maps.LatLng(lat, lng);  var map = page.ui.get("Map"); map.addMarker(latlng, "This is a marker", false); //note lat and lng variables are in decimal formatting.
		 */
		this.constructor.prototype.addMarker = function(location, title, draggable)
		{
			if(location == null)
				location = this._instance.map.getCenter();
		
			var google = this._instance.google;
			var marker = new google.maps.Marker({
				position: location, 
				map: this._instance.map,
				draggable: draggable,
				title: title
			});
			var view = this;
			var mkevtListnr = google.maps.event.addListener(marker, 'click', function(){
				bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONMARKERCLICK);
			});
		}
		
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				
				var opts = this.context.options;
				var mdt = opts._metadata;
			
				if (!opts.googleAPIKey)
					opts.googleAPIKey = bpmext.ui.substituteConfigOption(this, "googleAPIKey", null);
				
				if (!opts.googleAPIVer)
					opts.googleAPIVer = bpmext.ui.substituteConfigOption(this, "googleAPIVer", 3);
				
				if (!opts.useSensor)
					opts.useSensor = bpmext.ui.substituteConfigOption(this, "useSensor", false);

				if (!opts.hidePanControl)
					opts.hidePanControl = bpmext.ui.substituteConfigOption(this, "hidePanControl", false);

				if (!opts.hideZoomControl)
					opts.hideZoomControl = bpmext.ui.substituteConfigOption(this, "hideZoomControl", false);
					
				if (!opts.hideMapTypeControl)
					opts.hideMapTypeControl = bpmext.ui.substituteConfigOption(this, "hideMapTypeControl", false);

				if (!opts.hideScaleControl)
					opts.hideScaleControl = bpmext.ui.substituteConfigOption(this, "hideScaleControl", false);

				if (!opts.hideStreetViewControl)
					opts.hideStreetViewControl = bpmext.ui.substituteConfigOption(this, "hideStreetViewControl", false);

				if (!opts.hideOverviewMapControl)
					opts.hideOverviewMapControl = bpmext.ui.substituteConfigOption(this, "hideOverviewMapControl", false);

				if (!opts.hideRotateControl)	
					opts.hideRotateControl = bpmext.ui.substituteConfigOption(this, "hideRotateControl", false);
					
				if (!opts.centerLat)
					opts.centerLat = bpmext.ui.substituteConfigOption(this, "centerLat", null);

				if (!opts.centerLong)
					opts.centerLong = bpmext.ui.substituteConfigOption(this, "centerLong", null);

				if (!opts.mapType)
					opts.mapType = bpmext.ui.substituteConfigOption(this, "mapType", "ROADMAP");
					
				if (!opts.tilt)
					opts.tilt = bpmext.ui.substituteConfigOption(this, "tilt", null);

				if (!opts.zoom)
					opts.zoom = bpmext.ui.substituteConfigOption(this, "zoom", 12);

				if (!opts.width)
					opts.width = bpmext.ui.substituteConfigOption(this, "width", "100%");

				if (!opts.height)
					opts.height = bpmext.ui.substituteConfigOption(this, "height", "300px");

				if (!opts.marker)
					opts.marker = bpmext.ui.substituteConfigOption(this, "marker", false);
				
				this._instance.envelope = document.createElement("div");
				domClass.add(this._instance.envelope, "SPARKGMap");

				this._instance.mapDiv = document.createElement("div");

				this._instance.disabler = bpmext.ui.util.createDisabler(this, this._instance.envelope);
				
				this._instance.envelope.appendChild(this._instance.mapDiv);
				this.context.element.appendChild(this._instance.envelope);
					
				//this._proto._getScript("http://maps.googleapis.com/maps/api/js?v="  + opts.googleAPIVer.get("value") + "&amp;sensor=" + opts.useSensor.get("value"));
				this._proto._setWidth(this);
				this._proto._setHeight(this);

				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLICK, "event");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONMARKERCLICK);
				bpmext.ui.loadView(this);
				
				var view = this;
				
				
				var lat = view.context.options.centerLat.get("value");
				var lng = view.context.options.centerLong.get("value");
		
				
				if(view._instance.map == null)
				{
					bpmext.ui.addEventSubscription("GOOGLE_APIS_LOADED", function(evtName, payload) {
						try
						{
							var google = view._instance.google = payload.google;
						
							var latLng = new google.maps.LatLng(lat, lng);
							
							if(lat !== null && lng !== null)
							{
								var latLng = new google.maps.LatLng(lat, lng);
							}
								
								

							view._instance.map = new google.maps.Map(
								view._instance.mapDiv,
								{
									zoom: view.context.options.zoom.get("value"),
									center: latLng,
									mapTypeId: google.maps.MapTypeId[view.context.options.mapType.get("value")],
									panControl: !view.context.options.hidePanControl.get("value"),
									zoomControl: !view.context.options.hideZoomControl.get("value"),
									mapTypeControl: !view.context.options.hideMapTypeControl.get("value"),
									scaleControl: !view.context.options.hideScaleControl.get("value"),
									streetViewControl: !view.context.options.hideStreetViewControl.get("value"),
									overviewMapControl: !view.context.options.hideOverviewMapControl.get("value"),
									rotateControl: !view.context.options.hideRotateControl.get("value")
								});
							
					
							
							
							var tilt = view.context.options.tilt.get("value");
							
							if(tilt !== null)
								view._instance.map.setTilt(tilt);
							
							var evtListnr = google.maps.event.addListener(view._instance.map, "click", function (evt)
							{
								bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONCLICK, evt);
							});
							
				
							if(view.context.options.marker.get("value") == true)
							{
								//TODO: {#feature: US-1330 Added RT localization}
								var marker = new google.maps.Marker({
									position: latLng,
									map: view._instance.map,
									title: 'Click to zoom'
								});
							
								marker.setMap(view._instance.map);
							
								var mkevtListnr = google.maps.event.addListener(marker, 'click', function(){
									bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONMARKERCLICK);
								});
							}
							
						}
						catch(e)
						{
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.error("Error on Google API loaded event [" + view.context.viewid + "]: " + e);
							bpmext.log.error(bpmext.localization.formatMsg("controlMap", "ERROR_ON_API_LOADED_EVENT") + " [" + view.context.viewid + "]: " + e);
							if(e.stack) { 
								//{#feature: US-1330 Added RT localization}
								//bpmext.log.error("  Call stack: " + e.stack);
								bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
							}						
						}
					},
					this,
					true
					);
				}
				//{#bug: 417 Google Map doesn't render properly within collapsible panel}	
				//{#bug: * Bug #417 assumes the map is only in collapsible panel - fix generalized}	
				this._instance.rs = new ResizeSensor(view._instance.envelope, function(){
					setTimeout(function(){
						if(view._instance.google && view._instance.map)
						{
							view._instance.google.maps.event.trigger(view._instance.map, 'resize');
							console.debug("Map resize triggered");
						}
					});
				});

				/*
				if(document.querySelector(".SPARKCPanel.panel")){
					this._instance.rs = new ResizeSensor(document.querySelector(".SPARKCPanel.panel"), function(){	
			
						setTimeout(function(){
							if(view._instance.google && view._instance.map) 
								view._instance.google.maps.event.trigger(view._instance.map, 'resize')
							});			
					});
				}
				*/
            }	
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
		
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			
			try
			{
				
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "height":
						{
							this._proto._setHeight(this, event.newVal);
							break;
						}
					}
				}
				
				var view = this;
				var google = this._instance.google;
				
				setTimeout(function(){
					if(google && view._instance.map) 
					google.maps.event.trigger(view._instance.map, 'resize')
				});
				
				/*
				new ResizeSensor(this.context.element.querySelector("div.SPARKCPanel.panel"), function(){	
									var google = view._instance.google;
									
									setTimeout(function(){
										if(google && view._instance.map) 
										google.maps.event.trigger(view._instance.map, 'resize')
									});
									
									console.log("resized sensor called");
				});

				*/
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
			
		};

		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
			
			if(this._instance.rs!=null){
				this._instance.rs.detach(this.context.element.querySelector("div.SPARKGMap"));
			}
			
		};
	}
}

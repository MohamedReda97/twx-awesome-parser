		 */
		this.constructor.prototype.setLabelSizeStyle = function (style)
		{
			this.context.options.labelSizeStyle.set("value", style);
		}

		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method getLabelSizeStyle
		 * @returns {string} "R"=Super large | "X"=Extra large | "G"=Larger | "L"=Large | "S"=Small | "M"=Smaller | "D"=Default
		 * @desc Gets color style of label/caption
		 */
		this.constructor.prototype.getLabelSizeStyle = function ()

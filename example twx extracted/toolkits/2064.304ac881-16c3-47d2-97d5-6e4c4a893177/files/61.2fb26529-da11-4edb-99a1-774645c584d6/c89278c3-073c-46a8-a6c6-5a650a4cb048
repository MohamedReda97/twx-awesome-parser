bpmext_control_InitCaptionBox = function (bpmext, utilities, domClass, domAttr, domConstruct)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype.IS_ADDRESS_INVISIBLE = true;
		
		this.constructor.prototype._proto =
		{
			OPTS_CAP_PLC : 
			{
				"T": "cap-top",
				"L": "cap-left",
				"B": "cap-bottom",
				"R": "cap-right"
			},
			OPTS_LBL_PLC_CLZ :
			{
				"T": "",
				"L": "label-left",
				"B": "",
				"R": "label-right"
			},
			OPTS_LBL_HORIZ_ALIGN :
			{
				"L": "hclbl-left",
				"C": "hclbl-center",
				"R": "hclbl-right"
			},
			OPTS_LBL_VERT_ALIGN :
			{
				"T": "vclbl-top",
				"M": "vclbl-middle",
				"B": "vclbl-bottom"
			},
			OPTS_COL_STLZ :
			{
				"H" : "",
				"D" : "text-default",
				"M" : "text-muted",
				"L" : "text-light-gray",
				"P" : "text-primary",
				"I" : "text-info",
				"S" : "text-success",
				"W" : "text-warning",
				"G" : "text-danger",
				"E" : "text-danger"
			},
			OPTS_TXS_STLZ :
			{
				"D" : "",
				"R" : "text-slg",
				"X" : "text-xlg",
				"G" : "text-lg",
				"L" : "text-bg",
				"S" : "text-sm",
				"M" : "text-xs"
			},
			OPTS_TXW_STLZ :
			{
				"D" : "",
				"N" : "text-normal",
				"S" : "text-slim",
				"M" : "text-semibold",
				"B" : "text-bold"
			},
			_normalizeCaptionPlacement : function(view, val)
			{
				if(!val)
					val = "T";

				val = val.toUpperCase();
				if(val.length > 1)
				{
					switch (val)
					{
						case "TOP":
							val = "T";
							break;
						case "LEFT":
							val = "L";
							break;
						case "BOTTOM":
							val = "B";
							break;
						case "RIGHT":
							val = "R";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected caption placement: " + val);
							bpmext.log.warn(bpmext.localization.formatMsg("controlCaptionBox", "CAPBOX_CAPTION_PLACE_WARNING",val));
					}
				}
				else if(!(val in this.OPTS_CAP_PLC))
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.warn("Unexpected caption placement: " + val);
					bpmext.log.warn(bpmext.localization.formatMsg("controlCaptionBox", "CAPBOX_CAPTION_PLACE_WARNING",val));
					val = "T";
				}
				
				return val;
			},
			_normalizeHAlign : function(view, val)
			{
				if(!val)
					val = "L";

				val = val.toUpperCase();
				if(val.length > 1)
				{
					switch(val)
					{
						case "LEFT":
							val = "L";
							break;
						case "CENTER":
						case "MIDDLE":
							val = "C";
							break;
						case "RIGHT":
							val = "R";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected caption horizontal alignment: " + val);
							bpmext.log.warn(bpmext.localization.formatMsg("controlCaptionBox", "CAPBOX_CAPTION_HALIGN_WARNING",val));
					}
				}
				else if(!(val in this.OPTS_LBL_HORIZ_ALIGN))
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.warn("Unexpected caption horizontal alignment: " + val);
					bpmext.log.warn(bpmext.localization.formatMsg("controlCaptionBox", "CAPBOX_CAPTION_HALIGN_WARNING",val));
					val = "L";
				}

				return val;
			},
			_normalizeVAlign : function(view, val)
			{
				if(!val)
					val = "T";

				val = val.toUpperCase();
				if(val.length > 1)
				{
					switch(val)
					{
						case "TOP":
							val = "T";
							break;
						case "CENTER":
						case "MIDDLE":
							val = "M";
							break;
						case "BOTTOM":
							val = "B";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected caption vertical alignment: " + val);
							bpmext.log.warn(bpmext.localization.formatMsg("controlCaptionBox", "CAPBOX_CAPTION_VALIGN_WARNING",val));
					}
				}
				else if(!(val in this.OPTS_LBL_VERT_ALIGN))
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.warn("Unexpected caption vertical alignment: " + val);
					bpmext.log.warn(bpmext.localization.formatMsg("controlCaptionBox", "CAPBOX_CAPTION_VALIGN_WARNING",val));
					val = "T";
				}
				
				return val;
			},
			_normalizeSizeStyle: function(sizeStyle)
			{
				if(!sizeStyle)
					sizeStyle = "D";
				
				sizeStyle = sizeStyle.toUpperCase();
				if(sizeStyle.length > 1)
				{
					switch (sizeStyle)
					{
						case "SUPER-LARGE":
						case "SUPER LARGE":
						case "SUPER":
							sizeStyle = "R";
							break;
						case "EXTRA-LARGE":
						case "EXTRA LARGE":
						case "EXTRA":
							sizeStyle = "X";
							break;
						case "LARGER":
							sizeStyle = "G";
							break;
						case "LARGE":
							sizeStyle = "L";
							break;
						case "SMALL":
							sizeStyle = "S";
							break;
						case "SMALLER":
							sizeStyle = "M";
							break;
						case "DEF":
						case "DEFAULT":
							sizeStyle = "D";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected size style: " + sizeStyle);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "SIZE_STYLE_WARNING",sizeStyle));
					}
				}
				
				return sizeStyle;
			},
			_normalizeColorStyle: function(style)
			{
				if(!style)
					style = "D";
				
				style = style.toUpperCase();
				if(style.length > 1)
				{
					switch (style)
					{
						case "DEFAULT":
						case "DEF":
							style = "D";
							break;
						case "MUTED":
							style = "M";
							break;
						case "LIGHT-GRAY":
						case "GRAY":
						case "LIGHTGRAY":
						case "LIGHT GRAY":
							style = "L";
							break;
						case "SUCCESS":
							style = "S";
							break;
						case "INFO":
						case "INF":
							style = "I";
							break;
						case "PRIMARY":
						case "PRI":
							style = "P";
							break;
						case "WARNING":
						case "WARN":
							style = "W";
							break;
						case "ERROR":
						case "ERR":
						case "DANGER":
							style = "G";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected color style: " + style);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "COLOR_STYLE_WARNING",style));
					}
				}

				return style;
			},
			_ensureLabelCreated : function(view)
			{
				//view._instance.label = document.createElement("label");
				//Added for TK-1268 : STARTS
				view._instance.label = document.createElement("span");
				//TK-1268 : ENDS
				domClass.add(view._instance.label, "control-label");
				
				//{#feature: US-696 ARIA labeling}
				if(view._instance.ariaLabelTarget != null)
				{
					var lblId = "cpb-lbl-" + view.getUID();

					domAttr.set(view._instance.label, "id", lblId);
					domAttr.set(view._instance.ariaLabelTarget, "aria-labelledby", lblId);
				}
				//End US-696
			},
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("CaptionBox._setLabelVisibility() error: " + e);
					bpmext.log.error("CaptionBox._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelColorStyle : function (view, newVal, oldVal)
			{
				newVal = this._normalizeColorStyle(newVal);
				oldVal = this._normalizeColorStyle(oldVal);
				
				bpmext.ui.util.replaceCSSClass(view._instance.label, this.OPTS_COL_STLZ, newVal, oldVal);
			},
			_setLabelSizeStyle : function (view, newVal, oldVal)
			{
				newVal = this._normalizeSizeStyle(newVal);
				oldVal = this._normalizeSizeStyle(oldVal);
				
				bpmext.ui.util.replaceCSSClass(view._instance.label, this.OPTS_TXS_STLZ, newVal, oldVal);				
			},
			_setLabelWeightStyle : function (view, newVal, oldVal)
			{
				//TODO: Normalize weight style
				bpmext.ui.util.replaceCSSClass(view._instance.label, this.OPTS_TXW_STLZ, newVal, oldVal);
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{	
						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						view._instance.label.innerHTML = "";
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("CaptionBox._setLabel() error: " + e);
					bpmext.log.error("CaptionBox._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelHAlign : function(view, newVal, oldVal)
			{
				newVal = this._normalizeHAlign(view, newVal);
				oldVal = this._normalizeHAlign(view, oldVal);

				bpmext.ui.util.replaceCSSClass(view._instance.label, this.OPTS_LBL_HORIZ_ALIGN, newVal, oldVal);
			},
			_setLabelVAlign : function(view, newVal, oldVal)
			{
				newVal = this._normalizeVAlign(view, newVal);
				oldVal = this._normalizeVAlign(view, oldVal);

				bpmext.ui.util.replaceCSSClass(view._instance.group, this.OPTS_LBL_VERT_ALIGN, newVal, oldVal);
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{

				newVal = this._normalizeCaptionPlacement(view, newVal);
				oldVal = this._normalizeCaptionPlacement(view, oldVal);
				
				var domLoc;
				
				switch(newVal)
				{
					case "L":
						domLoc = "first";
						break;
					case "B":
						domLoc = "last";
						break;
					case "R":
						domLoc = "last";
						break;
					default:
					case "T":
						domLoc = "first";
						break;
				}

				domConstruct.place(view._instance.label, view._instance.group, domLoc);
				bpmext.ui.util.replaceCSSClass(view._instance.group, this.OPTS_LBL_PLC_CLZ, newVal, oldVal);				
				bpmext.ui.util.replaceCSSClass(view._instance.group, this.OPTS_CAP_PLC, newVal, oldVal);
			},
			_setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else {
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}
					
					domClass.remove(view.context.element, "labelWidth");
				}
					
			},
			_setShrinkToContent : function(view)
			{
				if(view.context.options.shrinkToContent.get("value"))
				{
					domClass.add(view._instance.group, "shrink-to-cnt");
				}
				else
				{
					domClass.remove(view._instance.group, "shrink-to-cnt");
				}				
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;
						
						domClass.add(view.context.element, "widthSet");
					}
					else {
						view.context.element.style.width = null;
						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("CaptionBox._setWidth() error: " + e);
					bpmext.log.error("CaptionBox._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_normalizeColorStyle: function(style)
			{
				if(!style)
					style = "D";
				
				style = style.toUpperCase();
				if(style.length > 1)
				{
					switch (style)
					{
						case "DEFAULT":
						case "DEF":
							style = "D";
							break;
						case "SUCCESS":
							style = "S";
							break;
						case "INFO":
						case "INF":
							style = "I";
							break;
						case "PRIMARY":
						case "PRI":
							style = "P";
							break;
						case "WARNING":
						case "WARN":
							style = "W";
							break;
						case "ERROR":
						case "ERR":
						case "DANGER":
							style = "G";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected color style: " + style);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "COLOR_STYLE_WARNING",style));
					}
				}

				return style;
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);
				
				view.context.setDisplay(visibility != "NONE");
				view.context.setVisibility(visibility != "HIDDEN");
			}
		};

		/*
		Public control methods *************************************************************
		 */
		 
		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method setLabel
		 * @param {string} label label text for the control
		 * @desc Set label for control
		 */
		this.constructor.prototype.setLabel = function (text)
		{
			this.context.options._metadata.label.set("value", text);
		};

		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method getLabel
		 * @desc Get label associated with control
		 * @returns {string}
		 */
		this.constructor.prototype.getLabel = function ()
		{
			return this.context.options._metadata.label.get("value");
		}

		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method setLabelPlacement
		 * @param {string} placement "T","TOP"=Top | "L","LEFT"=Left | "B","BOTTOM"=Bottom | "R","RIGHT"=Right
		 * @desc Set label placement for caption box
		 */
		this.constructor.prototype.setLabelPlacement = function (plc)
		{
			this.context.options.labelPlacement.set("value", plc);
		};

		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method getLabelPlacement
		 * @desc Get label/caption placement for the control
		 * @returns {string} {"T"=Top | "L"=Left}
		 */
		this.constructor.prototype.getLabelPlacement = function ()
		{
			return this.context.options.labelPlacement.get("value");
		}
		
		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method getLabelWidth
		 * @desc Get label width of CaptionBox control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelWidth = function ()
		{
			return this.context.options.labelWidth.get("value");
		};
		
		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method setLabelWidth
		 * @param {string} labelWidth Control's label width
		 * @desc Set label width of CaptionBox control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setLabelWidth = function (labelWidth)
		{
			this.context.options.labelWidth.set("value", labelWidth);
		};

		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method setLabelHorizontalAlignment
		 * @desc Set the horizontal alignment for the label/caption
		 * @returns {string} {"T"=Top | "C"=Center | "L"=Left}
		 */
		this.constructor.prototype.setLabelHorizontalAlignment = function (val)
		{
			this.context.options.labelHorizAlign.set("value", val);
		}

		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method setLabelVerticalAlignment
		 * @desc Set the veritical alignment for the label/caption
		 * @returns {string} {"T"=Top | "M"=Middle | "B"=Left}
		 */
		this.constructor.prototype.setLabelVerticalAlignment = function (val)
		{
			this.context.options.labelVertAlign.set("value", val);
		}
		
		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method setWidth
		 * @param {string} width width of the input group
		 * @desc Set width of text control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */

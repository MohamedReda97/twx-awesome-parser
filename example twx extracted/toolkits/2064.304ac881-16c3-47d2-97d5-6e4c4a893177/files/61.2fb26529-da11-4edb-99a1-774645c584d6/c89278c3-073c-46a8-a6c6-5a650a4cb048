		/**
		 * @instance
		 * @memberof CaptionBox
		 * @method getLabelWeightStyle
		 * @returns {string} "D"=Default | "N"=Normal | "S"=Slim | "M"=Semi-bold | "B"=Bold
		 * @desc Gets color style of label/caption

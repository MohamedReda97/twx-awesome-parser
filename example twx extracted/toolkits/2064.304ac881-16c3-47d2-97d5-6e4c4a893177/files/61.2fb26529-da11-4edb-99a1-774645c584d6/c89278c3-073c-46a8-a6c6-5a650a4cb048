		 * @instance
		 * @memberof CaptionBox
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "captionBox.3";
		}
		
		//{#feature: US-696 ARIA labeling}
		this.constructor.prototype._getHTMLInputElement = function () 
		{
			return this._instance.ariaLabelTarget;
		}
		//End US-696

		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;
				
				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if(!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");

				if(!opts.labelWidth)
					bpmext.ui.substituteConfigOption(this, "labelWidth", null);
		
				if(!opts.labelColorStyle)
					bpmext.ui.substituteConfigOption(this, "labelColorStyle", "D");

				if(!opts.labelSizeStyle)
					bpmext.ui.substituteConfigOption(this, "labelSizeStyle", "D");

				if(!opts.labelWeightStyle)
					bpmext.ui.substituteConfigOption(this, "labelWeightStyle", "D");

				if(!opts.labelHorizAlign)
					bpmext.ui.substituteConfigOption(this, "labelHorizAlign", "L");

				if(!opts.labelVertAlign)
					bpmext.ui.substituteConfigOption(this, "labelVertAlign", "T");
				
				if(!opts.shrinkToContent)
					bpmext.ui.substituteConfigOption(this, "shrinkToContent", false);
				
				this._instance.group = this.context.element.querySelector(".form-group");
				
				var cBox = bpmext.ui.util.getContentBox(this, this._instance.group);
				if(!cBox) {
					//{#feature: US-1330 Added RT localization}
					//throw new Error("Content Box not found in CaptionBox Coach View");
					throw new Error(bpmext.localization.formatMsg("controlCaptionBox", "CAPBOX_CBOX_NOT_FOUND"));
				}

				this._instance.cbox = cBox;
				domClass.add(this.context.element, "SPARKCapBox");
				
				//this._instance.label = document.createElement("label");
				//Added for TK-1268 : STARTS
				this._instance.label = document.createElement("span");
				//TK-1268 : ENDS
				domClass.add(this._instance.label, "control-label");								

				//this._proto._ensureLabelCreated(this);
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));                				

				this._proto._setLabelHAlign(this, opts.labelHorizAlign.get("value"));
				this._proto._setLabelVAlign(this, opts.labelVertAlign.get("value"));

				this._proto._setLabelColorStyle(this, opts.labelColorStyle.get("value"));
				this._proto._setLabelSizeStyle(this, opts.labelSizeStyle.get("value"));
				this._proto._setLabelWeightStyle(this, opts.labelWeightStyle.get("value"));
				this._proto._setWidth(this, opts.width.get("value"));
				this._proto._setShrinkToContent(this);
				
				var view = this;
				//Enabling a control with formula support
				bpmext.ui.setupFormulaTriggeredUpdates(
					this, 
					function (expResult)
					{
						if (expResult == undefined)
						{
							expResult = "";
						}

						view.setLabel(expResult);
					},
					this.getLabel
				);				
				
				bpmext.ui.loadContainer(this);
				
				var childNodes = cBox.childNodes;
				var j = 0;
				//Added for TK-1268 : STARTS
				var lblId = "cpb-lbl-" + this.getUID();
				domAttr.set(this._instance.label, "id", lblId);
				//TK-1268 : ENDS
				
				for(var i = 0; i < childNodes.length; i++)
				{
					var childNode = childNodes[i];
					if(domAttr.has(childNode, "data-viewid"))
					{
						j++;

						if(j > 1)
						{
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("This CaptionBox control should only contain one child view - it contains " + childNodes.length);
							bpmext.log.warn(bpmext.localization.formatMsg("controlCaptionBox", "CAPBOX_CONTROL") + " " + bpmext.localization.formatMsg("general", "ONE_CHILDVIEW_WARNING") + " " + childNodes.length);
							//bpmext.log.warn("  Only the first view was added");
							bpmext.log.warn(" " + bpmext.localization.formatMsg("general", "FIRSTVIEW_ADDED_WARNING"));
							
							break;
						}
						
						var subV = this.context.createView(childNode);
						
						//{#feature: US-696 ARIA labeling}
						if(subV._getHTMLInputElement){
							this._instance.ariaLabelTarget = subV._getHTMLInputElement();							
							domAttr.set(this._instance.ariaLabelTarget, "aria-labelledby", lblId);
														
							if(this._instance.ariaLabelTarget.nodeName == "BUTTON" || this._instance.ariaLabelTarget.nodeName == "A")
								domAttr.remove(this._instance.ariaLabelTarget, "aria-labelledby");
						}
						//End US-696
						
						subV.context.options._metadata.labelVisibility.set("value", "HIDE");
						if(!this.context.options._metadata.label.get("value"))
						{
							this.context.options._metadata.label.set("value", subV.context.options._metadata.label.get("value"));
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.label":
						{
							this._proto._setLabel(this, event.newVal);
							break;
						}
						case "_metadata.labelVisibility":
						{
							this._proto._setLabelVisibility(this, event.newVal);
							break;
						}
						case "shrinkToContent":
						{
							this._proto._setShrinkToContent(this);
							break;
						}							
						case "labelPlacement":
						{
							this._proto._setLabelPlacement(this, event.newVal, event.oldVal);
							break;
						}
						case "labelWidth":
						{
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}						
						case "labelHorizAlign":
						{
							this._proto._setLabelHAlign(this, event.newVal, event.oldVal);
							break;
						}						
						case "labelVertAlign":
						{
							this._proto._setLabelVAlign(this, event.newVal, event.oldVal);
							break;
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "labelColorStyle":
						{
							this._proto._setLabelColorStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "labelSizeStyle":
						{
							this._proto._setLabelSizeStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "labelWeightStyle":
						{
							this._proto._setLabelWeightStyle(this, event.newVal, event.oldVal);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};


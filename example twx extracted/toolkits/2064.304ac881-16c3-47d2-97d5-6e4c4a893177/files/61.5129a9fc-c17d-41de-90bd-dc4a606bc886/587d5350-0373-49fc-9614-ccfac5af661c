bpmext_control_InitStyle = function(domStyle, domConstruct)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			_appendStyle : function(styles) 
			{
				var css = document.createElement('style');
				css.type = 'text/css';

				if (css.styleSheet) css.styleSheet.cssText = styles;
				else css.appendChild(document.createTextNode(styles));

				document.getElementsByTagName("head")[0].appendChild(css);
			},
			_appendStyleSheet : function(view, styleSheetURL, media) 
			{
				if(!view._instance.link)
				{
					view._instance.link = document.createElement('link');
					view._instance.link.type = 'text/css';
					view._instance.link.rel = "stylesheet";
				}
				
				view._instance.link.href = styleSheetURL;
				
				if(media)
					view._instance.link.media = media;

				document.getElementsByTagName("head")[0].appendChild(view._instance.link);
				return view._instance.link;
			}		
		}
		
		/**
		 * @instance
		 * @memberof Style
		 * @method getType
		 * @desc Get descriptive string representing the type of control/section
		 * @returns {string}
		 */	
		this.constructor.prototype.getType = function()
		{
			return "style.3";
		}
		
		/**
		 * @instance
		 * @memberof Style
		 * @method setTheme
		 * @desc Sets the theme to be used
		 * @param {string} themeName Updated Theme
		 */	
		this.constructor.prototype.setTheme = function(themeName)
		{
			if(this.context.options.styleSpecs)
			{
				var styleSpecs = this.context.options.styleSpecs.get("value");
				if(styleSpecs)
				{
					for(var i = 0; i < styleSpecs.length(); i++)
					{
						var styleSpec = styleSpecs.items[i];
						if(!themeName || (styleSpec.themeName == themeName))
						{
							var ssurl;
							if(styleSpec.cssType != "External")
							{
								var assetType;
								if(styleSpec.appAcronym === "" || styleSpec.appAcronym === null)
								{
									styleSpec.appAcronym = undefined;
								}
								
								switch(styleSpec.cssType)
								{
									case "Web":
										assetType = com_ibm_bpm_coach.assetType_WEB;
										break;
									case "Server":
										assetType = com_ibm_bpm_coach.assetType_SERVER;
										break;
									case "Design":
										assetType = com_ibm_bpm_coach.assetType_DESIGN;
										break;
								}
								
								ssurl = com_ibm_bpm_coach.getManagedAssetUrl(styleSpec.cssFile, assetType, styleSpec.appAcronym);
							}
							else
								ssurl = styleSpec.cssFile;
							
							//Need to support env variable substitution for external URL
							this._proto._appendStyleSheet(this, ssurl);		
							break;
						}
					}
				}
			}
		}
		
		/*
			Coach NG Lifecycle methods *************************************************************
		 */
		
		this.constructor.prototype.load = function()
		{
			if (!this.context.binding)
				this.context.binding = bpmext.ui.substituteObject(this);

			this.context.element.style.display = "none";

			if(this.context.options.styleSpecs)
			{
				var styleSpecs = this.context.options.styleSpecs.get("value");
				if(styleSpecs)
				{
					for(var i = 0; i < styleSpecs.length(); i++)
					{
						var styleSpec = styleSpecs.items[i];
						if(!styleSpec.themeName)
						{
							styleSpec.themeName = i;
						}
					}
				}
			}

			//{# feature: * Allow setting the theme name from the variable (string) bound to the Style control - ED}
			this.setTheme(this.context.binding.get("value"));
			
			bpmext.ui.loadView(this);
		};

		this.constructor.prototype.unload = function()
		{
			bpmext.ui.unloadView(this);
		};

		this.constructor.prototype.view = function()
		{

		};

		this.constructor.prototype.change = function(event)
		{

		};

		/*
		this.constructor.prototype.collaboration = function(event)
		{
		};

		this.constructor.prototype.validate = function(event)
		{
		};
		*/		
	}
};

var mixObject = {
	createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", "dojo/_base/event", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, event, bpmext){
			bpmext.uidesign.css.ensureGlyphsLoaded(this);
			
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "Radio_Button CPP");
			
			this.context.coachViewData.label = domConstruct.create("span");
			domClass.add(this.context.coachViewData.label, "radio3");
			
			this.context.coachViewData.input = domConstruct.create("input", {type: "radio"});
			dojo.attr(this.context.coachViewData.input, "role", "radio");
			this.context.coachViewData.label.appendChild(this.context.coachViewData.input);
			
			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.span = domConstruct.create("span");
			var tempID = dojox.uuid.generateRandomUuid();
			domAttr.set(this.context.coachViewData.span, "id", "rdo_" + tempID);
			dojo.attr(this.context.coachViewData.input, "aria-labelledby", this.context.coachViewData.span.id);
			this.context.coachViewData.span.appendChild(this.context.coachViewData.labelTextDom);
			this.context.coachViewData.label.appendChild(this.context.coachViewData.span);
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.label);
			
			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, undefined/*don't hide span*/, this.context.coachViewData.containingDiv, false, false);
			
			callback();
		}));	
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.span;
	},
	propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class","dojo/dom-attr", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domAttr, configHelper){
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "labelPlacement"){
				var labelPlacement;
				if(propertyValue == "L"){
					labelPlacement = "label-left";
				} else {
					labelPlacement = "";
				}
				domClass.replace(this.formGroupDiv, labelPlacement, "label-left");
			} else if(propertyName == "sizeStyle"){
				var sizeStyle;
				if(propertyValue == "L"){
					sizeStyle = "input-lg";
				} else if(propertyValue == "S"){
					sizeStyle = "input-sm";
				} else {
					sizeStyle = "";
				}
				domClass.replace(this.select, sizeStyle, "input-sm input-lg");
			} else if(propertyName == "width"){
				this.width = propertyValue;
				if(!!propertyValue) {
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "groupName"){
				if(!!propertyValue) {
					domAttr.set(this.context.coachViewData.input, "name", propertyValue);
				} else {
					domAttr.remove(this.context.coachViewData.input, "name");
				}
			}
		}));
    },
	
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
	}
};

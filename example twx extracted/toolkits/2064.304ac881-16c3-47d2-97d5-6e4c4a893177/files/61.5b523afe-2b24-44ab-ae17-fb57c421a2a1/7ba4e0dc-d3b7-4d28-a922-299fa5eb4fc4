/** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the modal alert is clicked.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setVisible(true)<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Close:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the modal alert is clicked.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${Text}.setText("Modal Alert is closed")<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Show:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the modal alert is opened.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setText("Modal Alert is open")<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitModalAlert = function (utilities, bpmext, domClass, domAttr, domConstruct)
{
	this._instance =
	{
	};
	
	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONCLOSE : "eventON_CLOSE",
			EVT_ONSHOW : "eventON_SHOW",
			//{#feature: * Added support for Primary color style}
			OPTS_COL_STLZ :
			{
				"P" : "modal-primary",
				"I" : "modal-info",
				"S" : "modal-success",
				"W" : "modal-warning",
				"G" : "modal-danger"
			},
			OPTS_ICO_STLZ :
			{
				"P" : "fa-comment",
				"I" : "fa-info-circle",
				"S" : "fa-check-circle",
				"W" : "fa-warning",
				"G" : "fa-times-circle"
			},
			OPTS_BTN_STLZ :
			{
				"P" : "btn-primary",
				"I" : "btn-info",
				"S" : "btn-success",
				"W" : "btn-warning",
				"G" : "btn-danger"
			},			
			_handleVisibility : function (view)
			{
				var visibility = view.context.options._metadata.visibility.get("value");
				if(visibility != "NONE" && visibility != "HIDDEN")
				{
					domClass.add(view._instance.modalPanel, "in");
					view._instance.modalPanel.style.display = "block";

					setTimeout(function(){
						// BG-888 moved inside the setTimeout;
						view._instance.button.focus();
					}, 100);

				}	
				else
				{
					domClass.remove(view._instance.modalPanel, "in");
					view._instance.modalPanel.style.display = "none";

					setTimeout(function(){
						if (view._instance.ariaTriggerElementTarget) {
							view._instance.ariaTriggerElementTarget.focus();
						}
					}, 100);
				}
			},
			_normalizeColorStyle: function(style)
			{
				// OPTS_COL_STLZ :
				// {
					// "I" : "modal-info",
					// "S" : "modal-success",
					// "W" : "modal-warning",
					// "G" : "modal-danger"
				// },
				if(!style)
					style = "I";
				
				style = style.toUpperCase();
				if(style.length > 1)
				{
					switch (style)
					{
						case "DEFAULT":
						case "DEF":
						case "INFO":
						case "INF":
							style = "I";
							break;
						case "SUCCESS":
							style = "S";
							break;
						case "WARNING":
						case "WARN":
							style = "W";
							break;
						case "DANGER":
							style = "G";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected color style: " + style);
							bpmext.log.warn(bpmext.localization.formatMsg("general", "COLOR_STYLE_WARNING",style));
					}
				}

				return style;
			},
			_setColorStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldColStyle;
				
				newVal = this._normalizeColorStyle(newVal);
				oldVal = this._normalizeColorStyle(oldVal);

				bpmext.ui.util.replaceCSSClass(view._instance.modalPanel, this.OPTS_COL_STLZ, newVal, oldVal);
				if(utilities.getActiveTheme() === '"CLASSIC"') {
					bpmext.ui.util.replaceCSSClass(view._instance.icon, this.OPTS_ICO_STLZ, newVal, oldVal);
					bpmext.ui.util.replaceCSSClass(view._instance.header, this.OPTS_COL_STLZ, newVal, oldVal);
				}
				bpmext.ui.util.replaceCSSClass(view._instance.button, this.OPTS_BTN_STLZ, newVal, oldVal);
				view._instance.oldColStyle = newVal;
			},
			_setTitle : function (view, title)
			{
				try
				{
					if(title)
					{
						view._instance.modalTitle.innerHTML = view.context.htmlEscape(title);
						utilities.BiDi.applyTextDir(
							view._instance.modalTitle, 
							view._instance.modalTitle.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						view._instance.modalTitle.innerHTML = "&nbsp;";
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("ModalAlert._setTitle() error: " + e);
					bpmext.log.error("ModalAlert._setTitle() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setButtonLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						view._instance.button.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.button, 
							view._instance.button.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						view._instance.button.innerHTML = "OK";
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("ModalAlert._setButtonLabel() error: " + e);
					bpmext.log.error("ModalAlert._setButtonLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},			
			_setText : function (view, text)
			{
				try
				{
					if(text == null)
					{
						text = "";
					}

					if(text.length == 0)
						text = "&nbsp;";

					view._instance.modalBody.innerHTML = text; //add processing differences for HTML vs. non-HTML content
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("ModalAlert._setText() error: " + e);
					bpmext.log.error("ModalAlert._setText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			}			
		};

		/*
		Public control methods *************************************************************
		 */
		 /**
		 * @instance
		 * @memberof ModalAlert
		 * @method setColorStyle
		 * @param {string} style "DEFAULT"|"DEF"|"INFO"|"INF"|"I"=Default | "SUCCESS"|"S"=Success | "WARNING"|"WARN"|"W"=Warning | "DANGER"|"G"=Danger 
		 * @desc Sets the color style of the control.  NOTE: to avoid ambiguity always set the color using "I"|"S"|"W"|"G"
		 */

		this.constructor.prototype.setColorStyle = function (style)
		{
			this.context.options.colorStyle.set("value", style);
		};
		
	     /**
		 * @instance
		 * @memberof ModalAlert
		 * @method getColorStyle
		 * @desc Get the string representing the color style of the control.  NOTE: This always returns the color as set, to avoid ambiguity always set the color using "I"|"S"|"W"|"G"
		 * @returns {string} 
		 */
		this.constructor.prototype.getColorStyle = function ()
		{
			return this.context.options.colorStyle.get("value");
		};
		
		 /**
		 * @instance
		 * @memberof ModalAlert
		 * @method setTitle
		 * @param {string} title title label
		 * @desc Set the string representing the title of control
		 */
		this.constructor.prototype.setTitle = function (title)
		{
			this.context.options._metadata.label.set("value", title);
		};
		
		/**
		 * @instance
		 * @memberof ModalAlert
		 * @method getTitle
		 * @desc Gets the title of the control
		 * @returns {string} The title of the control
		 */
		this.constructor.prototype.getTitle = function ()
		{
			return this.context.options._metadata.label.get("value");
		};
		
		/**
		 * @instance
		 * @memberof ModalAlert
		 * @method setText
		 * @param {string} text the text of the control 
		 * @desc Sets the text 
		 */
		this.constructor.prototype.setText = function (text)
		{
			this.context.options._metadata.helpText.set("value", text);
		};
		
		/**
		 * @instance
		 * @memberof ModalAlert
		 * @method getText
		 * @desc Gets the text of the control 
		 * @returns {string} Gets the text of the control
		 */
		this.constructor.prototype.getText = function ()
		{
			return this.context.options._metadata.helpText.get("value");
		};
		
		/**
		 * @instance
		 * @memberof ModalAlert
		 * @method setButtonLabel
		 * @param {string} text the label of the button
		 * @desc Sets the button label for the control
		 */
		this.constructor.prototype.setButtonLabel = function (text)
		{
			this.context.options.buttonLabel.set("value", text);
		};
		
		/**
		 * @instance
		 * @memberof ModalAlert
		 * @method getButtonLabel
		 * @desc Gets the button label of the control 
		 * @returns {string} Returns the button label of the control
		 */
		this.constructor.prototype.getButtonLabel = function (text)
		{
			return this.context.options.buttonLabel.get("value");
		};
		
		/**
		 * @instance
		 * @memberof ModalAlert
		 * @method show
		 * @desc Display's the modal alert
		 */
		this.constructor.prototype.show = function()
		{
			bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONSHOW);
			bpmEventHelper.ui._showView.call(this);
		};
		
		/**
		 * @instance
		 * @memberof ModalAlert
		 * @method setVisible
		 * @param {boolean} flag the visibility of the control
		 * @desc Sets the visibility of the control
		 */
		this.constructor.prototype.setVisible = function(flag)
		{
			var vst1 = this.context.options._metadata.visibility.get("value");
			bpmext.ui.setViewVisible(this, flag);
			
			var vst2 = this.context.options._metadata.visibility.get("value");

	        if (flag && !!this.context.element && !!this.context.element.focus && vst2 != "NONE" && vst2 != "HIDDEN") {
	        	this._instance.ariaTriggerElementTarget = document.activeElement;
	            this.context.element.focus();
	        }

			if(vst1 != vst2 && (vst2 == "NONE" || vst2 == "HIDDEN"))
				bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCLOSE);
		};
		
		/**
		 * @instance
		 * @memberof ModalAlert
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "modalAlert.3";
		};
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;
				
				if (!opts.colorStyle)
					bpmext.ui.substituteConfigOption(this, "colorStyle", "P");
				
				if(!opts.buttonLabel)
					bpmext.ui.substituteConfigOption(this, "buttonLabel", null);

				this._instance.modalPanel = document.createElement("div");
				domClass.add(this._instance.modalPanel, "modal modal-alert fade");
				
				var modalDialog = document.createElement("div");
				domClass.add(modalDialog, "modal-dialog");
				
				var modalContent = document.createElement("div");
				domClass.add(modalContent, "modal-content");
				
				var modalHeader = document.createElement("div");
				domClass.add(modalHeader, "modal-header");
				this._instance.header = modalHeader;
				
				this._instance.modalTitle = document.createElement("div");
				domClass.add(this._instance.modalTitle, "modal-title");
				domAttr.set(this._instance.modalTitle, "id", "modalalert-title-"+this.context.controlidpath);

				this._instance.modalBody = document.createElement("div");
				domClass.add(this._instance.modalBody, "modal-body");
				
				var modalFooter = document.createElement("div");
				domClass.add(modalFooter, "modal-footer");
				
				this._instance.button = document.createElement("button");
				domAttr.set(this._instance.button, "id", "modalalert-button-"+this.context.controlidpath);
				domClass.add(this._instance.button, "btn");
				
				if(utilities.getActiveTheme() === '"CLASSIC"') {
					this._instance.icon = document.createElement("i");
					domClass.add(this._instance.icon, "fa");
					modalHeader.appendChild(this._instance.icon);
					modalHeader.style.textAlign = "center";
					modalFooter.style.textAlign = "center";
					this._instance.modalTitle.style.textAlign = "center";
					this._instance.button.style.width = "auto";
				}
				modalFooter.appendChild(this._instance.button);
				modalContent.appendChild(modalHeader);
				modalContent.appendChild(this._instance.modalTitle);
				modalContent.appendChild(this._instance.modalBody);
				modalContent.appendChild(modalFooter);
				modalDialog.appendChild(modalContent);
				this._instance.modalPanel.appendChild(modalDialog);
				this.context.element.appendChild(this._instance.modalPanel);
				
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLOSE);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSHOW);

				var view = this;
				
				this._instance.modalPanel.onclick = this._instance.button.onclick = function (event)
				{
					view.setVisible(false);
				};

				this._instance.button.onkeydown = function (event)
				{
					if(event.key === "Tab"){
						event.preventDefault();
					}
				};
				
				modalContent.onclick = function(event)
				{
					var evt = event ? event : window.event;
					if(evt.stopPropagation)
						evt.stopPropagation();
					if(evt.cancelBubble != null)
						evt.cancelBubble = true;
				};

				bpmext.ui.loadView(this);
				
				this._proto._setColorStyle(this, opts.colorStyle.get("value"));				
				this._proto._setTitle(this, opts._metadata.label.get("value"));
				this._proto._setText(this, opts._metadata.helpText.get("value"));
				this._proto._setButtonLabel(this, opts.buttonLabel.get("value"));
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);			
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.label":
						{
							this._proto._setTitle(this, event.newVal);
							break;
						}
						case "_metadata.helpText":
						{
							this._proto._setText(this, event.newVal);
							break;
						}
						case "colorStyle":
						{
							this._proto._setColorStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "buttonLabel":
						{
							this._proto._setButtonLabel(this, event.newVal);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}
};

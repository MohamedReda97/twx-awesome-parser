			_setDate : function (view, date)
			{
				try
				{
					bpmext.log.debug("_setDate for viewid [" + view.context.viewid + "]");

					//{#bug: * issue with clearing datePicker}
					
					if ( (typeof date == "string") && (date.length == 0) )
						date = undefined;
					else if (typeof date == "string" && date.indexOf("T") == -1)
					{																	
						date = view._proto._parseStringDate(view);		//BG-790				
					}
					else if (typeof date == "string" && date.indexOf("T") != -1) 	//BG-872
					{																							
						var dt = date.split(/[: T-]/).map(parseFloat);
						date = new Date(dt[0], dt[1] - 1, dt[2], dt[3] || 0, dt[4] || 0, dt[5] || 0, 0);
					}
					if ((view._instance.pickerControl.viewDate && view._instance.pickerControl.viewDate.getTime()) != (date && date.getTime()))
					{
						//console.log("_setDate", date);
						view._instance.pickerControl.updateControl(date);
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("DatePicker._setDate() error: " + e);
					bpmext.log.error("DatePicker._setDate() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if (e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},

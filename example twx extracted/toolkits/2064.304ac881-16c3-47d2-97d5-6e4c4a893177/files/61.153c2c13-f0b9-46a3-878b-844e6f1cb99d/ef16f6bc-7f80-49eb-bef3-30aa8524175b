			_reconcileFormat: function(view, selector)  // Added by Nividous for BG-790
			{
				var format = view.context.options.format.get("value");
				if(!format || format == "")
					return "mm/dd/yyyy";
				if(!selector)
					selector = "date";
				if(selector == "date")
				{
					while(format.indexOf("m") != -1) 
					{
						format = format.split("m").join("M");
					}
				}
				return format;
			},			
			_parseDate: function(view, date, formatOptions)  // Added by Nividous for BG-790
			{
				if(!formatOptions)
					formatOptions = {};
				if(!formatOptions["selector"])
					formatOptions["selector"] = "date";
				if(!formatOptions["datePattern"])
					formatOptions["datePattern"] = view.context.options.format.get("value");
				if(formatOptions["datePattern"])
					formatOptions["datePattern"] = view._proto._reconcileFormat(view, formatOptions["selector"]);								
								
				var resultDate;
				var rawDate = date;
				var day = "";
				var month = "";
				var year = "";
				if(formatOptions["datePattern"] =="ddMMyyyy"){ 
					day = rawDate.slice(0, 2);
					month = rawDate.slice(2, 4);
					year = rawDate.slice(4);
					resultDate = new Date(year,month - 1,day);
				}else if(formatOptions["datePattern"] =="yyyyMMdd"){ 
					year = rawDate.slice(0, 4);					
					month = rawDate.slice(4, 6);
					day = rawDate.slice(6);					
					resultDate = new Date(year,month - 1,day);
				} else if(formatOptions["datePattern"] =="MMddyyyy"){ 					
					month = rawDate.slice(0,2);
					day = rawDate.slice(2, 4);
					year = rawDate.slice(4);   				
					resultDate = new Date(year,month - 1,day);
				} else if(formatOptions["datePattern"] =="yyyyddMM"){ 					
					year = rawDate.slice(0, 4);					
					day = rawDate.slice(4, 6);
					month = rawDate.slice(6);					
					resultDate = new Date(year,month - 1,day);
				} else if(formatOptions["datePattern"] =="dMyy" || formatOptions["datePattern"] =="yyMd" || formatOptions["datePattern"] =="Mdyy" || formatOptions["datePattern"] =="yydM" ){ 					
					resultDate = undefined;
				} else if(formatOptions["datePattern"] =="dMyyyy" || formatOptions["datePattern"] =="yyyyMd" || formatOptions["datePattern"] =="Mdyyyy" || formatOptions["datePattern"] =="yyyydM" ){ 					
					resultDate = undefined;
				} else{
					var delimiter = /[^dmMy]/.exec(formatOptions["datePattern"])[0];
					//var formatLowerCase=formatOptions["datePattern"].toLowerCase();
					if (formatOptions["datePattern"].indexOf("/") != -1)
						date = date.split(" ").join("/");
					
					var formatLowerCase=formatOptions["datePattern"];
					var formatItems=formatLowerCase.split(delimiter);
					var dateItems=date.split(delimiter);
					var monthIndex=(formatItems.indexOf("mm") != -1) ? formatItems.indexOf("mm") : (formatItems.indexOf("MM") != -1) ? formatItems.indexOf("MM") : formatItems.indexOf("M");
					var dayIndex=(formatItems.indexOf("dd") != -1) ? formatItems.indexOf("dd") : formatItems.indexOf("d");
					var yearIndex=(formatItems.indexOf("yyyy") != -1) ? formatItems.indexOf("yyyy") : formatItems.indexOf("yy");
					var month;
					var minMonthAry = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
					var maxMonthAry = ["January","February","March","April","May","June","July","August","September","October","November","December"];
					if(!isNaN(dateItems[monthIndex])){
						month=parseInt(dateItems[monthIndex]);
						month-=1;
					}else{
						month= minMonthAry.indexOf(dateItems[monthIndex]);
						if(month == -1)
							month= maxMonthAry.indexOf(dateItems[monthIndex]);
					}
					var formatedDate = new Date(dateItems[yearIndex],month,dateItems[dayIndex]);
					resultDate = formatedDate;											
				}												
				return resultDate;															
			},
			_parseStringDate: function(view,eventNewVal) // Added by Nividous for BG-790
			{	
				var date;																	
				var dateString = (!!eventNewVal) ? eventNewVal : view.context.binding.get("value");
					
//				if (sniff("ie")) // code to detect slashes which IE does not like
//				{
					if (dateString.indexOf("/") != -1)
					{
						var noSlashString = dateString.split("/").join("");
						if (isNaN(noSlashString))
						{
							dateString = dateString.split("/").join(" ");
						}
					}
				//date = new Date(dateString);																
				 date = (dateString == null || dateString.length == 0) ? null : view._proto._parseDate(view, dateString);				
//				}								
				return (date !=null && date != undefined) ? date : undefined;
			},
			_getLocaleFormat: function (view)
			{
				if (!view._instance.localeFormat) {
					switch (dojo.locale) {
						case "ja":
						case "ko":
							view._instance.localeFormat = "yyyy/mm/dd";
							break;
						case "zh-tw":
						case "zh":
						case "sv":
						case "de":
							view._instance.localeFormat = "yyyy-MM-dd";
							break;
						case "tr":
						case "ru":
						case "nb":
						case "ro":
						case "pl":
							view._instance.localeFormat = "dd.MM.yyyy";
							break;
						case "el":
						case "he":
						case "it":
						case "ar":
						case "pt":
						case "pt-br":
						case "es":
							view._instance.localeFormat = "dd/mm/yyyy";
							break;
						case "nl":
						case "fr":
						case "da":
							view._instance.localeFormat = "dd-MM-yyyy";
							break;
						case "cs":
						case "fi":
						case "sk":
							view._instance.localeFormat = "d.M.yyyy";
							break;
						case "hu":
							view._instance.localeFormat = "yyyy.MM.dd";
							break;
						case "en":
						default:
							view._instance.localeFormat = "mm/dd/yyyy";
					}
				}
				return view._instance.localeFormat;
			},

							this.onChangeHandle = dojo.connect(this._instance.pickerControl, "setValue", this, function ()
							{
								if (this._instance.onChangeHandleRunning || !this._instance.dateIsValid || (this._instance.pickerControl.getDates(0).length == 0)) // TKT 349
								{
									return;
								}
								
								var oldValue = this.context.binding.get("value");

								bpmext.log.debug("onChangeHandle(type) for viewid [" + this.context.viewid + "] current binding [" + oldValue + "]");
								
								if (this._instance.dateType == "String") // TKT 349
								{																																									
									oldValue = this._proto._parseStringDate(this);		//BG-790								
								}
																	
								var oldYear = oldValue && oldValue.getUTCFullYear();
								var oldMonth = oldValue && oldValue.getUTCMonth();
								var oldDate = oldValue && oldValue.getUTCDate();

								var newValue = this._instance.pickerControl.getDates(0);
								if (newValue && newValue.length >= 0)
								{
									newValue = newValue[0];
									var newYear = newValue && newValue.getUTCFullYear();
									var newMonth = newValue && newValue.getUTCMonth();
									var newDate = newValue && newValue.getUTCDate();
									if (oldYear !== newYear ||
										oldMonth !== newMonth ||
										oldDate !== newDate)
									{
										try		// TKT 349
										{
											this._instance.onChangeHandleRunning = true;
											//BG-1085 adding support for list of Date
											if(/^Date[\W]*$/.test(this._instance.dateType))
											//if (this._instance.dateType == "Date") // TKT 349
												this.context.binding.set("value", typeof newValue == "undefined" ? null : newValue);
											else // Date Type is String				
												this.context.binding.set("value", this._instance.pickerControl.getFormattedDate(this.context.options.format.get("value")));
										}
										finally
										{
											this._instance.onChangeHandleRunning = false;
										}											
										//this.context.binding.set("value", typeof newValue == "undefined" ? null : newValue);
									}
								}
							});
                            this._proto._handleVisibility(this);
							break;
						}
					}
				}
				else
				{
					//{#bug: * issue with clearing datePicker}
					if (this._instance.loadEHIsRunning && this._instance.validateEHIsRunning)
						return;
					bpmext.log.debug("Change eh for viewid [" + this.context.viewid + "] newVal [" + event.newVal + "] oldVal [" + event.oldVal + "]");
					if (event.newVal != event.oldVal)
					{
						//validate tkt 349
						this._instance.dateIsValid = true;
						if (this._instance.dateType == "String" || dojo.isString(event.newVal))
						{
						    this._instance.dateType = "String";
							if (event.newVal.length != 0){	 															
								var tDate = this._proto._parseStringDate(this, event.newVal);		//BG-790																		
							}
								
							if ((tDate == "Invalid Date" || tDate == undefined))
							{
								this._instance.dateIsValid = false;
								//{#feature: US-1330 Added RT localization}
								//this.setValid(false, "Date Error on update of bound input [" +
								//	(event.newVal.length > 0 ? event.newVal : this._instance.pickerControl.lastDate) +
								//	"] use format '" + this.context.options.format.get("value") + "'");
								this.setValid(false, bpmext.localization.formatMsg("controlDatePicker", "DATE_BOUND_INPUT_UPDATE_ERROR") +" [" +
									(event.newVal.length > 0 ? event.newVal : this._instance.pickerControl.lastDate) +
									"] " + bpmext.localization.formatMsg("controlDatePicker", "USE_FORMAT") + " '" + this.context.options.format.get("value") + "'");
								//{#feature: US-1330 Added RT localization}
								//bpmext.log.error("Invalid Date [" +
								//	(event.newVal.length > 0 ? event.newVal : this._instance.pickerControl.lastDate) +
								//	"] for Control ID: " + this.context.viewid);
								bpmext.log.error(bpmext.localization.formatMsg("controlDatePicker", "INVALID_DATE") + " [" +
									(event.newVal.length > 0 ? event.newVal : this._instance.pickerControl.lastDate) +
									"] " + bpmext.localization.formatMsg("general", "FOR") + bpmext.localization.formatMsg("general", "CONTROL_ID") + ": " + this.context.viewid);
								this._instance.pickerElement.value = "";								
							}
							else
								this.setValid(true);
						}
						if ( (event.newVal != "") && (this._instance.dateIsValid == true) )						
							this._proto._setDate(this, event.newVal);
						bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE);
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if (e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.validate = function (event)
		{
			try
			{
				this._instance.validateEHIsRunning = true;
				bpmext.log.debug("Validation eh for viewid [" + this.context.viewid + "] running with type [" + event.type + "]");
				bpmext.ui.updateViewValidationState(this, event);
				if ( (this._instance.loadEHIsRunning) && (event.type == "error") )
					this.context.binding.set("value", "");   //Tkt 349
				this._proto._updateControl(this);
				if (this._instance.vc)
					this._instance.vc.validate(event);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on validate event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if (e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
			finally
			{
				this._instance.validateEHIsRunning = false;
			}
		};

		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}
}

			{
				if (!view._instance.pickerControl.isInline)
				{
					if (!oldVal)
						oldVal = view._instance.oldSzStyle;

					newVal = bpmext.ui.util.normalizeSizeStyle(newVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);
					oldVal = bpmext.ui.util.normalizeSizeStyle(oldVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);

					bpmext.ui.util.replaceCSSClass(view._instance.pickerControl.element, bpmext.ui.util.OPTS_SZ_STL_CLZ, newVal, oldVal);
					view._instance.oldSzStyle = newVal;

					bpmext.ui.util.propagateUpSizeStyle(view, newVal);
				}
			},
			_setColorStyle : function (view, newVal, oldVal)
			{
				if (!oldVal)
					oldVal = view._instance.oldSzStyle;

				if (view._instance.pickerControl.isInline)
				{
					bpmext.ui.util.replaceCSSClass(view._instance.pickerControl.focusElement, this.OPTS_COL_STLZ, newVal, oldVal);
				}
				else
				{
					bpmext.ui.util.replaceCSSClass(view._instance.wrapper, bpmext.ui.util.OPTS_COL_STL_CLZ, newVal, oldVal);
					bpmext.ui.util.replaceCSSClass(view._instance.pickerControl.picker, this.OPTS_COL_STLZ, newVal, oldVal);
				}
				view._instance.oldSzStyle = newVal;

				bpmext.ui.util.propagateUpSizeStyle(view, newVal);

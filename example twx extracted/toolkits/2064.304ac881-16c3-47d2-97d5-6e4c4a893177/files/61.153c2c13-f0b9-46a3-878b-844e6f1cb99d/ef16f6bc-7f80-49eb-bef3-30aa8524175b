					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("DatePicker._setLabel() error: " + e);
					bpmext.log.error("DatePicker._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);

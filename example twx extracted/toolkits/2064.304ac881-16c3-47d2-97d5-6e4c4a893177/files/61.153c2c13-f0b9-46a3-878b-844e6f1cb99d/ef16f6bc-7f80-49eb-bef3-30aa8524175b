			_convertDisabledWeekDaysOptionToString : function (toConvert)
			{
				var toReturn = "";
				var disabledWeekDaysArray = [];
				var index;
				for (index in this.OPTS_WEEK_DAYS_ARRAY)
				{
					if (toConvert[this.OPTS_WEEK_DAYS_ARRAY[index]])
					{
						disabledWeekDaysArray.push(index);
					}
				}
				toReturn = disabledWeekDaysArray.join();
				return toReturn;
			},

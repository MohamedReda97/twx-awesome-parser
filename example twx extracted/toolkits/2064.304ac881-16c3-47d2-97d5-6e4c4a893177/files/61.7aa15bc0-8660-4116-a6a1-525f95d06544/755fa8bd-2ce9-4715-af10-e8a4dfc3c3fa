var mixObject = {
	createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureGeneralStylesLoaded(this);
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");
			
			this.context.coachViewData.breadcrumbWrapper = domConstruct.create("div");
			domClass.add(this.context.coachViewData.breadcrumbWrapper, "Breadcrumbs");

			this.context.coachViewData.breadcrumbEnvelope = domConstruct.create("div");	
			domClass.add(this.context.coachViewData.breadcrumbEnvelope, "envelope");

			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.label = domConstruct.create("div");
			domClass.add(this.context.coachViewData.label, "breadcrumb-label");
			domAttr.set(this.context.coachViewData.label, "id", "BreadcrumbLabel_" + this.context.modelData.layoutItemIdPath);
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);
			
			this.context.coachViewData.navElement = document.createElement("NAV");
			domClass.add(this.context.coachViewData.navElement, "breadcrumb");
			
			var maxLen = 5;
			for(var count = 1; count <= maxLen ; count++){
				if(count != maxLen){
					var anchorElmnt = document.createElement("A");
					anchorElmnt.setAttribute("href", "javascript:void(0)");
					var txt = document.createTextNode("Level "+count);
					anchorElmnt.appendChild(txt);
					this.context.coachViewData.navElement.appendChild(anchorElmnt);
				} else {
					var lastSpanElement = document.createElement("SPAN");
					var lastTxt = document.createTextNode("Level "+count);
					lastSpanElement.appendChild(lastTxt);
					this.context.coachViewData.navElement.appendChild(lastSpanElement);
				}
			}						
									
			this.context.coachViewData.disablerDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.disablerDiv, "disabler hidden");
			
			domConstruct.place(this.context.coachViewData.breadcrumbWrapper, this.context.coachViewData.containingDiv);
			this.context.coachViewData.breadcrumbWrapper.appendChild(this.context.coachViewData.breadcrumbEnvelope);
			this.context.coachViewData.breadcrumbEnvelope.appendChild(this.context.coachViewData.label);
			this.context.coachViewData.breadcrumbEnvelope.appendChild(this.context.coachViewData.navElement);
			this.context.coachViewData.breadcrumbEnvelope.appendChild(this.context.coachViewData.disablerDiv);

			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, this.context.coachViewData.label, undefined, false, false);
			
			callback();
		}));	
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.label;
	},
	propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, configHelper){
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
		}));
    },

	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
	}
};

/**
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table>
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when control loads</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>if (${DeviceSensor}.getDeviceInfo().isIPhone) {me.setExpanded(false);} else {me.setExpanded(true);}</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Click:</td>
 *     <td colspan="2">
 *       <table>
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when control is clicked</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.toggleExpanded()</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Expand:</td>
 *     <td colspan="2">
 *       <table>
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when user expands text</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${TextReader2}.setExpanded(false)</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Collapse:</td>
 *     <td colspan="2">
 *       <table>
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when user collapses text</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${TextReader2}.setExpanded(true)</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitTextReader = function (bpmext, utilities, domClass, domAttr, domConstruct)
{
	this._instance = {
		expanded: false
	};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_EXPAND : "eventON_EXPAND",
			EVT_COLLAPSE : "eventON_COLLAPSE",
			EVT_ONCLICK : "eventON_CLICK",
			DEF_MAX_TEXT_LEN : 128,
			_setText : function (view)
			{
				try
				{
					var text = view.context.binding.get("value");
					
					if(text == null)
						text = "";

					var maxLen = view.context.options.maxTextLen.get("value");
					if(text.length > maxLen)
					{
						if (!view.context.options.useArrowIcons.get("value")) {
							var readHint;

							if(view._instance.expanded)
								readHint = view.context.options.readLessHint.get("value");
							else
							{
								readHint = view.context.options.readMoreHint.get("value");
								text = text.substring(0, maxLen) + "...";
							}
							
							view._instance.expButton.innerHTML = view.context.htmlEscape(readHint);
						}
						else {
							if (!view._instance.expButton.firstChild) {
								var icon = utilities.getCarbonIcon("ci-chevron-down");
								domConstruct.place(icon, view._instance.expButton);
							}
							if (view._instance.expanded) {
								domClass.add(view._instance.expButton, "expanded");
							}
							else
							{
								domClass.remove(view._instance.expButton, "expanded");
								text = text.substring(0, maxLen) + "...";
							}
						}
						
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							(view._instance.label != null && view._instance.label !="") ? view._instance.label.innerHTML : "", 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);						
					}
					else
					{
						if (!view.context.options.useArrowIcons.get("value")) {
							view._instance.expButton.innerHTML = "";
						}
					}
					
					view._instance.text.textContent = text;
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextReader._setText() error: " + e);
					bpmext.log.error("TextReader._setText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_getLabelElt : function (view)
			{
				if(!view._instance.label)
					this._createLabel(view);
				
				return view._instance.label;
			},
			_createLabel : function (view)
			{
				view._instance.label = document.createElement("label");
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.group, "first");
				domAttr.set(view._instance.label, "for", view._instance.textReader.id);
			},
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextReader._setLabelVisibility() error: " + e);
					bpmext.log.error("TextReader._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						if(view._instance.label)
						{
							view._instance.group.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextReader._setLabel() error: " + e);
					bpmext.log.error("TextReader._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHelpText : function (view, text)
			{
				utilities.setHelpText(view, text);
			},
			_setPlaceholder : function (view, text)
			{
				try
				{
					if(text)
						domAttr.set(view._instance.text, "placeholder", text);
					else
						domAttr.remove(view._instance.text, "placeholder");
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextReader._setPlaceholder() error: " + e);
					bpmext.log.error("TextReader._setPlaceholder() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);

				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			_setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else 
				{
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}
					
					domClass.remove(view.context.element, "labelWidth");
				}
			},
			_setSizeStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldSzStyle;
				
				newVal = bpmext.ui.util.normalizeSizeStyle(newVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);
				oldVal = bpmext.ui.util.normalizeSizeStyle(oldVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);

				bpmext.ui.util.replaceCSSClass(view._instance.textReader, bpmext.ui.util.OPTS_SZ_STL_CLZ, newVal, oldVal);
				view._instance.oldSzStyle = newVal;
				
				bpmext.ui.util.propagateUpSizeStyle(view, newVal);
				
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;
						
						domClass.add(view.context.element, "widthSet");
					}
					else 
					{
						view.context.element.style.width = null;

						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextReader._setWidth() error: " + e);
					bpmext.log.error("TextReader._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHeight : function (view, height)
			{
				try
				{
					if (height != null && height != "")
					{
						if (!isNaN(height))
							height += "px";

						//view.context.element.style.height = height;
						view._instance.textReader.style.height = height;
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("TextReader._setHeight() error: " + e);
					bpmext.log.error("TextReader._setHeight() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_handleVisibility : function (view)
			{
				var vis = utilities.handleVisibility(view.context);
				
				if (vis === "READONLY") {
					view._instance.textReader.setAttribute("disabled", "");
				} else {
					view._instance.textReader.removeAttribute("disabled");
				}

				// Updates for WAI
				if (domAttr.has(view._instance.textReader, "disabled")) {										
					domAttr.set(view._instance.textReader, "aria-disabled", "true");
				} else {
					domAttr.remove(view._instance.textReader, "aria-disabled");
				}
			},
			_updateControl : function (view)
			{
				//Color style
				var colStyle = view.context.options.colorStyle.get("value");
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_COL_STL_CLZ, colStyle, view._instance.oldColStyle);
				view._instance.oldColStyle = colStyle;
			}
		};

		/*
		Public control methods *************************************************************
		 */
		 
		/**
		 * @instance
		 * @memberof TextReader
		 * @method setLabel
		 * @param {string} label label for the text reader
		 * @desc Set label for text reader control
		 */
		this.constructor.prototype.setLabel = function (text)
		{
			this.context.options._metadata.label.set("value", text);
		};

		/**
		 * @instance
		 * @memberof TextReader
		 * @method getLabel
		 * @desc Get label associated with text reader control
		 * @returns {string}
		 */
		this.constructor.prototype.getLabel = function ()
		{
			return this.context.options._metadata.label.get("value");
		}
		
		/**
		 * @instance
		 * @memberof TextReader
		 * @method setLabelPlacement
		 * @param {string} placement "T"|"TOP"=Top | "L"|"LEFT"=Left
		 * @desc Set label placement for control.  NOTE: to avoid ambiguity always set the label placement using "T"|"L"
		 * @example me.setLabelPlacement("L");
		 */
		this.constructor.prototype.setLabelPlacement = function (plc)
		{
			this.context.options.labelPlacement.set("value", plc);
		};

		/**
		 * @instance
		 * @memberof TextReader
		 * @method getLabelPlacement
		 * @desc Get label placement for control.  NOTE: This always returns the label placement as set, to avoid ambiguity always set the label placement using "T"|"L"
		 * @returns {string}
		 * @example if(me.getLabelPlacement == "L"){me.setLabelPlacement("T");}
		 */
		this.constructor.prototype.getLabelPlacement = function ()
		{
			this.context.options.labelPlacement.get("value");
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method isLabelVisible
		 * @desc Get label visibility for text reader control
		 * @returns {boolean}
		 */
		this.constructor.prototype.isLabelVisible = function ()
		{
			return this.context.options._metadata.labelVisibility.get("value") == "SHOW";
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method setLabelVisible
		 * @param {boolean} flag set the visibility of the text reader
		 * @desc Set label visibility for text reader control
		 */
		this.constructor.prototype.setLabelVisible = function (flag)
		{
			this.context.options._metadata.labelVisibility.set("value", flag ? "SHOW" : "HIDE");
		};		
		
		/**
		 * @instance
		 * @memberof TextReader
		 * @method getLabelWidth
		 * @desc Get label width of text reader control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelWidth = function ()
		{
			this.context.options.labelWidth.get("value");
		};
		
		/**
		 * @instance
		 * @memberof TextReader
		 * @method setLabelWidth
		 * @param {string} labelWidth Control's label width
		 * @desc Set label width of text reader control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setLabelWidth = function (labelWidth)
		{
			this.context.options.labelWidth.set("value", labelWidth);
		};
		
		/**
		 * @instance
		 * @memberof TextReader
		 * @method getText
		 * @desc Get text for text reader control
		 * @returns {string}
		 */
		this.constructor.prototype.getText = function ()
		{
			var res = this.getData();
			return res == null ? "" : res;
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method setText
		 * @param {string} text the text in the text reader
		 * @desc Set text for text reader control
		 */
		this.constructor.prototype.setText = function (text)
		{
			this.context.binding.set("value", text);
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method setWidth
		 * @param {string} width width of the control
		 * @desc Set width of text reader control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (width)
		{
			this.context.options.width.set("value", width);
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method getWidth
		 * @desc Get configured width for text reader control (including unit)
		 * @returns {string}
		 */	
		this.constructor.prototype.getWidth = function ()
		{
			return this.context.options.width.get("value");
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method setHeight
		 * @param {string} height height of the control
		 * @desc Set height of text reader control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setHeight = function (height)
		{
			this.context.options.height.set("value", height);
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method getHeight
		 * @desc Get configured height for text reader control (including unit)
		 * @returns {string}
		 */	
		this.constructor.prototype.getHeight = function ()
		{
			return this.context.options.height.get("value");
		}		
		
		/**
		 * @instance
		 * @memberof TextReader
		 * @method setSizeStyle
		 * @param {string} style "DEFAULT"|"DEF"|"NORMAL"|"D"=Default | "SMALL"|"S"=Small | "LARGE"|"L"=Large
		 * @desc Sets size style of control.  NOTE: to avoid ambiguity always set the size style using "D"|"S"|"L"
		 */		
		this.constructor.prototype.setSizeStyle = function (style)
		{
			return this.context.options.sizeStyle.set("value", style);
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method getSizeStyle
		 * @desc Gets size style of control.  NOTE: This always returns the size style as set, to avoid ambiguity always set the size style using "D"|"S"|"L"
		 * @returns {string}
		 */		
		this.constructor.prototype.getSizeStyle = function ()
		{
			return this.context.options.sizeStyle.get("value");
		}
		
		/**
		 * @instance
		 * @memberof TextReader
		 * @method getReadMoreHint
		 * @desc Gets the "read more hint" text of the reader control
		 * @return {string}
		 */		
		this.constructor.prototype.getReadMoreHint = function ()
		{
			return this.context.options.readMoreHint.get("value");
		}		

		/**
		 * @instance
		 * @memberof TextReader
		 * @method setReadMoreHint
		 * @desc Sets the "read more hint" text of the reader control
		 * @param {string} text Text to set for the read more hint
		 */		
		this.constructor.prototype.setReadMoreHint = function (text)
		{
			this.context.options.readMoreHint.set("value", text);
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method getReadLessHint
		 * @desc Gets the "read less hint" text of the reader control
		 * @return {string}
		 */
		this.constructor.prototype.getReadLessHint = function ()
		{
			return this.context.options.readLessHint.get("value");
		}		

		/**
		 * @instance
		 * @memberof TextReader
		 * @method setReadLessHint
		 * @desc Sets the "read less hint" text of the reader control
		 * @param {string} text Text to set for the read less hint
		 */		
		this.constructor.prototype.setReadLessHint = function (text)
		{
			this.context.options.readLessHint.set("value", text);
		}
		
		/**
		 * @instance
		 * @memberof TextReader
		 * @method setExpanded
		 * @param {boolean} flag indicating the desired expanded state
		 * @desc Sets the expanded stated of text reader control. This has no effect is the text length in the control is not greater than the max text length allowed
		 * @returns {boolean} State after function is executed
		 */	
		this.constructor.prototype.setExpanded = function(flag)
		{
			this._instance.expanded = flag;
			this._proto._setText(this);
			
			if(this._instance.expanded)
				bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_EXPAND);
			else
				bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_COLLAPSE);
			
			return flag;
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method isExpanded
		 * @desc Gets the expanded stated of text reader control
		 * @returns {boolean} <code>true</code> if reader is currently expanded, <code>false</code> otherwise
		 */			
		this.constructor.prototype.isExpanded = function()
		{
			return this._instance.expanded;
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method toggleExpanded
		 * @desc Sets the expanded stated of text reader control. This has no effect is the text length in the control is not greater than the max text length allowed
		 * @returns {boolean} State after function is executed
		 */			
		this.constructor.prototype.toggleExpanded = function()
		{
			return this.setExpanded(!this.isExpanded())
		}
		
		/**
		 * @instance
		 * @memberof TextReader
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "textReader.3";
		}

		/**
		 * @instance
		 * @memberof TextReader
		 * @method setHelpText
		 * @param {string} helptext Help text for the control
		 * @desc Set help text for the control
		 */
		this.constructor.prototype.setHelpText = function (text) {
			this.context.options._metadata.helpText.set("value", text);
		};

		/**
		 * @instance
		 * @memberof TextReader
		 * @method getHelpText
		 * @desc Get help text associated with the control
		 * @returns {string}
		 */
		this.constructor.prototype.getHelpText = function () {
			return this.context.options._metadata.helpText.get("value");
		};

		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_EXPAND);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_COLLAPSE);
				

				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;
				
				if (!this.context.binding)
					this.context.binding = bpmext.ui.substituteObject(this);

				if (!opts.colorStyle)
					bpmext.ui.substituteConfigOption(this, "colorStyle", "D");

				if (!opts.sizeStyle)
					bpmext.ui.substituteConfigOption(this, "sizeStyle", "D");

				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if (!opts.height)
					bpmext.ui.substituteConfigOption(this, "height", null);

				if(!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");
				
				if(!opts.labelWidth)
					bpmext.ui.substituteConfigOption(this, "labelWidth", null);
				
				if(!opts.readMoreHint) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.ui.substituteConfigOption(this, "readMoreHint", "Show more");
					bpmext.ui.substituteConfigOption(this, "readMoreHint", bpmext.localization.formatMsg("controlTextReader", "TR_SHOW_MORE"));
				}

				if(!opts.readLessHint) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.ui.substituteConfigOption(this, "readLessHint", "Show less");
					bpmext.ui.substituteConfigOption(this, "readLessHint", bpmext.localization.formatMsg("controlTextReader", "TR_SHOW_LESS"));
				}
				
				if(!opts.maxTextLen)
					bpmext.ui.substituteConfigOption(this, "maxTextLen", this._proto.DEF_MAX_TEXT_LEN);
				
				if(!opts.initiallyExpanded)
					bpmext.ui.substituteConfigOption(this, "initiallyExpanded", false);

				if (!opts.useArrowIcons)
					bpmext.ui.substituteConfigOption(this, "useArrowIcons", false);

				this._instance.group = document.createElement("div");
				domClass.add(this._instance.group, "form-group");
				this._instance.input = document.createElement("div");
				domClass.add(this._instance.input, "input");
				
				this._instance.textReader = document.createElement("div");
				this._instance.text = document.createTextNode("");

				if (!opts.useArrowIcons.get("value")) {
					this._instance.expButton = document.createElement("a");
					this._instance.expButton.href = "javascript:void(0)";
				}
				else {
					this._instance.expButton = document.createElement("i");
					domClass.add(this._instance.expButton, "ci ci-chevron");
				}

				this._instance.expanded = opts.initiallyExpanded.get("value");

				var view = this;
				this._instance.expButton.onclick = function(event) {
					//{#bug: * Prevent click event propagation to Text Reader when anchor clicked}
					view.toggleExpanded();
					event.stopPropagation();
				}
				
				domClass.add(this._instance.textReader, "form-control");
				domAttr.set(this._instance.textReader, "id", "textreader-content" + this.context.controlidpath);

				this._instance.textReader.appendChild(this._instance.text);
				this._instance.textReader.appendChild(this._instance.expButton);
				this._instance.input.appendChild(this._instance.textReader);
				this._instance.group.appendChild(this._instance.input);
				this.context.element.appendChild(this._instance.group);

				if (opts.useArrowIcons.get("value") && utilities.handleVisibility(view.context) !== "READONLY") {
					domAttr.set(this._instance.textReader, "tabindex", 0);
					domAttr.set(this._instance.textReader, "style", "cursor: pointer");
					this._instance.input.onclick = function(event) {
						view.toggleExpanded();
						event.stopPropagation();
					}

					this._instance.textReader.onkeydown = function(event) {
						if (event.key === "Enter")
							view.toggleExpanded();
						event.stopPropagation();
					}
				}

				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					null,
					this.getText
					);				
				
				if(opts[this._proto.EVT_ONCLICK])
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLICK);
					
				this._instance.textReader.onclick = function (event)
				{
					if(!domClass.contains(this, "disabled"))
					{
						
							bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONCLICK);
					}
					return false;
				}
				
				bpmext.ui.loadView(this);

				this._proto._setSizeStyle(this, opts.sizeStyle.get("value"));
				this._proto._setLabelVisibility(this, opts._metadata.labelVisibility.get("value"));
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));
				this._proto._setWidth(this, opts.width.get("value"));
				this._proto._setHeight(this, opts.height.get("value"));
				if(this._proto._setText(this))
					this._proto._updateControl(this);

				var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.label":
						{
							this._proto._setLabel(this, event.newVal);
							this._proto._setHelpText(this, this.context.options._metadata.helpText.get("value"));
							break;
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.labelVisibility":
						{
							this._proto._setLabelVisibility(this, event.newVal);
							break;
						}
						case "_metadata.helpText":
                        {
							this._proto._setHelpText(this, event.newVal);
                            this._proto._updateControl(this);
                            break;
                        }
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "height":
						{
							this._proto._setHeight(this, event.newVal);
							break;
						}

						case "sizeStyle":
						{
							this._proto._setSizeStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "labelPlacement":
						{
							this._proto._setLabelPlacement(this, event.newVal);
							break;
						}
						case "labelWidth": 
						{
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}
						case "maxTextLen":
						case "readMoreHint":
						case "readLessHint":
						{
							this._proto._setText(this);
							break;
						}
                        case "initiallyExpanded":
                        {
                            this.setExpanded(event.newVal);
                            break;
                        }
					}
				}
				else if(event.insertedInto == event.removedFrom)
				{
					this._proto._setText(this);
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		/*
		this.constructor.prototype.validate = function (event)
		{
		};
		*/
		
		/*
		this.constructor.prototype.collaboration = function (event)
		{
		};
		*/
		
		this.constructor.prototype.unload = function ()
		{
			bpmext.ui.unloadView(this);
		};
	}
}

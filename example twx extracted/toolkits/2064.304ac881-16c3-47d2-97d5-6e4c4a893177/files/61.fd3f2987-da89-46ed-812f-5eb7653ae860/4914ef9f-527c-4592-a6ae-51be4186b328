        }
        /**
		 * @instance
		 * @memberof NavigationItem
		 * @method setIconLocation
		 * @param {string} direction Indicates the direction of the icon alignment (L - left | R - right)
		 * @desc Sets the direction of the icon alignment
		 */
		this.constructor.prototype.setIconLocation = function (location)
		{
			this.context.options.iconLocation.set("value", location);
			this._proto._setIconLocation(this);
		}
		/**
		 * @instance
		 * @memberof NavigationItem
		 * @method addPageToList
		 * @param {string} pageID : The page ID you want to add to the list of associated page for the navigation item
		 * @desc Adds page ID to the list of associated page within the navigation item, if page id is on the list, it will not add the item
		 */
		this.constructor.prototype.addPageToList = function (pageId)
		{
			if (!this.context.options.pageId) 
				this.context.options.pageId = bpmext.ui.substituteConfigOption(this, "pageId", []);
			var lstPage = this.context.options.pageId.get("value").items;
			if (lstPage && lstPage.length > 0) {
				var found=false;
				for (var i=0; i<lstPage.length; i++){
					if (lstPage[i] == pageId) {
						found=true;
						break;
					}
				}
				if (!found) {
					lstPage.push(pageId)
				}
			} else {
				lstPage.push(pageId);
			}
			this.context.options.pageId.set("value", lstPage);
		}
		/**
		 * @instance
		 * @memberof NavigationItem
		 * @method setExternalURL
		 * @param {string} targetURL : the url that will be set for the navigation item.
		 * @desc Sets the target URL for the navigation item.

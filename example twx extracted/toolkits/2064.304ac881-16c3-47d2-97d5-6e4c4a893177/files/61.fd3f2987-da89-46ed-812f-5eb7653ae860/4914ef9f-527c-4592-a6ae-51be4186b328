bpmext_control_InitSiteMenuItem = function (bpmext, domClass, utilities,domConstruct,fastclick) {
    this._instance = {
        navButton: null,
        multiClicks:true,
        txtNode:null,
        itemType : null
    };

    if (!this.constructor.prototype._proto) {
        this.constructor.prototype._proto = {
            EVT_ONCLICK : "eventON_CLICK",
            EVT_ONBOUNDARYEVT : "eventON_BOUNDARYEVT",
            _setText : function (view, text)
			{
				try
				{
					
					var mdt = view.context.options._metadata;
					var baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
					var genPrefTextDir = view.context.bpm.system.baseTextDirection;
					var txtNode = view._instance.txtNode;

					if (text != null && text.length != "")
					{
						txtNode.textContent = text; //view.context.htmlEscape(text);
						utilities.BiDi.applyTextDir(txtNode, txtNode.textContent, baseTxtDir, genPrefTextDir);
					}
					else
					{
						txtNode.textContent = "\u00a0"; //Non-breaking space to prevent button height collapse
					}
				}
				catch (e)
				{
					bpmext.log.error("Button._setText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) {
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
            _setIcon : function(view, icon)
			{
				if(view._instance.iconSpan)
				{
					view._instance.navButton.removeChild(view._instance.iconSpan);
					view._instance.iconSpan = null;
				}

				if(icon != null && icon != "")
				{
					var span = document.createElement("span");
                    var iconClasses = "";

					icon = icon.trim().toLowerCase();

                    if(bpmext.text.startsWith(icon, "ci-")) {
                        var svgElement = utilities.getCarbonIcon(icon);
                        if (svgElement) {
                            span.appendChild(svgElement);
                            iconClasses = "ci";
                        }
                    } else {
                        if(!bpmext.text.startsWith(icon, "fa-")) {
                            icon = "fa-" + icon;
                        }
                        iconClasses = "fa " + icon;
                    }

                    domClass.add(span, "btn-label icon " + iconClasses);
                    domClass.add(view._instance.navButton, "btn-labeled");
                    domConstruct.place(span, view._instance.navButton, "first");
                    view._instance.iconSpan = span;
				}
				else
				{
					domClass.remove(view._instance.navButton, "btn-labeled");
				}
				
				view._proto._setIconLocation(view);
            },
            _setIconLocation : function (view)
			{
            	try {
            		var location = view.getIconLocation();
    				var icon = view._instance.iconSpan;
    				var btn = view._instance.navButton;
    				
    				if (icon) 
    				{
    					if(location === "R")
    					{
    						domClass.remove(btn, "icon-left");
    						domClass.add(btn, "icon-right");
    					}
    					else
    					{
    						domClass.remove(btn, "icon-right");
    						domClass.add(btn, "icon-left");
    					}
    				}
    				else 
    				{
    					domClass.remove(btn, "icon-left");
    					domClass.remove(btn, "icon-right");
    				}
            	} catch (e) {}
			},
            _handleVisibility: function (view) {
            	if (view && view._instance && view._instance.navButton) {
            		var btn = view._instance.navButton;
    				var visibility = bpmext.ui.getEffectiveVisibility(view);

    				view.context.setDisplay(visibility != "NONE");
    				view.context.setVisibility(visibility != "HIDDEN");

    				if (visibility != "NONE")
    				{
    					if (visibility == "READONLY")
    					{
    						btn.disabled = true;
    						domClass.add(btn, "disabled");
    					}
    					else
    					{
    						btn.disabled = false;
    						domClass.remove(btn, "disabled");
    					}
    				}
            	}
            },

            _setHelpText : function(view, text){
				utilities.setHelpText(view, text);
            },
            _setLabelVisibility : function (view, flag)
			{
				try
				{
					if(!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("OutputText._setLabelVisibility() error: " + e);
					bpmext.log.error("OutputText._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
            },
            _getListPages : function (view) {
                var retVal = [];
                if (view.context.parentView() && view.context.parentView().context) {
                    listSubs = view.context.parentView().context.subview;

                    Object.keys(listSubs).forEach(function(key) {
                        if (view.context.parentView().context.getSubview(key) && 
                            view.context.parentView().context.getSubview(key).length > 0 &&
                            view.context.parentView().context.getSubview(key)[0].context.options.pageId) {
                                retVal.push(view.context.parentView().context.getSubview(key)[0].context.options.pageId.get("value"));
                            }
                    });
                }

                return retVal;
            },
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						if(view._instance.label)
						{
							this._setLabelVisibility(view, "HIDE");
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("OutputText._setLabel() error: " + e);
					bpmext.log.error("OutputText._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
        }
        

        /*

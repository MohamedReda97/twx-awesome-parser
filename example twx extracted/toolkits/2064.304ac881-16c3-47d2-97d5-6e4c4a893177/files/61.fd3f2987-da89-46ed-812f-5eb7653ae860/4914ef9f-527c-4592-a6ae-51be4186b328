        /*
        Coach NG Lifecycle methods *************************************************************
         */
        this.constructor.prototype.load = function () {
            try {
                var opts = this.context.options;
                var mdt = opts._metadata;
                
                /* We can set the page id for the binding later 
                if (!this.context.binding){
					this.context.binding = bpmext.ui.substituteObject(
							this,
							false //default value
						);
                }
                */

                // Set default value for icon
                if (!opts.icon)
                    opts.icon = bpmext.ui.substituteConfigOption(this, "icon", null);
                if (!opts.iconLocation)
                    bpmext.ui.substituteConfigOption(this, "iconLocation", "L");
                
                //create nav item element    
                this._instance.navButton = document.createElement("button");
                this._instance.navButton.setAttribute("id", "nav-button-"+this.context.controlidpath);
                this._instance.navButton.type = "button";
                this._instance.navButton.setAttribute("role", "button");
                this._instance.txtNode = document.createTextNode("");

                fastclick.attach(this._instance.navButton);
                
                this._proto._setText(this, mdt.label.get("value"));
                this._proto._setIcon(this, opts.icon.get("value"));
                
                domClass.add(this._instance.navButton, "btn btn-ghost");

                this._instance.navButton.appendChild(this._instance.txtNode)
                this.context.element.appendChild(this._instance.navButton);
                
                //Event support 
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLICK);
                bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONBOUNDARYEVT, "status");
                
                this._instance.multiClicks = !(opts.preventMultipleClicks ? opts.preventMultipleClicks.get("value") : false);

                var _this = this;

                this._instance.navButton.onclick = function (event) {
                    
                    var fireBE = bpmext.ui.executeEventHandlingFunction(_this, _this._proto.EVT_ONCLICK);
						//Note: The above calls the logic specified on the control's on click event
						//and captures the value returned by your code (assuming you return a value)
						if (fireBE)
						{
							if (!_this._instance.multiClicks)
							{
								_this._instance.navButton.disabled = true;
								domClass.add(_this._instance.navButton, "disabled");
							}

							if (_this.context.binding)
							{
                                // GOTO?
								//_this.context.binding.set("value", /* page id? */);
                            }
                            if (_this.context.options.itemType){
                                if (_this.context.options.itemType.get("value") == "url" && _this.context.options.externalURL) {
                                    window.open(_this.context.options.externalURL.get("value"), "", "width=800,height=600"); 
                                }
                            }
							_this.context.trigger(function (st)
							{
								_this._instance.navButton.disabled = false;
								domClass.remove(_this._instance.navButton, "disabled");

								setTimeout(function(){
									var _parent =_this.context.parentView().context.element.getElementsByClassName("panel-collapse collapse in");
									var col_panel = _this.context.parentView().context.element.getElementsByClassName("panel-heading");
									if (col_panel && col_panel.length > 0) {
										var col_panel_child = col_panel[0].children;
										if (col_panel_child && col_panel_child.length > 0) {
											if (!col_panel_child[0].classList.contains("collapsed")) {
												col_panel_child[0].classList.add("collapsed");
											}
										}
									}
									if (_parent && _parent.length > 0) {
										//collapse folder when clicked
										_parent[0].classList.remove("in")
									}
									bpmext.ui.executeEventHandlingFunction(_this, _this._proto.EVT_ONBOUNDARYEVT, st.status);
								});
							}, {callBackForAll : true});
						}
                }
                
                //Continue here for highlighting --------------------------------
               
                var currentPageId = this.context.bpm.system.currentPageInfo.id;
                
                if (opts.pageId && opts.pageId.get("value").items && opts.pageId.get("value").items.length > 0) {
                    var pages = opts.pageId.get("value").items;
                    for (var ctr=0; ctr < pages.length; ctr++) {
                        if (pages[ctr] == currentPageId) {
                            if (this.context.viewid.indexOf("Navigation_Item") == -1) {
								this.context.parentView().setPageLabel(mdt.label.get("value"));
                            } else {
                            	if (this.context.parentView().context.parentView()) {
                            		this.context.parentView().context.parentView().context.parentView().setPageLabel("<span style='font-size:9pt'>" + _this.context.parentView().context.parentView().context.options._metadata.label.get("value") + "</span><p style='margin:0'>" +_this.context.options._metadata.label.get("value") + "</p",1);
                                    this.context.parentView().context.parentView().context.element.setAttribute("aria-current", "page");
                                         
                                    var __this = this;
                                    setTimeout(function() {
    										
                                            var ac =  __this.context.parentView().context.element.getElementsByClassName("accordion-toggle")[0];
                                    
                                            ac.innerHTML = "<span class='subitemButton' style='font-size:9pt; font-weight:bold;white-space: nowrap;'>" +
                                                           __this.context.parentView().context.parentView().context.options._metadata.label.get("value") + 
                                                           "</span><p style='margin:0; margin-top:-2px; white-space:nowrap'>" +
                                                           __this.context.options._metadata.label.get("value") + "</p>";
                                            ac.style.padding = "0px 35px 0px 20px";
    										ac.style.border = "none";
    										
                                    }, 200);
                            	}    
                            }
                            
                            this.context.element.children[0].setAttribute("aria-current", "page");
                            
                        } else {}
                    }
                } 
                
                bpmext.ui.loadView(this);
            } catch (e) {
                
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
                if (e.stack) {
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.view = function () {
            try {
                this._proto._handleVisibility(this);
            } catch (e) {
                
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack) {
                    
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.change = function (event) {
            try {
                if (event.type == "config") {
                    switch (event.property) {
                        case "_metadata.label": {
                        	this._proto._setText(this, event.newVal);
                            break;
                        }
                        case "_metadata.visibility": {
                            this._proto._handleVisibility(event.newVal);
                            break;
                        }
                        case "iconLocation":
						{
							this._proto._setIconLocation(this);
							break;
						}
                        case "icon":
						{
							this._proto._setIcon(this, event.newVal);
							break;
						}
                        
                    }
                } else {
                    if(!this._instance.visibilityChangeInProgress === true && event.newVal !== event.oldVal)
                        event.newVal === true ? this.show() : this.hide();
                }
            } catch (e) {
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack) {
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.validate = function (event) {
            try {
                bpmext.ui.updateViewValidationState(this, event);
            } catch (e) {
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack) {
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.unload = function () {
            bpmext.ui.unloadView(this);
        };
    }

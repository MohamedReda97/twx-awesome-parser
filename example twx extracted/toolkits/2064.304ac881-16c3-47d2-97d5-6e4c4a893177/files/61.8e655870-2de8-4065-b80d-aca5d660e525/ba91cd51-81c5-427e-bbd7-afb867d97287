bpmext_control_InitButton = function (utilities, bpmext, domClass, domAttr, domConstruct, fastclick)
{
	/*
	Instance-specific "PRIVATE" data
	We use _instance so as to keep the number of attributes and functions visible at the main
	object level to a minimum. If we don't do that, people will see all kinds of extra
	functions and attributes at the main object level and assume it is ok to use them.

	We'll need to tell users/developers that anything under _instance is private and should
	not be accessed/called outide of the control.
	 */
	this._instance =
	{
		btn : null,
		txtNode : null,
		iconSpan : null,
		multiClicks : true,
		colorStyle : null,
		shapeStyle : null,
		sizeStyle : null
	};

	if (!this.constructor.prototype._proto)
	{
		/*
		Prototype-specific "PRIVATE" data - this is common to ALL instances of this control.

		We use _proto so as to keep the number of attributes and functions visible at the main
		object level to a minimum. If we don't do that, people will see all kinds of extra
		functions and attributes at the main object level and assume it is ok to use them.

		We'll need to tell users/developers that anything under _proto is private and should
		not be accessed/called ouside of the control.
		 */
		this.constructor.prototype._proto =
		{
			//Declarations for "private" constant values & structures
			OPTS_COL_STLZ :
			{
				"D" : "",
				"P": "btn-primary",
				"I" : "btn-info",
				"S" : "btn-success",
				"W" : "btn-warning",
				"G" : "btn-danger",
				//#{bug: * CSS class mapping fixed for "error" color style}
				"E" : "btn-danger",
				"B" : "btn-dark",
			},
			OPTS_SHP_STLZ :
			{
				"D" : "",
				"R" : "btn-rounded",
				"F" : "btn-flat"
			},
			OPTS_SZ_STLZ :
			{
				"D" : "",
				"L" : "btn-lg",
				"S" : "btn-sm",
				"X" : "btn-xs"
			},
			EVT_ONCLICK : "eventON_CLICK",
			EVT_ONBOUNDARYEVT : "eventON_BOUNDARYEVT",
			//Declarations for "private" functions
			_setText : function (view, text)
			{
				//In here, "this" refers to the "_proto" object, which is why we need to
				//pass a "view" reference to the Coach View

				try
				{
					//Example of accessing Coach View instance attributes and functions
					var mdt = view.context.options._metadata;
					var baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
					var genPrefTextDir = view.context.bpm.system.baseTextDirection;
					var txtNode = view._instance.txtNode;

					if (text != null && text.length != "")
					{
						txtNode.textContent = text; //view.context.htmlEscape(text);
						utilities.BiDi.applyTextDir(txtNode, txtNode.textContent, baseTxtDir, genPrefTextDir);
					}
					else
					{
						txtNode.textContent = "\u00a0"; //Non-breaking space to prevent button height collapse
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Button._setText() error: " + e);
					bpmext.log.error("Button._setText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHelpText : function (view, text)
			{
				try
				{
					var mdt = view.context.options._metadata;
					var btn = view._instance.btn;

					if (text != null && text.length != "")
					{
						btn.title = text;
					}
					else
					{
						btn.title = null;
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Button._setHelpText() error: " + e);
					bpmext.log.error("Button._setHelpText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;

						domClass.add(view.context.element, "widthSet");
					}
					else
					{
						view.context.element.style.width = null;
						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("Button._setWidth() error: " + e);
					bpmext.log.error("Button._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_replaceClass : function (view, valueMap, newVal, oldVal)
			{
				if(newVal != null)
					newVal = newVal.toUpperCase();

				if(oldVal != null)
					oldVal = oldVal.toUpperCase();

				var oldClass = valueMap[oldVal];
				if(oldClass == null)
					oldClass = "";

				var newClass = valueMap[newVal];
				if(newClass == null)
					newClass = "";

				domClass.replace(view._instance.btn, newClass, oldClass);
			},
			_setColorStyle : function (view, newVal, oldVal)
			{
				oldVal = bpmext.ui.util.normalizeColorStyle(oldVal,this.OPTS_COL_STLZ);
				newVal = bpmext.ui.util.normalizeColorStyle(newVal,this.OPTS_COL_STLZ);
				newVal = bpmext.ui.util.normalizeColorStyle(newVal,this.OPTS_COL_STLZ);
				this._replaceClass(view, this.OPTS_COL_STLZ, newVal, oldVal);
			},
			_normalizeShapeStyle : function(val)
			{
				if(!val)
					val = "D";

				val = val.toUpperCase();
				if(val.length > 1)
				{
					switch(val)
					{
						case "DEFAULT":
						//{#bug: * Removed warning "Unexpected shape style value: DEF"}
						case "DEF":
						case "D":
							val = "D";
							break;
						case "ROUND":
						case "ROUNDED":
							val = "R";
							break;
						case "FLAT":
							val = "F";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected shape style value: " + val);
							bpmext.log.warn(bpmext.localization.formatMsg("controlButton", "BTN_SHAPE_STYLE_WARNING", val));
					}
				}

				return val;
			},
			_setShapeStyle : function (view, newVal, oldVal)
			{
				newVal = this._normalizeShapeStyle(newVal);
				oldVal = this._normalizeShapeStyle(oldVal);

				this._replaceClass(view, this.OPTS_SHP_STLZ, newVal, oldVal);
			},
			_setSizeStyle : function (view, newVal, oldVal)
			{
				//{#bug: BG-252 Normalized size style for Button}
				newVal = bpmext.ui.util.normalizeSizeStyle(newVal,this.OPTS_SZ_STLZ);
				oldVal = bpmext.ui.util.normalizeSizeStyle(oldVal,this.OPTS_SZ_STLZ);

				this._replaceClass(view, this.OPTS_SZ_STLZ, newVal, oldVal);
			},
			_setOutline : function(view, outline)
			{
				var fn = outline ? domClass.add : domClass.remove;
				fn(view._instance.btn, "btn-outline");
			},
			_setGhostMode : function(view, ghostMode)
			{
				var fn = ghostMode ? domClass.add : domClass.remove;
				fn(view._instance.btn, "btn-ghost");
			},
			_setIcon : function(view, icon)
			{
				if(view._instance.iconSpan)
				{
					view._instance.btn.removeChild(view._instance.iconSpan);
					view._instance.iconSpan = null;
				}

				if(icon != null && icon != "")
				{
					var span = document.createElement("span");
                    var iconClasses = "";

					icon = icon.trim().toLowerCase();

                    if(bpmext.text.startsWith(icon, "ci-")) {
                        var svgElement = utilities.getCarbonIcon(icon);
                        if (svgElement) {
                            span.appendChild(svgElement);
                            iconClasses = "ci";
                        }
                    } else {
                        if(!bpmext.text.startsWith(icon, "fa-")) {
                            icon = "fa-" + icon;
                        }
                        iconClasses = "fa " + icon;
                    }

                    domClass.add(span, "btn-label icon " + iconClasses);
                    domClass.add(view._instance.btn, "btn-labeled");
                    domConstruct.place(span, view._instance.btn, "first");
                    view._instance.iconSpan = span;
				}
				else
				{
					domClass.remove(view._instance.btn, "btn-labeled");
				}
				
				view._proto._setIconLocation(view);
			},
			_handleVisibility : function (view)
			{
				var btn = view._instance.btn;
				var visibility = bpmext.ui.getEffectiveVisibility(view);

				view.context.setDisplay(visibility != "NONE");
				view.context.setVisibility(visibility != "HIDDEN");

				if (visibility != "NONE")
				{
					if (visibility == "READONLY")
					{
						btn.disabled = true;
						domClass.add(btn, "disabled");
					}
					else
					{
						btn.disabled = false;
						domClass.remove(btn, "disabled");
					}
				}

				// Updates for WAI
				if (btn.disabled) {										
					domAttr.set(btn, "aria-disabled", "true");
				} else {					
					domAttr.remove(btn, "aria-disabled");
				}
			},
			_setTabIndex : function (view, index)
			{
				if(index != null)
					domAttr.set(view._instance.btn, "tabindex", index);
				else
					domAttr.remove(view._instance.btn, "tabindex");
			},
			_setIconLocation : function (view)
			{
				var location = view.getIconLocation();
				var icon = view._instance.iconSpan;
				var btn = view._instance.btn;
				
				if (icon) 
				{
					if(location === "R")
					{
						domClass.remove(btn, "icon-left");
						domClass.add(btn, "icon-right");
					}
					else
					{
						domClass.remove(btn, "icon-right");
						domClass.add(btn, "icon-left");
					}
				}
				else 
				{
					domClass.remove(btn, "icon-left");
					domClass.remove(btn, "icon-right");
				}
			}
		};


		/*
		Public control methods *************************************************************
		 */

		/**
		 * @instance
		 * @memberof Button
		 * @method setText
		 * @param {string} text Text to be set on the button
		 * @desc Set text of button
		 */
		this.constructor.prototype.setText = function (text)
		{
			this.context.options._metadata.label.set("value", text);
		};

		/**
		 * @instance
		 * @memberof Button
		 * @method getText
		 * @desc Get text of button
		 * @returns {string}
		 */
		this.constructor.prototype.getText = function ()
		{
			return this.context.options._metadata.label.get("value");
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method setHelpText
		 * @param {string} text Rollover text to be set
		 * @desc Set help text for button
		 */
		this.constructor.prototype.setHelpText = function (text)
		{
			this.context.options._metadata.helpText.set("value", text);
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method getHelpText
		 * @desc Get help text for button
		 * @returns {string}
		 */
		this.constructor.prototype.getHelpText = function ()
		{
			return this.context.options._metadata.helpText.get("value");
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method setWidth
		 * @param {string} width Button width
		 * @desc Set width of button (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (width)
		{
			this.context.options.width.set("value", width);
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method getWidth
		 * @desc Get configured width for button (including unit)
		 * @returns {string}
		 */
		this.constructor.prototype.getWidth = function ()
		{
			return this.context.options.width.get("value");
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method setIcon
		 * @param {string} icon See {@link http://fontawesome.io/icons Font Awesome} for a comprehensive list of icons. Refer to the knowledge center for the latest Font Awesome version.
		 * @desc Sets icon to display on the button
		 */
		this.constructor.prototype.setIcon = function (icon)
		{
			return this.context.options.icon.set("value", icon);
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method setColorStyle
		 * @param {string} style "DEFAULT"|"DEF"|"D"=Default | "PRIMARY"|"PRI"|"P"=Primary | "INFO"|INF"|"I"=Info | "SUCCESS"|"S"=Success | "WARNING"|"WARN"|"W"=Warning | "DANGER"|ERROR|ERR"|"E"|"G"=Danger | "BLACK"|BLACK|"BLK"|"B"|"B"=Black
     	 * @desc Sets color style of button.  NOTE: to avoid ambiguity always set the color using "D"|"P"|"I"|"S"|"W"|"E"|"B"
		 */
		this.constructor.prototype.setColorStyle = function (style)
		{
			this.context.options.colorStyle.set("value", style);
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method getColorStyle
		 * @desc Gets color style of button.  NOTE: This always returns the color as set, to avoid ambiguity always set the color using "D"|"P"|"I"|"S"|"W"|"E"
		 * @returns {string}
		 */
		this.constructor.prototype.getColorStyle = function ()
		{
			return this.context.options.colorStyle.get("value");
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method setShapeStyle
		 * @param {string} style "Default"|"D"=Default | "ROUNDED"|ROUND"|"R"=Rounded | "FLAT"|"F"=Flat
		 * @desc Sets shape style of button.  NOTE: to avoid ambiguity always set the shape style using "D"|"R"|"F"
		 */
		this.constructor.prototype.setShapeStyle = function (style)
		{
			return this.context.options.shapeStyle.set("value", style);
		}

		//{#feature: * getShapeStyle method added}
		/**
		 * @instance
		 * @memberof Button
		 * @method getShapeStyle
		 * @desc Gets shape style of button.  NOTE: This always returns the shape style as set, to avoid ambiguity always set the shape style using "D"|"R"|"F"
		 * @returns {string}
		 */
		this.constructor.prototype.getShapeStyle = function ()
		{
			return this.context.options.shapeStyle.get("value");
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method setSizeStyle
		 * @param {string} style "DEFAULT"|"DEF"|"NORMAL"|"D"=Default | "SMALL"|"S"=Small | "LARGE"|"L"=Large | "EXTRA-SMALL"|"X-SMALL"|"XS"|"X"=X-small
		 * @desc Sets size style of button.  NOTE: to avoid ambiguity always set the size style using "D"|"S"|"L"|"X"
		 */
		this.constructor.prototype.setSizeStyle = function (style)
		{
			return this.context.options.sizeStyle.set("value", style);

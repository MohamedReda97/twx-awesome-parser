		{
			this._instance.btn.click();
		}

		/**
		 * @instance
		 * @memberof Button
		 * @method setTabIndex
		 * @param {integer} tabIndex Tab indices start at 1 and may be set sparsely
		 * @desc Sets tab index of Button control
		 */

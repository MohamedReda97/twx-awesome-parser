		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				//Good practice to make life easier: If binding is not set make it easy to
				//use with SPARK
				if (!this.context.binding)
				{
					this.context.binding = bpmext.ui.substituteObject(
							this,
							false //default value
						);
				}

				//Good practice to make life easier: If a config option is not defined/set, make it
				//easy to use with SPARK
				if (!opts.colorStyle)
				{
					opts.colorStyle = bpmext.ui.substituteConfigOption(
							this,
							"colorStyle",
							"DEF" //default value
						);
				}

				if (!opts.shapeStyle)
					opts.shapeStyle = bpmext.ui.substituteConfigOption(this, "shapeStyle", "DEF");

				if (!opts.sizeStyle)
					opts.sizeStyle = bpmext.ui.substituteConfigOption(this, "sizeStyle", "DEF");

				if (!opts.outline)
					opts.outline = bpmext.ui.substituteConfigOption(this, "outline", false);
				
				if (!opts.ghostMode)
					opts.ghostMode = bpmext.ui.substituteConfigOption(this, "ghostMode", false);

				if (!opts.width)
					opts.width = bpmext.ui.substituteConfigOption(this, "width", null);

				if (!opts.icon)
					opts.icon = bpmext.ui.substituteConfigOption(this, "icon", null);

				if (!opts.tabIndex)
					bpmext.ui.substituteConfigOption(this, "tabIndex", null);
				
				if (!opts.iconLocation)
					bpmext.ui.substituteConfigOption(this, "iconLocation", "L");

				this._instance.btn = document.createElement("button");
				this._instance.btn.setAttribute("id", "button-button-"+this.context.controlidpath);
				//{#feature: TK-306 Work around weird IE11 update bug with Enter key the default button type is submit which causes some versions of IE11 problems}
				this._instance.btn.type = "button";
                this._instance.btn.setAttribute("role", "button");
				this._instance.txtNode = document.createTextNode("");

				fastclick.attach(this._instance.btn);

				domClass.add(this._instance.btn, "btn");

				this._proto._setText(this, mdt.label.get("value"));
				this._proto._setWidth(this, opts.width.get("value"));
				this._proto._setColorStyle(this, opts.colorStyle.get("value"));
				this._proto._setShapeStyle(this, opts.shapeStyle.get("value"));
				this._proto._setSizeStyle(this, opts.sizeStyle.get("value"));
				this._proto._setOutline(this, opts.outline.get("value"));
				this._proto._setGhostMode(this, opts.ghostMode.get("value"));
				this._proto._setIcon(this, opts.icon.get("value"));
				this._proto._setTabIndex(this, opts.tabIndex.get("value"));

				var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}

				this._instance.btn.appendChild(this._instance.txtNode);
				this.context.element.appendChild(this._instance.btn);

				//Event support - for example, support the onclick event
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCLICK);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONBOUNDARYEVT, "status");
				//Note: Later in the logic of this control, the event can be triggered through:
				//  bpmext.ui.executeEventHandlingFunction(this, "eventON_CLICK");


				this._instance.multiClicks = !(opts.preventMultipleClicks ? opts.preventMultipleClicks.get("value") : false);

				var _this = this;

				this._instance.btn.onclick = function (event)
				{
					if (!_this._instance.btn.disabled)
					{
						//Example of triggering the onClick event for Button:
						var fireBE = bpmext.ui.executeEventHandlingFunction(_this, _this._proto.EVT_ONCLICK);
						//Note: The above calls the logic specified on the control's on click event
						//and captures the value returned by your code (assuming you return a value)
						if (fireBE)
						{
							if (!_this._instance.multiClicks)
							{
								_this._instance.btn.disabled = true;
								domClass.add(_this._instance.btn, "disabled");
							}

							if (_this.context.binding)
							{
								// {#bug: * changed to match IBM button behaviour}
								_this.context.binding.set("value", true);
							}

							_this.context.trigger(function (st)
							{
								_this._instance.btn.disabled = false;
								domClass.remove(_this._instance.btn, "disabled");

								setTimeout(function(){
									bpmext.ui.executeEventHandlingFunction(_this, _this._proto.EVT_ONBOUNDARYEVT, st.status);
								});
							}, {callBackForAll : true});
						}
					}
				}

				//**Note: To compute the value of this control through a formula, this control MUST have a
				//String option named "expression" as the formula placeholder

				//Enabling a control with formula support
				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					function (expResult) //Function to be called when the formula for this control is computed
					{
						if (expResult == undefined)
						{
							expResult = "";
						}

						_this.setText(expResult); //In this case, the button's label updates based on the result of the formula expression
					},
					this.getText //Getter method pointer to be called when this control is referenced with @{control-id} in formulas
				);

				//Register this Coach View instance as an SPARK control
				bpmext.ui.loadView(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.label":
						{
							this._proto._setText(this, event.newVal);

							//Let formula subscribers know this control has changed

							//If this control is formula-support enabled, broadcastExpressionTrigger will trigger
							//whatever formula dependency chains that are associated with this control...
							//
							//broadcastExpressionTrigger() can be called for ANY changes in the control, or only
							//for specific situations to make formula-based updates less chatty
							bpmext.ui.broadcastExpressionTrigger(this);
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.helpText":
						{
							this._proto._setHelpText(this, event.newVal);
							break;
						}
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "colorStyle":
						{
							this._proto._setColorStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "shapeStyle":
						{
							this._proto._setShapeStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "sizeStyle":
						{
							this._proto._setSizeStyle(this, event.newVal, event.oldVal);
							break;
						}
						case "outline":
						{
							this._proto._setOutline(this, event.newVal);
							break;
						}
						case "ghostMode":
						{
							this._proto._setGhostMode(this, event.newVal);
							break;
						}
						case "icon":
						{
							this._proto._setIcon(this, event.newVal);
							break;
						}
						case "iconLocation":
						{
							this._proto._setIconLocation(this);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
			}
		};

		this.constructor.prototype.validate = function (event)
		{};

		this.constructor.prototype.collaboration = function (event)
		{};

		this.constructor.prototype.unload = function ()
		{
			//Deregister this Coach View instance from SPARK
			bpmext.ui.unloadView(this);
		};
	}
}

								view.context.options._metadata.label.set("value", view.raveBidiFormatter(dataSeries.seriesName));

								if (pieStyle) {
									var columns = [];

									for (var i = 0; i < dataSeries.dataPoints.items.length; i++) {
										var val = dataSeries.dataPoints.items[i].value;
										var label = dataSeries.dataPoints.items[i].label;
										//BPM: Bidi Formatting
										label = view.raveBidiFormatter(label);

										columns.push([label, val]);
									}

									var unloadIds = [];
									var data = view._instance.chart.data();
									for (var i = 0; i < data.length; i++)
										unloadIds.push(data[i].id);

									bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONREFRESH);

									view._instance.chart.load({
										columns : columns,
										unload : unloadIds,
										done : function () {
											view._instance._cdColIdx = 0
										}
									});

									//BPM Set Keyboard Navaigation - START
									setTimeout(function(){
										view._proto._enableAccessibility(view, chartType, dataSeries);
									}, 500);
									//BPM Set Keyboard Navaigation - END
								} else {
									var xAxisData = ['x'];
									var chartData = [dataSeries.seriesName || 'data1'];
									var minVal = 9007199254740992;
									var maxVal = -minVal;

									for (var i = 0; i < dataSeries.dataPoints.items.length; i++) {
										var val = dataSeries.dataPoints.items[i].value;
										if (val > maxVal)
											maxVal = val;

										if (val < minVal)
											minVal = val;
										//BPM: Bidi Formatting
										xAxisData.push(view.raveBidiFormatter(dataSeries.dataPoints.items[i].label));
										chartData.push(val);
									}

									bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONREFRESH);

									view._instance.chart.load({
										columns : [xAxisData, chartData]
									});

									//BPM Set Keyboard Navaigation - START
									setTimeout(function(){
										view._proto._enableAccessibility(view, chartType, dataSeries);
									}, 500);
									//BPM Set Keyboard Navaigation - END
								}

								//Update breadcrumbs
								view._instance.chartTrailNode.innerHTML = "";

								for (var k = 0; k < view._instance._drillDownStack.length; k++) {
									var li = document.createElement("li");
									var link = document.createElement("a");
									li.appendChild(link);

									var name = view._instance._drillDownStack[k].name;

									link.onclick = view._proto._makeBreadCrumbsClickableLink(view, view._instance._drillDownStack, k, name);
									link.setAttribute("href", "javascript:void(0)");

									if (k == view._instance._drillDownStack.length - 1) {
										//{#feature: US-1330 Added RT localization}
										//link.setAttribute("title", "Refresh " + view._instance._drillDownStack[k].name);
										link.setAttribute("title", bpmext.localization.formatMsg("general", "REFRESH") + " " + view._instance._drillDownStack[k].name);
									} else {
										//{#feature: US-1330 Added RT localization}
										//link.setAttribute("title", "Drill-up to " + view._instance._drillDownStack[k].name);
										link.setAttribute("title", bpmext.localization.formatMsg("controlChart", "CHART_DRILL_UP") + " " + bpmext.localization.formatMsg("general", "TO") + " " + view._instance._drillDownStack[k].name);
									}

									//BPM bidi formatting
									link.innerHTML = view.raveBidiFormatter(view._instance._drillDownStack[k].name);

									view._instance.chartTrailNode.appendChild(li);

									if (k < view._instance._drillDownStack.length - 1) {
										var val = view._instance._drillDownStack[k].value;
										if (val != null && val != "null") //TODO Cleanup "null" check
										{
											//BPM bidi formatting
											val = view.raveBidiFormatter(val);
											var span = document.createElement("span");
											span.appendChild(document.createTextNode(" (" + val + ")"));
											li.appendChild(span);
										}
									}
								}

								//Update chart menu analytics section
								view._instance._duMenuItems = [];
								view._instance._ddMenuItems = [];

								if (view._instance._drillDownStack.length > 1) {
									//{#feature: US-1330 Added RT localization}
									view._proto._addMenuAction(
										view,
										view._instance._duMenuItems,
										"DrillUP",
										"level-up",
										//"Drill-up",
										bpmext.localization.formatMsg("controlChart", "CHART_DRILL_UP"),
										"1",
										function () {
										view._proto._doDrillUp(view);
										if (view.context.options[view._proto.EVT_ONMENUCMD]) {
											var action = {
												name : "DrillUP"
											};

											if (view.isEnabled()) {
												bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONMENUCMD, action);
											}
										}
									});
								}

								if (availableForDrillDown && availableForDrillDown.items) {
									for (var j = 0; j < availableForDrillDown.items.length; j++) {
										//{#feature: US-1330 Added RT localization}
										view._proto._addMenuAction(
											view,
											view._instance._ddMenuItems,
											"DrillDown" + j,
											"level-down",
											//"Drill-down on [" + availableForDrillDown.items[j].name + "]...",
											bpmext.localization.formatMsg("controlChart", "CHART_DRILL_DOWN_ON") + " [" + availableForDrillDown.items[j].name + "]...",
											null,
											(function (dimension) {
												return function () {
													view._proto._doDrillDown(view, dimension);
													if (view.context.options[view._proto.EVT_ONMENUCMD]) {
														var action = {
															name : "DrillDown" + j
														};

														if (view.isEnabled()) {
															bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONMENUCMD, action);
														}
													}
												}
											})(availableForDrillDown.items[j].name));
									}
								}
							}

							if (view._proto.OPTS_LEGEND_PLC[view.context.options.legendPlacement.get("value")] != "")
								view._instance.chart.legend.show();

							//Nividous: BG-774: Donut/Pie Charts throwing Uncaught TypeError when refreshing table
							if(view._instance.chart){
								view.ui.get().setEnabled(true);
								//Ends: BG-774

								//defect 284182 - chart controls not visible within a modal dialog
								if (originalVis !== undefined) {
									view.context.options._metadata.visibility.set("value", originalVis);
								}
							}
						});
					}
				}
				finally {
					//{#bug: * Fixed chart update refresh flag for IE to allow drill-down}
					delete view._instance._refreshing;

					if (!pieStyle) {
						if (
							view._instance.chart.element.children &&
							view._instance.chart.element.children.length > 0 &&
							view._instance.chart.element.children[0].children &&
							view._instance.chart.element.children[0].children.length > 1 &&
							view._instance.chart.element.children[0].children[1].children) {
							var chartElements = view._instance.chart.element.children[0].children[1].children;

							for (var i = 0; i < chartElements.length; i++) {
								if (chartElements[i].classList.contains("c3-axis-x") || chartElements[i].classList.contains("c3-axis-y"))
									chartElements[i].style.visibility = "inherit";
							}
						}
					}
				}
			},
			_onChartRender : function (view, chartInternal) {
            	if(view._instance.chart) {
            		if(!view._instance.chart_onrendered) {
	            		view._instance.chart_onrendered = true;

	            		setTimeout(function() {
	            			if(chartInternal.api && chartInternal.api.resize) {
	            				chartInternal.api.resize();
	            			}
	            		}, 350);
	            	}

	            	if(document.body.dir == "rtl") {
	            		//When chart is refreshed mirroring information(attributes) on certain nodes is lost causing display issues. Therefore need to reset mirroring.
	            		view._proto._mirrorChart(view, false);
	            		var svg = view._instance.chart.element.querySelector("svg");
	            		delete svg["__owner__"];
	            		view._proto._mirrorChart(view, true);
            		}
            	}
			},
			_mirrorChart : function (view, enabled) {
				//BPM Bidi - mirror if needed
				var svg = rave.select(view._instance.chart.element.querySelector("svg"));
				if (document.body.dir == "rtl" && svg) {
					if (svg && svg.mirror) {
						svg.mirror(enabled);
					}
				}
			},
			_enableAccessibility : function (view, chartType, data) {
				var getData = function(d) {
					if (data.dataPoints && data.dataPoints[d.index]) {
						return data.dataPoints[d.index];
					} else if (data.dataPoints && data.dataPoints.items && data.dataPoints.items[d.index]) {
						return data.dataPoints.items[d.index];
					} else if (data.items) {
						var i;
						for(i=0; i<data.items.length; i++){
							if (data.items[i].seriesName === d.id) {
								if (data.items[i].dataPoints && data.items[i].dataPoints.items) {
									return data.items[i].dataPoints.items[d.index];
								}
							}
						}
					}
				}

				//Chart
				view._instance.rchart = rave.select(view._instance.chart.element.getElementsByTagName('svg')[0])
					//Enable accessibility
					.extension("raveAccessibility")
					//Make the parent div the owner
					.owner(view._instance.chartContainerNode)
					//Accessiblity info
					.info({
						label: data.seriesName,
						role: "tree"
					});
				
				domAttr.set(view._instance.rchart.selector[0][0], "aria-label", data.seriesName);

				//Main 'g' element
				var mainG = view._instance.rchart.select('g').info({});

				//Chart 'g' element
				var c3Chart = mainG.select('.c3-chart').info({});

				if(chartType === 'bar') {
					//Bar Chart wrapper
					var c3ChartBars = c3Chart.select('.c3-chart-bars').info({});
					c3ChartBars.selectAll('g, path')
						.info(function(d){
							var classes = this.className.baseVal;
							if(classes.search('c3-bars') !== -1){
								return {
									label: data.seriesName || d.id
								}
							} else if(classes.search('c3-bar') !== -1) {
								return {
									label: 'Label: ' + d.id + ', value: ' + d.value,
									role: 'treeitem'
								}
							} else {
								return {
									label: d.id
								};
							}
						});
				} else if(chartType === 'line' || chartType === 'area' || chartType.indexOf('step') !== -1 || chartType.indexOf('spline') !== -1) {
					//Line Chart wrapper
					var c3ChartLines = c3Chart.select('.c3-chart-lines').info({});
					var c3ChartLine = c3Chart.selectAll('.c3-chart-line').info(function(d){
						return{
							label: d.id
						};
					});
					c3ChartLine.selectAll('.c3-circles, circle')
						.info(function(d){
							var classes = this.className.baseVal;
							if(classes.search('c3-circles') !== -1){
								return {
									label: data.seriesName || d.id
								};
							} else if(classes.search('c3-circle') !== -1){
								return {
									label: 'Label: ' + d.id + ', value: ' + d.value,
									role: 'treeitem'
								};
							}
						});
				} else if(chartType === 'pie' || chartType === 'donut') {
					//Pie Chart wrapper
					var c3ChartArcs = c3Chart.select('.c3-chart-arcs').info({});
					c3ChartArcs.selectAll('.c3-chart-arc')
						.info(function(d){
							//Contrast Shift
							var path = this.querySelector('path');
							var text = this.querySelector('text');
							text.style.fill = rave.rgb(path.rave_getComputedStyles().fill).contrastShift(text.rave_getComputedStyles().fill, 5);

							return{
								label: d.data.id + ': value: ' + d.value,
								role: 'treeitem'
							};
						});
				}

				if(chartType !== 'pie' && chartType !== 'donut') {
					//X axis
					var bottomAxisNode = mainG.select('.c3-axis-x')
						.info({
							label: "X Axis"
						});

					bottomAxisNode.selectAll('.tick')
						.info(function(d){
							var tspan = this.querySelector('tspan');
							var data = rave.select(tspan).data();
							return{
								label: data[0].splitted,
								role: 'treeitem'
							}
						});

					//Y axis
					var leftAxisNode = mainG.select('.c3-axis-y')
						.info({
							label: "Y Axis"
						});

					leftAxisNode.selectAll('.tick')
						.info(function(d){
							var tspan = this.querySelector('tspan');
							var data = rave.select(tspan).data();
							return{
								label: data[0].splitted,
								role: 'treeitem'
							}
						});
				}

				var rects = mainG.selectAll('.c3-event-rect').selector[0];

				// Invoke a11y keyboard navigation
				var kb = rave.accessibility.navigation.keyboard();
				kb.keyBinding().on(9, function(e){
					rects.forEach(function(element){
						element.__onmouseout(rave.event);
					});
				}.bind(view));
				view._instance.rchart.call(kb);

				// Setup event listeners
				mainG.on("ravefocus", function() {
					if(rave.event.target.rave_hasData()){
						var data = rave.event.target.rave_getData();
						if(data.values){
							this._instance.chart.select([data.id]);
						} else if(data && (typeof data.index === 'number')){
							this._instance.chart.select(null, [data.index], true);
							if(rects[data.index]) {
								rects[data.index].__onmouseover(rave.event);
								this._instance.chart.tooltip.show({x: data.x});
							}
						} else if(data && data.data){
							var path = rave.event.target.querySelector('.c3-shape');
							if(path){
								data.clientX = path.getBoundingClientRect().x + path.getBoundingClientRect().width / 2;
								data.clientY = path.getBoundingClientRect().y - 10;
								path.__onmousemove(data);
							}
							this._instance.chart.focus([data.data.id]);
						}
					}
					rave.select(rave.event.target).classed("selectedItem", true);
				}.bind(view));

				mainG.on("raveblur", function() {
					this._instance.chart.unselect();
					this._instance.chart.revert();
					rave.select(rave.event.target).classed("selectedItem", false);
					var data = rave.event.target.rave_getData();
					if(data && (typeof data.index === 'number') && rects[data.index]){
						rects[data.index].__onmouseout(rave.event);
					} else if(data && data.data){
						var path = rave.event.target.querySelector('.c3-shape');
						if(path){
							path.__onmouseout(rave.event);
						}
					}
				}.bind(view));
			}
		}

		/**
		 * @instance
		 * @memberof Chart
		 * @method addStaticMenuAction
		 * @desc Adds an action to the chart's popup menu and optionally attaches logic to it
		 * @param {String} action An identifier for this action
		 * @param {String} menuItemLabel The label of the menu item
		 * @param {String} [icon] (Font Awesome) icon name for the menu item. See {@link http://fontawesome.io/icons Font Awesome} for a comprehensive list of icons. Refer to the knowledge center for the latest Font Awesome version.
		 * @param {String} [badgeText] text/value to show in a badge next to the menu item
		 * @param {function} [onClickFunction] a callback function to be invoked when the menu item is clicked. If omitted, the "on menu action" event will be called when the item is clicked
		 */
		this.constructor.prototype.addStaticMenuAction = function (action, menuItemLabel, icon, badgeText, onClickFn) {
			this._proto._addMenuAction(this, this._instance._ptMenuItems, action, icon, menuItemLabel, badgeText, onClickFn);
		}

		/**
		 * @instance
		 * @memberof Chart
		 * @method addTempMenuAction
		 * @desc Adds an action to the chart's popup menu and optionally attaches logic to it. This method should ONLY be called from the On Click event of the chart - otherwise it will not be displayed in the menu
		 * @param {String} action An identifier for this action
		 * @param {String} menuItemLabel The label of the menu item
		 * @param {String} [icon] (Font Awesome) icon name for the menu item. See {@link http://fontawesome.io/icons Font Awesome} for a comprehensive list of icons. Refer to the knowledge center for the latest Font Awesome version.
		 * @param {String} [badgeText] text/value to show in a badge next to the menu item
		 * @param {function} [onClickFunction] a callback function to be invoked when the menu item is clicked. If omitted, the "on menu action" event will be called when the item is clicked
		 */
		this.constructor.prototype.addTempMenuAction = function (action, menuItemLabel, icon, badgeText, onClickFn) {
			this._proto._addMenuAction(this, this._instance._tpMenuItems, action, icon, menuItemLabel, badgeText, onClickFn);
		}

		/**
		 * @instance
		 * @memberof Chart
		 * @method removeMenuAction
		 * @desc Removes an action from the chart's popup menu
		 * @param {String} actionId Identifier for the action to be removed
		 * @return {boolean} true if action found and removed, otherwise false
		 */
		this.constructor.prototype.removeMenuAction = function (actionId) {
			//educos: 2015-07-14 Fix for bug 242
			//Loop through permanent (or temp?) menu item array and remove entry with matching command
			//Nothing else needed since menu table rebuilt from scratch every time it is displayed

			//Try to remove item from permanent actions menu
			var itemArray = this._instance._ptMenuItems;
			if (itemArray) {
				for (var i = 0; i < itemArray.length; i++) {
					if (actionId == itemArray[i].actionId) {
						itemArray.splice(i, 1);
						return true;
					}
				}
			}

			return false;
		}

		/**
		 * @instance
		 * @memberof Chart
		 * @method refresh
		 * @desc Updates the chart by calling the AJAX service and using the Data Series data returned.
		 */
		this.constructor.prototype.refresh = function () {
			this._proto._updateChart(this, true);
		}

        /**
         * @instance
         * @memberof Chart
         * @method redrawChart
         * @desc Redraws the chart.  This operation simply redraws the chart and does not refresh the current chart data.  It is useful
         * to quickly redraw the chart when it is not displaying properly.  It is quicker than doing a full refresh.
         */
        this.constructor.prototype.redrawChart = function () {
            this._instance.chart.resize();
        }

        /**
		 * @instance
		 * @memberof Chart
		 * @method getDrillDownStack
		 * @desc Get the stack/structure of the drill-down tree. Only functional if drill-down is enabled
		 * @returns {NameValuePair[]} Array of name/value pairs
		 */
		this.constructor.prototype.getDrillDownStack = function () {
			var res = [];
			for (var i = 0; i < this._instance._drillDownStack.length; i++) {
				res.push({
					"name" : this._instance._drillDownStack[i].name,
					"value" : this._instance._drillDownStack[i].value
				});
			}

			if (res.length > 0) {
				res[res.length - 1].value = null;
			}

			return res;
		}
		/**
		 * @instance
		 * @memberof Chart
		 * @method getCurrentDimensionCriteria
		 * @desc Returns an object with a name/value pair that describes the current position of the drill-down tree;  Only functional if drill-down is enabled.
		 * @returns {object}
		 * @example me.getCurrentDimensionCriteria();  //returns -->  Object {name: "Type", value: "CLOTHING"}
		 */
		this.constructor.prototype.getCurrentDimensionCriteria = function () {
			var res;

			if (this._instance._drillDownStack.length < 2) {
				res = {};
			} else {
				var elt = this._instance._drillDownStack[this._instance._drillDownStack.length - 2];
				res = {
					name : elt.name,
					value : elt.value
				}
			}

			return res;
		}

		/**
		 * @instance
		 * @memberof Chart
		 * @method getCurrentDimension
		 * @desc Get the current drilldown dimension (the current hierarchical level at the drill-down tree). Only functional if drill-down is enabled
		 * @returns {string}
		 */
		this.constructor.prototype.getCurrentDimension = function () {
			if (this._instance._drillDownStack && this._instance._drillDownStack.length > 0) {
				var ddsi = this._instance._drillDownStack[this._instance._drillDownStack.length - 1];
				return ddsi.name;
			} else {
				return null;
			}
		}

		/**
		 * @instance
		 * @memberof Chart
		 * @method getDataSeries
		 * @desc Get the current data series being used to populate the chart
		 * @returns {DataSeries}
		 */
		this.constructor.prototype.getDataSeries = function () {
			var res = {};
			res.name = this._instance._dataSeries.seriesName;
			res.items = this._instance._dataSeries.dataPoints.items;
			return res;
		}

		/**
		 * @instance
		 * @memberof Chart
		 * @method setQueryData
		 * @desc Sets the input to the Data Series AJAX Service
		 * @param {*} queryData Updated query data
		 */
		this.constructor.prototype.setQueryData = function (queryData) {
			if (this.context.binding)
				this.context.binding.set("value", queryData);
			else
				this._instance._queryData = queryData;
		}

		/**
		 * @instance
		 * @memberof Chart
		 * @method getQueryData
		 * @desc Gets the input of the Data Series AJAX Service
		 * @returns {*}
		 */
		this.constructor.prototype.getQueryData = function () {
			var val = null;

			if (this.context.binding)
				val = this.context.binding.get("value");
			else if (this._instance._queryData != undefined)
				val = this._instance._queryData;
			else {
				if (this.context.options.defaultInputData) {
					var tmp = this.context.options.defaultInputData.get("value");
					if (tmp != null && tmp.length > 0) {
						try {
							var f = new Function("me", "return " + tmp);
							val = f(this);
						} catch (e) {
							//{#feature: US-1330 Added RT localization}
							//console.error("Error evaluating input data: " + tmp);
							console.error(bpmext.localization.formatMsg("controlChart", "CHART_INPUTDATA_EVAL_ERROR") + ": " + tmp);
							//console.error("  Detail: " + e);
							console.error(" " + bpmext.localization.formatMsg("general", "DETAIL") + ": " + e);
						}
					}
				}
			}

			return val;
		}

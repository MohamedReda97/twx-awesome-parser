bpmext_control_InitChart = function (utilities, bpmext, domClass, domAttr, json, d3, c3, cfg) {
	this._instance = {
		_duMenuItems : [],
		_ddMenuItems : [],
		_tpMenuItems : [],
		_ptMenuItems : [],
		_firstTime : false
	};

	//BPM set up Rave bidi
	if (!this.raveBidiFormatter) {

		//check the base text direction preference
		var baseTextDirection = this.context.options._metadata.baseTextDirection && this.context.options._metadata.baseTextDirection.get("value") ? this.context.options._metadata.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
		var generalPrefTextDirection = this.context.bpm.system.baseTextDirection;

		//Get the bidi direction of view.
		var viewDir = baseTextDirection.toLowerCase() == utilities.BiDi.BASE_TEXT_DIRECTION._default ?
							generalPrefTextDirection ?
								utilities.BiDi.GENERAL_PREFERENCE_BASE_TEXT_DIRECTION.getValue(generalPrefTextDirection) :
								"" :
						baseTextDirection.toLowerCase()== utilities.BiDi.BASE_TEXT_DIRECTION.contextual ?
							"auto" :
							baseTextDirection.toLowerCase();

		//If none is set, or it is invalid, use a dummy formatter
		if (!(viewDir == "ltr" || viewDir == "rtl" || viewDir == "auto")) {
			viewDir = null;
		}


		if (viewDir) {
			this.raveBidiFormatter = rave.bidi.format();
			this.raveBidiFormatter.direction(viewDir);
		} else {
			this.raveBidiFormatter = function (str) { return str;}
		}
	}
	//BPM set up Rave bidi

	//{#bug: 24 Suppress call of Refresh first time Load is called}

	if (!this.constructor.prototype._proto) {
		this.constructor.prototype._proto = {
			EVT_ONREFRESH : "eventON_REFRESH",
			EVT_ONCLICK : "eventON_CLICK",
			EVT_ONMENUCMD : "eventON_MENUCMD",
			MENU_POS_OFFSET : -20,
			//{#feature: * Allow both E and G for Danger color style}
			OPTS_COL_STLZ : {
				"T" : "",
				"P" : "bg-primary",
				"I" : "bg-info darken",
				"S" : "bg-success",
				"W" : "bg-warning",
				"E" : "bg-danger",
				"G" : "bg-danger"
			},
			OPTS_CHART_TYPE : {
				"B" : "bar",
				"L" : "line",
				"A" : "area",
				"S" : "spline",
				"R" : "area-spline",
				"T" : "step",
				"E" : "area-step",
				"P" : "pie",
				"D" : "donut"
			},
			OPTS_LEGEND_PLC : {
				"N" : "",
				"B" : "bottom",
				"M" : "right"
			},
			OPTS_GLINES_STLZ : {
				"N" : "",
				"L" : "gridlines-light",
				"D" : "gridlines-dark"
			},
			OPTS_AXIS_STLZ : {
				"N" : "axis-none",
				"L" : "axis-light",
				"D" : "axis-dark",
				"K" : "axis-light", //label only, no line
				"C" : "axis-dark" //label only, no line
			},
			_setTitle : function (view) {
				var title = view.context.options._metadata.label.get("value");

				//BPM: Bidi formatting
				title = view.raveBidiFormatter(title);

				var lViz = view.context.options._metadata.labelVisibility.get("value");

				if (lViz == "HIDE")
					domClass.add(view._instance.title, "hidden");
				else
					domClass.remove(view._instance.title, "hidden");

				if (title == null || title.length == 0)
					view._instance.title.innerHTML = "&nbsp;";
				else
					view._instance.title.innerHTML = view.context.htmlEscape(title);
			},
			_setBreadcrumbsVisibility : function (view) {
				if (view.context.options.showBreadCrumbs.get("value"))
					domClass.remove(view._instance.chartTrailNode, "hidden");
				else
					domClass.add(view._instance.chartTrailNode, "hidden");

				if (view._instance.chart)
					view._instance.chart.resize();
			},
			_setMenuEnabled : function (view) {
				var enabled = view.context.options.enableMenu.get("value");
				if (!enabled)
					domClass.remove(view._instance.chartMenu, "open");
			},
			_normalizeChartType : function (view, type) {
				if (type == null)
					type = "";

				type = type.toUpperCase();

				if (type.indexOf("BAR") != -1 || type.indexOf("COL") != -1)
					type = "B";
				else if (type == "LINE")
					type = "L";
				else if (type == "SPLINE")
					type = "S";
				else if (type.indexOf("AREA") != -1) {
					if (type.indexOf("SPLINE") != -1)
						type = "R";
					else if (type.indexOf("STEP") != -1)
						type = "E";
					else
						type = "A";
				} else if (type == "STEP")
					type = "T";

				switch (type) {
				case "B":
				case "L":
				case "A":
				case "S":
				case "R":
				case "T":
				case "E":
				case "P":
				case "D":
					break;
				default:
					type = "L";
				}

				return type;
			},
			_doDrillUp : function (view) {
				var dds = view._instance._drillDownStack;
				if (dds.length > 0) {
					dds.splice(dds.length - 1, 1);
					this._updateChart(view, true);
				}
			},
			_doDrillDown : function (view, dataDim) {
				if (view._instance._chartClickEvt != null) {
					var cats = view._instance.chart.categories();
					if (cats.length > 0) {
						var catName = cats[view._instance._chartClickEvt.index];
					} else {
						var catName = view._instance._chartClickEvt.name;
					}

					//BPM: Bidi formatting adds control characters, so we need to remove them before doing the drill down
					if (catName && (catName[0] == String.fromCharCode(8234) || catName[0] == String.fromCharCode(8235))) {
						catName = catName.substring(1, catName.length-1);
					}

					//var dataValue = view._instance._chartClickEvt.chart.axes.x.labels[view._instance._chartClickEvt.index].text;

					if (view._instance._drillDownStack == null) {
						view._instance._drillDownStack = [];
					}

					if (view._instance._drillDownStack.length > 0) {
						view._instance._drillDownStack[view._instance._drillDownStack.length - 1].value = catName;
					}

					view._instance._drillDownStack.push({
						"name" : dataDim
					});

					view._instance._chartClickEvt = null;
					view._proto._updateChart(view, true);
				}
			},
			//{#bug: BG-321 Invalid action id used for temp menu actions if more than 1 action specified}
			_setMenuClickAction : function (view, element, actionItem) {
				element.onclick = function (evt) {
					var action = {
						name : actionItem.actionId
					};

					if (view.isEnabled()) {
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONMENUCMD, action);
					}
				};
			},
			_populateMenuCategory : function (view, arr, table) {
				for (var i = 0; i < arr.length; i++) {
					var item = arr[i];
					var tr = document.createElement("tr");
					table.appendChild(tr);
					var td1 = document.createElement("td");
					tr.appendChild(td1);

					domClass.add(tr, "mnTextItem");
					domClass.add(td1, "mnLabel");

					var a = document.createElement("a");
					domClass.add(a, "mnItem");

					a.href = "javascript:void(0)";
					if (item.actionId !== null && item.actionId.length > 0)
						domAttr.set(a, "data-action-id", item.actionId);

					if (item.icon != null && item.icon.length > 0) {
						var icon = document.createElement("i");
						var ic = bpmext.text.startsWith(item.icon, "fa-") ? item.icon : "fa-" + item.icon;

						domClass.add(icon, "dropdown-icon fa " + ic);
						a.appendChild(icon);
					}

					var txt = document.createTextNode(item.text);
					a.appendChild(txt);
					td1.appendChild(a);

					var actionId = item.actionId;

					if (item.onclick) {
						tr.onclick = item.onclick;
					} else {
						view._proto._setMenuClickAction(view, tr, item);
					}

					var td2 = document.createElement("td");

					if (item.badgeText != null && item.badgeText.length > 0) {
						domClass.add(td2, "mnBadge");

						var span = document.createElement("span");
						domClass.add(span, "mnBadge badge badge-success");

						span.innerHTML = view.context.htmlEscape(item.badgeText);

						td2.appendChild(span);
					}

					tr.appendChild(td2);

					table.appendChild(tr);
				}

				return i;
			},
			_addMenuDivider : function (table) {
				var tr = document.createElement("tr");
				table.appendChild(tr);

				var td1 = document.createElement("td");
				tr.appendChild(td1);

				domAttr.set(td1, "colspan", 2);
				domClass.add(td1, "divider");

				var divider = document.createElement("div");
				domClass.add(divider, "divider");

				td1.appendChild(divider);
			},
			_populateMenu : function (view) {
				view._instance.menuTbl.innerHTML = "";
				var mnuCats = [
					view._instance._duMenuItems,
					view._instance._ddMenuItems,
					view._instance._tpMenuItems,
					view._instance._ptMenuItems
				];

				var lastNonEmptySz = 0;
				var itemsAdded = 0;

				for (var i = 0; i < mnuCats.length; i++) {
					var items = mnuCats[i];
					if (items.length > 0 && lastNonEmptySz > 0)
						this._addMenuDivider(view._instance.menuTbl);

					var sz = this._populateMenuCategory(view, mnuCats[i], view._instance.menuTbl);
					if (sz > 0)
						lastNonEmptySz = sz;

					itemsAdded += sz;
				}

				return itemsAdded > 0;
			},
			_handleVisibility : function (view) {
				var visibility = utilities.handleVisibility(view.context);

				view.context.setDisplay(visibility != "NONE");
				view.context.setVisibility(visibility != "HIDDEN");

				if (visibility != "NONE") {
					if (visibility == "READONLY"){
						// domClass.remove(view._instance.disabler, "hidden"); // Work item#307677
					}
					else{
						domClass.add(view._instance.disabler, "hidden");
					}

					view._instance.chart.resize();
				}
			},
			_handleDataPointClick : function (view, d, element) {
				view._instance._tpMenuItems = [];

				var cats = view._instance.chart.categories();

				if (cats.length > 0)
					var catName = cats[d.index];
				else
					var catName = d.name;

				var val = d.value;

				view._instance._chartClickEvt = d;


				//BPM: Bidi formatting
				view._instance._selectedDataPoint = {
					label : view.raveBidiFormatter(catName),
					value : val
				};

				if (view.isEnabled()) {
					var res = bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONCLICK);
					if (res === false)
						return;
				}

				if (view.context.options.enableMenu.get("value")) {
					//{#bug: BG-326 Fix menu behavior inconsistencies}
					if (this._populateMenu(view)) {
						var chartDiv = document.body;
						var chartMenu = view._instance.chartMenu;
						var menuLeft = d3.event.clientX || d3.event.pageX;
						var menuTop = d3.event.clientY || d3.event.pageY;

						//Fix chart menu visibility behavior on chart data point click - related to BG-326
						setTimeout(function () {
							domClass.add(chartMenu, "open");

							var menuRight = menuLeft + chartMenu.offsetWidth + chartDiv.offsetLeft;
							var chartRight = chartDiv.offsetLeft + chartDiv.offsetWidth;

							if (menuRight > chartRight)
								menuLeft = chartRight - chartMenu.offsetWidth - chartDiv.offsetLeft;

							//Fix chart menu positioning behavior on chart data point click - related to BG-326
							var bcr = view._instance.wrapper.getBoundingClientRect();

							menuTop -= bcr.top;
							menuLeft -= bcr.left;

							menuTop += view._proto.MENU_POS_OFFSET;
							menuLeft += view._proto.MENU_POS_OFFSET;

							chartMenu.style.top = menuTop + "px";
							chartMenu.style.left = menuLeft + "px";

							view._instance.chartMenuInner.focus();
						}, 230);
					}
				}
			},
			_addMenuAction : function (view, arr, actionId, icon, text, badgeText, onclickFn) {
				arr.push({
					actionId : actionId,
					icon : icon,
					text : text,
					badgeText : badgeText,
					onclick : onclickFn
				});
			},
			_toString : function (val) {
				if (typeof val != "object")
					return val + "";
				else
					return val;
			},
			_callDataSvc : function (view, query, onLoadFn) {
				var d = {};

				//{#bug: * Fixed bug for non-null query data}
				d.input = (query != undefined ? this._toString(query) : "");
				if (typeof d.input == "object" && d.input.toJson)
					d.input = json.parse(d.input.toJson()); //Extract only the data that matters

				if (view.context.options.mds.get("value")) //Multi-Data Series Chart
				{
					var serviceArgs = {
						params : json.stringify(d),
						load : function (response) {
							var multiDataSeries = response.multiDataSeries;

							if (!multiDataSeries.items)
								multiDataSeries.items = [];

							/*
							if (multiDataSeries.items.length > 0) {
								//TODO Hide indicator that no data is available here
							} else {
								//TODO Show indicator that no data is available here
							}
							*/

							onLoadFn(multiDataSeries);
						},
						error : function (error) {
							var multiDataSeries = {
								"items" : []
							};

							try {
								onLoadFn(multiDataSeries, null, null);
							} catch (e) {
								//{#feature: US-1330 Added RT localization}
								//errorTxt = "Error processing chart service error: " + e;
								errorTxt = bpmext.localization.formatMsg("controlChart", "CHART_SERVICE_ERROR") + ": " + e;
								//Display updated error here
							}

						}
					};
				} else //Single-Data series chart
				{
					d.drillDownStack = view._instance._drillDownStack;

					var serviceArgs = {
						params : json.stringify(d),
						load : function (response) {
							//TODO Show load progress indicator here

							var availableForDrillDown = response.availableForDrillDown; //items[i].name
							var drillDownStack = response.drillDownStack; //.items[i].name/value
							var dataSeries = response.dataSeries;

							if (!dataSeries.dataPoints)
								dataSeries.dataPoints = {
									"items" : []
								};

							if (!dataSeries.dataPoints.items)
								dataSeries.dataPoints.items = [];

							/*
							if (dataSeries.dataPoints.items.length > 0) {
								//TODO Hide indicator that no data is available here
							} else {
								//TODO Show indicator that no data is available here
							}
							*/

							onLoadFn(dataSeries, availableForDrillDown, drillDownStack);
						},
						error : function (error) {
							//TODO Display error here

							var dataSeries = {
								"dataPoints" : {
									"items" : []
								}
							};

							try {
								onLoadFn(dataSeries, null, null);
							} catch (e) {
								//{#feature: US-1330 Added RT localization}
								//errorTxt = "Error processing chart service error: " + e;
								errorTxt = bpmext.localization.formatMsg("controlChart", "CHART_SERVICE_ERROR") + ": " + e;
								//Display updated error here
							}
						}
					};
				}

				try {
					if (view.context.options.mds.get("value"))
						view.context.options.mdsDataService(serviceArgs);
					else
						view.context.options.sdsDataService(serviceArgs);
				} catch (e) {
					//{#feature: US-1330 Added RT localization}
					//console.log("AJAX result processing error: " + e);
					console.log(bpmext.localization.formatMsg("general", "AJAX_RESULT_PROCESSING_ERROR") + ": " + e);
				}
			},
			_getComputedStyle : function (elt, prop) {
				if (elt.currentStyle)
					return elt.currentStyle[prop];
				else if (document.defaultView && document.defaultView.getComputedStyle)
					return document.defaultView.getComputedStyle(elt, "")[prop];
				else
					return elt.style[prop];
			},
			_getStandardColors : function (view) {
				if (!this.OPTS_SCOL_STLZ) {
					this.OPTS_SCOL_STLZ = {};
					for (var key in this.OPTS_COL_STLZ)
						this.OPTS_SCOL_STLZ[key] = this.OPTS_COL_STLZ[key];

					this.OPTS_SCOL_STLZ["L"] = "bgx-light";
					this.OPTS_SCOL_STLZ["D"] = "bgx-dark";
				}

				var cols = {};

				for (var key in this.OPTS_SCOL_STLZ) {
					var cls = this.OPTS_SCOL_STLZ[key];
					if (cls == "")
                        continue;

                    try {
                        var highContrastMode = false;
                        var div = document.createElement("div");
                        // mount the element to force computed styles
                        view.context.element.appendChild(div);
                        //Check if FF is in high contrast mode
                        if(dojo.isFF){
                            div.style["background-color"] = "rgb(255, 0, 0)"; //Set some random color
                            var divComputedBGColor = window.getComputedStyle(div)["background-color"];
                            if(divComputedBGColor !== "rgb(255, 0, 0)") { //if in high contrast FF will override the background color to the high contrast theme
                                highContrastMode = true;
                                var generatedHEXColor = '#'+(Math.random()*0xFFFFFF<<0).toString(16); //Generate random HEX color
                                var contrastShiftedColor = rave.rgb(divComputedBGColor).contrastShift(generatedHEXColor);
                                div.style["background-color"] = "";
                            }
                        }
                        div.className = this.OPTS_SCOL_STLZ[key];

						var col;
						if(highContrastMode){
							col = contrastShiftedColor;
						} else {
							col = this._getComputedStyle(div, "backgroundColor");
						}
						cols[key] = col;
					}
					finally {
						view.context.element.removeChild(div);
					}
				}

				return cols;
			},
			_getColorPatterns : function (view, colKey) {
				var stdColMap = this._getStandardColors(view);
				var patterns = [],
				lPatterns = [],
				dPatterns = [],
				i;

				var colFac = 0.3;

				if (colKey == "D" || colKey == "L") {
					for (var key in stdColMap) {
						if (key == "L" || key == "D")
							continue;

						var color = stdColMap[key];
						if (patterns.indexOf(color) === -1) {
							patterns.push(color);

							lPatterns.push(d3.rgb(color).brighter(colFac));
							dPatterns.push(d3.rgb(color).darker(colFac));
						}
					}
				} else {
					//var hsl = d3.hsl(stdColMap[colKey]);
					patterns.push(stdColMap[colKey]);

					for (i = -2; i <= 2; i++) {
						/*var h = hsl.h + (i * 20);

						if (h < 0)
						h += 360;
						if (h > 360)
						h -= 360;

						patterns.push(d3.hsl(h,hsl.s,hsl.l).rgb());
						lPatterns.push(d3.hsl(h,hsl.s,hsl.l).rgb().brighter(colFac));
						dPatterns.push(d3.hsl(h,hsl.s,hsl.l).rgb().darker(colFac));
						 */

						var color = d3.rgb(stdColMap[colKey]).darker(i * 0.3);

						patterns.push(color);
						lPatterns.push(color.brighter(colFac));
						dPatterns.push(color.darker(colFac));
					}
				}

				for (i = 0; i < dPatterns.length; i++)
					patterns.push(dPatterns[i]);


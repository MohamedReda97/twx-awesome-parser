				this._proto._populateMenu(this);

				this._instance.chartMenuInner.appendChild(this._instance.menuTbl);

				var view = this;

				//*
				this._instance.chartMenuInner.onblur = function () {
					setTimeout(function () {
						domClass.remove(view._instance.chartMenu, "open");
					}, 220);
				}
				//*/

				this._instance.chartMenu.onclick = function () {
					var view = this;

					setTimeout(function () {
						domClass.remove(view, "open");
					});
				}

				this._instance.wrapper.appendChild(this._instance.chartMenu);
				this._instance.chartContainerNode = document.createElement("div");

				this._instance.chartContainerNode.oncontextmenu = function (event) {
					event.preventDefault();
					return false;
				};

				this._instance.wrapper.appendChild(this._instance.chartContainerNode);
				this.context.element.appendChild(this._instance.wrapper);

				this._proto._setBackgroundColorStyle(this, opts.backgroundColorStyle.get("value"));
				this._proto._setHGridStyle(this, opts.horizontalGridlineStyle.get("value"));
				this._proto._setXYAxisColorStyle(this, opts.xyAxisColorStyle.get("value"));
				// Work Item#308584 - START
				setTimeout(function(){
					view._proto._setRadius(view, opts.radius.get("value"));
				}, 500);
				// Work Item#308584 - END

				//set the title only if this is a MultiPurpose Chart and
				//"Show multi data series" option is enabled
				if(!cfg && opts.mds.get("value")){
					this._proto._setTitle(this);
				}

				this._proto._setBreadcrumbsVisibility(this);
				this._proto._setMenuEnabled(this);

				bpmext.ui.loadView(this);

				this._proto._updateChart(this, false);
			} catch (e) {
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);

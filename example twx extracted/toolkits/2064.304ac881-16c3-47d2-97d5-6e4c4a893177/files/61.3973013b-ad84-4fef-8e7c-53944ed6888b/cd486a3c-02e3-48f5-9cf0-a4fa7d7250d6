		this.constructor.prototype.change = function (event) {
			try {
				if (event.type == "config") {
					switch (event.property) {
					case "_metadata.label":
					case "_metadata.labelVisibility": {
							this._proto._setTitle(this);
							break;
						}
					case "_metadata.visibility": {
							this._proto._handleVisibility(this);
							break;
						}
					case "radius": {
							this._proto._setRadius(this, event.newVal);
							break;
						}
					case "height": {
							this._proto._setHeight(this);
							break;
						}
					case "xyAxisColorStyle": {
							this._proto._setXYAxisColorStyle(this, event.newVal, event.oldVal);
							break;
						}
					case "backgroundColorStyle": {
							this._proto._setBackgroundColorStyle(this, event.newVal, event.oldVal);
							break;
						}
					case "dataSeriesColorStyle":
					case "dataSeriesCustomColorStyle": {
							this._proto._updateChart(this, false);
							break;
						}
					case "horizontalGridlineStyle": {
							this._proto._setHGridStyle(this, event.newVal, event.oldVal);
							break;
						}
					case "showBreadcrumbs": {
							this._proto._setBreadcrumbsVisibility(this);
							break;
						}
					case "enableMenu": {
							this._proto._setMenuEnabled(this);
							break;
						}
					case "legendPlacement":
					case "maxYAxisTicks":
					case "maxYAxisValue":
					case "minYAxisValue":
					case "yAxisTickPrecision":
					case "padding":
					case "xAxisCulling":
					case "maxXTickCount":
					case "pointSize":
					case "xLabelRotation":
					case "singleDataSeries":
					case "multiDataSeries":
					case "xAxisHeight": {
							this._proto._updateChart(this, false);
							break;
						}
					}
				} else {
					this._proto._updateChart(this, false);
				}
			} catch (e) {
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) {
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));

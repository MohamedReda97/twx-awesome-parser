			bpmext.ui.unloadView(this);
			if (this._instance.bindAllHandle)
				this._instance.bindAllHandle.unbind();

			if (this._instance.pointBindHandle)
				this._instance.dataPointsBindHandle.unbind();

			if (this._instance.dataBindHandle) {
				for (var i = 0; i < this._instance.dataBindHandle.length; i++) {
					this._instance.dataBindHandle[i].unbind();
				}
			}

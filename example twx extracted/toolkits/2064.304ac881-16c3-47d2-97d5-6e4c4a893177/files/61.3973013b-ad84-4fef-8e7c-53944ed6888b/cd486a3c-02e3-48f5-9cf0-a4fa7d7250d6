		/**
		 * @instance
		 * @memberof Chart
		 * @param {boolean} whether to group the series or not
		 * @param {string[]} [seriesName] the name of the dataseries
		 * @method groupSeries
		 * @desc Groups the DataSeries in the chart.
		 * @example me.groupSeries(true, ["SeriesName 1", "SeriesName 2", "SeriesName 3"]); //SeriesName 1, SeriesName2, and SeriesName3 will stack together if it is a bar chart.
		 */
		this.constructor.prototype.groupSeries = function (flag, seriesNames) {
			var groups;

			if (flag) {
				if (seriesNames == null) {
					var data = this._instance.chart.data();
					groups = [];

					for (var i = 0; i < data.length; i++)
						groups.push(data[i].id);
				} else
					groups = seriesNames;
			} else {
				if (seriesNames == null)
					groups = [];
				else {
					var cgs = this._instance.chart.groups();
					if (cgs != null && cgs.length > 0)
						cgs = cgs[0];

					var cgsm = {};

					for (var i = 0; i < cgs.length; i++)
						cgsm[cgs[i]] = true;

					for (var i = 0; i < seriesNames.length; i++)
						delete cgsm[seriesNames[i]];

					groups = [];

					for (var sn in cgsm)
						groups.push(sn);
				}
			}

			this._instance.chart.groups([groups]);
		}

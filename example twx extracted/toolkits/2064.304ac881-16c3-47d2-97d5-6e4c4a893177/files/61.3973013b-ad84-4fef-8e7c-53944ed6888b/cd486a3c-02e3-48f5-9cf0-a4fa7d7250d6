				case "LIGHT":
				case "L":
					style = "L";
					break;
				case "PRIMARY":
				case "P":
					style = "P";
					break;
				case "SUCCESS":
				case "S":
					style = "S";
					break;
				case "INFO":
				case "INF":
				case "I":
					style = "I";
					break;
				case "WARNING":
				case "WARN":
				case "W":
					style = "W";
					break;
				case "DANGER":
				case "ERROR":
				case "E":
				case "G":
					style = "G";
					break;
				default:
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.warn("Unexpected data series color style: " + style);
					bpmext.log.warn(bpmext.localization.formatMsg("controlChart", "DATASERIES_COLOR_STYLE_WARNING",style));

/** 
 * @constructor DeviceSensor
 * @desc This constructor is <i>never</i> used explicitly.
 * @augments com.ibm.bpm.coach.CoachView 
 * @classdesc A Device Sensor provides the following configuration properties in Process Designer:
 * <table class=Config>
 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>console.log("Device info ready")</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitDeviceSensor = function(domConstruct, domClass, domStyle, lang, bpmext, utilities)
{
	this._instance = {
		_deviceInfo : null,
		versionSearchString : ""
	};
	
	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONDEVICEINFO : "eventON_DEVICEINFO",
			BROWSER_DATA : [
				{string : navigator.userAgent, subString : "Chrome", identity : "Chrome"},
				{string : navigator.userAgent, subString : "OmniWeb", versionSearch : "OmniWeb/", identity : "OmniWeb"},
				{string : navigator.vendor,	subString : "Apple", identity : "Safari", versionSearch : "Version"},
				{prop : window.opera, identity : "Opera", versionSearch : "Version"},
				{string : navigator.vendor, subString : "iCab", identity : "iCab"},
				{string : navigator.userAgent, subString : "Firefox", identity : "Firefox"},
				{string : navigator.userAgent, subString : "Netscape", identity : "Netscape"},
				{string : navigator.userAgent, subString : "MSIE", identity : "Explorer", versionSearch : "MSIE"},
				{string : navigator.userAgent, subString : "Gecko", identity : "Mozilla", versionSearch : "rv"}
			],
			OS_DATA : [
				{string : navigator.platform, subString : "Win", identity : "Windows"},
				{string : navigator.platform, subString : "Mac", identity : "Mac"},
				{string : navigator.userAgent, subString : "iPhone", identity : "iPhone/iPod"},
				{string : navigator.userAgent, subString : "iPad", identity : "iPad"},
				{string : navigator.userAgent, subString : "Android", identity : "Android"},
				{string : navigator.userAgent, subString : "IEMobile", identity : "IEMobile"},
				{string : navigator.platform, subString : "Linux", identity : "Linux"}
			],
			_searchString : function(view, data)
			{
				for (var i = 0; i < data.length; i++)
				{
					var dataString = data[i].string;
					var dataProp = data[i].prop;
					view._instance.versionSearchString = data[i].versionSearch || data[i].identity;
					if (dataString)
					{
						if (dataString.indexOf(data[i].subString) != -1)
							return data[i].identity;
					}
					else if (dataProp)
						return data[i].identity;
				}	
			},
			_searchVersion : function(view, dataString)
			{
				var index = dataString.indexOf(view._instance.versionSearchString);
				if (index == -1)
					return;

				return parseFloat(dataString.substring(index + view._instance.versionSearchString.length + 1));
			},
			_getDeviceInfo : function(view)
			{
				var deviceInfo = {};
				//{#feature: US-1330 Added RT localization}
				//deviceInfo.browser = this._searchString(view, this.BROWSER_DATA) || "An unknown browser";
				deviceInfo.browser = this._searchString(view, this.BROWSER_DATA) || bpmext.localization.formatMsg("controlDeviceSensor", "DS_UNKNOWN_BROWSER");
				//deviceInfo.version = this._searchVersion(view, navigator.userAgent) || this._searchVersion(view, navigator.appVersion) || "Unknown";
				deviceInfo.version = this._searchVersion(view, navigator.userAgent) || this._searchVersion(view, navigator.appVersion) || bpmext.localization.formatMsg("controlDeviceSensor", "DS_UNKNOWN");
				//deviceInfo.OS = this._searchString(view, this.OS_DATA) || "Unknown";
				deviceInfo.OS = this._searchString(view, this.OS_DATA) || bpmext.localization.formatMsg("controlDeviceSensor", "DS_UNKNOWN");
			
				var language = navigator.language;
				if(!language)
					language = navigator.browserLanguage;
				
				var os = deviceInfo.OS;
				var res = 
				{
					browserName: deviceInfo.browser,
					language: language,
					clientWidth: window.innerWidth,
					browserMajorVersion: "" + deviceInfo.version,
					os: os,
					screenWidth: window.screen.availWidth,
					isIPad: os.indexOf("iPad") != -1,
					isIPhone: os.indexOf("iPhone") != -1,
					isAndroid: os.indexOf("Android") != -1,
					isIEMobile: os.indexOf("IEMobile") != -1
				};
				
				return res;
			},
			_handleVisibility : function(view)
			{
				view.context.setDisplay(false);
				view.context.setVisibility(false);
			}
		};
		
		/*
			Public control methods *************************************************************
		 */
		
		/**
		 * @instance
		 * @memberof DeviceSensor
		 * @method refresh
		 * @desc Refreshes the device info data
		 */
		this.constructor.prototype.refresh = function()
		{
			var res = this._proto._getDeviceInfo(this);			
			this.context.binding.set("value", res);
        }

		
		/**
		 * @instance
		 * @memberof DeviceSensor
		 * @method getDeviceInfo
		 * @desc Returns information about the device
		 * @returns {DeviceInfo} DeviceInfo object, containing information such as browser, OS, language, etc.
		 */
		this.constructor.prototype.getDeviceInfo = function()
		{
			return this.context.binding.get("value");
		}

		/**
		 * @instance
		 * @memberof DeviceSensor
		 * @method getType
		 * @desc Get descriptive string representing the type of control/section
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function()
		{
			return "deviceSensor.3";
		}
		
		this.constructor.prototype.load = function()
		{
			try
			{
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONDEVICEINFO, "device");
				this.context.element.style.position = "absolute";
				
				bpmext.ui.loadView(this);
				
				if(!this.context.binding)
				{
					var deviceInfo = this._proto._getDeviceInfo(this);
					this.context.binding = bpmext.ui.substituteObject(this, "binding", "deviceInfo", deviceInfo);
				}
				else
					this.refresh();
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}			
		};
		
		this.constructor.prototype.unload = function()
		{
			bpmext.ui.unloadView(this);
		};

		this.constructor.prototype.view = function()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function(event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.collaboration = function(event)
		{
			
		};
		
		this.constructor.prototype.validate = function(event)
		{
			
		};		
	}
};

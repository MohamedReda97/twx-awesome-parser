var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
    	var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, bpmext){
			this.context.coachViewData.containingDiv = containingDiv;
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			
			this.context.coachViewData.defaultBorderRadius = "5px";
			
			this.context.coachViewData.widthInterval = null;
			this.context.coachViewData.widthIntervalAttempt = 0;
			this.context.coachViewData.width=null;
			this.context.coachViewData.vertical=false;
			this.context.coachViewData.handleWidth=null;
			this.context.coachViewData.radius=null;
			
			this.context.coachViewData.sliderOuter = domConstruct.create("div");
            domClass.add(this.context.coachViewData.sliderOuter, "slider-container");
			
			this.context.coachViewData.sliderWrapper = domConstruct.create("div");
			domClass.add(this.context.coachViewData.sliderWrapper, "noUi-target");
			domClass.add(this.context.coachViewData.sliderWrapper, "noUi-connect");
			domClass.add(this.context.coachViewData.sliderWrapper, "noUi-horizontal");
			
			this.context.coachViewData.sliderBaseDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.sliderBaseDiv, "noUi-base");
			
			this.context.coachViewData.sliderOriginDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.sliderOriginDiv, "noUi-origin");
			domClass.add(this.context.coachViewData.sliderOriginDiv, "noUi-background");
			        	
			this.context.coachViewData.sliderDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.sliderDiv, "noUi-handle");
			domClass.add(this.context.coachViewData.sliderDiv, "noUi-handle-lower");
			
			dojo.attr(this.context.coachViewData.sliderDiv, "role", "slider");
            dojo.attr(this.context.coachViewData.sliderDiv, "tabindex", "0");

			domConstruct.place(this.context.coachViewData.sliderOuter, this.context.coachViewData.containingDiv);
			this.context.coachViewData.sliderOuter.appendChild(this.context.coachViewData.sliderWrapper);
			this.context.coachViewData.sliderWrapper.appendChild(this.context.coachViewData.sliderBaseDiv);
			this.context.coachViewData.sliderBaseDiv.appendChild(this.context.coachViewData.sliderOriginDiv);
			this.context.coachViewData.sliderOriginDiv.appendChild(this.context.coachViewData.sliderDiv);
			
			this.context.coachViewData.sliderOriginDiv.style.left = "50%";
			
			callback();
		}));
    },
	
    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, configHelper){
			if(propertyName == "@label") {
				dojo.attr(this.context.coachViewData.sliderDiv, "aria-label", propertyValue); 
			} else if(propertyName ==  "@labelVisibility"){
			} else if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "radius"){
				this.context.coachViewData.radius = propertyValue;
				this.updateBorderRadius();
			} else if(propertyName == "width"){
				this.context.coachViewData.width = propertyValue;
				this.updateWidth();
			} else if(propertyName == "height"){
				if(!!propertyValue && propertyValue!="") {
					//in order to override the default behaviour, we need to let the framework run first.  A coach view really shouldn't
					//be messing with the framework-owned container div, but this is how it currently works unfortunately.
					setTimeout(lang.hitch(this, function(){
						this.context.coachViewData.containingDiv.style.height = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
					}), 10);
					this.context.coachViewData.sliderOuter.style.height = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					setTimeout(lang.hitch(this, function(){
						this.context.coachViewData.containingDiv.style.height = "";
					}), 10);
					
					this.context.coachViewData.sliderOuter.style.height = "";
				}
				this.updateHandleSize();
			} else if(propertyName == "colorStyle"){
				var colorStyle;
				if(propertyValue == "P"){
					colorStyle = "cs-primary";
				} else if(propertyValue == "I"){
					colorStyle = "cs-info";
				} else if(propertyValue == "S"){
					colorStyle = "cs-success";
				} else if(propertyValue == "W"){
					colorStyle = "cs-warning";
				} else if(propertyValue == "E"){
					colorStyle = "cs-danger";
				} else {
					colorStyle = "";
				}
				domClass.replace(this.context.coachViewData.containingDiv, colorStyle, "cs-primary cs-info cs-success cs-warning cs-danger");
			}
			else if(propertyName == "vertical"){
				if(propertyValue == "true" || propertyValue == true){
					domClass.remove(this.context.coachViewData.sliderWrapper, "noUi-horizontal");
					domClass.remove(this.context.coachViewData.sliderOuter, "sr-horizontal");
					domClass.add(this.context.coachViewData.sliderOuter, "sr-vertical");
					domClass.add(this.context.coachViewData.sliderWrapper, "noUi-vertical");
					domClass.remove(this.context.coachViewData.sliderWrapper, "noUi-ltr");
					domClass.add(this.context.coachViewData.sliderWrapper, "noUi-rtl");	
					domClass.remove(this.context.coachViewData.sliderDiv, "noUi-handle-lower");
					domClass.add(this.context.coachViewData.sliderDiv, "noUi-handle-upper");
					this.context.coachViewData.sliderOriginDiv.style.top = "50%";
					this.context.coachViewData.sliderOriginDiv.style.left = "0";
					domClass.remove(this.context.coachViewData.sliderWrapper, "noUi-connect");
					domClass.remove(this.context.coachViewData.sliderOriginDiv, "noUi-background");
					domClass.add(this.context.coachViewData.sliderWrapper, "noUi-background");	
					domClass.add(this.context.coachViewData.sliderOriginDiv, "noUi-connect");
				} else {
					domClass.remove(this.context.coachViewData.sliderOuter, "sr-vertical");
					domClass.remove(this.context.coachViewData.sliderWrapper, "noUi-vertical");
					domClass.add(this.context.coachViewData.sliderWrapper, "noUi-horizontal");
					domClass.add(this.context.coachViewData.sliderOuter, "sr-horizontal");
					domClass.add(this.context.coachViewData.sliderWrapper, "noUi-ltr");
					domClass.remove(this.context.coachViewData.sliderWrapper, "noUi-rtl");
					domClass.remove(this.context.coachViewData.sliderDiv, "noUi-handle-upper");
					domClass.add(this.context.coachViewData.sliderDiv, "noUi-handle-lower");
					this.context.coachViewData.sliderOriginDiv.style.left = "50%";
					this.context.coachViewData.sliderOriginDiv.style.top = "0";
					var borderRadiusVal = configHelper.getConfigOptionValue(this, "radius");
					var updatedBorderRadius = isNaN(borderRadiusVal) ? borderRadiusVal : (borderRadiusVal+"px");
					this.context.coachViewData.sliderOriginDiv.style.borderTopRightRadius = updatedBorderRadius;
					this.context.coachViewData.sliderOriginDiv.style.borderBottomRightRadius = updatedBorderRadius;
					domClass.remove(this.context.coachViewData.sliderWrapper, "noUi-background");
					domClass.remove(this.context.coachViewData.sliderOriginDiv, "noUi-connect");
					domClass.add(this.context.coachViewData.sliderWrapper, "noUi-connect");
					domClass.add(this.context.coachViewData.sliderOriginDiv, "noUi-background");
				}
				this.context.coachViewData.vertical = propertyValue;
				this.updateWidth();
				this.updateHandleSize();
				this.updateBorderRadius();
			} else if(propertyName == "handleWidth"){
				this.context.coachViewData.handleWidth = propertyValue;
				this.updateHandleSize();
			} else if(propertyName == "handleRadius"){
				if(propertyValue == ""){
					domStyle.set(this.context.coachViewData.sliderDiv, "border-radius", "9999px");
				}else {
					domStyle.set(this.context.coachViewData.sliderDiv, "border-radius", isNaN(propertyValue) ? propertyValue : propertyValue+"px");
				}
			}
		}));
	},
	updateWidth:function(){
		if(this.context.coachViewData.width) {
			if(this.context.coachViewData.vertical=="true" || this.context.coachViewData.vertical==true){
				this.context.coachViewData.sliderOuter.style.width = "";
				this.context.coachViewData.sliderWrapper.style.width = isNaN(this.context.coachViewData.width) ? this.context.coachViewData.width : (this.context.coachViewData.width+"px");
			} else{
				this.context.coachViewData.sliderOuter.style.width = isNaN(this.context.coachViewData.width) ? this.context.coachViewData.width : (this.context.coachViewData.width+"px");
				this.context.coachViewData.sliderWrapper.style.width = "";
			}
		} else {
			this.context.coachViewData.containingDiv.style.width = "";
			this.context.coachViewData.sliderOuter.style.width = "";
		}
	},
	updateHandleSize:function(){
		if(this.context.coachViewData.widthInterval){
			clearInterval(this.context.coachViewData.widthInterval);
			this.context.coachViewData.widthInterval = null;
			this.context.coachViewData.widthIntervalAttempt = 0;
		}
		if(this.context.coachViewData.handleWidth && this.context.coachViewData.handleWidth!="") {
			//if handle width is set, use it
			this.context.coachViewData.sliderDiv.style.width = isNaN(this.context.coachViewData.handleWidth) ? this.context.coachViewData.handleWidth : (this.context.coachViewData.handleWidth+"px");
		} else {
			//make width the same as height, but this is difficult because we don't know when the DOM element is actually shown.
			//the slider height will be 0 until it's shown, so try for a given amount of time, then stop.
			if(this.context.coachViewData.sliderDiv.offsetHeight==0){
				this.context.coachViewData.widthInterval = setInterval(lang.hitch(this, function(){
					this.context.coachViewData.widthIntervalAttempt++;
					if(this.context.coachViewData.sliderDiv.offsetHeight!=0){
						clearInterval(this.context.coachViewData.widthInterval);
						this.context.coachViewData.widthInterval = null;
						this.context.coachViewData.widthIntervalAttempt = 0;
						this.context.coachViewData.sliderDiv.style.width = this.context.coachViewData.sliderDiv.offsetHeight+"px";
					}
					if(this.context.coachViewData.widthIntervalAttempt>100){
						//if it's still not there in 20 seconds, forget about it
						clearInterval(this.context.coachViewData.widthInterval);
						this.context.coachViewData.widthInterval = null;
						this.context.coachViewData.widthIntervalAttempt = 0;
					}
				}), 200);
			}else{
				
			}this.context.coachViewData.sliderDiv.style.width = this.context.coachViewData.sliderDiv.offsetHeight+"px";
		}
	},
	updateBorderRadius:function(){
		require(["dojo/dom-style"], this.lang.hitch(this, function(domStyle){
			var radiusVal = this.context.coachViewData.radius;
			if(this.context.coachViewData.vertical=="true" || this.context.coachViewData.vertical==true){
				//vertical
				domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-top-right-radius", "0px");
				if(radiusVal==null || radiusVal===undefined || radiusVal == ""){
					domStyle.set(this.context.coachViewData.sliderWrapper, "border-radius", this.context.coachViewData.defaultBorderRadius);
					domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-bottom-left-radius", this.context.coachViewData.defaultBorderRadius);
					domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-bottom-right-radius", this.context.coachViewData.defaultBorderRadius);
				}else {
					domStyle.set(this.context.coachViewData.sliderWrapper, "border-radius", isNaN(radiusVal) ? radiusVal : radiusVal+"px");	
					domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-bottom-left-radius", isNaN(radiusVal) ? radiusVal : radiusVal+"px");
					domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-bottom-right-radius", isNaN(radiusVal) ? radiusVal : radiusVal+"px");
				}
			}else{
				//horizontal
				domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-bottom-left-radius", "0px");
				if(radiusVal==null || radiusVal===undefined || radiusVal == ""){
					domStyle.set(this.context.coachViewData.sliderWrapper, "border-radius", this.context.coachViewData.defaultBorderRadius);
					domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-top-right-radius", this.context.coachViewData.defaultBorderRadius);
					domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-bottom-right-radius", this.context.coachViewData.defaultBorderRadius);
				}else {
					domStyle.set(this.context.coachViewData.sliderWrapper, "border-radius", isNaN(radiusVal) ? radiusVal : radiusVal+"px");	
					domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-top-right-radius", isNaN(radiusVal) ? radiusVal : radiusVal+"px");
					domStyle.set(this.context.coachViewData.sliderOriginDiv, "border-bottom-right-radius", isNaN(radiusVal) ? radiusVal : radiusVal+"px");
				}
			}
		}));
	},
	modelChanged: function(propertyName, propertyValue) {
	
	}
};

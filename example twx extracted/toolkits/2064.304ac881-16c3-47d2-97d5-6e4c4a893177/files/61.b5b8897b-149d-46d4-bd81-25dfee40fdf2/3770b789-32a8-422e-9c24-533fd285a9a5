var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");

		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", configHelperUri, bpmextUri], 
		this.lang.hitch(this, function(domConstruct, domClass, domAttr, configHelper, bpmext){
			
			const siteMenuUUID = "64.6d3d37fb-3254-4f43-a409-e4f532200678";
			const siteFolderUUID = "64.13e06fc4-c088-4091-9bc9-9f7120b59322";
			const siteItemUUID = "64.655c6c8a-c4a2-49e1-9174-a47adae9db7d";

			this.context.coachViewData.containingDiv = containingDiv;

			var isInSiteMenu = this.context.modelData.layoutItemParent._parent &&
            	this.context.modelData.layoutItemParent._parent._pathSegment=="contentBoxContrib" && this.context.modelData.layoutItemParent._parent._parent &&
				(this.context.modelData.layoutItemParent._parent._parent.viewUUID==siteItemUUID ||
				this.context.modelData.layoutItemParent._parent._parent.viewUUID==siteFolderUUID);

			var tempID;
			while(true) {
				tempID = dojox.uuid.generateRandomUuid();
				if(this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']") == null)
					break;
			}
			
			this.context.coachViewData.containingDiv.setAttribute("data-temp-id", tempID);
			domClass.add(this.context.coachViewData.containingDiv, "ContentBox navigationContainer ");
			
			//create logo placeholder
			this.context.coachViewData.placeholderImageUrl = this.context.getManagedAssetUrl("BPMExt-Control-Image-Preview.png", this.context.assetType_WEB, "SYSBPMUI");
			
			this.context.coachViewData.imageEl = domConstruct.create("img",{src:this.context.coachViewData.placeholderImageUrl});

			domClass.add(this.context.coachViewData.imageEl, "logoImage hide");
			domConstruct.place(this.context.coachViewData.imageEl, this.context.coachViewData.containingDiv);

			//create nav header
			this.context.coachViewData.formGroupDiv = domConstruct.create("div");

			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.label = domConstruct.create("span");
			
			domAttr.set(this.context.coachViewData.label, "id", "OutputTextLabel_" + this.context.modelData.layoutItemIdPath);
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);

			this.context.coachViewData.inputDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.inputDiv, "input");
			//Added for WYSWYG 			
			this.context.coachViewData.inputDiv.style.width="100%";
			this.context.coachViewData.defaultWidth = "100%";

			domConstruct.place(this.context.coachViewData.formGroupDiv, this.context.coachViewData.containingDiv);
			domClass.add(this.context.coachViewData.formGroupDiv, "form-group");
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.label);
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.inputDiv);
			domClass.add(this.context.coachViewData.formGroupDiv, "headerLabel");
			
			this.context.coachViewData.contentBoxDiv = this.context.coachViewData.containingDiv.querySelector("div[data-temp-id='" + tempID + "']  .DesignContentBox");
            this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, undefined, undefined, true, true);
			callback();
		}));	
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.label;
	},
	_setHoverStates: function(hoverBackground, hoverBorder, fontColor) {
		var buildStyle = ".ContentBox.navigationContainer button.btn.btn-ghost.preview:hover, ";
		if (hoverBackground || hoverBorder || fontColor){
			buildStyle += ".ContentBox.navigationContainer.navigationBar-background-color-dark button.btn.btn-ghost.preview:hover{";
			if (hoverBackground) {
				buildStyle += "background:" + hoverBackground + " !important; ";
			}
			if (hoverBorder) {
				buildStyle += "box-shadow: 0 -3px 0 inset " + hoverBorder + " !important; -moz-box-shadow: 0 -3px 0 inset " + hoverBorder + " !important; -webkit-box-shadow: 0 -3px 0 inset " + hoverBorder + " !important; ";
			}
			if (fontColor) {
				buildStyle += "color:" + fontColor + "!important; "
			}
			buildStyle += "}";
		} else {
			buildStyle = undefined;
		}
		return buildStyle;
	},
    propertyChanged:function(propertyName, propertyValue){
		
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class",  "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){
			
			if(propertyName ==  "@visibility"){
					if(propertyValue == "READONLY"){
						domClass.add(this.context.coachViewData.button, "disabled");
					}else{
						domClass.remove(this.context.coachViewData.button, "disabled");
					}
					if(propertyValue == "REQUIRED"){
						dojo.attr(this.context.coachViewData.button, "aria-required", "true");
					} else {
						dojo.attr(this.context.coachViewData.button, "aria-required", "false");
					}
			}
			else if(propertyName=="@label"){
				var showLabel = false;

				this.context.modelData.layoutItem.configData.forEach(function (confNode){
					if (confNode.optionName == "@labelVisibility" && confNode.value == "SHOW") { showLabel = true;}
				})

				if (propertyValue && showLabel) {
					domClass.remove(this.context.coachViewData.formGroupDiv, "hide");
				}else {
					domClass.add(this.context.coachViewData.formGroupDiv, "hide");
				}
				this.context.coachViewData.label.innerHTML = propertyValue;
			} else if (propertyName == "@labelVisibility") {
				if (propertyValue == "SHOW") {
					domClass.remove(this.context.coachViewData.formGroupDiv, "hide");
				} else {
					domClass.add(this.context.coachViewData.formGroupDiv, "hide");
				}
			} else if (propertyName == "colorMode") {
				domClass.remove(this.context.coachViewData.containingDiv, "navigationBar-background-color-light");
				domClass.remove(this.context.coachViewData.containingDiv, "navigationBar-background-color-dark");
				if (propertyValue == "light") {
					domClass.remove(this.context.coachViewData.containingDiv, "navigationBar-background-color-light");
				} else if (propertyValue == "dark"){
					domClass.add(this.context.coachViewData.containingDiv, "navigationBar-background-color-dark");
				} 
			} else if(propertyName=="alignment") {
				domClass.remove(this.context.coachViewData.containingDiv, "alignRight");
				domClass.remove(this.context.coachViewData.containingDiv, "alignCenter");
				if (propertyValue=="right") {
					domClass.add(this.context.coachViewData.containingDiv, "alignRight");
				} else if (propertyValue=="center") {
					domClass.add(this.context.coachViewData.containingDiv, "alignCenter");
				}
			} else if (propertyName == "sizeStyle") {
				
				domClass.remove(this.context.coachViewData.containingDiv, "navLarge");
				domClass.remove(this.context.coachViewData.containingDiv, "navSmall");
				domClass.remove(this.context.coachViewData.containingDiv, "navXSmall");
				this.context.coachViewData.label.style.fontSize = "14px";
				switch (propertyValue) {
					case "L": domClass.add(this.context.coachViewData.containingDiv, "navLarge"); this.context.coachViewData.label.style.fontSize = "20px"; break;
					case "S" : domClass.add(this.context.coachViewData.containingDiv, "navSmall"); this.context.coachViewData.label.style.fontSize = "12px"; break;
					case "X" : domClass.add(this.context.coachViewData.containingDiv, "navXSmall"); this.context.coachViewData.label.style.fontSize = "10px"; break;
				}
			} else if(propertyName == "highlightColor" || propertyName == "borderColor" || propertyName == "fontColor") {
				
				var highlightColor = configHelper.getResponsiveConfigOptionValue(this,"highlightColor");
				var borderColor = configHelper.getResponsiveConfigOptionValue(this,"borderColor");
				var fontColor = configHelper.getResponsiveConfigOptionValue(this,"fontColor");

				switch (propertyName) {
					case "highlightColor": highlightColor=propertyValue; break;
					case "borderColor": borderColor=propertyValue; break;
					case "fontColor":  fontColor=propertyValue; break;
				}
				
				if (this.context.coachViewData.containingDiv.childNodes[9]) {
					this.context.coachViewData.containingDiv.removeChild(this.context.coachViewData.containingDiv.childNodes[9]); 
				}

				var tmpStyle = this._setHoverStates(highlightColor, borderColor, fontColor);
				if (tmpStyle) {
					var newStyle = document.createElement('style');
					newStyle.textContent = tmpStyle;
					this.context.coachViewData.containingDiv.append(newStyle);
				}
			}
			
		}));	
	},
	modelChanged: function(propertyName, propertyValue) {
		require(["dojo/dom-class"], this.lang.hitch(this, function(domClass){
			if(propertyName=="@binding"){
				this.context.coachViewData.binding = propertyValue;
				domClass.remove(this.context.coachViewData.imageEl, "hide");
				this.updateImageSrc();
			}
		}));
	},
	updateImageSrc:function(){
		require(["dojo/dom-class", "dojo/dom-attr"], this.lang.hitch(this, function(domClass, domAttr){
			if(this.context.coachViewData.binding!==null && this.context.coachViewData.binding!==undefined && this.context.coachViewData.binding!=""){
				if (this.context.coachViewData.binding.indexOf("61.") == 0){
					var assetType = "Web";
					var imgUrl = this.context.getManagedAssetUrlById(this.context.coachViewData.binding);
					var newURL = new URL(imgUrl);
					
					if (this.context.modelData.owningCoachView.containerRef && newURL.search.indexOf(this.context.modelData.owningCoachView.containerRef) == -1){
						newURL.search = "?containerRef=" + this.context.modelData.owningCoachView.containerRef;
						imgUrl = newURL.toString();
					}
					
					domAttr.set(this.context.coachViewData.imageEl, "src", imgUrl);
				} else {
					//binding is set, which overrides "default" image settings, so just show placeholder
					domAttr.set(this.context.coachViewData.imageEl, "src", this.context.coachViewData.placeholderImageUrl);
				}
			} else if(this.context.coachViewData.defaultUrl!==null && this.context.coachViewData.defaultUrl!==undefined && this.context.coachViewData.defaultUrl!=""){
				//try to show value based on default image settings, since URL is set (not really a URL, it's just the managed asset name)
				var appAcronym = null;
				if(this.context.coachViewData.defaultAppAcronym!==null && this.context.coachViewData.defaultAppAcronym!==undefined && this.context.coachViewData.defaultAppAcronym!=""){
					appAcronym = this.context.coachViewData.defaultAppAcronym;
				}
				var assetType = "Web";
				if(this.context.coachViewData.defaultUrlType=="External"){
					assetType = "External";
				}
				var imgDefaultUrl = (assetType === "External") ? this.context.coachViewData.defaultUrl : this.context.getManagedAssetUrl(this.context.coachViewData.defaultUrl, assetType, appAcronym, false, null, true);
				domAttr.set(this.context.coachViewData.imageEl, "src", imgDefaultUrl);
			} else{
				//binding not set, and neither is default image URL, so show placeholder
				domAttr.set(this.context.coachViewData.imageEl, "src", this.context.coachViewData.placeholderImageUrl);
				domClass.add(this.context.coachViewData.imageEl, "hide");
			}
		}));
	},
	//Init the config section to hide any options that are not relevant to the current selections
	initializeConfigurationOptionVisibility: function(configHelper) {
		var visibility = this.getOptionVisibility(configHelper);
		this.setConfigurationOptionVisibility(visibility);
	},
	setConfigurationOptionVisibility: function(visibility) {
		this.configurationOptionVisibility = visibility;
	},
	getConfigurationOptionVisibility: function() {
		return this.configurationOptionVisibility;
	},
	getOptionVisibility: function(configHelper) {
		var visibility = {}, deferLoad = false, sensor = "";
		var val = configHelper.getConfigOptionValue(this, "deferLoad");
		if (val != undefined) {
			deferLoad = val;
		}
		val = configHelper.getConfigOptionValue(this, "sensor");
		if (val != undefined) {
			sensor = val;
		}
		
		if (deferLoad == true || deferLoad == "true") {
			visibility["loadBatchSize"] =  {visible: true};
		} else {
			visibility["loadBatchSize"] =  {visible: false};
		}

		if (sensor != "") {
			visibility["behaviors"] =  {visible: true};
		} else {
			visibility["behaviors"] =  {visible: false};
		}

		return visibility;
	}
};

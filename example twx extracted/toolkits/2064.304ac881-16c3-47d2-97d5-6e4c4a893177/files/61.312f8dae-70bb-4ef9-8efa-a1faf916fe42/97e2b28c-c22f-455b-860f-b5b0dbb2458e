define(["dojo/dom-class", "dojo/_base/xhr"], function(domClass, xhr){

	var bpmext = window.bpmext = {};
	bpmext.uidesign =
	{
		css:
		{
			STYLES_ARCHIVE : "BPMExt-Style.zip",
			appendStyle : function(styles)
			{
				var css = document.createElement('style');
				css.type = 'text/css';

				if (css.styleSheet) css.styleSheet.cssText = styles;
				else css.appendChild(document.createTextNode(styles));

				document.getElementsByTagName("head")[0].appendChild(css);
			},
			appendStyleSheet : function(styleSheetURL, media)
			{
				if(!window.__bpmextCSSMap[styleSheetURL])
				{
					var head = document.getElementsByTagName("head")[0];
					var link = document.createElement('link');
					link.type = 'text/css';
					link.rel = "stylesheet";
					link.href = styleSheetURL;

					if(media)
						link.media = media;

					head.appendChild(link);
					window.__bpmextCSSMap[styleSheetURL] = true;
				}
			},
			/*
			ensureStyleSheetLoaded : function(styleSheetURL, assetType, archiveName, fileName)
			{
				if(typeof styleSheetURL != "string")
				{
					var view = styleSheetURL;
					styleSheetURL = view.context.getManagedAssetUrl(archiveName, assetType, null, null, fileName);
				}

				this.appendStyleSheet(styleSheetURL);
			},
			*/
			ensureGeneralStylesLoaded : function(view)
			{
				if(!window.__bpmextCSSMap["__SPARKOSFonts"])
				{
					var loadFontCss =
						"@font-face {" +
						"font-family: Open Sans; " +
						"font-weight: 300;" +
						"font-style: normal;" +
						"src: local('Open Sans Light'), local('OpenSans-Light'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "open-sans/OpenSans-Light.woff") + ") format('woff');" +
						"} " +
						"@font-face {" +
						"font-family: Open Sans; " +
						"font-weight: 400;" +
						"font-style: normal;" +
						"src: local('Open Sans'), local('OpenSans'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "open-sans/OpenSans.woff") + ") format('woff');" +
						"} " +
						"@font-face {" +
						"font-family: Open Sans; " +
						"font-weight: 600;" +
						"font-style: normal;" +
						"src: local('Open Sans Semibold'), local('OpenSans-Semibold'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "open-sans/OpenSans-Semibold.woff") + ") format('woff');" +
						"} " +
						"@font-face {" +
						"font-family: Open Sans; " +
						"font-weight: 700;" +
						"font-style: normal;" +
						"src: local('Open Sans Bold'), local('OpenSans-Bold'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "open-sans/OpenSans-Bold.woff") + ") format('woff');" +
						"} " +
						"@font-face {" +
						"font-family: Open Sans; " +
						"font-weight: 300;" +
						"font-style: italic;" +
						"src: local('Open Sans Light Italic'), local('OpenSansLight-Italic'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "open-sans/OpenSansLight-Italic.woff") + ") format('woff');" +
						"} " +
						"@font-face {" +
						"font-family: Open Sans; " +
						"font-weight: 400;" +
						"font-style: italic;" +
						"src: local('Open Sans Italic'), local('OpenSans-Italic'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "open-sans/OpenSans-Italic.woff") + ") format('woff');" +
						"} " +
						"@font-face {" +
						"font-family: Open Sans; " +
						"font-weight: 600;" +
						"font-style: italic;" +
						"src: local('Open Sans Semibold Italic'), local('OpenSans-SemiboldItalic'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "open-sans/OpenSans-SemiboldItalic.woff") + ") format('woff');" +
						"} " +
						"@font-face {" +
						"font-family: Open Sans; " +
						"font-weight: 700;" +
						"font-style: italic;" +
						"src: local('Open Sans Bold Italic'), local('OpenSans-BoldItalic'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "open-sans/OpenSans-BoldItalic.woff") + ") format('woff');" +
						"} " +
						"@font-face {" +
						"font-family: Droid Sans Mono; " +
						"font-weight: 400;" +
						"font-style: normal;" +
						"src: local('Droid Sans Mono'), local('DroidSansMono'), url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "droid-sans/DroidSans-Mono.woff2") + ") format('woff2');" +
						"} "
						;

					this.appendStyle(loadFontCss);

					var syntheticBody = document.querySelector("div.claro");
					domClass.add(syntheticBody, "synthBody");

					this.ensureStyleLoaded(
						view,
						"synthBody",
						"div.claro.synthBody {" +
							"    font-family: 'Open Sans','Helvetica Neue',Helvetica,Arial,sans-serif;" +
							"    font-size: 13px;" +
							"    line-height: 1.42857143;" +
							"    color: #555;" +
							"    background-color: #fff" +
							"}"
						);

					window.__bpmextCSSMap["__SPARKOSFonts"] = true;
				};
			},
			ensureGlyphsLoaded : function(view)
			{
				if(!window.__bpmextCSSMap["__SPARKFAFonts"])
				{
					var loadFontCss = "@font-face {" +
					"font-family: FontAwesome; " +
					"src: url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "font-awesome/fontawesome-webfont.eot") + "); " +
					"src: url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "font-awesome/fontawesome-webfont.eot") + ") format('embedded-opentype'), " +
					"url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "font-awesome/fontawesome-webfont.woff") + ") format('woff'), " +
					"url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "font-awesome/fontawesome-webfont.ttf") + ") format('truetype'), " +
					"url(" + view.context.getManagedAssetUrl(this.STYLES_ARCHIVE, view.context.assetType_WEB, null, null, "font-awesome/fontawesome-webfont.svg#fontawesomeregular") + ") format('svg'); " +
					"font-weight: 400;" +
					"font-style: normal;" +
					"}";

					this.appendStyle(loadFontCss);
					window.__bpmextCSSMap["__SPARKFAFonts"] = true;
				}
			},
			ensureStyleLoaded : function(view, styleID, styleSpec)
			{
				if(!window.__bpmextCSSMap["__Ctl" + styleID])
				{
					this.appendStyle(styleSpec);
					window.__bpmextCSSMap["__Ctl" + styleID] = true;
				}
			},
			/**
			 * Called to ensure the "spark-ui" class is added to the root element of the editor.
			 */
			ensureSparkUIClass : function(someEle){
				var currentEle = someEle;
				while(currentEle){
					if(domClass.contains(currentEle, "DesignBodyElement")){
						domClass.add(currentEle, "spark-ui");
						return;
					}
					currentEle = currentEle.parentElement;
				}
			}
        },
        svg: {
            loadSVG: function (url, svgMapName, callback) {
                xhr("GET", {
                    url: url,
                    handleAs: "xml",
                    load: function (response) {
                        var svgElement = response && response.getElementsByTagName("svg")[0];
                        if (svgElement) {
                            window.__bpmextSVGMap[svgMapName] = svgElement;
                            window.__bpmextSVGMap.currentlyLoading.splice(window.__bpmextSVGMap.currentlyLoading.indexOf(svgMapName), 1);
                            if (dojo.isFunction(callback)) {
                                callback(svgElement);
                            }
                        }
                    },
                    error: function (response) {
                        window.__bpmextSVGMap.currentlyLoading.splice(window.__bpmextSVGMap.currentlyLoading.indexOf(svgMapName), 1);
                        return response;
                    }
                });
            },
            ensureCarbonIconsLoaded: function (view) {
                var svgMapName = "__CarbonIconsSprite",
                    id = "carbon-icons-sprite",
                    archiveName= "BPMExt-Style.zip",
                    projectAcronym = "SYSBPMUI",
                    svgFileName = "carbon-icons.svg",
                    carbonIconsUrl = view && view.context && view.context.getManagedAssetUrl(archiveName, view.context.assetType_WEB, projectAcronym, null, svgFileName) || undefined;
                if (!window.__bpmextSVGMap[svgMapName] && window.__bpmextSVGMap.currentlyLoading.indexOf(svgMapName) === -1) {
                    window.__bpmextSVGMap.currentlyLoading.push(svgMapName);
                    this.loadSVG(carbonIconsUrl, svgMapName, function (svgElement) {
                        // apply styling elements to hide the sprite
                        svgElement.style.width = "0px";
                        svgElement.style.height = "0px";
                        svgElement.style.overflow = "hidden";
                        svgElement.style.position = "absolute";
                        svgElement.setAttribute("id", id);
                        svgElement.setAttribute("aria-hidden", "true");
                        document.body.insertBefore(svgElement, document.body.firstChild);
                    });
                }
            },
            formatCarbonIconName: function formatCarbonIconName(name) {
                return "#" + name.trim().toLowerCase().replace(/\s+/g, "-");
            },
            getCarbonIcon: function getCarbonIcon(iconName) {
                var svgShell = null, useElement = null;
                if (iconName && iconName.indexOf("ci-") === 0) {
                    svgShell = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                    useElement = document.createElementNS("http://www.w3.org/2000/svg", "use");

                    useElement.setAttributeNS("http://www.w3.org/1999/xlink", "xlink:href", this.formatCarbonIconName(iconName));

                    svgShell.appendChild(useElement);
                    // domClass only works with HTML DOM not SVG DOM
                    // we are only adding one class. classList doesn't work with SVG on IE. We could shim it but performance is impacted
                    svgShell.setAttribute("class", "ci");
                }
                return svgShell;
            },
            replaceCarbonIcon: function replaceCarbonIcon(svgElement, newIconName) {
                if (newIconName && newIconName.indexOf("ci-") === 0 && svgElement && svgElement.firstChild && svgElement.firstChild.tagName === "use") {
                    svgElement.firstChild.setAttributeNS("http://www.w3.org/1999/xlink", "xlink:href", this.formatCarbonIconName(newIconName));
                }
                return svgElement;
            }
        },
		/**
		 * labelTextNode - the DOM text node containing the label
		 * labelHideEle - the DOM element to hide when label visisbility is HIDE
		 * requiredClassEle - the element on which to apply the bpmRequiredMarker class when visibility is set to required
		 * ignoreLabelVis - if true, will not remove label when label vis is set to HIDE
		 * supportsExpression - If true, the "expression" config option will be looked it.  If this config is set, it overrides
		 * showLabelWhenEmpty - if true, the label element will not be hidden if it is empty (default is to hide element)
		 * the @label.
		 */
		createLabelHandler : function(labelTextNode, labelHideEle, requiredClassEle, ignoreLabelVis, supportsExpression, showLabelWhenEmpty)
		{
			var labelHandler = {};
			labelHandler.labelTextNode = labelTextNode;
			labelHandler.labelHideEle = labelHideEle;
			labelHandler.requiredClassEle = requiredClassEle;
			labelHandler.ignoreLabelVis = ignoreLabelVis;
			labelHandler.supportsExpression = supportsExpression;
			labelHandler.showLabelWhenEmpty = showLabelWhenEmpty;

			labelHandler.propLabelRaw = undefined;
			labelHandler.propLabel = undefined;
			labelHandler.propExpression = undefined;
			//keep track of label visibility and visibility
			labelHandler.propLabelVis = undefined;
			labelHandler.propVis = undefined;
			labelHandler.propertyChanged = function(propertyName, propertyValue){
				if(propertyName=="@label"){
					labelHandler.propLabel = propertyValue;
					labelHandler.updateLabel();
				} else if(propertyName=="@labelVisibility"){
					labelHandler.propLabelVis = propertyValue;
					labelHandler.updateLabel();
				} else if(propertyName=="@visibility"){
					labelHandler.propVis = propertyValue;
					labelHandler.updateLabel();
				} else if(labelHandler.supportsExpression && propertyName==="expression"){
					labelHandler.propExpression = propertyValue;
					labelHandler.updateLabel();
				}
			};
			labelHandler.modelChanged = function(propertyName, propertyValue){
				if(propertyName=="@label"){
					labelHandler.propLabelRaw = propertyValue;
					labelHandler.updateLabel();
				}
			};
			labelHandler.setLabelDomElements = function(labelTextNode, labelHideEle){
				labelHandler.labelTextNode = labelTextNode;
				labelHandler.labelHideEle = labelHideEle;
				labelHandler.updateLabel();
			};
			labelHandler.updateLabel = function(){
				if(labelHandler.requiredClassEle){
					if(labelHandler.propVis==="REQUIRED"){
						domClass.add(labelHandler.requiredClassEle, "bpmRequiredMarker");
					}else{
						domClass.remove(labelHandler.requiredClassEle, "bpmRequiredMarker");
					}
				}

				var isLabelHide = false;
				//label is hidden if it is explicitly hidden OR there is no content from expression or static label or dynamic binding
				if(labelHandler.propLabelVis!="HIDE" && labelHandler.showLabelWhenEmpty){
					//check against the labelHandler.showLabelWhenEmpty setting and ensure label is not hidden if empty (still hide if label vis is set to HIDE though)
					isLabelHide = false;
				}else if( (labelHandler.propLabelVis=="HIDE" && !labelHandler.ignoreLabelVis) ||
						( (labelHandler.propExpression===null || labelHandler.propExpression===undefined || labelHandler.propExpression==="") &&
						(labelHandler.propLabel===null || labelHandler.propLabel===undefined || labelHandler.propLabel==="") &&
						(labelHandler.propLabelRaw===null || labelHandler.propLabelRaw===undefined || labelHandler.propLabelRaw==="") )	){
					isLabelHide = true;
				}

				if(labelHandler.labelHideEle){
					if(isLabelHide){
						domClass.add(labelHandler.labelHideEle, "CoachView_hidden");
					}else{
						domClass.remove(labelHandler.labelHideEle, "CoachView_hidden");
					}
				}

				if(labelHandler.labelTextNode){
					if(!labelHandler.ignoreLabelVis && isLabelHide){
						//label is set to HIDE, takes precedence
						labelHandler.labelTextNode.data  = '\u00A0';
					}else if(labelHandler.propExpression!==null && labelHandler.propExpression!==undefined && labelHandler.propExpression!==""){
						//expression always overrides @label
						labelHandler.labelTextNode.data = labelHandler.propExpression;
					}else if(labelHandler.propLabel!==null && labelHandler.propLabel!==undefined && labelHandler.propLabel!==""){
						//use the static @label setting
						labelHandler.labelTextNode.data = labelHandler.propLabel;
					}else if(labelHandler.propLabelRaw!==null && labelHandler.propLabelRaw!==undefined && labelHandler.propLabelRaw!==""){
						//use the variable set if dynamic
						labelHandler.labelTextNode.data = labelHandler.propLabelRaw;
					}else{
						labelHandler.labelTextNode.data = "";
					}
				}
			};
			return labelHandler;
		},

		loadLocalization : function(view, callback)
		{
			if (bpmext.localization) {
				callback();
			} else {
				require({
					packages: [{
						name: 'com.ibm.bpm.bpmui.localization',
						location: view.context.getManagedAssetUrl('BPMExt-Core.zip', view.context.assetType_WEB, 'SYSBPMUI') + "/com/ibm/bpm/bpmui/localization"
					}]
				});

				require(["com.ibm.bpm.bpmui.localization"], function(localization){
					localization.initMessages(null, true, function(){
						callback();
					});
				});
			}
		}
	};

    // init global objects
    if (!window.__bpmextSVGMap){
        window.__bpmextSVGMap = {};
        window.__bpmextSVGMap.currentlyLoading = [];
    }

    if (!window.__bpmextCSSMap) {
        window.__bpmextCSSMap = {};
    }
	return bpmext;
});

/**
 * @function FOR_EACH
 * @memberof formulas
 * @param {expression} JSExpression Javascript expression containing #{ } data element references
 * @desc FOR_EACH used in a formula denotes that the expression contained within { } will be 
 * executed <i>for each</i> element in a list/array. 
 *<p><b>Note:</b> FOR_EACH is more a keyword than a 
 * function (see in the example below the need for {} instead of () when using <code>FOR_EACH</code> - The alias  
 * <code>FOR EACH</code> can be used also.</p>
 * @example SUM(${Table1}, FOR_EACH { #{quantity} * #{unitPrice} })
 *  //This means: In Table1, which contains a <i>list</i> of data elements including quantity and unitPrice,...
 *  //...compute the aggregate sum of each quantity * unitPrice
 */

/**
 * @function SUM
 * @memberof formulas
 * @param {com.ibm.bpm.coach.CoachView} view
 * @param {function} forEachIterator (Optional) Use with FOR_EACH function
 * @desc Sum function. For use only in the Formula property of control types that support formulas
 * @example SUM(${Table1/LineItemTotal*}) 
 *  //Sum of ALL <i>LineItemTotal</i> field/control values in the table
 * @example SUM(${Table1}, FOR_EACH {#{quantity}}) 
 *  //Sum of ALL <i>quantity</i> data elements in the bound data of the table
 */

/**
 * @function AVG
 * @memberof formulas
 * @param {com.ibm.bpm.coach.CoachView} view
 * @param {function} forEachIterator (Optional) Use with FOR_EACH function
 * @desc Average (mean) function. For use only in the Formula property of control types that support formulas
 * @example AVG(${Table1/LineItemTotal*}) 
 *  //Average of ALL <i>LineItemTotal</i> field/control values in the table
 * @example AVG(${Table1}, FOR_EACH {#{unitPrice}}) 
 *  //Average of ALL <i>unitPrice</i> data elements in the bound data of the table
 */

/**
 * @function MIN
 * @memberof formulas
 * @param {com.ibm.bpm.coach.CoachView} view
 * @param {function} forEachIterator (Optional) Use with FOR_EACH function
 * @desc Minimum function. For use only in the Formula property of control types that support formulas
 * @example MIN(${Table1/LineItemTotal*}) 
 *  //Minimum of ALL <i>LineItemTotal</i> field/control values in the table
 * @example MIN(${Table1}, FOR_EACH {#{unitPrice} * #{quantity}}) 
 *  //Minimum of product of ALL <i>unitPrice</i> and <i>quantity</i> data elements 
 *  //in the bound data of the table
 */


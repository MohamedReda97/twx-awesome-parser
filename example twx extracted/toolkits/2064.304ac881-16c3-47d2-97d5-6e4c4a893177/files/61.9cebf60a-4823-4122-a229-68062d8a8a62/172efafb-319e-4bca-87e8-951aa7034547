 * @example COUNT(${Table1}, FOR_EACH {#{unitPrice}}) 
 *  //Count of ALL <i>unitPrice</i> data elements (not null or undefined)
 *  //in the bound data of the table
 */

//Simple operations
/**
 * @function MULT
 * @memberof formulas
 * @param {com.ibm.bpm.coach.CoachView} view1
 * @param {com.ibm.bpm.coach.CoachView} view2
 * @desc Multiplication function. For use only in the Formula property of control types that support formulas
 * @example MULT(@{UnitPrice=}, @{Quantity=}) 
 *  //Multiply values of UnitPrice and Quantity controls in same row as field containing formula
 * @example @{UnitPrice=} * @{Quantity=}
 *  //Equivalent to above
 * @example ${UnitPrice=}.getValue() * ${Quantity=}.getValue()
 *  //Equivalent to above
 */

/**
 * @function DIV
 * @memberof formulas
 * @param {com.ibm.bpm.coach.CoachView} view1
 * @param {com.ibm.bpm.coach.CoachView} view2
 * @desc Division function. For use only in the Formula property of control types that support formulas
 * @example DIV(@{LineItemWeight=}, @{UnitWeight=}) 
 *  //DIVIDE values of UnitPrice and Quantity controls in same row as field containing formula
 * @example @{LineItemWeight=} / @{UnitWeight=}
 *  //Equivalent to above
 * @example ${LineItemWeight=}.getValue() / ${UnitWeight=}.getValue()
 *  //Equivalent to above
 */

/**
 * @function ADD
 * @memberof formulas
 * @param {com.ibm.bpm.coach.CoachView} view1
 * @param {com.ibm.bpm.coach.CoachView} view2
 * @desc Addition function. For use only in the Formula property of control types that support formulas
 * @example ADD(@{PreTaxPrice}, @{TaxAmount}) 
 *  //Add values of PreTaxPrice and TaxAmount controls
 * @example @{PreTaxPrice} + @{TaxAmount}
 *  //Equivalent to above
 * @example ${PreTaxPrice}.getValue() + ${TaxAmount}.getValue()
 *  //Equivalent to above
 */

/**
 * @function SUB
 * @memberof formulas
 * @param {com.ibm.bpm.coach.CoachView} view1
 * @param {com.ibm.bpm.coach.CoachView} view2
 * @desc Subtraction function. For use only in the Formula property of control types that support formulas
 * @example SUB(@{NetPrice}, @{TaxAmount}) 
 *  //Subtract values of TaxAmount from NetPrice controls
 * @example @{NetPrice} - @{TaxAmount}
 *  //Equivalent to above
 * @example ${NetPrice}.getValue() - ${TaxAmount}.getValue()
 *  //Equivalent to above
 */

/**
 * @function MOD
 * @memberof formulas
 * @param {com.ibm.bpm.coach.CoachView} view1
 * @param {com.ibm.bpm.coach.CoachView} view2
 * @desc Modulo/division remainder function. For use only in the Formula property of control types that support formulas
 * @example MOD(@{TotalPeople}, @{TeamSize}) 
 *  //Compute division remainder of values of TeamSize from TotalPeople controls
 * @example @{TotalPeople} % @{TeamSize}
 *  //Equivalent to above
 * @example ${TotalPeople}.getValue() % ${TeamSize}.getValue()
 *  //Equivalent to above
 */

		 * @desc Set items selected in select control based on the indexes
		 */
		this.constructor.prototype.setSelectedItemsAt = function (idxs)			//jmacSEL
		{
			if (idxs.length > 0)
			{
				for(var i = 0; i < this._instance.select.options.length; i++)
				{
					this._instance.select.options[i].selected = false;
					domClass.remove(this._instance.select.options[i], "selected");
					domAttr.set(this._instance.select.options[i], "aria-selected", "false");
				}			
				
				var selOpts = this._instance.select.options;
				var mySelectedArray =  [ ];
				for (var i = 0; i < idxs.length; i++)
				{

					var curIdx = idxs[i];
					if ( !isNaN(curIdx) && (curIdx <= this._instance.select.options.length - 1) && (curIdx > -1) )
					{
						this._instance.select.options[curIdx].selected = true;
						domClass.add(this._instance.select.options[curIdx], "selected");
						domAttr.set(this._instance.select.options[curIdx], "aria-selected", "true");
						if (this._instance._isSimpleBinding)
							mySelectedArray.push(selOpts[curIdx].value)
						else
						{
							var myObj = {};
							myObj[this._instance._busValProp] = selOpts[curIdx].value;
							myObj[this._instance._busDisProp] = selOpts[curIdx].label;
							mySelectedArray.push(myObj);
						}
					}
				}
				
				this.context.binding.set("value", mySelectedArray);			
			}
		};


/** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>console.log(me.getItemCount())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Service Items:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when AJAX Service returns item list. Only triggers if Item lookup Mode is set to Items From Service.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>console.log("MultiSelect1 item service retrieved items successfully")</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Service Error:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when AJAX selection service returns an error. Will not trigger if Item Lookup Mode is not set to Items From Service.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.clearItems()</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Change:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when the bound data changes.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${MultiSelect2}.reloadServiceItems(me.getSelectedIndices())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitMultiSelect = function (bpmext, utilities, domClass, domAttr, domConstruct, domGeometry, json)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE",
			EVT_ONFOCUS : "eventON_FOCUS",
			EVT_ONBLUR : "eventON_BLUR",
			EVT_ONSVCITEMS : "eventON_SVCITEMS",
			EVT_ONSVCERROR : "eventON_SVCERROR",
			_getItemIndex : function (view, value)
			{
				
				// DEC2016 CHANGE to use _instance.itemList instead of _instance.select.options
				// for consistency with Single Select method
				if(view._instance.itemList.items)
				{
					for(var i = 0; i < view._instance.itemList.items.length; i++)
					{

						if (value ==  view._instance.itemList.items[i][view._instance._optValProp] )
							return i;
					}
				}				
				
				return -1;
			},
			_getItemOption : function (view, index)
			{
				if(view._instance.select.options)
					return view._instance.select.options[index];
			},
			//{#feature: * Allow leniency for mapping complex-typed items list element to bound data}
			_mapBindingValues : function(view, values)
			{
				if(view.isBound() && view.context.bindingType)
				{
					var bType = view.context.bindingType().toUpperCase();
					if ( (bType == "STRING[]")  || (bType == "INTEGER[]") || (bType == "DECIMAL[]") || (bType == "BOOLEAN[]") )		//jmacSEL
					{
						if(values != null && values.length > 0)
						{
							var typeOfItems;
							if (values[0][view._instance._optValProp] != undefined)
								typeOfItems = typeof values[0][view._instance._optValProp];
							else
								typeOfItems = typeof values[0];

							var values2 = [];
							
							if(typeOfItems == "number") 
							{
								for(var i = 0; i < values.length; i++)
								{
									if (values[0][view._instance._optValProp] != undefined)									
										values2.push(values[i][view._instance._optValProp]);
									else
										values2.push(values[i]);
								}
								
								values = values2;
							}
							else // store as string
							{
								for(var i = 0; i < values.length; i++)
								{
									if (values[0][view._instance._optValProp] != undefined)									
									  values2.push(values[i][view._instance._optValProp] + "");
									else
										values2.push(values[i] + "");
								}
								
								values = values2;
							}
						}
					}
				}

				return values;
			},
			_getSelectedItemIndices : function (view,newVal) 						// jmacSEL  // DEC 2016
			{
				var indices = [];
				if (view._instance._isSimpleBinding)
				{	
					for (var i=0; i < view._instance.select.options.length; i ++)
					{
						for (var ii = 0; ii < newVal.items.length; ii++)
						{
//							if (view._instance.select.options[i].value == newVal.items[ii][view._instance._optValProp])
							if (view._instance.select.options[i].value == newVal.items[ii])
							{
								indices.push(i);
								break;
							}
						}
					}
				}
				else // complex binding
				{	
					for (var i=0; i < view._instance.select.options.length; i ++)
					{
						for (var ii = 0; ii < newVal.items.length; ii++)
						{
							if (view._instance.select.options[i].innerHTML == newVal.items[ii][view._instance._busDisProp])
//							if (view._instance.select.options[i].innerHTML == newVal.items[ii])
							{
								indices.push(i);
								break;
							}
						}
					}
				}
				return indices;
			},
			_setSelectedItemsByIndex : function(view, idxs) 				//jmacSEL
			{
				for(var i = 0; i < view._instance.select.options.length; i++)
				{
					view._instance.select.options[i].selected = false;
					domClass.remove(view._instance.select.options[i], "selected");
					domAttr.set(view._instance.select.options[i], "aria-selected", "false");
				}
				
				for(var i = 0; i < idxs.length; i++)
				{
					var curIdx = idxs[i];
					view._instance.select.options[curIdx].selected = true;
					domClass.add(view._instance.select.options[curIdx], "selected");
					domAttr.set(view._instance.select.options[curIdx], "aria-selected", "true");
				}				
			},
			_setSelectedItems : function (view, values)
			{
				var i;
				for(i = 0; i < view._instance.select.options.length; i++)
				{
					view._instance.select.options[i].selected = false;
					domClass.remove(view._instance.select.options[i], "selected");
					domAttr.set(view._instance.select.options[i], "aria-selected", "false");
				}
				
				if(values != null && values.items)
					values = values.items;
				
				if(values)
				{
					var map = {};
					for(i = 0; i < values.length; i++)
					{
						if (values[i].name)
						{
							map[values[i].name] = true;
						}
						else
						{
							map[values[i]] = true;
						}
					}
					
					for(i = 0; i < view._instance.select.options.length; i++)
					{
						if(map[view._instance.select.options[i].value]){
							view._instance.select.options[i].selected = true;
							domClass.add(view._instance.select.options[i], "selected");
							domAttr.set(view._instance.select.options[i], "aria-selected", "true");
						}
					}
				}
			},
			_appendOption : function(view, key, value)
			{
				if(view.context.itemCount===null || view.context.itemCount===undefined){
					view.context.itemCount=0;
				}
				var opt = document.createElement("option");
				domAttr.set(opt, "id", "multiselect-option-" + view.context.controlidpath + "["+view.context.itemCount+"]");
				view.context.itemCount++;
				domAttr.set(opt, "value", key);
				opt.innerHTML = view.context.htmlEscape(value);
				utilities.BiDi.applyTextDir(opt, opt.innerHTML, view._instance.baseTxtDir, view._instance.genPrefTextDir);
				view._instance.select.appendChild(opt);
				
				return opt;
			},
			_rebindAllUpdates : function(view)
			{
				
			},
			_updateItemList: function(view, event, itemList)
			{
				var selOpt
				if(event.insertedInto >= 0 && event.insertedInto != event.removedFrom)
				{
					view._proto._rebindAllUpdates(view);
					
					if(event.insertedInto == view._instance.select.options.length) //If inserted at the end
					{
						var item = event.newVal;
						selOpt = view._proto._appendOption(view, item[view._instance._optValProp], item[view._instance._optDisProp]);
						var tstOptValue;  //DEC 2016
						var boundData = view.context.binding.get("value").items;
						// check the bound dat for any items which should be selected
						for (var i = 0; i < boundData.length; i++)
						{
							if (view._instance._isSimpleBinding)
								tstOptValue = boundData[i];
							else
								tstOptValue = boundData[i][view._instance._busValProp];
							if (selOpt.value == tstOptValue)
							{
								selOpt.selected = true;
								domClass.add(selOpt, "selected");
								domAttr.set(selOpt, "aria-selected", "true");
								break;
							}	
						}
					}
					else
					{
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("Mid-list inserts not supported by Coach NG API yet");
						bpmext.log.error(bpmext.localization.formatMsg("general", "MID_LIST_INSERT_COACH_NG_ERROR"));
					}
				}
				else if(event.removedFrom >= 0 && event.removedFrom != event.insertedInto) //List item deletion
				{
					view._proto._rebindAllUpdates(view);
					selOpt = view._instance.select.options[event.removedFrom];
					
					if(selOpt != undefined) 	// DEC2016
					{
						selOpt.parentNode.removeChild(selOpt);
						
						if (selOpt.selected == true)  // remove current selection
						{
							view._proto._updateSelectedItems(view);
						}
					}
				}
				else if(event.removedFrom >= 0 && event.removedFrom == event.insertedInto)//Just a value change...
				{
					if(event.newVal != null)
					{
						selOpt = view._instance.select.options[event.removedFrom];
						selOpt.value = event.newVal[view._instance._optValProp];
						selOpt.innerHTML = event.newVal[view._instance._optDisProp];
						if (selOpt.selected == true)
							view._proto._updateSelectedItems(view);
						utilities.BiDi.applyTextDir(selOpt, selOpt.innerHTML, view._instance.baseTxtDir, view._instance.genPrefTextDir);
					}
				}
				else if(event.removedFrom == undefined && event.removedFrom == event.insertedInto ) // whole new list
				{
					if (event.newVal != null)
					{
						view._instance.itemList = view.context.options.itemList.get("value");
						view._proto._loadListItems(view, view._instance.itemList, view.context.binding.get("value"), view._instance._optValProp, view._instance._optDisProp);						
						//view._proto._loadListItems(view, view._instance.itemList, event.newVal);				
					}
				}

			},
			_updateSelectedItems : function (view)
			{
				try
				{
					view._instance._stopSetItem = true;
					var tArray = [];
					for (var i = 0; i < view._instance.select.options.length; i++)
					{
						if (view._instance.select.options[i].selected == true)
						{
							if (view._instance._isSimpleBinding)
							{
								tArray.push(view._instance.itemList.items[i][view._instance._optValProp]);
							}
							else
							{	
								tArray.push(view._instance.itemList.items[i]);
							}
						}
					}
					view.context.binding.set("value", tArray);
				}
				finally
				{
					delete view._instance._stopSetItem;
				}
				
			},
			_loadListItems : function(view, itemList, selectedValues, keyProp, valueProp)
			{
				if(view._instance._bindSelUpdHandle)
					view._instance._bindSelUpdHandle.unbind();

				if(view._instance._bindValueUpdHandle)
					view._instance._bindValueUpdHandle.unbind();
				
				if(keyProp == null)
					keyProp = "name";
				
				if(valueProp == null)
					valueProp = "value";
				
				view._instance._bindValueUpdHandle = itemList.bindAll
				(
					function(event)
					{			// jmacSEL potential  IT doesn't look like this code EVER gets called.					
						view._proto._updateItemList(view, event, itemList);
					}, 
					view
				);

				// Fix for defect 290086
				view._instance.select.innerHTML = "<optgroup disabled hidden></optgroup>";
				
				var items = itemList.items;
				//{#bug: * Allow initial selection from keys in bound list}
				var selVals = {};
				//{#bug: BG-760 }
				if (selectedValues)
				{
					var selIdxs = selectedValues.length() > 0 ? [] : null;
					
					for(var i = 0; i < selectedValues.length(); i++)
					{
						var selItem = selectedValues.get(i);
						if(selItem[view._instance._busValProp] != undefined)		// DEC2016
							selVals[selItem[view._instance._busValProp]] = true;	// DEC 2016
						else
							selVals[selItem] = true;
					}
				}
					
				for(var i = 0; i < items.length; i++)
				{
					var opt;
					if (items[i][keyProp] != undefined)				// jmacSEL  existing bug  without test for undefined a value of 0 causes issues
						opt = this._appendOption(view, items[i][keyProp], items[i][valueProp]);
					else
						opt = this._appendOption(view, items[i], items[i]);
					
					if(selVals[opt.value])
					{
						opt.selected = true;
						domClass.add(opt, "selected");
						domAttr.set(opt, "aria-selected", "true");
						if(selIdxs != null)
							selIdxs.push(i);
					}
				}
				
				if(selIdxs != null)
				{
					var lookupMode = view.context.options.itemLookupMode.get("value");
					
					if(lookupMode == "B" && view.context.options.itemList && !view.isBound())
					{
						var l = view.context.options.itemList.get("value");
						l.set("listAllSelectedIndices", selIdxs);
					}
				}

				view._instance._bindSelUpdHandle = itemList.bind(
					"listAllSelectedIndices", 
					function(event){
						if(event.newVal !== view._instance.sidxs){
							view._proto._setSelectedItemsByIndex(view,event.newVal);				//jmacSEL
						}
						//view._proto._setSelectedItems(view, {items: itemKeys});
					}, 
					view
					);

				// Defect 330494 - START
				this._handleVisibility(view);
				// Defect 330494 - END
			},
			_updateControl : function (view)
			{
				var errors = bpmext.ui.getViewValidationErrors(view);
				
				//Color style
				var colStyle = errors ? "E" : view.context.options.colorStyle.get("value");
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_COL_STL_CLZ, colStyle, view._instance.oldColStyle);
				view._instance.oldColStyle = colStyle;
				
				//Validation Error Icon
				if(view._instance.icon)
				{
					bpmext.ui.util.closeTooltip(view._instance.iconTT, view._instance.input);
					delete view._instance.iconTT;
					
					view._instance.input.removeChild(view._instance.icon);
					delete view._instance.icon;
				}
				
				if(errors)
				{
					domClass.add(view._instance.group, "has-feedback has-error");
					view._instance.icon = document.createElement("span");
					view._instance.input.appendChild(view._instance.icon);

					if (view.context.options.showValidationMarker.get("value") === true) {
						domClass.add(view._instance.icon, "fa form-control-feedback fa-exclamation-circle");
					
						var ttOpts = {
							horizontalPos: "right", 
							verticalPos: "top", 
							cssClass: "validationError",
							plainText: false,
							smartPositioning: true
						};
					
						view._instance.iconTT = bpmext.ui.util.showTooltip(
							view._instance.input, 
							bpmext.ui.util.formatErrors(errors), 
							ttOpts
						);

						view._instance.errorMessage = document.createElement("div");
						view._instance.errorMessage.id = view._instance.input.firstElementChild.id + "-error-msg";
						view._instance.errorMessage.classList.add("hide");
						view._instance.errorMessage.innerHTML = bpmext.ui.util.formatErrors(errors);
						view._instance.input.appendChild(view._instance.errorMessage);
						domAttr.set(view._instance.input.firstElementChild, "aria-describedby", view._instance.errorMessage.id);
						domAttr.set(view._instance.input.firstElementChild, "aria-invalid", "true");
					}
				}
				else
				{
					domClass.remove(view._instance.group, "has-feedback has-error");	
					if (view._instance.errorMessage) { view._instance.errorMessage.remove(); }
					domAttr.remove(view._instance.input.firstElementChild, "aria-describedby");
					domAttr.remove(view._instance.input.firstElementChild, "aria-invalid");			
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);

				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			_setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else 
				{
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}
					
					domClass.remove(view.context.element, "labelWidth");
				}
					
			},			
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(view._instance.label)
						view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("MultiSelect._setLabelVisibility() error: " + e);
					bpmext.log.error("MultiSelect._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_createLabel : function (view)
			{
				view._instance.label = document.createElement("label");
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.group, "first");
				domAttr.set(view._instance.label, "for", view._instance.select.id);
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefTextDir
							);
					}
					else
					{
						if(view._instance.label)
						{
							view._instance.group.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("MultiSelect._setLabel() error: " + e);
					bpmext.log.error("MultiSelect._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setSizeStyle : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldSzStyle;
				
				newVal = bpmext.ui.util.normalizeSizeStyle(newVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);
				oldVal = bpmext.ui.util.normalizeSizeStyle(oldVal, bpmext.ui.util.OPTS_SZ_STL_CLZ);

				bpmext.ui.util.replaceCSSClass(view._instance.select, bpmext.ui.util.OPTS_SZ_STL_CLZ, newVal, oldVal);
				view._instance.oldSzStyle = newVal;
				
				bpmext.ui.util.propagateUpSizeStyle(view, newVal);
			},
			_setWidth : function (view, width)
			{
				try
				{
					if (width != null && width != "")
					{
						if (!isNaN(width))
							width += "px";

						view.context.element.style.width = width;
						
						domClass.add(view.context.element, "widthSet");
					}
					else
					{
						view.context.element.style.width = null;

						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("MultiSelect._setWidth() error: " + e);
					bpmext.log.error("MultiSelect._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},			
			_setTabIndex : function (view, index)
			{
				if(index != null)
					domAttr.set(view._instance.select, "tabindex", index);
				else
					domAttr.remove(view._instance.select, "tabindex");
			},
			_handleVisibility : function (view)
			{
				var vis = utilities.handleVisibility(view.context);
				
				if (vis != "NONE") {
					if(vis === "READONLY") {
						// Defect 323393 - Android 9:  Multiselect values in read-only Tabs can not be seen
						var options = view._instance.select.options;
						for(i = 0; i < options.length; i++) {
							domAttr.set(options[i], "disabled", "");
						}
					} else {

		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;
				
				//{#feature: * Allow for binding to Complex Types in addition to Simple Types; Added setSelectedItemsAt public method}
				//jmacSEL tagged items	

				if (!this.context.binding)
				{
					this._instance._isSimpleBinding = true;				//jmacSEL
					this.context.binding = bpmext.ui.substituteObject(
						this, 
						"binding", 
						"value", 
						new com.ibm.bpm.coach.List([], "selected.items")
						);
				}
				else													// jmacSEL
				{
					this._instance._isSimpleBinding = false;
					var boundType = this.context.bindingType().toUpperCase();
					var boundTypeIsList = false;
					if ( bpmext.text.endsWith(boundType,"[]") )
					{	
						boundType = boundType.substr(0,boundType.length - 2);
						boundTypeIsList = true;
					}
					if ( (boundType == "STRING") || (boundType == "INTEGER") || (boundType == "DECIMAL") || (boundType == "BOOLEAN") )
						this._instance._isSimpleBinding = true;
					else
					{
						if (opts.businessDataMapping)
						{
							var dm = opts.businessDataMapping.get("value");
							this._instance._busValProp = (dm.optionValueProperty ? dm.optionValueProperty : "name" );
							this._instance._busDisProp = (dm.optionDisplayProperty ? dm.optionDisplayProperty : "value");
						}
						else
						{
							this._instance._busValProp = "name";
							this._instance._busDisProp = "value";							
						}
					}
					if (!boundTypeIsList){
						//{#feature: US-1330 Added RT localization}
						//throw new Error("A 'bound' Multi Select must be bound to a list");	
						throw new Error(bpmext.localization.formatMsg("controlMultiSelect", "MULTISELECT_ERROR"));	
					}
				}
				
				if (!this.context.binding)
				{
					this.context.binding = bpmext.ui.substituteObject(
						this, 
						"binding", 
						"value", 
						new com.ibm.bpm.coach.List([], "selected.items")
						);
				}

				if (!opts.tabIndex)
					bpmext.ui.substituteConfigOption(this, "tabIndex", null);

				if (!opts.staticList)
					bpmext.ui.substituteConfigOption(this, "staticList", []);

				if (!opts.sizeStyle)
					bpmext.ui.substituteConfigOption(this, "sizeStyle", "D");

				if (!opts.colorStyle)
					bpmext.ui.substituteConfigOption(this, "colorStyle", "D");
					
				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);
					
				if(!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");

				if(!opts.labelWidth)
					bpmext.ui.substituteConfigOption(this, "labelWidth", null);

				if (!opts.itemLookupMode)
					bpmext.ui.substituteConfigOption(this, "itemLookupMode", "E");

				if (!opts.inputData)
					bpmext.ui.substituteConfigOption(this, "inputData", null);

				if (!opts.disableAutoCall)
					bpmext.ui.substituteConfigOption(this, "disableAutoCall", false);
				
				if (opts.dataMapping)
				{
					var dm = opts.dataMapping.get("value");
					this._instance._optValProp = dm.optionValueProperty;
					this._instance._optDisProp = dm.optionDisplayProperty;
				}
				
				if (!opts.showValidationMarker)
					bpmext.ui.substituteConfigOption(this, "showValidationMarker", false);

				if (opts.showValidationMarker.get("value") === true) {
					domClass.add(this.context.element, "showValidation");
				}

				var lookupMode = opts.itemLookupMode.get("value");	
				
				if(this._instance._optValProp == null || lookupMode == "L")
					this._instance._optValProp = "name";
				
				if(this._instance._optDisProp == null || lookupMode == "L")
					this._instance._optDisProp = "value";
				
				this._instance.group = document.createElement("div");
				domClass.add(this._instance.group, "form-group");

				this._instance.select = document.createElement("select");
				domAttr.set(this._instance.select, "id", "multiselect-" + this.context.controlidpath);
				domAttr.set(this._instance.select, "aria-labelledby", this._instance.select.id);
				domAttr.set(this._instance.select, "multiple", "true");
				domAttr.set(this._instance.select, "aria-multiselectable", "true");
				domClass.add(this._instance.select, "form-control");
				
				this._instance.input = document.createElement("div");
				domClass.add(this._instance.input, "input");
				
				this._instance.group.appendChild(this._instance.input);

				this._instance.input.appendChild(this._instance.select);
				this._instance.group.appendChild(this._instance.input);
				this.context.element.appendChild(this._instance.group);
				
				bpmext.ui.loadView(this);
				this._instance.vc = bpmext.ui.getNearestValidationContainer(this);

				this._proto._setSizeStyle(this, opts.sizeStyle.get("value"));
				this._proto._setWidth(this, opts.width.get("value"));
				
				//BG-1000 moving setLabel above setLabelVisibility
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelVisibility(this, opts._metadata.labelVisibility.get("value"));
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				
				//this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));		
				this._proto._setTabIndex(this, opts.tabIndex.get("value"));
				
				var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}

				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGE);


				var view = this;
				
				if(opts[this._proto.EVT_ONFOCUS])
				{
					this._instance.select.onfocus = function(event) {
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONFOCUS);
					}

					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONFOCUS);
				} 

				if(opts[this._proto.EVT_ONBLUR])
				{
					this._instance.select.onblur = function(event) {
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONBLUR);
					}

					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONBLUR);
				}
				
				this._instance.select.onchange = function(event)
				{
					var visibility = utilities.handleVisibility(view.context);
                    if (visibility === "READONLY") {
                        return;
                    }
					
					var i;
					var selOpts = [];
					view._instance.sidxs = [];

					for(i = 0; i < this.options.length; i++)
					{
						if(this.options[i].selected)
						{
							selOpts.push(view._instance.itemList.items[i]);
							view._instance.sidxs.push(i);

							domClass.add(this.options[i], "selected");
							domAttr.set(this.options[i], "aria-selected", "true");
						} else {
							domClass.remove(this.options[i], "selected");
							domAttr.set(this.options[i], "aria-selected", "false");
						}
					}

					// jmacSEL 						
					//view.context.binding.set("value", view._proto._mapBindingValues(view, selOpts));
					view._instance._stopSetItem = true;
					try
					{
						if (view._instance._isSimpleBinding)
						{
							view.context.binding.set("value", view._proto._mapBindingValues(view, selOpts));
						}
						else
						{
							var mySelectedArray =  [ ];
							for (var i = 0; i < selOpts.length; i++)
							{

								var myObj = {};
								myObj[view._instance._busValProp] = selOpts[i][view._instance._optValProp];
								myObj[view._instance._busDisProp] = selOpts[i][view._instance._optDisProp];
								mySelectedArray.push(myObj);
							}
							view.context.binding.set("value", mySelectedArray);
						}

						if(lookupMode == "B" && opts.itemList && !view.isBound())
						{
							var l = opts.itemList.get("value");
							l.set("listAllSelectedIndices", view._instance.sidxs);
						}
					}
					finally
					{
						delete view._instance._stopSetItem;
					}

				};
				if(lookupMode == "S" && opts.itemService) //S = Lookup from AJAX Service
				{
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSVCITEMS);
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSVCERROR);
					
					this.reloadServiceItems();
				}
				else if(lookupMode == "L") //Static list
				{
					view._instance.itemList = opts.staticList.get("value");
					if(!view._instance.itemList)
						view._instance.itemList = new com.ibm.bpm.coach.List([], "static.items");

					this._proto._loadListItems(this, view._instance.itemList, this.context.binding.get("value"));
				}
				else if(lookupMode == "B")
				{
					if(!opts.itemList)
						bpmext.ui.substituteConfigOption(this, "itemList", []);						
					
					view._instance.itemList = opts.itemList.get("value");
					if(!view._instance.itemList)
						//view._instance.itemList = new ItemList(this, function(){return view.context.binding.get("value")}, false);	
						view._instance.itemList = new com.ibm.bpm.coach.List([], "list.items");
					
					this._proto._loadListItems(this, view._instance.itemList, this.context.binding.get("value"), this._instance._optValProp, this._instance._optDisProp);
				}
				else //lookupMode == "E"
				{
					//{#bug: BG-398 Fire service load-related events when starting empty}
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSVCITEMS);
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSVCERROR);

					view._instance.itemList = view._instance.itemList = new com.ibm.bpm.coach.List([], "list2.items");
					this._proto._loadListItems(this, view._instance.itemList, this.context.binding.get("value"), this._instance._optValProp, this._instance._optDisProp);
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.label":
						{
							this._proto._setLabel(this, event.newVal);
							this._proto._setHelpText(this, this.context.options._metadata.helpText.get("value"));
							break;
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.labelVisibility":
						{
							this._proto._setLabelVisibility(this, event.newVal);
							break;
						}
						case "_metadata.helpText":
						{
							this._proto._setHelpText(this, event.newVal);
                            this._proto._updateControl(this);
                            break;
						}
						case "tabIndex":
						{
							this._proto._setTabIndex(this, event.newVal);
							break;
						}
						case "sizeStyle":
						{
							this._proto._setSizeStyle(this, event.newVal);
							break;
						}
						case "labelPlacement":
						{
							this._proto._setLabelPlacement(this, event.newVal);
							break;
						}
						case "labelWidth":
						{
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}
						case "itemList":
						{
							this._instance.itemList = event.newVal;
							this._proto._updateItemList(this, event, this._instance.itemList);
							break;
						}
                        case "width":
                        {
                            this._proto._setWidth(this, event.newVal);
                            break;
                        }
						case "inputData":
						{
							if (this.context.options.disableAutoCall.get("value")) {
								// The view is configured to disable automatic calling of the service
								break;
							}
							if(event.newVal != event.oldVal) {
								this.reloadServiceItems(event.newVal);
								if(this.context.binding.get("value")) {
									this.context.binding.set("value", []);
								}
							}
							break;
						}
					}
				}
				else
				{
  
					if(!this._instance._stopSetItem)									// jmacSEL
					{
						this._proto._setSelectedItems(this, event.newVal);
					}
					
					if(event.newVal != event.oldVal)
						bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE);
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.validate = function (event)
		{
			try
			{
				bpmext.ui.updateViewValidationState(this, event);

				this._proto._updateControl(this);
				
				if(this._instance.vc)
					this._instance.vc.validate(event);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on validate event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}		
		};

		/*
		this.constructor.prototype.collaboration = function (event)
		{
		};
		*/
		
		this.constructor.prototype.unload = function ()
		{
			if(this._instance._bindSelUpdHandle)
				this._instance._bindSelUpdHandle.unbind();

			if(this._instance._bindValueUpdHandle)
				this._instance._bindValueUpdHandle.unbind();

			bpmext.ui.unloadView(this);
		};
	}
};

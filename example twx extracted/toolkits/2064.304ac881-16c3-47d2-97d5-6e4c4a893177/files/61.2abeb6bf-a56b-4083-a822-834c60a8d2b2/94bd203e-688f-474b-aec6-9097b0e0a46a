/**
 * @constructor Panel
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table>
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setWidth(${Table1}.getWidth())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Icon Click:</td>
 *     <td colspan="2">
 *       <table>
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the panel icon is clicked.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setColorStyle(me.getColorStyle() == "S" ? "G" : "S")</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitPanel = function (utilities, bpmext, domClass, domAttr, domConstruct)
{
    this._instance =
    {
    };

    if (!this.constructor.prototype._proto)
    {
        this.constructor.prototype.IS_ADDRESS_INVISIBLE = true;
        this.constructor.prototype._proto =
        {
            EVT_ONICONCLICK : "eventON_ICONCLICK",
            /* {#feature: Added support for primary color style for panels} */
            //{#feature: * Allow for both E and G for Danger color style}
            OPTS_COL_CLZ : {
                "D" : "",
                "P" : "panel-primary",
                "I" : "panel-info",
                "S" : "panel-success",
                "W" : "panel-warning",
                "E" : "panel-danger",
                "G" : "panel-danger",
                "T" : "panel-transparent"
            },
            _normalizeColorStyle: function(style)
            {
                if(!style)
                    style = "D";

                style = style.toUpperCase();

                if(style == "E")
                    style = "G";

                if(style.length > 1)
                {
                    switch (style)
                    {
                        case "DEFAULT":
                        case "DEF":
                            style = "D";
                            break;
                        case "PRI":
                        case "PRIMARY":
                            style = "P";
                            break;
                        case "SUCCESS":
                            style = "S";
                            break;
                        case "INFO":
                        case "INF":
                            style = "I";
                            break;
                        case "WARNING":
                        case "WARN":
                            style = "W";
                            break;
                        case "DANGER":
                            style = "G";
                            break;
                        case "TRANSPARENT":
                            style = "T";
                            break;
                        default:
                            //{#feature: US-1330 Added RT localization}
                            //bpmext.log.warn("Unexpected color style: " + style);
                            bpmext.log.warn(bpmext.localization.formatMsg("general", "COLOR_STYLE_WARNING",style));
                    }
                }

                return style;
            },
            _setColorStyle : function (view, newVal, oldVal){
                if(!oldVal)
                    oldVal = view._instance.oldColStyle;

                newVal = this._normalizeColorStyle(newVal);
                oldVal = this._normalizeColorStyle(oldVal);

                bpmext.ui.util.replaceCSSClass(view._instance.panel, this.OPTS_COL_CLZ, newVal, oldVal);
                view._instance.oldColStyle = newVal;
            },
            _setLightColor : function (view)
            {
                var fn = view.context.options.lightColor.get("value") ? domClass.remove : domClass.add;

                fn(view._instance.panel, "panel-dark");
            },
            _setFullBodyColor : function (view)
            {
                var fn = view.context.options.colorfulBody.get("value") ? domClass.add : domClass.remove;

                fn(view._instance.panel, "panel-body-colorful");
            },
            _setIcon : function (view)
            {
                var icon = view.context.options.icon.get("value");
                
                domConstruct.empty(view._instance.iconWrap);
                if (icon != null) {
                    icon = icon.trim().toLowerCase();
                    domAttr.set(view._instance.iconWrap, "aria-label", icon.replace("fa-", "").replace("ci-", ""));
                    if (bpmext.text.startsWith(icon, "ci-")) {
                        var svgElement = utilities.getCarbonIcon(icon);
                        svgElement && domConstruct.place(svgElement, view._instance.iconWrap, "first");
                    } else {
                        icon = bpmext.text.startsWith(icon, "fa-") ? icon : "fa-" + icon;
                        domConstruct.place(domConstruct.create("i", {class: "fa " + icon}), view._instance.iconWrap);
                    }
                } else {
                	domAttr.remove(view._instance.iconWrap, "aria-label");
                }

                if (view._instance.iconClickFn != null) {
                	domClass.add(view._instance.iconWrap, "clickable");
                    domAttr.set(view._instance.iconWrap, "tabindex", "0");
                    domAttr.set(view._instance.iconWrap, "role", "button");
                    
                    view._instance.iconWrap.onclick = view._instance.iconClickFn;
                    view._instance.iconWrap.onkeypress = view._instance.iconKeyPressFn;
                } else {
                	domClass.remove(view._instance.iconWrap, "clickable");
                    domAttr.remove(view._instance.iconWrap, "tabindex");
                    domAttr.remove(view._instance.iconWrap, "role");
                    
                    view._instance.iconWrap.onclick = null;
                    view._instance.iconWrap.onkeypress = null;
                }
                
                if (icon != null || view._instance.iconClickFn != null){
                	domClass.remove(view._instance.iconWrap, "hide");
                } else {
                	domClass.add(view._instance.iconWrap, "hide");
                }
            },
            _setWidth : function (view, width)
            {
                try
                {
                    if (width != null && width != "")
                    {
                        if (!isNaN(width))
                            width += "px";

                        view.context.element.style.width = width;
                    }
                }
                catch (e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("Panel._setWidth() error: " + e);
                    bpmext.log.error("Panel._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setHeight : function (view, height)
            {
                try
                {
                    if (height != null && height != "")
                    {
                        if (!isNaN(height))
                            height += "px";

                        view._instance.panelBody.style.height = height;
                        domClass.add(view.context.element, "heightSpec");
                    }
                    else
                    {
                        //{#bug: * Reset panel height if height not specified}
                        view._instance.panelBody.style.height = "";
                        domClass.remove(view.context.element, "heightSpec");
                    }
                }
                catch (e)
                {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("Panel._setHeight() error: " + e);
                    bpmext.log.error("Panel._setHeight() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if(e.stack) {
                        //{#feature: US-1330 Added RT localization}
                        //bpmext.log.error("  Call stack: " + e.stack);
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                    }
                }
            },
            _setTitle : function (view)
            {
                var labelViz = view.context.options._metadata.labelVisibility.get("value");
                var label = labelViz == "HIDE" ? null : view.context.options._metadata.label.get("value");

                view._instance.title.innerHTML = ((label != null && label != "") ? view.context.htmlEscape(label) : "&nbsp;");
                utilities.BiDi.applyTextDir(
                    view._instance.title.parentElement,
                    view._instance.title.textContent,
                    view._instance.baseTxtDir,
                    view._instance.genPrefTextDir
                    );
            },
            _setFooterContent : function (view)
            {
                var content = view.context.options.footerText.get("value");
                if(content == null || content == "")
                    domClass.add(view._instance.footer, "hidden");
                else
                {
                    domClass.remove(view._instance.footer, "hidden");
                    if(!view._instance.footerIsHTML)
                        content = view.context.htmlEscape(content);

                    view._instance.footer.innerHTML = content;
                    utilities.BiDi.applyTextDir(
                        view._instance.footer,
                        view._instance.footer.innerHTML,
                        view._instance.baseTxtDir,
                        view._instance.genPrefTextDir
                        );
                }
            },
            _getFooterElement : function(view)
            {
                var res = null;

                do
                {
                    var elts1 = view.context.element.children;

                    if(elts1 == null || elts1.length != 1)
                        break;

                    var elt1 = elts1[0];
                    var elts2 = elt1.children;

                    if(elts2 == null || elts2.length != 3)
                        break;

                    var elt2 = elts2[2];

                    if(!/\bpanel-footer\b/i.test(elt2.className))
                        break;

                    res = elt2;
                }
                while(false);

                if(res == null)
                    res = view.context.element.querySelector("#" + view.context.element.getAttribute("id") + "_Footer");

                return res;
            },
            _setHelpText: function(view, text){
                utilities.setHelpText(view, text);
            }
        };


        /*
        Public control methods *************************************************************
         */

        /**
         * @instance
         * @memberof Panel
         * @method setWidth
         * @param {string} width Section width
         * @desc Set width of section (e.g. 50px, 20%, 2em - omitting the unit assumes px)
         */
        this.constructor.prototype.setWidth = function (width)
        {
            this.context.options.width.set("value", width);
		};

        /**
         * @instance
         * @memberof Panel
         * @method getWidth
         * @desc Get configured width for section (including unit)
         * @returns {string}
         */
        this.constructor.prototype.getWidth = function ()
        {
            return this.context.options.width.get("value");
		};

        /**
         * @instance
         * @memberof Panel
         * @method setTitle
         * @param {string} title Section title
         * @desc Set title of section
         */
        this.constructor.prototype.setTitle = function (title)
        {
            this.context.options._metadata.label.set("value", title);
		};

        /**
         * @instance
         * @memberof Panel
         * @method getTitle
         * @desc Get title for section
         * @returns {string}
         */
        this.constructor.prototype.getTitle = function (title)
        {
            return this.context.options._metadata.label.get("value");
		};

        /**
         * @instance
         * @memberof Panel
         * @method setIcon
		 * @param {string} icon See {@link http://fontawesome.io/icons Font Awesome} for a comprehensive list of icons. Refer to the knowledge center for the latest Font Awesome version.
         * @desc Set section icon
         */
        this.constructor.prototype.setIcon = function (icon)
        {
            this.context.options.icon.set("value", icon);
		};

        /**
         * @instance
         * @memberof Panel
         * @method getIcon
         * @desc Get icon keyword for section
         * @returns {string}
         */
        this.constructor.prototype.getIcon = function ()
        {
            return this.context.options.icon.get("value");
		};

		/**
		 * @instance
		 * @memberof Panel
		 * @method getColorStyle
		 * @desc Get the color style of the panel.
		 */
		this.constructor.prototype.getColorStyle = function ()
		{
			return this.context.options.colorStyle.get("value");
		};

        /**
         * @instance
         * @memberof Panel
         * @method setColorStyle
         * @param {string} style "DEFAULT"|"DEF"|"D"=Default | "PRIMARY"|"P"=Primary | "INFO"|INF"|"I"=Info | "SUCCESS"|"S"=Success | "WARNING"|"WARN"|"W"=Warning | "DANGER"|"G"=Danger | "TRANSPARENT"|"T"=Transparent
         * @desc Sets color style of section.  NOTE: to avoid ambiguity always set the color using "D"|"P"|"I"|"S"|"W"|"G"|"T"
         */
        this.constructor.prototype.setColorStyle = function (style)
        {
            this.context.options.colorStyle.set("value", style);
		};

        /**
         * @instance
         * @memberof Panel
         * @method setLightColor
         * @param {boolean} flag {true | false}
         * @desc Sets whether light color styles are used
         */
        this.constructor.prototype.setLightColor = function (flag)
        {
            this.context.options.lightColor.set("value", flag);
		};

        /**
         * @instance
         * @memberof Panel
         * @method isLightColor
         * @desc Gets whether or not light colors are enabled
         * @returns {boolean}
         */
        this.constructor.prototype.isLightColor = function ()
        {
            return this.context.options.lightColor.get("value");
		};

        /**
         * @instance
         * @memberof Panel
         * @method setFullBodyColor
         * @param {boolean} flag {true | false}
         * @desc Sets whether or not the section color fills the section or just the title bar
         */
        this.constructor.prototype.setFullBodyColor = function (flag)
        {
            this.context.options.colorfulBody.set("value", flag);
		};

        /**
         * @instance
         * @memberof Panel
         * @method isFullBodyColor
         * @desc Gets whether or not full body color is enabled
         * @returns {boolean}
         */
        this.constructor.prototype.isFullBodyColor = function ()
        {
            return this.context.options.colorfulBody.get("value");
		};

        /**
         * @instance
         * @memberof Panel
         * @method setFooter
         * @param {string} content The content of the footer
         * @param {boolean} htmlFlag {true | false} set to true if footer includes html, false otherwise
         * @desc Sets whether or not the section color fills the section or just the title bar
         */
        this.constructor.prototype.setFooter = function (content, htmlFlag)
        {
            this._instance.footerIsHTML = htmlFlag;
            this.context.options.footerText.set("value", content);
		};

        /**
         * @instance
         * @memberof Panel
         * @method getFooter
         * @desc Gets the content of the footer
         * @returns {boolean}
         */
        this.constructor.prototype.getFooter = function ()
        {
            return this.context.options.footerText.get("value");
		};

        /**
         * @instance
         * @memberof Panel
         * @method getType
         * @desc Get descriptive string representing the type of control
         * @returns {string}
         */
        this.constructor.prototype.getType = function ()
        {
            return "panel.3";
        };
        
        /**
		 * @instance
		 * @memberof Panel
		 * @method setHelpText
		 * @param {string} helptext Help text for the control
		 * @desc Set help text for Table control
		 */
		this.constructor.prototype.setHelpText = function (text) {
			this.context.options._metadata.helpText.set("value", text);
		};

		/**
		 * @instance
		 * @memberof Panel
		 * @method getHelpText
		 * @desc Get help text associated with Table control
		 * @returns {string}
		 */
		this.constructor.prototype.getHelpText = function () {
			return this.context.options._metadata.helpText.get("value");
		};



        /*
        Coach NG Lifecycle methods *************************************************************
         */
        this.constructor.prototype.load = function ()
        {
            try
            {
                bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONICONCLICK);

                var opts = this.context.options;
                var mdt = opts._metadata;

                this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
                this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;

                if (!opts.width)
                    bpmext.ui.substituteConfigOption(this, "width", ""); //"100%"

                if (!opts.height)
                    bpmext.ui.substituteConfigOption(this, "height", "");

                if (!opts.colorStyle)
                    bpmext.ui.substituteConfigOption(this, "colorStyle", "D");

                if (!opts.lightColor)
                    bpmext.ui.substituteConfigOption(this, "lightColor", false);

                if (!opts.colorfulBody)
                    bpmext.ui.substituteConfigOption(this, "colorfulBody", false);

                if (!opts.icon)
                    bpmext.ui.substituteConfigOption(this, "icon", null);

                if (!opts.footerText)
                    bpmext.ui.substituteConfigOption(this, "footerText", null);

                domClass.add(this.context.element, "panel-group");

                var panelHeading = this.context.element.querySelector(".panel-heading");
                //{#bug: 379 set white-space for panels to "normal" to workaround apparent firefox display bug}
                panelHeading.style.whiteSpace = "normal";
                this._instance.panelBody = this.context.element.querySelector(".panel-body");

                this._instance.panel = this.context.element.querySelector(".SPARKPanel.panel");
                this._instance.title = this.context.element.querySelector(".panel-title");
                this._instance.iconWrap = this.context.element.querySelector(".panel-heading-icon");

                var view = this;
                /* US-1237 : STARTS */
                domAttr.set(panelHeading, "role", "heading");
                domAttr.set(panelHeading, "aria-level", "1");
                /* US-1237 : ENDS */

                if(opts[this._proto.EVT_ONICONCLICK] != null)
                {
                    this._instance.iconClickFn = function() {
                        bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONICONCLICK)
                    };
                    this._instance.iconKeyPressFn = function(evt) {
                        if(evt.key === "Enter" || evt.key === " " || evt.key === "Spacebar") {
                            bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONICONCLICK);
                        }
                    }
                }

                //{#bug: 381 Panel footer in nested panels bug}
                //{#bug: * Panel footer element not found if panel repeating}
                //this._instance.footer = this.context.element.querySelector("#" + this.context.element.getAttribute("id") + "_Footer");
                this._instance.footer = this._proto._getFooterElement(this);

                this._proto._setTitle(this);
                this._proto._setIcon(this);
                this._proto._setColorStyle(this, opts.colorStyle.get("value"));
                this._proto._setLightColor(this);
                this._proto._setFullBodyColor(this);
                this._proto._setWidth(this, opts.width.get("value"));
                this._proto._setHeight(this, opts.height.get("value"));
                this._proto._setFooterContent(this);

                var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0) {
					this._proto._setHelpText(this, tmp);
				}

                //{#feature: * Enabling Panel header with formula support}
                bpmext.ui.setupFormulaTriggeredUpdates(
                    this,
                    function (expResult)
                    {
                        if (expResult == undefined)
                        {
                            expResult = "";
                        }

                        view.setTitle(expResult);
                    },
                    this.getTitle
                );

                bpmext.ui.loadContainer(this);
                /* US-1237 : STARTS */
                var label = this.context.options._metadata.label.get("value");
                if(label != null && label != ""){
                    var lblId = "pnlHdr-lbl-" + view.getUID();
                    domAttr.set(view._instance.title, "id", lblId);
                    domAttr.set(panelHeading, "aria-labelledby", lblId);
                }
                /* US-1237 : ENDS */

                if(this._instance.headerView)
                    this._instance.headerView._proto._init(this._instance.headerView);

                if(this._instance.footerView)
                    this._instance.footerView._proto._init(this._instance.footerView);
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
                if(e.stack) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.view = function ()
        {
            try
            {
				var visibility = utilities.handleVisibility(this.context, null, null, null, null, false);
                this._proto._setTitle(this);
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if(e.stack) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        this.constructor.prototype.change = function (event)
        {
            try
            {
                if (event.type == "config")
                {
                    switch (event.property)
                    {
                    case "_metadata.labelVisibility":
                        {
                            this.view();
                            break;
                        }
                    case "_metadata.visibility":
                        {
                            this.view();
                            break;
                        }
                    case "_metadata.label":
                        {
                        this._proto._setTitle(this);
                        //BG-1244 added missing break statement
                        break;
                        }
                    case "_metadata.helpText":
                        {
                            this._proto._setHelpText(this, event.newVal);
                            break;
                        }    
                    case "width":
                        {
                            this._proto._setWidth(this, event.newVal);
                            break;
                        }
                    case "height":
                        {
                            this._proto._setHeight(this, event.newVal);
                            break;
                        }
                    case "colorStyle":
                        {
                            this._proto._setColorStyle(this, event.newVal, event.oldVal);
                            break;
                        }
                    case "lightColor":
                        {
                            this._proto._setLightColor(this);
                            break;
                        }
                    case "colorfulBody":
                        {
                            this._proto._setFullBodyColor(this);
                            break;
                        }
                    case "icon":
                        {
                            this._proto._setIcon(this);
                            break;
                        }
                    case "footerText":
                        {
                            this._proto._setFooterContent(this);
                            break;
                        }
                    }
                }
            }
            catch (e)
            {
                //{#feature: US-1330 Added RT localization}
                //bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if(e.stack) {
                    //{#feature: US-1330 Added RT localization}
                    //bpmext.log.error("  Call stack: " + e.stack);
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            }
        };

        /*
        this.constructor.prototype.validate = function (event)
        {};

        this.constructor.prototype.collaboration = function (event)
        {};
        */

        this.constructor.prototype.unload = function ()
        {
            bpmext.ui.unloadContainer(this);
        };
    }
};

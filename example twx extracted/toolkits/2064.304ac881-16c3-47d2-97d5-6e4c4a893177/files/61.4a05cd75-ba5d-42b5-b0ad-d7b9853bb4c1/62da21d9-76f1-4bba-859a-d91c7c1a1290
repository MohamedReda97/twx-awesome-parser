		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function () {
			try {
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefTextDir = this.context.bpm.system.baseTextDirection;

				if (!this.context.binding)
					this.context.binding = bpmext.ui.substituteObject(this, null, null, "");

				if (!opts.tabIndex)
					bpmext.ui.substituteConfigOption(this, "tabIndex", null);

				if (!opts.placeHolder)
					bpmext.ui.substituteConfigOption(this, "placeHolder", null);

				if (!opts.colorStyle)
					bpmext.ui.substituteConfigOption(this, "colorStyle", "D");

				if (!opts.sizeStyle)
					bpmext.ui.substituteConfigOption(this, "sizeStyle", "D");

				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if (!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");

				if(!opts.labelWidth)
					bpmext.ui.substituteConfigOption(this, "labelWidth", null);
				
				if (!opts.regExp)
					bpmext.ui.substituteConfigOption(this, "regExp", null);

				if (!opts.selectAll)
					bpmext.ui.substituteConfigOption(this, "selectAll", false);

				if(!opts.showOverflowTooltip)
					bpmext.ui.substituteConfigOption(this, "showOverflowTooltip", false);

				domClass.add(this.context.element, "SPARKText");
				this._instance.group = document.createElement("div");
				domClass.add(this._instance.group, "form-group");
				this._instance.input = document.createElement("div");
				domClass.add(this._instance.input, "input");

				this._instance.text = document.createElement("input");
				domClass.add(this._instance.text, "form-control");
				domAttr.set(this._instance.text, "id", "text-input-" + this.context.controlidpath);
				domAttr.set(this._instance.text, "type", password ? "password" : "text");
				
				this._instance.input.appendChild(this._instance.text);
				this._instance.group.appendChild(this._instance.input);
				this.context.element.appendChild(this._instance.group);

				var view = this;
				//Enabling control with formula support
				bpmext.ui.setupFormulaTriggeredUpdates(
					this,
					function (expResult) {
					if (expResult == undefined) {
						expResult = "";
					}

					view.setText(expResult);
				},
					this.getText);

				bpmext.ui.loadView(this);

				this._instance.vc = bpmext.ui.getNearestValidationContainer(this);

				this._proto._setSizeStyle(this, opts.sizeStyle.get("value"));
				this._proto._setLabelVisibility(this, opts._metadata.labelVisibility.get("value"));
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));
				this._proto._setPlaceholder(this, opts.placeHolder.get("value"));
				this._proto._setWidth(this, opts.width.get("value"));
				if (this._proto._setText(this, this.context.binding.get("value")))
					this._proto._updateControl(this);

				var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}

				
				this._proto._setTabIndex(this, opts.tabIndex.get("value"));

				if (opts[this._proto.EVT_ONCHANGE]) {
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGE, "newText", "oldText");
				}

				this._instance.text.onchange = function (event) {
					if (view._proto._checkContentValid(view)) {
						view.context.binding.set("value", this.value);
					} else {
					    view._instance.text.value = view.context.binding.get("value");
					}
				};

				if (opts[this._proto.EVT_ONFOCUS]) {
					this._instance.text.onfocus = function (event) {
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONFOCUS);

						if (view.context.options.selectAll.get("value"))
							setTimeout(function () {
								view._instance.text.select();
	                        }, 250);	
					};

					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONFOCUS);
				} else {
					this._instance.text.onfocus = function () {
						if (view.context.options.selectAll.get("value"))
							setTimeout(function () {
								view._instance.text.select();
	                        }, 250);	
					};
				}

				//Defect#304047 - On IE pressing ENTER does not fire change event
				var ie = utilities.isIE();

				if (ie || opts[this._proto.EVT_ONBLUR]) {
					this._instance.text.onblur = function (event) {
						var contentChange = (this.value !== view.context.binding.get("value"))
						
						if (ie && contentChange)
						view._instance.text.onchange();

						if (opts[view._proto.EVT_ONBLUR])
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONBLUR);
					};

					if (opts[this._proto.EVT_ONBLUR])
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONBLUR);
				}

				//BG-1016 preserving view reference
				var view = this;
				
				if (opts[this._proto.EVT_ONINPUT]) {
					var onInput = opts[this._proto.EVT_ONINPUT] != null;
					var text1 = this._instance.text;
					//var view = this;
					var sel;
					//BG-1016 accessing state variable as member of instance
					view._instance.state.current = text1.value;
					view._instance.state.potential = void(0);
					
					/*var state = {
						current : text1.value,
						potential : void 0
					};*/

					var redo;
					var undo;

					this._instance.text.onkeydown = function (event) {
						redo = false;
						undo = false;

						if (event.key === "z" && event.ctrlKey) //Ctrl-Z
						{
							redo = true;
							//BG-1016 accessing state variable as member of instance
							view._instance.state.current = text1.value;
							//state.current = text1.value;
							sel.start = 0;
							sel.end = 0;
							setTimeout(function () {
								//BG-1016 accessing state variable as member of instance
								view._proto._handleInput(view, onInput, text1, view._instance.state, sel, "undo");
								//view._proto._handleInput(view, onInput, text1, state, sel, "undo");
							});
						} else if (event.key === "y" && event.ctrlKey) //Ctrl-Y
						{
							undo = true;
							//BG-1016 accessing state variable as member of instance
							view._instance.state.current = text1.value;
							//state.current = text1.value;
							sel.start = 0;
							sel.end = 0;

							setTimeout(function () {
								//BG-1016 accessing state variable as member of instance
								view._proto._handleInput(view, onInput, text1, view._instance.state, sel, "redo");
								//view._proto._handleInput(view, onInput, text1, state, sel, "redo");
							});
						} else if (ie && event.key === "Enter") { //Defect#304047 - On IE pressing ENTER does not fire change event
							view._instance.text.onchange();
						} else {
							sel = view._proto._getSelection(text1);
						}
					};

					this._instance.text.oninput = function (event) {
						if (redo || undo)
							return;

						//BG-1016 accessing state variable as member of instance
						view._instance.state.potential = text1.value;
						
						if (view._instance.state.current != view._instance.state.potential) {
							view._proto._handleInput(view, onInput, text1, view._instance.state, sel, "change");
						}

						view._instance.state.potential = null;
						
						/*state.potential = text1.value;

						if (state.current != state.potential) {
							view._proto._handleInput(view, onInput, text1, state, sel, "change");
						}

						state.potential = null;*/
					};

					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONINPUT, "current", "potential", "selection", "type");
				} else if (ie) { //Need to listen for the ENTER key on IE to fire the change event regardless of Bob specifying code in the ONINPUT event.
					this._instance.text.onkeydown = function (event) {
						if (event.key === "Enter") { //Defect#315175 - On IE pressing ENTER does not fire change event
							view._instance.text.onchange();
						}
					};
				}

				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSCLICK);
			} catch (e) {
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if (e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function () {
			try {
				this._proto._handleVisibility(this);
			} catch (e) {
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if (e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event) {
			try {
				if (event.type == "config") {
					switch (event.property) {
					case "_metadata.label": {
							this._proto._setLabel(this, event.newVal);
							this._proto._setHelpText(this, this.context.options._metadata.helpText.get("value"));
							break;
						}
					case "_metadata.visibility": {
							this._proto._handleVisibility(this);
							break;
						}
					case "_metadata.labelVisibility": {
							this._proto._setLabelVisibility(this, event.newVal);
							break;
						}
					case "_metadata.helpText": {
						this._proto._setHelpText(this, event.newVal);
						this._proto._updateControl(this);
						break;
					}
					case "width": {
							this._proto._setWidth(this, event.newVal);
							break;
						}
					case "sizeStyle": {
							this._proto._setSizeStyle(this, event.newVal, event.oldVal);
							break;
						}
					case "showStatus": {
							this._proto._setStatusVisible(this, event.newVal);
							break;
						}
					case "tabIndex": {
							this._proto._setTabIndex(this, event.newVal);
							break;
						}
					case "placeHolder": {
							this._proto._setPlaceholder(this, event.newVal);
							break;
						}
					case "regExp": {
							this._proto._checkContentValid(this);
							break;
						}
					case "labelPlacement": {
							this._proto._setLabelPlacement(this, event.newVal);
							break;
						}
					case "labelWidth": {
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}
					}
				} else if (event.insertedInto == event.removedFrom) {
					this._proto._setText(this, event.newVal);

					if (event.newVal != event.oldVal)
						bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE, event.newVal, event.oldVal);

					//{#feature: * Enabled Text control to participate in (more specifically originate) formula-driven updates}
					bpmext.ui.broadcastExpressionTrigger(this, bpmext.ui.PHASE_NORMAL);
				}
			} catch (e) {
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if (e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.validate = function (event) {
			try {
				bpmext.ui.updateViewValidationState(this, event);

				this._proto._updateControl(this);
				if (this._instance.vc)
					this._instance.vc.validate(event);
			} catch (e) {
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on validate event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if (e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		/*
		this.constructor.prototype.collaboration = function (event){
		};
		 */

		this.constructor.prototype.unload = function () {
			if (this._instance.overFlowtextTT) {
				bpmext.ui.util.closeTooltip(this._instance.overFlowtextTT, this._instance.input);
				delete this._instance.overFlowtextTT;
			}
			bpmext.ui.unloadView(this);
		};
	}

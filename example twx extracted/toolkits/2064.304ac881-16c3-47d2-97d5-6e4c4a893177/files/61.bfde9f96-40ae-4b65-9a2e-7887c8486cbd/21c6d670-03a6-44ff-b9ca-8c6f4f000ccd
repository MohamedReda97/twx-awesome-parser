 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the QRCode is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.setQRCode("www.salientprocess.com")<code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Change:</td>
 *	   <td colspan = "2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>This event is fired when the QRCode is changed.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${Text1}.setText(oldQRCode); ${Text2}.setText(newQRCode);<code></pre></td>
 *         </tr>
 *       </table>
 *       <table style= "border: 1px solid black; border-collapse: collapse; ">
 *         <tr  style= "border: 1px solid black; border-collapse: collapse;">
 *           <th   style= "border: 1px solid black; border-collapse: collapse;padding: 5px;">Context Variables</th>
 *           <th   style="border: 1px solid black; border-collapse: collapse; padding: 5px;">newQRCode {string}</th>
 *           <th   style="border: 1px solid black; border-collapse: collapse; padding: 5px;">oldQRCode {string}</th>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitQRCode = function (bpmext, utilities, domClass, domAttr, domConstruct, qrCode)
{
	this._instance = {};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto =
		{
			EVT_ONCHANGE : "eventON_CHANGE",
			OPTS_ERROR_CORRECTION_LEVEL :
			{
				"L" : 1,
				"M" : 2,
				"Q" : 3,
				"H" : 4,
			},
			_setQRCodeText : function (view, text)
			{
				try
				{
					if(text == null)
						text = "";

					view._instance.qrCodeControl.setText(text);
					view._instance.qrCodeControl.update(text)
					// return this._checkContentValid(view);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("QRCode._setQRCodeText() error: " + e);
					bpmext.log.error("QRCode._setQRCodeText() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_getLabelElt : function (view)
			{
				if(!view._instance.label)
					this._createLabel(view);
				
				return view._instance.label;
			},
			_createLabel : function (view)
			{
				//Replaced label with span for US-692 : TK-1690 : STARTS
				view._instance.label = document.createElement("span");				
				//US-692 : TK-1690 : ENDS
				
				domClass.add(view._instance.label, "control-label");
				domConstruct.place(view._instance.label, view._instance.group, "first");
				//Removed for US-692 : TK-1690 : STARTS
				//domAttr.set(view._instance.label, "for", view._instance.group.id);
				//US-692 : TK-1690 : ENDS
				
				//Added for US-692 : TK-1690 : STARTS
				var lblId="lbl_"+bpmext.ui.makeUniqueId("");
				domAttr.set(view._instance.label,"id",lblId);
				
				domAttr.set(view._instance.canvasDiv.firstChild, "aria-labelledby", lblId);
				
				var spanEl = document.createElement("span");
				domClass.add(spanEl, "sr-only");
				var spanId="qrc_"+bpmext.ui.makeUniqueId("");
				domAttr.set(spanEl,"id",spanId);
				//spanEl.innerHTML = view.context.htmlEscape(view.context.options._metadata.label.get("value"));
				//{#feature: US-1330 Added RT localization}
				//spanEl.innerHTML = "QR Code";
				spanEl.innerHTML = bpmext.localization.formatMsg("controlQRCode", "QRCODE_CONTROL");
				domAttr.set(view._instance.canvasDiv.firstChild, "aria-describedby", spanId);
				domConstruct.place(spanEl, view._instance.label, "after");
				//US-692 : TK-1690 : ENDS
			},
			_setLabelVisibility : function (view, flag)
			{
				try
				{
					if(!view._instance.label)
						this._createLabel(view);

					view.context.setDisplay(flag == "SHOW", view._instance.label);
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("QRCode._setLabelVisibility() error: " + e);
					bpmext.log.error("QRCode._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabel : function (view, label)
			{
				try
				{
					if(label)
					{
						if(!view._instance.label)
							this._createLabel(view);

						view._instance.label.innerHTML = view.context.htmlEscape(label);
						utilities.BiDi.applyTextDir(
							view._instance.label, 
							view._instance.label.innerHTML, 
							view._instance.baseTxtDir, 
							view._instance.genPrefQRCodeDir
							);
					}
					else
					{
						if(view._instance.label)
						{
							view._instance.group.removeChild(view._instance.label);
							delete view._instance.label;
						}
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("QRCode._setLabel() error: " + e);
					bpmext.log.error("QRCode._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setLabelPlacement : function (view, newVal, oldVal)
			{
				if(!oldVal)
					oldVal = view._instance.oldLblPlc;
				
				newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				oldVal = bpmext.ui.util.normalizeLabelPlacement(oldVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);
				
				bpmext.ui.util.replaceCSSClass(view._instance.group, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
				view._instance.oldLblPlc = newVal;
			},
			
            _setLabelWidth : function (view, labelWidth)
			{
				if(labelWidth != null && labelWidth != "")
				{
					if(!isNaN(labelWidth))
						labelWidth += "px";
					
					view._instance.label.style.width = labelWidth;
					domClass.add(view.context.element, "labelWidth");
				}
				else 
				{
					if (view._instance.label) {
						view._instance.label.style.width = null;
					}
					
					domClass.remove(view.context.element, "labelWidth");
				}
					
			},

			_setWidth : function (view, width)
			{
				try
				{
					if (width != null)
					{
                        if (isNaN(width)) {
                            width = getComputedStyle(view.context.element).width;
                            width = width.substring(0, width.length - 2);
                            width = Number(width);
                        }
                        
						view._instance.qrCodeControl.setWidth(width);
						view._instance.qrCodeControl.update();
						domClass.add(view.context.element, "widthSet");
					}
					else 
					{
						// use default width when the width is undefined
						view._instance.qrCodeControl.setWidth(100);
						view._instance.qrCodeControl.update();

						domClass.remove(view.context.element, "widthSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("QRCode._setWidth() error: " + e);
					bpmext.log.error("QRCode._setWidth() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setHeight : function (view, height)
			{
				try
				{
					if (height != null)
					{
                        if (isNaN(height)) {
                            height = getComputedStyle(view.context.element).height;
                            height = height.substring(0, height.length - 2);
                            height = Number(height);
                        }
                        
						view._instance.qrCodeControl.setHeight(height);
						view._instance.qrCodeControl.update();
						domClass.add(view.context.element, "heightSet");
					}
					else 
					{
						// use default height when the height is undefined
						view._instance.qrCodeControl.setHeight(100);
						view._instance.qrCodeControl.update();

						domClass.remove(view.context.element, "heightSet");
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("QRCode._setHeight() error: " + e);
					bpmext.log.error("QRCode._setHeight() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setBackgroundImageURL : function (view, url)
			{
				try
				{
					if (url != null || url != undefined)
					{
						view._instance.qrCodeControl.setBackgroundImageURL(url);
						view._instance.qrCodeControl.update();
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("QRCode._setBackgroundImageURL() error: " + e);
					bpmext.log.error("QRCode._setBackgroundImageURL() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_setErrorCorrectionLevel : function (view, level)
			{
				try
				{
					if (level != null || level != undefined)
					{
						view._instance.qrCodeControl.setECCLevel(view._proto.OPTS_ERROR_CORRECTION_LEVEL[level]);
						view._instance.qrCodeControl.update();
					}
				}
				catch (e)
				{
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("QRCode._setErrorCorrectionLevel() error: " + e);
					bpmext.log.error("QRCode._setErrorCorrectionLevel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
					if(e.stack) { 
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("  Call stack: " + e.stack);
						bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
					}
				}
			},
			_handleVisibility : function (view)
			{
				var vis = utilities.handleVisibility(view.context);
				
				if (vis != "NONE"){
					view._instance.group.disabled = (vis == "READONLY");
					view._instance.required = (vis == "REQUIRED");
				}
			},
			_setHelpText : function(view, text){
				utilities.setHelpText(view, text);
			}
		};

		/*
		Public control methods *************************************************************
		 */
		 
		/**
		 * @instance
		 * @memberof QRCode
		 * @method setLabel
		 * @param {string} label the label of the control
		 * @desc Set label for QRCode control
		 */
		this.constructor.prototype.setLabel = function (QRCode)
		{
			this.context.options._metadata.label.set("value", QRCode);
		};

		/**
		 * @instance
		 * @memberof QRCode
		 * @method getLabel
		 * @desc Get label associated with QRCode control
		 * @returns {string}
		 */
		this.constructor.prototype.getLabel = function ()
		{
			return this.context.options._metadata.label.get("value");
		}
		
		/**
		 * @instance
		 * @memberof QRCode
		 * @method setHelpText
		 * @param {string} helptext Help text for the control
		 * @desc Set help text for QRCode control
		 */
		this.constructor.prototype.setHelpText = function (text)
		{
			this.context.options._metadata.helpText.set("value", text);
		};

		/**
		 * @instance
		 * @memberof QRCode
		 * @method getHelpText
		 * @desc Get help text associated with QRCode control
		 * @returns {string}
		 */
		this.constructor.prototype.getHelpText = function ()
		{
			return this.context.options._metadata.helpText.get("value");
		};

		/**
		 * @instance
		 * @memberof QRCode
		 * @method setLabelPlacement
		 * @param {string} placement "T"|"TOP"=Top | "L"|"LEFT"=Left
		 * @desc Set label placement for control.  NOTE: to avoid ambiguity always set the label placement using "T"|"L"
		 */
		this.constructor.prototype.setLabelPlacement = function (plc)
		{
			this.context.options.labelPlacement.set("value", plc);
		};

		/**
		 * @instance
		 * @memberof QRCode
		 * @method getLabelPlacement
		 * @desc Get label placement for control.  NOTE: This always returns the label placement as set, to avoid ambiguity always set the label placement using "T"|"L"
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelPlacement = function ()
		{
			return this.context.options.labelPlacement.get("value");
		}

		/**
		 * @instance
		 * @memberof QRCode
		 * @method getLabelWidth
		 * @desc Get label width of QRCode control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 * @returns {string}
		 */
		this.constructor.prototype.getLabelWidth = function ()
		{
			return this.context.options.labelWidth.get("value");
		};
		
		/**
		 * @instance
		 * @memberof QRCode
		 * @method setLabelWidth
		 * @param {string} labelWidth Control's label width
		 * @desc Set label width of QRCode control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setLabelWidth = function (labelWidth)
		{
			this.context.options.labelWidth.set("value", labelWidth);
		};

		/**
		 * @instance
		 * @memberof QRCode
		 * @method isLabelVisible
		 * @desc Get label visibility for QRCode control
		 * @returns {boolean}
		 */
		this.constructor.prototype.isLabelVisible = function ()
		{
			return this.context.options._metadata.labelVisibility.get("value") == "SHOW";
		}

		/**
		 * @instance
		 * @memberof QRCode
		 * @method setLabelVisible
		 * @param {boolean} flag the visibility of the label
		 * @desc Set label visibility for QRCode control
		 */
		this.constructor.prototype.setLabelVisible = function (flag)
		{
			this.context.options._metadata.labelVisibility.set("value", flag ? "SHOW" : "HIDE");
		};		
		
		/**
		 * @instance
		 * @memberof QRCode
		 * @method getQRCode
		 * @desc Get QRCode for QRCode control
		 * @returns {string} Returns the associated text/url
		 */
		this.constructor.prototype.getQRCode = function ()
		{
			var res = this.context.binding.get("value");
			return res == null ? "" : res;
		}

		/**
		 * @instance
		 * @memberof QRCode
		 * @method setQRCode
		 * @param {string} QRCode the QRCode text
		 * @desc Set QRCode for QRCode control
		 */
		this.constructor.prototype.setQRCode = function (QRCode)
		{
			this.context.binding.set("value", QRCode);
		}

		/**
		 * @instance
		 * @memberof QRCode
		 * @method setWidth
		 * @param {string} width the width of the control
		 * @desc Set width of QRCode control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setWidth = function (width)
		{
			this.context.options.width.set("value", width);
		}

		/**
		 * @instance
		 * @memberof QRCode
		 * @method setHeight
		 * @param {string} height the height of the control
		 * @desc Set height of QRCode control (e.g. 50px, 20%, 2em - omitting the unit assumes px)
		 */
		this.constructor.prototype.setHeight = function (height)
		{
			this.context.options.height.set("value", height);
		}
		
		/**
		 * @instance
		 * @memberof QRCode
		 * @method getWidth
		 * @desc Get configured width for QRCode control (including unit)
		 * @returns {string} Returns the width of the control
		 */	
		this.constructor.prototype.getWidth = function ()
		{
			return this.context.options.width.get("value");
		}

		/**
		 * @instance
		 * @memberof QRCode
		 * @method setBackgroundImageURL
		 * @param {string} height backgroundImageURL
		 * @desc Set backgroundImageURL of QRCode control
		 */
		this.constructor.prototype.setBackgroundImageURL = function (height)
		{
			this.context.options.backgroundImageURL.set("value", height);
		}
		
		/**
		 * @instance
		 * @memberof QRCode
		 * @method getBackgroundImageURL
		 * @desc Get configured backgroundImageURL for QRCode control
		 * @returns {string} Returns the URL text associated with the background image
		 */	
		this.constructor.prototype.getBackgroundImageURL = function ()
		{
			return this.context.options.backgroundImageURL.get("value");
		}
		
		/**
		* @instance
		 * @memberof QRCode
		 * @method setErrorCorrectionLevel
		 * @param {string} level "L"=Level L | "M"="Level M | "Q"=Level Q | "H"=Level H
		 * @desc Set errorCorrectionLevel of QRCode control
		 */
		this.constructor.prototype.setErrorCorrectionLevel = function (level)
		{
			this.context.options.errorCorrectionLevel.set("value", level);
		}
		
		/**
		 * @instance
		 * @memberof QRCode
		 * @method getErrorCorrectionLevel
		 * @desc Get configured errorCorrectionLevel for QRCode control
		 * @returns {string} Returns the error correction level
		 */	
		this.constructor.prototype.getErrorCorrectionLevel = function ()
		{
			return this.context.options.errorCorrectionLevel.get("value");
		}
		
		/**
		 * @instance
		 * @memberof QRCode
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "QRCode.3";
		}

		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				window.thiz = this;
				var opts = this.context.options;
				var mdt = opts._metadata;

				this._instance.baseTxtDir = mdt.baseTextDirection && mdt.baseTextDirection.get("value") ? mdt.baseTextDirection.get("value") : utilities.BiDi.BASE_TEXT_DIRECTION._default;
				this._instance.genPrefMaskedTextDir = this.context.bpm.system.baseTextDirection;
				
				if (!this.context.binding){
					this.context.binding = bpmext.ui.substituteObject(this, null, null, undefined);
				}
					
				if (!opts.width)
					bpmext.ui.substituteConfigOption(this, "width", null);

				if (!opts.height)
					bpmext.ui.substituteConfigOption(this, "height", null);
					
				if(!opts.labelPlacement)
					bpmext.ui.substituteConfigOption(this, "labelPlacement", "T");

				if(!opts.labelWidth)
					bpmext.ui.substituteConfigOption(this, "labelWidth", null);

				if(!opts.backgroundImageURL)
					bpmext.ui.substituteConfigOption(this, "backgroundImageURL", "");
					
				if (!opts.errorCorrectionLevel)
					bpmext.ui.substituteConfigOption(this, "errorCorrectionLevel", "L");
					
				this._instance.group = document.createElement("div");
				domClass.add(this._instance.group, "form-group");
				this._instance.canvasDiv = document.createElement("div");
				domClass.add(this._instance.canvasDiv, "input");								
				
				this._instance.group.appendChild(this._instance.canvasDiv);
				this.context.element.appendChild(this._instance.group);

				this._instance.qrCodeControl = new qrCode({}, this._instance.canvasDiv);
				
				//Added for US-692 : TK-1690 : STARTS
				domAttr.set(this._instance.canvasDiv.firstChild, "role", "img");
				//{#feature: US-1330 Added RT localization}
				//domAttr.set(this._instance.canvasDiv.firstChild, "alt", "QR Code");				
				domAttr.set(this._instance.canvasDiv.firstChild, "alt", bpmext.localization.formatMsg("controlQRCode", "QRCODE_CONTROL"));	
				//US-692 : TK-1690 : ENDS
				
				var view = this;
				
				bpmext.ui.setupFormulaTriggeredUpdates(
					this, 
					function (expResult)
					{
						if (expResult == undefined)
						{
							expResult = "";
						}

						view.setQRCode(expResult);
					},
					this.getQRCode
				);
				
				bpmext.ui.loadView(this);

				this._proto._setLabelVisibility(this, opts._metadata.labelVisibility.get("value"));
				this._proto._setLabelPlacement(this, opts.labelPlacement.get("value"));
				this._proto._setLabel(this, opts._metadata.label.get("value"));
				this._proto._setLabelWidth(this, opts.labelWidth.get("value"));				
				this._proto._setWidth(this, opts.width.get("value"));
				this._proto._setHeight(this, opts.height.get("value"));
				this._proto._setErrorCorrectionLevel(this, opts.errorCorrectionLevel.get("value"));
				this._proto._setQRCodeText(this, this.context.binding.get("value"));
				// if(this._proto._setQRCodeText(this, this.context.binding.get("value")))
					// this._proto._updateControl(this);

				var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
				}
								
				if(opts[this._proto.EVT_ONCHANGE])
				{
					bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONCHANGE, "newQRCode", "oldQRCode");
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.label":
						{
							this._proto._setLabel(this, event.newVal);
							this._proto._setHelpText(this, this.context.options._metadata.helpText.get("value"));
							break;
						}
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.labelVisibility":
						{
							this._proto._setLabelVisibility(this, event.newVal);
							break;
						}
						case "_metadata.helpText":
						{
							this._proto._setHelpText(this, event.newVal);
                            break;
						}
						case "_metadata.helpQRCode":
						{
							this._proto._updateControl(this);
							break;
						}
						case "width":
						{
							this._proto._setWidth(this, event.newVal);
							break;
						}
						case "height":
						{
							this._proto._setHeight(this, event.newVal);
							break;
						}
						case "labelPlacement":
						{
							this._proto._setLabelPlacement(this, event.newVal);
							break;
						}
						case "labelWidth":
						{
							this._proto._setLabelWidth(this, event.newVal);
							break;
						}				
						case "backgroundImageURL":
						{
							this._proto._setBackgroundImageURL(this, event.newVal);
							break;
						}					
						case "errorCorrectionLevel":
						{
							this._proto._setErrorCorrectionLevel(this, event.newVal);
							break;
						}
					}
				}
				else if(event.insertedInto == event.removedFrom)
				{
					this._proto._setQRCodeText(this, event.newVal);
					
					if(event.newVal != event.oldVal)
						bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE, event.newVal, event.oldVal);
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.validate = function (event)
		{
			try
			{
				bpmext.ui.updateViewValidationState(this, event);

				this._proto._updateControl(this);
				if(this._instance.vc)
					this._instance.vc.validate(event);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on validate event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}			
		};

		/*
		this.constructor.prototype.collaboration = function (event)
		{
		};
		*/
		
		this.constructor.prototype.unload = function ()
		{
			//BG-946 commenting out methods that are no longer supported
			//this._instance.qrCodeControl.destroy();
			//dojo.destroy(this._instance.label);
			//dojo.destroy(this._instance.canvasDiv);
			//dojo.destroy(this._instance.group);
			
			this._instance.label = null;
			this._instance.canvasDiv = null;
			this._instance.group = null;
			
			bpmext.ui.unloadView(this);
		};
	}
}

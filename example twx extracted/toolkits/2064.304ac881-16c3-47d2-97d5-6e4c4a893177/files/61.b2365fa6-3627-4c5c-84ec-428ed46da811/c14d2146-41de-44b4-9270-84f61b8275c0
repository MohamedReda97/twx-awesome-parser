var mixObject = {
	createPreview:function(containingDiv, noteText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			bpmext.uidesign.css.ensureGeneralStylesLoaded(this);
			
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");
			
			this.context.coachViewData.noteWrapper = domConstruct.create("div");
			domClass.add(this.context.coachViewData.noteWrapper, "note ");

			this.context.coachViewData.noteLabel = domConstruct.create("h4");
			this.context.coachViewData.labelTextDom = document.createTextNode(noteText);
			this.context.coachViewData.noteLabel.appendChild(this.context.coachViewData.labelTextDom);

			domClass.add(this.context.coachViewData.noteLabel, "note-title");
			
			this.context.coachViewData.noteText = domConstruct.create("p");
			
			this.context.coachViewData.expression = null;
			this.context.coachViewData.binding = null;
			
			this.context.coachViewData.noteWrapper.appendChild(this.context.coachViewData.noteLabel);
			this.context.coachViewData.noteWrapper.appendChild(this.context.coachViewData.noteText);
			
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.noteWrapper);

			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, this.context.coachViewData.noteLabel, undefined, false, false);
			
			callback();
		}));	
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.noteLabel;
	},
	propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "width"){
				this.width = propertyValue;
				if(!!propertyValue) {
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName == "expression"){
				this.context.coachViewData.expression = propertyValue;
				this.updateTextField();
			}
			else if(propertyName == "colorStyle"){
				var colorStyle;
				if(propertyValue == "P"){
					colorStyle = "note-primary";
				} else if(propertyValue == "I"){
					colorStyle = "note-info";
				} else if(propertyValue == "S"){
					colorStyle = "note-success";
				} else if(propertyValue == "W"){
					colorStyle = "note-warning";
				} else if(propertyValue == "G"){
					colorStyle = "note-danger";
				} else {
					colorStyle = "";
				}
				domClass.replace(this.context.coachViewData.noteWrapper, colorStyle, "note-primary note-info note-success note-warning note-danger note-transparent");
			} 
			else if(propertyName == "labelStyle"){
				var p = this.context.coachViewData.noteLabel.parentNode;
				var newLbl ;
				if(propertyValue == "H1"){
					newLbl = document.createElement("h1");
				} else if(propertyValue == "H2"){
					newLbl = document.createElement("h2");
				} else if(propertyValue == "H3"){
					newLbl = document.createElement("h3");
				} else {
					newLbl = document.createElement("h4");
				}
				this.context.coachViewData.labelTextDom = document.createTextNode("");
				newLbl.appendChild(this.context.coachViewData.labelTextDom);
				p.replaceChild(newLbl, this.context.coachViewData.noteLabel);
				this.context.coachViewData.noteLabel = newLbl;
				this.context.coachViewData.labelHandler.setLabelDomElements(this.context.coachViewData.labelTextDom, newLbl);
				domClass.add(this.context.coachViewData.noteLabel, "note-title");
			}
		}));	
    },
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
		if(propertyName=="@binding"){
			this.context.coachViewData.binding = propertyValue;
			this.updateTextField();
		}
	},
	
	updateTextField:function(){
		//if expression is set, it overrides binding
		if(this.context.coachViewData.expression!=null && this.context.coachViewData.expression!=undefined && this.context.coachViewData.expression!=""){
			this.context.coachViewData.noteText.innerHTML = this.context.coachViewData.expression;
		} else if(this.context.coachViewData.binding && this.context.coachViewData.binding!=""){
			//now check binding
			this.context.coachViewData.noteText.innerHTML = this.context.coachViewData.binding;
		} else{
			//if nothing is set, clear
			this.context.coachViewData.noteText.innerHTML = "";
		}
	}
};

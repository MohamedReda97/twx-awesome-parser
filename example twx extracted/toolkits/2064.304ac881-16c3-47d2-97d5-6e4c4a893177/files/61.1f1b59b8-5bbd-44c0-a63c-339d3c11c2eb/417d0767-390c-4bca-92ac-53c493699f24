bpmext_control_InitResponsiveSensor = function (bpmext, domClass, domAttr, ResizeSensor)
{
	this._instance = 
	{
		listeners: [],
		listenerMap: {}
	};

	if (!this.constructor.prototype._proto)
	{
		this.constructor.prototype.IS_ADDRESS_INVISIBLE = true;

		var addResizeListener = function (element, fn)
		{
			element.__rs = new ResizeSensor(element, fn);
		};

		var removeResizeListener = function (element, fn)
		{
			if(element.__rs)
			{
				element.__rs.detach(element);
				delete element.__rs;
			}
		}		

		var insertInOrder = function (element, array) 
		{
		  array.splice(arrayIdxOf(element, array) + 1, 0, element);
		  return array;
		}
		
		var arrayIdxOf = function (element, array, start, end) 
		{
		  start = start || 0;
		  end = end || array.length;
		  
		  var pivot = parseInt(start + (end - start) / 2, 10);
		  
		  if (end-start <= 1 || array[pivot] === element) 
			return pivot;
		  
		  if (array[pivot] < element)
			return arrayIdxOf(element, array, pivot, end);
		  else
			return arrayIdxOf(element, array, start, pivot);
		}	
		
		var getBoundaries = function(metric, milestones)
		{
			var idx = arrayIdxOf(metric, milestones);
			return [milestones[idx], milestones[idx+1]];
		}
		
		var _bfMonitor = function(element)
		{
			this.element = element;
		};
		
		_bfMonitor.prototype.MAX_WIDTH = '+';
		
		_bfMonitor.prototype.start = function(view, milestones, callbackFn, showSize)
		{
			if(this.started)
				this.stop();
			
			this.callbackFn = callbackFn;
			
			if(showSize && !view._instance.sizeIndElt)
			{
				view._instance.sizeIndElt = document.createElement("div");
				domClass.add(view._instance.sizeIndElt, "widthIndicator");

				var cb = bpmext.ui.util.getContentBox(view);
				cb.appendChild(view._instance.sizeIndElt);
			}
			
			var elt = this.element;
			var b0 = null;
			var _this = this;
			this._fn = function(e, force){
				var width = elt.offsetWidth;
				if(view._instance.sizeIndElt)
				{
					view._instance.sizeIndElt.innerHTML = "Width: " + width + "px";
				}
				
				if((_this.paused || !bpmext.ui.isResponsive()) && !force)
					return;
				
				var b = getBoundaries(width, milestones);
				//ED: force added into condition to trigger callback on layout refresh
				if(force || (!b0 || b0[0] != b[0]))
				{	
					//setTimeout(function(){callBackFn(width, b)});
					callbackFn(width, b);
					b0 = b;
				}
			};
			
			this._fn();
			addResizeListener(elt, this._fn);
			//addResizeListener(elt, this._fn, this);
			
			this.started = true;
		}
		
		_bfMonitor.prototype.isStarted = function()
		{
			return this.started;
		}

		_bfMonitor.prototype.stop = function()
		{
			removeResizeListener(this.element, this.callbackFn, this);
			this.started = false;
		}
		
		_bfMonitor.prototype.tickle = function()
		{
			this._fn({}, true);
		}

		_bfMonitor.prototype.pause = function()
		{
			this.paused = true;
		}
		
		_bfMonitor.prototype.resume = function()
		{
			this.paused = false;
			this.tickle();
		}
		
		this.constructor.prototype._proto =
		{
			EVT_ONBOUNDARY : "eventON_BOUNDARY",
			_lastTopics : {},
			_bfMonitor : _bfMonitor,
			_deIndexViewRef : function(viewRef)
			{
				return viewRef.replace(/\[[\d]+\]/mg, "");
			},
			_setBoxFactors : function(view, boxFactors)
			{
				view._instance._bfMon = new _bfMonitor(view.context.element);

				var bfMap = {};
				var milestones = [0];
				var maxBoundAdded = false;
				
				for(var i = 0; i < boxFactors.items.length; i++)
				{
					var bf = boxFactors.items[i];
					if(!bf.widthUpTo)
					{
						bf.widthUpTo = view._instance._bfMon.MAX_WIDTH;
						maxBoundAdded = true;
					}

					milestones.push(bf.widthUpTo);
					bfMap[milestones[i]] = bf.name;
				}
				if(!maxBoundAdded)
				{
					milestones.push(view._instance._bfMon.MAX_WIDTH);
					bfMap[milestones[milestones.length - 2]] = "+";
				}

				view._instance._bfMon.start(view, milestones, function(width, boundaries)
					{
						var boxFactor = bfMap[boundaries[0]];

						/*
						if(view._instance._bfMon._lastBf == boxFactor)
						{
							if(bpmext.log.isDebugging)
								bpmext.log.debug("SENSOR [" + view.ui.getAbsoluteName() + "]: Box factor=" + boxFactor +" already applied. Skipping notification");
						
							return;
						}
						
						view._instance._bfMon._lastBf = boxFactor;
						*/
						
						for(var i = 0; i < view._instance.listeners.length; i++)
						{
							var listener = view._instance.listeners[i];
							var fn = listener.callback;
							
							if(bpmext.log.isDebugging)
								bpmext.log.debug("SENSOR [" + view.ui.getAbsoluteName() + "]: Box factor=" + boxFactor +"; Width=" + width + "; slice=[" + boundaries[0] + ", " + boundaries[1] + "]; listener=" + listener.id);
							
							fn(
								{
									"boxFactor": boxFactor, 
									"lowerBound": boundaries[0],
									"upperBound": boundaries[1],
									"width": width
								}
							);
						}
					},
					bpmext.log.isDebugging
				);				
			},
			_handleVisibility : function (view)
			{
				var visibility = bpmext.ui.getEffectiveVisibility(view);
				
				view.context.setDisplay(visibility != "NONE");
				view.context.setVisibility(visibility != "HIDDEN");
				
				//{#bug: BG-896 Responsive Sensor doesn't work when first hidden with display:none}
				if (visibility != "NONE")
				{
					this._init(view);
				}
			},
			_init: function(view)
			{
				//{#bug: 395 Moved logic to initialize box factors to the view() stage to ensure DOM elements are already created when the Box Sensor attaches its sensor divs}
				if(view._instance.__initializing)
				{
					view._proto._setBoxFactors(view, view.context.options.boxFactors.get("value"));
					delete view._instance.__initializing;
				}
			}
		};
		
		this.constructor.prototype.addListener = function(listenerId, callback)
		{
			if(this._instance.listenerMap[listenerId] == null)
			{
				this._instance.listenerMap[listenerId] = this._instance.listeners.length;
				this._instance.listeners.push({"id": listenerId, "callback": callback});
			}
		}
		
		this.constructor.prototype.removeListener = function(listenerId)
		{
			var idx = this._instance.listenerMap[listenerId];
			if(idx != null)
			{
				this._instance.listeners.splice(idx, 1);
				delete this._instance.listenerMap[listenerId];
				//fix indexes to ensure that both lists are in synch
				for (var x in this._instance.listenerMap) {
				    if (!isNaN(this._instance.listenerMap[x]) && this._instance.listenerMap[x] > idx) {
				        this._instance.listenerMap[x] = this._instance.listenerMap[x]-1;
				    }
				}
				
			}
		}
		
		/*
		Public control methods *************************************************************
		 */

		//{# feature: * Added getActiveBoxFactor() method to retrieve the name of the currently active box factor}
		/**
		 * @instance
		 * @memberof ResponsiveSensor
		 * @method getActiveBoxFactor
		 * @desc Returns the active box factor based on the current sensor width and how the width maps to the box factors configured.
		 * @return {string} The box factor name
		 */
		this.constructor.prototype.getActiveBoxFactor = function()
		{
			if(this._instance._sensorInfo != null)
				return this._instance._sensorInfo.boxFactor;
			else
				return "+";
		}
		
		/**
		 * @instance
		 * @memberof ResponsiveSensor
		 * @method getType
		 * @desc Get descriptive string representing the type of control
		 * @returns {string}
		 */
		this.constructor.prototype.getType = function ()
		{
			return "responsiveSensor.3";
		}
		
		/**
		 * @instance
		 * @memberof ResponsiveSensor
		 * @method pause
		 * @desc Pauses responsive behavior
		 */
		this.constructor.prototype.pause = function()
		{
			if(bpmext.log.isDebugging)
				bpmext.log.debug("SENSOR [" + this.ui.getAbsoluteName() + "]: Responsive behavior paused", this);

			this._instance._bfMon.pause();
		}
		
		/**
		 * @instance
		 * @memberof ResponsiveSensor
		 * @method resume
		 * @desc Resumes responsive behavior
		 */
		this.constructor.prototype.resume = function()
		{
			if(bpmext.log.isDebugging)
				bpmext.log.debug("SENSOR [" + this.ui.getAbsoluteName() + "]: Responsive behavior resumed", this);

			this._instance._bfMon.resume();
		}
		
		/**
		 * @instance
		 * @memberof ResponsiveSensor
		 * @method refreshLayout
		 * @desc Forces the layout to refresh (even if layout is paused)
		 */
		this.constructor.prototype.refreshLayout = function()
		{
		    if (this._instance._bfMon) {
	            this._instance._bfMon.tickle();
		    } else {
		        var _this = this;
		        setTimeout(function() {
		            if (_this._instance._bfMon) {
		                _this._instance._bfMon.tickle();
		            }       
		        },50);
		    }
		}
		
		/*
		Coach NG Lifecycle methods *************************************************************
		 */
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				var mdt = opts._metadata;
				
				//Event support - for example, support the onclick event
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONBOUNDARY, "event");
				//Note: Later in the logic of this control, the event can be triggered through:
				//  bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONBOUNDARY);

				if(!opts.boxFactors)
					bpmext.ui.substituteConfigOption(this, "boxFactors", {"items":[]});
				
				bpmext.ui.loadContainer(this);

				var view = this;
				this.addListener(this._proto.EVT_ONBOUNDARY, function(sensorInfo)
					{
						setTimeout(function(){
							view._instance._sensorInfo = sensorInfo;
							
							bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONBOUNDARY, sensorInfo);
						});
					});

				this._instance.__initializing = true;
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.view = function ()
		{
			try
			{
				this._proto._handleVisibility(this);
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on view event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch (event.property)
					{
						case "_metadata.visibility":
						{
							this._proto._handleVisibility(this);
							break;
						}
						case "_metadata.helpText":
						{
							this._proto._setHelpText(this, event.newVal);
							break;
						}
						case "boxFactors":
						{
							this._proto._setBoxFactors(this, event.newVal);
							break;
						}
					}
				}
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};

		this.constructor.prototype.validate = function (event)
		{};

		this.constructor.prototype.collaboration = function (event)
		{};

		this.constructor.prototype.unload = function ()
		{
			//Deregister this Coach View instance from SPARK
			bpmext.ui.unloadContainer(this);
		};
	}
}

            _getFormat: function(view) {
                var fmt,
                    format = view.context.options.format.get("value"),
                    datePattern,
                    timePattern,
                    bundle = view._instance.dateBundle;

                if (format === 'short' || format === 'medium' || format === 'long' || format === 'full') {
                    fmt = datePattern = bundle["dateFormat-" + format];
                    timePattern = bundle["timeFormat-" + format];

                    //Convert to full year
                    if (datePattern.search("yyyy") == -1) {
                        if (datePattern.search("yy") > -1) {
                            fmt = datePattern = datePattern.replace("yy", "yyyy");
                        }
                    }

                    if (view.context.options.includeTimePicker.get("value")) {
                        fmt = bundle["dateTimeFormat-" + format].replace(/\{(\d+)\}/g, function(match, key) {
                            return [timePattern, datePattern][key];
                        });
                    }

                    return fmt;
                } else {
                    return format;
                }

 *         </tr>
 *       </table> 
 *     </td>
 *   </tr>
 * </table>
 */
bpmext_control_InitBPMDatePicker = function(utilities, bpmext, dom, domClass, domStyle, query, domAttr, domConstruct, baseWindow, win, domGeometry, bpmdatepicker, has, stamp, i18n) {
    this._instance = {
        /* {#feature: 349 Added validation to make sure dates entered adhere to correct formatting requested in TKT 349} */
        dateType: "unset", // TKT 349
        dateIsValid: true, // TKT 349
        loadEHIsRunning: true,
        validateEHIsRunning: true,
        onChangeHandleRunning: false,
        dateBundle: null
    };

    if (!this.constructor.prototype._proto) {
        this.constructor.prototype._proto = {
            OPTS_FORMAT: {
                canonical: "yyyy-MM-dd",
                default: "short"
            },
            OPTS_TYPE: {
                "TI": "TI",
                "I": "I"
            },
            OPTS_ORIENTATION: {
                "A": "auto",
                "TA": "top auto",
                "BA": "bottom auto",
                "AL": "auto left",
                "TL": "top left",
                "BL": "bottom left",
                "AR": "auto right",
                "TR": "top right",
                "BR": "bottom right",
            },
            OPTS_WEEK_DAYS_ARRAY: [
                "Sunday",
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday"
            ],
            OPTS_COL_STLZ: {
                "D": "",
                // "P": "dp-primary",
                "I": "dp-info",
                "S": "dp-success",
                "W": "dp-warning",
                "G": "dp-danger",
                "E": "dp-danger"
            },
            EVT_ONLOAD: "eventON_LOAD",
            EVT_ONCHANGE: "eventON_CHANGE",
            EVT_ONINPUT: "eventON_INPUT",
            EVT_ONFOCUS: "eventON_FOCUS",
            EVT_ONBLUR: "eventON_BLUR",
            EVT_ONBEFORESHOWDAY: "eventON_BEFORE_SHOW_DAY",
            _setHelpText: function (view, text) {
                utilities.setHelpText(view, text);
            },
            _getLabelElt: function(view) {
                if (!view._instance.label)
                    this._createLabel(view);

                return view._instance.label;
            },
            _createLabel: function(view) {
                view._instance.label = document.createElement("span");
                view._instance.hiddenLabel = document.createElement("span");
                domClass.add(view._instance.label, "control-label");
                domConstruct.place(view._instance.label, view._instance.formgroupDiv, "first");
                domAttr.set(view._instance.label, "id", view.context.element.id + '_label');

                domConstruct.place(view._instance.hiddenLabel, view._instance.formgroupDiv, "first");
                domAttr.set(view._instance.hiddenLabel, "aria-hidden", "true");
                domAttr.set(view._instance.hiddenLabel, "id", view.context.element.id + '_hidden-label');
                view._instance.hiddenLabel.style.display = "none";
                view._instance.hiddenLabel.innerText = bpmext.localization.formatMsg("controlDatePicker", "ENTER_POPUP_DESCRIPTION");
            },
            _setLabelVisibility: function(view, flag) {
                try {
                    if (!view._instance.label)
                        this._createLabel(view);

                    view.context.setDisplay(flag == "SHOW", view._instance.label);
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setLabelVisibility() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setLabel: function(view, label) {
                try {
                    if (label) {
                        if (!view._instance.label)
                            this._createLabel(view);

                        view._instance.label.innerHTML = view.context.htmlEscape(label);
                        utilities.BiDi.applyTextDir(
                            view._instance.label,
                            view._instance.label.innerHTML,
                            view._instance.baseTxtDir,
                            view._instance.genPrefTextDir);
                    } else {
                        if (view._instance.label) {
                            view._instance.label.parentNode.removeChild(view._instance.label);
                            delete view._instance.label;
                        }
                    }
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setLabel() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setPlaceholder: function(view, text) {
                try {
                    if (text)
                        domAttr.set(view._instance.pickerElement, "placeholder", text);
                    else
                        domAttr.remove(view._instance.pickerElement, "placeholder");
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setPlaceholder() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setLabelPlacement: function(view, newVal, oldVal) {
                newVal = bpmext.ui.util.normalizeLabelPlacement(newVal, bpmext.ui.util.OPTS_LBL_PLC_CLZ);

                if (!oldVal)
                    oldVal = view._instance.oldLblPlc;

                bpmext.ui.util.replaceCSSClass(view._instance.formgroupDiv, bpmext.ui.util.OPTS_LBL_PLC_CLZ, newVal, oldVal);
                view._instance.oldLblPlc = newVal;
            },
            _setPrevNextBtnIcon: function (view) {
                if (utilities.getActiveTheme() !== '"CARBON"') {
					return;
                }

				var replaceIcon = function(querySelector, iconName) {
					var list = view._instance.pickerControl.picker.querySelectorAll(querySelector);
					if (!!list && list.length > 0) {
                    	for (var i = 0; i<list.length; i++) {
                            domAttr.set(list[i].parentElement.parentElement, "scope", "row");
                    		var target = list[i];
                    		var icon = utilities.getCarbonIcon(iconName);
                    		
                        	domConstruct.empty(target);
                        	domAttr.set(target, "class", "ci " + iconName);
                        	domConstruct.place(icon, target)
                    	}
                	}
				}
				
				replaceIcon(".prev-btn > i", "ci-chevron-left");
				replaceIcon(".next-btn > i", "ci-chevron-right");
            },
            _setLabelWidth: function(view, labelWidth) {
                if (labelWidth != null && labelWidth != "") {
                    if (!isNaN(labelWidth))
                        labelWidth += "px";

                    view._instance.label.style.width = labelWidth;
                    domClass.add(view.context.element, "labelWidth");
                } else {
                    if (view._instance.label) {
						view._instance.label.style.width = null;
                    }
                    
                    domClass.remove(view.context.element, "labelWidth");
                }

            },
            _setYearSelectorStyle: function(view, style) {
                if (view._instance.pickerControl) {
                	view._instance.pickerControl.setYearSelectorStyle(style);
                }
            },
            _handleVisibility: function(view) {
                var visibility = utilities.handleVisibility(view.context);
                if (view._instance.type === 'I' || view._instance.type === 'TI') {
                    view._instance.pickerControl.readonly = (visibility === "READONLY");
                }

                if (visibility != "NONE" && view._instance.disabler) {
                    if (visibility === "READONLY") {
                        domClass.remove(view._instance.disabler, "hidden");
                        this._setReadOnly(view, true);
                    } else {
                        domClass.add(view._instance.disabler, "hidden");
                        this._setReadOnly(view, false);
                    }
                } else if (visibility === "NONE") {
                    this._setPickerDisplay(view, false);
                }
                
                if (!view._instance.label)
                    return;
                if (visibility === "READONLY")
                    domClass.add(view.context.element, "disabled");
                else
                    domClass.remove(view.context.element, "disabled");
            },
            _setReadOnly: function(view, value) {
                if (view._instance.type === "I") {
                    controlElement = view._instance.pickerControl.picker;
                    if (value) {
                        query("td", controlElement).style("cursor", "default");
                    } else {
                        query("td", controlElement).style("cursor", "");
                    }
                } else {
                    controlElement = view._instance.pickerElement;
                    if (value) {
                        domAttr.set(controlElement, "readonly", "");
                        domAttr.set(controlElement, "disabled", "");
                    } else {
                        domAttr.remove(controlElement, "readonly");
                        domAttr.remove(controlElement, "disabled");
                    }
                }
            },
            _updateControl: function(view) {
                bpmext.log.debug("_updateControl for viewid [" + view.context.viewid + "]");
                var errors = bpmext.ui.getViewValidationErrors(view);

                //Color style
                var colStyle = errors ? "E" : view.context.options.colorStyle.get("value");

                //bpmext.ui.util.replaceCSSClass(view._instance.formgroupDiv, bpmext.ui.util.OPTS_COL_STL_CLZ, colStyle, view._instance.oldColStyle);
                view._instance.oldColStyle = colStyle;

                var type = view.context.options.type.get('value');

                //Validation Error Icon
                if (view._instance.icon) {
                    bpmext.ui.util.closeTooltip(view._instance.iconTT, view._instance.icon);
                    delete view._instance.iconTT;

                    if (type === "TI") {
                        view._instance.inputDivWrapper.removeChild(view._instance.icon);
                    }
                    delete view._instance.icon;
                }

                if (errors) {
                    var anchorElement;
                    domClass.add(view._instance.formgroupDiv, "has-feedback has-error");
                    if (type === "TI") {
                        view._instance.icon = document.createElement("span");
                        //Remove the calendar icon if present
                        if (view._instance.calendarIcon) {
                        	domClass.remove(view._instance.pickerElement, 'has-icon');
                            domConstruct.destroy(view._instance.calendarIcon);
                            view._instance.calendarIcon = null;
                        }
                        view._instance.inputDivWrapper.appendChild(view._instance.icon);
                        domClass.add(view._instance.icon, "fa form-control-feedback fa-exclamation-circle");
                        anchorElement =  view._instance.inputDivWrapper;
                    } else {
                        anchorElement = view._instance.pickerControl.picker;
                    }

                    var ttOpts = {
                        horizontalPos: type === "I" ? "left" : "right",
                        verticalPos: "top",
                        cssClass: "validationError",
                        plainText: false,
                        smartPositioning: true
                    };

                    view._instance.iconTT = bpmext.ui.util.showTooltip(
                        anchorElement,
                        bpmext.ui.util.formatErrors(errors),
                        ttOpts);

                    view._instance.errorMessage = document.createElement("div");
                    view._instance.errorMessage.id = view._instance.inputDivWrapper.firstElementChild.id + "-error-msg";
                    view._instance.errorMessage.classList.add("hide");
                    view._instance.errorMessage.innerHTML = bpmext.ui.util.formatErrors(errors);
                    view._instance.inputDivWrapper.appendChild(view._instance.errorMessage);
                    domAttr.set(view._instance.inputDivWrapper.firstElementChild, "aria-describedby", view._instance.errorMessage.id);
                    domAttr.set(view._instance.inputDivWrapper.firstElementChild, "aria-invalid", "true");
                } else {
                    domClass.remove(view._instance.formgroupDiv, "has-feedback has-error");
                    view._proto._setEnableCalendarIcon(view, view.context.options.enableCalendarIcon.get("value"));
                    if (view._instance.errorMessage) { view._instance.errorMessage.remove(); }
					domAttr.remove(view._instance.inputDivWrapper.firstElementChild, "aria-describedby");
					domAttr.remove(view._instance.inputDivWrapper.firstElementChild, "aria-invalid");
                }

            },
            /* {#feature: US-357 made changes so that type could be dynamically updated for responsive designs in WebPD} */
            _createHTMLForType: function(type) {
                var toReturn;
                switch (type) {
                    case "I":
                        {
                            toReturn = document.createElement("div");
                            break;
                        }
                    case "TI":
                        {
                            toReturn = document.createElement("input");
                            domClass.add(toReturn, "form-control");
                            domAttr.set(toReturn, "autocomplete", "off")
                            break;
                        }
                    case "ND":
                        {
                            toReturn = domConstruct.create("input", { type: "date" });
                            domClass.add(toReturn, "form-control");
                            break;
                        }
                    case "NDT":
                        {
                            toReturn = domConstruct.create("input", { type: "datetime-local", step: "60" });
                            domClass.add(toReturn, "form-control");
                            break;
                        }
                }
                return toReturn;
            },
            _setShowWeeks: function(view, value) {
                try {
                    if (view._instance.pickerControl) {
                        view._instance.pickerControl.showCalendarWeek(value);
                    }
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setShowWeeks() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _convertDisabledWeekDaysOptionToString: function(toConvert) {
                var toReturn = "";
                var disabledWeekDaysArray = [];
                var index;
                for (index in this.OPTS_WEEK_DAYS_ARRAY) {
                    if (toConvert[this.OPTS_WEEK_DAYS_ARRAY[index]]) {
                        disabledWeekDaysArray.push(index);
                    }
                }
                toReturn = disabledWeekDaysArray.join();
                return toReturn;
            },
            _setDisabledWeekDays: function(view, value) {
                try {
                    var stringValue = this._convertDisabledWeekDaysOptionToString(value);
                    view._instance.pickerControl.setDaysOfWeekDisabled(stringValue);
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setDisabledWeekDays() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setStartView: function(view, value) {
                try {
                    if (view._instance.pickerControl) {
                        view._instance.pickerControl.viewMode = value;
                        view._instance.pickerControl.setStartView(value);
                    }
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setStartView() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setHighlightToday: function(view, value) {
                try {
                    if (view._instance.pickerControl) {
                        //console.log("_setHighlightToday", value);
                        view._instance.pickerControl.setTodayHighlight(value);
                    }
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setHighlightToday() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setEnableTodayButton: function(view, value) {
                try {
                    if (view._instance.pickerControl) {
                        view._instance.pickerControl.showTodayButton(value);
                    }
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setEnableTodayButton() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setEnableCalendarIcon: function(view, value) {
                try {
                    var type = view.context.options.type.get('value');
                    //Remove Calendar Icon if it exists
                    if (view._instance.calendarIcon) {
                        if (type === "TI") {
                        	domClass.remove(view._instance.pickerElement, 'has-icon');
                            domConstruct.destroy(view._instance.calendarIcon);
                            view._instance.calendarIcon = null;
                        }
                        delete view._instance.calendarIcon;
                    }
                    if (typeof value === 'boolean') {
                        if (value) {
                            if (type === "TI") {
                                view._instance.calendarIcon = domConstruct.create("span", {"class": "form-control-feedback has-icon"}, view._instance.inputDivWrapper);
                                domClass.add(view._instance.pickerElement, 'has-icon');
                                
                                if (utilities.getActiveTheme() === '"CARBON"') {
                                    var icon = utilities.getCarbonIcon("ci-calendar");
                                    icon && domConstruct.place(icon, view._instance.calendarIcon);
                                    domClass.add(view._instance.calendarIcon, 'ci ci-calendar');
                                } else {
                                    domClass.add(view._instance.calendarIcon, 'fa fa-calendar');                        			
                                }
                            }
                        }
                    }
                    
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setEnableCalendarIcon() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setEnableClearButton: function(view, value) {
                try {
                    if (view._instance.pickerControl) {
                        //console.log("_setEnableClearButton", value);
                        view._instance.pickerControl.showClearButton(value);
                    }
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setEnableClearButton() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setWeekStart: function(view, value) {
                try {
                    if (view._instance.pickerControl) {
                        //console.log("_setWeekStart", value);
                        view._instance.pickerControl.setWeekStart(value);
                    }
                } catch (e) {
                    bpmext.log.error("DateTimePicker._setWeekStart() " + bpmext.localization.formatMsg("general", "ERROR") + ": " + e);
                    if (e.stack)
                        bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
                }
            },
            _setOrientation: function(view, orientation) {
                try {
                    if (view.context.options.type.get('value') === 'I') return;

                    orientation = view._proto.OPTS_ORIENTATION[orientation];
                    var rtl = view._proto._getDirection() === "rtl";

                    var plc = String(orientation).toLowerCase().split(/\s+/g),
                        _plc = orientation.toLowerCase();
                    plc = plc.filter(function(word) {
                        return (/^auto|left|right|top|bottom$/).test(word);
                    });
                    orientation = { x: 'auto', y: 'auto' };
                    if (plc.length === 1) {
                        switch (plc[0]) {
                            case 'top':
                            case 'bottom':
                                orientation.y = plc[0];
                                break;
                            case 'left':
                            case 'right':
                                orientation.x = plc[0];
                                break;
                        }
                    } else {
                        _plc = plc.filter(function(word) {
                            return (/^left|right$/).test(word);
                        });
                        orientation.x = _plc[0] || 'auto';

                        _plc = plc.filter(function(word) {
                            return (/^top|bottom$/).test(word);
                        });
                        orientation.y = _plc[0] || 'auto';
                    }

                    var computedStyle = domStyle.getComputedStyle(view._instance.pickerControl.picker);
                    var contentBox = domGeometry.getContentBox(view._instance.pickerControl.picker, computedStyle);
                    var paddingBorderExtends = domGeometry.getPadBorderExtents(view._instance.pickerControl.picker, computedStyle);
                    var calendarWidth = contentBox.w + paddingBorderExtends.w;
                    var calendarHeight = contentBox.h + paddingBorderExtends.h;
                    var windowBox = win.getBox();
                    var visualPadding = 10;
                    var windowWidth = windowBox.w;
                    var windowHeight = windowBox.h;

                    var scrollTop;
                    // maybe we should use specific versions for FF and IE (e.g. 36 - this is where the bug was introduced, 
                    // and 9 respectively - i am not sure how it worked before version 9) instead of using a version > 0 
                    if (dojo && (dojo.isChrome > 0 || dojo.isFF > 0 || dojo.isIE > 0 || navigator.userAgent.indexOf("Trident") > 0)) {
                        scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
                    } else {
                        scrollTop = baseWindow.body().scrollTop || window.pageYOffset;
                    }

                    var parents = query(view._instance.pickerElement).parents();
                    var subParents = parents.filter(function(parent) {
                        return query(parent).style("z-index")[0] !== "auto";
                    });

                    //{#bug: BG-325 Display calendar popup above the background of a modal section}
                    var subParentZIndex = parseInt(subParents.first().style("z-index")[0]) || 0;
                    var zIndex = subParentZIndex + 1060; //1060 is used because a modal section's z-index is 1050
                    //var zIndex = parseInt(subParents.first().style("z-index")[0]) + 10;

                    var position = domGeometry.position(view._instance.pickerElement);

                    var left = position.x;
                    var top = position.y;
                    var height = position.h;
                    var width = position.w;
                    domClass.remove(view._instance.pickerControl.picker, 'datepicker-orient-top datepicker-orient-bottom ' +
                        'datepicker-orient-right datepicker-orient-left');

                    if (orientation.x == 'right') {
                        domClass.add(view._instance.pickerControl.picker, 'datepicker-orient-' + orientation.x);
                        if (!rtl) {
                            left -= calendarWidth - width - window.pageXOffset;
                        } else {
                            if (left < 0) {
                                left -= left - visualPadding;
                            } else {
                                left = left + window.pageXOffset;
                            }
                        }
                    }
                    // auto x orientation is best-placement: if it crosses a window
                    // edge, fudge it sideways
                    else {
                        // Default to left
                        domClass.add(view._instance.pickerControl.picker, "datepicker-orient-left");
                        if (!rtl) {
                            if (left < 0) {
                                left -= left - visualPadding;
                            } else {
                                if (left + calendarWidth > windowWidth) {
                                    // left = windowWidth - calendarWidth - visualPadding;
                                    left = (left - calendarWidth) + visualPadding + 20; //Move it left
                                    domClass.replace(view._instance.pickerControl.picker, "datepicker-orient-right", "datepicker-orient-left");
                                }
                                left = left + window.pageXOffset;
                            }
                        } else {
                            if (left < 0) {
                                left -= left - visualPadding;
                                domClass.replace(view._instance.pickerControl.picker, "datepicker-orient-right", "datepicker-orient-left");
                            } else {
                                // left = width - calendarWidth; this line works 
                                // but when there is a scroll bar(because or many controls), the popup is shifted a few pixels to the left
                                left += width - calendarWidth + window.pageXOffset;
                            }
                        }
                    }

                    // auto y orientation is best-situation: top or bottom, no fudging,
                    // decision based on which shows more of the calendar
                    var yorient = orientation.y,
                        top_overflow, bottom_overflow;
                    if (yorient === 'auto') {
                        top_overflow = top - calendarHeight;
                        bottom_overflow = windowHeight - (top + height + calendarHeight);
                        if (Math.max(top_overflow, bottom_overflow) === bottom_overflow)
                            yorient = 'bottom';
                        else
                            yorient = 'top';
                    }

                    //domClass.add(this.picker, "datepicker-orient-" + yorient);

                var highlightToday = opts.highlightToday.get("value");
                var includeTimePicker = opts.includeTimePicker.get("value");
                var enableTodayButton = opts.enableTodayButton.get("value");
                var enableClearButton = opts.enableClearButton.get("value");
                var bidi = this._proto._getDirection();
                var hideHeader = opts.hideHeader.get("value");
                var customPickerOnly = opts.customPickerOnly.get("value");
                var date = this.getDate();
                var yearSelectorStyle = opts.yearSelectorStyle.get("value");

                var datepickerOptions = {
                    calendarType: calendarType,
                    format: format,
                    weekStart: weekStart,
                    startView: startView,
                    daysOfWeekDisabled: disabledWeekDaysString,
                    blackoutDates: blackoutDates,
                    blackoutDateStart: blackoutDateStart,
                    blackoutDateEnd: blackoutDateEnd,
                    startDate: startDate,
                    endDate: endDate,
                    minViewMode: minViewMode,
                    calendarWeeks: showWeeks,
                    todayHighlight: highlightToday,
                    includeTimePicker: includeTimePicker,
                    todayBtn: enableTodayButton,
                    clearBtn: enableClearButton,
                    bidi: bidi,
                    beforeShowDay: beforeShowDay,
                    showHeader: !hideHeader,
                    date: date,
                    controlidpath: this.context.controlidpath,
                    yearSelectorStyle: yearSelectorStyle
                };

                if (this._proto._isMobileDevice() && this._proto._detectNativeDateSupport() && !customPickerOnly && this._instance.type !== 'I' && weekStart === 0 && disabledWeekDaysString === "" && calendarType === "gregorian" && blackoutDates.length === 0 && !blackoutDateStart && !blackoutDateEnd && !startDate && !endDate) {
                    view._instance.type = 'ND'; //Native Date
                    if (datepickerOptions.includeTimePicker) {
                        view._instance.type = 'NDT'; //Native Date Time
                    }
                    this._proto._loadNativePicker(view, opts, datepickerOptions);
                } else {
                    this._proto._loadCustomPicker(view, opts, datepickerOptions);
                }
                
                var tmp = mdt.helpText ? mdt.helpText.get("value") : null;
				if (tmp && tmp.length > 0)
				{
					this._proto._setHelpText(this, tmp);
                }
                
                bpmext.ui.loadView(this);

                if (this._instance.type === 'I' || this._instance.type === 'TI') {
                    this._instance.pickerControl.startup(); //Start Date picker

                    if (!this._instance.dateIsValid) { // TKT 349  Show Error on initial display with bad input
                        bpmext.ui.addViewValidationError(this, "datetime", bpmext.localization.formatMsg("controlDatePicker", "DATE_BOUND_INPUT_ERROR") + " [" + this.context.binding.get("value") + "] ");
                    }
                }

                this._instance.loadEHIsRunning = false;
            } catch (e) {
                bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
                if (e.stack)
                    bpmext.log.error("  Call stack: " + e.stack);
            }
        };

        this.constructor.prototype.view = function() {
            try {
                this.context.element.classList.remove("Date_Time_Picker");
                this.context.element.classList.add("Date_Picker");

                this._proto._handleVisibility(this);
            } catch (e) {
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVIEW_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack)
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
            }
        };

        this.constructor.prototype.change = function(event) {
            try {
                bpmext.log.debug("Change eh for viewid [" + this.context.viewid + "] type [" + event.type + "] property [" + event.property + "] newVal [" + event.newVal + "] oldVal [" + event.oldVal + "]");
                if (event.type == "config") {
                    switch (event.property) {
                        case "_metadata.label":
                            {
                                this._proto._setLabel(this, event.newVal, event.oldVal);
                                this._proto._setHelpText(this, this.context.options._metadata.helpText.get("value"));
                                break;
                            }
                        case "_metadata.visibility":
                            {
                                this._proto._handleVisibility(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "_metadata.labelVisibility":
                            {
                                this._proto._setLabelVisibility(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "_metadata.helpText":
                            {
                                this._proto._updateControl(this, event.newVal, event.oldVal);
                                this._proto._setHelpText(this, event.newVal);
                                break;
                            }
                        case "placeHolder":
                            {
                                this._proto._setPlaceholder(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "showWeeks":
                            {
                                this._proto._setShowWeeks(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "disabledWeekDays":
                            {
                                this._proto._setDisabledWeekDays(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "startView":
                            {
                                this._proto._setStartView(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "highlightToday":
                            {
                                this._proto._setHighlightToday(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "enableTodayButton":
                            {
                                this._proto._setEnableTodayButton(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "enableClearButton":
                            {
                                this._proto._setEnableClearButton(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "enableCalendarIcon":
                        	{
                            	this._proto._setEnableCalendarIcon(this, event.newVal, event.oldVal);
                            	break;
                        	}
                        case "weekStart":
                            {
                                this._proto._setWeekStart(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "orientation":
                            {
                                this._proto._setOrientation(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "format":
                            {
                                this._proto._setFormat(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "minViewMode":
                            {
                                this._proto._setMinViewMode(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "startDate":
                            {
                                this._proto._setStartDate(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "endDate":
                            {
                                this._proto._setEndDate(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "blackoutDateStart":
                            {
                                this._proto._setBlackoutDateStart(this, event.newVal);
                                break;
                            }
                        case "blackoutDateEnd":
                            {
                                this._proto._setBlackoutDateEnd(this, event.newVal);
                                break;
                            }
                        case "blackoutDates":
                            {
                                this._proto._setBlackoutDates(this, event.newVal);
                                break;
                            }
                        case "width":
                            {
                                this._proto._setWidth(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "sizeStyle":
                            {
                                this._proto._setSizeStyle(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "colorStyle":
                            {
                                this._proto._setColorStyle(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "tabIndex":
                            {
                                this._proto._setTabIndex(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "labelPlacement":
                            {
                                this._proto._setLabelPlacement(this, event.newVal, event.oldVal);
                                break;
                            }
                        case "labelWidth":
                            {
                                this._proto._setLabelWidth(this, event.newVal);
                                break;
                            }
                        case "yearSelectorStyle":
                            {
                                this._proto._setYearSelectorStyle(this, event.newVal);
                                break;
                            }
                        case "type":
                            {
                                this._instance.type = event.newVal;
                                if (event.newVal === "I" && event.oldVal === "TI") {
                                    if (this._instance.pickerControl.picker.parentElement.tagName === 'BODY') {
                                        if(!this._instance.dpControlDiv) {
                                            this._instance.dpControlDiv = document.createElement("div");
                                            this._instance.inputDivWrapper.appendChild(this._instance.dpControlDiv);
                                        }
                                        this._instance.dpControlDiv.appendChild(this._instance.pickerControl.picker);
                                    }
                                    domClass.add(this._instance.pickerElement, "hidden");

                                    this._proto._removeStyle(this);
                                    this._proto._setPickerDisplay(this, true);
                                } else if (event.newVal === "TI" && event.oldVal === "I") {
                                    if (this._instance.pickerControl.picker.parentElement.tagName === 'DIV') {
                                        document.getElementsByTagName("body")[0].appendChild(this._instance.pickerControl.picker);
                                    }
                                    var element = this._instance.inputDivWrapper.children[0];
                                    if (element.tagName === "DIV") {
                                        this._instance.inputDivWrapper.removeChild(element);
                                        this._instance.pickerElement = this._proto._createHTMLForType(event.newVal);
                                        this._instance.inputDivWrapper.appendChild(this._instance.pickerElement);
                                    }
                                    domClass.remove(this._instance.pickerElement, "hidden");

                                    this._proto._setPlaceholder(this, this.context.options.placeHolder.get("value"));
                                    this._proto._setPickerDisplay(this, false);
                                    this._proto._addAccessibility(this);
                                    this._proto._handleVisibility(this);

                                    var format = this.context.options.format.get("value") || this._proto.OPTS_FORMAT.default;
                                    this._proto._updateTextInput(this, this.context.binding.get("value"), format);
                                }
                                this._proto._unapplyEvents(this);
                                this._proto._applyEvents(this);
                                this._proto._setPickerTypeCSS(this);
                                this._proto._setTabIndex(this, this.context.options.tabIndex.get("value"));
                                this._proto._updateControl(this);

                                //Load i18n bundle
                                this._proto._loadi18Bundle(this);

                                break;
                            }
                        case "includeTimePicker":
                            {
                                this._instance.pickerControl.showTimePicker(event.newVal);
                                if (this._instance.type === 'TI') { //If Date Time Picker is displayed as "Text Input" update the input value
                                    var format = this.context.options.format.get("value") || this._proto.OPTS_FORMAT.default;
                                    this._proto._updateTextInput(this, this.context.binding.get("value"), format);
                                }

                                break;
                            }
                    }
                } else if (event.insertedInto == event.removedFrom){
                    //{#bug: * issue with clearing datePicker}
                    if (this._instance.loadEHIsRunning && this._instance.validateEHIsRunning)
                        return;
                    bpmext.log.debug("Change eh for viewid [" + this.context.viewid + "] newVal [" + event.newVal + "] oldVal [" + event.oldVal + "]");

                    if ((event.oldVal && event.oldVal.getTime()) !== (event.newVal && event.newVal.getTime())) {

                        if (this._instance.type === 'I') { //Inline
                            this._instance.pickerControl.updateControl(event.newVal);
                        } else if (this._instance.type === 'TI') { //Text Input
                            this._instance.pickerControl.updateControl(event.newVal);

                            var orientation = this.context.options.orientation.get("value"); //APAR 327163
                            this._proto._setOrientation(this, orientation); //APAR 327163

                            //Format date to display in input text
                            var format = this.context.options.format.get("value") || this._proto.OPTS_FORMAT.default;
                            this._proto._updateTextInput(this, event.newVal, format);

                            if (!this._instance.dateIsValid) {
                                this._instance.dateIsValid = true;
                                bpmext.ui.removeViewValidationError(this, "datetime");
                            }
                            this._proto._updateControl(this);
                        } else if (this._instance.type === 'ND' || this._instance.type === 'NDT') { //Native Date Time Picker
                            this._proto._updateNativeDateInput(this, event.newVal);
                        }
                        bpmext.ui.executeEventHandlingFunction(this, this._proto.EVT_ONCHANGE, event.newVal, event.oldVal);
                    }
                }
            } catch (e) {
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack)
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
            }
        };

        this.constructor.prototype.validate = function(event) {
            try {
                this._instance.validateEHIsRunning = true;
                bpmext.log.debug("Validation eh for viewid [" + this.context.viewid + "] running with type [" + event.type + "]");
                bpmext.ui.updateViewValidationState(this, event);
                if ((this._instance.loadEHIsRunning) && (event.type == "error"))
                    this.context.binding.set("value", ""); //Tkt 349
                this._proto._updateControl(this);
                if (this._instance.vc)
                    this._instance.vc.validate(event);
            } catch (e) {
                bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONVALIDATE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
                if (e.stack)
                    bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
            } finally {
                this._instance.validateEHIsRunning = false;
            }
        };

        this.constructor.prototype.unload = function() {
            this._instance.pickerControl.picker.parentNode.removeChild(this._instance.pickerControl.picker);
            delete this._instance.pickerControl;

            bpmext.ui.unloadView(this);
        };
    }
};
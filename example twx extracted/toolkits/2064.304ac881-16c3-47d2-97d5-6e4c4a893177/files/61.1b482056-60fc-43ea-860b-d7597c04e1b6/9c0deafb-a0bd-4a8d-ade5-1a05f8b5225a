            _setPickerDisplay: function(view, value) {
                if (view._instance.type === "NDT") {
                    return;
                }
                
                if (value) { //show
                    view._instance.pickerControl.picker.style.display = "inline-block";

                    //Accessibility
                    view._instance.pickerControl.picker.setAttribute("aria-hidden", "false");

                    //Add scroll event
                    document.addEventListener("scroll", view._instance, { passive: true, capture: true });
                    document.addEventListener("touchmove", view._instance, { passive: true });

                    //Defect 323394 - Android 9: Date Time Picker dialog remains on screen out of context when scrolling
                    if (dojo.isAndroid) {
                        window.addEventListener("resize", view._instance, { passive: true });
                    }
                } else { //hide
                    view._instance.pickerControl.picker.style.display = "";

                    //Accessibility
                    view._instance.pickerControl.picker.setAttribute("aria-hidden", "true");

                    //Remove scroll event
                    document.removeEventListener("scroll", view._instance, { passive: true, capture: true });
                    document.removeEventListener("touchmove", view._instance, { passive: true });

                    //Defect 323394 - Android 9: Date Time Picker dialog remains on screen out of context when scrolling
                    if (dojo.isAndroid) {

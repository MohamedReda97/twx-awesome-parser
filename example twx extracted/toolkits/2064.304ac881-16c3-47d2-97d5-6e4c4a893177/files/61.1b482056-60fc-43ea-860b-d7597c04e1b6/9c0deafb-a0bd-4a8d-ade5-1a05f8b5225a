            },
            _isIE: function() {
                var ua = window.navigator.userAgent;

                // Test values; Uncomment to check result

                // IE 10
                // ua = 'Mozilla/5.0 (compatible; MSIE 10.0; Windows NT 6.2; Trident/6.0)';

                // IE 11
                // ua = 'Mozilla/5.0 (Windows NT 6.3; Trident/7.0; rv:11.0) like Gecko';

                // Edge 12 (Spartan)
                // ua = 'Mozilla/5.0 (Windows NT 10.0; WOW64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/39.0.2171.71 Safari/537.36 Edge/12.0';

                // Edge 13
                // ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/46.0.2486.0 Safari/537.36 Edge/13.10586';

                var msie = ua.indexOf('MSIE ');
                if (msie > 0) {
                    // IE 10 or older => return version number
                    return parseInt(ua.substring(msie + 5, ua.indexOf('.', msie)), 10);
                }

                var trident = ua.indexOf('Trident/');
                if (trident > 0) {
                    // IE 11 => return version number
                    var rv = ua.indexOf('rv:');
                    return parseInt(ua.substring(rv + 3, ua.indexOf('.', rv)), 10);
                }

                var edge = ua.indexOf('Edge/');
                if (edge > 0) {
                    // Edge (IE 12+) => return version number
                    return parseInt(ua.substring(edge + 5, ua.indexOf('.', edge)), 10);
                }

                // other browser
                return false;
            },
            _applyEvents: function(view) {
                view._instance.handleEvent = function(event) {
                    var date = null;
                    var isDisabled = false;
                    var format = view.context.options.format.get("value");
                    switch (event.type) {
                        case 'focus':
                        case 'click':
                            if (event.target.tagName === "INPUT" && !view._instance.changeDateHandleRunning) {
                                var visibility = utilities.handleVisibility(view.context);
                                if (visibility !== "READONLY") {
                                    view._proto._setPickerDisplay(view, true);
                                    var orientation = view.context.options.orientation.get("value");
                                    view._proto._setOrientation(view, orientation);
                                }
                            }
                            view._instance.changeDateHandleRunning = false;
                            break;
                        case 'blur':
                            setTimeout(function() {
                                var ae = document.activeElement;
                                var isDescendant = dom.isDescendant(ae, view.context.element) || dom.isDescendant(ae, view._instance.pickerControl.picker);
                                if (view.context.options.type.get("value") === 'TI') {
                                    if (view.context.options.noAutoclose.get("value") && !isDescendant) { // Do not close picker when date is selected but close if clicked outside
                                        view._proto._setPickerDisplay(view, false);
                                    } else if (!view.context.options.noAutoclose.get("value")) {
                                        if (isDescendant && !view._instance.changeDateHandleRunning) {
                                            return;
                                        }

                                        //Focus on input element when a date is selected
                                        if (view._instance.changeDateHandleRunning) {
                                            view._instance.pickerElement.focus();
                                        }

                                        //Close picker
                                        view._proto._setPickerDisplay(view, false);
                                    }
                                }
                            }, 150);
                            break;
                        case 'keydown':
                            if (event.key === "Tab" || event.key === "Esc" || event.key === "Escape") {
                                if (event.key === "Esc" || event.key === "Escape") view._instance.pickerElement.focus();
                                view._proto._setPickerDisplay(view, false);
                                //Accessibility
                                view._instance.pickerControl.picker.setAttribute("aria-hidden", "true");
                            } else if (event.key === "ArrowUp" || event.key === "Up" || event.key === "ArrowDown" || event.key === "Down") {
                                event.preventDefault();
                                if (view._instance.pickerElement === document.activeElement) {
                                    view._instance.handleEvent(event = { type: 'focus', target: view._instance.pickerElement });
                                    view._instance.pickerControl.picker.focus();
                                }
                            } else if (event.key === "Enter") { //301333: Typing a date in IE11 and pressing 'Enter' does not select the date on the calendar
                                if (view._proto._isIE() && (event.target === view._instance.pickerElement)) {
                                    view._instance.handleEvent(event = { type: 'change' });
                                }

                                var isDescendant = dom.isDescendant(event.target, view._instance.pickerControl.picker);
                                if (isDescendant) {
                                    view._instance.handleEvent(event = { type: 'blur' });
                                }
                            }
                            break;
                        case 'change':
                            var value = view._instance.pickerElement.value;
                            if (view._instance.type === "TI") {
                                if (value !== "" && value.length > 0) {
                                    date = view._instance.pickerControl.parseDate(value, {
                                        calendarType: view.context.options.calendarType.get("value"),
                                        hasTime: view.context.options.includeTimePicker.get("value"),
                                        customFormat: format,
                                        testDefaultFormats: false
                                    });

                                    if (date) {
                                        isDisabled = view._instance.pickerControl.isDisabled(date);
                                    }

                                    if (!date || isDisabled) {
                                        view._instance.dateIsValid = false;
                                        if (isDisabled) {
                                        	bpmext.ui.addViewValidationError(view, "datetime", bpmext.localization.formatMsg("controlDatePicker", "INVALID_DATE_RANGE", value));
                                        } else {
                                        	bpmext.ui.addViewValidationError(view, "datetime", bpmext.localization.formatMsg("controlDatePicker", "INVALID_DATE", value, view._proto._getFormat(view)));
                                        }

                                        //Accessibility
                                        view._instance.pickerElement.setAttribute("aria-invalid", "true");
                                    } else {
                                        if (!view._instance.dateIsValid) {
                                            view._instance.dateIsValid = true;
                                            bpmext.ui.removeViewValidationError(view, "datetime");

                                            //Accessibility
                                            view._instance.pickerElement.setAttribute("aria-invalid", "false");
                                        }
                                        view.setDate(new Date(date));
                                    }
                                } else {
                                    view.setDate(null);
                                }

                                if (!isDisabled) {
                                    view._instance.pickerControl.updateControl(date);
                                }
                            } else {
                                if (value !== "" && value.length > 0) {
                                    view.setDate(stamp.fromISOString(value));
                                } else {
                                    view.setDate(null);
                                }
                            }
                            break;
                        case 'changeDate':
                            if (view._instance.onChangeHandleRunning) { // TKT 349
                                return;
                            } else {
                                view._instance.changeDateHandleRunning = true;
                            }

                            if (!view._instance.dateIsValid) {
                                view._instance.dateIsValid = true;
                                bpmext.ui.removeViewValidationError(view, "datetime");
                            }

                            //If Date Time Picker is displayed as "Text Input" update the input value
                            if (view.context.options.type.get("value") === 'TI') {
                                view._proto._updateTextInput(view, event.datepicker.date, format);
                            }

                            var oldValue = view.context.binding.get("value");
                            bpmext.log.debug("onChangeHandle for viewid [" + view.context.viewid + "] current binding [" + oldValue + "]");

                            var newValue = event.datepicker.date;
                            try {
                                view._instance.onChangeHandleRunning = true;
                                //Update date
                                if ((oldValue && oldValue.getTime()) !== (newValue && newValue.getTime())) {
                                    view.context.binding.set("value", newValue);
                                }
                            } finally {
                                view._instance.onChangeHandleRunning = false;
                            }
                            break;
                        case 'changeTime':
                            if (view._instance.onChangeHandleRunning) { // TKT 349
                                return;
                            }

                            if (!view._instance.dateIsValid) {
                                view._instance.dateIsValid = true;
                                bpmext.ui.removeViewValidationError(view, "datetime");
                            }

                            var newTime;
                            date = view.context.binding.get("value");

                            bpmext.log.debug("onChangeTimeHandle for viewid [" + view.context.viewid + "] current binding [" + date + "]");

                            if (date) {
                                newTime = new Date(date);
                                var hours = event.timepicker.hours;
                                var minutes = event.timepicker.minutes;
                                newTime.setHours(hours, minutes, 0, 0);
                            }

                            //If Date Picker is displayed as "Text Input", update the input value
                            if (view.context.options.type.get("value") === 'TI') {
                                view._proto._updateTextInput(view, date, format);
                            }

                            try {
                                view._instance.onChangeHandleRunning = true;
                                //Update date
                                if (date) {
                                    view.context.binding.set("value", newTime);
                                }
                            } finally {
                                view._instance.onChangeHandleRunning = false;
                            }
                            break;
                        case 'scroll':
                            //Close picker
                            view._proto._setPickerDisplay(view, false);
                        case 'touchmove':
                        case 'resize':
                            var time = (event.type === "touchmove") ? 100 : 0;
                            setTimeout(function() {
                                var orientation = view.context.options.orientation.get("value");
                                view._proto._setOrientation(view, orientation);
                            }, time);
                            break;
                    }
                };

                //Add event listeners based on the type of calendar being displayed
                if (view._instance.type === 'TI') {
                    view._instance.pickerElement.addEventListener("focus", view._instance, false);
                    view._instance.pickerElement.addEventListener("click", view._instance, false);
                    view._instance.pickerElement.addEventListener("blur", view._instance, false);
                    view._instance.pickerControl.picker.addEventListener("blur", view._instance, true);
                    view._instance.pickerElement.addEventListener("keydown", view._instance, false);
                    view._instance.pickerControl.picker.addEventListener("keydown", view._instance, false);
                    view._instance.pickerElement.addEventListener("change", view._instance, false);
                    view._instance.pickerControl.picker.addEventListener("changeDate", view._instance, false);
                    view._instance.pickerControl.picker.addEventListener("changeTime", view._instance, false);
                } else if (view._instance.type === 'I') {
                    view._instance.pickerControl.picker.addEventListener("changeDate", view._instance, false);
                    view._instance.pickerControl.picker.addEventListener("changeTime", view._instance, false);
                } else if (view._instance.type === 'ND' || view._instance.type === 'NDT') {
                    view._instance.pickerElement.addEventListener("change", view._instance, false);
                }
            },
            _unapplyEvents: function(view) {
                view._instance.pickerElement.removeEventListener('focus', view._instance, false);
                view._instance.pickerElement.removeEventListener("click", view._instance, false);
                view._instance.pickerElement.removeEventListener('blur', view._instance, false);
                view._instance.pickerControl.picker.removeEventListener("blur", view._instance, true);
                view._instance.pickerElement.removeEventListener("keydown", view._instance, false);

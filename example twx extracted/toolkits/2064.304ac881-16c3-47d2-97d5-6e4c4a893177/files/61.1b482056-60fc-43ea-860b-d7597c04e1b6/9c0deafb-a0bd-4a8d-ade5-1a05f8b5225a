                view._instance.pickerControl.picker.removeEventListener('changeDate', view._instance, false);
                view._instance.pickerControl.picker.removeEventListener('changeTime', view._instance, false);
            },
            _getDirection: function() {
                var getDirection = function(element) {
                    var result = null;
                    if (element) {
                        if (window.getComputedStyle) {
                            result = window.getComputedStyle(element, null).direction;
                        } else if (element.currentStyle) {
                            result = element.currentStyle.direction;
                        }
                    }
                    return result;

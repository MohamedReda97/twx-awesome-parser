                        var timeString = stamp.toISOString(date, { selector: 'time' });
                        view._instance.pickerElement.value = dateString + timeString;
                    }

                    //BiDi
                    utilities.BiDi.applyTextDir(
                        view._instance.pickerElement,
                        view._instance.pickerElement.value,
                        view._instance.baseTxtDir,
                        view._instance.genPrefTextDir

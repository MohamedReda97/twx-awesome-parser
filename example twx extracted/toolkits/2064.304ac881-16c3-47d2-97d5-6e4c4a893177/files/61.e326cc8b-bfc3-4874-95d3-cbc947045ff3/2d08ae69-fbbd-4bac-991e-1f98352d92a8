var mixObject = {
    createPreview: function(containingDiv, labelText, callback) {
    	var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
        require(["dojo/dom-construct", bpmextUri], this.lang.hitch(this, function(domConstruct, bpmext) {
            this.context.coachViewData.containingDiv = containingDiv;

            var isInPanel = this.context.modelData.layoutItemParent && this.context.modelData.layoutItemParent && this.context.modelData.layoutItemParent._parent &&
            	this.context.modelData.layoutItemParent._parent._pathSegment=="contentBoxContrib" && this.context.modelData.layoutItemParent._parent._parent &&
            	this.context.modelData.layoutItemParent._parent._parent.viewUUID=="64.455e44ab-b77b-4337-b3f9-435e234fb569";

            var contentBox = this.context.coachViewData.containingDiv.querySelector('.ContentBox');

            var _this = this;
            bpmext.uidesign.loadLocalization(this, function(){
            	var warning = domConstruct.create('div', {
                    className: 'alert alert-warning hide',
                    role: 'alert',
                    innerHTML: bpmext.localization.formatMsg("controlPanelFooter", "INCORRECT_USAGE_WARNING")
                });
            	
                if (!isInPanel) {
                    contentBox.classList.add('hide');
                    _this.context.coachViewData.containingDiv.classList.add('Panel_Footer_Warning');
                    _this.context.coachViewData.containingDiv.appendChild(warning);
                    warning.classList.remove('hide');
                }
            });

            callback();
        }));
    }
};
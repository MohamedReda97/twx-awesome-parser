var mixObject = {
	createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", bpmextUri ], this.lang.hitch(this, function(domConstruct, domClass, bpmext){
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
			
			this.context.coachViewData.containingDiv = containingDiv;
			this.context.coachViewData.formGroupDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.containingDiv, "Text_Reader");
			
			this.context.coachViewData.labelTextDom = document.createTextNode(labelText);
			this.context.coachViewData.label = domConstruct.create("label");
			domClass.add(this.context.coachViewData.label, "control-label");
			this.context.coachViewData.label.appendChild(this.context.coachViewData.labelTextDom);
			
			this.context.coachViewData.inputDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.inputDiv, "input");

			this.context.coachViewData.textReaderDiv = domConstruct.create("div");
			domClass.add(this.context.coachViewData.textReaderDiv, "form-control");
			this.context.coachViewData.inputDiv.appendChild(this.context.coachViewData.textReaderDiv);
			
			this.context.coachViewData.userInteracted = false;//keep track of whether the user has interacted with the WYSIWYG
			this.context.coachViewData.currentlyExpanded = false;
			this.context.coachViewData.maxTextLen = 128;
			this.context.coachViewData.defMaxTextLen = 128;

			this.context.coachViewData.defaultInitiallyExpanded = false;
			this.context.coachViewData.readHint = "";
			
			this.context.coachViewData.sampleText = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur rutrum justo massa. Morbi augue nunc, imperdiet eget sapien vitae, bibendum consequat erat. Donec laoreet aliquet libero, imperdiet tincidunt leo pellentesque at. Phasellus sollicitudin, mi in mattis ornare, nisl orci tristique tortor, in maximus leo diam lobortis lorem. Duis id felis interdum, facilisis risus in, feugiat massa. In tristique, lacus in rhoncus egestas, magna ligula accumsan lorem, non consectetur elit diam non purus. Proin vitae urna non sapien posuere tristique nec in nulla. Nullam quis tellus orci. Nulla ac orci imperdiet, lacinia nisl ut, venenatis eros. Integer hendrerit mauris ac arcu efficitur ornare. Maecenas pharetra elementum urna at lobortis. Cras in metus sagittis, vestibulum ex et, tempus elit. Aenean placerat urna in pretium ullamcorper. Nulla sit amet mauris porttitor, euismod neque vel, tincidunt augue. Aenean ornare metus elit, in imperdiet ex lobortis et.";
			this.context.coachViewData.textNodeDom = document.createTextNode("");
			this.context.coachViewData.textNodeDom.textContent = this.context.coachViewData.sampleText.substring(0, this.context.coachViewData.maxTextLen) + "...";
			this.context.coachViewData.textReaderDiv.appendChild(this.context.coachViewData.textNodeDom);
			
			//this.context.coachViewData.anchorLink = domConstruct.create("a", { href: "javascript:void(0)" }, this.context.coachViewData.textReaderDiv);	
			this.context.coachViewData.anchorLink = domConstruct.create("button");
			domClass.add(this.context.coachViewData.anchorLink, "readHint");
			this.context.coachViewData.textReaderDiv.appendChild(this.context.coachViewData.anchorLink);
			
			domConstruct.place(this.context.coachViewData.formGroupDiv, this.context.coachViewData.containingDiv);
			domClass.add(this.context.coachViewData.formGroupDiv, "form-group");
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.label);
			this.context.coachViewData.formGroupDiv.appendChild(this.context.coachViewData.inputDiv);

			var _this = this;
			bpmext.uidesign.loadLocalization(this, function(){
				_this.context.coachViewData.defaultReadMoreHint = bpmext.localization.formatMsg("controlTextReader", "TR_SHOW_MORE");
				_this.context.coachViewData.defaultReadLessHint = bpmext.localization.formatMsg("controlTextReader", "TR_SHOW_LESS");
				_this.context.coachViewData.readMoreHint = bpmext.localization.formatMsg("controlTextReader", "TR_SHOW_MORE");
				_this.context.coachViewData.readLessHint = bpmext.localization.formatMsg("controlTextReader", "TR_SHOW_LESS");

				_this.context.coachViewData.anchorLink.innerHTML = _this.context.coachViewData.defaultReadMoreHint;
			});
			
			this.context.coachViewData.anchorLink.onclick = this.lang.hitch(this, function(event){
				this.context.coachViewData.anchorLink.focus();
				this.context.coachViewData.userInteracted = true;//do not look at default initially expanded from this point on
				this.updateTextArea(true);
				event.stopPropagation();
			});
			
			this.context.coachViewData.labelHandler = bpmext.uidesign.createLabelHandler(this.context.coachViewData.labelTextDom, this.context.coachViewData.label, this.context.coachViewData.containingDiv, false, false);
			callback();
		}));
	},
	getLabelDomElement:function(){
		return this.context.coachViewData.label;
	},
	propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-attr", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domAttr, configHelper){
			this.context.coachViewData.labelHandler.propertyChanged(propertyName, propertyValue);
			
			if(propertyName == "@style"){
				var width = configHelper.getResponsiveConfigOptionValue(this, "@width");
				var minWidth = configHelper.getResponsiveConfigOptionValue(this, "@minWidth");
				if(!!width || !!minWidth || this.context.coachViewData.width) {
					this.context.coachViewData.containingDiv.style.width =  minWidth || this.context.coachViewData.width || width;
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
			} else if(propertyName ==  "@visibility"){
				if(propertyValue == "READONLY"){
					domAttr.set(this.context.coachViewData.textReaderDiv, "disabled","disabled");
				}else{
					domAttr.remove(this.context.coachViewData.textReaderDiv, "disabled");
				}
				
				if(propertyValue == "REQUIRED"){
					dojo.attr(this.context.coachViewData.textReaderDiv, "aria-required", "true");
				} else {
					dojo.attr(this.context.coachViewData.textReaderDiv, "aria-required", "false");
				}
			} else if(propertyName == "labelPlacement"){
				var labelPlacement;
				if(propertyValue == "L"){
					labelPlacement = "label-left";
				} else {
					labelPlacement = "";
				}
				domClass.replace(this.context.coachViewData.formGroupDiv, labelPlacement, "label-left");
			} else if(propertyName == "sizeStyle"){
				var sizeStyle;
				if(propertyValue == "L"){
					sizeStyle = "input-lg";
				} else if(propertyValue == "S"){
					sizeStyle = "input-sm";
				} else {
					sizeStyle = "";
				}
				domClass.replace(this.context.coachViewData.textReaderDiv, sizeStyle, "input-sm input-lg");
			} else if(propertyName == "width"){
				this.context.coachViewData.width = propertyValue;
				if(!!propertyValue) {
					this.context.coachViewData.containingDiv.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.containingDiv.style.width = "";
				}
            } else if (propertyName == "labelWidth") {
                if (propertyValue) {
                    this.context.coachViewData.label.style.width = isNaN(propertyValue) ? propertyValue : (propertyValue + "px");
                    domClass.add(this.context.coachViewData.containingDiv, "labelWidth");
                } else {
                    this.context.coachViewData.label.style.width = "";
                    domClass.remove(this.context.coachViewData.containingDiv, "labelWidth");
                }
			} else if(propertyName == "height"){
				this.context.coachViewData.height = propertyValue;
				if(!!propertyValue) {
					this.context.coachViewData.textReaderDiv.style.height = isNaN(propertyValue) ? propertyValue : (propertyValue+"px");
				} else {
					this.context.coachViewData.textReaderDiv.style.height = "";
				}
			} else if(propertyName == "maxTextLen"){
				this.context.coachViewData.maxTextLen = (!!propertyValue) ? parseInt(propertyValue) : this.context.coachViewData.defMaxTextLen ;
				if(this.context.coachViewData.maxTextLen<1){
					this.context.coachViewData.maxTextLen = 128;
				}
				this.updateTextArea();
			} else if(propertyName == "initiallyExpanded"){
				this.context.coachViewData.defaultInitiallyExpanded = propertyValue;
				var maxTextLen = configHelper.getConfigOptionValue(this, "maxTextLen");
				this.updateTextArea();
			}
		}));
	},
	updateTextArea:function(flipstate){
		var maxTextLen = this.context.coachViewData.maxTextLen
		var expanded = false;
		if(this.context.coachViewData.userInteracted){
			//user interacted with control, so use the last state that the user put it in
			if(flipstate){
				expanded = !this.context.coachViewData.currentlyExpanded;
			}else{
				expanded = this.context.coachViewData.currentlyExpanded;
			}
		} else{
			//use the default initially expanded state
			if(this.context.coachViewData.defaultInitiallyExpanded){
				expanded = true;
			}
		}
		
		if(this.context.coachViewData.sampleText.length > maxTextLen){
			if(expanded){
				this.context.coachViewData.textNodeDom.textContent = this.context.coachViewData.sampleText;
				this.context.coachViewData.readHint = this.context.coachViewData.readLessHint;
				this.context.coachViewData.currentlyExpanded = true;
			}else {
				this.context.coachViewData.readHint = this.context.coachViewData.readMoreHint;
				this.context.coachViewData.textNodeDom.textContent = this.context.coachViewData.sampleText.substring(0, this.context.coachViewData.maxTextLen) + "...";
				this.context.coachViewData.currentlyExpanded = false;
			}
			this.context.coachViewData.anchorLink.innerHTML = this.context.coachViewData.readHint;
		}else {
			//can't collapse, so set everything to expanded
			this.context.coachViewData.currentlyExpanded = false;
			this.context.coachViewData.textNodeDom.textContent = this.context.coachViewData.sampleText;
			this.context.coachViewData.anchorLink.innerHTML = this.context.coachViewData.readLessHint;
		}
	},
	modelChanged: function(propertyName, propertyValue) {
		this.context.coachViewData.labelHandler.modelChanged(propertyName, propertyValue);
		if(propertyName == "readMoreHint"){
			this.context.coachViewData.readMoreHint = (propertyValue!="" && propertyValue!==null && propertyValue!==undefined) ? propertyValue : this.context.coachViewData.defaultReadMoreHint;
			this.updateTextArea();
		} else if(propertyName == "readLessHint"){
			this.context.coachViewData.readLessHint = (propertyValue!="" && propertyValue!==null && propertyValue!==undefined) ? propertyValue : this.context.coachViewData.defaultReadLessHint;
			this.updateTextArea();
		} 
	}
};

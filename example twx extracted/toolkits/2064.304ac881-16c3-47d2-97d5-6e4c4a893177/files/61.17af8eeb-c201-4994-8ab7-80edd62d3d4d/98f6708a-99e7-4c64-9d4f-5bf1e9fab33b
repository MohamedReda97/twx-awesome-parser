/** 
 *   <tr class=Prop>
 *     <td class=SectionName colspan=3>Events</td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Load:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers whenever the view is loaded.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>me.execute(${Data1}.getValue())</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Invoked:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Fires when service is invoked.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>${SvcButton}.setEnabled(false);</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Before Result:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Fires when the service returns a result and prior to the result being processed to allow for data augmentation.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>alert("Service call returned: " + data.results);</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Result:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Fires when the service returns a result.</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>alert("Service call returned: " + result);</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 *   <tr class=Prop>
 *     <td>On Error:</td>
 *     <td colspan="2">
 *       <table> 
 *         <tr class=Prop>
 *           <td>Description: </td>
 *           <td>Triggers when an error is returned from the service. To return an error, an AjaxError object should be used as an output variable inside the service. This can be used in conjunction with an Error Intermediate Event to catch any errors (and set the AjaxError object accordingly).</td>
 *         </tr>
 *         <tr class=Prop>
 *           <td>Example: </td>
 *           <td><pre class="prettyprint"><code>alert("Service error: " + error.errorText);</code></pre></td>
 *         </tr>
 *       </table>
 *     </td>
 *   </tr>
 * </table>
 */  
 bpmext_control_InitServiceCall = function(bpmext, domClass, utilities)
{
	this._instance = {
	};
	
	if(!this.constructor.prototype._proto)
	{
		this.constructor.prototype._proto = 
		{
			EVT_ONSVCINVOKE : "eventON_SVCINVOKE",
			EVT_ONSVCBEFORERESULT : "eventON_SVCBEFORERESULT",
			EVT_ONSVCRESULT : "eventON_SVCRESULT",
			EVT_ONSVCERROR : "eventON_SVCERROR",
			OPTS_BUSY_IND_CLZ : {
				"S" : "fa-spinner",
				"R" : "fa-refresh",
				"C" : "fa-cog"
			},
			_normalizeBusyIndicator : function (ind)
			{
				if(!ind)
					ind = "X";

				ind = ind.toUpperCase();
				if(ind.length > 1)
				{
					switch(ind)
					{
						case "SPIN":
						case "SPINNER":
							ind = "S";
							break;
						case "REFRESH":
							ind = "R";
							break;
						case "GEAR":
						case "COG":
							ind = "C";
							break;
						default:
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.warn("Unexpected busy indicator value: " + ind);
							bpmext.log.warn(bpmext.localization.formatMsg("controlServiceCall", "BUSY_INDICATOR_WARNING",ind));
					}
				}
				
				return ind;				
			},
			_setupBusyIndicator : function(view, ind)
			{
				ind = this._normalizeBusyIndicator(ind);
				if(ind != "X")
				{
					if(!view._instance.busyIndicator)
					{
						view._instance.busyIndicator = document.createElement("i");
						domClass.add(view._instance.busyIndicator, "indicator fa");
						view._instance.busyIndicator.title = bpmext.localization.formatMsg("controlServiceCall", "LOADING_SERVICE");
						//A text alternative for screen readers only
						view._instance.busyIndicatorMessage = document.createElement("span");
						domClass.add(view._instance.busyIndicatorMessage, "sr-only");
						view._instance.busyIndicatorMessage.innerText = bpmext.localization.formatMsg("controlServiceCall", "LOADING_SERVICE");
						view._instance.busyIndicator.appendChild(view._instance.busyIndicatorMessage);
						view.context.element.appendChild(view._instance.busyIndicator);
					}
					
					bpmext.ui.util.replaceCSSClass(view._instance.busyIndicator, this.OPTS_BUSY_IND_CLZ, ind, view._instance.oldBusyInd);
					view._instance.oldBusyInd = ind;
				}
				else
				{
					if(view._instance.busyIndicator)
						view._instance.busyIndicator.parentNode.removeChild(view._instance.busyIndicator);
				}
			},
			_setExecutionStatus : function(view, status, statusInfo)
			{
				if(view._instance.busyIndicator)
				{
					switch(status)
					{
						case "executing":
							domClass.remove(view._instance.busyIndicator, "error");
							domClass.add(view._instance.busyIndicator, "fa-spin");
							break;
						case "error":
							domClass.remove(view._instance.busyIndicator, "fa-spin");
							domClass.add(view._instance.busyIndicator, "fa-times-circle error");
							break;
						case "cleared":
							domClass.remove(view._instance.busyIndicator, "error fa-times-circle");
							break;
						case "completed":
							domClass.remove(view._instance.busyIndicator, "fa-spin");
							break;
						default:
							domClass.remove(view._instance.busyIndicator, "fa-spin");
							break;
					}
				}
			},
			_bindValueUpdate : function(event)
			{
				if(this.context.options.autoRun.get("value")){
					this.constructor.prototype.execute.bind(this)(this.context.options.inputData.get("value"));
				}
			}
		};
		
		/*
		Public control methods *************************************************************
		 */

		/**
		 * @instance
		 * @memberof ServiceCall
		 * @method getLastError
		 * @desc Get most recent error thrown
		 * @returns {ServiceError}
		 */
		this.constructor.prototype.getLastError = function()
		{
			return this._instance.error;
		};
		
		/**
		 * @instance
		 * @memberof ServiceCall
		 * @method execute
		 * @param {ANY} input Input data for the AJAX service (type will depend on the binding type of the AJAX service)
		 * @desc Executes the attached AJAX service
		 */
		this.constructor.prototype.execute = function(input)
		{
			//var input = {};
			if(input === undefined)
				input = this.context.options.inputData.get("value");

			//{#bug: Error if input data null}
			if(input != null && input.toJSObject)
				input = input.toJSObject();
			
			input = {"data": input};
			var view = this;

			var sargs = {
				params: (typeof input == "object") ? JSON.stringify(input) : input,
				load: function(data) {
					try
					{
						//domClass.remove(view._instance.input, "spin");
						//"results" is the name of the ouput of the AJAX service
						if(data.error)
						{
							delete data.error["@metadata"];
							view._instance.error = data.error;
							
							view._proto._setExecutionStatus(view, "error");
							
							setTimeout(function(){
								bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSVCERROR, data.error, input);
							});
						}
						else
						{
							bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSVCBEFORERESULT, data, input);

							if(data.results != null)
							{
								delete data.results["@metadata"]; //TODO Recursively remove @metadata
								view.context.binding.set("value", data.results);
							}
							else //{#bug: BG-842 Service Call doesn't set its result if null returned after execute}
								view.context.binding.set("value", null);

							//{#bug: BG-769 Service Call busy icons don't stop for services that return nothing}
							 view._proto._setExecutionStatus(view, "completed");

							//{#bug: * Fixed issue where onresult event was called even after a service error}
							//console.log("Service returned: " + bpmext.text.toString(data));
							setTimeout(function(){
								bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSVCRESULT, data.results, input);
							});
						}
					}
					catch (e) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("Error on AJAX service invocation [" + view.context.viewid + "]: " + e);
						bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONAJAX_SVC_INVOCATION") + " [" + view.context.viewid + "]: " + e);
						if(e.stack) { 
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.error("  Call stack: " + e.stack);
							bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
						}
					}
				},
				error: function(error) {
					try
					{
						//domClass.remove(view._instance.input, "spin");
						//console.log("Service returned w/ error");
						
						//TODO Show error on control?
						//view._instance.error = error....
						var errObj = JSON.parse(error.responseText);
						if(errObj.Data)
							view._instance.error = {
								//{#bug: * Improved retrieval of error data if AJAX error caused by Error End Event}
								//errorCode: errObj.Data.errorNumber,
								//errorText: errObj.Data.programmersDetails,
								errorCode: (errObj.Data.errorData != null && errObj.Data.errorData.code != null ? errObj.Data.errorData.code : errObj.Data.errorNumber),
								errorText: (errObj.Data.errorData != null && errObj.Data.errorData.data != null ? errObj.Data.errorData.data : errObj.Data.programmersDetails),
								serviceInError: error.response.url							
							};
						else
							view._instance.error = {
								errorCode: error.response.status + "",
								errorText: error.response.xhr.statusText,
								serviceInError: error.response.url							
							};
						
						bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSVCERROR, view._instance.error, input);
					}
					catch (e) {
						//{#feature: US-1330 Added RT localization}
						//bpmext.log.error("Error on AJAX service invocation [" + view.context.viewid + "]: " + e);
						bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONAJAX_SVC_INVOCATION") + " [" + view.context.viewid + "]: " + e);
						if(e.stack) { 
							//{#feature: US-1330 Added RT localization}
							//bpmext.log.error("  Call stack: " + e.stack);
							bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
						}
					}
				}
			};

			try
			{
				this._proto._setExecutionStatus(this, "executing");
				this.context.options.attachedService(sargs);
				bpmext.ui.executeEventHandlingFunction(view, view._proto.EVT_ONSVCINVOKE);				
			}
			catch(e)
			{
				this._proto._setExecutionStatus(this, "error");
			}
		};

		/**
		 * @instance
		 * @memberof ServiceCall
		 * @method setAutoRun
		 * @param {boolean} flag Set to <code>true</code> to enable autorun for the service
		 * @desc Specifies whether this service runs automatically on load and whenever the input value is updated
		 */		
		this.constructor.prototype.setAutoRun = function(flag)
		{ 
			this.context.options.autoRun.set("value", flag);
		};

		/**
		 * @instance
		 * @memberof ServiceCall
		 * @method isAutoRun
		 * @returns {boolean} Indicates whether the service runs automatically on load and when the input value is updated
		 * @desc Returns the indicator for Auto Run
		 */
		this.constructor.prototype.isAutoRun = function()
		{
			return this.context.options.autoRun.get("value");
		};
		
		/**
		 * @instance
		 * @memberof ServiceCall
		 * @method setInputData
		 * @param {*} data the input data
		 * @desc Specifies the default input for this service
		 */		
		this.constructor.prototype.setInputData = function(data)
		{ 
			this.context.options.inputData.set("value", data);
		};

		/**
		 * @instance
		 * @memberof ServiceCall
		 * @method getInputData
		 * @returns {ANY} Return type depends on type of attached input
		 * @desc Returns the input for this service
		 */
		this.constructor.prototype.getInputData = function()
		{
			return this.context.options.inputData.get("value");
		};
		
		/**
		 * @instance
		 * @memberof ServiceCall
		 * @method getResult
		 * @returns {ANY} Return type depends on what is returned from the attached AJAX service
		 * @desc Returns the result from the attached AJAX service
		 */
		this.constructor.prototype.getResult = function()
		{
			return this.context.binding.get("value");
		};
		
		/*
			Coach NG Lifecycle methods *************************************************************
		 */
		
		this.constructor.prototype.load = function ()
		{
			try
			{
				var opts = this.context.options;
				
				if (!this.context.binding)
					this.context.binding = bpmext.ui.substituteObject(this, null, null, null);				
				
				if (!opts.inputData)
					bpmext.ui.substituteConfigOption(this, "inputData", null);
					
				if (!opts.autoRun)
					bpmext.ui.substituteConfigOption(this, "autoRun", false);
				
				if(!opts.busyIndicator)
					bpmext.ui.substituteConfigOption(this, "busyIndicator", "X");

				this._proto._setupBusyIndicator(this, opts.busyIndicator.get("value"));
				
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSVCINVOKE);
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSVCBEFORERESULT, "data", "input");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSVCRESULT, "result", "input");
				bpmext.ui.registerEventHandlingFunction(this, this._proto.EVT_ONSVCERROR, "error", "input");
				
				var view = this;
				
				if(this.context.options.inputData.get("value") && this.context.options.inputData.get("value").bindAll) {
					this._instance._bindValueUpdHandle = this.context.options.inputData.get("value").bindAll(this._proto._bindValueUpdate, this);
				}
				
				bpmext.ui.setupFormulaTriggeredUpdates(
					this, 
					function (expResult)
					{
						if (expResult == undefined)
						{
							expResult = "";
						}

						view.setInputData(expResult);
					},
					this.getResult
				);				
				
				bpmext.ui.loadView(this);
				
				if(this.context.options.autoRun.get("value"))
					this.execute(this.context.options.inputData.get("value"));
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on load event [" + this.context.viewid + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONLOAD_EVENT") + " [" + this.context.viewid + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};
		
		this.constructor.prototype.change = function (event)
		{
			try
			{
				if (event.type == "config")
				{
					switch(event.property)
					{
						case "inputData":
							if(this._instance._bindValueUpdHandle) {
								this._instance._bindValueUpdHandle.unbind();
								this._instance._bindValueUpdHandle = null;
							}
							if(this.context.options.inputData.get("value") && this.context.options.inputData.get("value").bindAll) {
								this._instance._bindValueUpdHandle = this.context.options.inputData.get("value").bindAll(this._proto._bindValueUpdate, this);
							} else if(this.context.options.autoRun.get("value")) {
								this.execute(event.newVal);
							}
							break;
						case "autoRun":
							/*
							if(event.newVal)
								this.execute(event.newVal);
							*/
							break;
						case "busyIndicator":
							this._proto._setupBusyIndicator(this, event.newVal);
							break;
					}
				}
				else if(event.insertedInto == event.removedFrom)
				{
					//Let subscribers know this control's value has changed
					bpmext.ui.broadcastExpressionTrigger(this, bpmext.ui.PHASE_NORMAL);					
				}
				
			}
			catch (e)
			{
				//{#feature: US-1330 Added RT localization}
				//bpmext.log.error("Error on change event [" + this.ui.getAbsoluteName() + "]: " + e);
				bpmext.log.error(bpmext.localization.formatMsg("general", "ERROR_ONCHANGE_EVENT") + " [" + this.ui.getAbsoluteName() + "]: " + e);
				if(e.stack) { 
					//{#feature: US-1330 Added RT localization}
					//bpmext.log.error("  Call stack: " + e.stack);
					bpmext.log.error("  " + bpmext.localization.formatMsg("general", "CALL_STACK", e.stack));
				}
			}
		};
		
		this.constructor.prototype.unload = function ()
		{
			if(this._instance._bindValueUpdHandle)
				this._instance._bindValueUpdHandle.unbind();

			bpmext.ui.unloadView(this);
		};		
	}
};

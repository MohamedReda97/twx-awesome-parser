var mixObject = {
    createPreview:function(containingDiv, labelText, callback){
		var bpmextUri = this.context.getManagedAssetUrl("BPMExt-Core-Designer.js", this.context.assetType_WEB, "SYSBPMUI");
		require([ "dojo/dom-construct", "dojo/dom-class", "dojo/dom-attr", bpmextUri], this.lang.hitch(this, function(domConstruct, domClass, domAttr, bpmext){
			bpmext.uidesign.css.ensureSparkUIClass(containingDiv);
            bpmext.uidesign.css.ensureGlyphsLoaded(this);
            bpmext.uidesign.svg.ensureCarbonIconsLoaded(this);

			/*
			var syntheticBody = document.querySelector("div.claro");
			domClass.add(syntheticBody, "synthBpdy");


			"div.claro.synthBpdy {" +
			"    font-family: 'Open Sans','Helvetica Neue',Helvetica,Arial,sans-serif;" +
			"    font-size: 13px;" +
			"    line-height: 1.42857143;" +
			"    color: #555;" +
			"    background-color: #fff" +
			"}";
			*/
			this.context.coachViewData.labelText = labelText;
			this.context.coachViewData.containingDiv = containingDiv;
			domClass.add(this.context.coachViewData.containingDiv, "spark-ui");

			this.context.coachViewData.defaultHeight = null;
			this.context.coachViewData.defaultWidth = null;
			this.context.coachViewData.defaultBorderRadius = null;
			this.context.coachViewData.defaultFontSize = null;
			
			this.context.coachViewData.iconWrapper = domConstruct.create("div", {tabindex: 0});
			domClass.add(this.context.coachViewData.iconWrapper, "SPARKIcon btn ");
			dojo.attr(this.context.coachViewData.iconWrapper, "role", "button");
			var span = domConstruct.create("span");
			span.innerHTML = this.context.coachViewData.labelText;
			span.style.fontSize = "12px";
			this.context.coachViewData.iconPlaceholder = span;
			this.context.coachViewData.iconWrapper.appendChild(this.context.coachViewData.iconPlaceholder);
			this.context.coachViewData.containingDiv.appendChild(this.context.coachViewData.iconWrapper);
			callback();
		}));
    },

    propertyChanged:function(propertyName, propertyValue){
		var configHelperUri = this.context.getManagedAssetUrl("BPMExt-Core-ConfigHelper.js",this.context.assetType_WEB, "SYSBPMUI");
		require(["dojo/dom-style", "dojo/dom-class", "dojo/dom-construct", configHelperUri], this.lang.hitch(this, function(domStyle, domClass, domConstruct, configHelper){
			if(propertyName == "@label") {
				this.context.coachViewData.labelText = propertyValue ? propertyValue : "";
				if(this.context.coachViewData.iconPlaceholder)
					this.context.coachViewData.iconPlaceholder.innerHTML = this.context.coachViewData.labelText;
				dojo.attr(this.context.coachViewData.iconWrapper, "aria-label", propertyValue);
			} else if(propertyName ==  "@labelVisibility"){
				if(this.context.coachViewData.iconPlaceholder != null) {
					if(propertyValue == "HIDE"){
						this.context.coachViewData.iconPlaceholder.style.display = "none";
					} else {
						this.context.coachViewData.iconPlaceholder.style.display = "";
					}
				}
			} else if(propertyName == "outline"){
				if(Boolean(propertyValue)){
					domClass.add(this.context.coachViewData.iconWrapper, "btn-outline");
				} else {
					domClass.remove(this.context.coachViewData.iconWrapper, "btn-outline");
				}
			} else if(propertyName == "iconSize"){
				var svgWrapper = this.context.coachViewData.iconWrapper.querySelector("svg.ci");
				if(propertyValue===null || propertyValue===undefined || propertyValue==""){
					domStyle.set(this.context.coachViewData.iconWrapper, "font-size", this.context.coachViewData.defaultFontSize);
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.iconWrapper, "font-size", propertyValue);
				}else{
					domStyle.set(this.context.coachViewData.iconWrapper, "font-size", propertyValue+"px");
				}

				if (svgWrapper) {
					svgWrapper.style.height = this.context.coachViewData.iconWrapper.style.fontSize;
					svgWrapper.style.width = svgWrapper.style.height;
				}
			} else if(propertyName == "radius"){
				if(propertyValue===null || propertyValue===undefined || propertyValue==""){
					domStyle.set(this.context.coachViewData.iconWrapper, "border-radius", this.context.coachViewData.defaultBorderRadius);
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.iconWrapper, "border-radius", propertyValue);
				}else{
					domStyle.set(this.context.coachViewData.iconWrapper, "border-radius", propertyValue+"px");
				}
			} else if(propertyName == "size"){
				if(propertyValue===null || propertyValue===undefined || propertyValue==""){
					domStyle.set(this.context.coachViewData.iconWrapper, "height", this.context.coachViewData.defaultHeight);
					domStyle.set(this.context.coachViewData.iconWrapper, "width", this.context.coachViewData.defaultWidth);
				}else if(isNaN(propertyValue)){
					domStyle.set(this.context.coachViewData.iconWrapper, "height", propertyValue);
					domStyle.set(this.context.coachViewData.iconWrapper, "width", propertyValue);
				}else{
					domStyle.set(this.context.coachViewData.iconWrapper, "height", propertyValue+"px");
					domStyle.set(this.context.coachViewData.iconWrapper, "width", propertyValue+"px");
				}
			} else if(propertyName == "icon"){
				if (this.context.coachViewData.icon && this.context.coachViewData.icon.classes) {
					this.context.coachViewData.icon.className = "";
                }

                propertyValue = propertyValue && propertyValue.trim();
				if(propertyValue) {
                    var newIcon = propertyValue.toLowerCase();
                    if(!this.context.coachViewData.icon){
                        this.context.coachViewData.iconPlaceholder = null;
                        this.context.coachViewData.iconWrapper.innerHTML = "";
                        this.context.coachViewData.icon = domConstruct.create("span");
                    }
                    domClass.remove(this.context.coachViewData.icon);
                    domClass.add(this.context.coachViewData.icon, "btn-label icon");

					// removing the contents of the icon node
                	dojo.empty(this.context.coachViewData.icon);

                    //prefix the value with 'fa-' if it doesn't already have a prefix
					if (newIcon.indexOf("fa-") !== 0 && newIcon.indexOf("ci-") !== 0) {
                        domClass.add(this.context.coachViewData.icon, "fa fa-" + newIcon);
                    } else if (newIcon.indexOf("ci-") ===  0) {
                        // add a new icon since we are clearing the content of the icon node
                        var svgWrapper = bpmext.uidesign.svg.getCarbonIcon(newIcon);
                        this.context.coachViewData.icon.appendChild(svgWrapper);
                        svgWrapper.style.height = this.context.coachViewData.iconWrapper.style.fontSize || "";
                        svgWrapper.style.width = svgWrapper.style.height;
                    } else {
                    	domClass.add(this.context.coachViewData.icon, "fa " + newIcon);
                    }
                    this.context.coachViewData.iconWrapper.appendChild(this.context.coachViewData.icon);
				} else {
					if(this.context.coachViewData.icon){
						this.context.coachViewData.iconWrapper.removeChild(this.context.coachViewData.icon);
						this.context.coachViewData.icon = null;
					}
					if(!this.context.coachViewData.iconPlaceholder){
						var span = domConstruct.create("span");
						span.innerHTML = this.context.coachViewData.labelText;
						span.style.fontSize = "12px";
						this.context.coachViewData.iconPlaceholder = span;
						this.context.coachViewData.iconWrapper.appendChild(this.context.coachViewData.iconPlaceholder);
					}
				}
			} else if(propertyName == "colorStyle"){
				var colorStyle;
				if(propertyValue == "P"){
					colorStyle = "btn-primary";
				} else if(propertyValue == "I"){
					colorStyle = "btn-info";
				} else if(propertyValue == "S"){
					colorStyle = "btn-success";
				} else if(propertyValue == "W"){
					colorStyle = "btn-warning";
				} else if(propertyValue == "G"){
					colorStyle = "btn-danger";
				} else if(propertyValue == "T"){
					colorStyle = "btn-transparent";
				} else {
					colorStyle = "";
				}
				domClass.replace(this.context.coachViewData.iconWrapper, colorStyle, "btn-primary btn-info btn-success btn-warning btn-danger btn-transparent");
			}
		}));
    },

	modelChanged: function(propertyName, propertyValue) {

	}
};

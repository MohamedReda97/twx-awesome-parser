                <scriptTypeId>2</scriptTypeId>
                <isActive>true</isActive>
                <script>tw.local.sqlStatements = new tw.object.listOf.SQLStatement();

tw.local.sqlStatements[tw.local.sqlStatements.listLength] = tw.local.templateSQLStatement;

var deleteStatement = newSQLStatement(tw.local.deleteDataSQL);
addSQLParameter(deleteStatement, tw.local.templateID);
tw.local.sqlStatements[tw.local.sqlStatements.listLength] = deleteStatement;

for(var i = 0; i &lt; tw.local.selectedConditionalActivities.listLength; i++) {
  var insertStatement = newSQLStatement(tw.local.insertDataSQL);
  addSQLParameter(insertStatement, tw.local.templateID);
  addSQLParameter(insertStatement, tw.local.selectedConditionalActivities[i]);
  tw.local.sqlStatements[tw.local.sqlStatements.listLength] = insertStatement;
}

</script>

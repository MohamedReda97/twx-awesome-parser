                <script>tw.local.conditionalActivitySelectionTreeHTML
&lt;#
  var caValuesFieldName = "MLT_SELECTION_LIST_" + tw.local.selectionVariableName.replace(/\./g, "#");
#&gt;

&lt;style type="text/css"&gt;
	@import "../portal/js/dojo/1.6.1/dijit/themes/soria/soria.css";
	@import "../portal/js/dojo/1.6.1/dojo/resources/dojo.css";
&lt;/style&gt;
&lt;link rel="stylesheet" type="text/css" href="../portal/js/dojo/1.6.1/dijit/themes/soria/soria.css"&gt;

&lt;# if(!tw.local.isReadOnly) { #&gt;
	&lt;a href="#" id="selectAllLink"&gt;Select All&lt;/a&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;a href="#" id="deselectAllLink"&gt;Deselect All&lt;/a&gt;
&lt;# } #&gt;

&lt;div id="conditionalActivitySelectionTree"&gt;conditionalActivitySelectionTreeHTML&lt;/div&gt;
&lt;input type="hidden" name="&lt;#=caValuesFieldName#&gt;" id="&lt;#=caValuesFieldName#&gt;" value=" "&gt;

&lt;script type="text/javascript" src="../portal/js/dojo/1.6.1/dojo/dojo.js"
        dojoConfig="parseOnLoad:true" &gt;
&lt;/script&gt;

&lt;SCRIPT&gt;
	dojo.require("dijit.tree.TreeStoreModel");
	dojo.require("dijit.Tree");
	dojo.require("dojo.data.ItemFileWriteStore");

	dojo.registerModulePath("lombardi","/teamworks/script/widgets");
	dojo.require("lombardi.CheckBoxTree");
	
	dojo.addOnLoad(function() {
		var treeData = {
					"identifier": "id",
					"bpdid": "value",
					"label": "name",
					"items": [
						{ id: "root", children:
							[&lt;#addTreeDataNode(tw.local.conditionalActivities, "root")#&gt;]
						}]};

&lt;#
var idx = 1;
function addTreeDataNode(caList, path) {
  for(var i = 0; i &lt; caList.listLength; i++) {
    var currentNode = "n_" + idx++;
    log.info(caList[i].id);
#&gt;

{
	id: "&lt;#= path+'.'+caList[i].id #&gt;",
	value: "&lt;#= caList[i].id #&gt;",  
	name: "&lt;#= caList[i].name #&gt;"
	
	&lt;#if(caList[i].isConditional) {#&gt;, checkbox: false&lt;#}#&gt;

	&lt;#if (caList[i].children != null) {#&gt;
		, children: [&lt;#addTreeDataNode(caList[i].children, path+"."+caList[i].name);#&gt;]
	&lt;#}#&gt;
}

	&lt;#if(i&lt;caList.listLength-1) {#&gt;,&lt;#}#&gt;

  &lt;#}#&gt;
&lt;#}#&gt;

	// Load tree data into data source.
	var data =  new dojo.data.ItemFileWriteStore({
		data: treeData,
		idAttribute: "id"
	});
	
	// Bind data source to tree data.
	var treeModel = new lombardi.CheckBoxStoreModel({
		store: data,
		query: {id: 'root'},
		labelAttr: "name"
	});
	
	// Bind data source to tree widget.
    var tree = new lombardi.CheckBoxTree({ model: treeModel, showRoot: false}, "conditionalActivitySelectionTree");
	
&lt;# if(!tw.local.isReadOnly) { #&gt;
	document.getElementById("selectAllLink").onclick = function() {
		tree.setAll(true);
	}
	document.getElementById("deselectAllLink").onclick = function() {
		tree.setAll(false);
	}
&lt;# } #&gt;
	
	tree.setReadOnly(&lt;#=tw.local.isReadOnly#&gt;);
	tree.setCheckboxNames("&lt;#=caValuesFieldName#&gt;");
	
&lt;#
	if(tw.local.selectedConditionalActivities != null) {
		for(var i = 0; i &lt; tw.local.selectedConditionalActivities.listLength; i++) {
#&gt;
			tree.setById("&lt;#=tw.local.selectedConditionalActivities[i]#&gt;", true);
&lt;#
		}
	}
#&gt;
});
&lt;/SCRIPT&gt;</script>

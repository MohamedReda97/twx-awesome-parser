        <layoutData>&lt;script src="/teamworks/script/javascript.js" type="text/javascript"&gt;&lt;/script&gt;
&lt;#
   var allReports = scoreboard.getReports();
#&gt;

&lt;h1&gt;&lt;#= scoreboard.reportTitle #&gt;&lt;/h1&gt;

&lt;#
if (allReports != null &amp;&amp; allReports.length &gt; 0) {
    for(var i = 0; i &lt; allReports.length; i++) {
        out += "&lt;div id=\"report" + i + "\"&gt;\r\n";
        out += allReports[i].displayDefaultPage();
        out += "&lt;/div&gt;\r\n\r\n";
    }
}
#&gt;

&lt;script&gt;init()&lt;/script&gt;
</layoutData>

        <layoutData>var labels = reportLabels;
var seriesName = settings.legendName;
if (seriesName == null)
   seriesName = "unnamed";

if (labels.arrayLength == 0)
   throw "Cannot use expression transformation with no other datasource present as well (no labels found). Make sure " +
         "another datasource is present and executed before the expression one.";

for (var i = 0 ; i &lt; labels.arrayLength ; i++ ) {
   var value = String(report.epv[settings.epvName][settings.epvVariableName]);
   addDataToSeries(seriesName, i, value);
}</layoutData>
        <description>Creates a serie based on a EPV Variable value. This datasource cannot be used alone it has to be together with another datasource providing the possible x labels</description>

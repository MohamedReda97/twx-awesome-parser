&lt;#
function eval_sqlstr(str) {
  var rs, li = 0;
  str.replace(
     /&amp;lt;#=(.+?)#__#/mg,
      function (m, g, i, w) {
        if (rs) rs += "+";
        else    rs = "";
        rs += "\"" + w.substring(li, i) + "\"+" + g;
        li = i + g.length + 10; // 10 is the length of "&lt;#=#__#"
      });
  if (!rs) rs = "";
  else if (li &lt; str.length) rs += "+";
  if (li &lt; str.length)
      rs += "\"" + str.substring(li) + "\"";
  java.lang.System.out.println("SQLStr Before eval= " + rs);
  return eval(rs);
}</xsl:text>
